fwd boom.graphics.material.Material;
fwd boom.graphics.material.material;
fwd boom.graphics.material.material_set_color;
fwd boom.graphics.material.material_add_texture;
fwd boom.graphics.material.material_bind;

fwd boom.graphics.transform.Transform;
