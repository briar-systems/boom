# Virtual paths, so a game never writes a filesystem path.
#
# A game names an asset `res://art/hero.qoi`, not `assets/art/hero.qoi` and
# certainly not an absolute path. The scheme says what kind of location it is.
# Where that lands on disk is a deployment decision the game does not encode.
#
# This is not cosmetic. A literal path bakes a layout into every call site, so
# moving assets, renaming a directory, or shipping them beside the binary
# instead of above it becomes a search and replace through game code. The
# `user://` case cannot be a literal at all, because saves belong in a
# different place on every OS and a game that writes beside its executable is
# wrong on all three.
#
# The schemes are:
#
#   res://   Read-only game content shipped with the build. Defaults to `res`
#            relative to the working directory.
#   user://  Writable per-user state such as saves, settings, and logs.
#            Defaults to the platform's own location, derived at first use.
#
# A bare path with no scheme passes through unchanged. That is the escape hatch
# for a tool or a test that genuinely means one specific file, and it is
# deliberately the ugly option so that game code does not reach for it.
#
# The roots are plain globals. A game sets them once at startup:
#
#     vfs.res_root = "data";
#     vfs.user_root = "/opt/onslaughter/state";
#
# A build can drive that from a manifest value, an environment variable, or a
# debug flag pointing at a source tree so that assets reload without a rebuild.
# Registering further schemes is vfs_register.

use allo: std.allocator;
use std.allocator.page;
use std.collections.vector;
use fs: std.filesystem;
use std.process.env;
use text: std.text.string;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.path;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.owned_adopt;
use std.types.string.owned_release;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_starts_with;

# The separator between a scheme and its path
val MARK: str = "://";

# Where `res://` resolves
#
# Read-only content shipped with the build. relative to the working directory
# unless set to an absolute path.
pub var res_root: str = "res";

# Where `user://` resolves
#
# Empty means "derive from the platform at first use". set it to override that
# entirely, which is what a portable build or a test wants. applications should
# normally derive and assign a namespaced root with vfs_user_data_root.
pub var user_root: str = "";

# How many extra schemes a game may register beyond res and user
pub val MAX_SCHEMES: usize = 8;

# why a virtual path could not be resolved
# ---
# unknown_scheme:        the path names a scheme that is neither built in nor registered
# invalid_namespace:     an organization or application is not one portable path component
# user_data_unavailable: the platform exposes no absolute per-user data directory
# env:                   reading the platform's data directory variables failed
# alloc:                 the resolved path could not be allocated
pub tag VfsError: u8 {
    unknown_scheme;
    invalid_namespace;
    user_data_unavailable;
    env:   env.EnvError;
    alloc: allo.Error;
}

# why vfs_register refused a scheme
# ---
# builtin: res and user are answered from res_root and user_root, never the table
# full:    MAX_SCHEMES schemes are already registered
pub tag RegisterError: u8 {
    builtin;
    full;
}

# why an asset could not be read through a virtual path
# ---
# path: the virtual path did not resolve, or its resolution could not be released
# read: the resolved file could not be read
pub tag ReadError: u8 {
    path: VfsError;
    read: fs.FsError;
}

# a human-readable description of a read failure
# ---
# e:   the failure
# ret: static text naming the case
pub fun read_error_message(e: ReadError) str {
    if (sel e.path) { ret vfs_error_message(e.path); }
    ret "could not read the file";
}

# Read a whole file named by a virtual path.
#
# The one way an engine loader reaches the disk, so a sound, a texture, a mesh
# and a font all honour the same schemes. The resolved path is released before
# returning, and the caller owns the vector, released with vector.dnit.
# ---
# a:     allocator for the resolved path and the bytes
# vpath: virtual path, e.g. `res://art/hero.qoi`, or a bare filesystem path
# ret:   the file's bytes, or why they could not be read
pub fun vfs_read_bytes(a: *allo.Allocator, vpath: str) res[vector.Vector[u8], ReadError] {
    val resolved: res[str, VfsError] = vfs_resolve(a, vpath);
    if (sel resolved.err) {
        ret res[vector.Vector[u8], ReadError].err{ReadError.path{resolved.err}};
    }
    val read:  res[vector.Vector[u8], fs.FsError] = fs.read_bytes(a, resolved.ok);
    val freed: err[allo.Error]                    = text.str_free(a, resolved.ok);
    if (sel read.err) {
        ret res[vector.Vector[u8], ReadError].err{ReadError.read{read.err}};
    }
    if (sel freed.err) {
        var bytes: vector.Vector[u8] = read.ok;
        vector.dnit[u8](?bytes);
        ret res[vector.Vector[u8], ReadError].err{ReadError.path{VfsError.alloc{freed.err}}};
    }
    ret res[vector.Vector[u8], ReadError].ok{read.ok};
}

# a human-readable description of a resolution failure
# ---
# e:   the failure
# ret: static text naming the case
pub fun vfs_error_message(e: VfsError) str {
    if (sel e.unknown_scheme)        { ret "unknown path scheme"; }
    if (sel e.invalid_namespace)     { ret "invalid user data namespace"; }
    if (sel e.user_data_unavailable) { ret "user data directory is unavailable"; }
    if (sel e.env)                   { ret "could not read the platform data directory"; }
    ret "out of memory resolving a path";
}

rec Extra {
    name: str;
    root: str;
    used: bool;
}

# a scheme root, either borrowed from a global or owned by the resolution
tag Root: u8 {
    borrowed: str;
    owned:    OwnedString;
}

var extras:      [8]Extra;
var extra_count: usize = 0;

# Register or replace a scheme beyond the built-in two
#
# The name is the bare scheme without `://`, so `vfs_register("mods", ...)`
# makes `mods://weapon.pack` resolve. re-registering an existing name replaces
# its root rather than adding a second entry, so a game may call this on every
# reload without leaking entries.
#
# `res` AND `user` ARE REFUSED, they are not registerable. vfs_resolve answers
# those two from res_root and user_root before it looks at this table, so an
# entry under either name can never be consulted. Accepting one and reporting
# success, which this used to do, is a report of something that did not happen:
# the caller believes it has redirected `res://` and every asset then loads from
# somewhere else. Assign res_root or user_root instead; both are public.
# ---
# name: scheme name, without the `://`
# root: directory the scheme resolves against
# ret:  ok, or why the scheme was refused
pub fun vfs_register(name: str, root: str) err[RegisterError] {
    if (str_equals(name, "res") || str_equals(name, "user")) {
        ret err[RegisterError].err{RegisterError.builtin{}};
    }
    var i: usize = 0;
    for (i < extra_count) {
        if (extras[i].used && str_equals(extras[i].name, name)) {
            extras[i].root = root;
            ret err[RegisterError].ok{};
        }
        i = i + 1;
    }
    if (extra_count >= MAX_SCHEMES) { ret err[RegisterError].err{RegisterError.full{}}; }
    extras[extra_count].name = name;
    extras[extra_count].root = root;
    extras[extra_count].used = true;
    extra_count              = extra_count + 1;
    ret err[RegisterError].ok{};
}

# Whether a virtual path carries a scheme
pub fun vfs_has_scheme(vpath: str) bool {
    ret scheme_end(vpath) != 0;
}

# Derive an owned, platform-native application data root
#
# An explicit user_root is already considered the complete application root and
# is cloned unchanged. otherwise this appends organization and application to
# the platform data directory. both names must use the portable identifier
# alphabet `[A-Za-z0-9._-]`. the caller owns the returned path, released with
# std.text.string.str_free; assign it to user_root only while it remains live.
# ---
# a:            allocator for the returned path
# organization: stable publisher identifier, e.g. `briar-systems`
# application:  stable application identifier, e.g. `ludus`
# ret:          owned application data path, or why it could not be derived
pub fun vfs_user_data_root(a: *allo.Allocator,
    organization: str,
    application: str) res[str, VfsError] {
    if (!valid_root_component(organization)
        || !valid_root_component(application)) {
        ret res[str, VfsError].err{VfsError.invalid_namespace{}};
    }
    if (user_root != nil && str_len(user_root) > 0) {
        val copied: res[str, allo.Error] = text.str_dup(a, user_root);
        if (sel copied.err) { ret res[str, VfsError].err{VfsError.alloc{copied.err}}; }
        ret res[str, VfsError].ok{copied.ok};
    }

    val base_result: res[Root, VfsError] = user_root_resolved(a);
    if (sel base_result.err) { ret res[str, VfsError].err{base_result.err}; }
    var base:                Root                       = base_result.ok;
    val organization_result: res[path.Path, allo.Error] = path.join(
        a, root_value(?base), organization);
    val released: err[allo.Error] = release_root(?base);
    if (sel organization_result.err) {
        ret res[str, VfsError].err{VfsError.alloc{organization_result.err}};
    }
    val organization_root: str = organization_result.ok;
    if (sel released.err) {
        text.str_free(a, organization_root);
        ret res[str, VfsError].err{VfsError.alloc{released.err}};
    }
    val application_result: res[path.Path, allo.Error] = path.join(
        a, organization_root, application);
    val freed: err[allo.Error] = text.str_free(a, organization_root);
    if (sel application_result.err) {
        ret res[str, VfsError].err{VfsError.alloc{application_result.err}};
    }
    if (sel freed.err) {
        text.str_free(a, application_result.ok);
        ret res[str, VfsError].err{VfsError.alloc{freed.err}};
    }
    ret res[str, VfsError].ok{application_result.ok};
}

fun valid_root_component(value: str) bool {
    if (value == nil || str_len(value) == 0
        || str_equals(value, ".") || str_equals(value, "..")) { ret false; }
    if (value[str_len(value) - 1] == '.' || reserved_windows_name(value)) {
        ret false;
    }
    var i: usize = 0;
    for (i < str_len(value)) {
        val c:     u8   = value[i]::u8;
        val alpha: bool = (c >= 'a'::u8 && c <= 'z'::u8)
            || (c >= 'A'::u8 && c <= 'Z'::u8);
        val digit: bool = c >= '0'::u8 && c <= '9'::u8;
        if (!alpha && !digit && c != '-'::u8 && c != '_'::u8 && c != '.'::u8) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

fun reserved_windows_name(value: str) bool {
    var len: usize = 0;
    for (value[len] != 0 && value[len] != '.') { len = len + 1; }
    if (name_equals(value, len, "con") || name_equals(value, len, "prn")
        || name_equals(value, len, "aux") || name_equals(value, len, "nul")) {
        ret true;
    }
    if (len == 4 && value[3] >= '1' && value[3] <= '9') {
        if (name_equals_prefix(value, "com") || name_equals_prefix(value, "lpt")) {
            ret true;
        }
    }
    ret false;
}

fun name_equals(value: str, len: usize, expected: str) bool {
    if (len != str_len(expected)) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (ascii_lower(value[i]) != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun name_equals_prefix(value: str, expected: str) bool {
    var i: usize = 0;
    for (i < 3) {
        if (ascii_lower(value[i]) != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ascii_lower(c: u8) u8 {
    if (c >= 'A'::u8 && c <= 'Z'::u8) { ret c + 32; }
    ret c;
}

# Index just past the `://` of a scheme, or 0 when there is none
#
# A path whose `://` appears after a `/` is not a scheme -- that is a directory
# that happens to contain the characters -- so the search stops at the first
# separator.
fun scheme_end(vpath: str) usize {
    if (vpath == nil) { ret 0; }
    val n: usize = str_len(vpath);
    var i: usize = 0;
    for (i + 3 <= n) {
        if (path.is_separator(vpath[i]::u8))                               { ret 0; }
        if (vpath[i] == ':' && vpath[i + 1] == '/' && vpath[i + 2] == '/') { ret i + 3; }
        i = i + 1;
    }
    ret 0;
}

# The root a scheme resolves against
fun root_for(a: *allo.Allocator, vpath: str, end: usize) res[Root, VfsError] {
    if (str_starts_with(vpath, "res://")) {
        ret res[Root, VfsError].ok{Root.borrowed{res_root}};
    }
    if (str_starts_with(vpath, "user://")) { ret user_root_resolved(a); }

    var i: usize = 0;
    for (i < extra_count) {
        if (extras[i].used && str_len(extras[i].name) == end - 3) {
            var m: bool  = true;
            var k: usize = 0;
            for (k < end - 3) {
                if (vpath[k] != extras[i].name[k]) { m = false; }
                k = k + 1;
            }
            if (m) {
                ret res[Root, VfsError].ok{Root.borrowed{extras[i].root}};
            }
        }
        i = i + 1;
    }
    ret res[Root, VfsError].err{VfsError.unknown_scheme{}};
}

# Resolve a virtual path to a filesystem path
#
# The result is owned by the caller, allocated from `a` and released with
# std.text.string.str_free. a path with no scheme is copied through unchanged,
# so the escape hatch costs a copy and nothing else.
# ---
# a:     allocator for the result
# vpath: virtual path, e.g. `res://art/hero.qoi`
# ret:   the filesystem path, or why it could not be resolved
pub fun vfs_resolve(a: *allo.Allocator, vpath: str) res[str, VfsError] {
    val end: usize = scheme_end(vpath);
    if (end == 0) {
        val copied: res[str, allo.Error] = text.str_dup(a, vpath);
        if (sel copied.err) { ret res[str, VfsError].err{VfsError.alloc{copied.err}}; }
        ret res[str, VfsError].ok{copied.ok};
    }

    val rr: res[Root, VfsError] = root_for(a, vpath, end);
    if (sel rr.err) { ret res[str, VfsError].err{rr.err}; }
    var root:  Root = rr.ok;
    val value: str  = root_value(?root);

    val n:    usize = str_len(vpath);
    val rest: usize = n - end;
    val rlen: usize = str_len(value);

    # A root of "" means the rest is already the whole path, which is what an
    # absolute user_root override collapses to
    if (rlen == 0) {
        val result: res[str, allo.Error] = text.str_dup_range(a, vpath, end, rest);
        ret finish_resolve(a, ?root, result);
    }

    # Join with exactly one separator regardless of whether the root carries a
    # trailing one, since both spellings are natural for a dev to write
    var sep: usize = 1;
    if (path.is_separator(value[rlen - 1]::u8)) { sep = 0; }

    val br: res[*u8, allo.Error] = allo.allocate[u8](a, rlen + sep + rest + 1);
    if (sel br.err) { ret finish_resolve(a, ?root, res[str, allo.Error].err{br.err}); }
    val buf: *u8 = br.ok;

    var o: usize = 0;
    var i: usize = 0;
    for (i < rlen) {
        buf[o] = value[i]::u8;
        o      = o + 1;
        i      = i + 1;
    }
    if (sep == 1) {
        buf[o] = path.separator();
        o      = o + 1;
    }
    i = 0;
    for (i < rest) {
        var c: u8 = vpath[end + i]::u8;
        if (c == '/'::u8) { c = path.separator(); }
        buf[o] = c;
        o      = o + 1;
        i      = i + 1;
    }
    buf[o] = 0;
    ret finish_resolve(a, ?root, res[str, allo.Error].ok{buf:~str});
}

# release a resolution's root, reporting the first failure and owning nothing on one
fun finish_resolve(a: *allo.Allocator, root: *Root, result: res[str, allo.Error]) res[str, VfsError] {
    val released: err[allo.Error] = release_root(root);
    if (sel result.err) { ret res[str, VfsError].err{VfsError.alloc{result.err}}; }
    if (sel released.err) {
        text.str_free(a, result.ok);
        ret res[str, VfsError].err{VfsError.alloc{released.err}};
    }
    ret res[str, VfsError].ok{result.ok};
}

fun root_value(root: *Root) str {
    if (sel root.owned)    { ret root.owned.data; }
    if (sel root.borrowed) { ret root.borrowed; }
    ret nil;
}

fun release_root(root: *Root) err[allo.Error] {
    if (sel root.owned) { ret owned_release(?root.owned); }
    ret err[allo.Error].ok{};
}

# The resolved `user://` root, deriving the platform default when unset
#
# Derived rather than hardcoded because the right answer differs per OS and,
# on linux, is itself configurable. the result is not cached: a game that
# cares sets user_root explicitly, and a game that does not resolves it a
# handful of times over its life.
fun user_root_resolved(a: *allo.Allocator) res[Root, VfsError] {
    if (user_root != nil && str_len(user_root) > 0) {
        ret res[Root, VfsError].ok{Root.borrowed{user_root}};
    }

    $if ($mach.build.os == $mach.os.windows) {
        # Roaming application data, the documented home for per-user state
        val r: res[opt[Root], VfsError] = absolute_env(a, "APPDATA", "");
        if (sel r.err)     { ret res[Root, VfsError].err{r.err}; }
        if (sel r.ok.some) { ret res[Root, VfsError].ok{r.ok.some}; }
    }
    $or ($mach.build.os == $mach.os.darwin) {
        val h: res[opt[Root], VfsError] = absolute_env(a, "HOME", "Library/Application Support");
        if (sel h.err)     { ret res[Root, VfsError].err{h.err}; }
        if (sel h.ok.some) { ret res[Root, VfsError].ok{h.ok.some}; }
    }
    $or {
        # XDG first, since a user may have moved it; the specification defines
        # $HOME/.local/share as the default when the variable is absent
        val x: res[opt[Root], VfsError] = absolute_env(a, "XDG_DATA_HOME", "");
        if (sel x.err)     { ret res[Root, VfsError].err{x.err}; }
        if (sel x.ok.some) { ret res[Root, VfsError].ok{x.ok.some}; }
        val h: res[opt[Root], VfsError] = absolute_env(a, "HOME", ".local/share");
        if (sel h.err)     { ret res[Root, VfsError].err{h.err}; }
        if (sel h.ok.some) { ret res[Root, VfsError].ok{h.ok.some}; }
    }

    ret res[Root, VfsError].err{VfsError.user_data_unavailable{}};
}

# an owned root from an environment variable holding an absolute path
#
# none when the variable is unset or relative. a non-empty suffix is joined
# onto the value.
fun absolute_env(a: *allo.Allocator, name: str, suffix: str) res[opt[Root], VfsError] {
    val read: res[opt[OwnedString], env.EnvError] = env.value(a, name);
    if (sel read.err)     { ret res[opt[Root], VfsError].err{VfsError.env{read.err}}; }
    if (sel read.ok.none) { ret res[opt[Root], VfsError].ok{opt[Root].none{}}; }
    var value: OwnedString = read.ok.some;
    if (!path.is_abs(value.data)) {
        val dropped: err[allo.Error] = owned_release(?value);
        if (sel dropped.err) { ret res[opt[Root], VfsError].err{VfsError.alloc{dropped.err}}; }
        ret res[opt[Root], VfsError].ok{opt[Root].none{}};
    }
    if (str_len(suffix) == 0) {
        ret res[opt[Root], VfsError].ok{opt[Root].some{Root.owned{value}}};
    }
    val joined:   res[path.Path, allo.Error] = path.join(a, value.data, suffix);
    val released: err[allo.Error]            = owned_release(?value);
    if (sel joined.err) { ret res[opt[Root], VfsError].err{VfsError.alloc{joined.err}}; }
    if (sel released.err) {
        text.str_free(a, joined.ok);
        ret res[opt[Root], VfsError].err{VfsError.alloc{released.err}};
    }
    val len: usize = str_len(joined.ok);
    ret res[opt[Root], VfsError].ok{opt[Root].some{Root.owned{owned_adopt(a, joined.ok, len, len + 1)}}};
}

# whether a resolution produced exactly the expected path
fun resolves_to(r: res[str, VfsError], expected: str) bool {
    ret sel r.ok && str_equals(r.ok, expected);
}

# whether a user data root was refused as an invalid namespace
fun refused_namespace(r: res[str, VfsError]) bool {
    ret sel r.err && sel r.err.invalid_namespace;
}

test "vfs: res:// resolves against res_root" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = res_root;
    res_root = "assets";

    val r: res[str, VfsError] = vfs_resolve(?a, "res://art/hero.qoi");
    res_root = saved;
    if (!resolves_to(r, "assets/art/hero.qoi")) { ret 1; }
    ret 0;
}

test "vfs: a root with a trailing slash does not double it" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = res_root;

    res_root = "assets/";
    val r: res[str, VfsError] = vfs_resolve(?a, "res://hero.qoi");
    res_root = saved;
    # Both spellings of a root are natural to write, so both must land here
    if (!resolves_to(r, "assets/hero.qoi")) { ret 1; }
    ret 0;
}

test "vfs: an absolute root works, including one that is only a slash" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = res_root;

    res_root = "/opt/game/data";
    val r: res[str, VfsError] = vfs_resolve(?a, "res://hero.qoi");
    if (!resolves_to(r, "/opt/game/data/hero.qoi")) {
        res_root = saved;
        ret 1;
    }

    res_root = "/";
    val r2: res[str, VfsError] = vfs_resolve(?a, "res://hero.qoi");
    res_root = saved;
    if (!resolves_to(r2, "/hero.qoi")) { ret 2; }
    ret 0;
}

test "vfs: a bare path passes through unchanged" {
    var a: allo.Allocator;
    page.make(?a);
    val r: res[str, VfsError] = vfs_resolve(?a, "some/plain/path.txt");
    if (!resolves_to(r, "some/plain/path.txt")) { ret 1; }
    if (vfs_has_scheme("some/plain/path.txt"))  { ret 2; }
    ret 0;
}

test "vfs: :// after a separator is a directory, not a scheme" {
    # A path like `weird/a://b` names a directory that happens to contain the
    # characters. treating it as a scheme would silently redirect the lookup.
    if (vfs_has_scheme("weird/a://b")) { ret 1; }
    var a: allo.Allocator;
    page.make(?a);
    val r: res[str, VfsError] = vfs_resolve(?a, "weird/a://b");
    if (!resolves_to(r, "weird/a://b")) { ret 2; }
    ret 0;
}

test "vfs: an unknown scheme is an error, not a silent passthrough" {
    var a: allo.Allocator;
    page.make(?a);
    # Passing it through would resolve `bogus://x` against the working
    # directory and fail later with a confusing not-found
    val r: res[str, VfsError] = vfs_resolve(?a, "bogus://x");
    if (!sel r.err)                { ret 1; }
    if (!sel r.err.unknown_scheme) { ret 2; }
    ret 0;
}

test "vfs: a registered scheme resolves, and re-registering replaces it" {
    var a: allo.Allocator;
    page.make(?a);

    val first: err[RegisterError] = vfs_register("mods", "mods/enabled");
    if (!sel first.ok) { ret 1; }
    val r: res[str, VfsError] = vfs_resolve(?a, "mods://weapons.pack");
    if (!resolves_to(r, "mods/enabled/weapons.pack")) { ret 2; }

    # Re-registering must replace rather than append, so a reload does not
    # leak table entries or leave the old root shadowing the new one
    val again: err[RegisterError] = vfs_register("mods", "other");
    if (!sel again.ok) { ret 3; }
    val r2: res[str, VfsError] = vfs_resolve(?a, "mods://weapons.pack");
    if (!resolves_to(r2, "other/weapons.pack")) { ret 4; }
    ret 0;
}

test "vfs: user:// honours an explicit override" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = user_root;

    user_root = "/tmp/game-state";
    val r: res[str, VfsError] = vfs_resolve(?a, "user://save1.dat");
    user_root = saved;
    if (!resolves_to(r, "/tmp/game-state/save1.dat")) { ret 1; }
    ret 0;
}

test "vfs: an explicit user root is already application scoped" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = user_root;

    user_root = "/tmp/portable-ludus";
    val r: res[str, VfsError] = vfs_user_data_root(
        ?a, "briar-systems", "ludus");
    user_root = saved;
    if (!resolves_to(r, "/tmp/portable-ludus")) { ret 1; }
    if (sel r.ok) {
        val freed: err[allo.Error] = text.str_free(?a, r.ok);
        if (sel freed.err) { ret 2; }
    }
    ret 0;
}

test "vfs: user data namespaces are single path components" {
    var a: allo.Allocator;
    page.make(?a);
    if (!refused_namespace(vfs_user_data_root(?a, "..", "ludus"))) { ret 1; }
    if (!refused_namespace(vfs_user_data_root(?a, "briar/systems", "ludus"))) {
        ret 2;
    }
    if (!refused_namespace(vfs_user_data_root(?a, "briar\\systems", "ludus"))) {
        ret 3;
    }
    if (!refused_namespace(vfs_user_data_root(?a, "briar:systems", "ludus"))) {
        ret 4;
    }
    if (!refused_namespace(vfs_user_data_root(?a, "briar-systems.", "ludus"))) {
        ret 5;
    }
    if (!refused_namespace(vfs_user_data_root(?a, "briar-systems", "CON.log"))) {
        ret 6;
    }
    if (!refused_namespace(vfs_user_data_root(?a, "briar-systems", "lPt9"))) {
        ret 7;
    }
    if (!refused_namespace(vfs_user_data_root(?a, "briar-systems", ""))) { ret 8; }
    ret 0;
}

test "vfs: user:// derives a root or reports missing platform state" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = user_root;
    user_root = "";

    val r: res[str, VfsError] = vfs_resolve(?a, "user://save1.dat");
    user_root = saved;
    # Sandboxed processes may expose no HOME or platform data directory. that
    # is an explicit error instead of writing into the working directory.
    if (sel r.err)          { ret 0; }
    if (str_len(r.ok) == 0) { ret 1; }
    ret 0;
}

test "vfs: the built-in schemes are refused rather than silently ignored" {
    # An entry named res or user can never be consulted, because vfs_resolve
    # answers those from res_root and user_root first. Accepting one and
    # reporting success is worse than refusing: the caller believes it has
    # redirected res:// and every asset then loads from the old root.
    val res_refused: err[RegisterError] = vfs_register("res", "/tmp/somewhere");
    if (!sel res_refused.err)         { ret 1; }
    if (!sel res_refused.err.builtin) { ret 2; }
    val user_refused: err[RegisterError] = vfs_register("user", "/tmp/elsewhere");
    if (!sel user_refused.err) { ret 3; }

    # And the refusal must not have consumed a slot or shadowed the real root.
    var a: allo.Allocator;
    page.make(?a);
    val r: res[str, VfsError] = vfs_resolve(?a, "res://sprite.qoi");
    if (!resolves_to(r, "res/sprite.qoi")) { ret 4; }
    ret 0;
}

test "vfs: a missing file reports the read, not the path" {
    var a:    allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    val r: res[vector.Vector[u8], ReadError] = vfs_read_bytes(?a, "/nonexistent/boom/asset.bin");
    if (!sel r.err)      { ret 2; }
    if (!sel r.err.read) { ret 3; }
    val bogus: res[vector.Vector[u8], ReadError] = vfs_read_bytes(?a, "bogus://asset.bin");
    if (!sel bogus.err)      { ret 4; }
    if (!sel bogus.err.path) { ret 5; }
    ret 0;
}

test "vfs: res_root is what redirects the res scheme" {
    # The supported way to do what vfs_register("res", ...) looks like it does.
    val saved: str = res_root;
    res_root = "assets/packed";
    var a: allo.Allocator;
    page.make(?a);
    val r: res[str, VfsError] = vfs_resolve(?a, "res://sprite.qoi");
    res_root = saved;
    if (!resolves_to(r, "assets/packed/sprite.qoi")) { ret 1; }
    ret 0;
}
