# Virtual paths, so a game never writes a filesystem path.
#
# A game names an asset `res://art/hero.qoi`, not `assets/art/hero.qoi` and
# certainly not an absolute path. The scheme says what kind of location it is.
# Where that lands on disk is a deployment decision the game does not encode.
#
# This is not cosmetic. A literal path bakes a layout into every call site, so
# moving assets, renaming a directory, or shipping them beside the binary
# instead of above it becomes a search and replace through game code. The
# `user://` case cannot be a literal at all, because saves belong in a
# different place on every OS and a game that writes beside its executable is
# wrong on all three.
#
# The schemes are:
#
#   res://   Read-only game content shipped with the build. Defaults to `res`
#            relative to the working directory.
#   user://  Writable per-user state such as saves, settings, and logs.
#            Defaults to the platform's own location, derived at first use.
#
# A bare path with no scheme passes through unchanged. That is the escape hatch
# for a tool or a test that genuinely means one specific file, and it is
# deliberately the ugly option so that game code does not reach for it.
#
# The roots are plain globals. A game sets them once at startup:
#
#     vfs.res_root = "data";
#     vfs.user_root = "/opt/onslaughter/state";
#
# A build can drive that from a manifest value, an environment variable, or a
# debug flag pointing at a source tree so that assets reload without a rebuild.
# Registering further schemes is vfs_register.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;
use std.types.string.str_starts_with;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use allo: std.allocator;
use page: std.allocator.page;
use text: std.text.string;
use env:  std.process.env;
use path: std.types.path;

# The separator between a scheme and its path
val MARK: str = "://";

# Where `res://` resolves
#
# Read-only content shipped with the build. relative to the working directory
# unless set to an absolute path.
pub var res_root: str = "res";

# Where `user://` resolves
#
# Empty means "derive from the platform at first use". set it to override that
# entirely, which is what a portable build or a test wants. applications should
# normally derive and assign a namespaced root with vfs_user_data_root.
pub var user_root: str = "";

# How many extra schemes a game may register beyond res and user
pub val MAX_SCHEMES: usize = 8;

rec Extra {
    name: str;
    root: str;
    used: bool;
}

rec Root {
    value: str;
    owned: bool;
}

var extras: [8]Extra;
var extra_count: usize = 0;

# Register or replace a scheme beyond the built-in two
#
# The name is the bare scheme without `://`, so `vfs_register("mods", ...)`
# makes `mods://weapon.pack` resolve. re-registering an existing name replaces
# its root rather than adding a second entry, so a game may call this on every
# reload without leaking entries.
#
# `res` AND `user` ARE REFUSED, they are not registerable. vfs_resolve answers
# those two from res_root and user_root before it looks at this table, so an
# entry under either name can never be consulted. Accepting one and returning
# true, which this used to do, is a report of something that did not happen: the
# caller believes it has redirected `res://` and every asset then loads from
# somewhere else. Assign res_root or user_root instead; both are public.
# ---
# name: scheme name, without the `://`
# root: directory the scheme resolves against
# ret:  false when the table is full, or when the name is a built-in scheme
pub fun vfs_register(name: str, root: str) bool {
    if (str_equals(name, "res") || str_equals(name, "user")) { ret false; }
    var i: usize = 0;
    for (i < extra_count) {
        if (extras[i].used && str_equals(extras[i].name, name)) {
            extras[i].root = root;
            ret true;
        }
        i = i + 1;
    }
    if (extra_count >= MAX_SCHEMES) { ret false; }
    extras[extra_count].name = name;
    extras[extra_count].root = root;
    extras[extra_count].used = true;
    extra_count = extra_count + 1;
    ret true;
}

# Whether a virtual path carries a scheme
pub fun vfs_has_scheme(vpath: str) bool {
    ret scheme_end(vpath) != 0;
}

# Derive an owned, platform-native application data root
#
# An explicit user_root is already considered the complete application root and
# is cloned unchanged. otherwise this appends organization and application to
# the platform data directory. both names must use the portable identifier
# alphabet `[A-Za-z0-9._-]`. the caller owns the returned path; assign it to
# user_root only while that allocation remains live.
# ---
# a:            allocator for the returned path
# organization: stable publisher identifier, e.g. `briar-systems`
# application:  stable application identifier, e.g. `ludus`
# ret:          owned application data path, or an error
pub fun vfs_user_data_root(a: *allo.Allocator,
                           organization: str,
                           application: str) Result[str, str] {
    if (a == nil) { ret err[str, str]("allocator is nil"); }
    if (!valid_root_component(organization)
        || !valid_root_component(application)) {
        ret err[str, str]("invalid user data namespace");
    }
    if (user_root != nil && str_len(user_root) > 0) {
        ret text.str_dup(a, user_root);
    }

    val base_result: Result[Root, str] = user_root_resolved(a);
    if (is_err[Root, str](base_result)) {
        ret err[str, str](unwrap_err[Root, str](base_result));
    }
    val base: Root = unwrap_ok[Root, str](base_result);
    val organization_result: Result[str, str] = path.join(
        a, base.value, organization);
    release_root(a, base);
    if (is_err[str, str](organization_result)) {
        ret err[str, str](unwrap_err[str, str](organization_result));
    }
    val organization_root: str = unwrap_ok[str, str](organization_result);
    val application_result: Result[str, str] = path.join(
        a, organization_root, application);
    allo.deallocate[u8](a, organization_root, str_len(organization_root) + 1);
    ret application_result;
}

fun valid_root_component(value: str) bool {
    if (value == nil || str_len(value) == 0
        || str_equals(value, ".") || str_equals(value, "..")) { ret false; }
    if (value[str_len(value) - 1] == '.' || reserved_windows_name(value)) {
        ret false;
    }
    var i: usize = 0;
    for (i < str_len(value)) {
        val c: u8 = value[i]::u8;
        val alpha: bool = (c >= 'a'::u8 && c <= 'z'::u8)
            || (c >= 'A'::u8 && c <= 'Z'::u8);
        val digit: bool = c >= '0'::u8 && c <= '9'::u8;
        if (!alpha && !digit && c != '-'::u8 && c != '_'::u8 && c != '.'::u8) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

fun reserved_windows_name(value: str) bool {
    var len: usize = 0;
    for (value[len] != 0 && value[len] != '.') { len = len + 1; }
    if (name_equals(value, len, "con") || name_equals(value, len, "prn")
        || name_equals(value, len, "aux") || name_equals(value, len, "nul")) {
        ret true;
    }
    if (len == 4 && value[3] >= '1' && value[3] <= '9') {
        if (name_equals_prefix(value, "com") || name_equals_prefix(value, "lpt")) {
            ret true;
        }
    }
    ret false;
}

fun name_equals(value: str, len: usize, expected: str) bool {
    if (len != str_len(expected)) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (ascii_lower(value[i]) != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun name_equals_prefix(value: str, expected: str) bool {
    var i: usize = 0;
    for (i < 3) {
        if (ascii_lower(value[i]) != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun ascii_lower(c: u8) u8 {
    if (c >= 'A'::u8 && c <= 'Z'::u8) { ret c + 32; }
    ret c;
}

# Index just past the `://` of a scheme, or 0 when there is none
#
# A path whose `://` appears after a `/` is not a scheme -- that is a directory
# that happens to contain the characters -- so the search stops at the first
# separator.
fun scheme_end(vpath: str) usize {
    if (vpath == nil) { ret 0; }
    val n: usize = str_len(vpath);
    var i: usize = 0;
    for (i + 3 <= n) {
        if (path.is_separator(vpath[i]::u8)) { ret 0; }
        if (vpath[i] == ':' && vpath[i + 1] == '/' && vpath[i + 2] == '/') { ret i + 3; }
        i = i + 1;
    }
    ret 0;
}

# The root a scheme resolves against, or nil when the scheme is unknown
fun root_for(a: *allo.Allocator, vpath: str, end: usize) Result[Root, str] {
    if (str_starts_with(vpath, "res://")) {
        ret ok[Root, str](Root{value: res_root, owned: false});
    }
    if (str_starts_with(vpath, "user://")) { ret user_root_resolved(a); }

    var i: usize = 0;
    for (i < extra_count) {
        if (extras[i].used && str_len(extras[i].name) == end - 3) {
            var m: bool = true;
            var k: usize = 0;
            for (k < end - 3) {
                if (vpath[k] != extras[i].name[k]) { m = false; }
                k = k + 1;
            }
            if (m) {
                ret ok[Root, str](Root{value: extras[i].root, owned: false});
            }
        }
        i = i + 1;
    }
    ret err[Root, str]("unknown path scheme");
}

# Resolve a virtual path to a filesystem path
#
# The result is owned by the caller and allocated from `a`. a path with no
# scheme is copied through unchanged, so the escape hatch costs a copy and
# nothing else.
# ---
# a:     allocator for the result
# vpath: virtual path, e.g. `res://art/hero.qoi`
# ret:   the filesystem path, or an error naming the unknown scheme
pub fun vfs_resolve(a: *allo.Allocator, vpath: str) Result[str, str] {
    if (vpath == nil) { ret err[str, str]("nil path"); }
    val end: usize = scheme_end(vpath);
    if (end == 0) { ret text.str_dup(a, vpath); }

    val rr: Result[Root, str] = root_for(a, vpath, end);
    if (is_err[Root, str](rr)) { ret err[str, str](unwrap_err[Root, str](rr)); }
    val root: Root = unwrap_ok[Root, str](rr);

    val n:    usize = str_len(vpath);
    val rest: usize = n - end;
    val rlen: usize = str_len(root.value);

    # A root of "" means the rest is already the whole path, which is what an
    # absolute user_root override collapses to
    if (rlen == 0) {
        val result: Result[str, str] = text.str_dup_range(a, vpath, end, rest);
        release_root(a, root);
        ret result;
    }

    # Join with exactly one separator regardless of whether the root carries a
    # trailing one, since both spellings are natural for a dev to write
    var sep: usize = 1;
    if (path.is_separator(root.value[rlen - 1]::u8)) { sep = 0; }

    val br: Result[*u8, str] = allo.allocate[u8](a, rlen + sep + rest + 1);
    if (is_err[*u8, str](br)) {
        release_root(a, root);
        ret err[str, str](unwrap_err[*u8, str](br));
    }
    val buf: *u8 = unwrap_ok[*u8, str](br);

    var o: usize = 0;
    var i: usize = 0;
    for (i < rlen) { buf[o] = root.value[i]::u8; o = o + 1; i = i + 1; }
    if (sep == 1) { buf[o] = path.separator(); o = o + 1; }
    i = 0;
    for (i < rest) {
        var c: u8 = vpath[end + i]::u8;
        if (c == '/'::u8) { c = path.separator(); }
        buf[o] = c;
        o = o + 1;
        i = i + 1;
    }
    buf[o] = 0;
    release_root(a, root);
    ret ok[str, str](buf:~str);
}

fun release_root(a: *allo.Allocator, root: Root) {
    if (!root.owned || root.value == nil) { ret; }
    allo.deallocate[u8](a, root.value, str_len(root.value) + 1);
}

# The resolved `user://` root, deriving the platform default when unset
#
# Derived rather than hardcoded because the right answer differs per OS and,
# on linux, is itself configurable. the result is not cached: a game that
# cares sets user_root explicitly, and a game that does not resolves it a
# handful of times over its life.
fun user_root_resolved(a: *allo.Allocator) Result[Root, str] {
    if (user_root != nil && str_len(user_root) > 0) {
        ret ok[Root, str](Root{value: user_root, owned: false});
    }

    $if ($mach.build.os == $mach.os.windows) {
        # Roaming application data, the documented home for per-user state
        val r: Result[str, str] = env.value(a, "APPDATA");
        if (!is_err[str, str](r)) {
            val value: str = unwrap_ok[str, str](r);
            if (path.is_abs(value)) {
                ret ok[Root, str](Root{value: value, owned: true});
            }
            allo.deallocate[u8](a, value, str_len(value) + 1);
        }
    }
    $or ($mach.build.os == $mach.os.darwin) {
        val h: Result[str, str] = env.value(a, "HOME");
        if (!is_err[str, str](h)) {
            val home: str = unwrap_ok[str, str](h);
            if (path.is_abs(home)) {
                ret append_owned_root(a, home, "Library/Application Support");
            }
            allo.deallocate[u8](a, home, str_len(home) + 1);
        }
    }
    $or {
        # XDG first, since a user may have moved it; the specification defines
        # $HOME/.local/share as the default when the variable is absent
        val x: Result[str, str] = env.value(a, "XDG_DATA_HOME");
        if (!is_err[str, str](x)) {
            val data: str = unwrap_ok[str, str](x);
            if (path.is_abs(data)) {
                ret ok[Root, str](Root{value: data, owned: true});
            }
            allo.deallocate[u8](a, data, str_len(data) + 1);
        }
        val h: Result[str, str] = env.value(a, "HOME");
        if (!is_err[str, str](h)) {
            val home: str = unwrap_ok[str, str](h);
            if (path.is_abs(home)) {
                ret append_owned_root(a, home, ".local/share");
            }
            allo.deallocate[u8](a, home, str_len(home) + 1);
        }
    }

    ret err[Root, str]("user data directory is unavailable");
}

fun append_owned_root(a: *allo.Allocator, base: str, suffix: str) Result[Root, str] {
    val joined: Result[str, str] = path.join(a, base, suffix);
    allo.deallocate[u8](a, base, str_len(base) + 1);
    if (is_err[str, str](joined)) {
        ret err[Root, str](unwrap_err[str, str](joined));
    }
    ret ok[Root, str](Root{
        value: unwrap_ok[str, str](joined), owned: true});
}

# --------------------------------------------------------------------- tests

test "vfs: res:// resolves against res_root" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = res_root;
    res_root = "assets";

    val r: Result[str, str] = vfs_resolve(?a, "res://art/hero.qoi");
    if (is_err[str, str](r)) { ret 1; }
    if (!str_equals(unwrap_ok[str, str](r), "assets/art/hero.qoi")) { ret 1; }

    res_root = saved;
    ret 0;
}

test "vfs: a root with a trailing slash does not double it" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = res_root;

    res_root = "assets/";
    val r: Result[str, str] = vfs_resolve(?a, "res://hero.qoi");
    if (is_err[str, str](r)) { ret 1; }
    # Both spellings of a root are natural to write, so both must land here
    if (!str_equals(unwrap_ok[str, str](r), "assets/hero.qoi")) { ret 1; }

    res_root = saved;
    ret 0;
}

test "vfs: an absolute root works, including one that is only a slash" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = res_root;

    res_root = "/opt/game/data";
    val r: Result[str, str] = vfs_resolve(?a, "res://hero.qoi");
    if (!str_equals(unwrap_ok[str, str](r), "/opt/game/data/hero.qoi")) { ret 1; }

    res_root = "/";
    val r2: Result[str, str] = vfs_resolve(?a, "res://hero.qoi");
    if (!str_equals(unwrap_ok[str, str](r2), "/hero.qoi")) { ret 1; }

    res_root = saved;
    ret 0;
}

test "vfs: a bare path passes through unchanged" {
    var a: allo.Allocator;
    page.make(?a);
    val r: Result[str, str] = vfs_resolve(?a, "some/plain/path.txt");
    if (is_err[str, str](r)) { ret 1; }
    if (!str_equals(unwrap_ok[str, str](r), "some/plain/path.txt")) { ret 1; }
    if (vfs_has_scheme("some/plain/path.txt")) { ret 1; }
    ret 0;
}

test "vfs: :// after a separator is a directory, not a scheme" {
    # A path like `weird/a://b` names a directory that happens to contain the
    # characters. treating it as a scheme would silently redirect the lookup.
    if (vfs_has_scheme("weird/a://b")) { ret 1; }
    var a: allo.Allocator;
    page.make(?a);
    val r: Result[str, str] = vfs_resolve(?a, "weird/a://b");
    if (!str_equals(unwrap_ok[str, str](r), "weird/a://b")) { ret 1; }
    ret 0;
}

test "vfs: an unknown scheme is an error, not a silent passthrough" {
    var a: allo.Allocator;
    page.make(?a);
    # Passing it through would resolve `bogus://x` against the working
    # directory and fail later with a confusing not-found
    if (!is_err[str, str](vfs_resolve(?a, "bogus://x"))) { ret 1; }
    ret 0;
}

test "vfs: a registered scheme resolves, and re-registering replaces it" {
    var a: allo.Allocator;
    page.make(?a);

    if (!vfs_register("mods", "mods/enabled")) { ret 1; }
    val r: Result[str, str] = vfs_resolve(?a, "mods://weapons.pack");
    if (is_err[str, str](r)) { ret 1; }
    if (!str_equals(unwrap_ok[str, str](r), "mods/enabled/weapons.pack")) { ret 1; }

    # Re-registering must replace rather than append, so a reload does not
    # leak table entries or leave the old root shadowing the new one
    if (!vfs_register("mods", "other")) { ret 1; }
    val r2: Result[str, str] = vfs_resolve(?a, "mods://weapons.pack");
    if (!str_equals(unwrap_ok[str, str](r2), "other/weapons.pack")) { ret 1; }
    ret 0;
}

test "vfs: user:// honours an explicit override" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = user_root;

    user_root = "/tmp/game-state";
    val r: Result[str, str] = vfs_resolve(?a, "user://save1.dat");
    user_root = saved;
    if (is_err[str, str](r)) { ret 1; }
    if (!str_equals(unwrap_ok[str, str](r), "/tmp/game-state/save1.dat")) { ret 1; }
    ret 0;
}

test "vfs: an explicit user root is already application scoped" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = user_root;

    user_root = "/tmp/portable-ludus";
    val r: Result[str, str] = vfs_user_data_root(
        ?a, "briar-systems", "ludus");
    user_root = saved;
    if (is_err[str, str](r)) { ret 1; }
    val root: str = unwrap_ok[str, str](r);
    if (!str_equals(root, "/tmp/portable-ludus")) { ret 2; }
    allo.deallocate[u8](?a, root, str_len(root) + 1);
    ret 0;
}

test "vfs: user data namespaces are single path components" {
    var a: allo.Allocator;
    page.make(?a);
    if (!is_err[str, str](vfs_user_data_root(?a, "..", "ludus"))) { ret 1; }
    if (!is_err[str, str](vfs_user_data_root(?a, "briar/systems", "ludus"))) {
        ret 2;
    }
    if (!is_err[str, str](vfs_user_data_root(?a, "briar\\systems", "ludus"))) {
        ret 3;
    }
    if (!is_err[str, str](vfs_user_data_root(?a, "briar:systems", "ludus"))) {
        ret 4;
    }
    if (!is_err[str, str](vfs_user_data_root(?a, "briar-systems.", "ludus"))) {
        ret 5;
    }
    if (!is_err[str, str](vfs_user_data_root(?a, "briar-systems", "CON.log"))) {
        ret 6;
    }
    if (!is_err[str, str](vfs_user_data_root(?a, "briar-systems", "lPt9"))) {
        ret 7;
    }
    if (!is_err[str, str](vfs_user_data_root(?a, "briar-systems", ""))) { ret 8; }
    ret 0;
}

test "vfs: user:// derives a root or reports missing platform state" {
    var a: allo.Allocator;
    page.make(?a);
    val saved: str = user_root;
    user_root = "";

    val r: Result[str, str] = vfs_resolve(?a, "user://save1.dat");
    user_root = saved;
    # Sandboxed processes may expose no HOME or platform data directory. that
    # is an explicit error instead of writing into the working directory.
    if (is_err[str, str](r)) { ret 0; }
    if (str_len(unwrap_ok[str, str](r)) == 0) { ret 1; }
    ret 0;
}

test "vfs: the built-in schemes are refused rather than silently ignored" {
    # An entry named res or user can never be consulted, because vfs_resolve
    # answers those from res_root and user_root first. Accepting one and
    # reporting success is worse than refusing: the caller believes it has
    # redirected res:// and every asset then loads from the old root.
    if (vfs_register("res", "/tmp/somewhere"))  { ret 1; }
    if (vfs_register("user", "/tmp/elsewhere")) { ret 2; }

    # And the refusal must not have consumed a slot or shadowed the real root.
    var a: allo.Allocator;
    page.make(?a);
    val r: Result[str, str] = vfs_resolve(?a, "res://sprite.qoi");
    if (is_err[str, str](r)) { ret 3; }
    if (!str_equals(unwrap_ok[str, str](r), "res/sprite.qoi")) { ret 4; }
    ret 0;
}

test "vfs: res_root is what redirects the res scheme" {
    # The supported way to do what vfs_register("res", ...) looks like it does.
    val saved: str = res_root;
    res_root = "assets/packed";
    var a: allo.Allocator;
    page.make(?a);
    val r: Result[str, str] = vfs_resolve(?a, "res://sprite.qoi");
    res_root = saved;
    if (is_err[str, str](r)) { ret 1; }
    if (!str_equals(unwrap_ok[str, str](r), "assets/packed/sprite.qoi")) { ret 2; }
    ret 0;
}
