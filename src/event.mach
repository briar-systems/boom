# input event queue
#
# a fixed-capacity ring buffer of input events. the window layer pushes
# events as they arrive from the platform; the game drains them once per
# frame. push and pop are O(1) and never allocate; a push onto a full
# queue is refused rather than overwriting unread events.

use inp:  boom.input;
use allo: std.allocator;
use std.allocator.page;
use std.memory;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

# capacity of an EventQueue's backing ring, in events
pub val CAPACITY: usize = 256;

# what happened to a key
# ---
# press:   the key went down
# release: the key came up
# repeat:  the platform's autorepeat fired while the key was held
pub tag KeyAction: u8 {
    press;
    release;
    repeat;
}

# a keyboard key changed state
# ---
# key:    the boom key, KEY_UNKNOWN for a key boom does not name
# action: press, release, or autorepeat
# mods:   the boom.input MOD_* bits held at the time
pub rec KeyEvent {
    key:    inp.Key;
    action: KeyAction;
    mods:   i32;
}

# a mouse button changed state
# ---
# button: the boom button
# down:   true when the button went down, false when it came up
# mods:   the boom.input MOD_* bits held at the time
pub rec ButtonEvent {
    button: inp.Button;
    down:   bool;
    mods:   i32;
}

# the cursor moved
# ---
# x: cursor x in framebuffer pixels
# y: cursor y in framebuffer pixels
pub rec MoveEvent {
    x: f64;
    y: f64;
}

# the scroll wheel moved
# ---
# dx: horizontal scroll offset
# dy: vertical scroll offset
pub rec ScrollEvent {
    dx: f64;
    dy: f64;
}

# the framebuffer was resized
# ---
# width:  new framebuffer width in pixels
# height: new framebuffer height in pixels
pub rec ResizeEvent {
    width:  i32;
    height: i32;
}

# the pointer entered or left the window
# ---
# inside: true when it entered, false when it left
pub rec PointerEvent {
    inside: bool;
}

# text was typed
#
# GLFW reports the unicode codepoint after keyboard layout, shift and dead keys
# are applied. it is independent of KeyEvent: a key press may produce no text
# (a modifier, an arrow), one codepoint, or several in a row (an IME commit),
# and text arrives from the same press that queued the key event, after it.
# a consumer reading typed text uses text and ignores key for that purpose.
# ---
# codepoint: unicode scalar value
pub rec TextEvent {
    codepoint: u32;
}

# the allocation behind a DropEvent: this header, then the path table, then
# the path bytes, all in one block
# ---
# next: the next lent block, while the queue holds this one until release
# size: bytes in the whole block
pub rec DropBlock {
    next: *DropBlock;
    size: usize;
}

# files were dropped on the window
#
# one event carries every path of one drop, in the order the platform listed
# them. the paths are owned by the event queue, never by the consumer: they
# stay valid from the moment the event is popped until the next window_poll,
# which releases them before it fetches new events, and are freed then. a consumer that wants a path past that point copies it. an event still
# queued when that happens is not affected: only popped events are released,
# and queue_clear frees the ones never popped. because the queue owns the
# block, copying the event by value copies a borrow, not the ownership.
# ---
# count: number of paths
# paths: count null-terminated UTF-8 paths, valid until the next release
# block: the owning allocation, for the queue alone
pub rec DropEvent {
    count: usize;
    paths: *str;
    block: *DropBlock;
}

# one input event
# ---
# close:        the window was asked to close
# key:          a keyboard key changed state
# mouse_button: a mouse button changed state
# mouse_move:   the cursor moved
# scroll:       the scroll wheel moved
# resize:       the framebuffer was resized
# text:         a unicode codepoint was typed
# drop:         files were dropped on the window
# pointer:      the pointer entered or left the window
pub tag Event: u8 {
    close;
    key:          KeyEvent;
    mouse_button: ButtonEvent;
    mouse_move:   MoveEvent;
    scroll:       ScrollEvent;
    resize:       ResizeEvent;
    text:         TextEvent;
    drop:         DropEvent;
    pointer:      PointerEvent;
}

# why an event was not queued
# ---
# full: the queue already holds CAPACITY unread events
pub tag QueueError: u8 {
    full;
}

# a one-line description of a queue failure
# ---
# e:   the failure
# ret: static text naming the case
pub fun queue_error_message(e: QueueError) str {
    ret "the event queue is full";
}

# a fixed-capacity ring buffer of events
# ---
# events: backing storage
# head:   index of the oldest queued event
# len:    number of queued events
# lent:   drop blocks whose events were popped, freed by the next release
pub rec EventQueue {
    events: [CAPACITY]Event;
    head:   usize;
    len:    usize;
    lent:   *DropBlock;
}

# create an empty event queue
# ---
# ret: an EventQueue holding no events
pub fun queue_new() EventQueue {
    var q: EventQueue;
    q.head = 0;
    q.len  = 0;
    q.lent = nil;
    ret q;
}

# the number of events currently queued
# ---
# q:   queue to query
# ret: count of unread events
pub fun queue_len(q: *EventQueue) usize {
    ret q.len;
}

# whether the queue holds no events
# ---
# q:   queue to query
# ret: true if empty
pub fun queue_is_empty(q: *EventQueue) bool {
    ret q.len == 0;
}

# whether the queue cannot accept another event
# ---
# q:   queue to query
# ret: true if at capacity
pub fun queue_is_full(q: *EventQueue) bool {
    ret q.len >= CAPACITY;
}

# append an event to the back of the queue
#
# a full queue refuses the event and leaves the queued events untouched. a
# refused drop event is freed here, since the queue took ownership of its
# paths on the call either way.
# ---
# q:   queue to append to
# e:   event to enqueue
# ret: ok, or full when the queue is at capacity
pub fun queue_push(q: *EventQueue, e: Event) err[QueueError] {
    if (q.len >= CAPACITY) {
        if (sel e.drop) { drop_free(e.drop.block); }
        ret err[QueueError].err{QueueError.full{}};
    }
    val slot: usize = (q.head + q.len) % CAPACITY;
    q.events[slot] = e;
    q.len          = q.len + 1;
    ret err[QueueError].ok{};
}

# remove and return the oldest event
# ---
# q:   queue to drain from
# ret: the dequeued event, or none when the queue is empty
pub fun queue_pop(q: *EventQueue) opt[Event] {
    if (q.len == 0) { ret opt[Event].none{}; }
    val e: Event = q.events[q.head];
    q.head = (q.head + 1) % CAPACITY;
    q.len  = q.len - 1;
    # the popped paths stay readable, so the block waits on the lent list
    if (sel e.drop) {
        e.drop.block.next = q.lent;
        q.lent            = e.drop.block;
    }
    ret opt[Event].some{e};
}

# free the paths of every drop event popped since the last release
#
# window_poll calls this for the window's queue, so no event loop has to. it
# is public only because the window module lives outside this one. events still
# queued keep their paths.
# ---
# q: queue whose lent drop paths are freed
pub fun queue_release(q: *EventQueue) {
    for (q.lent != nil) {
        val next: *DropBlock = q.lent.next;
        drop_free(q.lent);
        q.lent = next;
    }
}

# discard every queued event, and free every drop path the queue holds
# ---
# q: queue to empty
pub fun queue_clear(q: *EventQueue) {
    var i: usize = 0;
    for (i < q.len) {
        val e: Event = q.events[(q.head + i) % CAPACITY];
        if (sel e.drop) { drop_free(e.drop.block); }
        i = i + 1;
    }
    queue_release(q);
    q.head = 0;
    q.len  = 0;
}

# copy a platform path list into one owned block
#
# the platform's paths die when its callback returns, so the event takes its
# own copy. one allocation holds the header, the path table and the bytes, so
# freeing is one call and a drop costs one allocation however many files it has.
# ---
# count: number of paths
# paths: count null-terminated paths
# ret:   the event, whose block the queue owns once it is pushed, or the refusal
pub fun drop_new(count: usize, paths: **u8) res[DropEvent, allo.Error] {
    var a: allo.Allocator;
    page.make(?a);
    val head: usize = $size_of(DropBlock);
    var size: usize = head + count * $size_of(str);
    var i:    usize = 0;
    for (i < count) {
        size = size + str_len(paths[i]::str) + 1;
        i    = i + 1;
    }
    val got: res[ptr, allo.Error] = allo.allocate_raw(?a, size, $align_of(DropBlock));
    if (sel got.err) { ret res[DropEvent, allo.Error].err{got.err}; }
    val base: usize = got.ok::usize;
    @(got.ok::*DropBlock) = DropBlock{next: nil, size: size};
    val table: *str  = (base + head)::*str;
    var at:    usize = base + head + count * $size_of(str);
    i = 0;
    for (i < count) {
        val n: usize = str_len(paths[i]::str) + 1;
        memory.raw_copy(at::ptr, paths[i]::ptr, n);
        table[i] = at::str;
        at       = at + n;
        i        = i + 1;
    }
    ret res[DropEvent, allo.Error].ok{DropEvent{count: count, paths: table, block: got.ok::*DropBlock}};
}

# free a drop block
fun drop_free(b: *DropBlock) {
    var a: allo.Allocator;
    page.make(?a);
    allo.deallocate_raw(?a, b::ptr, b.size, $align_of(DropBlock));
}

# whether a push was accepted
#[testing]
fun pushed(q: *EventQueue, e: Event) bool {
    val r: err[QueueError] = queue_push(q, e);
    ret sel r.ok;
}

# a key event with no modifiers
#[testing]
fun key(k: i64) Event {
    ret Event.key{KeyEvent{key: k::inp.Key, action: KeyAction.press{}, mods: 0}};
}

# the key of a popped key event, or -1 for anything else
#[testing]
fun popped_key(q: *EventQueue) i64 {
    val e: opt[Event] = queue_pop(q);
    if (sel e.some) {
        if (sel e.some.key) { ret e.some.key.key::i64; }
    }
    ret -1;
}

test queue__fifo {
    var q:    EventQueue = queue_new();
    val none: opt[Event] = queue_pop(?q);
    if (!sel none.none)      { ret 1; }
    if (!pushed(?q, key(1))) { ret 2; }
    if (!pushed(?q, key(2))) { ret 3; }
    if (popped_key(?q) != 1) { ret 4; }
    if (popped_key(?q) != 2) { ret 5; }
    if (!queue_is_empty(?q)) { ret 6; }
    ret 0;
}

test queue_push__full_refused {
    var q: EventQueue = queue_new();
    var i: usize      = 0;
    for (i < CAPACITY) {
        if (!pushed(?q, key(i::i64))) { ret 1; }
        i = i + 1;
    }
    if (!queue_is_full(?q)) { ret 2; }
    val refused: err[QueueError] = queue_push(?q, key(999));
    if (!sel refused.err)          { ret 3; }
    if (!sel refused.err.full)     { ret 4; }
    if (queue_len(?q) != CAPACITY) { ret 5; }
    ret 0;
}

test queue_push__wraps_ring {
    var q: EventQueue = queue_new();
    # fill, drain most, then push past the physical end of the ring
    var i: usize = 0;
    for (i < CAPACITY) {
        if (!pushed(?q, key(i::i64))) { ret 1; }
        i = i + 1;
    }
    var k: usize = 0;
    for (k < 200) {
        val drained: opt[Event] = queue_pop(?q);
        if (!sel drained.some) { ret 2; }
        k = k + 1;
    }
    # 56 remain (indices 200..255); pushing wraps into freed low slots
    var j: usize = 0;
    for (j < 200) {
        val moved: Event = Event.mouse_move{MoveEvent{x: 1000.0 + j::f64, y: 0.0}};
        if (!pushed(?q, moved)) { ret 3; }
        j = j + 1;
    }
    if (queue_len(?q) != 256) { ret 4; }
    # the first remaining event is still the oldest undrained one
    if (popped_key(?q) != 200) { ret 5; }
    ret 0;
}
