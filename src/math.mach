fwd transform.transform_matrix;
fwd boom.math.mat.mat4_project_point;
fwd boom.math.ray.Ray;
fwd boom.math.ray.ray;
fwd boom.math.ray.ray_at;
fwd boom.math.ray.ray_plane_y;
fwd boom.math.aabb.Aabb;
fwd boom.math.aabb.aabb_empty;
fwd boom.math.aabb.aabb_is_empty;
fwd boom.math.aabb.aabb_add;
fwd boom.math.aabb.aabb_union;
