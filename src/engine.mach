# the main loop that drives an App against a Context
#
# run ties the pieces together: it calls the App's lifecycle hooks around
# a frame loop that polls input, advances the clock, drains the fixed-
# timestep accumulator into update calls, and renders once with the
# leftover interpolation factor. it lives here rather than on the Context
# because the loop depends on both boom.context and boom.app, and mach
# forbids the circular module dependency that owning it on the Context
# would create (boom.app already depends on boom.context).
#
# the Context must be initialized (see boom.context.context_init) before
# run and shut down after it.

use boom.app.App;
use boom.clock.clock_advance;
use boom.clock.clock_tick;
use boom.context.Context;
use boom.context.Wake;
use boom.gamepad.gamepad_poll;
use inp: boom.input;
use boom.timestep.timestep_add;
use boom.timestep.timestep_alpha;
use boom.timestep.timestep_step;
use boom.window.window_poll;
use boom.window.window_refresh_size;
use boom.window.window_should_close;
use boom.window.window_wait;
use boom.window.window_wait_timeout;
use std.chrono.duration.Duration;
use std.chrono.duration.SECOND;
use std.chrono.time.InstantClock;
use std.chrono.time.instant;
use std.chrono.time.instant_sub;
use io_error: std.io.error;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

# why the frame loop stopped on its own account
# ---
# clock: the monotonic clock could not be read
pub tag EngineError: u8 {
    clock: io_error.Error;
}

# a one-line description of a frame loop failure
# ---
# e:   the failure
# ret: static text naming the case
pub fun engine_error_message(e: EngineError) str {
    ret "could not read the monotonic clock";
}

fun invoke(hook: fun(*Context), ctx: *Context) {
    if (hook != nil) {
        hook(ctx);
    }
}

fun tick_pending(ctx: *Context, app: *App) {
    for (ctx.running && timestep_step(?ctx.step)) {
        # fold input exactly once per tick, immediately before the tick sees
        # it. a frame running three ticks shows a press to the first only, and
        # a frame running none leaves it pending for whichever tick is next.
        inp.input_begin_tick(?ctx.input);
        invoke(app.f_tick, ctx);
    }
}

# what the last frame asked of this one's start, clearing the request for the
# next frame: at once when nothing asked or the frame delta is pinned
fun take_wake(ctx: *Context) Wake {
    val w: opt[Wake] = ctx.wake;
    ctx.wake = opt[Wake].none{};
    if (ctx.frame_dt != 0) { ret Wake.now{}; }
    if (sel w.some)        { ret w.some; }
    ret Wake.now{};
}

# take the platform's events, first sleeping as long as the last frame asked
# (see boom.context.context_wake)
fun await_events(ctx: *Context) {
    val w: Wake = take_wake(ctx);
    if (sel w.now) {
        window_poll();
        ret;
    }
    if (sel w.input) {
        window_wait();
        ret;
    }
    if (sel w.at) {
        # a clock that cannot be read is reported by the clock_tick that follows
        val now: InstantClock = instant();
        if (sel now.ok) {
            val left: Duration = w.at - instant_sub(now.ok, ctx.clock.start);
            window_wait_timeout(left::f64 / SECOND::f64);
            ret;
        }
    }
    window_poll();
}

# drive the app's lifecycle over an initialized context
#
# calls f_init once, then loops until the context is stopped or the
# window is closed: each frame takes input (sleeping first when the last
# frame asked to, see boom.context.context_wake), advances the clock, runs the
# fixed-timestep update as many times as the accumulator allows, sets
# ctx.alpha, and renders via f_draw. calls f_dnit once on exit. absent
# hooks are skipped. the context status is returned after teardown. a loop
# the engine itself cannot continue still calls f_dnit and reports why.
#
# the loop does not present: a Renderer brackets its own frame with an
# acquire and a present. what the loop owns is the timing, the input fold,
# and keeping ctx.window's size true.
# ---
# ctx: initialized engine context to run
# app: lifecycle hooks to drive
# ret: the context's final process status, or why the loop could not continue
pub fun run(ctx: *Context, app: *App) res[i64, EngineError] {
    invoke(app.f_init, ctx);

    for (ctx.running && !window_should_close(?ctx.window)) {
        await_events(ctx);
        # Pads have no events to deliver, so they are sampled once per frame
        # here. The edges this produces still belong to a tick, because
        # input_begin_tick folds them like every other edge.
        gamepad_poll(?ctx.input);
        # A window is resizable, so its size is not fixed at open. Refreshing
        # here rather than in a callback means a game reading ctx.window.width
        # during a tick or a draw sees one value for the whole frame, instead
        # of one that can change between two draws in the same frame.
        window_refresh_size(?ctx.window);
        # A pinned frame delta makes the run a function of its inputs rather
        # than of how busy the machine was. Everything downstream reads the
        # clock the same way either side of this.
        if (ctx.frame_dt != 0) { clock_advance(?ctx.clock, ctx.frame_dt); }
        or {
            val ticked: err[io_error.Error] = clock_tick(?ctx.clock);
            if (sel ticked.err) {
                ctx.running = false;
                invoke(app.f_dnit, ctx);
                ret res[i64, EngineError].err{EngineError.clock{ticked.err}};
            }
        }

        timestep_add(?ctx.step, ctx.clock.delta);
        tick_pending(ctx, app);

        if (ctx.running) {
            ctx.alpha = timestep_alpha(?ctx.step);
            # The renderer brackets its own frame with an acquire and a present,
            # so the loop no longer swaps the window after drawing. Under GL the
            # swap was the loop's because several renderers could composite into
            # one frame; a Vulkan frame is one command buffer between one acquire
            # and one present, and that bracket belongs to the renderer.
            invoke(app.f_draw, ctx);
        }
    }

    invoke(app.f_dnit, ctx);
    ret res[i64, EngineError].ok{ctx.status};
}

use boom.context.context_set_user;
use boom.context.context_stop;
use boom.context.context_user;
use boom.context.context_wake;
use boom.timestep.timestep_new;
use std.types.bool.true;

#[testing]
fun stop_on_tick(ctx: *Context) {
    val ticks: *i64 = context_user(ctx)::*i64;
    @ticks = @ticks + 1;
    context_stop(ctx);
}

test tick_pending__stop_leaves_backlog {
    var ticks: i64 = 0;
    var ctx:   Context;
    ctx.running = true;
    ctx.input   = inp.input_new();
    ctx.step    = timestep_new(10, 100);
    timestep_add(?ctx.step, 35);
    context_set_user(?ctx, (?ticks)::ptr);

    var app: App;
    app.f_init = nil::fun(*Context);
    app.f_tick = stop_on_tick;
    app.f_draw = nil::fun(*Context);
    app.f_dnit = nil::fun(*Context);

    tick_pending(?ctx, ?app);
    if (ticks != 1)                 { ret 1; }
    if (ctx.step.accumulator != 25) { ret 2; }
    ret 0;
}

test take_wake__an_idle_frame_sleeps_until_input {
    var ctx: Context;
    ctx.frame_dt = 0;
    ctx.wake     = opt[Wake].none{};
    # an interface with nothing moving asks to sleep, and the loop does
    context_wake(?ctx, Wake.input{});
    val idle: Wake = take_wake(?ctx);
    if (!sel idle.input) { ret 1; }
    # the request held for one frame: one that asks nothing runs at once
    val busy: Wake = take_wake(?ctx);
    if (!sel busy.now) { ret 2; }
    context_wake(?ctx, Wake.at{7});
    context_wake(?ctx, Wake.input{});
    val timed: Wake = take_wake(?ctx);
    if (!sel timed.at) { ret 3; }
    if (timed.at != 7) { ret 3; }
    # a pinned frame delta never sleeps
    ctx.frame_dt = 10;
    context_wake(?ctx, Wake.input{});
    val pinned: Wake = take_wake(?ctx);
    if (!sel pinned.now) { ret 4; }
    ret 0;
}
