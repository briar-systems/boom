# the main loop that drives an App against a Context
#
# run ties the pieces together: it calls the App's lifecycle hooks around
# a frame loop that polls input, advances the clock, drains the fixed-
# timestep accumulator into update calls, and renders once with the
# leftover interpolation factor. it lives here rather than on the Context
# because the loop depends on both boom.context and boom.app, and mach
# forbids the circular module dependency that owning it on the Context
# would create (boom.app already depends on boom.context).
#
# the Context must be initialized (see boom.context.context_init) before
# run and shut down after it.

use boom.context.Context;
use boom.app.App;
use inp: boom.input;
use phy: boom.physics;
use boom.window.window_should_close;
use boom.window.window_poll;
use boom.window.window_refresh_size;
use boom.clock.clock_tick;
use boom.timestep.timestep_add;
use boom.timestep.timestep_step;
use boom.timestep.timestep_alpha;
use boom.timestep.timestep_dt_seconds;

fun invoke(hook: fun(*Context), ctx: *Context) {
    if (hook != nil) {
        hook(ctx);
    }
}

# drive the app's lifecycle over an initialized context
#
# calls f_init once, then loops until the context is stopped or the
# window is closed: each frame polls input, advances the clock, runs the
# fixed-timestep update as many times as the accumulator allows, sets
# ctx.alpha, and renders via f_draw. calls f_dnit once on exit. absent
# hooks are skipped.
#
# the loop does not present: a Renderer brackets its own frame with an
# acquire and a present. what the loop owns is the timing, the input fold,
# and keeping ctx.window's size true.
# ---
# ctx: initialized engine context to run
# app: lifecycle hooks to drive
pub fun run(ctx: *Context, app: *App) {
    invoke(app.f_init, ctx);

    for (ctx.running && !window_should_close(?ctx.window)) {
        window_poll();
        # A window is resizable, so its size is not fixed at open. Refreshing
        # here rather than in a callback means a game reading ctx.window.width
        # during a tick or a draw sees one value for the whole frame, instead
        # of one that can change between two draws in the same frame.
        window_refresh_size(?ctx.window);
        clock_tick(?ctx.clock);

        timestep_add(?ctx.step, ctx.clock.delta);
        for (timestep_step(?ctx.step)) {
            # fold input exactly once per tick, immediately before the tick
            # sees it. this is what makes an edge belong to one tick: a frame
            # running three ticks shows the press to the first only, and a
            # frame running none leaves it pending for whichever tick is next.
            inp.input_begin_tick(?ctx.input);
            # Physics runs before the tick so a game reacts to this step's
            # collisions in the same tick they happened.
            phy.physics_step(?ctx.physics, ?ctx.events, timestep_dt_seconds(?ctx.step));
            invoke(app.f_tick, ctx);
        }

        ctx.alpha = timestep_alpha(?ctx.step);
        # The renderer brackets its own frame with an acquire and a present,
        # so the loop no longer swaps the window after drawing. Under GL the
        # swap was the loop's because several renderers could composite into
        # one frame; a Vulkan frame is one command buffer between one acquire
        # and one present, and that bracket belongs to the renderer.
        invoke(app.f_draw, ctx);
    }

    invoke(app.f_dnit, ctx);
}
