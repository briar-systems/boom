# The frame loop: render pass, framebuffers, command buffers, and synchronization.
#
# Third and last of the shader-independent steps of the Vulkan migration. With
# this, a frame can be acquired, cleared, and presented without any shader
# existing, which is what makes the whole path verifiable before the sampler
# binding lands.
#
# FRAMES IN FLIGHT. The CPU runs ahead of the GPU by up to MAX_FRAMES_IN_FLIGHT
# frames. Each in-flight frame owns its own command buffer, its own semaphores,
# and its own fence, because reusing any of them while the GPU still reads them
# is a data race the validation layers catch and a driver does not.
#
# The fence is waited on before reusing a frame's command buffer, which is what
# bounds the CPU's lead. Without it the CPU would queue frames without limit
# and latency would grow until memory ran out.
#
# TWO SEMAPHORES PER FRAME, not one. `available` orders acquire before render;
# `finished` orders render before present. They guard different handoffs and
# collapsing them to one lets presentation begin before rendering completes.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use vk;
use boom.graphics.error.Error;
use boom.graphics.error.error;
use boom.graphics.vk.Vk;
use boom.graphics.swapchain.Swapchain;
use boom.graphics.swapchain.MAX_IMAGES;

# How far the CPU may run ahead of the GPU.
#
# Two is the usual choice: one frame being recorded while another is executing.
# Three trades latency for throughput and is not what a game wants by default.
pub val MAX_FRAMES_IN_FLIGHT: usize = 2;

# Nanoseconds to wait on a fence before treating the GPU as hung.
val FENCE_TIMEOUT: u64 = 1000000000;

# Per-frame state, one set per in-flight frame.
# ---
# command:   Command buffer recorded this frame.
# available: Signalled when the acquired image is ready to render into.
# finished:  Signalled when rendering is done and presentation may begin.
# in_flight: Signalled when this frame's command buffer is reusable.
rec Frame {
    command:   vk.CommandBuffer;
    available: vk.Semaphore;
    finished:  vk.Semaphore;
    in_flight: vk.Fence;
}

# The frame loop's resources.
# ---
# pass:         Render pass, one colour attachment cleared on load.
# pool:         Command pool the frames allocate from.
# framebuffers: One per swapchain image.
# fb_count:     Number of valid framebuffers.
# frames:       Per-frame state.
# current:      Which in-flight frame is next.
# image_index:  Swapchain image acquired this frame.
# ready:        Whether creation completed.
pub rec FrameLoop {
    pass:         vk.RenderPass;
    pool:         vk.CommandPool;
    framebuffers: [8]vk.Framebuffer;
    fb_count:     u32;
    frames:       [2]Frame;
    current:      usize;
    image_index:  u32;
    ready:        bool;
}

# Create the render pass, pool, framebuffers, and per-frame objects.
pub fun frame_init(f: *FrameLoop, v: *Vk, s: *Swapchain) Result[bool, Error] {
    f.ready   = false;
    f.current = 0;

    if (!v.ready || !s.ready) {
        ret err[bool, Error](error("device or swapchain is not initialized"));
    }

    val pr: Result[bool, Error] = make_pass(f, v, s);
    if (is_err[bool, Error](pr)) { ret pr; }

    var pci: vk.CommandPoolCreateInfo;
    pci.sType            = vk.STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
    pci.pNext            = nil;
    # Buffers are re-recorded every frame, so they must be individually
    # resettable. Without this flag a buffer can only be reset by resetting the
    # whole pool, which would clobber the other in-flight frame.
    pci.flags            = vk.COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
    pci.queueFamilyIndex = v.graphics_family;
    if (vk.vkCreateCommandPool(v.device, ?pci, nil, ?f.pool) != vk.SUCCESS) {
        ret err[bool, Error](error("vkCreateCommandPool failed"));
    }

    val fr: Result[bool, Error] = make_framebuffers(f, v, s);
    if (is_err[bool, Error](fr)) { ret fr; }

    var i: usize = 0;
    for (i < MAX_FRAMES_IN_FLIGHT) {
        var abi: vk.CommandBufferAllocateInfo;
        abi.sType              = vk.STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
        abi.pNext              = nil;
        abi.commandPool        = f.pool;
        abi.level              = vk.COMMAND_BUFFER_LEVEL_PRIMARY;
        abi.commandBufferCount = 1;
        if (vk.vkAllocateCommandBuffers(v.device, ?abi, ?f.frames[i].command) != vk.SUCCESS) {
            ret err[bool, Error](error("vkAllocateCommandBuffers failed"));
        }

        var sci: vk.SemaphoreCreateInfo;
        sci.sType = vk.STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
        sci.pNext = nil;
        sci.flags = 0;
        if (vk.vkCreateSemaphore(v.device, ?sci, nil, ?f.frames[i].available) != vk.SUCCESS) {
            ret err[bool, Error](error("vkCreateSemaphore failed"));
        }
        if (vk.vkCreateSemaphore(v.device, ?sci, nil, ?f.frames[i].finished) != vk.SUCCESS) {
            ret err[bool, Error](error("vkCreateSemaphore failed"));
        }

        var fci: vk.FenceCreateInfo;
        fci.sType = vk.STRUCTURE_TYPE_FENCE_CREATE_INFO;
        fci.pNext = nil;
        # Created signalled, so the first frame's wait returns immediately.
        # Unsignalled, the first frame would block forever on a fence nothing
        # has submitted work against.
        fci.flags = vk.FENCE_CREATE_SIGNALED_BIT;
        if (vk.vkCreateFence(v.device, ?fci, nil, ?f.frames[i].in_flight) != vk.SUCCESS) {
            ret err[bool, Error](error("vkCreateFence failed"));
        }
        i = i + 1;
    }

    f.ready = true;
    ret ok[bool, Error](true);
}

# A single-subpass render pass with one colour attachment.
fun make_pass(f: *FrameLoop, v: *Vk, s: *Swapchain) Result[bool, Error] {
    var att: vk.AttachmentDescription;
    att.flags          = 0;
    att.format         = s.format;
    att.samples        = vk.SAMPLE_COUNT_1_BIT::i32;
    att.loadOp         = vk.ATTACHMENT_LOAD_OP_CLEAR;
    att.storeOp        = vk.ATTACHMENT_STORE_OP_STORE;
    att.stencilLoadOp  = vk.ATTACHMENT_LOAD_OP_DONT_CARE;
    att.stencilStoreOp = vk.ATTACHMENT_STORE_OP_DONT_CARE;
    att.initialLayout  = vk.IMAGE_LAYOUT_UNDEFINED;
    att.finalLayout    = vk.IMAGE_LAYOUT_PRESENT_SRC_KHR;

    var ref: vk.AttachmentReference;
    ref.attachment = 0;
    ref.layout     = vk.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;

    var sub: vk.SubpassDescription;
    sub.flags                   = 0;
    sub.pipelineBindPoint       = vk.PIPELINE_BIND_POINT_GRAPHICS;
    sub.inputAttachmentCount    = 0;
    sub.pInputAttachments       = nil;
    sub.colorAttachmentCount    = 1;
    sub.pColorAttachments       = ?ref;
    sub.pResolveAttachments     = nil;
    sub.pDepthStencilAttachment = nil;
    sub.preserveAttachmentCount = 0;
    sub.pPreserveAttachments    = nil;

    # The external dependency makes the subpass wait for the acquire semaphore
    # at the colour-output stage. Without it the render pass may begin writing
    # the attachment before the image is actually available.
    var dep: vk.SubpassDependency;
    dep.srcSubpass      = vk.SUBPASS_EXTERNAL;
    dep.dstSubpass      = 0;
    dep.srcStageMask    = vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
    dep.dstStageMask    = vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
    dep.srcAccessMask   = 0;
    dep.dstAccessMask   = vk.ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
    dep.dependencyFlags = 0;

    var rci: vk.RenderPassCreateInfo;
    rci.sType           = vk.STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
    rci.pNext           = nil;
    rci.flags           = 0;
    rci.attachmentCount = 1;
    rci.pAttachments    = ?att;
    rci.subpassCount    = 1;
    rci.pSubpasses      = ?sub;
    rci.dependencyCount = 1;
    rci.pDependencies   = ?dep;

    if (vk.vkCreateRenderPass(v.device, ?rci, nil, ?f.pass) != vk.SUCCESS) {
        ret err[bool, Error](error("vkCreateRenderPass failed"));
    }
    ret ok[bool, Error](true);
}

# One framebuffer per swapchain image view.
fun make_framebuffers(f: *FrameLoop, v: *Vk, s: *Swapchain) Result[bool, Error] {
    f.fb_count = 0;
    var i: u32 = 0;
    for (i < s.count) {
        var view: vk.ImageView = s.views[i];
        var fci: vk.FramebufferCreateInfo;
        fci.sType           = vk.STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
        fci.pNext           = nil;
        fci.flags           = 0;
        fci.renderPass      = f.pass;
        fci.attachmentCount = 1;
        fci.pAttachments    = ?view;
        fci.width           = s.width;
        fci.height          = s.height;
        fci.layers          = 1;
        if (vk.vkCreateFramebuffer(v.device, ?fci, nil, ?f.framebuffers[i]) != vk.SUCCESS) {
            ret err[bool, Error](error("vkCreateFramebuffer failed"));
        }
        f.fb_count = f.fb_count + 1;
        i = i + 1;
    }
    ret ok[bool, Error](true);
}

# Begin a frame: wait for its fence, acquire an image, and start recording.
#
# Returns false when the swapchain is out of date, which is not an error: the
# caller rebuilds and tries again next frame. Treating it as a failure would
# make every window resize look like a crash.
pub fun frame_begin(f: *FrameLoop, v: *Vk, s: *Swapchain, out_ok: *bool) Result[bool, Error] {
    @out_ok = false;
    if (!f.ready) { ret err[bool, Error](error("frame loop is not initialized")); }

    val i: usize = f.current;

    # Bounds the CPU's lead over the GPU. Without it frames queue without limit.
    vk.vkWaitForFences(v.device, 1, ?f.frames[i].in_flight, vk.TRUE, FENCE_TIMEOUT);

    var index: u32 = 0;
    val ar: i32 = vk.vkAcquireNextImageKHR(v.device, s.handle, FENCE_TIMEOUT,
                                           f.frames[i].available, nil, ?index);
    if (ar == vk.ERROR_OUT_OF_DATE_KHR) { ret ok[bool, Error](true); }
    if (ar != vk.SUCCESS && ar != vk.SUBOPTIMAL_KHR) {
        ret err[bool, Error](error("vkAcquireNextImageKHR failed"));
    }
    f.image_index = index;

    # Reset only after the acquire succeeds. Resetting first would leave the
    # fence unsignalled with no submission to signal it, deadlocking the next
    # wait when the swapchain is out of date.
    vk.vkResetFences(v.device, 1, ?f.frames[i].in_flight);
    vk.vkResetCommandBuffer(f.frames[i].command, 0);

    var bi: vk.CommandBufferBeginInfo;
    bi.sType            = vk.STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
    bi.pNext            = nil;
    bi.flags            = 0;
    bi.pInheritanceInfo = nil;
    if (vk.vkBeginCommandBuffer(f.frames[i].command, ?bi) != vk.SUCCESS) {
        ret err[bool, Error](error("vkBeginCommandBuffer failed"));
    }

    var clear: vk.ClearValue;
    clear.color.float32[0] = 0.0;
    clear.color.float32[1] = 0.0;
    clear.color.float32[2] = 0.0;
    clear.color.float32[3] = 1.0;

    var rbi: vk.RenderPassBeginInfo;
    rbi.sType                    = vk.STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
    rbi.pNext                    = nil;
    rbi.renderPass               = f.pass;
    rbi.framebuffer              = f.framebuffers[index];
    rbi.renderArea.offset.x      = 0;
    rbi.renderArea.offset.y      = 0;
    rbi.renderArea.extent.width  = s.width;
    rbi.renderArea.extent.height = s.height;
    rbi.clearValueCount          = 1;
    rbi.pClearValues             = ?clear;
    vk.vkCmdBeginRenderPass(f.frames[i].command, ?rbi, vk.SUBPASS_CONTENTS_INLINE);

    @out_ok = true;
    ret ok[bool, Error](true);
}

# End the render pass, submit, and present.
#
# Returns false in out_ok when the swapchain needs rebuilding.
pub fun frame_end(f: *FrameLoop, v: *Vk, s: *Swapchain, out_ok: *bool) Result[bool, Error] {
    @out_ok = false;
    if (!f.ready) { ret err[bool, Error](error("frame loop is not initialized")); }

    val i: usize = f.current;
    vk.vkCmdEndRenderPass(f.frames[i].command);
    if (vk.vkEndCommandBuffer(f.frames[i].command) != vk.SUCCESS) {
        ret err[bool, Error](error("vkEndCommandBuffer failed"));
    }

    var wait_stage: u32 = vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
    var si: vk.SubmitInfo;
    si.sType                = vk.STRUCTURE_TYPE_SUBMIT_INFO;
    si.pNext                = nil;
    si.waitSemaphoreCount   = 1;
    si.pWaitSemaphores      = ?f.frames[i].available;
    si.pWaitDstStageMask    = ?wait_stage;
    si.commandBufferCount   = 1;
    si.pCommandBuffers      = ?f.frames[i].command;
    si.signalSemaphoreCount = 1;
    si.pSignalSemaphores    = ?f.frames[i].finished;

    if (vk.vkQueueSubmit(v.graphics_queue, 1, ?si, f.frames[i].in_flight) != vk.SUCCESS) {
        ret err[bool, Error](error("vkQueueSubmit failed"));
    }

    var index: u32 = f.image_index;
    var chain: vk.SwapchainKHR = s.handle;
    var pi: vk.PresentInfoKHR;
    pi.sType              = vk.STRUCTURE_TYPE_PRESENT_INFO_KHR;
    pi.pNext              = nil;
    pi.waitSemaphoreCount = 1;
    pi.pWaitSemaphores    = ?f.frames[i].finished;
    pi.swapchainCount     = 1;
    pi.pSwapchains        = ?chain;
    pi.pImageIndices      = ?index;
    pi.pResults           = nil;

    val prr: i32 = vk.vkQueuePresentKHR(v.present_queue, ?pi);

    # Advance regardless of the present result, so a rebuild does not leave two
    # frames sharing one set of synchronization objects.
    f.current = (f.current + 1) % MAX_FRAMES_IN_FLIGHT;

    if (prr == vk.ERROR_OUT_OF_DATE_KHR || prr == vk.SUBOPTIMAL_KHR) {
        ret ok[bool, Error](true);
    }
    if (prr != vk.SUCCESS) { ret err[bool, Error](error("vkQueuePresentKHR failed")); }

    @out_ok = true;
    ret ok[bool, Error](true);
}

# Destroy the framebuffers and render pass, keeping the pool and frames.
#
# Split out because a swapchain rebuild invalidates these and nothing else.
pub fun frame_release_targets(f: *FrameLoop, v: *Vk) {
    var i: u32 = 0;
    for (i < f.fb_count) {
        vk.vkDestroyFramebuffer(v.device, f.framebuffers[i], nil);
        i = i + 1;
    }
    f.fb_count = 0;
}

# Rebuild the framebuffers against a resized swapchain.
pub fun frame_rebuild_targets(f: *FrameLoop, v: *Vk, s: *Swapchain) Result[bool, Error] {
    frame_release_targets(f, v);
    ret make_framebuffers(f, v, s);
}

# Destroy everything, in reverse order of creation.
pub fun frame_dnit(f: *FrameLoop, v: *Vk) {
    if (!f.ready) { ret; }
    vk.vkDeviceWaitIdle(v.device);

    var i: usize = 0;
    for (i < MAX_FRAMES_IN_FLIGHT) {
        vk.vkDestroySemaphore(v.device, f.frames[i].available, nil);
        vk.vkDestroySemaphore(v.device, f.frames[i].finished, nil);
        vk.vkDestroyFence(v.device, f.frames[i].in_flight, nil);
        i = i + 1;
    }
    frame_release_targets(f, v);
    vk.vkDestroyCommandPool(v.device, f.pool, nil);
    vk.vkDestroyRenderPass(v.device, f.pass, nil);
    f.ready = false;
}

# --------------------------------------------------------------------- tests
#
# The loop needs a device, a surface, and a swapchain, so it is not reachable
# in CI. These cover the frame-index rotation, which is pure and is where an
# error makes two frames share one set of synchronization objects.

test "frame: the frame index rotates and wraps" {
    var f: FrameLoop;
    f.current = 0;
    var seen: [4]usize;
    var i: usize = 0;
    for (i < 4) {
        seen[i] = f.current;
        f.current = (f.current + 1) % MAX_FRAMES_IN_FLIGHT;
        i = i + 1;
    }
    # Two frames in flight, so the sequence is 0,1,0,1. A wrap that skipped or
    # repeated would let two frames share a command buffer and fence.
    if (seen[0] != 0 || seen[1] != 1) { ret 1; }
    if (seen[2] != 0 || seen[3] != 1) { ret 1; }
    ret 0;
}

test "frame: every in-flight frame has its own slot" {
    # One command buffer, two semaphores, and a fence per frame. Sharing any of
    # them across frames is the race this indexing exists to prevent.
    if (MAX_FRAMES_IN_FLIGHT < 2) { ret 1; }
    var f: FrameLoop;
    var i: usize = 0;
    for (i < MAX_FRAMES_IN_FLIGHT) {
        f.frames[i].command = nil;
        i = i + 1;
    }
    ret 0;
}

test "frame: teardown on an uninitialized loop is a no-op" {
    var f: FrameLoop;
    f.ready = false;
    var v: Vk;
    v.ready = false;
    frame_dnit(?f, ?v);
    if (f.ready) { ret 1; }
    ret 0;
}
