# the Shader handle: a compiled, linked GPU program
#
# a game authors GLSL against the standard convention (see the module
# docstring on boom.graphics) and receives an opaque Shader; the backing
# mach-gl program id stays hidden so a future SPIR-V/Vulkan backend can
# replace this file without changing game code. uniforms are set by name,
# which keeps the interface backend-agnostic: the GL backend resolves a
# name to a location, a Vulkan backend would resolve it to a binding.

use gl.gl;
use boom.graphics.error.Error;
use boom.graphics.error.ERROR_CAP;
use boom.math.mat.Mat4;
use boom.math.mat.mat4_ptr;
use boom.math.vec.Vec3;
use boom.math.vec.Vec4;
use boom.graphics.texture.Texture;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.types.bool.false;
use std.types.string.str;

# an opaque handle to a linked shader program
# ---
# program: the backing mach-gl program id, hidden from the game
pub rec Shader {
    program: u32;
}

# compile one shader stage, returning its id or a failure log
# ---
# stage:  a GL shader stage enum (gl.VERTEX_SHADER or gl.FRAGMENT_SHADER)
# source: the GLSL source, null-terminated
# ret:    the compiled shader id, or the compile log on failure
fun compile_stage(stage: u32, source: str) Result[u32, Error] {
    val id: u32 = gl.create_shader(stage);
    var src: *u8 = source:~*u8;
    var strings: **u8 = ?src;
    gl.shader_source(id, 1, strings, nil);
    gl.compile_shader(id);

    var status: i32 = 0;
    gl.get_shaderiv(id, gl.COMPILE_STATUS, ?status);
    if (status == 0) {
        var e: Error;
        gl.get_shader_info_log(id, ERROR_CAP::i32, nil, ?e.message[0]);
        gl.delete_shader(id);
        ret err[u32, Error](e);
    }
    ret ok[u32, Error](id);
}

# compile and link a vertex and fragment shader into a program
#
# on any compile or link failure the returned error carries the driver's
# log. the game never sees the GL program id, only the Shader handle.
# ---
# vertex_glsl:   GLSL vertex shader source, null-terminated
# fragment_glsl: GLSL fragment shader source, null-terminated
# ret:           the linked Shader, or the compile/link log on failure
pub fun shader(vertex_glsl: str, fragment_glsl: str) Result[Shader, Error] {
    val vs: Result[u32, Error] = compile_stage(gl.VERTEX_SHADER, vertex_glsl);
    if (is_err[u32, Error](vs)) {
        ret err[Shader, Error](unwrap_err[u32, Error](vs));
    }
    val vs_id: u32 = unwrap_ok[u32, Error](vs);

    val fs: Result[u32, Error] = compile_stage(gl.FRAGMENT_SHADER, fragment_glsl);
    if (is_err[u32, Error](fs)) {
        gl.delete_shader(vs_id);
        ret err[Shader, Error](unwrap_err[u32, Error](fs));
    }
    val fs_id: u32 = unwrap_ok[u32, Error](fs);

    val program: u32 = gl.create_program();
    gl.attach_shader(program, vs_id);
    gl.attach_shader(program, fs_id);
    gl.link_program(program);
    gl.delete_shader(vs_id);
    gl.delete_shader(fs_id);

    var status: i32 = 0;
    gl.get_programiv(program, gl.LINK_STATUS, ?status);
    if (status == 0) {
        var e: Error;
        gl.get_program_info_log(program, ERROR_CAP::i32, nil, ?e.message[0]);
        gl.delete_program(program);
        ret err[Shader, Error](e);
    }
    ret ok[Shader, Error](Shader{program: program});
}

# make a shader the active program for subsequent draws and uniform sets
# ---
# s: shader to bind
pub fun shader_use(s: *Shader) {
    gl.use_program(s.program);
}

# set a mat4 uniform by name
#
# binds the shader and uploads the matrix column-major. a name absent
# from the linked program is ignored, the normal GL behavior for a
# uniform the compiler stripped.
# ---
# s:    shader owning the uniform
# name: uniform name as declared in GLSL
# m:    matrix to upload
pub fun shader_set_mat4(s: *Shader, name: str, m: *Mat4) {
    gl.use_program(s.program);
    val loc: i32 = gl.get_uniform_location(s.program, name);
    if (loc < 0) {
        ret;
    }
    gl.uniform_matrix4fv(loc, 1, false, mat4_ptr(m));
}

# set a mat4-array uniform by name
#
# uploads count contiguous column-major matrices to a uniform array, such
# as a skinning palette bound to u_joints. the matrices must be laid out
# contiguously, as a Pose's palette is. a name absent from the linked
# program is ignored.
# ---
# s:     shader owning the uniform
# name:  uniform array name as declared in GLSL
# m:     pointer to the first of count contiguous matrices
# count: number of matrices to upload
pub fun shader_set_mat4_array(s: *Shader, name: str, m: *Mat4, count: i32) {
    gl.use_program(s.program);
    val loc: i32 = gl.get_uniform_location(s.program, name);
    if (loc < 0) {
        ret;
    }
    gl.uniform_matrix4fv(loc, count, false, mat4_ptr(m));
}

# set a vec3 uniform by name
# ---
# s:    shader owning the uniform
# name: uniform name as declared in GLSL
# v:    value to upload
pub fun shader_set_vec3(s: *Shader, name: str, v: Vec3) {
    gl.use_program(s.program);
    val loc: i32 = gl.get_uniform_location(s.program, name);
    if (loc < 0) {
        ret;
    }
    gl.uniform3f(loc, v.x, v.y, v.z);
}

# set a vec4 uniform by name
# ---
# s:    shader owning the uniform
# name: uniform name as declared in GLSL
# v:    value to upload
pub fun shader_set_vec4(s: *Shader, name: str, v: Vec4) {
    gl.use_program(s.program);
    val loc: i32 = gl.get_uniform_location(s.program, name);
    if (loc < 0) {
        ret;
    }
    gl.uniform4f(loc, v.x, v.y, v.z, v.w);
}

# set a float uniform by name
# ---
# s:    shader owning the uniform
# name: uniform name as declared in GLSL
# x:    value to upload
pub fun shader_set_f32(s: *Shader, name: str, x: f32) {
    gl.use_program(s.program);
    val loc: i32 = gl.get_uniform_location(s.program, name);
    if (loc < 0) {
        ret;
    }
    gl.uniform1f(loc, x);
}

# set an integer uniform by name
# ---
# s:    shader owning the uniform
# name: uniform name as declared in GLSL
# i:    value to upload
pub fun shader_set_i32(s: *Shader, name: str, i: i32) {
    gl.use_program(s.program);
    val loc: i32 = gl.get_uniform_location(s.program, name);
    if (loc < 0) {
        ret;
    }
    gl.uniform1i(loc, i);
}

# bind a texture to a unit and point a sampler uniform at it
# ---
# s:    shader owning the sampler
# name: sampler uniform name as declared in GLSL
# tex:  texture to bind
# unit: texture unit index to bind into
pub fun shader_set_texture(s: *Shader, name: str, tex: *Texture, unit: i32) {
    gl.use_program(s.program);
    val loc: i32 = gl.get_uniform_location(s.program, name);
    if (loc < 0) {
        ret;
    }
    gl.active_texture(gl.TEXTURE0 + unit::u32);
    gl.bind_texture(gl.TEXTURE_2D, tex.id);
    gl.uniform1i(loc, unit);
}

# release the GPU program backing a shader
# ---
# s: shader to delete; the handle must not be used afterward
pub fun shader_delete(s: *Shader) {
    gl.delete_program(s.program);
    s.program = 0;
}

test "shader: a fresh handle carries no program" {
    var s: Shader;
    if (s.program != 0) { ret 1; }
    ret 0;
}
