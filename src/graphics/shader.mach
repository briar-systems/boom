# A game's own shading, without a game touching Vulkan.
#
# WHAT THIS IS FOR. boom ships one lit program and does not intend to grow a
# lighting system: how a surface responds to light is a game's decision, and an
# engine that decided it would be wrong for the next game. So a game must be
# able to supply its own vertex and fragment stages and have boom draw with
# them. This is that, and it is the only supported way to do it.
#
# WHAT IT DELIBERATELY HIDES. A Vulkan pipeline is not a shader. It bakes the
# shader stages together with the vertex layout, the blend and depth state, and
# the render pass it will be used inside, so the same pair of shaders needs a
# different pipeline for every mesh layout and incompatible target signature. A
# game that had to manage that would be writing the bookkeeping this engine
# exists to have already written, and would get it wrong in a way that surfaces
# as a validation error rather than as a picture.
#
# So a Shader is the pair of SPIR-V modules and nothing else, and the pipelines
# are built underneath it, on demand, keyed by render-pass compatibility, depth
# convention, and the vertex layout each draw actually needs. A game creates
# one, draws with it, and
# deletes it.
# It never names a pipeline, a render pass, or a descriptor set.
#
# WHAT A GAME SHADER MUST DECLARE. The descriptor layout is fixed, because a
# game shader and a built-in one are drawn through the same slots:
#
#   binding 0  uniform  the transform block: view-projection and model
#   binding 1  sampler  the material's first texture
#   binding 2  uniform  the tint colour
#   binding 3  storage  the joint palette, for skinned draws
#   binding 4  uniform  the game's own block, set by pass_set_user
#
# A shader declares only what it reads. Binding 4 is where a game's shading
# parameters go, and it is the reason this is usable for lighting rather than
# only for shading with constants baked in.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.result.res;
use std.types.error.err;
use vk;
use boom.graphics.error.Error;
use boom.graphics.error.Stage;
use boom.graphics.error.ShaderError;
use boom.graphics.vk.Vk;
use boom.graphics.vk.vk_wait_idle;
use boom.graphics.device.Device;
use boom.graphics.vertex.VertexFormat;
use boom.graphics.vertex.vertex_format_eq;
use boom.graphics.vertex.vertex_format_standard;
use boom.graphics.vertex.vertex_format_skinned;
use boom.graphics.pipeline.Pipeline;
use boom.graphics.pipeline.PipelineDesc;
use boom.graphics.pipeline.pipeline_desc_3d;
use boom.graphics.pipeline.pipeline_init_depth;
use boom.graphics.pipeline.pipeline_dnit;
use boom.graphics.pipeline.SetLayout;
use boom.graphics.pipeline.set_layout_full;
use boom.graphics.pass.PassCompatibility;
use boom.graphics.pass.pass_compatibility_eq;
use boom.graphics.pass.pass_compatibility_one;
use boom.graphics.depth.DepthConvention;
use boom.graphics.depth.depth_convention_same;

# How many pipelines one shader may build.
#
# One per combination of render pass and vertex layout the shader is drawn
# with. the depth convention is another cache axis, so both conventions fit
# without taking capacity away from the usual layouts and targets.
pub val MAX_SHADER_PIPELINES: usize = 8;

# one built pipeline and the state it was built for
rec ShaderPipeline {
    compatibility: PassCompatibility;
    format:   VertexFormat;
    depth:    DepthConvention;
    pipeline: Pipeline;
    live:     bool;
}

# A game-supplied vertex and fragment stage.
#
# The SPIR-V is borrowed, not copied: it is almost always an `#[embed]`ed
# constant with the lifetime of the program. A caller passing a buffer it later
# frees must delete the shader first.
# ---
# vert:  the vertex stage's SPIR-V
# frag:  the fragment stage's SPIR-V
# desc:  the fixed-function state, from pipeline_desc_3d or pipeline_desc_2d
# built: pipelines built so far
pub rec Shader {
    vert:  *u8;
    vlen:  usize;
    frag:  *u8;
    flen:  usize;
    desc:  PipelineDesc;
    built: [8]ShaderPipeline;
    count: usize;
    ready: bool;
}

# Declare a shader from two SPIR-V modules.
#
# Nothing is built here: a pipeline needs a render pass and a vertex layout,
# and neither is known until a draw. This only records what the shader is, so
# it cannot fail for reasons a caller would have to handle at a distance from
# the mistake.
# ---
# s:    the shader to initialise
# vert: the vertex stage's SPIR-V bytes
# vlen: its length in bytes
# frag: the fragment stage's SPIR-V bytes
# flen: its length in bytes
pub fun shader(s: *Shader, vert: *u8, vlen: usize, frag: *u8, flen: usize) err[Error] {
    if (vert == nil || frag == nil) {
        ret err[Error].err{Error.shader{ShaderError.missing_stage{}}};
    }
    # SPIR-V is a stream of 32-bit words with a five-word header, so anything
    # shorter or misaligned is not a module and would be rejected far away from
    # here, inside pipeline creation, as an unexplained driver failure.
    if (vlen < 20 || (vlen % 4) != 0) {
        ret err[Error].err{Error.shader{ShaderError.spirv_words{vlen}}};
    }
    if (flen < 20 || (flen % 4) != 0) {
        ret err[Error].err{Error.shader{ShaderError.spirv_words{flen}}};
    }

    s.vert  = vert;
    s.vlen  = vlen;
    s.frag  = frag;
    s.flen  = flen;
    s.desc  = pipeline_desc_3d();
    s.count = 0;
    var i: usize = 0;
    for (i < MAX_SHADER_PIPELINES) {
        s.built[i].live = false;
        i = i + 1;
    }
    s.ready = true;
    ret err[Error].ok{};
}

# Choose the blend, depth and cull state the shader draws with.
#
# Defaults to pipeline_desc_3d: depth tested, opaque, back faces culled. A game
# drawing transparent or unlit geometry sets its own. Must be called before the
# first draw, since it is baked into each pipeline as it is built.
pub fun shader_set_state(s: *Shader, d: PipelineDesc) {
    s.desc = d;
}

# The pipeline for a render pass and vertex layout, building it on first use.
#
# Internal to the draw path: a game never calls this, which is the point of the
# type. Refused when the shader is full or the pipeline could not be built, and
# the caller reports that as a dropped draw rather than drawing with a pipeline
# meant for different geometry.
pub fun shader_pipeline(s: *Shader, v: *Vk, pass: vk.RenderPass,
                        compatibility: *PassCompatibility, f: *VertexFormat,
                        depth: DepthConvention) res[*Pipeline, Error] {
    if (!s.ready) { ret res[*Pipeline, Error].err{Error.shader{ShaderError.undeclared{}}}; }
    if (pass == nil) { ret res[*Pipeline, Error].err{Error.uninitialized{Stage.frame{}}}; }

    var i: usize = 0;
    for (i < s.count) {
        if (s.built[i].live
            && depth_convention_same(s.built[i].depth, depth)
            && pass_compatibility_eq(?s.built[i].compatibility, compatibility)
            && vertex_format_eq(?s.built[i].format, f)) {
            ret res[*Pipeline, Error].ok{?s.built[i].pipeline};
        }
        i = i + 1;
    }

    if (s.count >= MAX_SHADER_PIPELINES) {
        ret res[*Pipeline, Error].err{Error.shader{ShaderError.full{}}};
    }

    val n: usize = s.count;
    var lay: SetLayout = set_layout_full();
    val r: err[Error] = pipeline_init_depth(?s.built[n].pipeline, v, pass,
                                            compatibility.color_count,
                                            f, ?s.desc, depth,
                                            s.vert, s.vlen,
                                            s.frag, s.flen, ?lay);
    if (sel r.err) { ret res[*Pipeline, Error].err{r.err}; }

    s.built[n].compatibility = @compatibility;
    s.built[n].format = @f;
    s.built[n].depth  = depth;
    s.built[n].live   = true;
    s.count = n + 1;
    ret res[*Pipeline, Error].ok{?s.built[n].pipeline};
}

# How many pipelines a shader has had to build.
#
# One per render pass and vertex layout it is drawn with. A number that keeps
# climbing means a shader is being used against more combinations than expected,
# which is the cheapest signal that something is rebuilding a render target or
# generating vertex layouts per frame.
pub fun shader_pipelines(s: *Shader) usize {
    ret s.count;
}

# Destroy every pipeline the shader built.
#
# Takes the Device the renderer hands out, like every other resource delete, so
# a game never names the Vulkan device this is really destroying against.
#
# The SPIR-V is not freed: it was borrowed.
pub fun shader_delete(s: *Shader, d: *Device) {
    if (d == nil || !d.ready) { ret; }
    val v: *Vk = d.vk;
    # A pipeline the GPU has not finished with is still referenced by a
    # submitted command buffer, and the frame loop runs several frames ahead, so
    # "after the last draw" is not after the last use. Every public delete waits
    # first; see vk_wait_idle.
    vk_wait_idle(v);
    var i: usize = 0;
    for (i < s.count) {
        if (s.built[i].live) {
            pipeline_dnit(?s.built[i].pipeline, v);
            s.built[i].live = false;
        }
        i = i + 1;
    }
    s.count = 0;
    s.ready = false;
}

# --------------------------------------------------------------------- tests
#
# Building a pipeline needs a device. What is testable without one is the
# validation and the cache lookup, which is where a mistake either rejects a
# valid shader or hands a draw a pipeline built for different geometry.

test "shader: a module that is not a whole number of SPIR-V words is refused" {
    # Rejected here rather than inside pipeline creation, where it surfaces as
    # an unexplained driver failure a long way from the call that caused it.
    var s: Shader;
    var bytes: [64]u8;
    if (!refused_words(shader(?s, ?bytes[0], 21, ?bytes[0], 64), 21)) { ret 1; }
    if (!refused_words(shader(?s, ?bytes[0], 64, ?bytes[0], 21), 21)) { ret 2; }
    # Too short to hold a SPIR-V header at all.
    if (!refused_words(shader(?s, ?bytes[0], 16, ?bytes[0], 64), 16)) { ret 3; }
    # And a valid pair is accepted.
    if (!declared(shader(?s, ?bytes[0], 64, ?bytes[0], 64)))          { ret 4; }
    ret 0;
}

fun declared(r: err[Error]) bool {
    ret sel r.ok;
}

fun refused_words(r: err[Error], len: usize) bool {
    ret sel r.err && (sel r.err.shader && (sel r.err.shader.spirv_words && r.err.shader.spirv_words == len));
}

fun missing_stage(r: err[Error]) bool {
    ret sel r.err && (sel r.err.shader && sel r.err.shader.missing_stage);
}

fun builds_nothing(r: res[*Pipeline, Error]) bool {
    ret sel r.err;
}

fun hands_out(r: res[*Pipeline, Error], p: *Pipeline) bool {
    ret sel r.ok && r.ok == p;
}

test "shader: a missing module is refused rather than deferred" {
    var s: Shader;
    var bytes: [64]u8;
    if (!missing_stage(shader(?s, nil, 64, ?bytes[0], 64))) { ret 1; }
    if (!missing_stage(shader(?s, ?bytes[0], 64, nil, 64))) { ret 2; }
    ret 0;
}

test "shader: a fresh shader has built nothing" {
    # Creation records what the shader is and builds nothing, because a pipeline
    # needs a render pass and a vertex layout that are not known until a draw.
    var s: Shader;
    var bytes: [64]u8;
    if (!declared(shader(?s, ?bytes[0], 64, ?bytes[0], 64))) { ret 1; }
    if (shader_pipelines(?s) != 0) { ret 2; }
    ret 0;
}

test "shader: a built pipeline is reused only for its own pass and layout" {
    # THE DEFECT THIS CATCHES. A pipeline bakes in both the render pass and the
    # vertex layout, so handing a draw the entry built for a different one is
    # not a slower picture, it is undefined behaviour that a driver may or may
    # not report. A lookup keyed on only one of the two would do exactly that,
    # and would look correct in every scene that has one render target or one
    # mesh layout, which is most scenes until the one that does not.
    #
    # The entry is installed directly rather than built, because building needs
    # a device. What is under test is the lookup, which is where the mistake is.
    var s: Shader;
    var v: Vk;
    var bytes: [64]u8;
    if (!declared(shader(?s, ?bytes[0], 64, ?bytes[0], 64))) { ret 1; }

    var pass_a: u32 = 1;
    var pass_b: u32 = 2;
    val a: vk.RenderPass = (?pass_a):~vk.RenderPass;
    val b: vk.RenderPass = (?pass_b):~vk.RenderPass;

    var std_fmt:  VertexFormat = vertex_format_standard();
    var skin_fmt: VertexFormat = vertex_format_skinned();
    var compatibility: PassCompatibility = pass_compatibility_one(1);
    var other: PassCompatibility = pass_compatibility_one(2);

    s.built[0].compatibility = compatibility;
    s.built[0].format = std_fmt;
    s.built[0].depth  = DepthConvention.forward{};
    s.built[0].live   = true;
    s.count = 1;

    # The pair it was built for.
    if (!hands_out(shader_pipeline(?s, ?v, a, ?compatibility, ?std_fmt,
                                   DepthConvention.forward{}), ?s.built[0].pipeline)) { ret 2; }

    # A distinct but compatible pass reuses it.
    if (!hands_out(shader_pipeline(?s, ?v, b, ?compatibility, ?std_fmt,
                                   DepthConvention.forward{}), ?s.built[0].pipeline)) { ret 3; }

    # A different attachment format is not compatible. Building instead fails
    # here for want of a device.
    if (!builds_nothing(shader_pipeline(?s, ?v, b, ?other, ?std_fmt,
                                        DepthConvention.forward{}))) { ret 4; }

    # Same pass, a different layout: likewise.
    if (!builds_nothing(shader_pipeline(?s, ?v, a, ?compatibility, ?skin_fmt,
                                        DepthConvention.forward{}))) { ret 5; }

    if (!builds_nothing(shader_pipeline(?s, ?v, a, ?compatibility, ?std_fmt,
                                        DepthConvention.reversed{}))) { ret 6; }

    # And a failed build leaves nothing behind to be handed out later.
    if (shader_pipelines(?s) != 1) { ret 7; }
    ret 0;
}

test "shader: a full shader refuses rather than evicting a live pipeline" {
    # Eviction would destroy a pipeline a command buffer may still be executing,
    # which is a use-after-free the driver reports at a distance if at all. So
    # the cache fills and stops, and the draw is dropped and counted.
    var s: Shader;
    var v: Vk;
    var bytes: [64]u8;
    if (!declared(shader(?s, ?bytes[0], 64, ?bytes[0], 64))) { ret 1; }

    var fmt: VertexFormat = vertex_format_standard();
    var handles: [8]u32;
    var compatibilities: [8]PassCompatibility;
    var i: usize = 0;
    for (i < MAX_SHADER_PIPELINES) {
        handles[i] = i::u32;
        compatibilities[i] = pass_compatibility_one((i + 1)::i32);
        s.built[i].compatibility = compatibilities[i];
        s.built[i].format = fmt;
        s.built[i].depth  = DepthConvention.forward{};
        s.built[i].live   = true;
        i = i + 1;
    }
    s.count = MAX_SHADER_PIPELINES;

    var extra: u32 = 99;
    var extra_compatibility: PassCompatibility = pass_compatibility_one(99);
    val refused: res[*Pipeline, Error] = shader_pipeline(?s, ?v, (?extra):~vk.RenderPass,
                                                         ?extra_compatibility, ?fmt,
                                                         DepthConvention.forward{});
    if (!sel refused.err) { ret 2; }
    if (!sel refused.err.shader) { ret 5; }
    # Nothing was evicted to make room.
    if (shader_pipelines(?s) != MAX_SHADER_PIPELINES) { ret 3; }
    if (!s.built[0].live)                             { ret 4; }
    ret 0;
}

test "shader: an unready shader builds nothing" {
    # A Shader left at its zero value has no modules, and reaching the driver
    # with a null pointer and a zero length is a crash rather than an error.
    var s: Shader;
    var v: Vk;
    var f: VertexFormat = vertex_format_standard();
    var pass: u32 = 1;
    var compatibility: PassCompatibility = pass_compatibility_one(1);
    s.ready = false;
    s.count = 0;
    if (!builds_nothing(shader_pipeline(?s, ?v, (?pass):~vk.RenderPass,
                                        ?compatibility, ?f, DepthConvention.forward{}))) { ret 1; }
    ret 0;
}
