# The render pass description every pass in boom is built from.
#
# WHY THIS MODULE EXISTS. A Vulkan pipeline is created against a render pass and
# may only be used inside one *compatible* with it, and compatibility is a
# stricter relation than it first looks: the attachment formats and sample
# counts must match, the subpass and its attachment references must match, and
# the subpass dependencies must match. Only the load and store operations and
# the initial and final layouts are exempt.
#
# boom builds one set of pipelines, in boom.graphics.cache, and draws them into
# the window and into offscreen targets alike. When the window pass and the
# target pass were written out separately they agreed on everything a reader
# would think of and differed in dependency count, one against two, which is
# enough to make every draw into a target invalid. Nothing about that is visible
# at either call site; it shows up as a validation error at the draw, naming two
# render passes.
#
# So there is one description here and the only things a caller may vary are
# exactly the members compatibility ignores. Adding a pass is filling in a
# PassOptions, and a pass that would be incompatible is not expressible.

use std.types.bool.bool;
use std.types.size.usize;
use std.types.bool.true;
use std.types.bool.false;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use vk;
use boom.graphics.error.Error;
use boom.graphics.error.error;
use boom.graphics.vk.Vk;
use boom.graphics.image.DEPTH_FORMAT;

# What a caller may vary about a pass.
#
# EVERY FIELD HERE IS EXEMPT FROM RENDER PASS COMPATIBILITY, and that is the
# invariant this record encodes. A field added here that is not exempt would
# reintroduce exactly the class of bug the module exists to remove, so a new
# member has to be checked against the compatibility rules before it is added.
# ---
# color_format:  Format of the colour attachment. Not a free choice: it is the
#                surface's, from Vk.color_format, for every pass, since formats
#                must match. Carried so the field is written once, not so it can
#                differ.
# color_load:    Whether the colour attachment is cleared, loaded, or discarded.
# color_initial: The layout the colour attachment is in on entry.
# color_final:   The layout it is left in.
# depth_load:    Whether depth is cleared or loaded.
# depth_initial: The layout depth is in on entry.
# The most colour attachments a pass may write.
#
# Four because that is Vulkan's guaranteed minimum for maxColorAttachments, so
# a pass built to this limit works on every conforming device without querying
# one. It is also exactly what a deferred pipeline wants: albedo, normal,
# material, emissive.
pub val MAX_COLOR_ATTACHMENTS: usize = 4;

# ---
# color_formats: one format per colour attachment
# color_count:   how many of color_formats are used, 1 to MAX_COLOR_ATTACHMENTS
#
# The load and layout settings are shared by every colour attachment, because
# attachments written together in one pass are cleared and transitioned
# together. A pass wanting them to differ wants two passes.
pub rec PassOptions {
    color_formats: [4]i32;
    color_count:   usize;
    color_load:    i32;
    color_initial: i32;
    color_final:   i32;
    depth_load:    i32;
    depth_initial: i32;
}

# A pass that clears and is entered with its attachments in no defined state.
#
# What a frame or an offscreen render begins with. UNDEFINED as the initial
# layout is what discards the previous contents; it is correct precisely because
# the load operation is a clear, so nothing that was there is read.
# ---
# format: The colour format, from Vk.color_format.
# final:  The layout to leave the colour attachment in.
pub fun pass_clearing(format: i32, final: i32) PassOptions {
    var o: PassOptions = pass_clearing_mrt(?format, 1, final);
    ret o;
}

# The multiple-attachment form of pass_clearing.
#
# ---
# formats: count attachment formats
# count:   1 to MAX_COLOR_ATTACHMENTS
# final:   the layout to leave every colour attachment in
pub fun pass_clearing_mrt(formats: *i32, count: usize, final: i32) PassOptions {
    var o: PassOptions;
    o.color_count   = clamp_count(count);
    o.color_load    = vk.ATTACHMENT_LOAD_OP_CLEAR;
    o.color_initial = vk.IMAGE_LAYOUT_UNDEFINED;
    o.color_final   = final;
    o.depth_load    = vk.ATTACHMENT_LOAD_OP_CLEAR;
    o.depth_initial = vk.IMAGE_LAYOUT_UNDEFINED;
    var i: usize = 0;
    for (i < MAX_COLOR_ATTACHMENTS) {
        if (i < o.color_count && formats != nil) { o.color_formats[i] = formats[i]; }
        or                                       { o.color_formats[i] = 0; }
        i = i + 1;
    }
    ret o;
}

# A count outside the supported range is a caller error that Vulkan would turn
# into a validation failure at pass creation. Clamping keeps it a pass that
# works rather than one that does not exist.
fun clamp_count(count: usize) usize {
    if (count == 0) { ret 1; }
    if (count > MAX_COLOR_ATTACHMENTS) { ret MAX_COLOR_ATTACHMENTS; }
    ret count;
}

# A pass that preserves what is already drawn.
#
# Used to resume the window pass after an offscreen excursion. Its initial
# layouts are the ones the suspended pass left behind, which is why they are
# attachment-optimal rather than undefined: undefined here would discard the
# frame.
# ---
# format: The colour format, from Vk.color_format.
# final:  The layout to leave the colour attachment in.
pub fun pass_loading(format: i32, final: i32) PassOptions {
    var fmt: i32 = format;
    ret pass_loading_mrt(?fmt, 1, vk.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, final);
}

# The multiple-attachment form of pass_loading, with the entry layout named.
#
# THE ENTRY LAYOUT IS NOT ALWAYS COLOR_ATTACHMENT_OPTIMAL. The window's resume
# pass enters attachments the suspended pass left mid-render, so for it that is
# right. An offscreen target enters in whatever its own pass left behind, which
# is SHADER_READ_ONLY_OPTIMAL, because the point of a target is that something
# samples it afterwards. Naming the wrong one here does not fail to create the
# pass: it declares a layout the image is not in, and the contents the load was
# supposed to preserve are undefined.
# ---
# formats: count attachment formats
# count:   1 to MAX_COLOR_ATTACHMENTS
# initial: the layout the colour attachments are already in
# final:   the layout to leave them in
pub fun pass_loading_mrt(formats: *i32, count: usize, initial: i32, final: i32) PassOptions {
    var o: PassOptions;
    o.color_count   = clamp_count(count);
    o.color_load    = vk.ATTACHMENT_LOAD_OP_LOAD;
    o.color_initial = initial;
    o.color_final   = final;
    o.depth_load    = vk.ATTACHMENT_LOAD_OP_LOAD;
    o.depth_initial = vk.IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
    var i: usize = 0;
    for (i < MAX_COLOR_ATTACHMENTS) {
        if (i < o.color_count && formats != nil) { o.color_formats[i] = formats[i]; }
        or                                       { o.color_formats[i] = 0; }
        i = i + 1;
    }
    ret o;
}

# Create a render pass from the shared description.
pub fun pass_create(v: *Vk, o: *PassOptions, out: *vk.RenderPass) Result[bool, Error] {
    val n: usize = clamp_count(o.color_count);

    # DEPTH IS LAST, AT INDEX n. Every consumer that builds a framebuffer or a
    # clear-value array for this pass has to agree on that ordering, so it is
    # stated once here and derived everywhere else from color_count.
    var atts: [5]vk.AttachmentDescription;
    var color_refs: [4]vk.AttachmentReference;
    var ai: usize = 0;
    for (ai < n) {
        atts[ai].flags          = 0;
        atts[ai].format         = o.color_formats[ai];
        atts[ai].samples        = vk.SAMPLE_COUNT_1_BIT::i32;
        atts[ai].loadOp         = o.color_load;
        atts[ai].storeOp        = vk.ATTACHMENT_STORE_OP_STORE;
        atts[ai].stencilLoadOp  = vk.ATTACHMENT_LOAD_OP_DONT_CARE;
        atts[ai].stencilStoreOp = vk.ATTACHMENT_STORE_OP_DONT_CARE;
        atts[ai].initialLayout  = o.color_initial;
        atts[ai].finalLayout    = o.color_final;

        color_refs[ai].attachment = ai::u32;
        color_refs[ai].layout     = vk.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
        ai = ai + 1;
    }

    # Nothing reads the depth buffer after the pass, so it need not be stored.
    # Saying so lets a tiled GPU skip writing it to memory at all.
    atts[n].flags          = 0;
    atts[n].format         = DEPTH_FORMAT;
    atts[n].samples        = vk.SAMPLE_COUNT_1_BIT::i32;
    atts[n].loadOp         = o.depth_load;
    atts[n].storeOp        = vk.ATTACHMENT_STORE_OP_DONT_CARE;
    atts[n].stencilLoadOp  = vk.ATTACHMENT_LOAD_OP_DONT_CARE;
    atts[n].stencilStoreOp = vk.ATTACHMENT_STORE_OP_DONT_CARE;
    atts[n].initialLayout  = o.depth_initial;
    atts[n].finalLayout    = vk.IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;

    var depth_ref: vk.AttachmentReference;
    depth_ref.attachment = n::u32;
    depth_ref.layout     = vk.IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;

    var sub: vk.SubpassDescription;
    sub.flags                   = 0;
    sub.pipelineBindPoint       = vk.PIPELINE_BIND_POINT_GRAPHICS;
    sub.inputAttachmentCount    = 0;
    sub.pInputAttachments       = nil;
    sub.colorAttachmentCount    = n::u32;
    sub.pColorAttachments       = ?color_refs[0];
    sub.pResolveAttachments     = nil;
    sub.pDepthStencilAttachment = ?depth_ref;
    sub.preserveAttachmentCount = 0;
    sub.pPreserveAttachments    = nil;

    # TWO DEPENDENCIES, AND THE SAME TWO FOR EVERY PASS. They are the union of
    # what a window pass and an offscreen pass each need, because dependencies
    # participate in compatibility and so cannot be tailored per pass.
    #
    # The first orders whatever came before against this pass's writes. For the
    # window that is the image acquire; for a target it is the previous frame's
    # sampling of the same image, without which a target reused every frame is
    # overwritten while the last frame still reads it.
    #
    # The second orders this pass's writes before anything samples the result.
    # It does nothing for the window, where nothing samples the presented image,
    # and it costs nothing there.
    var deps: [2]vk.SubpassDependency;
    deps[0].srcSubpass      = vk.SUBPASS_EXTERNAL;
    deps[0].dstSubpass      = 0;
    # The early-fragment-tests stage is included because that is where the depth
    # attachment's load-time clear happens, and it runs before colour output.
    deps[0].srcStageMask    = vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT
                            | vk.PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT
                            | vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
    deps[0].dstStageMask    = vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT
                            | vk.PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT;
    deps[0].srcAccessMask   = vk.ACCESS_SHADER_READ_BIT;
    deps[0].dstAccessMask   = vk.ACCESS_COLOR_ATTACHMENT_WRITE_BIT
                            | vk.ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
    deps[0].dependencyFlags = 0;

    deps[1].srcSubpass      = 0;
    deps[1].dstSubpass      = vk.SUBPASS_EXTERNAL;
    deps[1].srcStageMask    = vk.PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
    deps[1].dstStageMask    = vk.PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
    deps[1].srcAccessMask   = vk.ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
    deps[1].dstAccessMask   = vk.ACCESS_SHADER_READ_BIT;
    deps[1].dependencyFlags = 0;

    var ci: vk.RenderPassCreateInfo;
    ci.sType           = vk.STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
    ci.pNext           = nil;
    ci.flags           = 0;
    ci.attachmentCount = (n + 1)::u32;
    ci.pAttachments    = ?atts[0];
    ci.subpassCount    = 1;
    ci.pSubpasses      = ?sub;
    ci.dependencyCount = 2;
    ci.pDependencies   = ?deps[0];

    if (vk.vkCreateRenderPass(v.device, ?ci, nil, out) != vk.SUCCESS) {
        ret err[bool, Error](error("vkCreateRenderPass failed"));
    }
    ret ok[bool, Error](true);
}

# --------------------------------------------------------------------- tests
#
# Creation needs a device. What is testable without one is the part that was
# actually wrong: that two passes built for different purposes vary only in the
# members render pass compatibility exempts.

test "pass: a clearing and a loading pass differ only where compatibility allows" {
    # Formats and the depth format are the compatibility-relevant members these
    # options can reach. If a clearing pass and a loading pass ever disagreed on
    # the colour format, every pipeline drawn through both would be invalid, and
    # the diagnostic names two render passes rather than this line.
    val a: PassOptions = pass_clearing(vk.FORMAT_B8G8R8A8_SRGB, vk.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
    val b: PassOptions = pass_loading(vk.FORMAT_B8G8R8A8_SRGB, vk.IMAGE_LAYOUT_PRESENT_SRC_KHR);
    if (a.color_formats[0] != b.color_formats[0]) { ret 1; }
    if (a.color_count != b.color_count)           { ret 2; }
    ret 0;
}

test "pass: a single-attachment pass is the multi form with a count of one" {
    # pass_clearing is the common case and must stay exactly the old behaviour,
    # or every existing pipeline built against it becomes incompatible.
    var fmt: i32 = vk.FORMAT_B8G8R8A8_SRGB;
    val one: PassOptions = pass_clearing(fmt, vk.IMAGE_LAYOUT_PRESENT_SRC_KHR);
    val mrt: PassOptions = pass_clearing_mrt(?fmt, 1, vk.IMAGE_LAYOUT_PRESENT_SRC_KHR);
    if (one.color_count != 1)                      { ret 1; }
    if (one.color_formats[0] != mrt.color_formats[0]) { ret 2; }
    if (one.color_load != mrt.color_load)          { ret 3; }
    if (one.color_initial != mrt.color_initial)    { ret 4; }
    if (one.color_final != mrt.color_final)        { ret 5; }
    ret 0;
}

test "pass: an impossible attachment count is clamped into range" {
    # Zero would create a pass nothing can draw into and a count past the
    # guaranteed minimum would fail validation on a conforming device. Both are
    # caller errors, and a working pass beats one that does not exist.
    var fmts: [4]i32 = [4]i32{1, 2, 3, 4};
    val zero: PassOptions = pass_clearing_mrt(?fmts[0], 0, vk.IMAGE_LAYOUT_PRESENT_SRC_KHR);
    if (zero.color_count != 1) { ret 1; }

    val over: PassOptions = pass_clearing_mrt(?fmts[0], 99, vk.IMAGE_LAYOUT_PRESENT_SRC_KHR);
    if (over.color_count != MAX_COLOR_ATTACHMENTS) { ret 2; }

    val four: PassOptions = pass_clearing_mrt(?fmts[0], 4, vk.IMAGE_LAYOUT_PRESENT_SRC_KHR);
    if (four.color_count != 4)      { ret 3; }
    if (four.color_formats[3] != 4) { ret 4; }
    ret 0;
}

test "pass: a clearing pass discards, a loading pass preserves" {
    # The resume pass exists so an offscreen excursion does not erase the frame.
    # A clear here, or an UNDEFINED initial layout, wipes everything already
    # drawn and looks like the excursion itself failing to render.
    val a: PassOptions = pass_clearing(vk.FORMAT_B8G8R8A8_SRGB, vk.IMAGE_LAYOUT_PRESENT_SRC_KHR);
    if (a.color_load    != vk.ATTACHMENT_LOAD_OP_CLEAR)   { ret 1; }
    if (a.color_initial != vk.IMAGE_LAYOUT_UNDEFINED)     { ret 2; }
    if (a.depth_load    != vk.ATTACHMENT_LOAD_OP_CLEAR)   { ret 3; }

    val b: PassOptions = pass_loading(vk.FORMAT_B8G8R8A8_SRGB, vk.IMAGE_LAYOUT_PRESENT_SRC_KHR);
    if (b.color_load    != vk.ATTACHMENT_LOAD_OP_LOAD)    { ret 4; }
    if (b.depth_load    != vk.ATTACHMENT_LOAD_OP_LOAD)    { ret 5; }
    if (b.color_initial != vk.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL) { ret 6; }
    if (b.depth_initial != vk.IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL) { ret 7; }
    ret 0;
}

test "pass: a loading pass differs from a clearing one only where compatibility allows" {
    # These two are used interchangeably with one set of pipelines, which is
    # only legal because render pass compatibility exempts load and store
    # operations and attachment layouts. Every other member must match, or a
    # pipeline built against one is invalid in the other and the diagnostic
    # names two render passes rather than this line.
    var fmts: [4]i32 = [4]i32{7, 8, 9, 10};
    val c: PassOptions = pass_clearing_mrt(?fmts[0], 3, vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
    val l: PassOptions = pass_loading_mrt(?fmts[0], 3,
                                          vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
                                          vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
    if (c.color_count != l.color_count) { ret 1; }
    var i: usize = 0;
    for (i < c.color_count) {
        if (c.color_formats[i] != l.color_formats[i]) { ret 2; }
        i = i + 1;
    }

    # And they must actually differ in the load op, or the loading pass clears.
    if (c.color_load != vk.ATTACHMENT_LOAD_OP_CLEAR) { ret 3; }
    if (l.color_load != vk.ATTACHMENT_LOAD_OP_LOAD)  { ret 4; }
    if (l.depth_load != vk.ATTACHMENT_LOAD_OP_LOAD)  { ret 5; }
    ret 0;
}

test "pass: a loading pass enters in the layout it is told, not a fixed one" {
    # The window's resume pass enters attachments a suspended pass left
    # mid-render. An offscreen target enters in SHADER_READ_ONLY_OPTIMAL,
    # because that is where its own pass leaves it. Hardcoding either one makes
    # the other preserve nothing, and the pass still creates successfully.
    var fmt: i32 = 7;
    val target: PassOptions = pass_loading_mrt(?fmt, 1,
                                               vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
                                               vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
    if (target.color_initial != vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL) { ret 1; }

    val window: PassOptions = pass_loading(7, vk.IMAGE_LAYOUT_PRESENT_SRC_KHR);
    if (window.color_initial != vk.IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL) { ret 2; }
    if (window.color_final != vk.IMAGE_LAYOUT_PRESENT_SRC_KHR)            { ret 3; }
    ret 0;
}
