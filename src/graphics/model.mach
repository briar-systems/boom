# the Model handle: a skinned mesh, its skeleton, and its animation clips
#
# model_load hides mach-gltf the way mesh_load does: a game hands it a .glb
# path and receives an opaque Model carrying the uploaded Mesh, a
# boom-owned Skeleton, and the named Animation clips, never seeing a
# mach-gltf type. one parse of the document feeds all three: the geometry
# uploads to the GPU, the skin becomes a Skeleton (joints, hierarchy, and
# inverse bind matrices), and each glTF animation becomes an Animation clip
# whose keyframe arrays live in an arena the Model owns for its lifetime.
#
# the ergonomic path is model_load then model_player(name): a player bound
# to the model's skeleton and the named clip, advanced each frame and drawn
# with boom.graphics.renderer.pass_draw_skinned.
#
# first-pass limits, documented rather than worked around: the first skin
# is used, joint nodes must use TRS (not a baked matrix), and cubic-spline
# animation samplers are rejected. multiple skins, matrix-form joints, and
# morph-target (weights) channels are future work.

use boom.graphics.animation.Animation;
use boom.graphics.animation.AnimationPlayer;
use boom.graphics.animation.Channel;
use boom.graphics.animation.ChannelPath;
use boom.graphics.animation.Interp;
use boom.graphics.animation.animation_duration;
use boom.graphics.animation.animation_player;
use boom.graphics.animation.animation_player_advance;
use boom.graphics.device.Device;
use boom.graphics.error.Error;
use boom.graphics.error.mesh.MeshError;
use boom.graphics.error.mesh.ModelError;
use boom.graphics.mesh.AccessorError;
use boom.graphics.mesh.Floats;
use boom.graphics.mesh.Mesh;
use boom.graphics.mesh.MeshData;
use boom.graphics.mesh.extract_loaded;
use boom.graphics.mesh.mesh;
use boom.graphics.mesh.mesh_data_max_joint;
use boom.graphics.mesh.mesh_delete;
use boom.graphics.mesh.read_floats;
use boom.graphics.skeleton.MAX_JOINTS;
use boom.graphics.skeleton.Skeleton;
use boom.math.mat.Mat4;
use boom.math.mat.mat4_identity;
use boom.math.mat.mat4_ptr;
use boom.math.quat.Quat;
use boom.math.transform.Transform;
use boom.math.vec.Vec3;
use boom.math.vec.vec3;
use boom.vfs;
use gd:   gltf.doc;
use gp:   gltf.parse;
use allo: std.allocator;
use std.allocator.arena;
use std.allocator.page;
use std.collections.slice;
use vec:  std.collections.vector;
use text: std.text.string;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

# an opaque handle to a skinned, animated model
# ---
# mesh:        the uploaded skinned geometry, drawn with pass_draw_skinned
# skeleton:    the joint hierarchy and bind data, count 0 for an unskinned model
# joint_names: per-joint names in skin index order, owned by arena, none for an unnamed joint
# clips:       the named animation clips, owned by arena, clip_count entries
# clip_count:  number of clips
# arena:       backing storage for the names, clips and their keyframe arrays
pub rec Model {
    mesh:        Mesh;
    skeleton:    Skeleton;
    joint_names: [128]opt[str];
    clips:       *Animation;
    clip_count:  usize;
    arena:       arena.Arena;
}

# the graphics Error for an accessor refusal while loading a skeleton or clip
fun accessor_failed(e: AccessorError) Error {
    if (sel e.plan) { ret Error.model{ModelError.plan{e.plan}}; }
    or (sel e.read) { ret Error.model{ModelError.read{e.read}}; }
    ret Error.alloc{e.alloc};
}

# the joint index a skin assigns to a node, or none when the node is not a joint
fun node_to_joint(skin: *gd.Skin, node: usize) opt[usize] {
    var j: usize = 0;
    for (j < skin.joints.size) {
        if (skin.joints.data[j] == node) { ret opt[usize].some{j}; }
        j = j + 1;
    }
    ret opt[usize].none{};
}

# order joints so every parent precedes its children, into sk.order
#
# a stable sweep that emits any joint whose parent is already emitted; a
# sweep that makes no progress means the hierarchy has a cycle.
# ---
# sk:  the skeleton whose parents are set and whose order is filled
# ret: ok, or a cycle error
fun build_order(sk: *Skeleton) err[Error] {
    var added: [128]u8;
    var i:     usize = 0;
    for (i < sk.count) {
        added[i] = 0;
        i        = i + 1;
    }
    var produced: usize = 0;
    for (produced < sk.count) {
        var progress: u8    = 0;
        var j:        usize = 0;
        for (j < sk.count) {
            if (added[j] == 0) {
                val p:     opt[usize] = sk.parents[j];
                var ready: bool       = true;
                if (sel p.some) { ready = added[p.some] != 0; }
                if (ready) {
                    sk.order[produced] = j;
                    added[j]           = 1;
                    produced           = produced + 1;
                    progress           = 1;
                }
            }
            j = j + 1;
        }
        if (progress == 0) {
            ret err[Error].err{Error.model{ModelError.skeleton_cycle{}}};
        }
    }
    ret err[Error].ok{};
}

# the node a skin joint names, refusing a reference past the document's nodes
fun joint_node(d: *gd.Document, skin: *gd.Skin, j: usize) res[*gd.Node, Error] {
    val node_i: usize         = skin.joints.data[j];
    val nr:     opt[*gd.Node] = slice.get[gd.Node](d.nodes, node_i);
    if (sel nr.none) { ret res[*gd.Node, Error].err{Error.model{ModelError.joint_node{node_i}}}; }
    ret res[*gd.Node, Error].ok{nr.some};
}

# build a boom Skeleton from the document's first skin
#
# an unskinned document yields an empty skeleton (count 0). each joint's
# rest transform comes from its node's TRS, its parent from the node
# hierarchy, and its inverse bind matrix from the skin's accessor.
# ---
# loaded: the parsed document with its binary buffer
# a:      allocator for the inverse-bind scratch read
# sk:     receives the built skeleton
# ret:    ok, or an extract error
fun build_skeleton(loaded: *gp.Loaded, a: *allo.Allocator, sk: *Skeleton) err[Error] {
    val d:  *gd.Document  = ?loaded.document;
    val sr: opt[*gd.Skin] = slice.get[gd.Skin](d.skins, 0);
    if (sel sr.none) {
        sk.count = 0;
        ret err[Error].ok{};
    }
    val skin: *gd.Skin = sr.some;

    val n: usize = skin.joints.size;
    if (n > MAX_JOINTS) {
        ret err[Error].err{Error.model{ModelError.joints{n}}};
    }
    sk.count = n;

    var j: usize = 0;
    for (j < n) {
        val nr: res[*gd.Node, Error] = joint_node(d, skin, j);
        if (sel nr.err) { ret err[Error].err{nr.err}; }
        val node: *gd.Node = nr.ok;
        if (node.has_matrix) {
            ret err[Error].err{Error.model{ModelError.joint_matrix{skin.joints.data[j]}}};
        }
        sk.rest[j].position = vec3(node.translation[0], node.translation[1], node.translation[2]);
        sk.rest[j].rotation = f32x4{node.rotation[0], node.rotation[1], node.rotation[2], node.rotation[3]};
        sk.rest[j].scale    = vec3(node.scale[0], node.scale[1], node.scale[2]);
        sk.parents[j]       = opt[usize].none{};
        sk.inverse_bind[j]  = mat4_identity();
        j                   = j + 1;
    }

    var pn: usize = 0;
    for (pn < d.nodes.size) {
        val pj: opt[usize] = node_to_joint(skin, pn);
        if (sel pj.some) {
            val pnode: *gd.Node = ?d.nodes.data[pn];
            var ci:    usize    = 0;
            for (ci < pnode.children.size) {
                val cj: opt[usize] = node_to_joint(skin, pnode.children.data[ci]);
                if (sel cj.some) { sk.parents[cj.some] = opt[usize].some{pj.some}; }
                ci = ci + 1;
            }
        }
        pn = pn + 1;
    }

    val ord: err[Error] = build_order(sk);
    if (sel ord.err) { ret ord; }

    if (sel skin.inverse_bind_matrices.some) {
        val rr: res[Floats, AccessorError] = read_floats(d, loaded.bin, loaded.bin_len, skin.inverse_bind_matrices.some, a);
        if (sel rr.err) { ret err[Error].err{accessor_failed(rr.err)}; }
        val ibm: Floats = rr.ok;
        if (ibm.comps != 16) { ret err[Error].err{Error.model{ModelError.inverse_bind_type{}}}; }
        if (ibm.count < n)   { ret err[Error].err{Error.model{ModelError.inverse_bind_count{ibm.count}}}; }
        var k: usize = 0;
        for (k < n) {
            val matrix: *f32  = mat4_ptr(?sk.inverse_bind[k]);
            var m:      usize = 0;
            for (m < 16) {
                matrix[m] = ibm.data[k * 16 + m];
                m         = m + 1;
            }
            k = k + 1;
        }
    }
    ret err[Error].ok{};
}

# copy a glTF name into a boom-owned string
#
# glTF names are owned null-terminated strings as of mach-gltf 0.3.0, so this
# is a plain dup. it was a hand-rolled byte loop while they were borrowed views
# into the JSON buffer, which is the copy boom had to make to outlive it.
fun dup_name(v: str, pa: *allo.Allocator) res[str, Error] {
    val r: res[str, allo.Error] = text.str_dup(pa, v);
    if (sel r.err) { ret res[str, Error].err{Error.alloc{r.err}}; }
    ret res[str, Error].ok{r.ok};
}

fun build_joint_names(loaded: *gp.Loaded, skin: *gd.Skin,
    pa: *allo.Allocator, names: *opt[str]) err[Error] {
    if (skin.joints.size > MAX_JOINTS) {
        ret err[Error].err{Error.model{ModelError.joints{skin.joints.size}}};
    }
    var j: usize = 0;
    for (j < skin.joints.size) {
        val nr: res[*gd.Node, Error] = joint_node(?loaded.document, skin, j);
        if (sel nr.err) { ret err[Error].err{nr.err}; }
        val node: *gd.Node = nr.ok;
        names[j] = opt[str].none{};
        if (node.name != nil && node.name[0] != 0) {
            val copied: res[str, Error] = dup_name(node.name, pa);
            if (sel copied.err) { ret err[Error].err{copied.err}; }
            names[j] = opt[str].some{copied.ok};
        }
        j = j + 1;
    }
    ret err[Error].ok{};
}

# translate a glTF target path to a boom channel path, none for morph weights
fun channel_path(path: gd.TargetPath) opt[ChannelPath] {
    if (sel path.translation) { ret opt[ChannelPath].some{ChannelPath.translation{}}; }
    if (sel path.rotation)    { ret opt[ChannelPath].some{ChannelPath.rotation{}}; }
    if (sel path.scale)       { ret opt[ChannelPath].some{ChannelPath.scale{}}; }
    ret opt[ChannelPath].none{};
}

# the joint and path a glTF channel drives, none when it drives nothing boom poses
fun channel_target(skin: *gd.Skin, gch: *gd.AnimationChannel) opt[Channel] {
    if (sel gch.target_node.none) { ret opt[Channel].none{}; }
    val joint: opt[usize] = node_to_joint(skin, gch.target_node.some);
    if (sel joint.none) { ret opt[Channel].none{}; }
    val path: opt[ChannelPath] = channel_path(gch.target_path);
    if (sel path.none) { ret opt[Channel].none{}; }
    var ch: Channel;
    ch.joint = joint.some;
    ch.path  = path.some;
    ret opt[Channel].some{ch};
}

# build one Animation clip from a glTF animation
#
# reads each channel whose target is a skin joint and whose path is
# translation, rotation, or scale; other channels are skipped. keyframe
# input and output arrays are read straight into the persistent allocator,
# so they live as long as the Model.
# ---
# loaded: the parsed document with its binary buffer
# skin:   the skin whose joints the channels target
# anim:   the source animation
# pa:     the persistent allocator for keyframe arrays and channels
# ret:    the built clip, or a read/unsupported error
fun build_clip(loaded: *gp.Loaded, skin: *gd.Skin, anim: *gd.Animation, pa: *allo.Allocator) res[Animation, Error] {
    val d:     *gd.Document = ?loaded.document;
    val total: usize        = anim.channels.size;

    val car: res[*Channel, allo.Error] = allo.allocate[Channel](pa, total);
    if (sel car.err) { ret res[Animation, Error].err{Error.alloc{car.err}}; }
    val channels: *Channel = car.ok;

    var used: usize = 0;
    var ci:   usize = 0;
    for (ci < total) {
        val gch:    *gd.AnimationChannel = ?anim.channels.data[ci];
        val target: opt[Channel]         = channel_target(skin, gch);
        if (sel target.some) {
            val sr: opt[*gd.AnimationSampler] = slice.get[gd.AnimationSampler](anim.samplers, gch.sampler);
            if (sel sr.none) {
                ret res[Animation, Error].err{Error.model{ModelError.sampler_index{gch.sampler}}};
            }
            val samp: *gd.AnimationSampler = sr.some;
            if (sel samp.interpolation.cubic_spline) {
                ret res[Animation, Error].err{Error.model{ModelError.cubic_spline{}}};
            }

            val tr: res[Floats, AccessorError] = read_floats(d, loaded.bin, loaded.bin_len, samp.input, pa);
            if (sel tr.err) { ret res[Animation, Error].err{accessor_failed(tr.err)}; }
            val vr: res[Floats, AccessorError] = read_floats(d, loaded.bin, loaded.bin_len, samp.output, pa);
            if (sel vr.err) { ret res[Animation, Error].err{accessor_failed(vr.err)}; }
            if (vr.ok.count != tr.ok.count) {
                ret res[Animation, Error].err{Error.model{ModelError.keyframe_count{}}};
            }

            channels[used] = target.some;
            if (sel samp.interpolation.step) { channels[used].interp = Interp.step{}; }
            or                               { channels[used].interp = Interp.linear{}; }
            channels[used].times  = tr.ok.data;
            channels[used].values = vr.ok.data;
            channels[used].count  = tr.ok.count;
            channels[used].stride = vr.ok.comps;
            used                  = used + 1;
        }
        ci = ci + 1;
    }

    var out: Animation;
    out.channels = channels;
    out.count    = used;
    out.duration = animation_duration(?out);
    val nr: res[str, Error] = dup_name(anim.name, pa);
    if (sel nr.err) { ret res[Animation, Error].err{nr.err}; }
    out.name = nr.ok;
    ret res[Animation, Error].ok{out};
}

# a document's animation clips
# ---
# clips: the clip array, count entries, nil when there are none
# count: the clip count
rec Clips {
    clips: *Animation;
    count: usize;
}

# build every animation clip in the document
# ---
# loaded: the parsed document with its binary buffer
# skin:   the skin whose joints the channels target
# pa:     the persistent allocator for clips and keyframe arrays
# ret:    the clips, or a read/unsupported error
fun build_animations(loaded: *gp.Loaded, skin: *gd.Skin, pa: *allo.Allocator) res[Clips, Error] {
    val d:  *gd.Document = ?loaded.document;
    val na: usize        = d.animations.size;
    if (na == 0) { ret res[Clips, Error].ok{Clips{clips: nil, count: 0}}; }

    val car: res[*Animation, allo.Error] = allo.allocate[Animation](pa, na);
    if (sel car.err) { ret res[Clips, Error].err{Error.alloc{car.err}}; }
    val clips: *Animation = car.ok;

    var ai: usize = 0;
    for (ai < na) {
        val br: res[Animation, Error] = build_clip(loaded, skin, ?d.animations.data[ai], pa);
        if (sel br.err) { ret res[Clips, Error].err{br.err}; }
        clips[ai] = br.ok;
        ai        = ai + 1;
    }
    ret res[Clips, Error].ok{Clips{clips: clips, count: na}};
}

# release a failed model build, the primary failure winning over any release refusal
fun abandon(d: *Device, model: *Model, parse: *arena.Arena, persistent: bool) {
    if (persistent) { arena.dnit(?model.arena); }
    mesh_delete(d, ?model.mesh);
    arena.dnit(parse);
}

# build a Model from .glb bytes already in memory
#
# parses once, uploads the geometry, builds the skeleton, and reads the
# animation clips into the model's own arena. the bytes are not retained.
# ---
# d:    the upload context
# data: the .glb bytes
# len:  length of data in bytes
# ret:  the built Model, or a parse/extract/upload error
pub fun model_from_glb(d: *Device, data: *u8, len: usize) res[Model, Error] {
    var tpa: allo.Allocator;
    val pm:  err[allo.Error] = page.make(?tpa);
    if (sel pm.err) { ret res[Model, Error].err{Error.alloc{pm.err}}; }
    var tar: arena.Arena;
    val tie: err[allo.Error] = arena.init(?tar, ?tpa, 65536);
    if (sel tie.err) { ret res[Model, Error].err{Error.alloc{tie.err}}; }
    var taa: allo.Allocator;
    val tam: err[allo.Error] = arena.make(?taa, ?tar);
    if (sel tam.err) {
        arena.dnit(?tar);
        ret res[Model, Error].err{Error.alloc{tam.err}};
    }

    val lr: res[gp.Loaded, gp.LoadError] = gp.load_glb(data, len, ?taa);
    if (sel lr.err) {
        arena.dnit(?tar);
        ret res[Model, Error].err{Error.mesh{MeshError.gltf{lr.err}}};
    }
    var loaded: gp.Loaded = lr.ok;

    val er: res[MeshData, Error] = extract_loaded(?loaded, ?taa);
    if (sel er.err) {
        arena.dnit(?tar);
        ret res[Model, Error].err{er.err};
    }
    var md: MeshData = er.ok;

    var model: Model;
    val mr:    res[Mesh, Error] = mesh(d, md.vertices::ptr, md.vertex_count, ?md.format,
        md.indices, md.index_count);
    if (sel mr.err) {
        arena.dnit(?tar);
        ret res[Model, Error].err{mr.err};
    }
    model.mesh       = mr.ok;
    model.clips      = nil;
    model.clip_count = 0;

    val skr: err[Error] = build_skeleton(?loaded, ?taa, ?model.skeleton);
    if (sel skr.err) {
        abandon(d, ?model, ?tar, false);
        ret res[Model, Error].err{skr.err};
    }

    # A joint index past the skeleton's joints reads outside the palette the
    # skinned vertex stage is handed. Checked here, where both the geometry and
    # the joint count are known, rather than clamped per vertex in the shader.
    val max_joint: opt[usize] = mesh_data_max_joint(?md);
    if (sel max_joint.some) {
        if (max_joint.some >= model.skeleton.count) {
            abandon(d, ?model, ?tar, false);
            ret res[Model, Error].err{Error.model{ModelError.vertex_joint{max_joint.some}}};
        }
    }

    val pie: err[allo.Error] = arena.init(?model.arena, ?tpa, 4096);
    if (sel pie.err) {
        abandon(d, ?model, ?tar, false);
        ret res[Model, Error].err{Error.alloc{pie.err}};
    }
    var paa: allo.Allocator;
    val pam: err[allo.Error] = arena.make(?paa, ?model.arena);
    if (sel pam.err) {
        abandon(d, ?model, ?tar, true);
        ret res[Model, Error].err{Error.alloc{pam.err}};
    }

    if (model.skeleton.count > 0) {
        val sr: opt[*gd.Skin] = slice.get[gd.Skin](loaded.document.skins, 0);
        if (sel sr.some) {
            val skin:  *gd.Skin   = sr.some;
            val names: err[Error] =
                build_joint_names(?loaded, skin, ?paa, ?model.joint_names[0]);
            if (sel names.err) {
                abandon(d, ?model, ?tar, true);
                ret res[Model, Error].err{names.err};
            }
            val anr: res[Clips, Error] = build_animations(?loaded, skin, ?paa);
            if (sel anr.err) {
                abandon(d, ?model, ?tar, true);
                ret res[Model, Error].err{anr.err};
            }
            model.clips      = anr.ok.clips;
            model.clip_count = anr.ok.count;
        }
    }

    val released: err[allo.Error] = arena.dnit(?tar);
    if (sel released.err) {
        arena.dnit(?model.arena);
        mesh_delete(d, ?model.mesh);
        ret res[Model, Error].err{Error.alloc{released.err}};
    }
    ret res[Model, Error].ok{model};
}

# load a .glb file and build a Model from its skinned geometry and clips
# ---
# d:    the upload context
# path: virtual path to a .glb file
# ret:  the built Model, or a resolve/read/parse/extract/upload error
pub fun model_load(d: *Device, path: str) res[Model, Error] {
    var pa: allo.Allocator;
    val pm: err[allo.Error] = page.make(?pa);
    if (sel pm.err) { ret res[Model, Error].err{Error.alloc{pm.err}}; }

    # THROUGH THE VFS, like every other loader. A game writes `res://art/x.qoi`
    # and boom.vfs decides what that means; a raw path here would make the
    # graphics loaders the only ones in the engine that do not, so the same
    # spelling would work for a sound and fail for a texture.
    val br: res[vec.Vector[u8], vfs.ReadError] = vfs.vfs_read_bytes(?pa, path);
    if (sel br.err) { ret res[Model, Error].err{Error.load{br.err}}; }
    var buf: vec.Vector[u8] = br.ok;

    val made:     res[Model, Error] = model_from_glb(d, buf.data, buf.len);
    val released: err[allo.Error]   = vec.dnit[u8](?buf);
    if (sel made.err) { ret made; }
    if (sel released.err) {
        var built: Model = made.ok;
        model_delete(d, ?built);
        ret res[Model, Error].err{Error.alloc{released.err}};
    }
    ret made;
}

# a player bound to the model's skeleton and a named clip
#
# the ergonomic entry: model_load then model_player("walk"). the returned
# player starts at time zero, looping at real speed, with its pose already
# set to the first frame.
# ---
# model: the model to play, whose skeleton and clip the player borrows
# name:  the clip name to play
# ret:   the player, or no_clip when the model has no clip of that name
pub fun model_player(model: *Model, name: str) res[AnimationPlayer, Error] {
    var i: usize = 0;
    for (i < model.clip_count) {
        if (str_equals(model.clips[i].name, name)) {
            ret res[AnimationPlayer, Error].ok{animation_player(?model.skeleton, opt[*Animation].some{?model.clips[i]})};
        }
        i = i + 1;
    }
    ret res[AnimationPlayer, Error].err{Error.model{ModelError.no_clip{}}};
}

# a player showing the model's rest pose, with no active clip
# ---
# model: the model to pose
# ret:   a player holding the rest pose
pub fun model_rest_player(model: *Model) AnimationPlayer {
    ret animation_player(?model.skeleton, opt[*Animation].none{});
}

# resolve a unique named joint without relying on exporter-assigned skin order
# ---
# model: the model whose joint names are searched
# name:  the joint name, non-empty
# ret:   the joint's skin index, or joint_name_empty, joint_ambiguous or no_joint
pub fun model_joint(model: *Model, name: str) res[usize, Error] {
    if (name == nil || name[0] == 0) {
        ret res[usize, Error].err{Error.model{ModelError.joint_name_empty{}}};
    }
    var matches: usize = 0;
    var found:   usize = 0;
    var j:       usize = 0;
    for (j < model.skeleton.count) {
        val joint: opt[str] = model.joint_names[j];
        if (sel joint.some && str_equals(joint.some, name)) {
            if (matches > 0) {
                ret res[usize, Error].err{Error.model{ModelError.joint_ambiguous{}}};
            }
            matches = 1;
            found   = j;
        }
        j = j + 1;
    }
    if (matches == 0) {
        ret res[usize, Error].err{Error.model{ModelError.no_joint{}}};
    }
    ret res[usize, Error].ok{found};
}

# release a model's GPU buffers and clip storage
#
# the buffers are released whatever the outcome. a refused release of the clip
# storage leaves the arena owning it, and the model's names and clips are cleared
# either way.
# ---
# d:   the upload context the model was created against
# m:   model to delete; the handle must not be used afterward
# ret: ok, or the allocator's refusal to release the clip storage
pub fun model_delete(d: *Device, m: *Model) err[allo.Error] {
    mesh_delete(d, ?m.mesh);
    val released: err[allo.Error] = arena.dnit(?m.arena);
    m.clips      = nil;
    m.clip_count = 0;
    var j: usize = 0;
    for (j < MAX_JOINTS) {
        m.joint_names[j] = opt[str].none{};
        j                = j + 1;
    }
    m.skeleton.count = 0;
    ret released;
}

# write a little-endian u32 into a byte buffer at off
fun put_u32(b: *u8, off: usize, v: u32) {
    b[off]     = (v & 0xFF)::u8;
    b[off + 1] = ((v >> 8) & 0xFF)::u8;
    b[off + 2] = ((v >> 16) & 0xFF)::u8;
    b[off + 3] = ((v >> 24) & 0xFF)::u8;
}

# write a little-endian u16 into a byte buffer at off
fun put_u16(b: *u8, off: usize, v: u16) {
    b[off]     = (v & 0xFF)::u8;
    b[off + 1] = ((v >> 8) & 0xFF)::u8;
}

# write an f32 (little-endian IEEE-754) into a byte buffer at off
fun put_f32(b: *u8, off: usize, f: f32) {
    put_u32(b, off, f:~u32);
}

# write a column-major identity mat4 (16 f32) into bin at off
fun put_identity_mat4(bin: *u8, off: usize) {
    var i: usize = 0;
    for (i < 16) {
        put_f32(bin, off + i * 4, 0.0);
        i = i + 1;
    }
    put_f32(bin, off + 0, 1.0);
    put_f32(bin, off + 20, 1.0);
    put_f32(bin, off + 40, 1.0);
    put_f32(bin, off + 60, 1.0);
}

# assemble a minimal skinned, animated .glb: two joints and a rotation clip
fun fixture_animated_glb(out: *u8) usize {
    val json: str   = "{\"asset\":{\"version\":\"2.0\"},\"scenes\":[{\"nodes\":[0,1]}],\"nodes\":[{\"mesh\":0,\"skin\":0},{\"children\":[2],\"rotation\":[0,0,0,1]},{\"translation\":[1,0,0]}],\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0,\"JOINTS_0\":1,\"WEIGHTS_0\":2},\"indices\":3,\"mode\":4}]}],\"skins\":[{\"joints\":[1,2],\"inverseBindMatrices\":4}],\"animations\":[{\"name\":\"spin\",\"channels\":[{\"sampler\":0,\"target\":{\"node\":1,\"path\":\"rotation\"}}],\"samplers\":[{\"input\":5,\"output\":6,\"interpolation\":\"LINEAR\"}]}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":5,\"componentType\":5123,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":1,\"componentType\":5126,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":6,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"},{\"bufferView\":2,\"componentType\":5126,\"count\":2,\"type\":\"MAT4\"},{\"bufferView\":3,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\"},{\"bufferView\":4,\"componentType\":5126,\"count\":2,\"type\":\"VEC4\"}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":48},{\"buffer\":0,\"byteOffset\":84,\"byteLength\":128},{\"buffer\":0,\"byteOffset\":212,\"byteLength\":8},{\"buffer\":0,\"byteOffset\":220,\"byteLength\":32},{\"buffer\":0,\"byteOffset\":252,\"byteLength\":24},{\"buffer\":0,\"byteOffset\":276,\"byteLength\":6}],\"buffers\":[{\"byteLength\":282}]}";
    val jlen: usize = str_len(json);

    var bin: [284]u8;
    var z:   usize = 0;
    for (z < 284) {
        bin[z] = 0;
        z      = z + 1;
    }

    # POSITION
    put_f32(?bin[0], 0, 0.0);
    put_f32(?bin[0], 4, 0.0);
    put_f32(?bin[0], 8, 0.0);
    put_f32(?bin[0], 12, 1.0);
    put_f32(?bin[0], 16, 0.0);
    put_f32(?bin[0], 20, 0.0);
    put_f32(?bin[0], 24, 0.0);
    put_f32(?bin[0], 28, 1.0);
    put_f32(?bin[0], 32, 0.0);
    # WEIGHTS_0, fully weighted to joint 0
    put_f32(?bin[0], 36, 1.0);
    put_f32(?bin[0], 60, 1.0);
    put_f32(?bin[0], 72, 1.0);
    # inverse bind matrices: two identities
    put_identity_mat4(?bin[0], 84);
    put_identity_mat4(?bin[0], 148);
    # animation input times
    put_f32(?bin[0], 212, 0.0);
    put_f32(?bin[0], 216, 1.0);
    # animation rotation outputs: identity then 90 degrees about z
    put_f32(?bin[0], 220, 0.0);
    put_f32(?bin[0], 224, 0.0);
    put_f32(?bin[0], 228, 0.0);
    put_f32(?bin[0], 232, 1.0);
    put_f32(?bin[0], 236, 0.0);
    put_f32(?bin[0], 240, 0.0);
    put_f32(?bin[0], 244, 0.70710678);
    put_f32(?bin[0], 248, 0.70710678);
    # JOINTS_0 stays zero; indices
    put_u16(?bin[0], 276, 0);
    put_u16(?bin[0], 278, 1);
    put_u16(?bin[0], 280, 2);
    val blen: usize = 282;

    val jpad:   usize = (4 - (jlen % 4)) % 4;
    val jchunk: usize = jlen + jpad;
    val bpad:   usize = (4 - (blen % 4)) % 4;
    val bchunk: usize = blen + bpad;
    val total:  usize = 12 + 8 + jchunk + 8 + bchunk;

    put_u32(out, 0, 0x46546C67);
    put_u32(out, 4, 2);
    put_u32(out, 8, total::u32);

    put_u32(out, 12, jchunk::u32);
    put_u32(out, 16, 0x4E4F534A);
    var i: usize = 0;
    for (i < jlen) {
        out[20 + i] = json[i];
        i           = i + 1;
    }
    var jp: usize = 0;
    for (jp < jpad) {
        out[20 + jlen + jp] = ' ';
        jp                  = jp + 1;
    }

    val boff: usize = 20 + jchunk;
    put_u32(out, boff, bchunk::u32);
    put_u32(out, boff + 4, 0x004E4942);
    i = 0;
    for (i < bchunk) {
        out[boff + 8 + i] = bin[i];
        i                 = i + 1;
    }

    ret total;
}

# whether an allocator operation succeeded
fun ok_alloc(r: err[allo.Error]) bool {
    ret sel r.ok;
}

# whether a graphics operation was refused with a given model case
fun refused_joint_lookup(r: res[usize, Error], ambiguous: bool) bool {
    if (!sel r.err)       { ret false; }
    if (!sel r.err.model) { ret false; }
    if (ambiguous)        { ret sel r.err.model.joint_ambiguous; }
    ret sel r.err.model.no_joint;
}

test "model: skeleton and animation extract from a skinned, animated glb" {
    var glb: [2048]u8;
    val n:   usize = fixture_animated_glb(?glb[0]);

    var pa: allo.Allocator;
    if (!ok_alloc(page.make(?pa))) { ret 90; }
    var ar: arena.Arena;
    if (!ok_alloc(arena.init(?ar, ?pa, 65536))) { ret 91; }
    var aa: allo.Allocator;
    if (!ok_alloc(arena.make(?aa, ?ar))) {
        arena.dnit(?ar);
        ret 92;
    }

    val lr: res[gp.Loaded, gp.LoadError] = gp.load_glb(?glb[0], n, ?aa);
    if (sel lr.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var loaded: gp.Loaded = lr.ok;

    var sk:  Skeleton;
    val skr: err[Error] = build_skeleton(?loaded, ?aa, ?sk);
    if (sel skr.err) {
        arena.dnit(?ar);
        ret 2;
    }
    if (sk.count != 2) {
        arena.dnit(?ar);
        ret 3;
    }
    if (!sel sk.parents[0].none) {
        arena.dnit(?ar);
        ret 4;
    }
    val parent: opt[usize] = sk.parents[1];
    if (!sel parent.some) {
        arena.dnit(?ar);
        ret 5;
    }
    if (parent.some != 0) {
        arena.dnit(?ar);
        ret 5;
    }
    if (sk.order[0] != 0 || sk.order[1] != 1) {
        arena.dnit(?ar);
        ret 6;
    }
    if (sk.rest[1].position[0] != 1.0) {
        arena.dnit(?ar);
        ret 7;
    }

    val srr: opt[*gd.Skin] = slice.get[gd.Skin](loaded.document.skins, 0);
    if (sel srr.none) {
        arena.dnit(?ar);
        ret 8;
    }
    val skin: *gd.Skin = srr.some;

    val anr: res[Clips, Error] = build_animations(?loaded, skin, ?aa);
    if (sel anr.err) {
        arena.dnit(?ar);
        ret 9;
    }
    val clips: *Animation = anr.ok.clips;
    if (anr.ok.count != 1) {
        arena.dnit(?ar);
        ret 10;
    }
    if (!str_equals(clips[0].name, "spin")) {
        arena.dnit(?ar);
        ret 11;
    }
    if (clips[0].count != 1) {
        arena.dnit(?ar);
        ret 12;
    }
    if (clips[0].duration - 1.0 > 0.001 || clips[0].duration - 1.0 < 0.0 - 0.001) {
        arena.dnit(?ar);
        ret 13;
    }

    var pl: AnimationPlayer = animation_player(?sk, opt[*Animation].some{?clips[0]});
    pl.looping = 0;
    animation_player_advance(?pl, 1.0);
    # joint 0 turned 90 degrees about z: skinning column 0 becomes (0, 1, 0)
    if (pl.pose.matrices[0].m[0][1] < 0.99) {
        arena.dnit(?ar);
        ret 14;
    }
    if (pl.pose.matrices[0].m[0][0] > 0.01 || pl.pose.matrices[0].m[0][0] < 0.0 - 0.01) {
        arena.dnit(?ar);
        ret 15;
    }

    if (!ok_alloc(arena.dnit(?ar))) { ret 99; }
    ret 0;
}

# why the named-joint fixture could not be built
tag FixtureError: u8 {
    alloc: allo.Error;
    gltf:  gp.LoadError;
    build: Error;
    borrowed;
}

fun fixture_named_model() res[Model, FixtureError] {
    var glb: [2048]u8;
    val n:   usize           = fixture_animated_glb(?glb[0]);
    var pa:  allo.Allocator;
    val pm:  err[allo.Error] = page.make(?pa);
    if (sel pm.err) { ret res[Model, FixtureError].err{FixtureError.alloc{pm.err}}; }
    var parse_arena: arena.Arena;
    val pie:         err[allo.Error] = arena.init(?parse_arena, ?pa, 65536);
    if (sel pie.err) { ret res[Model, FixtureError].err{FixtureError.alloc{pie.err}}; }
    fin { arena.dnit(?parse_arena); }
    var parse_a: allo.Allocator;
    val pam:     err[allo.Error] = arena.make(?parse_a, ?parse_arena);
    if (sel pam.err) { ret res[Model, FixtureError].err{FixtureError.alloc{pam.err}}; }
    val parsed: res[gp.Loaded, gp.LoadError] = gp.load_glb(?glb[0], n, ?parse_a);
    if (sel parsed.err) { ret res[Model, FixtureError].err{FixtureError.gltf{parsed.err}}; }
    var loaded: gp.Loaded            = parsed.ok;
    val waist:  res[str, allo.Error] = text.str_dup(?parse_a, "waist");
    if (sel waist.err) { ret res[Model, FixtureError].err{FixtureError.alloc{waist.err}}; }
    val socket: res[str, allo.Error] = text.str_dup(?parse_a, "muzzle");
    if (sel socket.err) { ret res[Model, FixtureError].err{FixtureError.alloc{socket.err}}; }
    loaded.document.nodes.data[1].name = waist.ok;
    loaded.document.nodes.data[2].name = socket.ok;
    val skin: *gd.Skin = ?loaded.document.skins.data[0];
    skin.joints.data[0] = 2;
    skin.joints.data[1] = 1;
    var model: Model;
    val mie:   err[allo.Error] = arena.init(?model.arena, ?pa, 4096);
    if (sel mie.err) { ret res[Model, FixtureError].err{FixtureError.alloc{mie.err}}; }
    var kept: bool = false;
    fin {
        if (!kept) { arena.dnit(?model.arena); }
    }
    var persistent: allo.Allocator;
    val mam:        err[allo.Error] = arena.make(?persistent, ?model.arena);
    if (sel mam.err) { ret res[Model, FixtureError].err{FixtureError.alloc{mam.err}}; }
    val built: err[Error] = build_skeleton(?loaded, ?parse_a, ?model.skeleton);
    if (sel built.err) { ret res[Model, FixtureError].err{FixtureError.build{built.err}}; }
    val copied: err[Error] =
        build_joint_names(?loaded, skin, ?persistent, ?model.joint_names[0]);
    if (sel copied.err) { ret res[Model, FixtureError].err{FixtureError.build{copied.err}}; }
    val first:  opt[str] = model.joint_names[0];
    val second: opt[str] = model.joint_names[1];
    if (!sel first.some || !sel second.some) {
        ret res[Model, FixtureError].err{FixtureError.borrowed{}};
    }
    if (sel first.some && first.some == loaded.document.nodes.data[2].name) {
        ret res[Model, FixtureError].err{FixtureError.borrowed{}};
    }
    if (sel second.some && second.some == loaded.document.nodes.data[1].name) {
        ret res[Model, FixtureError].err{FixtureError.borrowed{}};
    }
    loaded.document.nodes.data[1].name[0] = 'x';
    loaded.document.nodes.data[2].name[0] = 'x';
    kept                                  = true;
    ret res[Model, FixtureError].ok{model};
}

test "model: named joints follow skin ordering and own names beyond parsing and moves" {
    val built: res[Model, FixtureError] = fixture_named_model();
    if (sel built.err) { ret 1; }
    var model: Model = built.ok;
    fin { arena.dnit(?model.arena); }
    val waist:  res[usize, Error] = model_joint(?model, "waist");
    val muzzle: res[usize, Error] = model_joint(?model, "muzzle");
    if (!sel waist.ok)  { ret 2; }
    if (!sel muzzle.ok) { ret 2; }
    if (waist.ok != 1)  { ret 3; }
    if (muzzle.ok != 0) { ret 3; }
    val parent: opt[usize] = model.skeleton.parents[0];
    if (!sel parent.some)                                 { ret 4; }
    if (parent.some != 1 || model.skeleton.order[0] != 1) { ret 4; }
    ret 0;
}

test "model: named joint lookup distinguishes missing and ambiguous names" {
    var model: Model;
    model.skeleton.count = 3;
    model.joint_names[0] = opt[str].some{"waist"};
    model.joint_names[2] = opt[str].some{"waist"};
    if (!refused_joint_lookup(model_joint(?model, "muzzle"), false)) { ret 1; }
    if (!refused_joint_lookup(model_joint(?model, "waist"), true))   { ret 2; }
    val unnamed: res[usize, Error] = model_joint(?model, nil);
    if (!sel unnamed.err)                        { ret 3; }
    if (!sel unnamed.err.model)                  { ret 4; }
    if (!sel unnamed.err.model.joint_name_empty) { ret 5; }
    val empty: res[usize, Error] = model_joint(?model, "");
    if (!sel empty.err) { ret 6; }
    ret 0;
}

test "model: optional unnamed joints remain legal and cannot match an empty query" {
    var nodes: [2]gd.Node;
    nodes[1].name = "";
    var joints: [2]usize = [2]usize{1, 0};
    var loaded: gp.Loaded;
    loaded.document.nodes = slice.make[gd.Node](?nodes[0], 2);
    var skin: gd.Skin;
    skin.joints = slice.make[usize](?joints[0], 2);
    var model: Model;
    model.skeleton.count = 2;
    model.joint_names[0] = opt[str].some{"previous"};
    val names: err[Error] =
        build_joint_names(?loaded, ?skin, nil, ?model.joint_names[0]);
    if (sel names.err)                                                    { ret 1; }
    if (!sel model.joint_names[0].none || !sel model.joint_names[1].none) { ret 2; }
    val empty: res[usize, Error] = model_joint(?model, "");
    if (!sel empty.err) { ret 3; }
    ret 0;
}

test "model: joint names reject invalid skin node references before allocation" {
    var joints: [1]usize = [1]usize{99};
    var skin:   gd.Skin;
    skin.joints = slice.make[usize](?joints[0], 1);
    var loaded:  gp.Loaded;
    var names:   [128]opt[str];
    val missing: err[Error] = build_joint_names(?loaded, ?skin, nil, ?names[0]);
    if (!sel missing.err)                  { ret 1; }
    if (!sel missing.err.model)            { ret 2; }
    if (!sel missing.err.model.joint_node) { ret 3; }
    skin.joints.size = 129;
    val oversized: err[Error] = build_joint_names(?loaded, ?skin, nil, ?names[0]);
    if (!sel oversized.err)              { ret 4; }
    if (!sel oversized.err.model)        { ret 5; }
    if (!sel oversized.err.model.joints) { ret 6; }
    ret 0;
}
