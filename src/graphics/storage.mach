# The per-frame storage buffer: bulk data a game's own shading reads.
#
# WHY THIS EXISTS ALONGSIDE THE UNIFORM SLOT. A draw's slot carries what that
# draw is parameterised by, and the game's own part of it is one aligned range:
# boom.graphics.descriptor.USER_BYTES, sixteen vec4s. That is the right size for
# a directional light, a fog term or a time value, and the wrong shape for a
# list. A traced light list is two vec4 per light, so six lights fit after a
# header, and a scene with lamps, hostiles and projectiles is forty. The
# workarounds are to batch the list across several full-screen passes, which
# scales in full-screen passes, or to encode it into a texture and sample it,
# which is a storage buffer with the type information thrown away.
#
# ONE BUFFER PER FRAME, NOT A SLOT PER DRAW. The whole point is that the payload
# is larger than a slot, so copying it per draw would defeat the exercise: a
# frame with forty lights and two hundred draws would upload the list two
# hundred times. A game fills this once as the frame opens and every draw in the
# frame reads the same bytes at binding 8.
#
# THAT IS A DIFFERENT CONTRACT FROM pass_set_user, and the difference is the one
# thing a game has to hold in mind. The user block is copied into each draw's
# slot as the draw is submitted, so changing it between two draws gives the two
# draws different values. This is one buffer for the whole frame: rewriting it
# changes what every draw in the frame reads, including draws already recorded.
# Per-draw parameters belong in the user block; the bulk array both draws index
# into belongs here.
#
# ONE BUFFER PER FRAME IN FLIGHT. The CPU runs up to MAX_FRAMES_IN_FLIGHT frames
# ahead, so the GPU is still reading the previous frame's contents while this
# one is written. Sharing a buffer between them is a data race with nothing
# expressing it, and its symptom is a light list that flickers between two
# frames' contents under load and looks correct the moment you stop to inspect
# it. The frame index the renderer already threads through its descriptor ring
# selects the buffer, so the two advance together.
#
# THE BUFFER GROWS AND IS NEVER SHRUNK, and that is deliberate rather than
# lazy. A flat capacity is the failure the palette ring and the vertex arena
# both had: work is refused in submission order, so the payload lost is whatever
# was written last, silently. Capping how many lights a game may have is also
# not boom's decision to make, which is the whole reason this module exists. So
# a write past the end allocates a larger buffer, copies what the frame has
# already written into it, and keeps the one it replaced.
#
# THE REPLACED BUFFER IS RETAINED, NOT FREED. Draws already recorded this frame
# hold descriptor sets naming it, and destroying a buffer the GPU may still read
# is a use-after-free the validation layers report far from its cause. Freeing
# at the next frame boundary would be legal and would only mean allocating it
# again the next time the same frame needs the room. Growth is therefore paid
# once, in the first frames, and never again; a game with forty lights pays for
# forty lights, once.

use boom.graphics.buffer.Buffer;
use boom.graphics.buffer.buffer_dnit;
use boom.graphics.buffer.buffer_init;
use boom.graphics.buffer.buffer_map;
use boom.graphics.buffer.buffer_unmap;
use boom.graphics.error.BufferError;
use boom.graphics.error.Capacity;
use boom.graphics.error.Error;
use boom.graphics.error.Stage;
use boom.graphics.frame.MAX_FRAMES_IN_FLIGHT;
use boom.graphics.vk.Vk;
use mem: std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use vk;

# The binding number the frame's storage buffer occupies.
#
# Past every binding a draw's own descriptors use, because it is not one of
# them: bindings 0 through 7 name ranges of the draw's uniform slot and the
# textures its material carries, and this names one buffer the whole frame
# shares. Placing it after them means adding a fifth texture or a fourth uniform
# range moves nothing, and a game shader that declares it does not have to be
# rewritten when they do. See boom.graphics.pipeline.set_layout_full.
pub val FRAME_STORAGE_BINDING: u32 = 8;

# Bytes a frame's buffer holds before anything grows.
#
# 64 KiB is 4096 vec4s, which is two thousand lights and far more than a frame
# usually carries. It is the starting size rather than the only size, so a game
# that wants more gets more and a game that wants less pays 128 KiB across both
# frames in flight for the room it did not use.
pub val STORAGE_BYTES: usize = 65536;

# The largest a frame's buffer may grow to.
#
# NOT A BUDGET, AND NOT THE KIND OF CAP THE PALETTE RING ARGUES AGAINST. That
# cap rationed a resource a game legitimately wanted more of and dropped the
# work that asked. This one is a device limit rather than a policy: 128 MiB is
# the smallest maxStorageBufferRange any Vulkan implementation may report, and
# the whole buffer is what the descriptor's range names, so a capacity past it
# is a descriptor a conforming device is entitled to reject. Growing past it
# would work on the machine it was written on and fail on someone else's, which
# is the failure UNIFORM_ALIGN exists to avoid on the other side of the set.
#
# It is also 8.4 million vec4s in a single frame, which is not a light list, a
# decal list or a tile field but a mistake in the arithmetic that produced the
# length. A game that genuinely needs more needs the device's own limit, which
# renderer_limits reports, and the payload split, which is a different
# design and not one to guess at.
#
# A request past it is refused and counted rather than clamped, because a
# clamped one would hand back a buffer that silently holds part of the payload.
pub val STORAGE_MAX_BYTES: usize = 134217728;

# How many buffers one frame may allocate over its life.
#
# The schedule doubles, so this bounds the total growth rather than the count of
# writes: 64 KiB reaches the ceiling above in eleven doublings, so twelve is
# every buffer a frame can ever hold and sixteen leaves the array room if either
# size moves. It exists so the array has a size, not as a limit anything meets.
pub val MAX_STORAGE_BUFFERS: usize = 16;

# One host-visible span a frame's payload lives in.
# ---
# buf:    the storage buffer
# mapped: its persistent mapping. Mapped once at creation, because a map and an
#         unmap around every frame are two driver calls to arrive back at the
#         same pointer.
# size:   its capacity in bytes
# live:   whether it has been created
pub rec StorageBuffer {
    buf:    Buffer;
    mapped: *u8;
    size:   usize;
    live:   bool;
}

# A growing per-frame storage buffer, one chain per frame in flight.
# ---
# bufs:    the chains, indexed by frame then buffer. The last one a frame has
#          created is the one it writes and the one draws are bound to; the
#          earlier ones are retained because recorded draws still name them.
# count:   how many buffers each frame has created
# used:    the highest byte each frame has written this frame, for reporting
# refused: writes refused because the buffer could not grow, over the whole life
#          of the storage rather than per frame, so a game polling it once at
#          shutdown still sees them
# ready:   whether creation completed
pub rec FrameStorage {
    bufs:    [2][16]StorageBuffer;
    count:   [2]usize;
    used:    [2]usize;
    refused: usize;
    ready:   bool;
}

# The capacity that replaces `current` when `need` bytes must fit.
#
# Doubling rather than sizing exactly to the need, because a game whose light
# count creeps up by one per frame would otherwise allocate a buffer every frame
# and reach MAX_STORAGE_BUFFERS in sixteen of them. Doubling makes the number of
# allocations logarithmic in the final size, so it is a handful over the life of
# the game whatever shape the growth has.
#
# Pure, so the schedule can be checked without a device. This is the arithmetic
# that decides whether a payload fits, and a mistake here is a buffer one byte
# short of what the shader reads. None when the need is past the ceiling.
pub fun storage_size_for(current: usize, need: usize) opt[usize] {
    if (need > STORAGE_MAX_BYTES) { ret opt[usize].none{}; }

    var size: usize = STORAGE_BYTES;
    if (current > size) { size = current; }
    for (size < need) { size = size * 2; }
    ret opt[usize].some{size};
}

# Create one buffer per frame in flight.
#
# Eagerly rather than on first write, so a device out of host-visible memory is
# reported when the renderer is built rather than midway through a frame, and so
# every descriptor set has a valid buffer to name from the first draw onwards.
pub fun storage_init(s: *FrameStorage, v: *Vk) err[Error] {
    s.ready   = false;
    s.refused = 0;

    var f: usize = 0;
    for (f < MAX_FRAMES_IN_FLIGHT) {
        s.count[f] = 0;
        s.used[f]  = 0;
        var b: usize = 0;
        for (b < MAX_STORAGE_BUFFERS) {
            s.bufs[f][b].live   = false;
            s.bufs[f][b].mapped = nil;
            s.bufs[f][b].size   = 0;
            b                   = b + 1;
        }
        val grown: err[Error] = storage_grow(s, v, f, STORAGE_BYTES);
        if (sel grown.err) {
            storage_dnit(s, v);
            ret grown;
        }
        f = f + 1;
    }

    s.ready = true;
    ret err[Error].ok{};
}

# Replace a frame's buffer with one large enough for `need` bytes.
#
# The bytes the frame has already written are carried into the new buffer, so a
# game that writes a header, draws, and then writes an array does not lose the
# header to the growth the array caused. The buffer being replaced is left
# alone: the draws already recorded name it, and it is destroyed with the rest
# at storage_dnit.
fun storage_grow(s: *FrameStorage, v: *Vk, frame: usize, need: usize) err[Error] {
    val n: usize = s.count[frame];
    if (n >= MAX_STORAGE_BUFFERS) { ret err[Error].err{Error.full{Capacity.storage{}}}; }

    var have: usize = 0;
    if (n > 0) { have = s.bufs[frame][n - 1].size; }

    val sized: opt[usize] = storage_size_for(have, need);
    if (sel sized.none) { ret err[Error].err{Error.full{Capacity.storage{}}}; }
    val size: usize = sized.some;

    # HOST_COHERENT as well as HOST_VISIBLE, so a write is visible to the GPU
    # without an explicit flush. Without it every write would need a
    # vkFlushMappedMemoryRanges over exactly the bytes touched, and a missed
    # flush is invisible on hardware whose host memory happens to be coherent
    # anyway.
    val br: err[Error] = buffer_init(?s.bufs[frame][n].buf, v, size::u64,
        vk.BUFFER_USAGE_STORAGE_BUFFER_BIT,
        vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT);
    if (sel br.err) { ret br; }

    val m: res[ptr, Error] = buffer_map(?s.bufs[frame][n].buf, v);
    if (sel m.err) {
        buffer_dnit(?s.bufs[frame][n].buf, v);
        ret err[Error].err{m.err};
    }

    var dst: *u8 = m.ok:~*u8;

    # ZEROED ONCE, AT CREATION. A fresh allocation's contents are undefined, so
    # a shader reading past what the game wrote would otherwise see whatever the
    # driver handed back, which differs between machines and between runs. That
    # is a game's bug either way, but one that reads as zeros everywhere is one
    # that can be found. It is not repeated per frame: a memset of megabytes
    # every frame would cost more than the payload it precedes.
    mem.zero[u8](dst, size);

    if (n > 0 && s.used[frame] > 0) {
        var carry: usize = s.used[frame];
        if (carry > have) { carry = have; }
        mem.copy[u8](dst, s.bufs[frame][n - 1].mapped, carry);
    }

    s.bufs[frame][n].mapped = dst;
    s.bufs[frame][n].size   = size;
    s.bufs[frame][n].live   = true;
    s.count[frame]          = n + 1;
    ret err[Error].ok{};
}

# Grow every frame's buffer to at least `bytes`.
#
# WHY A GAME CALLS THIS RATHER THAN LETTING THE WRITES GROW IT. A descriptor's
# range is the buffer's whole capacity, and a shader declaring a storage block
# larger than that range is invalid usage the validation layers report and a
# driver may honour anyway. A game whose shader declares a 256-light array but
# whose scene currently has four lights writes far less than it declares, so the
# capacity has to be reserved rather than discovered. Reserve what the shader
# declares, once, at start-up.
#
# It also removes the allocation from the frame that first needs the room, which
# is the frame least able to afford it.
#
# Every frame in flight is grown, not the open one: the other frame reaches the
# same payload one frame later and would otherwise allocate then. Growing a
# buffer the GPU is reading is safe because the one it replaces is retained.
pub fun storage_reserve(s: *FrameStorage, v: *Vk, bytes: usize) err[Error] {
    if (!s.ready)   { ret err[Error].err{Error.uninitialized{Stage.renderer{}}}; }
    if (bytes == 0) { ret err[Error].ok{}; }

    var f: usize = 0;
    for (f < MAX_FRAMES_IN_FLIGHT) {
        if (storage_capacity(s, f) < bytes) {
            val grown: err[Error] = storage_grow(s, v, f, bytes);
            if (sel grown.err) {
                s.refused = s.refused + 1;
                ret grown;
            }
        }
        f = f + 1;
    }
    ret err[Error].ok{};
}

# Reset a frame's write mark. Called once as the frame opens.
#
# The capacity is untouched: what a frame needed once it will need again, and
# the buffer is the thing this module exists to stop reallocating. Only the mark
# used for reporting and for the carry on growth is rewound.
pub fun storage_begin_frame(s: *FrameStorage, frame: usize) {
    if (!s.ready || frame >= MAX_FRAMES_IN_FLIGHT) { ret; }
    s.used[frame] = 0;
}

# Copy bytes into a frame's storage buffer at a byte offset, growing it to fit.
#
# The offset is a byte offset into the buffer and the layout is the game's
# business: boom copies the bytes and never looks at them, exactly as it does
# for the user block. What the game does have to match is what its shader
# declares, under std430 rather than std140 because this is a storage buffer.
#
# A refused write is counted and reported. It is the failure this module exists
# to make visible, so it is never partial: nothing is copied rather than the
# prefix that happened to fit.
# ---
# frame:  which frame in flight is being recorded
# offset: where in the buffer the bytes go
# src:    the bytes to copy
# len:    how many
pub fun storage_write(s: *FrameStorage, v: *Vk, frame: usize, offset: usize,
    src: *u8, len: usize) err[Error] {
    val wrote: err[Error] = write_storage(s, v, frame, offset, src, len);
    if (sel wrote.err) { s.refused = s.refused + 1; }
    ret wrote;
}

fun write_storage(s: *FrameStorage, v: *Vk, frame: usize, offset: usize,
    src: *u8, len: usize) err[Error] {
    if (!s.ready || frame >= MAX_FRAMES_IN_FLIGHT) {
        ret err[Error].err{Error.uninitialized{Stage.frame{}}};
    }
    if (src == nil || len == 0) { ret err[Error].err{Error.buffer{BufferError.empty{}}}; }

    val end: usize = offset + len;
    # An offset near the top of the address space wraps rather than overflowing
    # into a diagnosis, and the bounds check below would then pass on a range
    # that does not exist.
    if (end < offset) { ret err[Error].err{Error.buffer{BufferError.overrun{len::u64}}}; }

    if (end > storage_capacity(s, frame)) {
        val grown: err[Error] = storage_grow(s, v, frame, end);
        if (sel grown.err) { ret grown; }
    }

    var dst: *u8 = s.bufs[frame][s.count[frame] - 1].mapped;
    mem.copy[u8](?dst[offset], src, len);
    if (end > s.used[frame]) { s.used[frame] = end; }
    ret err[Error].ok{};
}

# The buffer a frame's draws are bound to.
#
# The last one the frame created, which is the one storage_write fills. Returns
# nil before storage_init, which the descriptor layer refuses rather than
# binding, because a set with an unwritten storage descriptor is undefined
# behaviour in Vulkan even where the shader never reads it.
pub fun storage_buffer(s: *FrameStorage, frame: usize) vk.Buffer {
    if (!s.ready || frame >= MAX_FRAMES_IN_FLIGHT) { ret nil; }
    if (s.count[frame] == 0)                       { ret nil; }
    ret s.bufs[frame][s.count[frame] - 1].buf.handle;
}

# The capacity of the buffer a frame's draws are bound to.
#
# This is also the descriptor's range, so it is the largest storage block a
# shader may declare. See storage_reserve.
pub fun storage_capacity(s: *FrameStorage, frame: usize) usize {
    if (frame >= MAX_FRAMES_IN_FLIGHT) { ret 0; }
    if (s.count[frame] == 0)           { ret 0; }
    ret s.bufs[frame][s.count[frame] - 1].size;
}

# The highest byte a frame has written this frame, for reporting.
pub fun storage_used(s: *FrameStorage, frame: usize) usize {
    if (!s.ready || frame >= MAX_FRAMES_IN_FLIGHT) { ret 0; }
    ret s.used[frame];
}

# How many buffers a frame has allocated over its life.
#
# One in a game that reserved what it needed or never outgrew the starting size.
# A number that climbs while the game runs means the payload is still growing,
# which is worth knowing before MAX_STORAGE_BUFFERS is reached.
pub fun storage_buffers(s: *FrameStorage, frame: usize) usize {
    if (frame >= MAX_FRAMES_IN_FLIGHT) { ret 0; }
    ret s.count[frame];
}

# Writes and reservations refused because the buffer could not grow.
#
# Zero in normal operation. Anything else means a shader read bytes the game
# believed it had written, which is otherwise indistinguishable from the shading
# being wrong.
pub fun storage_refused(s: *FrameStorage) usize {
    ret s.refused;
}

# Unmap and destroy every buffer, retained ones included.
pub fun storage_dnit(s: *FrameStorage, v: *Vk) {
    var f: usize = 0;
    for (f < MAX_FRAMES_IN_FLIGHT) {
        var b: usize = 0;
        for (b < MAX_STORAGE_BUFFERS) {
            if (s.bufs[f][b].live) {
                if (s.bufs[f][b].mapped != nil) {
                    buffer_unmap(?s.bufs[f][b].buf, v);
                    s.bufs[f][b].mapped = nil;
                }
                buffer_dnit(?s.bufs[f][b].buf, v);
                s.bufs[f][b].live = false;
            }
            s.bufs[f][b].size = 0;
            b                 = b + 1;
        }
        s.count[f] = 0;
        s.used[f]  = 0;
        f          = f + 1;
    }
    s.ready = false;
}

# --------------------------------------------------------------------- tests
#
# creating a buffer needs a device. what is testable without one is the growth
# schedule, the bounds arithmetic and the per-frame indexing.

#[testing]
fun sized(size: opt[usize], expected: usize) bool {
    ret sel size.some && size.some == expected;
}

#[testing]
fun refused(r: err[Error]) bool {
    ret sel r.err;
}

test size_for__doubles_within_ceiling {
    # a fixed step would allocate a buffer per frame for a payload creeping up by one
    if (!sized(storage_size_for(0, 0), STORAGE_BYTES)) { ret 1; }
    if (!sized(storage_size_for(STORAGE_BYTES, STORAGE_BYTES + 1),
        STORAGE_BYTES * 2)) { ret 2; }
    if (!sized(storage_size_for(STORAGE_BYTES, STORAGE_BYTES * 4 + 1),
        STORAGE_BYTES * 8)) { ret 3; }
    # never smaller than what the frame already has
    if (!sized(storage_size_for(STORAGE_BYTES * 8, 16), STORAGE_BYTES * 8)) { ret 4; }
    # past the ceiling is refused rather than clamped to a partial payload
    val past: opt[usize] = storage_size_for(0, STORAGE_MAX_BYTES + 1);
    if (!sel past.none)                                                    { ret 5; }
    if (!sized(storage_size_for(0, STORAGE_MAX_BYTES), STORAGE_MAX_BYTES)) { ret 6; }
    ret 0;
}

test size_for__ceiling_reached_by_doubling {
    # the base must double exactly onto the ceiling, in no more steps than a
    # frame can retain buffers, and stay a multiple of the largest offset alignment
    var size:  usize = STORAGE_BYTES;
    var steps: usize = 1;
    for (size < STORAGE_MAX_BYTES) {
        size  = size * 2;
        steps = steps + 1;
    }
    if (size != STORAGE_MAX_BYTES)   { ret 1; }
    if (steps > MAX_STORAGE_BUFFERS) { ret 2; }
    if ((STORAGE_BYTES % 256) != 0)  { ret 3; }
    ret 0;
}

test write__refused_outside_live_frame {
    # refused rather than copied into a nil mapping or past the ring
    var s:     FrameStorage;
    var v:     Vk;
    var bytes: [16]u8;
    s.ready   = false;
    s.refused = 0;
    if (!refused(storage_write(?s, ?v, 0, 0, ?bytes[0], 16))) { ret 1; }
    if (s.refused != 1)                                       { ret 2; }
    if (storage_buffer(?s, 0) != nil)                         { ret 3; }
    s.ready = true;
    if (!refused(storage_write(?s, ?v, MAX_FRAMES_IN_FLIGHT, 0, ?bytes[0], 16))) { ret 4; }
    if (storage_buffer(?s, MAX_FRAMES_IN_FLIGHT) != nil)                         { ret 5; }
    if (storage_capacity(?s, MAX_FRAMES_IN_FLIGHT) != 0)                         { ret 6; }
    ret 0;
}

test write__lands_at_offset_and_raises_mark {
    # a stack array stands in for the mapping
    var s:       FrameStorage;
    var v:       Vk;
    var backing: [256]u8;
    var i:       usize = 0;
    for (i < 256) {
        backing[i] = 0;
        i          = i + 1;
    }
    s.ready             = true;
    s.refused           = 0;
    s.count[0]          = 1;
    s.used[0]           = 0;
    s.bufs[0][0].live   = true;
    s.bufs[0][0].mapped = ?backing[0];
    s.bufs[0][0].size   = 256;

    var src: [4]u8 = [4]u8{1, 2, 3, 4};
    if (refused(storage_write(?s, ?v, 0, 64, ?src[0], 4))) { ret 1; }
    if (backing[64] != 1 || backing[67] != 4)              { ret 2; }
    if (backing[63] != 0 || backing[68] != 0)              { ret 3; }
    if (storage_used(?s, 0) != 68)                         { ret 4; }
    # a high-water mark, so an earlier write does not lower it
    if (refused(storage_write(?s, ?v, 0, 0, ?src[0], 4))) { ret 5; }
    if (storage_used(?s, 0) != 68)                        { ret 6; }
    ret 0;
}

test write__overrun_refused_whole {
    # with no device to grow, a write past capacity copies nothing rather than a prefix
    var s:       FrameStorage;
    var v:       Vk;
    var backing: [64]u8;
    v.ready             = false;
    s.ready             = true;
    s.refused           = 0;
    s.count[0]          = 1;
    s.used[0]           = 0;
    s.bufs[0][0].live   = true;
    s.bufs[0][0].mapped = ?backing[0];
    s.bufs[0][0].size   = 64;

    var src: [8]u8;
    if (!refused(storage_write(?s, ?v, 0, 60, ?src[0], 8))) { ret 1; }
    if (storage_used(?s, 0) != 0)                           { ret 2; }
    # ending exactly at capacity is legal
    if (refused(storage_write(?s, ?v, 0, 56, ?src[0], 8))) { ret 3; }
    # an offset that wraps the address space must not pass the bounds check
    if (!refused(storage_write(?s, ?v, 0, 0xFFFFFFFFFFFFFFF8, ?src[0], 16))) { ret 4; }
    if (s.refused != 2)                                                      { ret 5; }
    ret 0;
}

test frames__write_and_mark_separately {
    # the cpu fills one frame while the gpu reads the other
    var s: FrameStorage;
    var v: Vk;
    var a: [64]u8;
    var b: [64]u8;
    var i: usize = 0;
    for (i < 64) {
        a[i] = 0;
        b[i] = 0;
        i    = i + 1;
    }
    s.ready             = true;
    s.refused           = 0;
    s.count[0]          = 1;
    s.count[1]          = 1;
    s.used[0]           = 0;
    s.used[1]           = 0;
    s.bufs[0][0].live   = true;
    s.bufs[0][0].mapped = ?a[0];
    s.bufs[0][0].size   = 64;
    s.bufs[1][0].live   = true;
    s.bufs[1][0].mapped = ?b[0];
    s.bufs[1][0].size   = 64;

    var src: [4]u8 = [4]u8{9, 9, 9, 9};
    if (refused(storage_write(?s, ?v, 0, 0, ?src[0], 4))) { ret 1; }
    if (a[0] != 9 || b[0] != 0)                           { ret 2; }
    if (refused(storage_write(?s, ?v, 1, 0, ?src[0], 4))) { ret 3; }
    storage_begin_frame(?s, 0);
    if (storage_used(?s, 0) != 0) { ret 4; }
    if (storage_used(?s, 1) != 4) { ret 5; }
    ret 0;
}
