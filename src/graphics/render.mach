# the forward render path: clear the frame and draw meshes
#
# immediate-mode entry points the game calls each frame. draw binds a
# shader, uploads the standard model/view/projection uniforms from a
# transform and camera, and issues the GL draw; draw_material does the
# same after binding a material's shader, base color, and textures. these
# drive real GL calls against the live context boom.window provides and
# are compiled but not exercised by tests.

use gl.gl;
use boom.graphics.math.vec.Vec4;
use boom.graphics.math.mat.Mat4;
use boom.graphics.mesh.Mesh;
use boom.graphics.shader.Shader;
use boom.graphics.shader.shader_use;
use boom.graphics.shader.shader_set_mat4;
use boom.graphics.material.Material;
use boom.graphics.material.material_bind;
use boom.graphics.transform.Transform;
use boom.graphics.transform.transform_matrix;
use boom.graphics.camera.Camera;
use boom.graphics.camera.camera_view;
use boom.graphics.camera.camera_projection;

# enable the render state the forward path assumes
#
# turns on depth testing. call once after the GL context is current
# (after boom.window opens the window) and before drawing.
pub fun graphics_init() {
    gl.enable(gl.DEPTH_TEST);
}

# set the drawable region of the framebuffer
# ---
# width:  region width in pixels
# height: region height in pixels
pub fun viewport(width: i32, height: i32) {
    gl.viewport(0, 0, width, height);
}

# clear the color and depth buffers to a color
# ---
# color: the RGBA fill color
pub fun clear(color: Vec4) {
    gl.clear_color(color.x, color.y, color.z, color.w);
    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
}

# draw a mesh with a shader, transform, and camera
#
# binds the shader, uploads u_model, u_view, and u_projection, binds the
# mesh, and issues an indexed triangle draw. any other uniforms the
# shader needs should be set on it before this call.
# ---
# m:      mesh to draw
# s:      shader to draw with
# t:      model transform
# camera: viewpoint providing view and projection
pub fun draw(m: *Mesh, s: *Shader, t: *Transform, camera: *Camera) {
    var model: Mat4 = transform_matrix(t);
    var view:  Mat4 = camera_view(camera);
    var proj:  Mat4 = camera_projection(camera);

    shader_use(s);
    shader_set_mat4(s, "u_model", ?model);
    shader_set_mat4(s, "u_view", ?view);
    shader_set_mat4(s, "u_projection", ?proj);

    gl.bind_vertex_array(m.vao);
    gl.draw_elements(gl.TRIANGLES, m.index_count, gl.UNSIGNED_INT, nil);
    gl.bind_vertex_array(0);
}

# draw a mesh with a material, transform, and camera
#
# binds the material (its shader, base color, and textures), then draws
# as draw does with the material's shader.
# ---
# m:      mesh to draw
# mat:    material to draw with
# t:      model transform
# camera: viewpoint providing view and projection
pub fun draw_material(m: *Mesh, mat: *Material, t: *Transform, camera: *Camera) {
    material_bind(mat);
    draw(m, mat.shader, t, camera);
}
