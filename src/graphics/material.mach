# the Material handle: the parameters a surface draws with
#
# a Material bundles a base color and texture bindings so a game can
# describe a surface once and draw it with pass_draw_material. it
# references Textures the game owns; those handles must outlive the
# material.
#
# a material no longer carries a shader. GL let a draw pick a program and
# set named uniforms, so a material was the natural place to keep both; a
# Vulkan pipeline bakes both stages and its fixed-function state together,
# so the shader is the pipeline and belongs to the renderer. what remains
# here is what genuinely varies per surface, which is its colour and its
# textures.
#
# only the first texture reaches the shader today, because the sprite and
# mesh pipelines declare one combined image sampler. the table is wider
# because a material with a base colour map, a normal map and a roughness
# map is the obvious next step, and it is the pipeline's binding list that
# has to grow for it, not this record.

use boom.graphics.texture.Texture;
use boom.math.vec.Vec4;
use boom.math.vec.vec4;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.string.str;
use std.types.string.str_equals;

# the most texture bindings a material carries
pub val MAX_TEXTURES: i32 = 4;

# How a material binding samples its texture between texels.
pub def TextureFilter: u8;

pub val TEXTURE_NEAREST: TextureFilter = 0;
pub val TEXTURE_LINEAR:  TextureFilter = 1;

# one named texture binding within a material
# ---
# name:    the binding's name, for a game's own bookkeeping
# texture: the bound texture, owned by the game
# filter:  point or bilinear sampling for this binding
pub rec MaterialTexture {
    name:    str;
    texture: *Texture;
    filter:  TextureFilter;
}

# a surface description: a base color and texture bindings
# ---
# base_color:    multiplied into the sampled texel
# textures:      the texture bindings, first texture_count valid
# texture_count: number of live texture bindings
pub rec Material {
    base_color:    Vec4;
    textures:      [4]MaterialTexture;
    texture_count: i32;
}

# a material with a white base color and no textures
# ---
# ret: the new material
pub fun material() Material {
    var m: Material;
    m.base_color = vec4(1.0, 1.0, 1.0, 1.0);
    m.texture_count = 0;
    ret m;
}

# set the material's base color
# ---
# m:     material to modify
# color: the RGBA base color
pub fun material_set_color(m: *Material, color: Vec4) {
    m.base_color = color;
}

# add a named texture binding
#
# returns false without modifying the material when it already holds
# MAX_TEXTURES bindings.
# ---
# m:       material to modify
# name:    the sampler uniform name
# texture: the texture to bind, owned by the game
# ret:     true if the binding was added, false if the material is full
pub fun material_add_texture(m: *Material, name: str, texture: *Texture) bool {
    ret material_add_texture_filtered(m, name, texture, TEXTURE_NEAREST);
}

# Add a named texture binding with an explicit sampling filter.
#
# Filtering belongs to a binding rather than an image: the same rendered target
# may be inspected with nearest sampling and composited with linear sampling.
pub fun material_add_texture_filtered(m: *Material, name: str, texture: *Texture,
                                      filter: TextureFilter) bool {
    if (m.texture_count >= MAX_TEXTURES) {
        ret false;
    }
    m.textures[m.texture_count] = MaterialTexture{name: name, texture: texture, filter: filter};
    m.texture_count = m.texture_count + 1;
    ret true;
}

# the texture a draw samples, or nil when the material has none
#
# there is no bind step: a texture reaches a shader by being written into
# a descriptor set, which the renderer does per draw. this names which
# texture that write should use.
# ---
# m:   the material
# ret: the first bound texture, or nil
pub fun material_texture(m: *Material) *Texture {
    if (m.texture_count == 0) { ret nil; }
    ret m.textures[0].texture;
}

# A named texture binding, or nil.
#
# WHY THE SLOTS EXIST WHEN THE BUILT-IN PROGRAM READS ONE. boom's own mesh and
# lit programs sample a single albedo texture, which is what material_texture
# above returns. A game supplying its own pipeline is not limited to that: it
# binds whatever its own shader declares, and it needs a way to get the other
# maps out of the material it loaded. glTF materials routinely carry normal,
# metallic-roughness, occlusion and emissive alongside the base colour, and a
# Material that could hold only one would lose them at load time, where they
# cannot be recovered.
#
# So the slots are storage for the game's own use, not a promise that the
# built-in shader reads them. Naming rather than indexing, because the order
# glTF happens to list them in is not a contract.
# ---
# m:    the material
# name: the binding to look up, matched exactly
# ret:  the texture, or nil when the material has no such binding
pub fun material_texture_named(m: *Material, name: str) *Texture {
    var i: i32 = 0;
    for (i < m.texture_count) {
        if (str_equals(m.textures[i].name, name)) {
            ret m.textures[i].texture;
        }
        i = i + 1;
    }
    ret nil;
}

test "material: base color defaults to white" {
    var m: Material = material();
    if (m.base_color[0] != 1.0 || m.base_color[3] != 1.0) { ret 1; }
    if (m.texture_count != 0) { ret 2; }
    ret 0;
}

test "material: texture bindings fill then reject overflow" {
    var t: Texture;
    var m: Material = material();
    var i: i32 = 0;
    for (i < MAX_TEXTURES) {
        if (!material_add_texture(?m, "u_texture", ?t)) { ret 1; }
        i = i + 1;
    }
    if (m.texture_count != MAX_TEXTURES) { ret 2; }
    if (material_add_texture(?m, "u_texture", ?t)) { ret 3; }
    ret 0;
}

test "material: texture bindings default to nearest and may request linear" {
    var a: Texture;
    var b: Texture;
    var m: Material = material();
    if (!material_add_texture(?m, "albedo", ?a)) { ret 1; }
    if (!material_add_texture_filtered(?m, "field", ?b, TEXTURE_LINEAR)) { ret 2; }
    if (m.textures[0].filter != TEXTURE_NEAREST) { ret 3; }
    if (m.textures[1].filter != TEXTURE_LINEAR)  { ret 4; }
    ret 0;
}

test "material: an untextured material names no texture" {
    var m: Material = material();
    # nil rather than a dangling first entry, so the renderer writes the
    # uniform binding alone instead of a sampler pointing at nothing.
    if (material_texture(?m) != nil) { ret 1; }

    var t: Texture;
    material_add_texture(?m, "base", ?t);
    if (material_texture(?m) != ?t) { ret 2; }
    ret 0;
}

test "material: a named lookup finds the binding it names" {
    # The built-in programs read slot zero, so the other slots are only ever
    # reachable by name. A lookup that returned slot zero regardless would make
    # a custom pipeline bind the albedo as its normal map, which renders as a
    # surface lit from a direction that shifts with its colour.
    var albedo: Texture;
    var normal: Texture;
    var m: Material = material();
    if (!material_add_texture(?m, "albedo", ?albedo)) { ret 1; }
    if (!material_add_texture(?m, "normal", ?normal)) { ret 2; }

    if (material_texture_named(?m, "albedo") != ?albedo) { ret 3; }
    if (material_texture_named(?m, "normal") != ?normal) { ret 4; }
    # A binding the material does not carry is absent, not slot zero.
    if (material_texture_named(?m, "emissive") != nil)   { ret 5; }
    # And the unnamed accessor the built-in programs use is still the first.
    if (material_texture(?m) != ?albedo)                 { ret 6; }
    ret 0;
}
