# Text rendering: a rasterized glyph atlas drawn through the sprite path.
#
# mach-font parses TrueType and rasterizes a glyph into an 8-bit coverage
# bitmap. It does not decide where glyphs live, how they are uploaded, or how a
# string becomes draw calls. Those are an engine's job.
#
# Every glyph is rasterized once at load into a single RGBA texture laid out as
# a grid of fixed cells. Drawing a string is then N sprite quads against one
# texture, so a frame counter costs no per-frame rasterization and no texture
# thrash. Rasterizing per draw is the obvious implementation and is why naive
# text rendering is slow.
#
# Coverage is stored in the alpha channel with RGB left white, so the existing
# sprite shader tints text by multiplying. No text-specific shader and no
# single-channel texture format is needed.
#
# Each cell has a transparent one-texel gutter. Linear sampling can therefore
# soften coverage at a scaled edge without pulling in the neighbouring glyph.
#
# The atlas uses a fixed cell grid rather than tight packing. A tight packer
# buys atlas space and costs a rectangle-packing algorithm plus per-glyph
# bookkeeping. At one size and 95 glyphs the whole atlas is a few hundred
# kilobytes either way, so space is not the constraint and the simpler layout
# wins.
#
# Coverage is ASCII 32 to 126. That is a deliberate first cut and the limit is
# stated rather than hidden, because a codepoint outside the range draws
# nothing instead of drawing a wrong glyph. Wider coverage needs a real cmap
# walk and a packer, and neither changes the shapes here.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use allo:   std.allocator;
use page:   std.allocator.page;
use vector: std.collections.vector;
use vfs:    boom.vfs;
use finfo:  font.info;
use fglyf:  font.glyf;
use fhmtx:  font.hmtx;
use fhhea:  font.hhea;
use fraster: font.raster;
use font.error.FontError;
use font.error.TableId;

use boom.graphics.error.Error;
use boom.graphics.error.content.TextError;
use boom.graphics.texture.Texture;
use boom.graphics.texture.texture;
use boom.graphics.image.ColorSpace;
use boom.graphics.device.Device;
use boom.graphics.texture.texture_delete;
use boom.graphics.sprite.Rect;
use boom.graphics.sprite.rect;
use boom.graphics.renderer.Pass;
use boom.graphics.renderer.pass_draw_sprite_uv;
use boom.math.vec.Vec4;

# First and last codepoint the atlas covers
pub val FIRST_CP: u32 = 32;
pub val LAST_CP:  u32 = 126;
pub val GLYPH_COUNT: usize = 95;

# how glyph coverage and placement are represented
# ---
# smooth: retain fractional raster coverage and metrics
# pixel:  threshold coverage at the payload and place glyphs on whole pixels
pub tag FontRaster: u8 {
    smooth;
    pixel: u8;
}

# how the requested font size maps onto the face's design space
# ---
# line_height: requested pixels span the face's ascent through descent
# em:          requested pixels span one em, matching conventional font-size APIs
pub tag FontSizeMode: u8 {
    line_height;
    em;
}

# font atlas construction policy
# ---
# oversample: atlas texels per logical pixel; pixel fonts require one
# raster:     smooth coverage, or binary pixel coverage at a threshold
# size_mode:  whether the requested size describes the line or em square
pub rec FontOptions {
    oversample: usize;
    raster:     FontRaster;
    size_mode:  FontSizeMode;
}

# default smooth font policy
pub fun font_options() FontOptions {
    ret FontOptions{
        oversample: 1,
        raster: FontRaster.smooth{},
        size_mode: FontSizeMode.line_height{},
    };
}

# one-bit, em-sized font policy for pixel-sharp interfaces
pub fun font_pixel_options() FontOptions {
    ret FontOptions{
        oversample: 1,
        raster: FontRaster.pixel{128},
        size_mode: FontSizeMode.em{},
    };
}

# Scratch bounds for one glyph's outline, sized for the demanding glyphs in a
# normal text face rather than the worst case in any font ever made
val MAX_POINTS:   usize = 512;
val MAX_CONTOURS: usize = 32;
val MAX_EDGES:    usize = 1024;
val GUTTER:       usize = 1;

# One glyph's placement in the atlas and its metrics
# ---
# cell:     index into the atlas grid
# advance:  pen movement after drawing, in pixels
# offset_x: horizontal bearing from the pen to the atlas cell
# offset_y: vertical bearing from the line top to the atlas cell
# w:        rendered width in pixels
# h:        rendered height in pixels
rec Glyph {
    cell:     usize;
    advance:  f32;
    offset_x: f32;
    offset_y: f32;
    w:        f32;
    h:        f32;
}

# A loaded face at one logical pixel size
#
# A face may rasterize above its logical size. Its atlas then carries more edge
# coverage while measurement and drawing remain in the caller's coordinates.
# ---
# atlas:        the uploaded glyph texture
# glyphs:       per-codepoint placement and logical metrics
# cell_w:       atlas cell width in raster texels
# cell_h:       atlas cell height in raster texels
# cols:         cells per atlas row
# height:       logical ascent-to-descent height used for layout
# ascent:       logical line-top-to-baseline distance
# descent:      logical baseline-to-line-bottom distance, normally negative
# raster_scale: atlas texels per logical pixel
# pixel_snap:   whether origins and metrics stay on whole pixels
# valid:        whether the face holds a live atlas, cleared by font_delete
pub rec Font {
    atlas:        Texture;
    glyphs:       [95]Glyph;
    cell_w:       usize;
    cell_h:       usize;
    cols:         usize;
    height:       f32;
    ascent:       f32;
    descent:      f32;
    raster_scale: f32;
    pixel_snap:   bool;
    valid:        bool;
}

# Rasterize a face from borrowed TrueType bytes.
#
# The encoded bytes are read only during this call. The returned Font owns its
# uploaded atlas and glyph metrics, so the caller may release the byte span
# immediately after return.
#
# ---
# a:      allocator for temporary atlas and glyph storage
# d:      device receiving the rasterized atlas
# data:   complete TrueType byte stream, borrowed for this call
# len:    encoded byte count
# pixels: logical pixel height to rasterize and draw at
# ret:    an owned Font, or a parse/allocation/upload error
pub fun font_from_bytes(a: *allo.Allocator, d: *Device, data: *u8, len: usize,
                        pixels: f32) res[Font, Error] {
    ret font_from_bytes_with_options(a, d, data, len, pixels, font_options());
}

# Rasterize borrowed TrueType bytes above their logical draw resolution.
#
# Oversampling improves scaled text without changing advances or layout. The
# encoded bytes remain borrowed only for this call, as in `font_from_bytes`.
# ---
# a:          allocator for temporary atlas and glyph storage
# d:          device receiving the rasterized atlas
# data:       complete TrueType byte stream, borrowed for this call
# len:        encoded byte count
# pixels:     logical pixel height used for measurement and drawing
# oversample: raster texels per logical pixel, at least one
# ret:        an owned Font, or a validation/parse/allocation/upload error
pub fun font_from_bytes_oversampled(a: *allo.Allocator, d: *Device, data: *u8, len: usize,
                                    pixels: f32, oversample: usize) res[Font, Error] {
    var options: FontOptions = font_options();
    options.oversample = oversample;
    ret font_from_bytes_with_options(a, d, data, len, pixels, options);
}

# the Error for a parser refusal
fun font_failed(e: FontError) Error {
    ret Error.text{TextError.font{e}};
}

# the Error for a refused atlas policy
fun text_refused(e: TextError) Error {
    ret Error.text{e};
}

# the atlas policy a request may not use, or none when it is usable
fun options_refusal(pixels: f32, options: FontOptions) opt[TextError] {
    if (pixels <= 0.0) { ret opt[TextError].some{TextError.pixel_height{}}; }
    if (options.oversample == 0) { ret opt[TextError].some{TextError.oversample{}}; }
    if (sel options.raster.pixel) {
        if (options.raster.pixel == 0) { ret opt[TextError].some{TextError.threshold{}}; }
        if (options.oversample != 1 || pixels != pixel_round(pixels)) {
            ret opt[TextError].some{TextError.pixel_scale{}};
        }
    }
    ret opt[TextError].none{};
}

# whether a glyph refusal means only that boom's scratch cannot hold it
#
# such a glyph keeps its advance and draws nothing, as a codepoint the face
# lacks does. every other refusal is a malformed face and fails the load.
fun glyph_unrenderable(e: FontError) bool {
    ret sel e.points_full || sel e.contours_full || sel e.edges_full
        || sel e.point_matched_component;
}

# Rasterize borrowed TrueType bytes with an explicit atlas policy.
#
# Pixel fonts use binary alpha, integral placement, and conventional em sizing.
# Their requested size and raster scale must therefore both be whole pixels.
pub fun font_from_bytes_with_options(a: *allo.Allocator, d: *Device,
                                     data: *u8, len: usize, pixels: f32,
                                     options: FontOptions) res[Font, Error] {
    var f: Font;
    f.valid = false;

    val refused: opt[TextError] = options_refusal(pixels, options);
    if (sel refused.some) { ret res[Font, Error].err{text_refused(refused.some)}; }

    val parsed: res[finfo.Font, FontError] = finfo.init(data, len);
    if (sel parsed.err) { ret res[Font, Error].err{font_failed(parsed.err)}; }
    var face: finfo.Font = parsed.ok;
    val metrics: res[fhhea.Hhea, FontError] = line_metrics(?face);
    if (sel metrics.err) { ret res[Font, Error].err{font_failed(metrics.err)}; }
    val hhea: fhhea.Hhea = metrics.ok;

    val raster_scale: f32 = options.oversample::f32;
    val scaled: res[f32, FontError] = font_scale(?face, pixels, options.size_mode);
    if (sel scaled.err) { ret res[Font, Error].err{font_failed(scaled.err)}; }
    val logical_scale: f32 = scaled.ok;
    val glyph_scale: f32 = logical_scale * raster_scale;
    val line_height: f32 =
        (hhea.ascent::i32 - hhea.descent::i32)::f32 * logical_scale;

    # Scale the complete established cell, including its margin, so changing
    # atlas resolution cannot change the logical destination rectangle.
    val cell: usize = logical_cell_size(line_height) * options.oversample;
    f.cell_w = cell;
    f.cell_h = cell;
    f.cols   = 16;
    f.height = line_height;
    f.ascent = hhea.ascent::f32 * logical_scale;
    f.descent = hhea.descent::f32 * logical_scale;
    f.raster_scale = raster_scale;
    f.pixel_snap = sel options.raster.pixel;
    if (f.pixel_snap) {
        f.height = pixel_round(f.height);
        f.ascent = pixel_round(f.ascent);
        f.descent = pixel_round(f.descent);
    }

    val rows:   usize = (GLYPH_COUNT + f.cols - 1) / f.cols;
    val stride: usize = cell + GUTTER * 2;
    val aw:     usize = f.cols * stride;
    val ah:     usize = rows * stride;

    val ar: res[*u8, allo.Error] = allo.allocate[u8](a, aw * ah * 4);
    if (sel ar.err) { ret res[Font, Error].err{Error.alloc{ar.err}}; }
    val rgba: *u8 = ar.ok;
    clear_atlas(rgba, aw * ah);

    val cr: res[*u8, allo.Error] = allo.allocate[u8](a, cell * cell);
    if (sel cr.err) {
        allo.deallocate[u8](a, rgba, aw * ah * 4);
        ret res[Font, Error].err{Error.alloc{cr.err}};
    }
    val cov: *u8 = cr.ok;

    val laid: err[Error] = raster_glyphs(?f, ?face, rgba, aw, cov, cell,
                                         logical_scale, glyph_scale, options.raster);
    if (sel laid.err) {
        allo.deallocate[u8](a, cov, cell * cell);
        allo.deallocate[u8](a, rgba, aw * ah * 4);
        ret res[Font, Error].err{laid.err};
    }

    # sRGB. The atlas leaves RGB white and stores coverage in alpha, and Vulkan's
    # sRGB formats leave alpha linear, so the transfer function touches only the
    # white and coverage arrives at the shader exactly as rasterized.
    val tr: res[Texture, Error] = texture(d, rgba, aw::i32, ah::i32, ColorSpace.srgb{});
    val cov_freed: err[allo.Error] = allo.deallocate[u8](a, cov, cell * cell);
    val rgba_freed: err[allo.Error] = allo.deallocate[u8](a, rgba, aw * ah * 4);
    if (sel tr.err) { ret res[Font, Error].err{tr.err}; }
    f.atlas = tr.ok;
    f.valid = true;
    if (sel cov_freed.err) {
        font_delete(d, ?f);
        ret res[Font, Error].err{Error.alloc{cov_freed.err}};
    }
    if (sel rgba_freed.err) {
        font_delete(d, ?f);
        ret res[Font, Error].err{Error.alloc{rgba_freed.err}};
    }
    ret res[Font, Error].ok{f};
}

# the face's horizontal line metrics, which layout cannot proceed without
fun line_metrics(face: *finfo.Font) res[fhhea.Hhea, FontError] {
    if (sel face.hhea.some) { ret res[fhhea.Hhea, FontError].ok{face.hhea.some}; }
    ret res[fhhea.Hhea, FontError].err{FontError.missing_table{TableId.hhea{}}};
}

# rasterize every covered codepoint into its atlas cell and record its metrics
fun raster_glyphs(f: *Font, face: *finfo.Font, rgba: *u8, aw: usize, cov: *u8,
                  cell: usize, logical_scale: f32, glyph_scale: f32,
                  raster: FontRaster) err[Error] {
    var pts:   [512]fglyf.Point;
    var ends:  [32]u16;
    var edges: [1024]fraster.Edge;

    var g: usize = 0;
    for (g < GLYPH_COUNT) {
        val cp: u32 = FIRST_CP + g::u32;
        f.glyphs[g].cell = g;
        f.glyphs[g].advance = 0.0;
        f.glyphs[g].offset_x = 0.0;
        f.glyphs[g].offset_y = 0.0;
        f.glyphs[g].w    = 0.0;
        f.glyphs[g].h    = 0.0;

        val mapped: res[u16, FontError] = finfo.glyph_index(face, cp);
        if (sel mapped.err) { ret err[Error].err{font_failed(mapped.err)}; }
        val gi: u16 = mapped.ok;

        val hm: res[fhmtx.HMetrics, FontError] = finfo.glyph_hmetrics(face, gi);
        if (sel hm.err) { ret err[Error].err{font_failed(hm.err)}; }
        f.glyphs[g].advance = hm.ok.advance::f32 * logical_scale;
        f.glyphs[g].offset_x = hm.ok.lsb::f32 * logical_scale;
        if (f.pixel_snap) {
            f.glyphs[g].advance = pixel_round(f.glyphs[g].advance);
            f.glyphs[g].offset_x = pixel_round(f.glyphs[g].offset_x);
        }

        val info: res[opt[fglyf.GlyphInfo], FontError] = finfo.glyph_info(face, gi);
        if (sel info.err) { ret err[Error].err{font_failed(info.err)}; }

        var k: usize = 0;
        for (k < cell * cell) { cov[k] = 0; k = k + 1; }

        val rendered: err[FontError] = finfo.render_glyph(face, gi, glyph_scale,
            ?pts[0], MAX_POINTS, ?ends[0], MAX_CONTOURS,
            ?edges[0], MAX_EDGES, cov, cell::u16, cell::u16);
        if (sel rendered.err) {
            if (!glyph_unrenderable(rendered.err)) { ret err[Error].err{font_failed(rendered.err)}; }
        }
        or (sel info.ok.some) {
            val visible: bool = blit_cell(rgba, aw, cov, cell, g, f.cols, raster);
            if (visible) {
                f.glyphs[g].w = cell::f32 / f.raster_scale;
                f.glyphs[g].h = cell::f32 / f.raster_scale;
                f.glyphs[g].offset_y = baseline_offset(
                    f.ascent,
                    f.glyphs[g].h,
                    info.ok.some.y_min,
                    logical_scale,
                );
                if (f.pixel_snap) {
                    f.glyphs[g].offset_y = pixel_round(f.glyphs[g].offset_y);
                }
            }
        }
        g = g + 1;
    }
    ret err[Error].ok{};
}

# Load a face from a virtual path and rasterize its atlas.
# ---
# a:      allocator for the file bytes and temporary atlas storage
# d:      device receiving the rasterized atlas
# vpath:  virtual path to a TrueType file, e.g. res://fonts/ui.ttf
# pixels: logical pixel height to rasterize and draw at
# ret:    an owned Font, or a read/parse/allocation/upload error
pub fun font_load(a: *allo.Allocator, d: *Device, vpath: str,
                  pixels: f32) res[Font, Error] {
    ret font_load_with_options(a, d, vpath, pixels, font_options());
}

# Load a face from a virtual path with a higher raster than logical resolution.
pub fun font_load_oversampled(a: *allo.Allocator, d: *Device, vpath: str,
                              pixels: f32, oversample: usize) res[Font, Error] {
    var options: FontOptions = font_options();
    options.oversample = oversample;
    ret font_load_with_options(a, d, vpath, pixels, options);
}

# Load a face from a virtual path with an explicit atlas policy.
pub fun font_load_with_options(a: *allo.Allocator, d: *Device, vpath: str,
                               pixels: f32, options: FontOptions) res[Font, Error] {
    val br: res[vector.Vector[u8], vfs.ReadError] = vfs.vfs_read_bytes(a, vpath);
    if (sel br.err) { ret res[Font, Error].err{Error.load{br.err}}; }
    var bytes: vector.Vector[u8] = br.ok;
    val fr: res[Font, Error] = font_from_bytes_with_options(
        a, d, bytes.data, bytes.len, pixels, options);
    val freed: err[allo.Error] = vector.dnit[u8](?bytes);
    if (sel fr.err) { ret fr; }
    if (sel freed.err) {
        var f: Font = fr.ok;
        font_delete(d, ?f);
        ret res[Font, Error].err{Error.alloc{freed.err}};
    }
    ret fr;
}

# Fill an atlas with transparent white so filtered coverage keeps its colour.
fun clear_atlas(rgba: *u8, pixels: usize) {
    var i: usize = 0;
    for (i < pixels) {
        val o: usize = i * 4;
        rgba[o]     = 255;
        rgba[o + 1] = 255;
        rgba[o + 2] = 255;
        rgba[o + 3] = 0;
        i = i + 1;
    }
}

# Copy one coverage bitmap into the padded atlas cell as white-with-alpha.
fun blit_cell(rgba: *u8, atlas_w: usize, cov: *u8,
              cell: usize, index: usize, cols: usize,
              raster: FontRaster) bool {
    val stride: usize = cell + GUTTER * 2;
    val cx: usize = (index % cols) * stride + GUTTER;
    val cy: usize = (index / cols) * stride + GUTTER;
    var visible: bool = false;
    var y: usize = 0;
    for (y < cell) {
        var x: usize = 0;
        for (x < cell) {
            val o: usize = ((cy + y) * atlas_w + (cx + x)) * 4;
            val alpha: u8 = coverage_alpha(cov[y * cell + x], raster);
            if (alpha != 0) { visible = true; }
            rgba[o]     = 255;
            rgba[o + 1] = 255;
            rgba[o + 2] = 255;
            rgba[o + 3] = alpha;
            x = x + 1;
        }
        y = y + 1;
    }
    ret visible;
}

fun coverage_alpha(coverage: u8, raster: FontRaster) u8 {
    if (sel raster.pixel) {
        if (coverage >= raster.pixel) { ret 255; }
        ret 0;
    }
    ret coverage;
}

fun font_scale(face: *finfo.Font, pixels: f32, mode: FontSizeMode) res[f32, FontError] {
    if (sel mode.em) { ret res[f32, FontError].ok{finfo.scale_for_em_size(face, pixels)}; }
    ret finfo.scale_for_pixel_height(face, pixels);
}

fun pixel_round(value: f32) f32 {
    if (value < 0.0) { ret (value - 0.5)::i64::f32; }
    ret (value + 0.5)::i64::f32;
}

fun baseline_offset(ascent: f32, cell_height: f32,
                    y_min: i16, scale: f32) f32 {
    ret ascent - cell_height - y_min::f32 * scale;
}

# Release the atlas texture
pub fun font_delete(d: *Device, f: *Font) {
    if (!f.valid) { ret; }
    texture_delete(d, ?f.atlas);
    f.valid = false;
}

# The glyph slot for a codepoint, none when outside the atlas
fun slot_of(cp: u32) opt[usize] {
    if (cp < FIRST_CP || cp > LAST_CP) { ret opt[usize].none{}; }
    ret opt[usize].some{(cp - FIRST_CP)::usize};
}

# Width of a string in pixels, without drawing it
#
# UI has to lay out before it draws, so this walks the same advances the draw
# does. measuring by counting characters times a fixed width is wrong for any
# proportional face, which is every face worth using.
pub fun text_measure(f: *Font, s: str) f32 {
    if (!f.valid || s == nil) { ret 0.0; }
    var w: f32 = 0.0;
    var i: usize = 0;
    val n: usize = str_len(s);
    for (i < n) {
        val sl: opt[usize] = slot_of(s[i]::u32);
        if (sel sl.some) { w = w + f.glyphs[sl.some].advance; }
        i = i + 1;
    }
    ret w;
}

# The source rect of a glyph's cell in the atlas, in normalized UV
fun cell_uv(f: *Font, slot: usize) Rect {
    val cols: usize = f.cols;
    val rows: usize = (GLYPH_COUNT + cols - 1) / cols;
    val stride_x: usize = f.cell_w + GUTTER * 2;
    val stride_y: usize = f.cell_h + GUTTER * 2;
    val aw: f32 = (cols * stride_x)::f32;
    val ah: f32 = (rows * stride_y)::f32;
    val u: f32 = ((slot % cols) * stride_x + GUTTER)::f32 / aw;
    val v: f32 = ((slot / cols) * stride_y + GUTTER)::f32 / ah;
    ret rect(u, v, f.cell_w::f32 / aw, f.cell_h::f32 / ah);
}

fun glyph_dest(f: *Font, glyph: *Glyph, x: f32, y: f32) Rect {
    var px: f32 = x;
    var py: f32 = y;
    if (f.pixel_snap) {
        px = pixel_round(px);
        py = pixel_round(py);
    }
    ret rect(px + glyph.offset_x, py + glyph.offset_y,
            f.cell_w::f32 / f.raster_scale,
            f.cell_h::f32 / f.raster_scale);
}

fun logical_cell_size(pixels: f32) usize {
    val whole: i64 = pixels::i64;
    ret (whole + whole / 4 + 2)::usize;
}

# Draw a string into a pass, returning the pen x after the last glyph
#
# `x`/`y` are the top-left of the line box in the pass's coordinate space,
# which for an overlay pass is pixels. Glyph bearings place every atlas cell
# against the line's shared baseline. One sprite quad per glyph against one
# texture lets a caller draw many strings without a bind between them.
# ---
# p:    the pass to draw into, normally an overlay pass
# f:    the loaded face
# s:    the string
# x:    left edge of the first glyph
# y:    top edge of the line
# tint: colour multiplied over the glyph coverage
# ret:  the x the next glyph would start at, for chained draws
pub fun text_draw(p: *Pass, f: *Font, s: str, x: f32, y: f32, tint: Vec4) f32 {
    if (!f.valid || s == nil) { ret x; }
    var pen: f32 = x;
    if (f.pixel_snap) { pen = pixel_round(pen); }
    var i: usize = 0;
    val n: usize = str_len(s);
    for (i < n) {
        val sl: opt[usize] = slot_of(s[i]::u32);
        if (sel sl.some) {
            # A space has an advance and no coverage, so skipping the quad
            # saves a draw call per space without changing the layout
            if (f.glyphs[sl.some].w > 0.0) {
                val dest: Rect = glyph_dest(f, ?f.glyphs[sl.some], pen, y);
                pass_draw_sprite_uv(p, opt[*Texture].some{?f.atlas}, dest, cell_uv(f, sl.some), tint);
            }
            pen = pen + f.glyphs[sl.some].advance;
        }
        i = i + 1;
    }
    ret pen;
}

# --------------------------------------------------------------------- tests
#
# Rasterizing and uploading need a font file and a device, so these cover
# the layout arithmetic -- slot mapping, measurement, and atlas UVs -- which is
# what a caller's positioning depends on and where an off-by-one is silent.

# A face with known metrics, for layout tests that need no font file
fun test_font(advance: f32) Font {
    var f: Font;
    f.cell_w = 16;
    f.cell_h = 16;
    f.cols   = 16;
    f.height = 12.0;
    f.ascent = 9.0;
    f.descent = 0.0 - 3.0;
    f.raster_scale = 1.0;
    f.pixel_snap = false;
    f.valid  = true;
    var g: usize = 0;
    for (g < GLYPH_COUNT) {
        f.glyphs[g].cell    = g;
        f.glyphs[g].advance = advance;
        f.glyphs[g].offset_x = 0.0;
        f.glyphs[g].offset_y = 0.0;
        f.glyphs[g].w       = 16.0;
        f.glyphs[g].h       = 16.0;
        g = g + 1;
    }
    ret f;
}

fun text_near(a: f32, b: f32) bool {
    var d: f32 = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    ret d < 0.000001;
}

test "text: a codepoint outside the atlas maps to no slot" {
    # Below the range, above it, and the boundaries themselves
    val below: opt[usize] = slot_of(31);
    if (!sel below.none) { ret 1; }
    val above: opt[usize] = slot_of(127);
    if (!sel above.none) { ret 2; }
    val first: opt[usize] = slot_of(32);
    if (!(sel first.some && first.some == 0)) { ret 3; }
    val last: opt[usize] = slot_of(126);
    if (!(sel last.some && last.some == GLYPH_COUNT - 1)) { ret 4; }
    ret 0;
}

test "text: borrowed invalid font bytes return a parse error before upload" {
    var a: allo.Allocator;
    val made: err[allo.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    var d: Device;
    var bytes: [4]u8 = [4]u8{0, 1, 2, 3};
    val r: res[Font, Error] = font_from_bytes(?a, ?d, ?bytes[0], 4, 16.0);
    if (!sel r.err) { ret 2; }
    if (!sel r.err.text) { ret 3; }
    if (!sel r.err.text.font) { ret 4; }
    ret 0;
}

test "text: pixel policy preserves an em-aligned design grid" {
    val options: FontOptions = font_pixel_options();
    if (!sel options.raster.pixel) { ret 1; }
    if (!sel options.size_mode.em) { ret 1; }

    var face: finfo.Font;
    face.head.units_per_em = 550;
    face.hhea = opt[fhhea.Hhea].some{fhhea.Hhea{
        ascent: 550, descent: 0 - 150, line_gap: 0,
        advance_width_max: 0, num_h_metrics: 1,
    }};
    val scaled: res[f32, FontError] = font_scale(?face, 11.0, options.size_mode);
    if (!sel scaled.ok) { ret 2; }
    val scale: f32 = scaled.ok;
    if (scale != 0.02) { ret 2; }
    if (50.0 * scale != 1.0) { ret 3; }
    val hhea: res[fhhea.Hhea, FontError] = line_metrics(?face);
    if (!sel hhea.ok) { ret 4; }
    if ((hhea.ok.ascent::i32 - hhea.ok.descent::i32)::f32 * scale != 14.0) { ret 5; }
    ret 0;
}

test "text: an invalid atlas policy is refused with its case" {
    val bad_height: opt[TextError] = options_refusal(0.0, font_options());
    if (!(sel bad_height.some && sel bad_height.some.pixel_height)) { ret 1; }

    var zero: FontOptions = font_options();
    zero.oversample = 0;
    val bad_oversample: opt[TextError] = options_refusal(16.0, zero);
    if (!(sel bad_oversample.some && sel bad_oversample.some.oversample)) { ret 2; }

    var blind: FontOptions = font_pixel_options();
    blind.raster = FontRaster.pixel{0};
    val bad_threshold: opt[TextError] = options_refusal(11.0, blind);
    if (!(sel bad_threshold.some && sel bad_threshold.some.threshold)) { ret 3; }

    val fractional: opt[TextError] = options_refusal(11.5, font_pixel_options());
    if (!(sel fractional.some && sel fractional.some.pixel_scale)) { ret 4; }

    val usable: opt[TextError] = options_refusal(11.0, font_pixel_options());
    if (!sel usable.none) { ret 5; }
    ret 0;
}

test "text: measuring walks advances, not character count" {
    var f: Font = test_font(7.0);
    if (text_measure(?f, "abc") != 21.0) { ret 1; }
    if (text_measure(?f, "") != 0.0)     { ret 1; }

    # A codepoint outside the atlas contributes nothing rather than a default
    # width, so an unsupported character cannot silently shift a layout
    if (text_measure(?f, "a\tb") != 14.0) { ret 1; }
    ret 0;
}

test "text: an invalid face measures zero rather than reading glyphs" {
    var f: Font = test_font(7.0);
    f.valid = false;
    if (text_measure(?f, "abc") != 0.0) { ret 1; }
    ret 0;
}

test "text: oversampling preserves logical glyph geometry" {
    var f: Font = test_font(7.0);
    if (logical_cell_size(16.0) != 22) { ret 1; }
    f.cell_w = logical_cell_size(16.0) * 2;
    f.cell_h = logical_cell_size(16.0) * 2;
    f.raster_scale = 2.0;
    val d: Rect = glyph_dest(?f, ?f.glyphs[0], 3.0, 5.0);
    if (d.x != 3.0 || d.y != 5.0) { ret 2; }
    if (d.w != 22.0 || d.h != 22.0) { ret 3; }
    if (text_measure(?f, "abc") != 21.0) { ret 4; }
    ret 0;
}

test "text: glyph cells preserve one baseline across vertical bearings" {
    val uppercase: f32 = baseline_offset(9.0, 16.0, 0, 1.0);
    val descender: f32 = baseline_offset(9.0, 16.0, 0 - 3, 1.0);
    if (uppercase != 0.0 - 7.0 || descender != 0.0 - 4.0) { ret 1; }

    val uppercase_baseline: f32 = uppercase + 16.0;
    val descender_baseline: f32 = descender + 13.0;
    if (uppercase_baseline != 9.0 || descender_baseline != 9.0) { ret 2; }
    ret 0;
}

test "text: atlas UVs leave a transparent gutter between glyphs" {
    var f: Font = test_font(7.0);
    val rows: usize = (GLYPH_COUNT + f.cols - 1) / f.cols;
    val stride_x: usize = f.cell_w + GUTTER * 2;
    val stride_y: usize = f.cell_h + GUTTER * 2;
    val aw: f32 = (f.cols * stride_x)::f32;
    val ah: f32 = (rows * stride_y)::f32;

    val first: Rect = cell_uv(?f, 0);
    if (!text_near(first.x, 1.0 / aw) || !text_near(first.y, 1.0 / ah)) { ret 1; }
    if (!text_near(first.w, f.cell_w::f32 / aw)) { ret 1; }
    if (!text_near(first.h, f.cell_h::f32 / ah)) { ret 1; }

    # Adjacent source rectangles have two transparent texels between them: the
    # trailing gutter of one slot and the leading gutter of the next.
    val col1:  Rect = cell_uv(?f, 1);
    if (!text_near(col1.x - (first.x + first.w), 2.0 / aw)) { ret 1; }

    val row1: Rect = cell_uv(?f, 16);
    if (!text_near(row1.y - (first.y + first.h), 2.0 / ah)) { ret 1; }
    ret 0;
}

test "text: glyph coverage stays inside a white transparent gutter" {
    var rgba: [64]u8;
    var cov: [4]u8 = [4]u8{32, 64, 128, 255};
    clear_atlas(?rgba[0], 16);
    blit_cell(?rgba[0], 4, ?cov[0], 2, 0, 1, FontRaster.smooth{});

    # Both outer corners remain transparent white, so a linear edge sample
    # softens alpha without introducing a dark fringe.
    if (rgba[0] != 255 || rgba[1] != 255 || rgba[2] != 255 || rgba[3] != 0) { ret 1; }
    if (rgba[60] != 255 || rgba[61] != 255 || rgba[62] != 255 || rgba[63] != 0) { ret 2; }

    # The two-by-two coverage starts one texel inside the four-by-four slot.
    if (rgba[23] != 32 || rgba[27] != 64) { ret 3; }
    if (rgba[39] != 128 || rgba[43] != 255) { ret 4; }
    ret 0;
}

test "text: empty coverage remains advance-only" {
    var rgba: [64]u8;
    var cov: [4]u8;
    clear_atlas(?rgba[0], 16);
    if (blit_cell(?rgba[0], 4, ?cov[0], 2, 0, 1, FontRaster.smooth{})) { ret 1; }
    ret 0;
}

test "text: pixel coverage is one bit at the threshold" {
    var rgba: [64]u8;
    var cov: [4]u8 = [4]u8{0, 127, 128, 255};
    clear_atlas(?rgba[0], 16);
    if (!blit_cell(?rgba[0], 4, ?cov[0], 2, 0, 1, FontRaster.pixel{128})) { ret 1; }
    if (rgba[23] != 0 || rgba[27] != 0) { ret 2; }
    if (rgba[39] != 255 || rgba[43] != 255) { ret 3; }
    ret 0;
}

test "text: pixel fonts quantize glyph placement" {
    var f: Font = test_font(7.0);
    f.pixel_snap = true;
    f.glyphs[0].offset_x = 2.0;
    f.glyphs[0].offset_y = 0.0 - 3.0;
    val d: Rect = glyph_dest(?f, ?f.glyphs[0], 3.49, 5.51);
    if (d.x != 5.0 || d.y != 3.0) { ret 1; }
    if (pixel_round(1.49) != 1.0 || pixel_round(1.5) != 2.0) { ret 2; }
    if (pixel_round(0.0 - 1.49) != 0.0 - 1.0
        || pixel_round(0.0 - 1.5) != 0.0 - 2.0) { ret 3; }
    ret 0;
}

test "text: the last glyph's cell stays inside the atlas" {
    var f: Font = test_font(7.0);
    val rows: usize = (GLYPH_COUNT + f.cols - 1) / f.cols;
    val last: Rect = cell_uv(?f, GLYPH_COUNT - 1);
    # A cell running past 1.0 samples outside the texture and wraps, which
    # renders a neighbouring glyph's edge into this one
    if (last.x + last.w > 1.0001) { ret 1; }
    if (last.y + last.h > 1.0001) { ret 1; }
    ret 0;
}
