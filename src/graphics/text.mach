# Text rendering: a rasterized glyph atlas drawn through the sprite path.
#
# mach-font parses TrueType and rasterizes a glyph into an 8-bit coverage
# bitmap. It does not decide where glyphs live, how they are uploaded, or how a
# string becomes draw calls. Those are an engine's job.
#
# Every glyph is rasterized once at load into a single RGBA texture laid out as
# a grid of fixed cells. Drawing a string is then N sprite quads against one
# texture, so a frame counter costs no per-frame rasterization and no texture
# thrash. Rasterizing per draw is the obvious implementation and is why naive
# text rendering is slow.
#
# Coverage is stored in the alpha channel with RGB left white, so the existing
# sprite shader tints text by multiplying. No text-specific shader and no
# single-channel texture format is needed.
#
# The atlas uses a fixed cell grid rather than tight packing. A tight packer
# buys atlas space and costs a rectangle-packing algorithm plus per-glyph
# bookkeeping. At one size and 95 glyphs the whole atlas is a few hundred
# kilobytes either way, so space is not the constraint and the simpler layout
# wins.
#
# Coverage is ASCII 32 to 126. That is a deliberate first cut and the limit is
# stated rather than hidden, because a codepoint outside the range draws
# nothing instead of drawing a wrong glyph. Wider coverage needs a real cmap
# walk and a packer, and neither changes the shapes here.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use allo:   std.allocator;
use fs:     std.filesystem;
use vector: std.collections.vector;
use finfo:  font.info;
use fglyf:  font.glyf;
use fraster: font.raster;
use vfs: boom.vfs;

use boom.graphics.error.Error;
use boom.graphics.error.error;
use boom.graphics.texture.Texture;
use boom.graphics.texture.texture;
use boom.graphics.texture.texture_delete;
use boom.graphics.sprite.Rect;
use boom.graphics.sprite.rect;
use boom.graphics.renderer.Pass;
use boom.graphics.renderer.pass_draw_sprite_uv;
use boom.math.vec.Vec4;

# First and last codepoint the atlas covers
pub val FIRST_CP: u32 = 32;
pub val LAST_CP:  u32 = 126;
pub val GLYPH_COUNT: usize = 95;

# Scratch bounds for one glyph's outline, sized for the demanding glyphs in a
# normal text face rather than the worst case in any font ever made
val MAX_POINTS:   usize = 512;
val MAX_CONTOURS: usize = 32;
val MAX_EDGES:    usize = 1024;

# One glyph's placement in the atlas and its metrics
# ---
# cell:    index into the atlas grid
# advance: pen movement after drawing, in pixels
# w:       rendered width in pixels
# h:       rendered height in pixels
rec Glyph {
    cell:    usize;
    advance: f32;
    w:       f32;
    h:       f32;
}

# A loaded face at one pixel size
#
# A face is rasterized for the size it was loaded at. drawing it larger
# resamples the atlas and softens, which is the trade a bitmap atlas makes;
# load a second Font for a second size.
# ---
# atlas:  the uploaded glyph texture
# glyphs: per-codepoint placement and metrics
# cell_w: atlas cell width in pixels
# cell_h: atlas cell height in pixels
# cols:   cells per atlas row
# height: the pixel height this face was rasterized at
# valid:  whether the face loaded
pub rec Font {
    atlas:  Texture;
    glyphs: [95]Glyph;
    cell_w: usize;
    cell_h: usize;
    cols:   usize;
    height: f32;
    valid:  bool;
}

# Load a face and rasterize its atlas
#
# ---
# a:      allocator for the file bytes and the atlas, all released before return
# vpath:  virtual path to a TrueType file, e.g. res://fonts/ui.ttf
# pixels: pixel height to rasterize at
pub fun font_load(a: *allo.Allocator, vpath: str, pixels: f32) Result[Font, Error] {
    var f: Font;
    f.valid = false;

    val pr: Result[str, str] = vfs.vfs_resolve(a, vpath);
    if (is_err[str, str](pr)) { ret err[Font, Error](error(unwrap_err[str, str](pr))); }
    val real: str = unwrap_ok[str, str](pr);

    val br: Result[vector.Vector[u8], str] = fs.read_bytes(a, real);
    if (is_err[vector.Vector[u8], str](br)) {
        ret err[Font, Error](error(unwrap_err[vector.Vector[u8], str](br)));
    }
    var bytes: vector.Vector[u8] = unwrap_ok[vector.Vector[u8], str](br);

    var face: finfo.Font;
    if (!finfo.init(bytes.data, bytes.len, ?face)) {
        vector.dnit[u8](?bytes);
        ret err[Font, Error](error("not a TrueType font"));
    }

    val scale: f32 = finfo.scale_for_pixel_height(?face, pixels);

    # Cells are square and sized to the requested height plus a margin, so a
    # descender or an accent cannot bleed into the neighbouring cell
    val cell: usize = (pixels::i64 + (pixels::i64 / 4) + 2)::usize;
    f.cell_w = cell;
    f.cell_h = cell;
    f.cols   = 16;
    f.height = pixels;

    val rows:  usize = (GLYPH_COUNT + f.cols - 1) / f.cols;
    val aw:    usize = f.cols * cell;
    val ah:    usize = rows * cell;

    val ar: Result[*u8, str] = allo.allocate[u8](a, aw * ah * 4);
    if (is_err[*u8, str](ar)) {
        vector.dnit[u8](?bytes);
        ret err[Font, Error](error(unwrap_err[*u8, str](ar)));
    }
    val rgba: *u8 = unwrap_ok[*u8, str](ar);
    var i: usize = 0;
    for (i < aw * ah * 4) { rgba[i] = 0; i = i + 1; }

    val cr: Result[*u8, str] = allo.allocate[u8](a, cell * cell);
    if (is_err[*u8, str](cr)) {
        allo.deallocate[u8](a, rgba, aw * ah * 4);
        vector.dnit[u8](?bytes);
        ret err[Font, Error](error(unwrap_err[*u8, str](cr)));
    }
    val cov: *u8 = unwrap_ok[*u8, str](cr);

    var pts:   [512]fglyf.Point;
    var ends:  [32]u16;
    var edges: [1024]fraster.Edge;

    var g: usize = 0;
    for (g < GLYPH_COUNT) {
        val cp: u32 = FIRST_CP + g::u32;
        f.glyphs[g].cell = g;
        f.glyphs[g].w    = 0.0;
        f.glyphs[g].h    = 0.0;

        var gi: u16 = 0;
        if (finfo.glyph_index(?face, cp, ?gi)) {
            var adv: u16 = 0;
            var lsb: i16 = 0;
            if (finfo.glyph_hmetrics(?face, gi, ?adv, ?lsb)) {
                f.glyphs[g].advance = adv::f32 * scale;
            }

            var k: usize = 0;
            for (k < cell * cell) { cov[k] = 0; k = k + 1; }

            if (finfo.render_glyph(?face, gi, scale, ?pts[0], MAX_POINTS, ?ends[0], MAX_CONTOURS,
                                   ?edges[0], MAX_EDGES, cov, cell::u16, cell::u16)) {
                f.glyphs[g].w = cell::f32;
                f.glyphs[g].h = cell::f32;
                blit_cell(rgba, aw, cov, cell, g, f.cols);
            }
        }
        g = g + 1;
    }

    f.atlas = texture(rgba, aw::i32, ah::i32);
    f.valid = true;

    allo.deallocate[u8](a, cov, cell * cell);
    allo.deallocate[u8](a, rgba, aw * ah * 4);
    vector.dnit[u8](?bytes);
    ret ok[Font, Error](f);
}

# Copy one coverage bitmap into its atlas cell as white-with-alpha
#
# RGB is left white and coverage becomes alpha, so the sprite shader's tint
# multiply colours the text and no text-specific shader is needed.
fun blit_cell(rgba: *u8, atlas_w: usize, cov: *u8, cell: usize, index: usize, cols: usize) {
    val cx: usize = (index % cols) * cell;
    val cy: usize = (index / cols) * cell;
    var y: usize = 0;
    for (y < cell) {
        var x: usize = 0;
        for (x < cell) {
            val o: usize = ((cy + y) * atlas_w + (cx + x)) * 4;
            rgba[o]     = 255;
            rgba[o + 1] = 255;
            rgba[o + 2] = 255;
            rgba[o + 3] = cov[y * cell + x];
            x = x + 1;
        }
        y = y + 1;
    }
}

# Release the atlas texture
pub fun font_delete(f: *Font) {
    if (!f.valid) { ret; }
    texture_delete(?f.atlas);
    f.valid = false;
}

# The glyph slot for a codepoint, or GLYPH_COUNT when outside the atlas
fun slot_of(cp: u32) usize {
    if (cp < FIRST_CP || cp > LAST_CP) { ret GLYPH_COUNT; }
    ret (cp - FIRST_CP)::usize;
}

# Width of a string in pixels, without drawing it
#
# UI has to lay out before it draws, so this walks the same advances the draw
# does. measuring by counting characters times a fixed width is wrong for any
# proportional face, which is every face worth using.
pub fun text_measure(f: *Font, s: str) f32 {
    if (!f.valid || s == nil) { ret 0.0; }
    var w: f32 = 0.0;
    var i: usize = 0;
    val n: usize = str_len(s);
    for (i < n) {
        val sl: usize = slot_of(s[i]::u32);
        if (sl != GLYPH_COUNT) { w = w + f.glyphs[sl].advance; }
        i = i + 1;
    }
    ret w;
}

# The source rect of a glyph's cell in the atlas, in normalized UV
fun cell_uv(f: *Font, slot: usize) Rect {
    val cols: usize = f.cols;
    val rows: usize = (GLYPH_COUNT + cols - 1) / cols;
    val u: f32 = (slot % cols)::f32 / cols::f32;
    val v: f32 = (slot / cols)::f32 / rows::f32;
    ret rect(u, v, 1.0 / cols::f32, 1.0 / rows::f32);
}

# Draw a string into a pass, returning the pen x after the last glyph
#
# `x`/`y` are the top-left of the first cell in the pass's coordinate space,
# which for an overlay pass is pixels. one sprite quad per glyph against one
# texture, so a caller may draw many strings without a bind between them.
# ---
# p:    the pass to draw into, normally an overlay pass
# f:    the loaded face
# s:    the string
# x:    left edge of the first glyph
# y:    top edge of the line
# tint: colour multiplied over the glyph coverage
# ret:  the x the next glyph would start at, for chained draws
pub fun text_draw(p: *Pass, f: *Font, s: str, x: f32, y: f32, tint: Vec4) f32 {
    if (!f.valid || s == nil) { ret x; }
    var pen: f32 = x;
    var i: usize = 0;
    val n: usize = str_len(s);
    for (i < n) {
        val sl: usize = slot_of(s[i]::u32);
        if (sl != GLYPH_COUNT) {
            # A space has an advance and no coverage, so skipping the quad
            # saves a draw call per space without changing the layout
            if (f.glyphs[sl].w > 0.0) {
                val dest: Rect = rect(pen, y, f.cell_w::f32, f.cell_h::f32);
                pass_draw_sprite_uv(p, ?f.atlas, dest, cell_uv(f, sl), tint);
            }
            pen = pen + f.glyphs[sl].advance;
        }
        i = i + 1;
    }
    ret pen;
}

# --------------------------------------------------------------------- tests
#
# Rasterizing and uploading need a font file and a GL context, so these cover
# the layout arithmetic -- slot mapping, measurement, and atlas UVs -- which is
# what a caller's positioning depends on and where an off-by-one is silent.

# A face with known metrics, for layout tests that need no font file
fun test_font(advance: f32) Font {
    var f: Font;
    f.cell_w = 16;
    f.cell_h = 16;
    f.cols   = 16;
    f.height = 12.0;
    f.valid  = true;
    var g: usize = 0;
    for (g < GLYPH_COUNT) {
        f.glyphs[g].cell    = g;
        f.glyphs[g].advance = advance;
        f.glyphs[g].w       = 16.0;
        f.glyphs[g].h       = 16.0;
        g = g + 1;
    }
    ret f;
}

test "text: a codepoint outside the atlas maps to no slot" {
    # Below the range, above it, and the boundaries themselves
    if (slot_of(31) != GLYPH_COUNT)  { ret 1; }
    if (slot_of(127) != GLYPH_COUNT) { ret 1; }
    if (slot_of(32) != 0)            { ret 1; }
    if (slot_of(126) != GLYPH_COUNT - 1) { ret 1; }
    ret 0;
}

test "text: measuring walks advances, not character count" {
    var f: Font = test_font(7.0);
    if (text_measure(?f, "abc") != 21.0) { ret 1; }
    if (text_measure(?f, "") != 0.0)     { ret 1; }

    # A codepoint outside the atlas contributes nothing rather than a default
    # width, so an unsupported character cannot silently shift a layout
    if (text_measure(?f, "a\tb") != 14.0) { ret 1; }
    ret 0;
}

test "text: an invalid face measures zero rather than reading glyphs" {
    var f: Font = test_font(7.0);
    f.valid = false;
    if (text_measure(?f, "abc") != 0.0) { ret 1; }
    ret 0;
}

test "text: atlas UVs tile the grid without overlap or gap" {
    var f: Font = test_font(7.0);
    val rows: usize = (GLYPH_COUNT + f.cols - 1) / f.cols;

    val first: Rect = cell_uv(?f, 0);
    if (first.x != 0.0 || first.y != 0.0) { ret 1; }
    if (first.w != 1.0 / 16.0)            { ret 1; }
    if (first.h != 1.0 / rows::f32)       { ret 1; }

    # The cell after the first wraps to the next row at the column count, so a
    # miscomputed stride shows up here rather than as a subtly wrong glyph
    val col1:  Rect = cell_uv(?f, 1);
    if (col1.x != 1.0 / 16.0 || col1.y != 0.0) { ret 1; }

    val row1: Rect = cell_uv(?f, 16);
    if (row1.x != 0.0)                { ret 1; }
    if (row1.y != 1.0 / rows::f32)    { ret 1; }
    ret 0;
}

test "text: the last glyph's cell stays inside the atlas" {
    var f: Font = test_font(7.0);
    val rows: usize = (GLYPH_COUNT + f.cols - 1) / f.cols;
    val last: Rect = cell_uv(?f, GLYPH_COUNT - 1);
    # A cell running past 1.0 samples outside the texture and wraps, which
    # renders a neighbouring glyph's edge into this one
    if (last.x + last.w > 1.0001) { ret 1; }
    if (last.y + last.h > 1.0001) { ret 1; }
    ret 0;
}
