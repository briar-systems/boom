# Text: one font at one size, measured and drawn.
#
# Text is three layers, each usable on its own, and Font is the composite a game
# reaches for when it has one font at one size:
#
# - Typeface (text/typeface.mach): a font file's bytes and parsed tables. No
#   size, no device. One per file.
# - FontFace (text/face.mach): a typeface at one size and policy. Everything
#   layout needs, and no device, so layout is testable without a renderer.
# - GlyphAtlas (text/atlas.mach): rasterized glyph cells for one face, and the
#   draw. The only layer that needs a device.
#
# The glyph index is the contract between the face and the atlas.
#
# A Font owns one of each, allocated behind pointers so a Font can be returned
# and stored by value while its layers keep pointing at each other. Every
# measuring function here goes through the face and never rasterizes. Drawing
# and preloading go through the atlas. A game that draws one file at several
# sizes builds one Typeface and a FontFace plus a GlyphAtlas per size instead,
# so the file is held and parsed once.
#
# Coverage is ASCII and far beyond: strings are UTF-8 and any codepoint the
# typeface has a glyph for draws. A codepoint it lacks draws its .notdef box.
# This is not shaping: there is no bidi, no Arabic joining, no Indic
# reordering, no kerning and no ligature or mark positioning. A shaping pass
# would sit between the face and the atlas, and neither changes shape for it.

use boom.graphics.device.Device;
use boom.graphics.error.Error;
use boom.graphics.renderer.Pass;
use boom.graphics.text.atlas.GlyphAtlas;
use boom.graphics.text.atlas.atlas_cell_count;
use boom.graphics.text.atlas.atlas_delete;
use boom.graphics.text.atlas.atlas_draw;
use boom.graphics.text.atlas.atlas_init;
use boom.graphics.text.atlas.atlas_missing;
use boom.graphics.text.atlas.atlas_page_count;
use boom.graphics.text.atlas.atlas_preload;
use boom.graphics.text.face.FontFace;
use boom.graphics.text.face.FontOptions;
use boom.graphics.text.face.face_delete;
use boom.graphics.text.face.face_height;
use boom.graphics.text.face.face_init;
use boom.graphics.text.face.face_lines;
use boom.graphics.text.face.face_measure;
use boom.graphics.text.face.face_resolved;
use boom.graphics.text.face.face_unreadable;
use boom.graphics.text.face.font_options;
use boom.graphics.text.typeface.Typeface;
use boom.graphics.text.typeface.typeface_delete;
use boom.graphics.text.typeface.typeface_from_bytes;
use boom.graphics.text.typeface.typeface_load;
use boom.math.vec.Vec4;
use allo: std.allocator;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# one font at one size: a typeface, a face over it, and an atlas over that
# ---
# a:        allocator that owns all three layers
# typeface: the owned typeface
# face:     the owned face, borrowing `typeface`
# atlas:    the owned atlas, borrowing `face`
# valid:    whether the font is live, cleared by font_delete
pub rec Font {
    a:        *allo.Allocator;
    typeface: *Typeface;
    face:     *FontFace;
    atlas:    *GlyphAtlas;
    valid:    bool;
}

# unwind whatever layers a Font holds, innermost first
fun font_release(d: *Device, f: *Font) {
    if (f.atlas != nil) {
        atlas_delete(d, f.atlas);
        allo.deallocate[GlyphAtlas](f.a, f.atlas, 1);
        f.atlas = nil;
    }
    if (f.face != nil) {
        face_delete(f.face);
        allo.deallocate[FontFace](f.a, f.face, 1);
        f.face = nil;
    }
    if (f.typeface != nil) {
        typeface_delete(f.typeface);
        allo.deallocate[Typeface](f.a, f.typeface, 1);
        f.typeface = nil;
    }
    f.valid = false;
}

# build the face and atlas over a typeface the Font now owns
fun font_build(a: *allo.Allocator, d: *Device, made: res[Typeface, Error],
    pixels: f32, options: FontOptions) res[Font, Error] {
    var f: Font;
    f.a     = a;
    f.valid = false;
    if (sel made.err) { ret res[Font, Error].err{made.err}; }
    var t: Typeface = made.ok;

    val tr: res[*Typeface, allo.Error] = allo.allocate[Typeface](a, 1);
    if (sel tr.err) {
        typeface_delete(?t);
        ret res[Font, Error].err{Error.alloc{tr.err}};
    }
    f.typeface  = tr.ok;
    @f.typeface = t;

    val fr: res[*FontFace, allo.Error] = allo.allocate[FontFace](a, 1);
    if (sel fr.err) {
        font_release(d, ?f);
        ret res[Font, Error].err{Error.alloc{fr.err}};
    }
    val faced: res[FontFace, Error] = face_init(a, f.typeface, pixels, options);
    if (sel faced.err) {
        allo.deallocate[FontFace](a, fr.ok, 1);
        font_release(d, ?f);
        ret res[Font, Error].err{faced.err};
    }
    f.face  = fr.ok;
    @f.face = faced.ok;

    val ar: res[*GlyphAtlas, allo.Error] = allo.allocate[GlyphAtlas](a, 1);
    if (sel ar.err) {
        font_release(d, ?f);
        ret res[Font, Error].err{Error.alloc{ar.err}};
    }
    val atlased: res[GlyphAtlas, Error] = atlas_init(a, d, f.face);
    if (sel atlased.err) {
        allo.deallocate[GlyphAtlas](a, ar.ok, 1);
        font_release(d, ?f);
        ret res[Font, Error].err{atlased.err};
    }
    f.atlas  = ar.ok;
    @f.atlas = atlased.ok;
    f.valid  = true;
    ret res[Font, Error].ok{f};
}

# Load a font from borrowed TrueType bytes.
#
# The bytes are read only during this call. The Font keeps its own copy, so the
# caller may release the span immediately after return.
# ---
# a:      allocator for the retained bytes, the metrics and the atlas
# d:      device the atlas pages are created against
# data:   complete TrueType byte stream, borrowed for this call
# len:    encoded byte count
# pixels: logical pixel height to measure and draw at
# ret:    an owned Font, or a parse, allocation or upload error
pub fun font_from_bytes(a: *allo.Allocator, d: *Device, data: *u8, len: usize,
    pixels: f32) res[Font, Error] {
    ret font_from_bytes_with_options(a, d, data, len, pixels, font_options());
}

# Load a font from borrowed bytes, rasterized above its logical resolution.
#
# Oversampling improves scaled text without changing advances or layout.
# ---
# oversample: raster texels per logical pixel, at least one
pub fun font_from_bytes_oversampled(a: *allo.Allocator, d: *Device, data: *u8, len: usize,
    pixels: f32, oversample: usize) res[Font, Error] {
    var options: FontOptions = font_options();
    options.oversample = oversample;
    ret font_from_bytes_with_options(a, d, data, len, pixels, options);
}

# Load a font from borrowed bytes with an explicit size and raster policy.
pub fun font_from_bytes_with_options(a: *allo.Allocator, d: *Device,
    data: *u8, len: usize, pixels: f32,
    options: FontOptions) res[Font, Error] {
    ret font_build(a, d, typeface_from_bytes(a, data, len), pixels, options);
}

# Load a font from a virtual path.
# ---
# vpath: virtual path to a TrueType file, e.g. res://fonts/ui.ttf
pub fun font_load(a: *allo.Allocator, d: *Device, vpath: str,
    pixels: f32) res[Font, Error] {
    ret font_load_with_options(a, d, vpath, pixels, font_options());
}

# Load a font from a virtual path, rasterized above its logical resolution.
pub fun font_load_oversampled(a: *allo.Allocator, d: *Device, vpath: str,
    pixels: f32, oversample: usize) res[Font, Error] {
    var options: FontOptions = font_options();
    options.oversample = oversample;
    ret font_load_with_options(a, d, vpath, pixels, options);
}

# Load a font from a virtual path with an explicit size and raster policy.
pub fun font_load_with_options(a: *allo.Allocator, d: *Device, vpath: str,
    pixels: f32, options: FontOptions) res[Font, Error] {
    ret font_build(a, d, typeface_load(a, vpath), pixels, options);
}

# Release a font's atlas, face and typeface.
# ---
# d: the device the font was created against
# f: the font, unusable afterwards
pub fun font_delete(d: *Device, f: *Font) {
    if (!f.valid) { ret; }
    font_release(d, f);
}

# the typeface a font owns, for building more sizes of the same file
pub fun font_typeface(f: *Font) *Typeface {
    ret f.typeface;
}

# the face a font owns, for device-free layout
pub fun font_face(f: *Font) *FontFace {
    ret f.face;
}

# the atlas a font owns
pub fun font_atlas(f: *Font) *GlyphAtlas {
    ret f.atlas;
}

# Rasterize every glyph a string uses without drawing it.
#
# See atlas_preload: this moves the first-use cost of a screen of text to load.
pub fun font_preload(f: *Font, s: str) bool {
    if (!f.valid) { ret false; }
    ret atlas_preload(f.atlas, s);
}

# how many distinct codepoints the font has measured or drawn
pub fun font_glyph_count(f: *Font) usize {
    if (!f.valid) { ret 0; }
    ret face_resolved(f.face);
}

# how many atlas pages the font has created
pub fun font_page_count(f: *Font) usize {
    if (!f.valid) { ret 0; }
    ret atlas_page_count(f.atlas);
}

# how many glyphs the font had to measure or draw as nothing
#
# The sum of glyphs whose metrics the typeface could not read and glyphs the
# atlas could not rasterize or give a cell.
pub fun font_missing(f: *Font) usize {
    if (!f.valid) { ret 0; }
    ret face_unreadable(f.face) + atlas_missing(f.atlas);
}

# Width of the widest line in pixels, without drawing it.
#
# Goes through the face alone, so it never rasterizes or uploads.
pub fun text_measure(f: *Font, s: str) f32 {
    if (!f.valid) { ret 0.0; }
    ret face_measure(f.face, s);
}

# height of a text block in pixels, one line box per line
pub fun text_height(f: *Font, s: str) f32 {
    if (!f.valid) { ret 0.0; }
    ret face_height(f.face, s);
}

# how many lines a string draws as
pub fun text_lines(f: *Font, s: str) usize {
    if (!f.valid) { ret 0; }
    ret face_lines(f.face, s);
}

# Draw a string into a pass, returning the pen x after the last glyph.
#
# See atlas_draw for the coordinate and line-break rules.
pub fun text_draw(p: *Pass, f: *Font, s: str, x: f32, y: f32, tint: Vec4) f32 {
    if (!f.valid) { ret x; }
    ret atlas_draw(p, f.atlas, s, x, y, tint);
}

test "text: an invalid font measures and draws nothing" {
    var f: Font;
    f.valid = false;
    if (text_measure(?f, "abc") != 0.0) { ret 1; }
    if (text_height(?f, "abc") != 0.0)  { ret 2; }
    if (text_lines(?f, "abc") != 0)     { ret 3; }
    if (font_preload(?f, "abc"))        { ret 4; }
    if (font_glyph_count(?f) != 0)      { ret 5; }
    if (font_missing(?f) != 0)          { ret 6; }
    ret 0;
}

test "text: bytes that are not a font fail before any device work" {
    var a:     allo.Allocator;
    var d:     Device;
    var bytes: [4]u8            = [4]u8{0, 1, 2, 3};
    val r:     res[Font, Error] = font_from_bytes(?a, ?d, ?bytes[0], 4, 16.0);
    if (!(sel r.err && (sel r.err.text && sel r.err.text.font))) { ret 1; }
    ret 0;
}
