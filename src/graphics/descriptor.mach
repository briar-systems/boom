# Descriptor sets and the per-frame uniform ring.
#
# A pipeline declares a descriptor set layout; a descriptor set is an instance
# of that layout naming actual buffers and images. The set is what gets bound
# before a draw, so this is the last piece between a built pipeline and a draw
# call.
#
# A SLOT IS A DRAW, NOT A MATERIAL. Every draw needs its own uniform data: a
# mesh draw its two matrices, a sprite draw its transform, source rect and tint.
# Mach's SPIR-V has no push constants, so that data goes through a uniform
# buffer, and a buffer rewritten between two draws in the same command buffer
# would give both draws whichever value was written last. So each draw takes a
# slot: a distinct range of a per-frame ring buffer and a descriptor set
# pointing at it.
#
# Text is why the slot count is what it is. Every glyph is a draw, so a line of
# text is dozens of them, and sizing the ring by materials rather than by draws
# would run out inside the first label.
#
# ONE RING PER FRAME IN FLIGHT. The GPU is still reading the previous frame's
# uniforms while this one is recorded, so frames cannot share a ring. They need
# no synchronization beyond the frame fence, which has already been waited on
# before recording begins, so a slot's descriptor set can be rewritten then.
#
# THE RING IS PERSISTENTLY MAPPED. Mapping and unmapping per draw would cost
# more than the write. Host-coherent memory makes a write visible to the GPU
# without an explicit flush.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use mem: std.memory;
use vk;
use boom.graphics.error.Error;
use boom.graphics.error.error;
use boom.graphics.vk.Vk;
use boom.graphics.pipeline.sampler_binding;
use boom.graphics.buffer.Buffer;
use boom.graphics.buffer.buffer_init;
use boom.graphics.buffer.buffer_map;
use boom.graphics.buffer.buffer_unmap;
use boom.graphics.buffer.buffer_dnit;
use boom.graphics.frame.MAX_FRAMES_IN_FLIGHT;
use boom.graphics.uniform.MeshUniforms;
use boom.graphics.uniform.SkinnedUniforms;
use boom.graphics.uniform.ScreenUniforms;
use boom.graphics.uniform.TintUniforms;

# The most draws one frame may issue.
#
# A line of text is one draw per glyph, so this is sized for a screenful of
# them rather than for a handful of materials.
# Slots in one block. A block is a descriptor pool, its sets, and one uniform
# ring per frame in flight.
pub val SLOTS_PER_BLOCK: usize = 512;

# Blocks a frame may grow to, which is the real ceiling: 8192 draws.
pub val MAX_SLOT_BLOCKS: usize = 16;

# Slots available before anything grows.
#
# CAPACITY IS A STARTING SIZE, NOT A CEILING. This was a hard 512 and a frame
# that wanted more silently lost draws. That is not a hypothetical: a painter's
# ordered layer sorted by depth interleaves textures by construction, so every
# item is a texture change and every texture change is a flush and a slot. The
# consumer's arena reached 1757 items in a frame and the ones past 512 simply
# did not appear, with renderer_dropped as the only sign.
#
# A block cannot be resized once draws point into its ring, so growth adds a
# block rather than enlarging one, the same shape the palette rings already use.
pub val MAX_SLOTS: usize = 512;

# What descriptors_take answers when it cannot supply one.
pub val NO_SLOT: usize = 0xFFFFFFFFFFFFFFFF;

# Combined image samplers a draw binds, which is a Material's MAX_TEXTURES.
#
# Every one is written every draw. A shader sampling a slot the material left
# empty must read a defined texture rather than whatever the previous draw put
# in that set, so the caller supplies a fallback for the unset ones.
pub val MAX_SAMPLERS: usize = 4;

# The alignment every uniform descriptor's buffer offset must satisfy.
#
# 256 is the largest minUniformBufferOffsetAlignment any Vulkan implementation
# reports, so an offset that is a multiple of it is legal everywhere without
# querying the device.
pub val UNIFORM_ALIGN: usize = 256;

# Bytes reserved per slot in the ring.
#
# TWO ALIGNED SUB-SLOTS, NOT ONE. A draw binds two uniform ranges out of its
# slot: the vertex stage's transform block at binding 0 and the fragment stage's
# colour at binding 2. Both are descriptor buffer offsets, and both must be
# multiples of UNIFORM_ALIGN. Packing the colour immediately after the transform
# block puts it at 128 or 144 bytes into the slot, which is legal on hardware
# reporting a smaller alignment and rejected on hardware reporting 256, so it
# would work on the machine it was written on and fail elsewhere.
#
# So a slot is two aligned sub-slots: the transform block at offset 0 and the
# colour at COLOUR_OFFSET. The widest transform block is 144 bytes and the
# colour is 16, so 240 of the 512 bytes are padding, bought in exchange for a
# stride that does not depend on the device.
pub val SLOT_BYTES: usize = 768;

# Where a draw's colour block sits inside its slot.
#
# Both stages read from the same slot, which is why one descriptor write path
# serves the sprite tint and the mesh base colour.
pub val COLOUR_OFFSET: usize = 256;

# Where a draw's game-supplied uniform block sits within its slot.
#
# THE THIRD SUB-SLOT, AND WHY THE SLOT GREW TO HOLD IT. A game writing its own
# shading needs somewhere to put what that shading is parameterised by: a light
# direction, an ambient term, a time value. boom's own blocks are the transform
# and the tint, and neither has room to spare.
#
# A uniform binding's buffer offset must satisfy minUniformBufferOffsetAlignment,
# which is as much as 256 on real devices, so the aligned points inside a slot
# are 256 bytes apart and a 512-byte slot has exactly two. Adding a third means
# a 768-byte slot. That is 384 KB across the ring for both frames in flight,
# against 256 KB before, to make the engine usable by a game that wants its own
# shading at all.
pub val USER_OFFSET: usize = 512;

# The most a game may put in that block.
#
# One aligned region, so 256 bytes: sixteen vec4s, which is a directional light
# with room left over. A game needing more than this is describing per-draw data
# that wants a storage buffer rather than a uniform block.
pub val USER_BYTES: usize = 256;

# Palette slots in one block of the palette ring.
#
# THE RING GROWS RATHER THAN CAPPING. A palette is 8 KB where a uniform slot is
# 256, so reserving palettes the way slots are reserved would cost megabytes per
# frame to serve a case that is usually a handful of characters. It used to be a
# flat 32, which made the common case cheap and made the thirty-third skinned
# draw vanish: refused in submission order, so a crowd lost whichever characters
# were submitted last, silently. That is the same failure the sprite path had.
#
# So the ring starts at one block and adds another when a frame needs it, and
# blocks are retained rather than freed, because a frame that needed the room
# will need it again and releasing memory the GPU may still be reading is a
# race. A game with eight characters pays for 32 palettes forever; a game with a
# crowd pays for the crowd, once.
pub val PALETTES_PER_BLOCK: usize = 32;

# How many palette blocks one frame may grow to.
#
# Sixteen blocks is 512 skinned draws in a frame, which is far past what any
# game draws: a skinned mesh costs a palette upload and a draw of its own, so a
# scene with hundreds is expensive long before it is short of palettes.
pub val MAX_PALETTE_BLOCKS: usize = 16;

# The most skinned draws one frame may issue.
pub val MAX_PALETTES: usize = PALETTES_PER_BLOCK * MAX_PALETTE_BLOCKS;

# Bytes reserved per palette slot.
#
# MAX_JOINTS 4x4 matrices, which is what shaders/src/skinned_vert.mach declares
# as its 512-column storage block. The compile-time check in
# boom.graphics.skeleton keeps the joint count in step with the shader.
pub val PALETTE_BYTES: usize = 128 * 64;

# The pool and the per-frame rings.
# ---
# pool:   The descriptor pool, owned here.
# sets:   Allocated sets, indexed as slot * MAX_FRAMES_IN_FLIGHT + frame.
# rings:  One host-visible uniform buffer per frame in flight.
# mapped: The persistent host pointer for each ring.
# used:   Slots taken so far in the current frame.
# pals:   Host-visible storage buffers of joint palettes, per frame then block.
# pmap:   The persistent host pointer for each palette block.
# pcount: How many palette blocks each frame has created.
# pused:  Palette slots taken so far in the current frame, across its blocks.
# ready:  Whether creation completed.
# One block's worth of sets and rings.
pub rec SlotBlock {
    pool:   vk.DescriptorPool;
    sets:   [1024]vk.DescriptorSet;
    rings:  [2]Buffer;
    mapped: [2]ptr;
}

pub rec Descriptors {
    blocks: [16]SlotBlock;
    bcount: usize;
    used:   usize;
    # Kept so a block can be added mid-frame without the caller carrying it.
    layout: vk.DescriptorSetLayout;
    pals:   [2][16]Buffer;
    pmap:   [2][16]ptr;
    pcount: [2]usize;
    pused:  usize;
    ready:  bool;
}

# Which block a slot lives in, and where inside it.
#
# Pure, and the place a mistake sends a write into another block's ring, so both
# are tested directly rather than only through the allocation that uses them.
pub fun slot_block(slot: usize) usize {
    ret slot / SLOTS_PER_BLOCK;
}

pub fun slot_in_block(slot: usize) usize {
    ret slot % SLOTS_PER_BLOCK;
}

# The index of a slot's set for one frame, within its own block.
pub fun set_index(slot: usize, frame: usize) usize {
    ret slot_in_block(slot) * MAX_FRAMES_IN_FLIGHT + frame;
}

# The byte offset of a slot within its frame's ring.
pub fun slot_offset(slot: usize) u64 {
    ret (slot_in_block(slot) * SLOT_BYTES)::u64;
}

# The byte offset of a palette slot within the block that holds it.
#
# PALETTE_BYTES is 8192, so every offset is 8192-aligned and therefore satisfies
# any minStorageBufferOffsetAlignment a device reports without querying it.
pub fun palette_offset(slot: usize) u64 {
    ret ((slot % PALETTES_PER_BLOCK) * PALETTE_BYTES)::u64;
}

# Which block of the palette ring holds a slot.
#
# A descriptor names one buffer, so a palette's block decides which buffer is
# bound for that draw. Split out and pure because an index that disagrees with
# the offset above binds the right buffer at the wrong place, or the wrong
# buffer at a plausible one, and either draws a recognisable character in a pose
# that belongs to a different one.
pub fun palette_block(slot: usize) usize {
    ret slot / PALETTES_PER_BLOCK;
}

# Create one block: its pool, its sets, and one uniform ring per frame.
#
# Blocks are identical rather than doubling. A slot is a fixed 768 bytes and a
# frame needing more of them needs them one at a time, so there is nothing for a
# growth curve to amortise.
fun slot_block_create(d: *Descriptors, v: *Vk, layout: vk.DescriptorSetLayout) bool {
    # Checked here rather than only in descriptors_init, because this now runs
    # mid-frame from descriptors_take and a caller with no device would reach
    # vkCreateDescriptorPool with a null handle.
    if (v == nil || !v.ready) { ret false; }
    if (d.bcount >= MAX_SLOT_BLOCKS) { ret false; }
    val bi: usize = d.bcount;
    var b: *SlotBlock = ?d.blocks[bi];
    b.pool = nil;

    val total: u32 = (SLOTS_PER_BLOCK * MAX_FRAMES_IN_FLIGHT)::u32;

    # A pool is sized per descriptor type, not per set, and a set consumes what
    # its LAYOUT declares rather than what a draw writes. These counts come from
    # set_layout_full and must move whenever it does: three uniform buffers
    # (0, 2 and 4), four combined image samplers (1, 5, 6 and 7) and one storage
    # buffer (3).
    #
    # The uniform count was two per set and should always have been three, since
    # binding 4 has been in the layout as long as the game's own block has. Every
    # driver this has run on allocated anyway; a stricter one would have failed
    # with an out-of-pool-memory error naming the pool rather than the layout
    # that caused it.
    var sizes: [3]vk.DescriptorPoolSize;
    sizes[0].type            = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER;
    sizes[0].descriptorCount = total * 3;
    sizes[1].type            = vk.DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
    sizes[1].descriptorCount = total * MAX_SAMPLERS::u32;
    sizes[2].type            = vk.DESCRIPTOR_TYPE_STORAGE_BUFFER;
    sizes[2].descriptorCount = total;

    var ci: vk.DescriptorPoolCreateInfo;
    ci.sType         = vk.STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
    ci.pNext         = nil;
    ci.flags         = 0;
    ci.maxSets       = total;
    ci.poolSizeCount = 3;
    ci.pPoolSizes    = ?sizes[0];

    if (vk.vkCreateDescriptorPool(v.device, ?ci, nil, ?b.pool) != vk.SUCCESS) { ret false; }

    # Allocated in batches rather than one call: vkAllocateDescriptorSets takes
    # an array of layouts as long as the set count, and 1024 of them is a large
    # stack array for no benefit.
    var layouts: [64]vk.DescriptorSetLayout;
    var i: usize = 0;
    for (i < 64) { layouts[i] = layout; i = i + 1; }

    val count: usize = SLOTS_PER_BLOCK * MAX_FRAMES_IN_FLIGHT;
    var done: usize = 0;
    for (done < count) {
        var batch: usize = 64;
        if (count - done < batch) { batch = count - done; }

        var ai: vk.DescriptorSetAllocateInfo;
        ai.sType              = vk.STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
        ai.pNext              = nil;
        ai.descriptorPool     = b.pool;
        ai.descriptorSetCount = batch::u32;
        ai.pSetLayouts        = ?layouts[0];
        if (vk.vkAllocateDescriptorSets(v.device, ?ai, ?b.sets[done]) != vk.SUCCESS) { ret false; }
        done = done + batch;
    }

    var f: usize = 0;
    for (f < MAX_FRAMES_IN_FLIGHT) {
        val rr: Result[bool, Error] = buffer_init(?b.rings[f], v,
            (SLOTS_PER_BLOCK * SLOT_BYTES)::u64,
            vk.BUFFER_USAGE_UNIFORM_BUFFER_BIT,
            vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT);
        if (is_err[bool, Error](rr)) { ret false; }
        b.mapped[f] = buffer_map(?b.rings[f], v);
        if (b.mapped[f] == nil) { ret false; }
        f = f + 1;
    }

    d.bcount = d.bcount + 1;
    ret true;
}

# Create the first block and the per-frame palette rings.
pub fun descriptors_init(d: *Descriptors, v: *Vk, layout: vk.DescriptorSetLayout) Result[bool, Error] {
    d.bcount = 0;
    d.used   = 0;
    d.pused  = 0;
    d.layout = layout;
    d.ready  = false;

    if (!v.ready) { ret err[bool, Error](error("Vulkan device is not initialized")); }

    if (!slot_block_create(d, v, layout)) {
        ret err[bool, Error](error("could not create the first descriptor block"));
    }

    var f: usize = 0;
    for (f < MAX_FRAMES_IN_FLIGHT) {
        var b2: usize = 0;
        for (b2 < MAX_PALETTE_BLOCKS) {
            d.pmap[f][b2] = nil;
            b2 = b2 + 1;
        }
        d.pcount[f] = 0;
        if (!palette_block_create(d, v, f)) {
            ret err[bool, Error](error("could not create a palette ring"));
        }
        f = f + 1;
    }

    d.ready = true;

    # EVERY SET GETS A VALID PALETTE DESCRIPTOR UP FRONT. Binding 3 exists in
    # every set because all pipelines share one layout, but only a skinned draw
    # writes it. A set bound to any pipeline with binding 3 left uninitialized
    # is undefined behaviour in Vulkan even when the shader never reads it, and
    # the validation layers report it as a use-after-free-shaped error far from
    # the draw that caused it. Pointing all of them at palette slot 0 once
    # removes the class entirely, at the cost of one pass over the sets at init.
    var s: usize = 0;
    for (s < MAX_SLOTS) {
        var fr: usize = 0;
        for (fr < MAX_FRAMES_IN_FLIGHT) {
            descriptors_bind_palette(d, v, fr, s, 0);
            fr = fr + 1;
        }
        s = s + 1;
    }

    ret ok[bool, Error](true);
}

# Reset the slot counter at the start of a frame.
#
# The frame's fence has already been waited on, so every slot this frame owns
# is free again. Forgetting this leaks slots until the frame runs out mid-draw.
pub fun descriptors_begin_frame(d: *Descriptors) {
    d.used  = 0;
    d.pused = 0;
}

# Take the next free slot, or MAX_SLOTS when the frame is full.
# Take the next slot, adding a block when the current ones are full.
#
# A block cannot be resized: draws already recorded this frame point into its
# ring and hold its descriptor sets, so enlarging it would move the memory under
# them. Adding one leaves every recorded draw alone.
#
# Returns NO_SLOT only when the block ceiling is reached or the allocation
# fails, which the caller counts as a dropped draw. Growth happens inside a
# frame, which is the only time it can: the frame that needs the slots is the
# frame that discovers it needs them.
pub fun descriptors_take(d: *Descriptors, v: *Vk) usize {
    if (!d.ready) { ret NO_SLOT; }
    if (d.used >= d.bcount * SLOTS_PER_BLOCK) {
        if (!slot_block_create(d, v, d.layout)) { ret NO_SLOT; }
    }
    val s: usize = d.used;
    d.used = d.used + 1;
    ret s;
}

# How many slots have been handed out this frame, and how many exist.
pub fun descriptors_used(d: *Descriptors) usize   { ret d.used; }
pub fun descriptors_blocks(d: *Descriptors) usize { ret d.bcount; }

# Add one block to a frame's palette ring.
#
# Blocks are the same size rather than doubling, unlike the vertex arena: a
# palette is a fixed 8 KB and a frame needing more of them needs them one
# character at a time, so a block of 32 is already a coarse enough step.
fun palette_block_create(d: *Descriptors, v: *Vk, frame: usize) bool {
    val n: usize = d.pcount[frame];
    if (n >= MAX_PALETTE_BLOCKS) { ret false; }

    val pr: Result[bool, Error] = buffer_init(?d.pals[frame][n], v,
        (PALETTES_PER_BLOCK * PALETTE_BYTES)::u64,
        vk.BUFFER_USAGE_STORAGE_BUFFER_BIT,
        vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT);
    if (is_err[bool, Error](pr)) { ret false; }

    val m: ptr = buffer_map(?d.pals[frame][n], v);
    if (m == nil) {
        buffer_dnit(?d.pals[frame][n], v);
        ret false;
    }
    d.pmap[frame][n] = m;
    d.pcount[frame]  = n + 1;
    ret true;
}

# Take the next free palette slot, growing the ring if this frame has run out.
pub fun descriptors_take_palette(d: *Descriptors, v: *Vk, frame: usize) usize {
    if (!d.ready || frame >= MAX_FRAMES_IN_FLIGHT) { ret MAX_PALETTES; }
    if (d.pused >= MAX_PALETTES) { ret MAX_PALETTES; }

    # Every frame's ring has to be able to hold this slot, not just the one
    # being recorded: the slot index is taken once and used again next frame
    # from the other ring, and a block that exists in one and not the other
    # would bind a buffer that was never created.
    val need: usize = palette_block(d.pused) + 1;
    var f: usize = 0;
    for (f < MAX_FRAMES_IN_FLIGHT) {
        for (d.pcount[f] < need) {
            if (!palette_block_create(d, v, f)) { ret MAX_PALETTES; }
        }
        f = f + 1;
    }

    val s: usize = d.pused;
    d.pused = d.pused + 1;
    ret s;
}

# How many palette blocks a frame has grown to, for reporting.
pub fun descriptors_palette_blocks(d: *Descriptors, frame: usize) usize {
    if (!d.ready || frame >= MAX_FRAMES_IN_FLIGHT) { ret 0; }
    ret d.pcount[frame];
}

# Copy a joint palette into its slot in the frame's palette ring.
#
# Refuses a palette larger than a slot rather than writing over the next one,
# for the same reason descriptors_write_slot does: the corrupted draw is one
# that has not been recorded yet, so the damage appears nowhere near its cause.
pub fun descriptors_write_palette(d: *Descriptors, frame: usize, slot: usize, src: *u8, len: usize) bool {
    if (!d.ready || slot >= MAX_PALETTES || frame >= MAX_FRAMES_IN_FLIGHT) { ret false; }
    if (len > PALETTE_BYTES) { ret false; }
    val b: usize = palette_block(slot);
    if (b >= d.pcount[frame] || d.pmap[frame][b] == nil) { ret false; }
    val base: *u8 = d.pmap[frame][b]:~*u8;
    mem.copy[u8](?base[palette_offset(slot)::usize], src, len);
    ret true;
}

# Point a draw slot's set at a palette slot.
#
# Separate from descriptors_bind_slot because most draws are not skinned and
# would pay a descriptor write for a binding they never read. The two compose:
# a skinned draw calls both.
pub fun descriptors_bind_palette(d: *Descriptors, v: *Vk, frame: usize, slot: usize,
                                 palette: usize) bool {
    if (!d.ready || slot >= d.bcount * SLOTS_PER_BLOCK || frame >= MAX_FRAMES_IN_FLIGHT) { ret false; }
    if (palette >= MAX_PALETTES) { ret false; }

    val pb: usize = palette_block(palette);
    if (pb >= d.pcount[frame]) { ret false; }

    var bi: vk.DescriptorBufferInfo;
    bi.buffer = d.pals[frame][pb].handle;
    bi.offset = palette_offset(palette);
    bi.range  = PALETTE_BYTES::u64;

    var w: vk.WriteDescriptorSet;
    w.sType            = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
    w.pNext            = nil;
    w.dstSet           = d.blocks[slot_block(slot)].sets[set_index(slot, frame)];
    w.dstBinding       = 3;
    w.dstArrayElement  = 0;
    w.descriptorCount  = 1;
    w.descriptorType   = vk.DESCRIPTOR_TYPE_STORAGE_BUFFER;
    w.pImageInfo       = nil;
    w.pBufferInfo      = ?bi;
    w.pTexelBufferView = nil;

    vk.vkUpdateDescriptorSets(v.device, 1, ?w, 0, nil);
    ret true;
}

# Copy a draw's uniform bytes into its slot in the frame's ring.
#
# Returns false when the block is larger than a slot rather than writing over
# the next draw's uniforms, which would corrupt a draw that has not been
# recorded yet and is invisible at the call site that caused it.
pub fun descriptors_write_slot(d: *Descriptors, frame: usize, slot: usize, src: *u8, len: usize) bool {
    if (!d.ready || slot >= d.bcount * SLOTS_PER_BLOCK || frame >= MAX_FRAMES_IN_FLIGHT) { ret false; }
    if (len > SLOT_BYTES) { ret false; }
    val base: *u8 = d.blocks[slot_block(slot)].mapped[frame]:~*u8;
    mem.copy[u8](?base[slot_in_block(slot) * SLOT_BYTES], src, len);
    ret true;
}

# Copy bytes into a slot at a byte offset within it.
#
# The sprite path writes two blocks into one slot: the transform block at the
# start and the tint after it, so the fragment stage's binding reads from the
# same slot at an offset rather than needing a slot of its own.
pub fun descriptors_write_slot_at(d: *Descriptors, frame: usize, slot: usize, offset: usize,
                                  src: *u8, len: usize) bool {
    if (!d.ready || slot >= d.bcount * SLOTS_PER_BLOCK || frame >= MAX_FRAMES_IN_FLIGHT) { ret false; }
    if (offset + len > SLOT_BYTES) { ret false; }
    val base: *u8 = d.blocks[slot_block(slot)].mapped[frame]:~*u8;
    mem.copy[u8](?base[slot_in_block(slot) * SLOT_BYTES + offset], src, len);
    ret true;
}

# Point a slot's descriptor set at its uniform ranges and a texture.
#
# A NIL VIEW IS REFUSED, NOT SKIPPED. Every fragment stage boom ships samples,
# so a set bound with binding 1 unwritten makes the shader read a descriptor
# that was never filled. The untextured case is a caller passing the renderer's
# 1x1 white texture, not a caller passing nil: this cannot supply that fallback
# because it does not own one, so it reports the mistake instead.
#
# A `tint_size` above zero also writes the fragment stage's colour at binding 2
# from the same slot, at `tint_offset`. That offset is a descriptor buffer
# offset and must satisfy minUniformBufferOffsetAlignment, which is why it is
# COLOUR_OFFSET and not the size of the transform block.
pub fun descriptors_bind_slot(d: *Descriptors, v: *Vk, frame: usize, slot: usize,
                              size: u64, views: *vk.ImageView, sampler: vk.Sampler,
                              tint_offset: u64, tint_size: u64) bool {
    if (!d.ready || slot >= d.bcount * SLOTS_PER_BLOCK || frame >= MAX_FRAMES_IN_FLIGHT) { ret false; }
    if (views == nil || sampler == nil) { ret false; }
    # Every sampler binding is written every draw, so a shader sampling a slot
    # the material never filled reads a defined texture rather than whatever the
    # last draw left in the set. The caller supplies the fallback; the renderer
    # uses its white texel, which makes an unset slot a multiply by one.
    var ti2: usize = 0;
    for (ti2 < MAX_SAMPLERS) {
        if (views[ti2] == nil) { ret false; }
        ti2 = ti2 + 1;
    }
    if (tint_size > 0 && (tint_offset % UNIFORM_ALIGN::u64) != 0) { ret false; }
    val blk:  usize = slot_block(slot);
    val set:  vk.DescriptorSet = d.blocks[blk].sets[set_index(slot, frame)];
    val base: u64 = slot_offset(slot);

    var bi: vk.DescriptorBufferInfo;
    bi.buffer = d.blocks[blk].rings[frame].handle;
    bi.offset = base;
    bi.range  = size;

    var ti: vk.DescriptorBufferInfo;
    ti.buffer = d.blocks[blk].rings[frame].handle;
    ti.offset = base + tint_offset;
    ti.range  = tint_size;

    var ii: [4]vk.DescriptorImageInfo;
    var ij: usize = 0;
    for (ij < MAX_SAMPLERS) {
        ii[ij].sampler     = sampler;
        ii[ij].imageView   = views[ij];
        ii[ij].imageLayout = vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
        ij = ij + 1;
    }

    # The game's own block, always bound. A shader that does not declare
    # binding 4 simply never reads it, and one that does must not find an
    # undefined descriptor there, which is what leaving it unwritten would
    # produce for every draw that did not set user data.
    var ui: vk.DescriptorBufferInfo;
    ui.buffer = d.blocks[blk].rings[frame].handle;
    ui.offset = base + USER_OFFSET::u64;
    ui.range  = USER_BYTES::u64;

    var writes: [7]vk.WriteDescriptorSet;
    var n: u32 = 0;

    writes[n].sType            = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
    writes[n].pNext            = nil;
    writes[n].dstSet           = set;
    writes[n].dstBinding       = 0;
    writes[n].dstArrayElement  = 0;
    writes[n].descriptorCount  = 1;
    writes[n].descriptorType   = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER;
    writes[n].pImageInfo       = nil;
    writes[n].pBufferInfo      = ?bi;
    writes[n].pTexelBufferView = nil;
    n = n + 1;

    var si: usize = 0;
    for (si < MAX_SAMPLERS) {
        writes[n].sType            = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
        writes[n].pNext            = nil;
        writes[n].dstSet           = set;
        writes[n].dstBinding       = sampler_binding(si);
        writes[n].dstArrayElement  = 0;
        writes[n].descriptorCount  = 1;
        writes[n].descriptorType   = vk.DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
        writes[n].pImageInfo       = ?ii[si];
        writes[n].pBufferInfo      = nil;
        writes[n].pTexelBufferView = nil;
        n = n + 1;
        si = si + 1;
    }

    writes[n].sType            = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
    writes[n].pNext            = nil;
    writes[n].dstSet           = set;
    writes[n].dstBinding       = 4;
    writes[n].dstArrayElement  = 0;
    writes[n].descriptorCount  = 1;
    writes[n].descriptorType   = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER;
    writes[n].pImageInfo       = nil;
    writes[n].pBufferInfo      = ?ui;
    writes[n].pTexelBufferView = nil;
    n = n + 1;

    if (tint_size > 0) {
        writes[n].sType            = vk.STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
        writes[n].pNext            = nil;
        writes[n].dstSet           = set;
        writes[n].dstBinding       = 2;
        writes[n].dstArrayElement  = 0;
        writes[n].descriptorCount  = 1;
        writes[n].descriptorType   = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER;
        writes[n].pImageInfo       = nil;
        writes[n].pBufferInfo      = ?ti;
        writes[n].pTexelBufferView = nil;
        n = n + 1;
    }

    vk.vkUpdateDescriptorSets(v.device, n, ?writes[0], 0, nil);
    ret true;
}

# Bind a slot's set for the current frame before a draw.
pub fun descriptors_bind(d: *Descriptors, cmd: vk.CommandBuffer, layout: vk.PipelineLayout,
                         frame: usize, slot: usize) bool {
    if (!d.ready || slot >= d.bcount * SLOTS_PER_BLOCK || frame >= MAX_FRAMES_IN_FLIGHT) { ret false; }
    var set: vk.DescriptorSet = d.blocks[slot_block(slot)].sets[set_index(slot, frame)];
    vk.vkCmdBindDescriptorSets(cmd, vk.PIPELINE_BIND_POINT_GRAPHICS, layout, 0, 1, ?set, 0, nil);
    ret true;
}

# Destroy the rings and the pool.
#
# The sets are owned by the pool and are freed with it; freeing them
# individually would need the free-descriptor-set flag, which costs allocator
# bookkeeping this never uses.
pub fun descriptors_dnit(d: *Descriptors, v: *Vk) {
    if (!d.ready) { ret; }
    var f: usize = 0;
    for (f < MAX_FRAMES_IN_FLIGHT) {
        var bi2: usize = 0;
        for (bi2 < d.bcount) {
            buffer_dnit(?d.blocks[bi2].rings[f], v);
            d.blocks[bi2].mapped[f] = nil;
            bi2 = bi2 + 1;
        }
        var pb: usize = 0;
        for (pb < d.pcount[f]) {
            if (d.pmap[f][pb] != nil) {
                buffer_unmap(?d.pals[f][pb], v);
                d.pmap[f][pb] = nil;
            }
            buffer_dnit(?d.pals[f][pb], v);
            pb = pb + 1;
        }
        d.pcount[f] = 0;
        f = f + 1;
    }
    var bi3: usize = 0;
    for (bi3 < d.bcount) {
        vk.vkDestroyDescriptorPool(v.device, d.blocks[bi3].pool, nil);
        d.blocks[bi3].pool = nil;
        bi3 = bi3 + 1;
    }
    d.bcount = 0;
    d.used  = 0;
    d.pused = 0;
    d.ready = false;
}

# --------------------------------------------------------------------- tests
#
# Allocation needs a device, so these cover the indexing and the slot
# arithmetic. A mistake there makes two frames share a set or two draws share a
# uniform range, which appears as one-frame flicker under load and not at all
# when the GPU keeps up.

test "descriptor: each slot and frame gets a distinct set" {
    var seen: [1024]bool;
    var i: usize = 0;
    for (i < 1024) { seen[i] = false; i = i + 1; }

    var s: usize = 0;
    for (s < MAX_SLOTS) {
        var f: usize = 0;
        for (f < MAX_FRAMES_IN_FLIGHT) {
            val n: usize = set_index(s, f);
            if (n >= 1024) { ret 1; }
            if (seen[n])   { ret 2; }
            seen[n] = true;
            f = f + 1;
        }
        s = s + 1;
    }
    i = 0;
    for (i < MAX_SLOTS * MAX_FRAMES_IN_FLIGHT) {
        if (!seen[i]) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

test "descriptor: the two frames of one slot do not share a set" {
    # Sharing one means frame N overwrites the uniforms frame N-1 is executing.
    if (set_index(0, 0) == set_index(0, 1)) { ret 1; }
    if (set_index(7, 0) != 14)              { ret 2; }
    if (set_index(7, 1) != 15)              { ret 3; }
    ret 0;
}

test "descriptor: slot offsets do not overlap and are 256-aligned" {
    # 256 is the largest minUniformBufferOffsetAlignment any implementation
    # reports. An offset that is not a multiple of it is rejected on the
    # hardware that asks for it and accepted everywhere else.
    if (slot_offset(0) != 0)          { ret 1; }
    if (slot_offset(1) != SLOT_BYTES::u64) { ret 2; }
    var i: usize = 0;
    for (i < MAX_SLOTS) {
        if ((slot_offset(i) % 256) != 0) { ret 3; }
        i = i + 1;
    }
    # The last slot must still lie inside the ring.
    if (slot_offset(MAX_SLOTS - 1) + SLOT_BYTES::u64 != (MAX_SLOTS * SLOT_BYTES)::u64) { ret 4; }
    ret 0;
}

test "descriptor: a slot is wide enough for the widest uniform block" {
    # Written against the blocks themselves rather than a literal, because the
    # widest one has already changed once and a number left behind outlives the
    # reason for it. A slot narrower than the block would make a draw's uniforms
    # run into the next draw's.
    if (SLOT_BYTES < $size_of(SkinnedUniforms)) { ret 1; }
    if (SLOT_BYTES < $size_of(MeshUniforms))    { ret 2; }
    if (SLOT_BYTES < $size_of(ScreenUniforms))  { ret 3; }
    ret 0;
}

test "descriptor: both uniform ranges in a slot are correctly aligned" {
    # A uniform descriptor's buffer offset must be a multiple of
    # minUniformBufferOffsetAlignment, which is up to 256. This applies to the
    # colour block at COLOUR_OFFSET as much as to the slot itself: an offset of
    # 128 into an aligned slot is accepted on hardware reporting 16 and rejected
    # on hardware reporting 256, so it passes wherever it was written and fails
    # on someone else's machine.
    if ((SLOT_BYTES % UNIFORM_ALIGN) != 0)    { ret 1; }
    if ((COLOUR_OFFSET % UNIFORM_ALIGN) != 0) { ret 2; }
    if (COLOUR_OFFSET == 0)                   { ret 3; }
    # The colour must not run past the end of its slot.
    if (COLOUR_OFFSET + 16 > SLOT_BYTES)      { ret 4; }
    ret 0;
}

test "descriptor: the game's own block is aligned and fits inside a slot" {
    # The same alignment rule as the colour, and the same failure mode: an
    # unaligned offset is accepted on hardware reporting 16 and rejected on
    # hardware reporting 256, so it works wherever it was written and fails on
    # someone else's machine.
    if ((USER_OFFSET % UNIFORM_ALIGN) != 0) { ret 1; }
    # It must not overlap the colour block below it.
    if (USER_OFFSET < COLOUR_OFFSET + 16)   { ret 2; }
    # And a full-size block must not run past the end of the slot, or a game
    # writing USER_BYTES would be refused at the draw rather than here.
    if (USER_OFFSET + USER_BYTES > SLOT_BYTES) { ret 3; }
    ret 0;
}

test "descriptor: the transform block fits before the colour" {
    # A colour offset below the transform block would place the fragment stage's
    # colour inside the vertex stage's matrices, which draws the geometry
    # somewhere else entirely while the colour still looks right.
    if (COLOUR_OFFSET < $size_of(SkinnedUniforms)) { ret 1; }
    if (COLOUR_OFFSET < $size_of(MeshUniforms))    { ret 2; }
    ret 0;
}

test "descriptor: slots run out rather than wrapping onto live draws" {
    # No device, so no block can be created: this is the ceiling case, where
    # growth is unavailable and exhaustion must still be reportable. Wrapping to
    # 0 would silently give a later draw the same uniform range as the first.
    var d: Descriptors;
    var v: Vk;
    v.ready = false;
    d.ready  = true;
    d.used   = 0;
    d.bcount = 1;

    var i: usize = 0;
    for (i < SLOTS_PER_BLOCK) {
        if (descriptors_take(?d, ?v) != i) { ret 1; }
        i = i + 1;
    }
    if (descriptors_take(?d, ?v) != NO_SLOT) { ret 2; }

    descriptors_begin_frame(?d);
    if (descriptors_take(?d, ?v) != 0) { ret 3; }
    ret 0;
}

test "descriptor: a slot maps to its own block and offset" {
    # The arithmetic that sends a write into the right ring. A mistake here puts
    # one block's draw into another block's memory, which is invisible at the
    # call site and looks like a corrupted uniform much later.
    if (slot_block(0) != 0)                     { ret 1; }
    if (slot_block(SLOTS_PER_BLOCK - 1) != 0)   { ret 2; }
    if (slot_block(SLOTS_PER_BLOCK) != 1)       { ret 3; }
    if (slot_block(SLOTS_PER_BLOCK * 3 + 7) != 3) { ret 4; }

    if (slot_in_block(SLOTS_PER_BLOCK) != 0)      { ret 5; }
    if (slot_in_block(SLOTS_PER_BLOCK + 7) != 7)  { ret 6; }

    # Every block's ring starts at zero, so an offset is block-relative and the
    # last slot of a block still fits inside it.
    if (slot_offset(SLOTS_PER_BLOCK) != 0)        { ret 7; }
    if (slot_offset(SLOTS_PER_BLOCK + 1) != SLOT_BYTES::u64) { ret 8; }
    if (slot_offset(SLOTS_PER_BLOCK - 1) + SLOT_BYTES::u64
        != (SLOTS_PER_BLOCK * SLOT_BYTES)::u64)   { ret 9; }

    # Two slots in different blocks share a set index, which is correct because
    # they index different blocks' set arrays.
    if (set_index(SLOTS_PER_BLOCK, 0) != set_index(0, 0)) { ret 10; }
    ret 0;
}

test "descriptor: a block larger than a slot is refused, not truncated" {
    var d: Descriptors;
    d.ready = true;
    var bytes: [8]u8;
    # Writing it would run over the next slot, corrupting a draw that has not
    # been recorded yet.
    if (descriptors_write_slot(?d, 0, 0, ?bytes[0], SLOT_BYTES + 1)) { ret 1; }
    ret 0;
}

test "descriptor: an offset write must fit inside its slot" {
    var d: Descriptors;
    d.ready = true;
    var bytes: [8]u8;
    # A tint written past the slot lands in the next draw's transform, which
    # moves an unrelated draw rather than mis-colouring this one.
    if (descriptors_write_slot_at(?d, 0, 0, SLOT_BYTES - 4, ?bytes[0], 8)) { ret 1; }
    if (descriptors_write_slot_at(?d, 0, 0, SLOT_BYTES, ?bytes[0], 1))     { ret 2; }
    ret 0;
}

test "descriptor: a slot holds a transform block and its tint together" {
    # The transform block at offset 0 and TintUniforms at COLOUR_OFFSET. If they
    # did not both fit, the tint would need a slot of its own and the two would
    # drift.
    if (COLOUR_OFFSET + $size_of(TintUniforms) > SLOT_BYTES) { ret 1; }
    ret 0;
}

test "descriptor: a nil image view is refused rather than left unwritten" {
    # Every fragment stage samples, so a set bound with binding 1 unwritten has
    # the shader read a descriptor that was never filled. Silently skipping the
    # write is what made that possible.
    var d: Descriptors;
    d.ready = true;
    var v: Vk;
    v.ready = false;
    if (descriptors_bind_slot(?d, ?v, 0, 0, 64, nil, nil, 0, 0)) { ret 1; }
    ret 0;
}

test "descriptor: an uninitialized pool refuses everything" {
    var d: Descriptors;
    d.ready  = false;
    d.used   = 0;
    d.bcount = 0;
    var v: Vk;
    v.ready = false;
    var bytes: [8]u8;
    if (descriptors_take(?d, ?v) != NO_SLOT)                     { ret 1; }
    if (descriptors_write_slot(?d, 0, 0, ?bytes[0], 8))          { ret 2; }
    if (descriptors_bind(?d, nil, nil, 0, 0))                    { ret 3; }
    if (descriptors_bind_slot(?d, ?v, 0, 0, 64, nil, nil, 0, 0)) { ret 4; }
    if (descriptors_take_palette(?d, ?v, 0) != MAX_PALETTES)     { ret 5; }
    if (descriptors_write_palette(?d, 0, 0, ?bytes[0], 8))       { ret 6; }
    if (descriptors_bind_palette(?d, ?v, 0, 0, 0))               { ret 7; }
    descriptors_dnit(?d, ?v);
    ret 0;
}

test "descriptor: a palette slot holds a full joint palette" {
    # MAX_JOINTS 4x4 float matrices. A slot narrower than the storage block the
    # shader declares makes the vertex stage read the next draw's palette for
    # its last joints, which bends part of a character by another's pose.
    if (PALETTE_BYTES != 128 * 64) { ret 1; }
    ret 0;
}

test "descriptor: a palette slot names a block and an offset within it" {
    # The two have to agree. An index that disagrees with the offset binds the
    # right buffer at the wrong place, or the wrong buffer at a plausible one,
    # and either draws a recognisable character in another character's pose.
    #
    # 8192 is a multiple of every minStorageBufferOffsetAlignment a device
    # reports, so no offset here needs a device query to be legal.
    if (palette_block(0) != 0)                      { ret 1; }
    if (palette_offset(0) != 0)                     { ret 2; }
    if (palette_offset(1) != PALETTE_BYTES::u64)    { ret 3; }

    if (palette_block(PALETTES_PER_BLOCK - 1) != 0) { ret 4; }
    # The first slot of the second block wraps the offset back to zero, which is
    # the point of splitting: each block is a buffer of its own.
    if (palette_block(PALETTES_PER_BLOCK) != 1)     { ret 5; }
    if (palette_offset(PALETTES_PER_BLOCK) != 0)    { ret 6; }

    # And no slot ever addresses past the end of the block holding it.
    var i: usize = 0;
    for (i < MAX_PALETTES) {
        if (palette_offset(i) + PALETTE_BYTES::u64 > (PALETTES_PER_BLOCK * PALETTE_BYTES)::u64) { ret 7; }
        if (palette_block(i) >= MAX_PALETTE_BLOCKS) { ret 8; }
        i = i + 1;
    }
    ret 0;
}

test "descriptor: palette slots are handed out in order and reset each frame" {
    var d: Descriptors;
    var v: Vk;
    d.ready = true;
    d.pused = 0;
    # Pretend every block already exists, so the ring never reaches for the
    # device. What is under test is the accounting, not buffer creation.
    var f: usize = 0;
    for (f < MAX_FRAMES_IN_FLIGHT) {
        d.pcount[f] = MAX_PALETTE_BLOCKS;
        f = f + 1;
    }

    var i: usize = 0;
    for (i < MAX_PALETTES) {
        if (descriptors_take_palette(?d, ?v, 0) != i) { ret 1; }
        i = i + 1;
    }
    # Full, and reported as full rather than wrapping onto a live palette.
    if (descriptors_take_palette(?d, ?v, 0) != MAX_PALETTES) { ret 2; }
    descriptors_begin_frame(?d);
    if (descriptors_take_palette(?d, ?v, 0) != 0) { ret 3; }
    ret 0;
}

test "descriptor: the palette ring holds more than one block of skinned draws" {
    # The defect this replaces: the ring was a flat 32, so the thirty-third
    # skinned draw in a frame was refused. Refusal is in submission order, so a
    # crowd lost whichever characters were submitted last, and said nothing.
    if (MAX_PALETTES <= PALETTES_PER_BLOCK) { ret 1; }
    if (MAX_PALETTES != PALETTES_PER_BLOCK * MAX_PALETTE_BLOCKS) { ret 2; }
    ret 0;
}

test "descriptor: a palette larger than a slot is refused" {
    var d: Descriptors;
    d.ready = true;
    var bytes: [8]u8;
    if (descriptors_write_palette(?d, 0, 0, ?bytes[0], PALETTE_BYTES + 1)) { ret 1; }
    ret 0;
}

test "descriptor: beginning a frame frees the palette ring too" {
    # Resetting only the uniform ring leaks palette slots across frames, so a
    # scene with a few skinned characters stops animating after 32 frames.
    var d: Descriptors;
    d.ready = true;
    d.used  = 7;
    d.pused = 3;
    descriptors_begin_frame(?d);
    if (d.used != 0)  { ret 1; }
    if (d.pused != 0) { ret 2; }
    ret 0;
}
