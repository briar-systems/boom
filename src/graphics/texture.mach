# the Texture handle: a GPU image sampled by shaders
#
# a game supplies raw RGBA8 pixels, encoded image bytes, or a file path and
# receives an opaque Texture; the backing Vulkan image and the mach-image
# decoder both stay hidden. texture_load_as and texture_from_bytes_as decode
# PNG, QOI and TGA today (the formats mach-image decodes) in a caller-selected
# colour space; their shorter counterparts retain the original sRGB default.
# Other formats return a clean error until the library grows their decoders.
#
# creation takes a Device because Vulkan has no implicit current context the
# way GL did: an image is created against a device, and the staged upload
# needs a command pool and a queue. see boom.graphics.device.
#
# mipmaps are not generated. GL's generate_mipmap has no Vulkan equivalent;
# the levels have to be produced with explicit blits, which is a change to
# boom.graphics.image rather than to this module, and nothing in the engine
# samples a minified texture yet: sprites and glyphs are drawn at or near
# their native size.

use vk;
use boom.graphics.vk.vk_wait_idle;
use boom.graphics.device.Device;
use boom.graphics.image.Image;
use boom.graphics.image.image_upload;
use boom.graphics.image.ColorSpace;
use boom.graphics.image.COLOR_SRGB;
use boom.graphics.image.COLOR_LINEAR;
use boom.graphics.image.image_format;
use boom.graphics.image.image_dnit;
use img: image;
use boom.graphics.error.Error;
use boom.graphics.error.error;
use vfs: boom.vfs;
use fs:   std.filesystem;
use vec:    std.collections.vector;
use allo: std.allocator;
use page: std.allocator.page;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# an opaque handle to a GPU texture
# ---
# image:  the backing Vulkan image and its view, hidden from the game
# width:  texture width in texels
# height: texture height in texels
pub rec Texture {
    image:  Image;
    width:  i32;
    height: i32;
}

# a decoded RGBA8 image, allocated from a caller allocator
# ---
# pixels: width*height*4 RGBA8 bytes
# width:  image width in texels
# height: image height in texels
# space:  how sampling interprets the decoded bytes
rec Decoded {
    pixels: *u8;
    width:  i32;
    height: i32;
    space:  ColorSpace;
}

# upload an RGBA8 image to the GPU
#
# expects width * height * 4 bytes in row-major order, tightly packed.
# the image is created device-local, filled through a staging buffer, and
# left in the layout a shader samples from. filtering and wrapping belong
# to the sampler, not the image, so they are the renderer's choice rather
# than this one's.
# ---
# d:      the upload context
# pixels: RGBA8 pixel data, 4 bytes per texel
# width:  image width in texels
# height: image height in texels
# space:  what the bytes mean; COLOR_SRGB for anything authored to be looked at
# ret:    the uploaded Texture handle, or an allocation/upload error
pub fun texture(d: *Device, pixels: *u8, width: i32, height: i32, space: ColorSpace) Result[Texture, Error] {
    if (!d.ready) {
        ret err[Texture, Error](error("the upload context is not initialized"));
    }
    if (width <= 0 || height <= 0) {
        ret err[Texture, Error](error("texture dimensions must be positive"));
    }

    var t: Texture;
    t.width  = width;
    t.height = height;
    val r: Result[bool, Error] = image_upload(?t.image, d.vk, d.pool, pixels,
                                             width::u32, height::u32, space);
    if (is_err[bool, Error](r)) {
        ret err[Texture, Error](unwrap_err[bool, Error](r));
    }
    ret ok[Texture, Error](t);
}

# decode encoded image bytes into a caller-allocated RGBA8 buffer
#
# detects the format, sizes the destination from the header, and decodes.
# PNG, QOI and TGA are supported; every decoder normalizes to RGBA8 top-left.
# the returned pixels are allocated from a and belong to the caller.
# ---
# data: encoded image bytes
# len:  length of data in bytes
# a:    allocator for the pixel buffer
# space: interpretation to retain with the decoded pixels
# out:  populated with the decoded pixels, dimensions and space on success
# ret:  true on success, or a decode/allocation error
fun decode(data: *u8, len: usize, space: ColorSpace,
           a: *allo.Allocator, out: *Decoded) Result[bool, Error] {
    val fmt: u8 = img.detect(data, len);
    var header: img.Image;
    if (fmt == img.FORMAT_QOI) {
        if (img.qoi_info(data, len, ?header) != img.DECODE_OK) {
            ret err[bool, Error](error("qoi header is invalid"));
        }
    }
    or (fmt == img.FORMAT_TGA) {
        if (img.tga_info(data, len, ?header) != img.DECODE_OK) {
            ret err[bool, Error](error("tga header is invalid"));
        }
    }
    or (fmt == img.FORMAT_PNG) {
        if (img.png_info(data, len, ?header) != img.DECODE_OK) {
            ret err[bool, Error](error("png header is invalid"));
        }
    }
    or {
        ret err[bool, Error](error("unsupported image format (only PNG, QOI and TGA are decoded)"));
    }

    val need: usize = img.image_byte_len(header.width, header.height);
    if (need == 0) {
        ret err[bool, Error](error("image dimensions are invalid"));
    }
    val dr: Result[*u8, str] = allo.allocate[u8](a, need);
    if (is_err[*u8, str](dr)) {
        ret err[bool, Error](error(unwrap_err[*u8, str](dr)));
    }
    val dst: *u8 = unwrap_ok[*u8, str](dr);

    var decoded: img.Image;
    if (fmt == img.FORMAT_QOI) {
        if (img.qoi_decode(data, len, dst, need, ?decoded) != img.DECODE_OK) {
            ret err[bool, Error](error("qoi decode failed"));
        }
    }
    or (fmt == img.FORMAT_TGA) {
        if (img.tga_decode(data, len, dst, need, ?decoded) != img.DECODE_OK) {
            ret err[bool, Error](error("tga decode failed"));
        }
    }
    or {
        # png inflates through a working buffer the other decoders do not need.
        # it is scratch, so it is released before returning either way.
        val slen: usize = img.png_scratch_len(data, len);
        if (slen == 0) {
            ret err[bool, Error](error("png header is invalid"));
        }
        val sr: Result[*u8, str] = allo.allocate[u8](a, slen);
        if (is_err[*u8, str](sr)) {
            ret err[bool, Error](error(unwrap_err[*u8, str](sr)));
        }
        val scratch: *u8 = unwrap_ok[*u8, str](sr);
        val st: img.DecodeStatus = img.png_decode(data, len, dst, need, scratch, slen, ?decoded);
        allo.deallocate[u8](a, scratch, slen);
        if (st != img.DECODE_OK) {
            ret err[bool, Error](error("png decode failed"));
        }
    }

    out.pixels = dst;
    out.width  = decoded.width::i32;
    out.height = decoded.height::i32;
    out.space  = space;
    ret ok[bool, Error](true);
}

# Decode encoded image bytes and upload them in an explicit colour space.
#
# Supports PNG, QOI and TGA. The encoded and decoded bytes are not retained.
# COLOR_SRGB applies the inverse sRGB transfer function when sampled;
# COLOR_LINEAR preserves authored channel values for normal maps and masks.
# ---
# d:    the upload context
# data: encoded image bytes (PNG, QOI or TGA)
# len:  length of data in bytes
# space: how sampling interprets the decoded RGBA8 bytes
# ret:  the uploaded Texture, or a decode/upload error
pub fun texture_from_bytes_as(d: *Device, data: *u8, len: usize,
                              space: ColorSpace) Result[Texture, Error] {
    var pa: allo.Allocator;
    page.make(?pa);

    var dec: Decoded;
    val r: Result[bool, Error] = decode(data, len, space, ?pa, ?dec);
    if (is_err[bool, Error](r)) {
        ret err[Texture, Error](unwrap_err[bool, Error](r));
    }

    val tr: Result[Texture, Error] = texture(d, dec.pixels, dec.width, dec.height, dec.space);
    allo.deallocate[u8](?pa, dec.pixels, img.image_byte_len(dec.width::u32, dec.height::u32));
    ret tr;
}

# Decode encoded image bytes and upload them as sRGB colour.
#
# This is the source-compatible form of texture_from_bytes_as. Existing callers
# keep the display-colour interpretation they had before explicit spaces were
# added.
# ---
# d:    the upload context
# data: encoded image bytes (PNG, QOI or TGA)
# len:  length of data in bytes
# ret:  the uploaded sRGB Texture, or a decode/upload error
pub fun texture_from_bytes(d: *Device, data: *u8, len: usize) Result[Texture, Error] {
    ret texture_from_bytes_as(d, data, len, COLOR_SRGB);
}

# Load an image file in an explicit colour space.
#
# Resolves the path through boom.vfs, reads the whole file, decodes PNG, QOI or
# TGA to RGBA8, and uploads it. The file and decoded pixels are not retained.
# COLOR_LINEAR is for data maps whose channels must reach the shader unchanged.
# ---
# d:    the upload context
# path: filesystem path to a PNG, QOI or TGA image
# space: how sampling interprets the decoded RGBA8 bytes
# ret:  the uploaded Texture, or a read/decode/upload error
# THE PATH IS VIRTUAL. `res://art/sheet.qoi` resolves through boom.vfs, the same
# as boom.audio.sound_load and boom.graphics.text.font_load. A path with no
# scheme is passed through unchanged, so an absolute or relative filesystem path
# still works and a game may mix the two.
#
# These three loaders took raw paths while the audio and font ones did not, which
# meant the same spelling loaded a sound and failed for a texture with nothing
# but "no such file or directory" to go on.
pub fun texture_load_as(d: *Device, path: str, space: ColorSpace) Result[Texture, Error] {
    var pa: allo.Allocator;
    page.make(?pa);

    # THROUGH THE VFS, like every other loader. A game writes `res://art/x.qoi`
    # and boom.vfs decides what that means; a raw path here would make the
    # graphics loaders the only ones in the engine that do not, so the same
    # spelling would work for a sound and fail for a texture.
    val pr: Result[str, str] = vfs.vfs_resolve(?pa, path);
    if (is_err[str, str](pr)) {
        ret err[Texture, Error](error(unwrap_err[str, str](pr)));
    }
    val real: str = unwrap_ok[str, str](pr);

    val br: Result[vec.Vector[u8], str] = fs.read_bytes(?pa, real);
    if (is_err[vec.Vector[u8], str](br)) {
        ret err[Texture, Error](error(unwrap_err[vec.Vector[u8], str](br)));
    }
    var buf: vec.Vector[u8] = unwrap_ok[vec.Vector[u8], str](br);

    val res: Result[Texture, Error] = texture_from_bytes_as(d, buf.data, buf.len, space);
    vec.dnit[u8](?buf);
    ret res;
}

# Load an image file as sRGB colour.
#
# This is the source-compatible form of texture_load_as. Use the explicit form
# with COLOR_LINEAR for normal, roughness, metallic, occlusion and mask maps.
# ---
# d:    the upload context
# path: virtual or filesystem path to a PNG, QOI or TGA image
# ret:  the uploaded sRGB Texture, or a read/decode/upload error
pub fun texture_load(d: *Device, path: str) Result[Texture, Error] {
    ret texture_load_as(d, path, COLOR_SRGB);
}

# the image view a descriptor binds this texture through
#
# there is no bind-to-a-unit step in Vulkan: a texture reaches a shader by
# being written into a descriptor set, which is the renderer's job. this
# exposes what that write needs without exposing the image.
# ---
# t:   the texture
# ret: the view, or nil when the texture was never uploaded
pub fun texture_view(t: *Texture) vk.ImageView {
    ret t.image.view;
}

# release the GPU image backing a handle
# ---
# d: the upload context the texture was created against
# t: texture to delete; the handle must not be used afterward
pub fun texture_delete(d: *Device, t: *Texture) {
    # A resource may still be referenced by a command buffer the GPU has not
    # finished. See vk_wait_idle.
    vk_wait_idle(d.vk);
    image_dnit(?t.image, d.vk);
    t.width  = 0;
    t.height = 0;
}

test "texture: a fresh handle carries no image" {
    var t: Texture;
    t.image.view = nil;
    if (texture_view(?t) != nil) { ret 1; }
    ret 0;
}

test "texture: creation against an uninitialized context is refused" {
    var d: Device;
    d.ready = false;
    var px: [4]u8 = [4]u8{255, 255, 255, 255};
    if (!is_err[Texture, Error](texture(?d, ?px[0], 1, 1, COLOR_SRGB))) { ret 1; }
    ret 0;
}

test "texture: non-positive dimensions are refused before allocating" {
    var d: Device;
    d.ready = true;
    var px: [4]u8 = [4]u8{255, 255, 255, 255};
    if (!is_err[Texture, Error](texture(?d, ?px[0], 0, 1, COLOR_SRGB)))  { ret 1; }
    if (!is_err[Texture, Error](texture(?d, ?px[0], 1, -4, COLOR_SRGB))) { ret 2; }
    ret 0;
}

test "texture: decode round-trips a qoi image" {
    var src_px: [16]u8 = [16]u8{
        255, 0, 0, 255,   0, 255, 0, 255,
        0, 0, 255, 255,   255, 255, 0, 255,
    };
    var srcimg: img.Image;
    srcimg.pixels     = ?src_px[0];
    srcimg.width      = 2;
    srcimg.height     = 2;
    srcimg.channels   = 4;
    srcimg.colorspace = 0;

    var enc: [512]u8;
    val n: usize = img.qoi_encode(?srcimg, ?enc[0], 512);
    if (n == 0) { ret 1; }

    var pa: allo.Allocator;
    page.make(?pa);
    var dec: Decoded;
    val r: Result[bool, Error] = decode(?enc[0], n, COLOR_SRGB, ?pa, ?dec);
    if (is_err[bool, Error](r)) { ret 2; }
    if (dec.width != 2 || dec.height != 2) { ret 3; }
    if (dec.pixels[0] != 255 || dec.pixels[1] != 0 || dec.pixels[2] != 0 || dec.pixels[3] != 255) { ret 4; }
    if (dec.pixels[4] != 0 || dec.pixels[5] != 255 || dec.pixels[6] != 0) { ret 5; }
    if (dec.space != COLOR_SRGB) { ret 6; }
    if (image_format(dec.space) != vk.FORMAT_R8G8B8A8_SRGB) { ret 7; }
    allo.deallocate[u8](?pa, dec.pixels, img.image_byte_len(2, 2));
    ret 0;
}

test "texture: decoded data retains an explicit linear colour space" {
    var src_px: [4]u8 = [4]u8{128, 64, 32, 255};
    var srcimg: img.Image;
    srcimg.pixels     = ?src_px[0];
    srcimg.width      = 1;
    srcimg.height     = 1;
    srcimg.channels   = 4;
    srcimg.colorspace = 0;

    var enc: [64]u8;
    val n: usize = img.qoi_encode(?srcimg, ?enc[0], 64);
    if (n == 0) { ret 1; }

    var pa: allo.Allocator;
    page.make(?pa);
    var linear: Decoded;
    val r: Result[bool, Error] = decode(?enc[0], n, COLOR_LINEAR, ?pa, ?linear);
    if (is_err[bool, Error](r)) { ret 2; }
    if (linear.pixels[0] != 128 || linear.pixels[1] != 64
        || linear.pixels[2] != 32 || linear.pixels[3] != 255) { ret 3; }
    if (linear.space != COLOR_LINEAR) { ret 4; }
    if (image_format(linear.space) != vk.FORMAT_R8G8B8A8_UNORM) { ret 5; }
    allo.deallocate[u8](?pa, linear.pixels, img.image_byte_len(1, 1));
    ret 0;
}

test "texture: decode round-trips a png image" {
    # PNG is the format the art is authored in, and it was the one the dispatch
    # refused: mach-image grew a decoder and this module never called it, so a
    # .png reported "unsupported image format" with the decoder sitting right
    # there. Round-tripping through the encoder pins that the branch is wired.
    var src_px: [16]u8 = [16]u8{
        255, 0, 0, 255,   0, 255, 0, 255,
        0, 0, 255, 255,   255, 255, 0, 255,
    };
    var srcimg: img.Image;
    srcimg.pixels     = ?src_px[0];
    srcimg.width      = 2;
    srcimg.height     = 2;
    srcimg.channels   = 4;
    srcimg.colorspace = 0;

    var enc: [1024]u8;
    if (img.png_encode_bound(2, 2) > 1024) { ret 1; }
    val n: usize = img.png_encode(?srcimg, ?enc[0], 1024);
    if (n == 0) { ret 2; }
    if (img.detect(?enc[0], n) != img.FORMAT_PNG) { ret 3; }

    var pa: allo.Allocator;
    page.make(?pa);
    var dec: Decoded;
    val r: Result[bool, Error] = decode(?enc[0], n, COLOR_SRGB, ?pa, ?dec);
    if (is_err[bool, Error](r)) { ret 4; }
    if (dec.width != 2 || dec.height != 2) { ret 5; }
    if (dec.pixels[0] != 255 || dec.pixels[1] != 0 || dec.pixels[2] != 0 || dec.pixels[3] != 255) { ret 6; }
    if (dec.pixels[4] != 0 || dec.pixels[5] != 255 || dec.pixels[6] != 0) { ret 7; }
    if (dec.pixels[12] != 255 || dec.pixels[13] != 255 || dec.pixels[14] != 0) { ret 8; }
    allo.deallocate[u8](?pa, dec.pixels, img.image_byte_len(2, 2));
    ret 0;
}

test "texture: unsupported format reports cleanly" {
    var junk: [8]u8 = [8]u8{1, 2, 3, 4, 5, 6, 7, 8};
    var pa: allo.Allocator;
    page.make(?pa);
    var dec: Decoded;
    val r: Result[bool, Error] = decode(?junk[0], 8, COLOR_SRGB, ?pa, ?dec);
    if (!is_err[bool, Error](r)) { ret 1; }
    ret 0;
}

test "texture: a load path is resolved through the vfs" {
    # The loaders that read files must agree on what a path means. This one took
    # a raw filesystem path while sound_load and font_load resolved `res://`, so
    # `res://art/x.qoi` loaded a sound and failed for a texture.
    #
    # Asserted through vfs_resolve rather than by loading, which needs a device:
    # what is being pinned is that the scheme is honoured and that a plain path
    # is left alone, and both are decided before any device is touched.
    var a: allo.Allocator;
    page.make(?a);

    val r: Result[str, str] = vfs.vfs_resolve(?a, "res://art/sheet.qoi");
    if (is_err[str, str](r)) { ret 1; }
    if (!str_equals(unwrap_ok[str, str](r), "res/art/sheet.qoi")) { ret 2; }

    # No scheme, so it is a filesystem path and must survive untouched.
    val p2: Result[str, str] = vfs.vfs_resolve(?a, "assets/sheet.qoi");
    if (is_err[str, str](p2)) { ret 3; }
    if (!str_equals(unwrap_ok[str, str](p2), "assets/sheet.qoi")) { ret 4; }
    ret 0;
}
