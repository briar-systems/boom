# SPIR-V shader modules, compiled from Mach.
#
# Boom's shaders are written in Mach, compiled to SPIR-V by the build-shaders
# step, and embedded here, so a shipped binary carries them and a game needs
# no shader files beside it.
#
# These seven modules are the whole shader surface of the engine. There is no
# runtime shader compilation and no shader source in a shipped build.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use boom.graphics.spirvread.CAP_SHADER;
use boom.graphics.spirvread.CLASS_STORAGE_BUFFER;
use boom.graphics.spirvread.DEC_NON_WRITABLE;
use boom.graphics.spirvread.spv_capabilities;
use boom.graphics.spirvread.spv_variable_at_binding;
use boom.graphics.spirvread.spv_variable_class;
use boom.graphics.spirvread.spv_has_decoration;
use boom.graphics.spirvread.spv_max_array_stride;
use boom.graphics.spirvread.spv_block_of_binding;
use boom.graphics.spirvread.spv_member_offsets;
use boom.graphics.uniform.MeshUniforms;
use boom.graphics.uniform.SkinnedUniforms;
use boom.graphics.uniform.ScreenUniforms;
use boom.graphics.uniform.TintUniforms;

# Directional-light fragment stage.
#[embed("../../res/spv/lit_frag.spv")]
pub val LIT_FRAG_SPV: [_]u8;

# Mesh vertex stage: model-view-projection from a uniform block.
#[embed("../../res/spv/mesh_vert.spv")]
pub val MESH_VERT_SPV: [_]u8;

# Skinned mesh vertex stage: the view-projection and model matrices from a
# uniform block, and the joint palette from a storage buffer at binding 3.
#[embed("../../res/spv/skinned_vert.spv")]
pub val SKINNED_VERT_SPV: [_]u8;

# Immediate-mode vertex stage: positions already in pixels, a colour per vertex,
# and a projection at binding 0. What a UI draw list, a particle system or a
# debug overlay needs, none of which have a per-draw model matrix.
#[embed("../../res/spv/ui_vert.spv")]
pub val UI_VERT_SPV: [_]u8;

# Immediate-mode fragment stage: the atlas texel times the vertex colour. No
# tint uniform, because one draw covers a whole draw list.
#[embed("../../res/spv/ui_frag.spv")]
pub val UI_FRAG_SPV: [_]u8;

# The entry point name every boom vertex stage uses.
pub val VERTEX_ENTRY: str = "vert_main";
# The entry point name every boom fragment stage uses.
pub val FRAGMENT_ENTRY: str = "frag_main";

test "spirv: every embedded module is a SPIR-V module of whole words" {
    # The magic number, little-endian. A module that failed to build leaves a
    # stale or empty file, and #[embed] carries whatever is there without
    # complaint, so the bytes are checked rather than assumed.
    var mods: [5]*u8;
    var lens: [5]usize;
    mods[0] = ?LIT_FRAG_SPV[0];     lens[0] = $length_of(LIT_FRAG_SPV);
    mods[1] = ?MESH_VERT_SPV[0];    lens[1] = $length_of(MESH_VERT_SPV);
    mods[2] = ?SKINNED_VERT_SPV[0]; lens[2] = $length_of(SKINNED_VERT_SPV);
    mods[3] = ?UI_VERT_SPV[0];      lens[3] = $length_of(UI_VERT_SPV);
    mods[4] = ?UI_FRAG_SPV[0];      lens[4] = $length_of(UI_FRAG_SPV);

    var i: usize = 0;
    for (i < 5) {
        if (lens[i] == 0)       { ret 1; }
        if ((lens[i] % 4) != 0) { ret 2; }
        val m: *u8 = mods[i];
        # 0x07230203
        if (m[0] != 0x03) { ret 3; }
        if (m[1] != 0x02) { ret 4; }
        if (m[2] != 0x23) { ret 5; }
        if (m[3] != 0x07) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test "spirv: the 2D modules are distinct from the mesh ones" {
    # A copy-paste in the embed paths would silently make the 2D pipeline draw
    # with the mesh shader, which fails at pipeline creation with a vertex input
    # mismatch rather than saying the path was wrong.
    if ($length_of(UI_VERT_SPV) == $length_of(MESH_VERT_SPV)
        && $length_of(UI_FRAG_SPV) == $length_of(LIT_FRAG_SPV)) { ret 1; }
    ret 0;
}

# --------------------------------------------------- what the modules declare
#
# These are the checks that were a Python script over spirv-dis, run only by CI
# and skipped silently wherever spirv-tools was absent. The modules are embedded
# right here, so the agreement between the CPU and the shader is a test like any
# other. See boom.graphics.spirvread for the reader and for what it does not do.

test "spirv: no module declares a capability but Shader" {
    # A capability past Shader is a device feature that has to be enabled, and
    # therefore a set of devices boom no longer runs on. Two shipped in 0.3.0
    # undetected and neither was asked for by a shader: both came out of
    # codegen. boom now passes no optional features at all, and this is what
    # keeps that true; see boom.graphics.vk.
    val want: u64 = 1::u64 << CAP_SHADER::u64;

    var mods: [5]*u8;
    var lens: [5]usize;
    mods[0] = ?LIT_FRAG_SPV[0];     lens[0] = $length_of(LIT_FRAG_SPV);
    mods[1] = ?MESH_VERT_SPV[0];    lens[1] = $length_of(MESH_VERT_SPV);
    mods[2] = ?SKINNED_VERT_SPV[0]; lens[2] = $length_of(SKINNED_VERT_SPV);
    mods[3] = ?UI_VERT_SPV[0];      lens[3] = $length_of(UI_VERT_SPV);
    mods[4] = ?UI_FRAG_SPV[0];      lens[4] = $length_of(UI_FRAG_SPV);

    var i: usize = 0;
    for (i < 5) {
        var high: bool = false;
        val caps: u64 = spv_capabilities(mods[i], lens[i], ?high);
        if (high)         { ret 1; }
        if (caps != want) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

test "spirv: each stage declares exactly the bindings the CPU binds for it" {
    # A binding the set layout does not declare is a descriptor the shader reads
    # and nothing wrote. This is the check that caught the layout stopping at
    # binding 1 while a fragment stage declared a tint at binding 2.
    #
    # Absence matters as much as presence, so each stage is asked about every
    # binding in set_layout_full and the answer has to match on both sides.
    if (!declares(?MESH_VERT_SPV[0], $length_of(MESH_VERT_SPV),
                  true, false, false, false, false))    { ret 1; }
    if (!declares(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV),
                  true, false, false, true, false))     { ret 2; }
    if (!declares(?LIT_FRAG_SPV[0], $length_of(LIT_FRAG_SPV),
                  false, true, true, false, false))     { ret 3; }
    if (!declares(?UI_VERT_SPV[0], $length_of(UI_VERT_SPV),
                  true, false, false, false, false))    { ret 4; }
    if (!declares(?UI_FRAG_SPV[0], $length_of(UI_FRAG_SPV),
                  false, true, false, false, false))    { ret 5; }
    ret 0;
}

test "spirv: the joint palette is a storage buffer with a 16-byte stride" {
    # As a uniform block the palette's array of columns would fall under std140,
    # which pads an array element to 16 bytes only by coincidence of this
    # element being 16 wide; boom uploads a Mat4 palette as a straight copy on
    # the strength of std430's natural stride. The class is what selects the
    # rule, so it is not cosmetic.
    val id: u32 = spv_variable_at_binding(?SKINNED_VERT_SPV[0],
                                          $length_of(SKINNED_VERT_SPV), 0, 3);
    if (id == 0) { ret 1; }
    if (spv_variable_class(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV), id)
        != CLASS_STORAGE_BUFFER) { ret 2; }
    if (spv_max_array_stride(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV)) != 16) {
        ret 3;
    }
    ret 0;
}

test "spirv: the palette is decorated NonWritable" {
    # A storage buffer a vertex stage might write requires
    # vertexPipelineStoresAndAtomics, an optional device feature. The decoration
    # is what says it is only read, and it is why boom asks for no features.
    val id: u32 = spv_variable_at_binding(?SKINNED_VERT_SPV[0],
                                          $length_of(SKINNED_VERT_SPV), 0, 3);
    if (id == 0) { ret 1; }
    if (!spv_has_decoration(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV),
                            id, DEC_NON_WRITABLE)) { ret 2; }
    ret 0;
}

test "spirv: each uniform block has the members its CPU record has" {
    # A block whose members moved is read as whatever is at that address, so the
    # geometry lands somewhere else and no layer reports anything. The last
    # member's offset plus its width is the block's size, and every member here
    # is a 16-byte vec4 or column.
    if (!block_is(?MESH_VERT_SPV[0], $length_of(MESH_VERT_SPV), 0,
                  8, $size_of(MeshUniforms)))    { ret 1; }
    if (!block_is(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV), 0,
                  8, $size_of(SkinnedUniforms))) { ret 2; }
    if (!block_is(?UI_VERT_SPV[0], $length_of(UI_VERT_SPV), 0,
                  4, $size_of(ScreenUniforms)))  { ret 3; }
    if (!block_is(?LIT_FRAG_SPV[0], $length_of(LIT_FRAG_SPV), 2,
                  1, $size_of(TintUniforms)))    { ret 4; }
    ret 0;
}

# Whether a module declares exactly the given subset of set_layout_full.
fun declares(m: *u8, len: usize, b0: bool, b1: bool, b2: bool, b3: bool, b4: bool) bool {
    if ((spv_variable_at_binding(m, len, 0, 0) != 0) != b0) { ret false; }
    if ((spv_variable_at_binding(m, len, 0, 1) != 0) != b1) { ret false; }
    if ((spv_variable_at_binding(m, len, 0, 2) != 0) != b2) { ret false; }
    if ((spv_variable_at_binding(m, len, 0, 3) != 0) != b3) { ret false; }
    if ((spv_variable_at_binding(m, len, 0, 4) != 0) != b4) { ret false; }
    ret true;
}

# Whether the block bound at a binding has a member count and a size.
#
# Every member of every block boom uploads is 16 bytes wide, a vec4 or a matrix
# column, so the size is the last offset plus 16. A block that grew a scalar
# member would break that assumption and this check with it, which is the right
# outcome: the CPU record would have to state its padding too.
fun block_is(m: *u8, len: usize, binding: u32, members: usize, size: usize) bool {
    val id: u32 = spv_block_of_binding(m, len, 0, binding);
    if (id == 0) { ret false; }

    var count: usize = 0;
    var last:  u32   = 0;
    if (!spv_member_offsets(m, len, id, ?count, ?last)) { ret false; }
    if (count != members)                { ret false; }
    if (last::usize + 16 != size)        { ret false; }
    ret true;
}
