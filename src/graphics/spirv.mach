# SPIR-V shader modules, compiled from Mach.
#
# Boom's shaders are written in Mach, compiled to SPIR-V for the vulkan1.0
# environment by the shader-* artifacts the library requires, and embedded here
# from what those artifacts produce, so a shipped binary carries them and a game
# needs no shader files beside it. A consumer building boom builds them too: a
# library artifact's requirements travel with the dependency.
#
# These seven modules are the whole shader surface of the engine. There is no
# runtime shader compilation and no shader source in a shipped build.
#
# Each embed is 4-byte aligned to state Vulkan's word-read contract, not to fix
# an observed bug.

use boom.graphics.spirvread.CAP_SHADER;
use boom.graphics.spirvread.Capabilities;
use boom.graphics.spirvread.DEC_NON_WRITABLE;
use boom.graphics.spirvread.MemberOffsets;
use boom.graphics.spirvread.spv_block_of_binding;
use boom.graphics.spirvread.spv_capabilities;
use boom.graphics.spirvread.spv_declares_binding;
use boom.graphics.spirvread.spv_has_decoration;
use boom.graphics.spirvread.spv_is_storage_buffer;
use boom.graphics.spirvread.spv_max_array_stride;
use boom.graphics.spirvread.spv_member_offsets;
use boom.graphics.spirvread.spv_variable_at_binding;
use boom.graphics.storage.FRAME_STORAGE_BINDING;
use boom.graphics.uniform.MeshUniforms;
use boom.graphics.uniform.ScreenUniforms;
use boom.graphics.uniform.SkinnedUniforms;
use boom.graphics.uniform.TintUniforms;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# Directional-light fragment stage.
#[align(4)]
#[embed("{artifact.shader-lit_frag.out}")]
pub val LIT_FRAG_SPV: [_]u8;

# Mesh vertex stage: model-view-projection from a uniform block.
#[align(4)]
#[embed("{artifact.shader-mesh_vert.out}")]
pub val MESH_VERT_SPV: [_]u8;

# Skinned mesh vertex stage: the view-projection and model matrices from a
# uniform block, and the joint palette from a storage buffer at binding 3.
#[align(4)]
#[embed("{artifact.shader-skinned_vert.out}")]
pub val SKINNED_VERT_SPV: [_]u8;

# Immediate-mode vertex stage: positions already in pixels, a colour per vertex,
# and a projection at binding 0. What a UI draw list, a particle system or a
# debug overlay needs, none of which have a per-draw model matrix.
#[align(4)]
#[embed("{artifact.shader-ui_vert.out}")]
pub val UI_VERT_SPV: [_]u8;

# Immediate-mode fragment stage: the atlas texel times the vertex colour, which
# it decodes from sRGB when the screen block at binding 0 says to. No tint
# uniform, because one draw covers a whole draw list.
#[align(4)]
#[embed("{artifact.shader-ui_frag.out}")]
pub val UI_FRAG_SPV: [_]u8;

# The entry point name every boom vertex stage uses.
pub val VERTEX_ENTRY: str = "vert_main";
# The entry point name every boom fragment stage uses.
pub val FRAGMENT_ENTRY: str = "frag_main";
# The entry point name a compute stage boom dispatches uses.
pub val COMPUTE_ENTRY: str = "comp_main";

test spirv__modules_whole_and_shader_capability_only {
    # #[embed] carries whatever the artifact produced, so the magic is checked.
    # a capability past Shader is a device feature boom would have to enable,
    # and two shipped in 0.3.0 out of codegen; see boom.graphics.vk
    val want: u64 = 1::u64 << CAP_SHADER::u64;
    var mods: [5]*u8;
    var lens: [5]usize;
    mods[0] = ?LIT_FRAG_SPV[0];
    lens[0] = $length_of(LIT_FRAG_SPV);
    mods[1] = ?MESH_VERT_SPV[0];
    lens[1] = $length_of(MESH_VERT_SPV);
    mods[2] = ?SKINNED_VERT_SPV[0];
    lens[2] = $length_of(SKINNED_VERT_SPV);
    mods[3] = ?UI_VERT_SPV[0];
    lens[3] = $length_of(UI_VERT_SPV);
    mods[4] = ?UI_FRAG_SPV[0];
    lens[4] = $length_of(UI_FRAG_SPV);

    var i: usize = 0;
    for (i < 5) {
        if (lens[i] == 0 || (lens[i] % 4) != 0) { ret 1; }
        val m: *u8 = mods[i];
        # 0x07230203, little-endian
        if (m[0] != 0x03 || m[1] != 0x02 || m[2] != 0x23 || m[3] != 0x07) { ret 2; }
        val caps: Capabilities = spv_capabilities(mods[i], lens[i]);
        if (caps.high)        { ret 3; }
        if (caps.low != want) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test spirv__stages_declare_exactly_bound_bindings {
    # A binding the set layout does not declare is a descriptor the shader reads
    # and nothing wrote. This is the check that caught the layout stopping at
    # binding 1 while a fragment stage declared a tint at binding 2.
    #
    # Absence matters as much as presence, so each stage is asked about every
    # binding in set_layout_full and the answer has to match on both sides.
    if (!declares(?MESH_VERT_SPV[0], $length_of(MESH_VERT_SPV),
        true, false, false, false, false, false)) { ret 1; }
    if (!declares(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV),
        true, false, false, true, false, false)) { ret 2; }
    if (!declares(?LIT_FRAG_SPV[0], $length_of(LIT_FRAG_SPV),
        false, true, true, false, false, false)) { ret 3; }
    if (!declares(?UI_VERT_SPV[0], $length_of(UI_VERT_SPV),
        true, false, false, false, false, false)) { ret 4; }
    if (!declares(?UI_FRAG_SPV[0], $length_of(UI_FRAG_SPV),
        true, true, false, false, false, false)) { ret 5; }
    ret 0;
}

test spirv__palette_readonly_storage_buffer_16_byte_stride {
    # a storage buffer selects std430, whose natural stride lets a Mat4 palette
    # upload as a straight copy. NonWritable is what spares the optional
    # vertexPipelineStoresAndAtomics feature
    val id: opt[u32] = spv_variable_at_binding(?SKINNED_VERT_SPV[0],
        $length_of(SKINNED_VERT_SPV), 0, 3);
    if (!sel id.some) { ret 1; }
    if (!spv_is_storage_buffer(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV), id.some)) {
        ret 2;
    }
    if (spv_max_array_stride(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV)) != 16) {
        ret 3;
    }
    if (!spv_has_decoration(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV),
        id.some, DEC_NON_WRITABLE)) { ret 4; }
    ret 0;
}

test spirv__uniform_blocks_match_cpu_records {
    # A block whose members moved is read as whatever is at that address, so the
    # geometry lands somewhere else and no layer reports anything. The last
    # member's offset plus its width is the block's size, and every member here
    # is a 16-byte vec4 or column.
    if (!block_is(?MESH_VERT_SPV[0], $length_of(MESH_VERT_SPV), 0,
        8, $size_of(MeshUniforms))) { ret 1; }
    if (!block_is(?SKINNED_VERT_SPV[0], $length_of(SKINNED_VERT_SPV), 0,
        8, $size_of(SkinnedUniforms))) { ret 2; }
    if (!block_is(?UI_VERT_SPV[0], $length_of(UI_VERT_SPV), 0,
        5, $size_of(ScreenUniforms))) { ret 3; }
    if (!block_is(?UI_FRAG_SPV[0], $length_of(UI_FRAG_SPV), 0,
        5, $size_of(ScreenUniforms))) { ret 5; }
    if (!block_is(?LIT_FRAG_SPV[0], $length_of(LIT_FRAG_SPV), 2,
        1, $size_of(TintUniforms))) { ret 4; }
    ret 0;
}

# Whether a module declares exactly the given subset of set_layout_full.
#[testing]
fun declares(m: *u8, len: usize, b0: bool, b1: bool, b2: bool, b3: bool, b4: bool,
    b8: bool) bool {
    if (spv_declares_binding(m, len, 0, 0) != b0)                     { ret false; }
    if (spv_declares_binding(m, len, 0, 1) != b1)                     { ret false; }
    if (spv_declares_binding(m, len, 0, 2) != b2)                     { ret false; }
    if (spv_declares_binding(m, len, 0, 3) != b3)                     { ret false; }
    if (spv_declares_binding(m, len, 0, 4) != b4)                     { ret false; }
    if (spv_declares_binding(m, len, 0, FRAME_STORAGE_BINDING) != b8) { ret false; }
    ret true;
}

# Whether the block bound at a binding has a member count and a size.
#
# Every member of every block boom uploads is 16 bytes wide, a vec4 or a matrix
# column, so the size is the last offset plus 16. A block that grew a scalar
# member would break that assumption and this check with it, which is the right
# outcome: the CPU record would have to state its padding too.
#[testing]
fun block_is(m: *u8, len: usize, binding: u32, members: usize, size: usize) bool {
    val id: opt[u32] = spv_block_of_binding(m, len, 0, binding);
    if (sel id.none) { ret false; }

    val offsets: opt[MemberOffsets] = spv_member_offsets(m, len, id.some);
    if (sel offsets.none)                      { ret false; }
    if (offsets.some.count != members)         { ret false; }
    if (offsets.some.last::usize + 16 != size) { ret false; }
    ret true;
}
