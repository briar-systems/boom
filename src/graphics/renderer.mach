pub val MAX_RETIRED_MESHES:       usize = 1024;
pub val MAX_PENDING_MESH_UPLOADS: usize = 1024;

rec RetiredMeshes {
    meshes: [1024]Mesh;
    count:  usize;
}

rec PendingMeshUpload {
    vertex_staging: Buffer;
    index_staging:  Buffer;
    command:        vk.CommandBuffer;
    fence:          vk.Fence;
}

# the render device: the frame lifecycle, pipelines, and shared resources
# ---
# vk:          the instance, device, and queues
# dev:         the upload context resources are created against
# swap:        the swapchain the window is presented through
# frame:       the frame loop and its synchronization
# desc:        descriptor sets and the per-frame uniform ring
# nearest:     point sampling for pixel art and discrete data
# linear:      bilinear sampling for scaled images and continuous fields
# pipes:       the pipeline cache, keyed by program and vertex layout
# white:       a 1x1 opaque white texture, bound when a draw has no texture of
#              its own, since every fragment stage samples
# store:       the frame's storage buffer, the bulk data a game's own shading reads
# width:       the target width in pixels
# height:      the target height in pixels
# frame_index: which in-flight frame is being recorded
# drawing:     whether a frame is currently open
# dropped:     draws refused this frame, because a resource ran out or because
#              their parameters could not be uploaded
# refused:     uniform blocks refused this frame for not fitting the slot's user
#              region, which is a different fault from a dropped draw and is
#              counted separately so the two are told apart
# culled:      draws skipped this frame because they were outside the view
# draws:       draw calls recorded this frame, after batching
# srgb:        whether the surface encodes sRGB on write; false means the colour
#              pipeline is missing its final encode and output is dark
# present:     the present mode that was asked for, which the surface may not have
#              honoured; the one in use lives on the swapchain
# Readiness flags record which owned stages are live for partial unwind.
pub rec Renderer {
    window:          glfw.Window;
    vk:              Vk;
    dev:             Device;
    swap:            Swapchain;
    frame:           FrameLoop;
    desc:            Descriptors;
    nearest:         vk.Sampler;
    linear:          vk.Sampler;
    pipes:           PipelineCache;
    white:           Texture;
    stream:          VertexStream;
    store:           FrameStorage;
    retired:         [2]RetiredMeshes;
    uploads:         [MAX_PENDING_MESH_UPLOADS]PendingMeshUpload;
    upload_count:    usize;
    upload_reserved: usize;
    ui_format:       VertexFormat;
    width:           i32;
    height:          i32;
    frame_index:     usize;
    drawing:         bool;
    dropped:         usize;
    refused:         usize;
    culled:          usize;
    draws:           usize;
    srgb:            bool;
    present:         PresentMode;
    ready_vk:        bool;
    ready_dev:       bool;
    ready_swap:      bool;
    ready_frame:     bool;
    ready_near:      bool;
    ready_linear:    bool;
    ready_pipes:     bool;
    ready_desc:      bool;
    ready_white:     bool;
    ready_stream:    bool;
    ready_store:     bool;
}

# initialize a renderer against a window
#
# the window must have been opened with boom.window.window_open, which
# creates no GL context: a window carrying one cannot back a Vulkan surface.
# the renderer starts at the window's framebuffer size and follows it after.
#
# presents with vsync, which every implementation supports.
# renderer_init_with_present asks for another, and renderer_set_present_mode
# changes it later without the renderer being torn down.
# ---
# r:      renderer to initialize
# window: the open window to present to, which must outlive the renderer
# ret:    ok, or the first step that failed
pub fun renderer_init(r: *Renderer, window: *Window) err[Error] {
    ret renderer_init_with_present(r, window, PresentMode.vsync{});
}

# initialize a renderer against a window, presenting a chosen way
#
# the mode is a request. a surface that does not offer it falls back to
# vsync, and renderer_present_mode reports what was actually taken;
# renderer_present_mode_supported answers the question ahead of the attempt.
# ---
# r:       renderer to initialize
# window:  the open window to present to, which must outlive the renderer
# present: how finished frames should reach the display
# ret:     ok, or the first step that failed
pub fun renderer_init_with_present(r: *Renderer, window: *Window,
    present: PresentMode) err[Error] {
    if (sel window.handle.none) { ret err[Error].err{Error.uninitialized{Stage.window{}}}; }
    val width:  i32 = window.width;
    val height: i32 = window.height;
    r.window      = window.handle.some;
    r.width       = width;
    r.height      = height;
    r.drawing     = false;
    r.frame_index = 0;
    var retire_frame: usize = 0;
    for (retire_frame < 2) {
        r.retired[retire_frame].count = 0;
        retire_frame                  = retire_frame + 1;
    }
    r.upload_count    = 0;
    r.upload_reserved = 0;
    r.dropped         = 0;
    r.refused         = 0;
    r.culled          = 0;
    r.draws           = 0;
    r.present         = present;
    r.ready_vk        = false;
    r.ready_dev       = false;
    r.ready_swap      = false;
    r.ready_frame     = false;
    r.ready_near      = false;
    r.ready_linear    = false;
    r.ready_pipes     = false;
    r.ready_desc      = false;
    r.ready_white     = false;
    r.ready_stream    = false;
    r.ready_store     = false;

    val vr: err[Error] = vk_init(?r.vk, r.window, "boom");
    if (sel vr.err) { ret vr; }
    r.ready_vk = true;

    val dr: err[Error] = device_init(?r.dev, ?r.vk);
    if (sel dr.err) {
        renderer_rollback(r);
        ret dr;
    }
    r.ready_dev = true;

    val sr: err[Error] = swapchain_init(?r.swap, ?r.vk, width::u32, height::u32, r.present);
    if (sel sr.err) {
        renderer_rollback(r);
        ret sr;
    }
    r.ready_swap = true;

    val fr: err[Error] = frame_init(?r.frame, ?r.vk, ?r.swap);
    if (sel fr.err) {
        renderer_rollback(r);
        ret fr;
    }
    r.ready_frame = true;

    # The colour pipeline assumes the sRGB encode happens exactly once, at the
    # surface: textures are sampled through sRGB formats so the shader works in
    # linear light. A surface offering no sRGB format leaves that encode out,
    # and everything comes out darker than authored. Recording it rather than
    # failing, because a dark window is better than no window and the caller
    # can say so.
    r.srgb = format_is_srgb(r.swap.format);

    val samr: err[Error] = sampler_init(?r.nearest, ?r.vk, true);
    if (sel samr.err) {
        renderer_rollback(r);
        ret samr;
    }
    r.ready_near = true;
    val saml: err[Error] = sampler_init(?r.linear, ?r.vk, false);
    if (sel saml.err) {
        renderer_rollback(r);
        ret saml;
    }
    r.ready_linear = true;

    # Pipelines are built on demand, keyed by program and vertex layout, because
    # a .glb decides its own layout. See boom.graphics.cache.
    cache_init(?r.pipes);
    r.ready_pipes = true;
    r.ui_format   = vertex_format_ui();

    # The descriptor pool needs a set layout before any pipeline exists, so the
    # 2D pipeline is built first and its layout is what the pool allocates
    # against. Every pipeline shares one set layout, so any of them would do;
    # building one up front just means there is one to ask. This one, because it
    # is the pipeline every frame uses.
    val window_compatibility: PassCompatibility     = pass_compatibility_one(r.vk.color_format);
    val two_d:                res[*Pipeline, Error] = cache_get(?r.pipes, ?r.vk, r.frame.pass,
        ?window_compatibility, PROGRAM_UI,
        ?r.ui_format, DepthConvention.forward{});
    if (sel two_d.err) {
        renderer_rollback(r);
        ret err[Error].err{two_d.err};
    }

    val der: err[Error] = descriptors_init(?r.desc, ?r.vk, two_d.ok.set_layout);
    if (sel der.err) {
        renderer_rollback(r);
        ret der;
    }
    r.ready_desc = true;

    # Every fragment stage samples, so a draw with no texture of its own needs
    # something valid bound. One opaque white texel makes an untextured mesh
    # come out as its base colour exactly.
    var white_px: [4]u8;
    white_px[0] = 255;
    white_px[1] = 255;
    white_px[2] = 255;
    white_px[3] = 255;
    # sRGB, so it decodes to exactly 1.0 and multiplying by it is the identity.
    # A linear white would also be 1.0 today, but naming the space keeps this
    # correct if the fallback ever becomes something other than pure white.
    val wr: res[Texture, Error] = texture(?r.dev, ?white_px[0], 1, 1, ColorSpace.srgb{});
    if (sel wr.err) {
        renderer_rollback(r);
        ret err[Error].err{wr.err};
    }
    r.white       = wr.ok;
    r.ready_white = true;

    # The per-frame arena for geometry that is rebuilt every frame: every 2D
    # draw boom makes goes through it.
    val str_r: err[Error] = stream_init(?r.stream, ?r.vk);
    if (sel str_r.err) {
        renderer_rollback(r);
        ret str_r;
    }
    r.ready_stream = true;

    # The frame's storage buffer. Created here rather than on the first write,
    # because binding 8 is in every set layout and a set bound with it unwritten
    # is undefined behaviour: there has to be a buffer to name before the first
    # draw, whether or not a game ever fills it.
    val sto_r: err[Error] = storage_init(?r.store, ?r.vk);
    if (sel sto_r.err) {
        renderer_rollback(r);
        ret sto_r;
    }
    r.ready_store = true;

    ret err[Error].ok{};
}

# whether the surface encodes sRGB on write
#
# false means the driver offered no sRGB surface format, so the linear values
# the shaders write reach the display un-encoded and everything looks darker
# than it was authored. Nothing can be done about it inside the renderer; a
# game that wants to tell the player, or to log it, asks here.
# ---
# r:   the renderer
# ret: true when the colour pipeline is complete
pub fun renderer_is_srgb(r: *Renderer) bool {
    ret r.srgb;
}

# the upload context resources are created against
#
# textures, meshes, models, and render targets are created against this
# rather than against an implicit current context, which Vulkan has none of.
# ---
# r:   the renderer
# ret: the upload context, valid while the renderer lives
pub fun renderer_device(r: *Renderer) *Device {
    ret ?r.dev;
}

fun release_mesh_upload(r: *Renderer, upload: *PendingMeshUpload) {
    if (upload.fence != nil) {
        vk.vkDestroyFence(r.vk.device, upload.fence, nil);
        upload.fence = nil;
    }
    if (upload.command != nil) {
        vk.vkFreeCommandBuffers(r.vk.device, r.dev.pool, 1,
            ?upload.command);
        upload.command = nil;
    }
    buffer_dnit(?upload.vertex_staging, ?r.vk);
    buffer_dnit(?upload.index_staging, ?r.vk);
}

fun collect_mesh_uploads(r: *Renderer) {
    if (r == nil || !r.ready_dev) { ret; }
    var i: usize = 0;
    for (i < r.upload_count) {
        if (vk.vkGetFenceStatus(r.vk.device, r.uploads[i].fence)
            == vk.SUCCESS) {
            release_mesh_upload(r, ?r.uploads[i]);
            r.upload_count = r.upload_count - 1;
            if (i < r.upload_count) {
                r.uploads[i] = r.uploads[r.upload_count];
            }
        }
        or { i = i + 1; }
    }
}

# The staging a runtime mesh upload is written through, held between a
# renderer_mesh_begin and its renderer_mesh_end.
#
# The caller writes vertex_bytes through `vertices` and index_bytes through
# `indices`. Both point at host-coherent memory the transfer reads directly, so
# geometry a game generates is written once rather than assembled in its own
# array and copied again on the way to staging.
#
# ---
# vertices:       writable vertex staging, vertex_bytes long
# indices:        writable index staging, index_bytes long
# vertex_count:   vertices the staging was sized for
# index_count:    indices the staging was sized for
# format:         the layout the vertices are written in
# vertex_bytes:   the writable vertex extent, vertex_count * format.stride
# index_bytes:    the writable index extent, four bytes per index
# live:           whether the reservation is still open, cleared by end or cancel
# vertex_staging: the vertex staging buffer, owned until end or cancel
# index_staging:  the index staging buffer, owned until end or cancel
pub rec MeshUpload {
    vertices:       ptr;
    indices:        *u32;
    vertex_count:   i32;
    index_count:    i32;
    format:         VertexFormat;
    vertex_bytes:   u64;
    index_bytes:    u64;
    live:           bool;
    vertex_staging: Buffer;
    index_staging:  Buffer;
}

# whether another mesh upload fits, counting open reservations as outstanding
#
# A reservation holds staging and a queue slot from begin until end or cancel,
# so it is charged against the same budget as a submitted transfer. Counting
# only submitted transfers would admit a begin whose end has nowhere to go.
fun mesh_upload_fits(pending: usize, reserved: usize) bool {
    ret pending + reserved < MAX_PENDING_MESH_UPLOADS;
}

# the shape and staging extents an upload of this geometry needs
fun mesh_upload_sizes(u: *MeshUpload, format: *VertexFormat,
    vertex_count: i32, index_count: i32) {
    u.vertex_count = vertex_count;
    u.index_count  = index_count;
    u.format       = @format;
    u.vertex_bytes = vertex_count::u64 * format.stride::u64;
    u.index_bytes  = index_count::u64 * 4;
}

# copy a caller's arrays into the staging an upload exposes
fun mesh_upload_fill(u: *MeshUpload, vertices: *u8, indices: *u8) {
    mem.copy[u8](u.vertices:~*u8, vertices, u.vertex_bytes::usize);
    mem.copy[u8](u.indices:~*u8, indices, u.index_bytes::usize);
}

# the Mesh an upload describes, before its device-local buffers exist
fun mesh_upload_record(u: *MeshUpload, bounds: Aabb) Mesh {
    var m: Mesh;
    m.vertices.handle = nil;
    m.indices.handle  = nil;
    m.format          = u.format;
    m.index_count     = u.index_count;
    m.bounds          = bounds;
    ret m;
}

fun mesh_upload_empty() MeshUpload {
    var u: MeshUpload;
    u.vertices              = nil;
    u.indices               = nil;
    u.vertex_count          = 0;
    u.index_count           = 0;
    u.vertex_bytes          = 0;
    u.index_bytes           = 0;
    u.live                  = false;
    u.vertex_staging.handle = nil;
    u.index_staging.handle  = nil;
    ret u;
}

# release everything a failed end holds, staging and half-built mesh alike
fun mesh_end_fail(r: *Renderer, pending: *PendingMeshUpload, m: *Mesh,
    reason: Error) res[Mesh, Error] {
    release_mesh_upload(r, pending);
    buffer_dnit(?m.vertices, ?r.vk);
    buffer_dnit(?m.indices, ?r.vk);
    ret res[Mesh, Error].err{reason};
}

# Reserve host-visible staging for a runtime mesh and hand back its pointers.
#
# The caller writes its vertices and indices straight into the memory the
# transfer reads, then finishes with renderer_mesh_end. That removes the copy
# renderer_mesh makes out of a game's own array, which for multi-megabyte
# generated geometry is the larger half of the upload cost.
#
# Every reservation owns its own staging, so several may be open at once and a
# begin without an end does not disturb the next one. An open reservation is
# charged against the pending upload budget until end or cancel retires it, and
# one that is simply abandoned holds its staging until renderer teardown.
# ---
# r:            the renderer
# format:       the layout the vertices will be written in
# vertex_count: vertices to make room for
# index_count:  indices to make room for
# ret:          the staging to write through, or why it was refused
pub fun renderer_mesh_begin(r: *Renderer, format: *VertexFormat,
    vertex_count: i32,
    index_count: i32) res[MeshUpload, Error] {
    if (!r.ready_dev) {
        ret res[MeshUpload, Error].err{Error.uninitialized{Stage.renderer{}}};
    }
    if (vertex_count <= 0 || index_count <= 0) {
        ret res[MeshUpload, Error].err{Error.mesh{MeshError.empty{}}};
    }
    if (format.stride == 0) {
        ret res[MeshUpload, Error].err{Error.mesh{MeshError.zero_stride{}}};
    }
    collect_mesh_uploads(r);
    if (!mesh_upload_fits(r.upload_count, r.upload_reserved)) {
        ret res[MeshUpload, Error].err{Error.full{Capacity.mesh_uploads{}}};
    }

    var u: MeshUpload = mesh_upload_empty();
    mesh_upload_sizes(?u, format, vertex_count, index_count);

    val vsr: err[Error] = buffer_init(?u.vertex_staging, ?r.vk,
        u.vertex_bytes, vk.BUFFER_USAGE_TRANSFER_SRC_BIT,
        vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT
        | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT);
    if (sel vsr.err) { ret res[MeshUpload, Error].err{vsr.err}; }
    val isr: err[Error] = buffer_init(?u.index_staging, ?r.vk,
        u.index_bytes, vk.BUFFER_USAGE_TRANSFER_SRC_BIT,
        vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT
        | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT);
    if (sel isr.err) {
        buffer_dnit(?u.vertex_staging, ?r.vk);
        ret res[MeshUpload, Error].err{isr.err};
    }

    # Mapped for the life of the reservation rather than per write: the caller
    # holds these pointers, and the memory is host-coherent, so there is nothing
    # to flush between the last write and the transfer.
    val vmap: res[ptr, Error] = buffer_map(?u.vertex_staging, ?r.vk);
    if (sel vmap.err) {
        buffer_dnit(?u.vertex_staging, ?r.vk);
        buffer_dnit(?u.index_staging, ?r.vk);
        ret res[MeshUpload, Error].err{vmap.err};
    }
    val imap: res[ptr, Error] = buffer_map(?u.index_staging, ?r.vk);
    if (sel imap.err) {
        buffer_dnit(?u.vertex_staging, ?r.vk);
        buffer_dnit(?u.index_staging, ?r.vk);
        ret res[MeshUpload, Error].err{imap.err};
    }
    u.vertices = vmap.ok;
    u.indices  = imap.ok:~*u32;

    r.upload_reserved = r.upload_reserved + 1;
    u.live            = true;
    ret res[MeshUpload, Error].ok{u};
}

# Submit a reserved upload and hand back the mesh it becomes.
#
# `bounds` is taken as given. The caller guarantees the box contains every
# vertex it wrote and boom does not walk the vertices to check, which is the
# whole point for a caller that generated the geometry and already knows its
# extent.
#
# The reservation is consumed either way, so a failed end needs no cancel and
# ending twice reports the second call rather than submitting again.
# ---
# r:      the renderer the staging was reserved from
# upload: the reservation, consumed by this call
# bounds: the geometry's extent in the mesh's own space
# ret:    the drawable Mesh handle, or the first upload error
pub fun renderer_mesh_end(r: *Renderer, upload: *MeshUpload,
    bounds: Aabb) res[Mesh, Error] {
    if (!upload.live) {
        ret res[Mesh, Error].err{Error.renderer{RendererError.no_mesh_upload{}}};
    }
    if (!r.ready_dev) {
        ret res[Mesh, Error].err{Error.uninitialized{Stage.renderer{}}};
    }

    val vsize:    u64  = upload.vertex_bytes;
    val isize:    u64  = upload.index_bytes;
    var mesh_out: Mesh = mesh_upload_record(upload, bounds);

    # The staging moves from the caller's reservation to the renderer's pending
    # queue here, so the reservation is retired exactly once whatever follows.
    var pending: PendingMeshUpload;
    pending.vertex_staging       = upload.vertex_staging;
    pending.index_staging        = upload.index_staging;
    pending.command              = nil;
    pending.fence                = nil;
    upload.vertices              = nil;
    upload.indices               = nil;
    upload.vertex_staging.handle = nil;
    upload.index_staging.handle  = nil;
    upload.live                  = false;
    r.upload_reserved            = r.upload_reserved - 1;

    val vdr: err[Error] = buffer_init(?mesh_out.vertices, ?r.vk,
        vsize,
        vk.BUFFER_USAGE_VERTEX_BUFFER_BIT
        | vk.BUFFER_USAGE_TRANSFER_DST_BIT,
        vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
    if (sel vdr.err) {
        ret mesh_end_fail(r, ?pending, ?mesh_out, vdr.err);
    }
    val idr: err[Error] = buffer_init(?mesh_out.indices, ?r.vk,
        isize,
        vk.BUFFER_USAGE_INDEX_BUFFER_BIT
        | vk.BUFFER_USAGE_TRANSFER_DST_BIT,
        vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
    if (sel idr.err) {
        ret mesh_end_fail(r, ?pending, ?mesh_out, idr.err);
    }

    var ai: vk.CommandBufferAllocateInfo;
    ai.sType              = vk.STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
    ai.pNext              = nil;
    ai.commandPool        = r.dev.pool;
    ai.level              = vk.COMMAND_BUFFER_LEVEL_PRIMARY;
    ai.commandBufferCount = 1;
    val allocated: i32 = vk.vkAllocateCommandBuffers(r.vk.device, ?ai, ?pending.command);
    if (allocated != vk.SUCCESS) {
        # Nothing was allocated, so there is no command buffer to free.
        pending.command = nil;
        ret mesh_end_fail(r, ?pending, ?mesh_out,
            vk_failed(VkCall.allocate_command_buffers{}, allocated));
    }

    var bi: vk.CommandBufferBeginInfo;
    bi.sType            = vk.STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
    bi.pNext            = nil;
    bi.flags            = vk.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
    bi.pInheritanceInfo = nil;
    val begun: i32 = vk.vkBeginCommandBuffer(pending.command, ?bi);
    if (begun != vk.SUCCESS) {
        ret mesh_end_fail(r, ?pending, ?mesh_out,
            vk_failed(VkCall.begin_command_buffer{}, begun));
    }

    var vertex_copy: vk.BufferCopy;
    vertex_copy.srcOffset = 0;
    vertex_copy.dstOffset = 0;
    vertex_copy.size      = vsize;
    vk.vkCmdCopyBuffer(pending.command, pending.vertex_staging.handle,
        mesh_out.vertices.handle, 1, ?vertex_copy);
    var index_copy: vk.BufferCopy;
    index_copy.srcOffset = 0;
    index_copy.dstOffset = 0;
    index_copy.size      = isize;
    vk.vkCmdCopyBuffer(pending.command, pending.index_staging.handle,
        mesh_out.indices.handle, 1, ?index_copy);

    var barriers: [2]vk.BufferMemoryBarrier;
    barriers[0].sType               = vk.STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
    barriers[0].pNext               = nil;
    barriers[0].srcAccessMask       = vk.ACCESS_TRANSFER_WRITE_BIT;
    barriers[0].dstAccessMask       = vk.ACCESS_VERTEX_ATTRIBUTE_READ_BIT;
    barriers[0].srcQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED;
    barriers[0].dstQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED;
    barriers[0].buffer              = mesh_out.vertices.handle;
    barriers[0].offset              = 0;
    barriers[0].size                = vsize;
    barriers[1].sType               = vk.STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
    barriers[1].pNext               = nil;
    barriers[1].srcAccessMask       = vk.ACCESS_TRANSFER_WRITE_BIT;
    barriers[1].dstAccessMask       = vk.ACCESS_INDEX_READ_BIT;
    barriers[1].srcQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED;
    barriers[1].dstQueueFamilyIndex = vk.QUEUE_FAMILY_IGNORED;
    barriers[1].buffer              = mesh_out.indices.handle;
    barriers[1].offset              = 0;
    barriers[1].size                = isize;
    vk.vkCmdPipelineBarrier(pending.command,
        vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_VERTEX_INPUT_BIT,
        0, 0, nil, 2, ?barriers[0], 0, nil);

    val ended: i32 = vk.vkEndCommandBuffer(pending.command);
    if (ended != vk.SUCCESS) {
        ret mesh_end_fail(r, ?pending, ?mesh_out,
            vk_failed(VkCall.end_command_buffer{}, ended));
    }

    var fci: vk.FenceCreateInfo;
    fci.sType = vk.STRUCTURE_TYPE_FENCE_CREATE_INFO;
    fci.pNext = nil;
    fci.flags = 0;
    val fenced: i32 = vk.vkCreateFence(r.vk.device, ?fci, nil, ?pending.fence);
    if (fenced != vk.SUCCESS) {
        pending.fence = nil;
        ret mesh_end_fail(r, ?pending, ?mesh_out,
            vk_failed(VkCall.create_fence{}, fenced));
    }

    var si: vk.SubmitInfo;
    si.sType                = vk.STRUCTURE_TYPE_SUBMIT_INFO;
    si.pNext                = nil;
    si.waitSemaphoreCount   = 0;
    si.pWaitSemaphores      = nil;
    si.pWaitDstStageMask    = nil;
    si.commandBufferCount   = 1;
    si.pCommandBuffers      = ?pending.command;
    si.signalSemaphoreCount = 0;
    si.pSignalSemaphores    = nil;
    val submitted: i32 = vk.vkQueueSubmit(r.vk.graphics_queue, 1, ?si, pending.fence);
    if (submitted != vk.SUCCESS) {
        ret mesh_end_fail(r, ?pending, ?mesh_out,
            vk_failed(VkCall.queue_submit{}, submitted));
    }

    r.uploads[r.upload_count] = pending;
    r.upload_count            = r.upload_count + 1;
    ret res[Mesh, Error].ok{mesh_out};
}

# Release a reservation without uploading it.
#
# The way out of a begin the caller decides not to finish. end consumes the
# reservation itself, so this is only for the abandoned case.
# ---
# r:      the renderer the staging was reserved from
# upload: the reservation, consumed by this call
pub fun renderer_mesh_cancel(r: *Renderer, upload: *MeshUpload) {
    if (!upload.live) { ret; }
    buffer_dnit(?upload.vertex_staging, ?r.vk);
    buffer_dnit(?upload.index_staging, ?r.vk);
    upload.vertices   = nil;
    upload.indices    = nil;
    upload.live       = false;
    r.upload_reserved = r.upload_reserved - 1;
}

# reservations opened by renderer_mesh_begin and not yet ended or cancelled
pub fun renderer_mesh_reserved(r: *Renderer) usize {
    ret r.upload_reserved;
}

# Upload runtime geometry with bounds the caller already knows.
#
# Identical to renderer_mesh except that the box is taken as given rather than
# walked out of the vertices. That walk is a call per vertex, which a game
# generating multi-megabyte meshes pays twice: once here and once wherever it
# computed the same extent while building them.
# ---
# r:            the renderer
# vertices:     raw interleaved vertex bytes
# vertex_count: number of vertices
# format:       the vertex layout
# indices:      triangle index list, three per triangle
# index_count:  number of indices
# bounds:       the geometry's extent in the mesh's own space
# ret:          the drawable Mesh handle, or the first upload error
pub fun renderer_mesh_with_bounds(r: *Renderer, vertices: ptr,
    vertex_count: i32, format: *VertexFormat,
    indices: *u32, index_count: i32,
    bounds: Aabb) res[Mesh, Error] {
    val begun: res[MeshUpload, Error] = renderer_mesh_begin(r, format, vertex_count,
        index_count);
    if (sel begun.err) { ret res[Mesh, Error].err{begun.err}; }
    var upload: MeshUpload = begun.ok;
    mesh_upload_fill(?upload, vertices:~*u8, indices:~*u8);
    ret renderer_mesh_end(r, ?upload, bounds);
}

# upload runtime geometry without draining the graphics queue
#
# Walks the vertices for the mesh's bounds. A caller that already knows the
# extent skips that with renderer_mesh_with_bounds, and one that can generate
# its geometry in place skips this copy too with renderer_mesh_begin.
pub fun renderer_mesh(r: *Renderer, vertices: ptr, vertex_count: i32,
    format: *VertexFormat, indices: *u32,
    index_count: i32) res[Mesh, Error] {
    val begun: res[MeshUpload, Error] = renderer_mesh_begin(r, format, vertex_count,
        index_count);
    if (sel begun.err) { ret res[Mesh, Error].err{begun.err}; }
    var upload: MeshUpload = begun.ok;
    mesh_upload_fill(?upload, vertices:~*u8, indices:~*u8);
    ret renderer_mesh_end(r, ?upload,
        mesh_bounds_of(vertices:~*u8, vertex_count, format));
}

# The framebuffer width the renderer is currently drawing into, in pixels.
#
# THE ONE TO USE FOR ANYTHING IN FRAMEBUFFER PIXELS. It is the size the
# swapchain images actually have, which is what a full-screen composite has to
# be laid out against. It tracks the window, but it is adopted from the surface
# at rebuild time rather than copied from the window, so the two can disagree
# for the frame in which a resize is being applied.
pub fun renderer_width(r: *Renderer) i32 {
    ret r.width;
}

# The framebuffer height the renderer is currently drawing into, in pixels.
pub fun renderer_height(r: *Renderer) i32 {
    ret r.height;
}

# update the framebuffer size after a window resize
#
# rebuilds the swapchain and the frame loop's targets, both of which are
# bound to the surface size and are invalidated rather than adjusted by a
# resize. the device is idled first, because rebuilding while a frame is in
# flight destroys images the GPU is still reading.
# ---
# r:      renderer to update
# width:  the new framebuffer width in pixels
# height: the new framebuffer height in pixels
# ret:    success, or the first swapchain or framebuffer rebuild error
pub fun renderer_resize(r: *Renderer, width: i32, height: i32) err[Error] {
    ret renderer_rebuild(r, width, height, false);
}

fun renderer_rebuild(r: *Renderer, width: i32, height: i32,
    force: bool) err[Error] {
    if (width <= 0 || height <= 0) { ret err[Error].ok{}; }

    # Already the right size, so there is nothing to rebuild. Without this the
    # per-frame check below would idle the device and recreate every swapchain
    # image on every frame, which is a rebuild storm rather than a resize.
    if (!force && width == r.width && height == r.height
        && r.swap.ready && r.frame.fb_count > 0) {
        ret err[Error].ok{};
    }

    vk.vkDeviceWaitIdle(r.vk.device);
    frame_release_targets(?r.frame, ?r.vk);
    val sr: err[Error] = swapchain_rebuild(?r.swap, ?r.vk, width::u32, height::u32, r.present);
    if (sel sr.err) { ret sr; }
    val fr: err[Error] = frame_rebuild_targets(?r.frame, ?r.vk, ?r.swap);
    if (sel fr.err) { ret fr; }

    # THE SURFACE DECIDES, NOT THE REQUEST. A surface reporting a concrete
    # currentExtent overrides whatever size was asked for, which is the usual
    # case on a desktop compositor. Recording the request here instead would
    # leave the viewport and the 2D orthographic projection sized for a window
    # that no longer exists, so a resize would lay every sprite out against the
    # old dimensions while the image itself was the new size.
    #
    # It also means the out-of-date path can rebuild with the size it already
    # has and still converge: the driver corrects it and this reads the
    # correction back.
    r.width  = r.swap.width::i32;
    r.height = r.swap.height::i32;
    ret err[Error].ok{};
}

# choose how finished frames reach the display, with the game running
#
# THIS IS A SETTINGS-MENU OPERATION, so it does not tear the renderer down:
# every texture, mesh, font and pipeline the game has loaded survives it. A
# swapchain is bound to its present mode the way it is bound to its extent, so
# the mode is changed by rebuilding it, down the path a resize already takes.
# The device is idled, the frame loop's framebuffers are released, the swapchain
# is rebuilt, and the framebuffers are rebuilt against it.
#
# The request is remembered even when the rebuild fails, because the failure
# leaves no swapchain and the per-frame check will try again; retrying with the
# mode the player chose is the point. It is remembered even when the surface
# refuses the mode, so a game saving the choice saves the choice rather than the
# substitution.
# ---
# r:       the renderer
# present: how finished frames should reach the display
# ret:     success, or the first swapchain or framebuffer rebuild error
pub fun renderer_set_present_mode(r: *Renderer, present: PresentMode) err[Error] {
    if (!r.ready_swap) {
        ret err[Error].err{Error.uninitialized{Stage.swapchain{}}};
    }
    if (!present_mode_changed(r, present)) { ret err[Error].ok{}; }

    r.present = present;
    # Forced, because the extent is unchanged and the size check alone would
    # find nothing to do.
    ret renderer_rebuild(r, r.width, r.height, true);
}

# whether a present-mode request differs from the one the renderer is driving
#
# Pure and separate for the reason renderer_needs_rebuild is: a settings screen
# writes its values back every frame it is open, and a swapchain rebuilt every
# frame is not distinguishable from a hang.
#
# Compared against what was REQUESTED, not against what the swapchain settled
# for. On a surface with no MAILBOX those two differ for as long as the game
# runs, so comparing against the mode in use would rebuild forever on exactly
# the hardware the fallback exists for.
fun present_mode_changed(r: *Renderer, present: PresentMode) bool {
    ret !present_mode_same(present, r.present);
}

# how finished frames are actually reaching the display
#
# The requested mode unless the surface did not offer it, in which case
# vsync: the only mode every implementation must support. Worth reading
# after asking for MAILBOX or IMMEDIATE, because a game profiling itself under
# an unnoticed fallback is measuring the display's refresh rate and reading it
# as its own frame rate.
# ---
# r:   the renderer
# ret: the mode the swapchain was created with
pub fun renderer_present_mode(r: *Renderer) PresentMode {
    ret r.swap.present;
}

# the present mode that was asked for
#
# Differs from renderer_present_mode only where the surface refused it. A
# settings screen displays this one: writing the mode in use back to disk would
# replace the player's MAILBOX with the vsync some driver fell back to, and the
# choice would never return on hardware able to honour it.
# ---
# r:   the renderer
# ret: the mode last requested, at init or through renderer_set_present_mode
pub fun renderer_present_mode_requested(r: *Renderer) PresentMode {
    ret r.present;
}

# whether the surface can present this way
#
# For a menu that offers what it can actually deliver rather than one that
# accepts a choice and quietly ignores it. Vsync is always true, since
# every implementation must support it; the other two are the surface's answer.
#
# Also how a game expresses a second choice. The fallback here is to vsync and
# never to the other optional mode, because MAILBOX and IMMEDIATE differ in
# whether the image tears; a game that would rather tear than wait when MAILBOX
# is missing asks this and picks IMMEDIATE itself.
# ---
# r:    the renderer
# mode: the mode to ask about
# ret:  true when a request for that mode would be honoured
pub fun renderer_present_mode_supported(r: *Renderer, mode: PresentMode) bool {
    ret present_mode_supported(?r.vk, mode);
}

# begin this renderer's frame
#
# waits for the frame's fence, acquires a swapchain image, begins the
# render pass, and resets the uniform ring. false when the swapchain was out
# of date and was rebuilt, or the window is minimized, in which case the caller
# should skip drawing and try again next frame; that is a resize, not an error.
# ---
# r:   renderer to begin on
# ret: whether a frame was opened, or the failure that prevented one
pub fun renderer_begin_frame(r: *Renderer) res[bool, Error] {
    r.dropped = 0;
    r.refused = 0;
    r.culled  = 0;
    r.draws   = 0;
    collect_mesh_uploads(r);

    # THE RENDERER KEEPS ITSELF THE SIZE OF ITS SURFACE. The swapchain used to
    # rebuild only when the presentation engine reported it out of date, which
    # is not something every driver and compositor does on a resize: the window
    # would change size and the renderer would go on drawing at the old one
    # indefinitely, stretched, with no error anywhere. Measured on lavapipe
    # under Wayland, a window taken from 1280x720 to 640x640 left the renderer
    # at 1280x720 for as long as it ran.
    #
    # A game cannot be expected to drive this. The swapchain has to match the
    # surface or presentation is undefined, so it is not a policy choice a game
    # is entitled to make differently, and anything a game must remember to call
    # every frame is something it will one day forget. Rendering at a lower
    # resolution on purpose is a separate thing, done with an offscreen target
    # the game already owns.
    #
    # Checked here rather than in a resize callback so the size is stable for
    # the whole frame, matching how the engine loop refreshes the window's own.
    var fw: i32 = 0;
    var fh: i32 = 0;
    glfw.get_framebuffer_size(r.window, ?fw, ?fh);
    # Zero in either dimension is a minimized window: a legal state, and not one
    # a swapchain can be built for, so the frame is skipped rather than rebuilt.
    if (fw <= 0 || fh <= 0) { ret res[bool, Error].ok{false}; }
    if (renderer_needs_rebuild(r, fw, fh)) {
        val rr: err[Error] = renderer_resize(r, fw, fh);
        if (sel rr.err) { ret res[bool, Error].err{rr.err}; }
    }

    val br: res[bool, Error] = frame_begin(?r.frame, ?r.vk, ?r.swap);
    if (sel br.err) { ret br; }

    if (!br.ok) {
        val rr: err[Error] = renderer_rebuild(r, fw, fh, true);
        if (sel rr.err) { ret res[bool, Error].err{rr.err}; }
        ret res[bool, Error].ok{false};
    }

    r.frame_index = r.frame.current;
    release_retired_meshes(r, r.frame_index);
    # The frame's fence has been waited on, so every slot this frame owns is
    # free again. Without this the ring runs out after MAX_SLOTS total draws
    # rather than MAX_SLOTS per frame.
    descriptors_begin_frame(?r.desc);
    # Same reasoning as the descriptor ring, and the same fence proves it: the
    # GPU is done with everything this frame's command buffer read last time, so
    # its arena is free again.
    stream_begin(?r.stream, r.frame_index);
    # And its storage buffer, for the same reason. The capacity survives; only
    # the write mark is rewound, so a frame that needed room for forty lights
    # does not allocate for them again.
    storage_begin_frame(?r.store, r.frame_index);
    r.drawing = true;
    ret res[bool, Error].ok{true};
}

fun renderer_needs_rebuild(r: *Renderer, width: i32, height: i32) bool {
    if (width <= 0 || height <= 0) { ret false; }
    ret width != r.width || height != r.height
        || !r.swap.ready || r.frame.fb_count == 0;
}

# end the frame, submit it, and present
# ---
# r: renderer to finalize
pub fun renderer_end_frame(r: *Renderer) err[Error] {
    if (!r.drawing) { ret err[Error].ok{}; }
    r.drawing = false;

    val er: res[bool, Error] = frame_end(?r.frame, ?r.vk, ?r.swap);
    if (sel er.err) { ret err[Error].err{er.err}; }
    if (!er.ok) {
        val rr: err[Error] = renderer_rebuild(r, r.width, r.height, true);
        if (sel rr.err) { ret rr; }
    }
    ret err[Error].ok{};
}

# wait until the GPU has finished everything this renderer has submitted
#
# A FULL PIPELINE STALL, PAID TWICE. The CPU blocks until every frame in flight
# has retired, and then the GPU has nothing queued and refills from empty. A
# game that calls this every frame has given up the overlap the frame loop
# exists to provide and will see it in its frame times.
#
# It is here because tooling needs it and there is no other way for a game to
# ask for it. A readback drains the device itself (see render_target_read), so
# reads are correct without this, but a game reading several targets in a row
# can drain once here and let the reads that follow find the queue already
# idle. It is also what a measurement needs: with work still in flight, a timer
# around a draw records how far the CPU ran ahead of the GPU rather than what
# the GPU did.
#
# It does not flush the open frame. Passes record into a command buffer that
# renderer_end_frame submits, and waiting cannot retire work that has not been
# handed over, so a read that must include the current frame ends it first.
# ---
# r: the renderer to drain
pub fun renderer_wait_idle(r: *Renderer) {
    vk_wait_idle(?r.vk);
}

# retire a mesh when this frame's fence next proves its last use complete
#
# refused, leaving the mesh as it was, when the renderer never came up or too
# many meshes already wait on this frame's fence.
pub fun renderer_retire_mesh(r: *Renderer, m: *Mesh) err[Error] {
    if (!r.ready_dev) { ret err[Error].err{Error.uninitialized{Stage.renderer{}}}; }
    val frame: usize = r.frame_index;
    val count: usize = r.retired[frame].count;
    if (count >= MAX_RETIRED_MESHES) { ret err[Error].err{Error.full{Capacity.retired_meshes{}}}; }
    r.retired[frame].meshes[count] = @m;
    r.retired[frame].count         = count + 1;
    m.vertices.handle              = nil;
    m.vertices.memory              = nil;
    m.vertices.size                = 0;
    m.vertices.mapped              = nil;
    m.indices.handle               = nil;
    m.indices.memory               = nil;
    m.indices.size                 = 0;
    m.indices.mapped               = nil;
    m.index_count                  = 0;
    ret err[Error].ok{};
}

pub fun renderer_retired_meshes(r: *Renderer) usize {
    ret r.retired[0].count + r.retired[1].count;
}

fun release_retired_meshes(r: *Renderer, frame: usize) {
    if (r == nil || !r.ready_dev || frame >= 2) { ret; }
    var i: usize = 0;
    for (i < r.retired[frame].count) {
        mesh_release_retired(?r.dev, ?r.retired[frame].meshes[i]);
        i = i + 1;
    }
    r.retired[frame].count = 0;
}

# how many draws were refused this frame
#
# zero in normal operation. a non-zero count means the frame drew fewer
# things than it asked to, which is otherwise invisible: the missing draws
# simply do not appear.
#
# WHAT COUNTS AS ONE. A draw that could not take a uniform slot or a palette
# slot, one whose geometry did not fit the vertex arena, one whose pipeline
# could not be built, one submitted to a multi-attachment pass through a
# built-in program, and one whose uniforms could not be uploaded. That last
# class used to return without counting, and it is the worst of them to lose: a
# full-screen stage that does not run leaves everything downstream reading
# whatever its target already held, no layer reports anything, and from outside
# it is indistinguishable from the shading being wrong.
# ---
# r:   the renderer
# ret: the number of dropped draws in the most recent frame
pub fun renderer_dropped(r: *Renderer) usize {
    ret r.dropped;
}

# how many uniform blocks were refused this frame for not fitting
#
# Separate from renderer_dropped because the cause is different and the fix is
# different: a dropped draw means the frame asked for more than the renderer
# had, and this means a game handed pass_set_user more than USER_BYTES. The
# draws that follow such a refusal still happen, reading whatever their slot's
# user region last held, so the picture is wrong rather than missing.
#
# A payload larger than the block is what renderer_storage_write exists for.
# ---
# r:   the renderer
# ret: blocks refused in the most recent frame
pub fun renderer_refused(r: *Renderer) usize {
    ret r.refused;
}

# Draw calls recorded in the most recent frame.
#
# The number that matters after batching: a thousand sprites from one sheet is
# one draw here, and a count that tracks the sprite count instead means
# something is breaking the run, usually a texture alternating between two
# sheets in the submission order.
pub fun renderer_draws(r: *Renderer) usize {
    ret r.draws;
}

# Draws skipped in the most recent frame for being outside the view.
#
# The number that says whether culling is doing anything. Zero in a large scene
# means the bounds are wrong or the pass has culling off; a count that equals
# the submission count means everything is being rejected, which is what a
# frustum built from the wrong matrix looks like.
pub fun renderer_culled(r: *Renderer) usize {
    ret r.culled;
}

# release everything the renderer owns
# ---
# r: renderer to shut down; must not be used afterward
pub fun renderer_dnit(r: *Renderer) {
    renderer_rollback(r);
}

fun renderer_rollback(r: *Renderer) {
    if (r == nil) { ret; }

    # A live device may still be reading any of the later stages.
    if (r.ready_dev) { vk.vkDeviceWaitIdle(r.vk.device); }

    if (r.ready_dev) {
        for (r.upload_count > 0) {
            r.upload_count = r.upload_count - 1;
            release_mesh_upload(r, ?r.uploads[r.upload_count]);
        }
        # Staging still held by an open reservation dies with the device; the
        # budget it charged has to die with it.
        r.upload_reserved = 0;
        release_retired_meshes(r, 0);
        release_retired_meshes(r, 1);
    }

    if (r.ready_store) {
        storage_dnit(?r.store, ?r.vk);
        r.ready_store = false;
    }
    if (r.ready_stream) {
        stream_dnit(?r.stream, ?r.vk);
        r.ready_stream = false;
    }
    if (r.ready_white) {
        texture_delete(?r.dev, ?r.white);
        r.ready_white = false;
    }
    if (r.ready_desc) {
        descriptors_dnit(?r.desc, ?r.vk);
        r.ready_desc = false;
    }
    if (r.ready_pipes) {
        cache_dnit(?r.pipes, ?r.vk);
        r.ready_pipes = false;
    }
    if (r.ready_linear) {
        sampler_dnit(r.linear, ?r.vk);
        r.ready_linear = false;
    }
    if (r.ready_near) {
        sampler_dnit(r.nearest, ?r.vk);
        r.ready_near = false;
    }
    if (r.ready_frame) {
        frame_dnit(?r.frame, ?r.vk);
        r.ready_frame = false;
    }
    if (r.ready_swap) {
        swapchain_dnit(?r.swap, ?r.vk);
        r.ready_swap = false;
    }
    if (r.ready_dev) {
        device_dnit(?r.dev);
        r.ready_dev = false;
    }
    if (r.ready_vk) {
        vk_dnit(?r.vk);
        r.ready_vk = false;
    }
    r.drawing = false;
}

test "renderer: zero state teardown is idempotent" {
    var r: Renderer;
    r.drawing = true;
    renderer_dnit(?r);
    renderer_dnit(?r);
    if (r.drawing) { ret 1; }
    ret 0;
}

test "renderer: failed target rebuild remains retryable" {
    var r: Renderer;
    r.width  = 1280;
    r.height = 720;
    if (!renderer_needs_rebuild(?r, 1280, 720)) { ret 1; }
    r.swap.ready = true;
    if (!renderer_needs_rebuild(?r, 1280, 720)) { ret 2; }
    r.frame.fb_count = 2;
    if (renderer_needs_rebuild(?r, 1280, 720))   { ret 3; }
    if (!renderer_needs_rebuild(?r, 1920, 1080)) { ret 4; }
    ret 0;
}

test "renderer: a present mode cannot be set before there is a swapchain" {
    var r: Renderer;
    r.ready_swap = false;
    r.present    = PresentMode.vsync{};
    # There is nothing to rebuild, and recording the request anyway would leave
    # a renderer that never opened claiming to be presenting a mode.
    val set: err[Error] = renderer_set_present_mode(?r, PresentMode.mailbox{});
    if (!sel set.err)         { ret 1; }
    if (!sel r.present.vsync) { ret 2; }
    ret 0;
}

test "renderer: the requested present mode outlives the surface refusing it" {
    var r: Renderer;
    r.present      = PresentMode.mailbox{};
    r.swap.present = PresentMode.vsync{};
    # The two answer different questions, and a settings screen needs both:
    # writing the mode in use back to disk would replace the player's MAILBOX
    # with the vsync this driver fell back to, and the choice would never return
    # on hardware able to honour it.
    val in_use: PresentMode = renderer_present_mode(?r);
    if (!sel in_use.vsync) { ret 1; }
    val requested: PresentMode = renderer_present_mode_requested(?r);
    if (!sel requested.mailbox) { ret 2; }
    # Asking again for the mode already requested is not a change, even though
    # the swapchain is not in it. Comparing against the mode in use instead
    # would rebuild the swapchain every frame a settings screen was open, and
    # only ever on the hardware that could not honour the request.
    if (present_mode_changed(?r, PresentMode.mailbox{}))    { ret 3; }
    if (!present_mode_changed(?r, PresentMode.immediate{})) { ret 4; }
    if (!present_mode_changed(?r, PresentMode.vsync{}))     { ret 5; }
    ret 0;
}

# what a pass is seen through
# ---
# pixels: pixel space, origin at the target's top left and one world unit to one
#         pixel, which is what a UI overlay wants
# world:  a 2D camera mapping world units onto the target; borrowed for the pass
# scene:  a 3D camera providing view, projection and depth convention; borrowed
pub tag PassView: u8 {
    pixels;
    world: *Camera2D;
    scene: *Camera;
}

# how a pass is configured before it begins
# ---
# target: the offscreen target to render into, or none for the window
# view:   the projection the pass draws through
# clear:  the colour cleared to when the pass begins, or none to keep what is there
# depth:  the depth-buffer convention of a 2D pass; a scene takes its camera's
# cull:   whether the pass skips draws whose bounds are outside its view
#
# cull is on in every description boom builds, because a draw that cannot be
# seen is not worth submitting and a game should not have to remember to ask.
# It is turned off for a pass whose output is not what the camera sees: a shadow
# map rendered from the light's point of view, or a pass deliberately capturing
# geometry behind the viewer. Also turned off by a game doing its own culling
# upstream, where this second test is redundant rather than wrong.
pub rec PassDesc {
    target: opt[*RenderTarget];
    view:   PassView;
    clear:  opt[Vec4];
    depth:  DepthConvention;
    cull:   bool;
}

# a 3D scene pass description: perspective camera, depth test, opaque
# ---
# camera: the viewpoint providing view and projection
# ret:    the pass description
pub fun pass_scene(camera: *Camera) PassDesc {
    ret PassDesc{
        target: opt[*RenderTarget].none{},
        view:   PassView.scene{camera},
        clear:  opt[Vec4].some{vec4(0.08, 0.09, 0.12, 1.0)},
        depth:  camera_depth_convention(camera),
        cull:   true,
    };
}

# a 2D overlay pass description: pixel-space ortho, no depth, blended
# ---
# ret: the pass description
pub fun pass_overlay() PassDesc {
    ret PassDesc{
        target: opt[*RenderTarget].none{},
        view:   PassView.pixels{},
        clear:  opt[Vec4].none{},
        depth:  DepthConvention.forward{},
        cull:   true,
    };
}

# a 2D world pass seen through a camera: pan, zoom and roll
#
# The same pass as pass_overlay in every other respect. The difference is
# whose coordinates the draws are in: an overlay is placed in the target's
# pixels, and this is placed in world units the camera maps onto them.
#
# A game wants both in the same frame, which is the reason they are separate
# descriptions rather than one with an optional field: the world moves with the
# camera and the UI drawn over it does not.
# ---
# camera: the view; borrowed for the duration of the pass, not copied
# ret:    the pass description
pub fun pass_world(camera: *Camera2D) PassDesc {
    ret PassDesc{
        target: opt[*RenderTarget].none{},
        view:   PassView.world{camera},
        clear:  opt[Vec4].none{},
        depth:  DepthConvention.forward{},
        cull:   true,
    };
}

# an open pass: the resolved target, matrices, and the command buffer
# ---
# renderer:   the renderer this pass draws through
# cmd:        the command buffer draws are recorded into
# target:     the offscreen target this pass renders into, or none for the window
# width:      the target width in pixels
# height:     the target height in pixels
# view:       the view matrix draws combine into their transform
# projection: the projection matrix draws combine into their transform
pub rec Pass {
    renderer: *Renderer;
    # How many colour attachments this pass writes. A pipeline is only valid in
    # a pass with a matching attachment count, so it travels with the handle.
    targets:       usize;
    compatibility: PassCompatibility;
    cmd:           vk.CommandBuffer;
    target:        opt[*RenderTarget];
    width:         i32;
    height:        i32;
    region_x:      i32;
    region_y:      i32;
    region_width:  i32;
    region_height: i32;
    view:          Mat4;
    projection:    Mat4;
    depth:         DepthConvention;

    # The open run of 2D geometry. On the pass rather than the renderer because
    # its vertices were placed for this pass's projection and must be drawn into
    # this pass's render pass, so it cannot survive pass_end.
    batch: Batch2D;

    # What the 2D batch draws with, when a game has replaced the defaults.
    #
    # A batched sprite run used to be locked to the built-in UI program and to a
    # single texture, which is what kept the whole 2D path out of a deferred
    # geometry pass: that program declares one colour output and the run carried
    # one texture, so it could neither write four attachments nor read a
    # material's four sheets. A deferred game had to fall back to one draw per
    # sprite, and a screenful of floor is five hundred of them.
    #
    # Setting either flushes the open run, so a run never spans two programs or
    # two materials.
    shader2d: opt[*Shader];
    mat2d:    opt[*Material];

    # What this pass can see, resolved once when it opens.
    #
    # Both are derived from the matrices above, so they are built here rather
    # than at each draw: a frustum is six planes out of a matrix multiply, and
    # recomputing it per draw would make culling cost more than the draws it
    # saves. visible is the 2D equivalent, in world units.
    cull:    bool;
    frustum: Frustum;
    visible: Rect;

    # Whether this offscreen pass suspended the window's render pass, and so
    # must resume it when it ends. False for a window pass, and for an
    # excursion taken before any window pass began, which leaves the window
    # idle for the first window pass to begin with its own clear.
    resumes: bool;

    # The render pass draws are recorded into: the window's, or an offscreen
    # target's. Kept here because a game shader builds its pipelines against
    # whichever pass it is actually drawn in, and that is only known once the
    # pass is open.
    pass: vk.RenderPass;

    # The game's own uniform block, set by pass_set_user, copied into each
    # draw's slot. Borrowed for the duration of the pass, not copied here, so a
    # game may change it between draws by calling pass_set_user again.
    user:     *u8;
    user_len: usize;
}

# Clear the attachments of a render pass that is already recording.
#
# ONLY LEGAL WITH A RENDER PASS OPEN. It is not a clear on load by another
# spelling: that one is folded into the beginning of the pass and costs nothing,
# and this is work recorded between draws which erases whatever earlier passes
# in the same frame put in these attachments. Erasing them is what asking to
# clear means, but which of the two is being paid for is worth knowing.
#
# The first window pass of a frame begins the window's render pass and clears on
# load, so this is only reached by a later window pass, when the load-time clear
# is spent and erasing in place is the only way left to honour one.
fun clear_mid_pass(p: *Pass, color: Vec4) {
    # Four colours and a depth, which is as many attachments as any pass boom
    # builds has.
    var atts: [5]vk.ClearAttachment;
    val n:    usize = clear_attachments(p.targets, color, p.depth, ?atts[0]);

    var rect: vk.ClearRect;
    rect.rect.offset.x      = 0;
    rect.rect.offset.y      = 0;
    rect.rect.extent.width  = p.width::u32;
    rect.rect.extent.height = p.height::u32;
    rect.baseArrayLayer     = 0;
    rect.layerCount         = 1;

    # ONE RECT, NOT ONE PER ATTACHMENT. The rects are regions cleared in every
    # attachment named rather than a list paired off against them, so a single
    # rect over the whole extent is what makes this stand in for a clear on load.
    vk.vkCmdClearAttachments(p.cmd, n::u32, ?atts[0], 1, ?rect);
}

# The attachments a mid-pass clear names, and how many it filled in.
#
# Split out and pure so it can be tested, because this is the part that is wrong
# silently. An attachment missing from the array is simply not cleared, and an
# aspect named that the attachment does not have is a validation error the
# picture gives no sign of: both look like a clear that worked on the machine
# they were written on.
#
# Written over targets rather than over the one attachment the window has, so
# this stays a clear of whatever pass is open. Leaving the rest out on a
# multi-attachment pass would show as the last frame's G-buffer through the
# sheets that were missed.
#
# Unlike the clear-value array a render pass begins with, this one is not
# positional: each entry names its own aspect and, for a colour, its own
# attachment index. The order still follows pass_create's, colours then depth,
# because every other attachment array in boom reads that way.
fun clear_attachments(targets: usize, color: Vec4, depth: DepthConvention,
    out: *vk.ClearAttachment) usize {
    var i: usize = 0;
    for (i < targets) {
        out[i].aspectMask                  = vk.IMAGE_ASPECT_COLOR_BIT;
        out[i].colorAttachment             = i::u32;
        out[i].clearValue.color.float32[0] = color[0];
        out[i].clearValue.color.float32[1] = color[1];
        out[i].clearValue.color.float32[2] = color[2];
        out[i].clearValue.color.float32[3] = color[3];
        i                                  = i + 1;
    }

    # Depth goes with the colour, because that is what clearing already means
    # everywhere else: a target's clearing pass and the window's own both clear
    # both on load. Colour alone would leave the draws that follow depth-tested
    # against geometry that is no longer on the screen.
    #
    # DEPTH ONLY. Every attachment boom builds uses DEPTH_FORMAT, which is
    # D32_SFLOAT and carries no stencil component, so naming the stencil aspect
    # here is a validation error rather than a harmless extra.
    out[targets].aspectMask = vk.IMAGE_ASPECT_DEPTH_BIT;
    # Read only for a colour clear, and the struct offers nowhere else to put it.
    out[targets].colorAttachment                 = 0;
    out[targets].clearValue.depthStencil.depth   = depth_clear_value(depth);
    out[targets].clearValue.depthStencil.stencil = 0;

    ret targets + 1;
}

fun depth_clear_value(depth: DepthConvention) f32 {
    if (sel depth.reversed) { ret 0.0; }
    ret 1.0;
}

# begin a pass
#
# resolves the viewport from the target (or the window) and builds the view
# and projection: from the camera for a 3D pass, or a pixel-space
# orthographic projection for a 2D pass.
#
# a pass targeting an offscreen RenderTarget suspends the window's render
# pass and begins the target's, because a Vulkan pipeline draws into the
# render pass that is open and the two have different attachments. pass_end
# resumes the window's through its load variant, so the excursion does not
# erase what the frame has already drawn.
#
# the first window pass of a frame begins the window's render pass, so its
# clear is the clear on load and costs nothing. that is how a game sets the
# window's background: it is the clear of the first pass drawn to the window,
# and black when that pass asks for none. a later window pass that clears does
# so through vkCmdClearAttachments, because the load is spent by then. that is
# not free, and it erases what earlier passes in the same frame drew, which is
# what asking a pass to clear means. both leave the same pixels as clearing on
# load would, so one field says both and there is no second source to rank
# against it. an offscreen target clears on load, since it begins a render pass
# of its own.
#
# the request used to be ignored here: a window pass read clear_color, dropped
# it, and left the frame's own clear to black standing. of honouring a request,
# refusing it, and ignoring it, ignoring is the worst, because it is the one the
# caller cannot see. the call site reads correctly, the window is black, and
# there is nothing to search for. an outside report is what found it, and a game
# on this engine had been asking for a dark background and getting black for as
# long as it had been asking.
# ---
# r:   the renderer
# d:   the pass description
# ret: the open pass, passed to draw calls and pass_end
pub fun pass_begin(r: *Renderer, d: *PassDesc) Pass {
    var p: Pass = pass_resolve(r, d);

    if (sel d.target.none) {
        val step: WindowStep = window_step(r.frame.window, sel d.clear.some);
        if (sel step.begin) {
            var colour: Vec4 = vec4(0.0, 0.0, 0.0, 1.0);
            var depth:  f32  = 1.0;
            if (sel d.clear.some) {
                colour = d.clear.some;
                depth  = depth_clear_value(p.depth);
            }
            frame_begin_pass(?r.frame, ?r.swap, colour[0], colour[1], colour[2], colour[3], depth);
        }
        or (sel step.clear) {
            # window_step only chooses clear for a pass whose clear is set
            if (sel d.clear.some) { clear_mid_pass(?p, d.clear.some); }
        }
        ret p;
    }

    val target: *RenderTarget = d.target.some;
    p.resumes = frame_suspend_pass(?r.frame);

    var rbi: vk.RenderPassBeginInfo;
    rbi.sType                    = vk.STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
    rbi.pNext                    = nil;
    rbi.renderPass               = p.pass;
    rbi.framebuffer              = target.framebuffer;
    rbi.renderArea.offset.x      = 0;
    rbi.renderArea.offset.y      = 0;
    rbi.renderArea.extent.width  = target.width::u32;
    rbi.renderArea.extent.height = target.height::u32;
    # A loading pass declares no clear, and passing values for one is both
    # meaningless and a validation error.
    rbi.clearValueCount = 0;
    rbi.pClearValues    = nil;

    # ONE CLEAR VALUE PER ATTACHMENT, and depth last, matching the order
    # pass_create declared. A short array here is read past its end by the
    # driver for every attachment beyond the second.
    var clears: [5]vk.ClearValue;
    if (sel d.clear.some) {
        val colour: Vec4  = d.clear.some;
        var cvi:    usize = 0;
        for (cvi < p.targets) {
            clears[cvi].color.float32[0] = colour[0];
            clears[cvi].color.float32[1] = colour[1];
            clears[cvi].color.float32[2] = colour[2];
            clears[cvi].color.float32[3] = colour[3];
            cvi                          = cvi + 1;
        }
        # depth clears to the far value of the pass convention
        clears[p.targets].depthStencil.depth   = depth_clear_value(p.depth);
        clears[p.targets].depthStencil.stencil = 0;
        rbi.clearValueCount                    = (p.targets + 1)::u32;
        rbi.pClearValues                       = ?clears[0];
    }
    vk.vkCmdBeginRenderPass(p.cmd, ?rbi, vk.SUBPASS_CONTENTS_INLINE);
    ret p;
}

# Resolve a pass description into its target, extent, matrices and what it can
# see, recording nothing. That is what lets the projections be tested without a
# device.
fun pass_resolve(r: *Renderer, d: *PassDesc) Pass {
    var p: Pass;
    p.renderer = r;
    p.cmd      = r.frame.frames[r.frame_index].command;
    batch_reset(?p.batch);
    p.shader2d = opt[*Shader].none{};
    p.mat2d    = opt[*Material].none{};
    p.cull     = d.cull;
    p.depth    = d.depth;
    if (sel d.view.scene) {
        p.depth = camera_depth_convention(d.view.scene);
    }
    p.user     = nil;
    p.user_len = 0;

    p.target = d.target;
    if (sel d.target.some) {
        val target: *RenderTarget = d.target.some;
        p.width  = target.width;
        p.height = target.height;
        # PassDesc.clear selects the pass, and until now it did not: the target
        # path always began the clearing pass, so a game asking to preserve
        # what was there had its target wiped and nothing said so.
        p.pass = target.pass;
        if (sel d.clear.none) { p.pass = target.pass_load; }
        p.targets       = render_target_count(target);
        p.compatibility = target.compatibility;
    }
    or {
        p.width         = r.width;
        p.height        = r.height;
        p.pass          = r.frame.pass;
        p.targets       = 1;
        p.compatibility = pass_compatibility_one(r.vk.color_format);
    }
    p.resumes = false;

    p.region_width  = p.width;
    p.region_height = p.height;
    p.view          = mat4_identity();
    p.visible       = rect(0.0, 0.0, p.width::f32, p.height::f32);
    if (sel d.view.scene) {
        p.view       = camera_view(d.view.scene);
        p.projection = camera_projection(d.view.scene);
    }
    or (sel d.view.world) {
        # The camera folds into the projection rather than riding in the view,
        # because the 2D program takes a single matrix: its vertices arrive
        # already placed, so there is no model transform to combine a separate
        # view with.
        p.projection = camera2d_matrix(d.view.world, p.width::f32, p.height::f32);
        p.visible    = camera2d_visible(d.view.world, p.width::f32, p.height::f32);
    }
    or {
        p.projection = mat4_orthographic(0.0, p.width::f32, p.height::f32, 0.0, 0.0 - 1.0, 1.0);
    }

    # Resolve what this pass can see, once. The frustum serves 3D draws and the
    # rectangle above serves 2D ones; both come out of the matrices just built,
    # so a pass with no camera still gets a correct answer from its fixed
    # projection.
    var vp: Mat4 = mat4_mul(?p.projection, ?p.view);
    p.frustum = frustum_from_matrix(?vp);
    ret p;
}

# restrict subsequent draws to a pixel viewport and matching scissor, preserving projection
#
# a region outside the pass is refused, counted in renderer_refused, and leaves
# the region as it was.
pub fun pass_set_region(p: *Pass, x: i32, y: i32, width: i32, height: i32) err[Error] {
    if (x < 0 || y < 0 || width <= 0 || height <= 0
        || width > p.width || height > p.height || x > p.width - width || y > p.height - height) {
        p.renderer.refused = p.renderer.refused + 1;
        ret err[Error].err{Error.renderer{RendererError.region{}}};
    }
    batch_flush(p);
    p.region_x      = x;
    p.region_y      = y;
    p.region_width  = width;
    p.region_height = height;
    ret err[Error].ok{};
}

# finish a pass
#
# an offscreen pass ends its target's render pass and resumes the window's;
# a window pass has nothing to unbind, because pipeline and descriptor state
# belong to the command buffer and are replaced by the next pass's binds
# rather than restored.
# ---
# p: the pass to end
pub fun pass_end(p: *Pass) {
    # Before anything else, and before the early return below: geometry still in
    # the batcher has been recorded nowhere, and a render pass that ends without
    # it drops it silently.
    batch_flush(p);

    if (sel p.target.none) { ret; }
    vk.vkCmdEndRenderPass(p.cmd);
    if (p.resumes) { frame_resume_pass(?p.renderer.frame, ?p.renderer.swap); }
}

# The world-space box a skinned mesh actually occupies this frame.
#
# A skinned mesh's vertices are placed by its joints, so the box it was authored
# in describes only its rest pose. Culling against that box makes a character
# who reaches, lunges or is flung by a ragdoll disappear at the edge of the
# screen while plainly still on it.
#
# The pose's joint matrices are already built for the palette upload, so this
# reuses them: the rest box is transformed by each joint and the results unioned.
# That is conservative rather than exact, since a vertex is a weighted blend of
# several joints and therefore lies inside the union of their transforms rather
# than at any one of them, so the box always contains the geometry and is never
# tighter than the truth.
fun skinned_bounds(m: *Mesh, pose: *Pose, model: *Mat4) Aabb {
    val n: usize = pose.count;
    if (n == 0) { ret aabb_transform(?m.bounds, model); }
    val joints: *Mat4 = pose_matrices(pose);

    var acc: Aabb  = aabb_empty();
    var i:   usize = 0;
    for (i < n) {
        var world: Mat4 = mat4_mul(model, ?joints[i]);
        var b:     Aabb = aabb_transform(?m.bounds, ?world);
        aabb_union(?acc, ?b);
        i = i + 1;
    }
    ret acc;
}

# take a uniform slot for one draw, counting a full ring as a dropped draw
fun take_slot(p: *Pass) opt[usize] {
    val s: opt[usize] = descriptors_take(?p.renderer.desc, ?p.renderer.vk);
    if (sel s.none) {
        p.renderer.dropped = p.renderer.dropped + 1;
    }
    ret s;
}

# Draw the open run of 2D geometry, if there is one.
#
# This is the only place 2D geometry is actually submitted. Every 2D draw call
# appends to the batcher and this issues the draw, so a sprite, a glyph and a
# UI panel all reach the GPU through one program, one pipeline and one buffer.
#
# One uniform slot per flush rather than per sprite is the whole point: the slot
# carries the pass projection, which is the same for every sprite in the run.
pub fun batch_flush(p: *Pass) {
    # THE BUILT-IN PROGRAMS WRITE ONE COLOUR OUTPUT, so their pipelines are
    # built for a single attachment and are not valid in a pass with more. A
    # multi-attachment pass is a deferred geometry pass and belongs to a game's
    # own Shader. Counting the refusal rather than submitting an invalid
    # pipeline is the difference between a reported drop and a device loss.
    # Only the built-in program is limited to one attachment. A game's own
    # shader declares its own outputs, so a multi-attachment pass is legal once
    # one is set.
    if (p.targets != 1 && sel p.shader2d.none) {
        if (p.batch.count != 0) { p.renderer.dropped = p.renderer.dropped + 1; }
        batch_reset(?p.batch);
        ret;
    }
    val r: *Renderer = p.renderer;
    if (!p.batch.open || p.batch.count == 0) {
        batch_reset(?p.batch);
        ret;
    }

    val count: u32           = p.batch.count;
    val first: u32           = p.batch.first;
    val block: usize         = p.batch.block;
    val tex:   opt[*Texture] = p.batch.texture;
    # The run is closed before anything that can fail, so an early return below
    # cannot leave it open to be drawn a second time by the next flush.
    batch_reset(?p.batch);

    val taken: opt[usize] = take_slot(p);
    if (sel taken.none) { ret; }
    val slot: usize = taken.some;

    var u: ScreenUniforms;
    u.projection = p.projection;
    # COUNTED, NOT SILENT. A draw whose uniforms could not be uploaded must not
    # be recorded, and refusing to record it is correct; saying nothing about it
    # is what made a stage that did not run indistinguishable from a shading
    # bug, because everything downstream then reads whatever its target already
    # held and no validation layer fires.
    if (!descriptors_write_slot(?r.desc, r.frame_index, slot, (?u):~*u8, $size_of(ScreenUniforms))) {
        r.dropped = r.dropped + 1;
        ret;
    }

    # The game's own block, exactly as the mesh path writes it.
    #
    # WITHOUT THIS A BATCHED DRAW READS AN UNDEFINED BINDING 4. pass_set_user
    # was honoured on the mesh path and silently dropped here, so a game shader
    # that took its lighting from the block drew with whatever the slot last
    # held. It is not a wrong picture that announces itself: a stage reading a
    # zeroed block still draws, still samples its textures, and still writes its
    # emissive, so what fails is only the part that depended on the block. In
    # examples/lighting the composite went black while the lamp, the bloom and
    # the deferred light target all stayed correct, which is the shape of bug
    # that survives a look at the screen.
    if (p.user != nil) {
        if (!descriptors_write_slot_at(?r.desc, r.frame_index, slot, USER_OFFSET,
            p.user, p.user_len)) {
            r.dropped = r.dropped + 1;
            ret;
        }
    }

    # No tint block: the colour is per vertex. Passing 0 for its size is what
    # tells the descriptor layer binding 2 is not part of this draw.
    var views2d:    [4]vk.ImageView;
    var samplers2d: [4]vk.Sampler;
    fill_views_batch(r, ?views2d[0], p.mat2d, tex);
    fill_samplers_mat(r, ?samplers2d[0], p.mat2d);
    # A set that was not written must not be bound: the shader would read
    # descriptors nothing filled. The answer used to be discarded here, which is
    # the same silence the uploads above had.
    if (!descriptors_bind_slot(?r.desc, ?r.vk, r.frame_index, slot,
        $size_of(ScreenUniforms)::u64, ?views2d[0], ?samplers2d[0],
        0, 0,
        storage_buffer(?r.store, r.frame_index),
        storage_capacity(?r.store, r.frame_index)::u64)) {
        r.dropped = r.dropped + 1;
        ret;
    }

    val pipe: res[*Pipeline, Error] = surface_pipeline(p, ?r.ui_format, PROGRAM_UI, p.shader2d);
    if (sel pipe.err) {
        r.dropped = r.dropped + 1;
        ret;
    }
    pipeline_bind_region(pipe.ok, p.cmd, p.region_x, p.region_y,
        p.region_width::u32, p.region_height::u32);
    if (!descriptors_bind(?r.desc, p.cmd, pipe.ok.layout, r.frame_index, slot)) {
        r.dropped = r.dropped + 1;
        ret;
    }

    var buf: vk.Buffer = stream_buffer(?r.stream, r.frame_index, block);
    if (buf == nil) {
        r.dropped = r.dropped + 1;
        ret;
    }
    var off: u64 = 0;
    vk.vkCmdBindVertexBuffers(p.cmd, 0, 1, ?buf, ?off);
    # firstVertex rather than a per-draw buffer offset, so every run sharing a
    # block shares one binding.
    vk.vkCmdDraw(p.cmd, count, 1, first, 0);
    r.draws = r.draws + 1;
}

# Add 2D geometry to the open run, drawing it first if it cannot be extended.
#
# The vertices are copied into the frame's arena, so the caller may reuse or
# free its buffer the moment this returns.
# ---
# p:            the open pass
# texture:      what these vertices sample, or none for the white texel
# vertices:     vertex data in the shared 2D layout
# vertex_count: how many vertices
fun batch_append(p: *Pass, texture: opt[*Texture], vertices: *u8, vertex_count: usize) {
    val r: *Renderer = p.renderer;
    if (vertex_count == 0) { ret; }

    if (batch_breaks(?p.batch, texture)) { batch_flush(p); }

    val stride: usize           = r.ui_format.stride::usize;
    val pushed: opt[StreamSpan] = stream_push(?r.stream, ?r.vk, r.frame_index, vertices,
        vertex_count * stride, stride);
    if (sel pushed.none) {
        # The arena is full for this frame. Counted as a dropped draw, so a
        # frame that outgrows the arena is a number a game can read rather than
        # geometry that quietly disappears.
        r.dropped = r.dropped + 1;
        ret;
    }
    val span: StreamSpan = pushed.some;

    # A push that did not land next to the open run means something else took
    # arena space in between, so the run has to be drawn as it stands and a new
    # one started here. Extending it across the gap would draw the intervening
    # geometry with this run's texture.
    if (p.batch.open && !batch_continues(?p.batch, span.block, span.first)) { batch_flush(p); }

    if (!p.batch.open) {
        p.batch.open    = true;
        p.batch.texture = texture;
        p.batch.block   = span.block;
        p.batch.first   = span.first;
        p.batch.count   = 0;
    }
    p.batch.count = p.batch.count + vertex_count::u32;
}

# submit a 3D mesh draw with a model transform
#
# writes the model-view-projection and model matrices into this draw's
# uniform slot, binds the mesh pipeline and the slot, and draws.
# ---
# p: the open pass
# m: the mesh to draw
# t: the model transform
pub fun pass_draw(p: *Pass, m: *Mesh, t: *Transform) {
    pass_draw_textured(p, m, t, opt[*Material].none{}, opt[*Texture].none{},
        vec4(1.0, 1.0, 1.0, 1.0), opt[*Pose].none{}, opt[*Shader].none{});
}

# submit a 3D mesh draw with a material
#
# the material supplies the base colour and the texture; the transform
# places the mesh.
# ---
# p:   the open pass
# m:   the mesh to draw
# mat: the material to draw with
# t:   the model transform
pub fun pass_draw_material(p: *Pass, m: *Mesh, mat: *Material, t: *Transform) {
    pass_draw_textured(p, m, t, opt[*Material].some{mat}, material_texture(mat), mat.base_color,
        opt[*Pose].none{}, opt[*Shader].none{});
}

# a texture, or the renderer's white texel in its absence
fun or_white(r: *Renderer, tex: opt[*Texture]) *Texture {
    if (sel tex.some) { ret tex.some; }
    ret ?r.white;
}

# Fill a draw's sampler views from a single texture: slot 0 is it, the rest are
# the renderer's white texel.
fun fill_views(r: *Renderer, out: *vk.ImageView, tex: opt[*Texture]) {
    out[0] = texture_view(or_white(r, tex));
    var i: usize = 1;
    for (i < MAX_SAMPLERS) {
        out[i] = texture_view(?r.white);
        i      = i + 1;
    }
}

# Fill a draw's sampler views from a material.
#
# An unfilled slot gets the renderer's white texel rather than being left unwritten,
# so a shader sampling a texture the material never set reads a known value
# instead of whatever the previous draw put in that descriptor set.
fun fill_views_mat(r: *Renderer, out: *vk.ImageView, mat: opt[*Material], fallback: opt[*Texture]) {
    if (sel mat.none) {
        fill_views(r, out, fallback);
        ret;
    }
    var i: usize = 0;
    for (i < MAX_SAMPLERS) {
        out[i] = texture_view(?r.white);
        i      = i + 1;
    }
    val m: *Material = mat.some;
    var n: usize     = m.texture_count::usize;
    if (n > MAX_SAMPLERS) { n = MAX_SAMPLERS; }
    i = 0;
    for (i < n) {
        out[i] = texture_view(m.textures[i].texture);
        i      = i + 1;
    }
    if (n == 0) { out[0] = texture_view(or_white(r, fallback)); }
}

# Fill a batched 2D run's sampler views.
#
# A TEXTURED RUN'S OWN TEXTURE OWNS BINDING 1. A batched run's UVs were
# normalised against the texture the sprites were pushed with, so a material
# whose first texture is a different sheet makes every vertex sample the right
# coordinates in the wrong atlas. The material supplies the companion channels
# at 5, 6 and 7; it does not get to replace the sheet the geometry was built
# for.
#
# AN UNTEXTURED RUN LEAVES BINDING 1 TO THE MATERIAL, and that is not a
# concession to it. pass_set_material is how a run whose sprites carry no
# texture of their own is given one: the sprites are pushed with nil, the
# material names the atlas, and binding 1 is the only place that atlas can
# arrive. Overriding it for such a run binds the renderer's white texel instead,
# because white is what an untextured run has already been defaulted to, and a
# shader sampling it reads 1.0 everywhere. That does not look like a missing
# texture, it looks like a saturated frame: examples/lighting wrote a white
# G-buffer and every check comparing two of its texels read 255.
#
# The run's texture stays optional to here, so an untextured run and a run that
# samples the white texel remain distinguishable where binding 1 is chosen.
# ---
# r:   the renderer, for its white texel
# out: MAX_SAMPLERS views to fill
# mat: the material bound on the pass, if any
# tex: the run's own texture, if it named one
fun fill_views_batch(r: *Renderer, out: *vk.ImageView, mat: opt[*Material], tex: opt[*Texture]) {
    if (sel mat.none) {
        fill_views(r, out, tex);
        ret;
    }
    fill_views_mat(r, out, mat, tex);
    if (sel tex.some) { out[0] = texture_view(tex.some); }
}

# Fill the sampler array parallel to a draw's image views.
fun fill_samplers_mat(r: *Renderer, out: *vk.Sampler, mat: opt[*Material]) {
    var i: usize = 0;
    for (i < MAX_SAMPLERS) {
        out[i] = r.nearest;
        i      = i + 1;
    }
    if (sel mat.none) { ret; }
    val m: *Material = mat.some;
    var n: usize     = m.texture_count::usize;
    if (n > MAX_SAMPLERS) { n = MAX_SAMPLERS; }
    i = 0;
    for (i < n) {
        if (sel m.textures[i].filter.linear) { out[i] = r.linear; }
        i = i + 1;
    }
}

# write the descriptors shared by every shaded 3D surface
fun write_surface_slot(p: *Pass, slot: usize, mat: opt[*Material], tex: opt[*Texture],
    tint: Vec4) bool {
    val r:     *Renderer = p.renderer;
    var basec: TintUniforms;
    basec.colour = tint;
    if (!descriptors_write_slot_at(?r.desc, r.frame_index, slot, COLOUR_OFFSET,
        (?basec):~*u8, $size_of(TintUniforms))) {
        ret false;
    }
    if (p.user != nil) {
        if (!descriptors_write_slot_at(?r.desc, r.frame_index, slot, USER_OFFSET,
            p.user, p.user_len)) {
            ret false;
        }
    }

    var views:    [4]vk.ImageView;
    var samplers: [4]vk.Sampler;
    fill_views_mat(r, ?views[0], mat, tex);
    fill_samplers_mat(r, ?samplers[0], mat);
    ret descriptors_bind_slot(?r.desc, ?r.vk, r.frame_index, slot,
        $size_of(SkinnedUniforms)::u64, ?views[0], ?samplers[0],
        COLOUR_OFFSET::u64, $size_of(TintUniforms)::u64,
        storage_buffer(?r.store, r.frame_index),
        storage_capacity(?r.store, r.frame_index)::u64);
}

# the pipeline for this pass and vertex layout: a game's shader, or the built-in program
fun surface_pipeline(p: *Pass, format: *VertexFormat, program: Program,
    sh: opt[*Shader]) res[*Pipeline, Error] {
    val r: *Renderer = p.renderer;
    if (sel sh.some) {
        ret shader_pipeline(sh.some, ?r.vk, p.pass, ?p.compatibility, format, p.depth);
    }
    ret cache_get(?r.pipes, ?r.vk, p.pass, ?p.compatibility, program, format, p.depth);
}

# bind the pipeline cached for this pass and vertex layout
fun bind_surface_pipeline(p: *Pass, format: *VertexFormat, program: Program,
    sh: opt[*Shader], slot: usize) bool {
    val r:    *Renderer             = p.renderer;
    val pipe: res[*Pipeline, Error] = surface_pipeline(p, format, program, sh);
    if (sel pipe.err) { ret false; }
    pipeline_bind_region(pipe.ok, p.cmd, p.region_x, p.region_y,
        p.region_width::u32, p.region_height::u32);
    ret descriptors_bind(?r.desc, p.cmd, pipe.ok.layout, r.frame_index, slot);
}

# Draw the 2D runs that follow with a game's own shader.
#
# None restores the built-in program. Flushes first, so the run already open is
# drawn with the program it was pushed for.
pub fun pass_set_shader(p: *Pass, sh: opt[*Shader]) {
    if (same_shader(p.shader2d, sh)) { ret; }
    batch_flush(p);
    p.shader2d = sh;
}

fun same_shader(a: opt[*Shader], b: opt[*Shader]) bool {
    if (sel a.some) { ret sel b.some && b.some == a.some; }
    ret sel b.none;
}

fun same_material(a: opt[*Material], b: opt[*Material]) bool {
    if (sel a.some) { ret sel b.some && b.some == a.some; }
    ret sel b.none;
}

# Bind a material's textures on the 2D runs that follow, rather than the single
# texture a sprite carries.
#
# The sprite's own texture stays the first binding, so a material supplying only
# companion channels does not have to repeat it. A run whose sprites were pushed
# without a texture has none to keep, and takes the material's first binding
# instead, which is how such a run names its atlas at all.
pub fun pass_set_material(p: *Pass, mat: opt[*Material]) {
    if (same_material(p.mat2d, mat)) { ret; }
    batch_flush(p);
    p.mat2d = mat;
}

# Set the game's own uniform block for the draws that follow.
#
# WHY THIS EXISTS. boom's built-in shading is a default, not a system: a game
# that wants its own lighting, its own fog, its own anything supplies a Shader,
# and a shader whose parameters are baked in at compile time is not useful. This
# is where a light direction, a colour, a time value or whatever else the game's
# shader reads comes from. It arrives at binding 4.
#
# BORROWED UNTIL THE NEXT DRAW, then copied. The bytes are read at each
# following draw rather than now, so a game may fill one struct, draw, change
# it, and draw again, and each draw sees what the struct held when it was
# submitted. The pointer must stay valid until the last draw that uses it.
#
# pass_clear_user clears it, and the following draws read an undefined block if
# their shader declares binding 4.
#
# TOO LARGE IS COUNTED AS WELL AS REFUSED. A game that ignores the answer used
# to get nothing at all: the block was not set, the draws that followed read
# whatever the slot last held, and the picture was wrong in a way that looked
# like the shading rather than like a budget. renderer_refused reports it, and
# renderer_storage_write is where a payload that does not fit belongs.
# ---
# p:    the open pass
# data: the block's bytes
# len:  its length, at most USER_BYTES
# ret:  ok, or user_block when the block is empty or larger than a slot's user
#       region, in which case nothing is set and the draws that follow are
#       unaffected
pub fun pass_set_user(p: *Pass, data: *u8, len: usize) err[Error] {
    if (len == 0 || len > USER_BYTES) {
        p.renderer.refused = p.renderer.refused + 1;
        ret err[Error].err{Error.renderer{RendererError.user_block{len}}};
    }
    p.user     = data;
    p.user_len = len;
    ret err[Error].ok{};
}

# Clear the game's own uniform block for the draws that follow.
pub fun pass_clear_user(p: *Pass) {
    p.user     = nil;
    p.user_len = 0;
}

# Submit a mesh drawn with the game's own shader.
#
# Everything else is as pass_draw_material: the material supplies the texture and
# the base colour, the transform places the mesh, and the draw is culled against
# the pass frustum. Only the program differs, and with it whatever the game's
# fragment stage does with the block set by pass_set_user.
#
# The pipeline for this mesh's vertex layout and this pass is built on the first
# draw that needs it and reused afterwards, so the first frame a shader appears
# in is more expensive than the rest.
# ---
# p:   the open pass
# m:   the mesh to draw
# mat: the material to draw with
# t:   the model transform
# sh:  the game's shader
pub fun pass_draw_shaded(p: *Pass, m: *Mesh, mat: *Material, t: *Transform, sh: *Shader) {
    pass_draw_textured(p, m, t, opt[*Material].some{mat}, material_texture(mat), mat.base_color,
        opt[*Pose].none{}, opt[*Shader].some{sh});
}

# submit static meshes that share one shaded surface state
#
# this is the static-world counterpart to pass_draw_shaded. one transform,
# material, shader, descriptor slot, and pipeline bind serve every mesh in the
# array. each mesh still owns its buffers and bounds, so boom can cull and draw
# the visible members independently without making the game merge unrelated
# resource lifetimes.
#
# every mesh must use the same unskinned vertex layout. a mixed-layout batch is
# refused as a whole because its one bound pipeline cannot describe two vertex
# streams. use another batch for another layout or surface state.
#
# the mesh pointer array is borrowed for this call. meshes and their backing
# buffers remain owned by the caller.
# ---
# p:          the open pass
# meshes:     pointers to meshes sharing the batch state
# mesh_count: number of pointers
# mat:        the shared material
# t:          the shared model transform
# sh:         the shared game shader
pub fun pass_draw_shaded_batch(p: *Pass, meshes: **Mesh, mesh_count: usize,
    mat: *Material, t: *Transform, sh: *Shader) {
    if (mesh_count == 0) { ret; }
    val r: *Renderer = p.renderer;
    if (!shaded_batch_valid(meshes, mesh_count, mat, t, sh)) {
        r.dropped = r.dropped + mesh_count;
        ret;
    }

    # preserve submission order with any open 2D run before binding the shared
    # surface state.
    batch_flush(p);

    var model:   Mat4  = transform_matrix(t);
    var visible: usize = 0;
    var i:       usize = 0;
    for (i < mesh_count) {
        val m: *Mesh = meshes[i];
        if (!p.cull) { visible = visible + 1; }
        or {
            var world_bounds: Aabb = aabb_transform(?m.bounds, ?model);
            if (frustum_contains_aabb(?p.frustum, ?world_bounds)) {
                visible = visible + 1;
            }
            or { r.culled = r.culled + 1; }
        }
        i = i + 1;
    }
    if (visible == 0) { ret; }

    val taken: opt[usize] = take_slot(p);
    if (sel taken.none) {
        # take_slot counted one refused slot. the remaining visible meshes are
        # absent for the same refusal and belong in the draw count too.
        if (visible > 1) { r.dropped = r.dropped + visible - 1; }
        ret;
    }
    val slot: usize = taken.some;

    var vp:       Mat4 = mat4_mul(?p.projection, ?p.view);
    var mvp:      Mat4 = mat4_mul(?vp, ?model);
    var uniforms: MeshUniforms;
    uniforms.mvp   = mvp;
    uniforms.model = model;
    if (!descriptors_write_slot(?r.desc, r.frame_index, slot,
        (?uniforms):~*u8, $size_of(MeshUniforms))) {
        r.dropped = r.dropped + visible;
        ret;
    }
    if (!write_surface_slot(p, slot, opt[*Material].some{mat}, material_texture(mat), mat.base_color)) {
        r.dropped = r.dropped + visible;
        ret;
    }
    if (!bind_surface_pipeline(p, ?meshes[0].format, PROGRAM_MESH, opt[*Shader].some{sh}, slot)) {
        r.dropped = r.dropped + visible;
        ret;
    }

    i = 0;
    for (i < mesh_count) {
        val m:    *Mesh = meshes[i];
        var draw: bool  = true;
        if (p.cull) {
            var world_bounds: Aabb = aabb_transform(?m.bounds, ?model);
            draw = frustum_contains_aabb(?p.frustum, ?world_bounds);
        }
        if (draw) {
            mesh_draw(m, p.cmd);
            r.draws = r.draws + 1;
        }
        i = i + 1;
    }
}

fun shaded_batch_valid(meshes: **Mesh, mesh_count: usize, mat: *Material,
    t: *Transform, sh: *Shader) bool {
    if (meshes == nil || mesh_count == 0 || mat == nil || t == nil || sh == nil) {
        ret false;
    }
    val first: *Mesh = meshes[0];
    if (first == nil || first.format.stride == 0
        || vertex_format_is_skinned(?first.format)) {
        ret false;
    }
    var i: usize = 1;
    for (i < mesh_count) {
        val m: *Mesh = meshes[i];
        if (m == nil || !vertex_format_eq(?first.format, ?m.format)) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

test "renderer: a shaded mesh batch has one vertex layout" {
    var a: Mesh;
    var b: Mesh;
    a.format = vertex_format_standard();
    b.format = vertex_format_standard();
    var meshes: [2]*Mesh;
    meshes[0] = ?a;
    meshes[1] = ?b;
    var mat:       Material;
    var transform: Transform = transform_identity();
    var shader:    Shader;

    if (!shaded_batch_valid(?meshes[0], 2, ?mat, ?transform, ?shader)) { ret 1; }
    b.format = vertex_format_ui();
    if (shaded_batch_valid(?meshes[0], 2, ?mat, ?transform, ?shader)) { ret 2; }
    b.format = vertex_format_skinned();
    a.format = vertex_format_skinned();
    if (shaded_batch_valid(?meshes[0], 2, ?mat, ?transform, ?shader)) { ret 3; }
    meshes[1] = nil;
    if (shaded_batch_valid(?meshes[0], 2, ?mat, ?transform, ?shader)) { ret 4; }
    ret 0;
}

# submit dynamic non-indexed 3D triangles through a game shader
pub fun pass_draw_shaded_triangles(p: *Pass, vertices: ptr, vertex_count: i32,
    format: *VertexFormat, local_bounds: *Aabb,
    mat: *Material, t: *Transform, sh: *Shader) {
    val r: *Renderer = p.renderer;
    if (vertex_count <= 0) { ret; }
    if (!dynamic_triangles_valid(vertices, vertex_count, format, local_bounds,
        mat, t, sh)) {
        r.dropped = r.dropped + 1;
        ret;
    }

    batch_flush(p);
    var model: Mat4 = transform_matrix(t);
    if (!dynamic_bounds_visible(p, local_bounds, ?model)) {
        r.culled = r.culled + 1;
        ret;
    }

    val stride: usize           = format.stride::usize;
    val pushed: opt[StreamSpan] = stream_push(?r.stream, ?r.vk, r.frame_index, vertices:~*u8,
        vertex_count::usize * stride, stride);
    if (sel pushed.none) {
        r.dropped = r.dropped + 1;
        ret;
    }
    val span: StreamSpan = pushed.some;

    val taken: opt[usize] = take_slot(p);
    if (sel taken.none) { ret; }
    val slot: usize = taken.some;

    var vp:       Mat4 = mat4_mul(?p.projection, ?p.view);
    var mvp:      Mat4 = mat4_mul(?vp, ?model);
    var uniforms: MeshUniforms;
    uniforms.mvp   = mvp;
    uniforms.model = model;
    if (!descriptors_write_slot(?r.desc, r.frame_index, slot,
        (?uniforms):~*u8, $size_of(MeshUniforms))) {
        r.dropped = r.dropped + 1;
        ret;
    }
    if (!write_surface_slot(p, slot, opt[*Material].some{mat}, material_texture(mat),
        mat.base_color)) {
        r.dropped = r.dropped + 1;
        ret;
    }
    if (!bind_surface_pipeline(p, format, PROGRAM_MESH, opt[*Shader].some{sh}, slot)) {
        r.dropped = r.dropped + 1;
        ret;
    }

    var buffer: vk.Buffer = stream_buffer(?r.stream, r.frame_index, span.block);
    if (buffer == nil) {
        r.dropped = r.dropped + 1;
        ret;
    }
    var offset: u64 = 0;
    vk.vkCmdBindVertexBuffers(p.cmd, 0, 1, ?buffer, ?offset);
    vk.vkCmdDraw(p.cmd, vertex_count::u32, 1, span.first, 0);
    r.draws = r.draws + 1;
}

fun dynamic_triangles_valid(vertices: ptr, vertex_count: i32,
    format: *VertexFormat, local_bounds: *Aabb,
    mat: *Material, t: *Transform, sh: *Shader) bool {
    ret vertices != nil && vertex_count > 0 && (vertex_count % 3) == 0
        && format != nil && format.stride != 0 && local_bounds != nil
        && mat != nil && t != nil && sh != nil;
}

fun dynamic_bounds_visible(p: *Pass, local_bounds: *Aabb,
    model: *Mat4) bool {
    if (!p.cull) { ret true; }
    var world_bounds: Aabb = aabb_transform(local_bounds, model);
    ret frustum_contains_aabb(?p.frustum, ?world_bounds);
}

# Submit a skinned mesh drawn with the game's own shader.
#
# The shader's vertex stage must read the joint palette at binding 3 and place
# the vertex by it, as the built-in skinned stage does; a shader that ignores it
# draws the mesh in its rest pose rather than failing.
# ---
# p:    the open pass
# m:    the skinned mesh to draw
# mat:  the material to draw with
# pose: the pose whose joint matrices place the vertices
# t:    the model transform
# sh:   the game's shader
pub fun pass_draw_shaded_skinned(p: *Pass, m: *Mesh, mat: *Material, pose: *Pose, t: *Transform, sh: *Shader) {
    pass_draw_textured(p, m, t, opt[*Material].some{mat}, material_texture(mat), mat.base_color,
        opt[*Pose].some{pose}, opt[*Shader].some{sh});
}

# the shared body of the mesh draws, skinned and not
#
# no pose is an unskinned draw. the two differ in which program they use,
# what goes in the uniform block, and whether a joint palette is uploaded, but
# share the texture binding, the base colour, and the slot bookkeeping, so
# splitting them would duplicate the parts that are easy to get subtly wrong.
#
# no shader draws through the built-in program for the mesh; a shader replaces
# only the program, so a game's own shading gets the same culling, slot
# handling, texture binding and palette upload as a built-in draw.
fun pass_draw_textured(p: *Pass, m: *Mesh, t: *Transform, mat: opt[*Material], tex: opt[*Texture],
    tint: Vec4, pose: opt[*Pose], sh: opt[*Shader]) {
    # See batch_flush: only a game's own Shader can write a multi-attachment
    # pass, because the built-in programs declare one output.
    if (p.targets != 1 && sel sh.none) {
        p.renderer.dropped = p.renderer.dropped + 1;
        ret;
    }
    val r: *Renderer = p.renderer;

    # Any open 2D run has to be drawn before this mesh, or it would be recorded
    # after and appear on top of geometry the caller submitted first. The
    # batcher can defer a sprite past another sprite because it then draws them
    # in order; it cannot defer one past a draw it does not own.
    batch_flush(p);

    var model: Mat4 = transform_matrix(t);

    # OUT OF VIEW, SO NOT SUBMITTED. Done before the slot is taken, since a
    # culled draw that still consumed a uniform slot would starve the draws that
    # are visible, which is the failure this renderer already had once.
    #
    # A skinned mesh is bounded by its pose rather than by its rest position: a
    # character reaching up or a ragdoll flung sideways leaves the box the mesh
    # was authored in, and culling against that box pops it out of view at the
    # edges of the screen while it is plainly still on them.
    if (p.cull) {
        var wb: Aabb = aabb_transform(?m.bounds, ?model);
        if (sel pose.some) { wb = skinned_bounds(m, pose.some, ?model); }
        if (!frustum_contains_aabb(?p.frustum, ?wb)) {
            r.culled = r.culled + 1;
            ret;
        }
    }

    val taken: opt[usize] = take_slot(p);
    if (sel taken.none) { ret; }
    val slot: usize = taken.some;

    # A pose is only usable on geometry that carries joints and weights. Drawing
    # an unskinned mesh through the skinned program leaves those two vertex
    # inputs with no attribute behind them, which is invalid vertex input rather
    # than a mesh that ignores its pose.
    val skinned: bool = sel pose.some && vertex_format_is_skinned(?m.format);

    var vp: Mat4 = mat4_mul(?p.projection, ?p.view);

    if (skinned) {
        var su: SkinnedUniforms;
        su.view_proj = vp;
        su.model     = model;
        # Counted for the reason batch_flush's is: a draw refused for a failed
        # upload is a draw that does not appear, and one that says nothing looks
        # exactly like a shading bug from outside.
        if (!descriptors_write_slot(?r.desc, r.frame_index, slot, (?su):~*u8, $size_of(SkinnedUniforms))) {
            r.dropped = r.dropped + 1;
            ret;
        }
    }
    or {
        # The unskinned shader reads one matrix, so the view and projection are
        # folded in here rather than uploaded separately. The model matrix is
        # kept whole because the normal is transformed by it alone.
        var mvp: Mat4 = mat4_mul(?vp, ?model);
        var u:   MeshUniforms;
        u.mvp   = mvp;
        u.model = model;
        if (!descriptors_write_slot(?r.desc, r.frame_index, slot, (?u):~*u8, $size_of(MeshUniforms))) {
            r.dropped = r.dropped + 1;
            ret;
        }
    }

    if (!write_surface_slot(p, slot, mat, tex, tint)) {
        r.dropped = r.dropped + 1;
        ret;
    }

    var program: Program = PROGRAM_MESH;
    if (sel pose.some) {
        if (skinned) {
            program = PROGRAM_SKINNED;

            val pal: opt[usize] = descriptors_take_palette(?r.desc, ?r.vk, r.frame_index);
            if (sel pal.none) {
                r.dropped = r.dropped + 1;
                ret;
            }
            # The pose's matrices are already column-major Mat4 values, and std430
            # gives the shader's array of columns a natural 16-byte stride, so the
            # palette uploads as a copy rather than a repack.
            if (!descriptors_write_palette(?r.desc, r.frame_index, pal.some,
                (pose_matrices(pose.some)):~*u8, MAX_JOINTS * 64)) {
                r.dropped = r.dropped + 1;
                ret;
            }
            # A skinned draw whose binding 3 was not written reads a palette nothing
            # filled, which places the character by whatever the descriptor held.
            if (!descriptors_bind_palette(?r.desc, ?r.vk, r.frame_index, slot, pal.some)) {
                r.dropped = r.dropped + 1;
                ret;
            }
        }
    }

    if (!bind_surface_pipeline(p, ?m.format, program, sh, slot)) {
        r.dropped = r.dropped + 1;
        ret;
    }
    mesh_draw(m, p.cmd);
    r.draws = r.draws + 1;
}

# submit a skinned mesh draw
#
# uploads the pose's joint matrices into a palette slot and draws through the
# skinned program, which places each vertex by its four weighted joints before
# applying the model, view and projection.
#
# a mesh whose vertex layout carries no joints or weights is drawn unskinned
# rather than through a program whose vertex inputs it cannot satisfy.
# ---
# p:    the open pass
# m:    the skinned mesh to draw
# pose: the pose whose joint matrices place the vertices
# t:    the model transform
pub fun pass_draw_skinned(p: *Pass, m: *Mesh, pose: *Pose, t: *Transform) {
    pass_draw_textured(p, m, t, opt[*Material].none{}, opt[*Texture].none{},
        vec4(1.0, 1.0, 1.0, 1.0), opt[*Pose].some{pose}, opt[*Shader].none{});
}

# submit a skinned mesh draw with a material
# ---
# p:    the open pass
# m:    the skinned mesh to draw
# mat:  the material to draw with
# pose: the pose whose joint matrices place the vertices
# t:    the model transform
pub fun pass_draw_skinned_material(p: *Pass, m: *Mesh, mat: *Material, pose: *Pose, t: *Transform) {
    pass_draw_textured(p, m, t, opt[*Material].some{mat}, material_texture(mat), mat.base_color,
        opt[*Pose].some{pose}, opt[*Shader].none{});
}

# submit a 2D sprite draw covering a whole texture
# ---
# p:       the open pass
# texture: the texture to draw, or none for the white texel or the pass material's atlas
# dest:    the destination rectangle in pixels
# tint:    the color multiplied into the texture
pub fun pass_draw_sprite(p: *Pass, texture: opt[*Texture], dest: Rect, tint: Vec4) {
    pass_draw_sprite_uv(p, texture, dest, rect(0.0, 0.0, 1.0, 1.0), tint);
}

# submit a 2D sprite draw of a sub-rectangle of a texture
# ---
# p:       the open pass
# texture: the texture to sample, or none for the white texel or the pass
#          material's atlas, which is how a solid rectangle and a sprite named
#          only by pass_set_material are drawn
# dest:    the destination rectangle in pixels
# src:     the source rectangle in texture space, 0 to 1
# tint:    the color multiplied into the sample
pub fun pass_draw_sprite_uv(p: *Pass, texture: opt[*Texture], dest: Rect, src: Rect, tint: Vec4) {
    # Expanded to two triangles and appended to the open run rather than drawn.
    # A run of sprites sharing a texture becomes one draw and one uniform slot,
    # which is what lets a screenful of them cost what a handful used to. See
    # boom.graphics.batch for why the per-sprite uniform had to go.
    # Off screen, so not expanded. Checked before sprite_expand rather than
    # after, because the cost this avoids is the six vertices in the frame's
    # arena, not the draw: a large world is mostly off screen, and expanding all
    # of it fills the arena with geometry nothing can see.
    if (p.cull && !rect_overlaps(dest, p.visible)) {
        p.renderer.culled = p.renderer.culled + 1;
        ret;
    }

    var v: [48]f32;
    sprite_expand(dest, src, tint, ?v[0]);
    batch_append(p, texture, (?v[0]):~*u8, SPRITE_VERTICES);
}

# submit a whole tile field as one run of quads
#
# WHY THIS IS NOT A LOOP OVER pass_draw_sprite_uv. It is the same expansion into
# the same batch, and the difference is which cells are visited at all. A sprite
# is an arbitrary rectangle, so the sprite path can only cull it by testing it
# against the visible rectangle, and a game looping over its own grid therefore
# pays for every cell of the world every frame. A cell's position is implied by
# its index, so the view converts into a column and a row range once and the
# loops are bounded by that. A field the camera has left costs nothing at all.
#
# THE CELLS OFF SCREEN ARE NOT COUNTED AS CULLED, because they are never
# considered. renderer_culled reports draws the renderer looked at and refused,
# and adding a number here would mean walking the whole grid to compute it,
# which is the work this exists to avoid. tilemap_span_cells tells a game how
# much of its field a frame visited.
#
# Cells holding TILE_EMPTY and cells whose index is past the sheet's frame array
# are skipped. See boom.graphics.tilemap for why a malformed map draws holes
# rather than being refused as a whole.
# ---
# p:     the open pass
# layer: the grid, borrowed and read now
# sheet: the frames the indices address
# tint:  the colour multiplied into every tile
pub fun pass_draw_tilemap(p: *Pass, layer: *TileLayer, sheet: *TileSheet, tint: Vec4) {
    if (layer == nil || sheet == nil || layer.tiles == nil) { ret; }

    var span: TileSpan;
    if (p.cull) { span = tilemap_span(layer, p.visible); }
    or          { span = tilemap_all(layer); }

    # Expanded in chunks rather than a tile at a time, because an append is a
    # push into the frame's arena and a run check, and a grid is the one case
    # where the caller already knows the next quad continues the same run. The
    # staging buffer is a stack array, so it is fixed at TILEMAP_CHUNK tiles and
    # the span is walked across as many chunks as it needs.
    var v:   [1536]f32;
    var cur: TileCursor = tile_cursor(?span);
    for (!tilemap_done(?cur, ?span)) {
        val n: usize = tilemap_expand(layer, sheet, ?span, ?cur, tint, ?v[0], TILEMAP_CHUNK);
        if (n > 0) { batch_append(p, sheet.texture, (?v[0]):~*u8, n * SPRITE_VERTICES); }
    }
}

# submit a stream of already-placed, per-vertex-coloured triangles
#
# WHAT THIS IS FOR. An immediate-mode UI (blit), a particle system, or a debug
# overlay produces a whole draw list of triangles that are already in the right
# place, each with its own colour, and rebuilds it from scratch every frame. A
# sprite draw cannot express that: it is one rectangle placed by a model matrix,
# so a thousand UI quads would be a thousand draws and a thousand uniform slots.
#
# The vertices are copied into the frame's arena and drawn non-indexed, so the
# caller may reuse or free its buffer the moment this returns. The layout is
# boom.graphics.vertex.vertex_format_ui: position in pixels, uv, then rgba,
# eight f32 at a 32-byte stride, which is exactly what blit emits.
#
# The pass's projection is what maps those pixels to clip space, so a call in an
# overlay pass places geometry in window pixels and one in a scene pass places it
# in world units.
#
# A count that is not a multiple of three is refused: a partial triangle is a
# caller bug, and passing it on draws whatever the arena held next.
# ---
# p:            the open pass
# vertices:     the vertex data, vertex_count * 32 bytes
# vertex_count: how many vertices, a multiple of 3
# texture:      the atlas the uvs address, or none for the renderer's white texel
pub fun pass_draw_triangles(p: *Pass, vertices: ptr, vertex_count: i32, texture: opt[*Texture]) {
    val r: *Renderer = p.renderer;
    if (vertex_count <= 0) { ret; }
    if ((vertex_count % 3) != 0) {
        r.dropped = r.dropped + 1;
        ret;
    }
    # Appended to the same run sprites use. A draw list and a sprite are the
    # same thing to the batcher, so UI drawn over sprites from the same atlas
    # coalesces into one draw instead of breaking the run.
    batch_append(p, texture, vertices:~*u8, vertex_count::usize);
}

# how many draws this frame's vertex arena refused for want of room
#
# Separate from renderer_dropped, which counts uniform slots: they run out for
# different reasons and the fix is different. A game raising STREAM_BYTES when
# it should be raising MAX_SLOTS has read the wrong number.
pub fun renderer_stream_dropped(r: *Renderer) usize {
    ret stream_dropped(?r.stream);
}

# How many arena blocks the current frame has grown to.
#
# One means the frame fits in the base reservation. A number that climbs over
# the first few frames and then holds is the arena finding the game's high-water
# mark, which is the intended behaviour. A number that keeps climbing is a leak
# in whatever builds the frame's geometry.
pub fun renderer_stream_blocks(r: *Renderer) usize {
    ret stream_blocks(?r.stream, r.frame_index);
}

# Bytes the current frame's arena has reserved, across its blocks.
#
# This is what the arena costs in host-visible memory. It only ever grows, so it
# reports the heaviest frame the game has drawn rather than the current one.
pub fun renderer_stream_reserved(r: *Renderer) usize {
    ret stream_reserved(?r.stream, r.frame_index);
}

# fill this frame's storage buffer, which every draw in the frame reads
#
# WHAT THIS IS FOR. A draw's own parameters go in the block pass_set_user
# delivers, which is one aligned range and therefore sixteen vec4s. A list does
# not fit that shape: a traced light is two vec4, so six lights fit after a
# header, and a scene with lamps, hostiles and projectiles is forty. This is
# where that list goes. It arrives at binding 8, under std430 rather than
# std140, as one buffer the whole frame shares.
#
# ONE BUFFER, NOT A COPY PER DRAW, which is the whole point and is also the one
# thing to hold in mind. The bytes are not snapshotted per draw the way the user
# block is: every draw in the frame, including draws already recorded, reads
# whatever the buffer holds when the frame executes. Fill it once as the frame
# opens. Per-draw values belong in the user block; the array both draws index
# into belongs here.
#
# ONLY WITH A FRAME OPEN. Between frames the GPU may still be reading this
# frame's buffer, and the fence that proves otherwise is waited on inside
# renderer_begin_frame. A write before that is a data race whose symptom is a
# list that flickers between two frames' contents under load.
#
# The buffer grows to fit and keeps what it grew to, so a game that writes a
# larger payload than last frame is not refused; see renderer_storage_reserve
# for why a game may still want to say the size up front.
# ---
# r:   the renderer, with a frame open
# src: the bytes to copy
# len: how many
# ret: ok, or why nothing was written; a buffer that could not grow is also
#      counted by renderer_storage_refused
pub fun renderer_storage_write(r: *Renderer, src: *u8, len: usize) err[Error] {
    ret renderer_storage_write_at(r, 0, src, len);
}

# fill part of this frame's storage buffer, at a byte offset
#
# For a game packing several arrays into the one buffer: a header at 0, a light
# list after it, a decal list after that. The offset is a byte offset and the
# layout is the game's business, exactly as it is for the user block, so what it
# has to match is what the shader declares under std430.
#
# Everything renderer_storage_write says applies here, including that the buffer
# is the frame's rather than the draw's.
# ---
# r:      the renderer, with a frame open
# offset: where in the buffer the bytes go
# src:    the bytes to copy
# len:    how many
pub fun renderer_storage_write_at(r: *Renderer, offset: usize, src: *u8, len: usize) err[Error] {
    if (!r.drawing) { ret err[Error].err{Error.renderer{RendererError.no_frame{}}}; }
    ret storage_write(?r.store, ?r.vk, r.frame_index, offset, src, len);
}

# grow every frame's storage buffer to at least this many bytes
#
# WHY A GAME CALLS THIS. The descriptor's range is the buffer's whole capacity,
# so it is also the largest storage block a shader may legally declare. A game
# whose shader declares an array of 256 lights but whose scene currently holds
# four writes far less than it declares, and the capacity has to be reserved
# rather than discovered: a block larger than the range is invalid usage that
# the validation layers report and a driver may honour anyway, which is the
# shape of bug that works here and fails elsewhere.
#
# So a game reserves what its shader declares, once, at start-up. That also
# moves the allocation off the first frame that needs the room, which is the
# frame least able to afford it.
#
# Safe to call with no frame open, and with one: growing does not disturb the
# buffer the GPU is reading, because the one being replaced is retained.
# ---
# r:     the renderer
# bytes: the capacity to guarantee
# ret:   ok, or why the buffer could not grow, which renderer_storage_refused
#        also counts
pub fun renderer_storage_reserve(r: *Renderer, bytes: usize) err[Error] {
    if (!r.ready_store) { ret err[Error].err{Error.uninitialized{Stage.renderer{}}}; }
    ret storage_reserve(?r.store, ?r.vk, bytes);
}

# the current frame's storage capacity, in bytes
#
# Also the descriptor's range, and therefore the largest storage block a shader
# may declare. See renderer_storage_reserve.
pub fun renderer_storage_capacity(r: *Renderer) usize {
    ret storage_capacity(?r.store, r.frame_index);
}

# bytes written into the current frame's storage buffer this frame
#
# What the payload actually costs, against the capacity above. Rewound each
# frame, so this is the frame being recorded rather than a high-water mark.
pub fun renderer_storage_used(r: *Renderer) usize {
    ret storage_used(?r.store, r.frame_index);
}

# how many storage buffers the current frame has allocated over its life
#
# One in a game that reserved what it needed or never outgrew the starting size.
# A number that climbs while the game runs means the payload is still growing,
# and every step of that growth is a buffer retained until the renderer is torn
# down.
pub fun renderer_storage_buffers(r: *Renderer) usize {
    ret storage_buffers(?r.store, r.frame_index);
}

# writes refused because the storage buffer could not grow
#
# Zero in normal operation, and counted over the renderer's life rather than per
# frame so a game polling once at shutdown still sees them. Anything else means
# a shader read bytes the game believed it had written, which is otherwise
# indistinguishable from the shading being wrong.
pub fun renderer_storage_refused(r: *Renderer) usize {
    ret storage_refused(?r.store);
}

# --------------------------------------------------------------------- tests
#
# a renderer needs a device and a surface, so these cover the pure parts:
# the pass projections and the dropped-draw accounting.

use boom.graphics.vertex.VertexFormat;

test "renderer: an overlay pass maps pixels to clip space" {
    var r: Renderer;
    r.width  = 800;
    r.height = 600;
    var d: PassDesc = pass_overlay();
    var p: Pass     = pass_resolve(?r, ?d);

    # (0, 0) is the top-left corner, which is what a 2D game means by an
    # origin, and in Vulkan the top of the window is clip -1. The mapping is
    # asserted rather than the sign of an entry, because the sign depends on
    # both the flip in mat4_orthographic and the argument order here, and
    # getting one of the two wrong leaves the other looking right.
    if (p.width != 800 || p.height != 600) { ret 1; }

    val top:    f32 = p.projection.m[1][1] * 0.0 + p.projection.m[3][1];
    val bottom: f32 = p.projection.m[1][1] * 600.0 + p.projection.m[3][1];
    if (top + 1.0 > 0.0001 || top + 1.0 < 0.0 - 0.0001)       { ret 2; }
    if (bottom - 1.0 > 0.0001 || bottom - 1.0 < 0.0 - 0.0001) { ret 3; }

    val left:  f32 = p.projection.m[0][0] * 0.0 + p.projection.m[3][0];
    val right: f32 = p.projection.m[0][0] * 800.0 + p.projection.m[3][0];
    if (left + 1.0 > 0.0001 || left + 1.0 < 0.0 - 0.0001)   { ret 4; }
    if (right - 1.0 > 0.0001 || right - 1.0 < 0.0 - 0.0001) { ret 5; }
    ret 0;
}

test "renderer: a scene pass takes its matrices from the camera" {
    var r: Renderer;
    r.width  = 640;
    r.height = 480;
    var c: Camera;
    c.fov      = 1.0;
    c.aspect   = 1.333;
    c.near     = 0.1;
    c.far      = 100.0;
    c.position = vec3(0.0, 0.0, 5.0);
    c.target   = vec3(0.0, 0.0, 0.0);
    c.up       = vec3(0.0, 1.0, 0.0);

    # Resolved rather than begun: a Renderer with no device can answer for its
    # matrices and has no command buffer to record into.
    var d: PassDesc = pass_scene(?c);
    var p: Pass     = pass_resolve(?r, ?d);
    # An identity view would mean the camera position was ignored, which
    # draws the scene from the origin no matter where the camera is.
    if (p.view.m[3][2] == 0.0) { ret 1; }
    ret 0;
}

test "renderer: a reversed camera carries its depth convention into the pass" {
    var r: Renderer;
    r.width  = 640;
    r.height = 480;
    var c: Camera = camera_perspective_reversed_infinite(
        vec3(0.0, 0.0, 5.0), vec3(0.0, 0.0, 0.0),
        1.0, 1.333, 0.1);
    var d: PassDesc = pass_scene(?c);
    if (!sel d.depth.reversed) { ret 1; }

    var p: Pass = pass_resolve(?r, ?d);
    if (!sel p.depth.reversed) { ret 2; }

    val zn: f32 = (p.projection.m[2][2] * (0.0 - c.near)
        + p.projection.m[3][2]) / c.near;
    if (zn - 1.0 > 0.0001 || zn - 1.0 < 0.0 - 0.0001) { ret 3; }
    ret 0;
}

test "renderer: pass descriptions differ in what they clear and project" {
    var c:  Camera;
    var c2: Camera2D;
    val s:  PassDesc = pass_scene(?c);
    val o:  PassDesc = pass_overlay();
    val w:  PassDesc = pass_world(?c2);
    if (!sel s.view.scene)  { ret 1; }
    if (!sel o.view.pixels) { ret 2; }
    if (!sel w.view.world)  { ret 5; }
    # An overlay that cleared would erase the scene it is drawn over.
    if (!sel s.clear.some) { ret 3; }
    if (!sel o.clear.none) { ret 4; }
    if (!sel w.clear.none) { ret 6; }
    ret 0;
}

test "renderer: a mid-pass clear names every attachment and no aspect it lacks" {
    var atts: [5]vk.ClearAttachment;

    val one: usize = clear_attachments(1, vec4(0.25, 0.5, 0.75, 1.0),
        DepthConvention.forward{}, ?atts[0]);
    if (one != 2)                                        { ret 1; }
    if (atts[0].aspectMask != vk.IMAGE_ASPECT_COLOR_BIT) { ret 2; }
    if (atts[0].colorAttachment != 0)                    { ret 3; }
    if (atts[0].clearValue.color.float32[1] != 0.5)      { ret 4; }
    # DEPTH_FORMAT is D32_SFLOAT and has no stencil component, so naming the
    # stencil aspect would fail validation on every clearing window pass while
    # clearing nothing that exists.
    if (atts[1].aspectMask != vk.IMAGE_ASPECT_DEPTH_BIT) { ret 5; }
    if (atts[1].clearValue.depthStencil.depth != 1.0)    { ret 6; }

    # A pass with four sheets clears four. Clearing only the first would leave
    # the rest holding the previous frame, which is a picture, just the wrong one.
    val four: usize = clear_attachments(4, vec4(0.0, 0.0, 0.0, 1.0),
        DepthConvention.forward{}, ?atts[0]);
    if (four != 5)                                       { ret 7; }
    if (atts[3].aspectMask != vk.IMAGE_ASPECT_COLOR_BIT) { ret 8; }
    if (atts[3].colorAttachment != 3)                    { ret 9; }
    if (atts[4].aspectMask != vk.IMAGE_ASPECT_DEPTH_BIT) { ret 10; }
    ret 0;
}

test "renderer: reversed depth clears to zero" {
    var atts: [2]vk.ClearAttachment;
    if (clear_attachments(1, vec4(0.0, 0.0, 0.0, 1.0),
        DepthConvention.reversed{}, ?atts[0]) != 2) { ret 1; }
    if (atts[1].clearValue.depthStencil.depth != 0.0)        { ret 2; }
    if (depth_clear_value(DepthConvention.forward{}) != 1.0) { ret 3; }
    ret 0;
}

test "renderer: a full uniform ring drops draws and counts them" {
    # Slots grow a block at a time, so exhaustion now means the block ceiling is
    # reached or the device cannot supply one. Here there is no device, which is
    # the case that must still count rather than crash or wrap.
    var r: Renderer;
    r.dropped     = 0;
    r.vk.ready    = false;
    r.desc.ready  = true;
    r.desc.bcount = 1;
    r.desc.used   = SLOTS_PER_BLOCK;
    var p: Pass;
    p.renderer = ?r;

    # Silently drawing with a wrapped slot would give this draw another
    # draw's transform, so exhaustion has to be visible instead.
    val taken: opt[usize] = take_slot(?p);
    if (!sel taken.none) { ret 1; }
    if (r.dropped != 1)  { ret 2; }
    ret 0;
}

test "renderer: invalid dynamic 3D triangles are counted as dropped draws" {
    var r: Renderer;
    var p: Pass;
    p.renderer = ?r;

    var vertices: [24]f32;
    var format:   VertexFormat = vertex_format_standard();
    var bounds:   Aabb         = Aabb{
        min: vec3(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0),
        max: vec3(1.0, 1.0, 1.0),
    };
    var mat: Material;
    var t:   Transform = transform_identity();
    var sh:  Shader;

    pass_draw_shaded_triangles(?p, (?vertices[0])::ptr, 0, ?format,
        ?bounds, ?mat, ?t, ?sh);
    if (r.dropped != 0) { ret 1; }

    pass_draw_shaded_triangles(?p, (?vertices[0])::ptr, 4, ?format,
        ?bounds, ?mat, ?t, ?sh);
    if (r.dropped != 1) { ret 2; }

    pass_draw_shaded_triangles(?p, nil, 3, ?format,
        ?bounds, ?mat, ?t, ?sh);
    if (r.dropped != 2) { ret 3; }

    var empty_format: VertexFormat;
    pass_draw_shaded_triangles(?p, (?vertices[0])::ptr, 3, ?empty_format,
        ?bounds, ?mat, ?t, ?sh);
    if (r.dropped != 3) { ret 4; }

    pass_draw_shaded_triangles(?p, (?vertices[0])::ptr, 3, ?format,
        ?bounds, ?mat, ?t, nil);
    if (r.dropped != 4) { ret 5; }
    ret 0;
}

test "renderer: dynamic 3D bounds are transformed before culling" {
    var c: Camera;
    c.position = vec3(0.0, 0.0, 5.0);
    c.target   = vec3(0.0, 0.0, 0.0);
    c.up       = vec3(0.0, 1.0, 0.0);
    c.fov      = 1.0;
    c.aspect   = 1.0;
    c.near     = 0.1;
    c.far      = 100.0;

    var view:       Mat4 = camera_view(?c);
    var projection: Mat4 = camera_projection(?c);
    var vp:         Mat4 = mat4_mul(?projection, ?view);
    var p:          Pass;
    p.cull    = true;
    p.frustum = frustum_from_matrix(?vp);

    var bounds: Aabb = Aabb{
        min: vec3(0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0),
        max: vec3(1.0, 1.0, 1.0),
    };
    var t:     Transform = transform_identity();
    var model: Mat4      = transform_matrix(?t);
    if (!dynamic_bounds_visible(?p, ?bounds, ?model)) { ret 1; }

    t.position = vec3(1000.0, 0.0, 0.0);
    model      = transform_matrix(?t);
    if (dynamic_bounds_visible(?p, ?bounds, ?model)) { ret 2; }

    p.cull = false;
    if (!dynamic_bounds_visible(?p, ?bounds, ?model)) { ret 3; }
    ret 0;
}

test "renderer: a game block larger than a slot's region is refused, not truncated" {
    # Truncating would hand the shader a struct whose tail is whatever the last
    # draw left there, which shades wrongly rather than not at all, and does it
    # only for the fields past the cut. Refusing leaves the previous block in
    # place and reports it, so the caller finds out at the call that is wrong.
    var r: Renderer;
    r.refused = 0;
    var p: Pass;
    p.renderer = ?r;
    p.user     = nil;
    p.user_len = 0;
    var block: [512]u8;

    val oversized: err[Error] = pass_set_user(?p, ?block[0], USER_BYTES + 1);
    if (!sel oversized.err)               { ret 1; }
    if (!sel oversized.err.renderer)      { ret 10; }
    if (p.user != nil || p.user_len != 0) { ret 2; }
    # AND COUNTED. A caller that ignores the answer used to get no sign at all:
    # the draws that followed read whatever their slot's user region last held,
    # which looks like the shading being wrong rather than like a budget.
    if (renderer_refused(?r) != 1) { ret 7; }

    # A block of exactly the advertised size is accepted.
    val exact: err[Error] = pass_set_user(?p, ?block[0], USER_BYTES);
    if (!sel exact.ok)                                   { ret 3; }
    if (p.user != ?block[0] || p.user_len != USER_BYTES) { ret 4; }
    if (renderer_refused(?r) != 1)                       { ret 8; }

    # And clearing it is its own call rather than a zero-length block.
    pass_clear_user(?p);
    if (p.user != nil)             { ret 6; }
    if (renderer_refused(?r) != 1) { ret 9; }
    ret 0;
}

test "renderer: a storage write outside an open frame is refused" {
    # Between frames the GPU may still be reading the buffer this write would
    # land in, and the fence that proves otherwise is waited on inside
    # renderer_begin_frame. Allowing it would make a payload written from a
    # loading screen or a tick handler race the frame in flight, which flickers
    # under load and looks correct the moment the GPU catches up.
    var r: Renderer;
    r.drawing     = false;
    r.frame_index = 0;
    r.store.ready = true;
    var bytes: [64]u8;
    val whole: err[Error] = renderer_storage_write(?r, ?bytes[0], 64);
    if (!sel whole.err) { ret 1; }
    val at: err[Error] = renderer_storage_write_at(?r, 0, ?bytes[0], 64);
    if (!sel at.err) { ret 2; }
    ret 0;
}

test "renderer: reserving before the storage exists is refused, not a fault" {
    # A game may reserve at start-up, and start-up is also where a renderer that
    # failed to come up is still zeroed. Reaching for a device through it would
    # be a fault rather than an answer.
    var r: Renderer;
    r.ready_store = false;
    val reserved: err[Error] = renderer_storage_reserve(?r, 4096);
    if (!sel reserved.err) { ret 1; }
    ret 0;
}

test "renderer: a material owns binding 1 only for an untextured run" {
    # The case that shipped broken, and it shipped because nothing here ever
    # chose a binding. A run pushed with nil takes its atlas from the pass
    # material, so binding the run's own texture over it binds the white texel
    # the run was defaulted to, and every sampler reads 1.0. Which view each
    # binding gets is decided on the CPU, so no device is involved and only the
    # identity of the views matters.
    var r:     Renderer;
    var sheet: Texture;
    var atlas: Texture;

    # Three distinct non-nil views. The addresses stand in for image handles and
    # are never dereferenced; what matters is which one binding 1 ends up with.
    var handles: [3]u8;
    r.white.image.view = (?handles[0]):~vk.ImageView;
    sheet.image.view   = (?handles[1]):~vk.ImageView;
    atlas.image.view   = (?handles[2]):~vk.ImageView;

    var mat: Material;
    mat.base_color    = vec4(1.0, 1.0, 1.0, 1.0);
    mat.texture_count = 0;
    val added: err[MaterialError] = material_add_texture(?mat, "albedo", ?atlas);
    if (!sel added.ok) { ret 1; }

    # An untextured run under a material. The run names no texture, which is
    # exactly the case a white-texel default applied too early would hide.
    var views: [4]vk.ImageView;
    fill_views_batch(?r, ?views[0], opt[*Material].some{?mat}, opt[*Texture].none{});
    if (views[0] != texture_view(?atlas)) { ret 2; }

    # A textured run under the same material keeps its own sheet, because its
    # uvs were normalised against that sheet and not against the material's.
    fill_views_batch(?r, ?views[0], opt[*Material].some{?mat}, opt[*Texture].some{?sheet});
    if (views[0] != texture_view(?sheet)) { ret 3; }

    # No material: the run's own texture at binding 1 and the white texel in the
    # companion channels, so a shader sampling a slot nothing set reads a known
    # value rather than whatever the previous draw left in that descriptor.
    fill_views_batch(?r, ?views[0], opt[*Material].none{}, opt[*Texture].some{?sheet});
    if (views[0] != texture_view(?sheet))   { ret 4; }
    if (views[1] != texture_view(?r.white)) { ret 5; }

    # And no material and no texture is the flat-colour case a solid rectangle
    # or a glyph takes: white at binding 1, so `colour * texel` is the vertex
    # colour.
    fill_views_batch(?r, ?views[0], opt[*Material].none{}, opt[*Texture].none{});
    if (views[0] != texture_view(?r.white)) { ret 6; }
    ret 0;
}

test "renderer: draining a renderer that never came up is a no-op" {
    # A game drains before a readback, and start-up is allowed to have failed
    # before it gets there. vkDeviceWaitIdle on a device that was never created
    # is a call through a loader that was never resolved, so the guard is the
    # difference between a stall of nothing and a jump to a null function.
    var r: Renderer;
    r.vk.ready = false;
    renderer_wait_idle(?r);
    ret 0;
}

test "renderer: an open mesh reservation is charged against the pending budget" {
    if (!mesh_upload_fits(0, 0))                            { ret 1; }
    if (!mesh_upload_fits(MAX_PENDING_MESH_UPLOADS - 1, 0)) { ret 2; }
    # A reservation holds staging and a slot from begin until end, so counting
    # only submitted transfers would admit a begin whose end has nowhere to go.
    if (mesh_upload_fits(MAX_PENDING_MESH_UPLOADS - 1, 1)) { ret 3; }
    if (mesh_upload_fits(MAX_PENDING_MESH_UPLOADS, 0))     { ret 4; }
    ret 0;
}

test "renderer: mesh upload staging is sized from the format's stride" {
    var f: VertexFormat = vertex_format_standard();
    var u: MeshUpload;
    mesh_upload_sizes(?u, ?f, 4, 6);
    if (u.vertex_count != 4 || u.index_count != 6) { ret 1; }
    # The extent the caller may write. Sizing it from anything but the declared
    # stride hands out a pointer that runs off the end of the allocation.
    if (u.vertex_bytes != 4::u64 * f.stride::u64) { ret 2; }
    if (u.index_bytes != 24)                      { ret 3; }
    if (u.format.stride != f.stride)              { ret 4; }
    ret 0;
}

test "renderer: a mesh upload copies whole arrays through its own pointers" {
    var f: VertexFormat = vertex_format_standard();
    var u: MeshUpload;
    mesh_upload_sizes(?u, ?f, 2, 3);

    var src: [256]u8;
    var i:   usize = 0;
    for (i < u.vertex_bytes::usize) {
        src[i] = (i + 1)::u8;
        i      = i + 1;
    }
    var idx: [3]u32;
    idx[0] = 7;
    idx[1] = 8;
    idx[2] = 9;

    # Staging needs a device, so the write path is exercised against plain
    # memory: this is the copy renderer_mesh makes on the caller's behalf.
    var vdst: [256]u8;
    var idst: [3]u32;
    u.vertices = (?vdst[0]):~ptr;
    u.indices  = ?idst[0];
    mesh_upload_fill(?u, ?src[0], (?idx[0]):~*u8);

    i = 0;
    for (i < u.vertex_bytes::usize) {
        if (vdst[i] != src[i]) { ret 1; }
        i = i + 1;
    }
    if (idst[0] != 7 || idst[1] != 8 || idst[2] != 9) { ret 2; }
    ret 0;
}

test "renderer: caller-supplied mesh bounds reach the mesh exactly as given" {
    var f: VertexFormat = vertex_format_standard();
    var u: MeshUpload;
    mesh_upload_sizes(?u, ?f, 3, 3);

    val b: Aabb = Aabb{min: vec3(0.0 - 2.0, 0.0 - 1.0, 0.0 - 4.0),
        max: vec3(5.0, 6.0, 7.0)};

    # Taken as given rather than recomputed: a caller that already knows its
    # extent must not pay the per-vertex walk a second time.
    val m: Mesh = mesh_upload_record(?u, b);
    if (m.bounds.min[0] != 0.0 - 2.0) { ret 1; }
    if (m.bounds.min[1] != 0.0 - 1.0) { ret 2; }
    if (m.bounds.min[2] != 0.0 - 4.0) { ret 3; }
    if (m.bounds.max[0] != 5.0)       { ret 4; }
    if (m.bounds.max[1] != 6.0)       { ret 5; }
    if (m.bounds.max[2] != 7.0)       { ret 6; }
    if (m.index_count != 3)           { ret 7; }
    if (m.format.stride != f.stride)  { ret 8; }
    ret 0;
}

test "renderer: the walked bounds a mesh gets are the ones the vertices hold" {
    var f: VertexFormat = vertex_format_standard();
    # Two standard vertices: position, normal, texcoord, eight floats each.
    var v: [16]f32;
    var i: usize = 0;
    for (i < 16) {
        v[i] = 0.0;
        i    = i + 1;
    }
    v[0]  = 1.0;
    v[1]  = 2.0;
    v[2]  = 3.0;
    v[8]  = 0.0 - 4.0;
    v[9]  = 0.0 - 5.0;
    v[10] = 0.0 - 6.0;

    var u: MeshUpload;
    mesh_upload_sizes(?u, ?f, 2, 3);

    # renderer_mesh is renderer_mesh_with_bounds fed this walk, so the two paths
    # agree on a mesh whose caller did not supply a box.
    val walked: Aabb = mesh_bounds_of((?v[0]):~*u8, 2, ?f);
    val m:      Mesh = mesh_upload_record(?u, walked);
    if (m.bounds.min[0] != 0.0 - 4.0) { ret 1; }
    if (m.bounds.min[1] != 0.0 - 5.0) { ret 2; }
    if (m.bounds.min[2] != 0.0 - 6.0) { ret 3; }
    if (m.bounds.max[0] != 1.0)       { ret 4; }
    if (m.bounds.max[1] != 2.0)       { ret 5; }
    if (m.bounds.max[2] != 3.0)       { ret 6; }
    ret 0;
}

test "renderer: a mesh upload begun before the device is refused, not a fault" {
    var r: Renderer;
    r.ready_dev       = false;
    r.upload_count    = 0;
    r.upload_reserved = 0;
    var f: VertexFormat = vertex_format_standard();

    val begun: res[MeshUpload, Error] = renderer_mesh_begin(?r, ?f, 3, 3);
    if (!sel begun.err)               { ret 1; }
    if (!sel begun.err.uninitialized) { ret 2; }
    # A refused reservation charges nothing.
    if (renderer_mesh_reserved(?r) != 0) { ret 3; }

    # And a reservation that was never opened can be neither ended nor cancelled.
    var u: MeshUpload;
    u.live = false;
    val m: res[Mesh, Error] = renderer_mesh_end(?r, ?u, aabb_empty());
    if (!sel m.err) { ret 4; }
    renderer_mesh_cancel(?r, ?u);
    if (renderer_mesh_reserved(?r) != 0 || r.upload_count != 0) { ret 5; }
    ret 0;
}

test "renderer: pass regions bound viewport and scissor without changing projection" {
    var renderer: Renderer;
    var pass:     Pass;
    pass.renderer   = ?renderer;
    pass.targets    = 1;
    pass.width      = 2048;
    pass.height     = 2048;
    pass.projection = mat4_identity();
    if (!region_set(pass_set_region(?pass, 1536, 1024, 512, 512))) { ret 1; }
    if (pass.region_x != 1536 || pass.region_y != 1024
        || pass.region_width != 512 || pass.region_height != 512) { ret 2; }
    if (pass.width != 2048 || pass.height != 2048 || pass.projection.m[0][0] != 1.0)                                  { ret 3; }
    if (region_set(pass_set_region(?pass, -1, 0, 512, 512)) || region_set(pass_set_region(?pass, 0, 0, 0, 512)))      { ret 4; }
    if (region_set(pass_set_region(?pass, 1537, 0, 512, 512)) || region_set(pass_set_region(?pass, 0, 0, 2049, 512))) { ret 5; }
    if (region_set(pass_set_region(?pass, 2147483647, 0, 512, 512)))                                                  { ret 6; }
    if (renderer.refused != 5 || pass.region_x != 1536 || pass.region_y != 1024)                                      { ret 7; }
    if (!region_set(pass_set_region(?pass, 0, 0, 2048, 2048)) || renderer.refused != 5)                               { ret 8; }
    ret 0;
}

fun region_set(r: err[Error]) bool {
    ret sel r.ok;
}
