# the Skeleton and Pose: joint hierarchy, bind data, and the skinning palette
#
# a Skeleton is boom's own view of a glTF skin: the joints, their parent
# hierarchy, each joint's rest-pose local transform, and its inverse bind
# matrix. it holds no mach-gltf types; boom.graphics.model builds one from
# a loaded document. a Pose is the product of posing a skeleton: the
# per-joint skinning matrices a skinning shader multiplies its vertices
# by, laid out contiguously so the whole palette uploads in one call.
#
# joint storage is fixed at MAX_JOINTS so a Skeleton and Pose are plain
# values with no backing allocation, and MAX_JOINTS also sizes the joint
# palette the skinning shader reads. the composition is pure boom.math, so
# it is unit-tested with no device.

use boom.math.mat.Mat4;
use boom.math.mat.mat4_mul;
use boom.math.mat.mat4_identity;
use boom.math.mat.mat4_translation;
use boom.math.vec.Vec3;
use boom.math.vec.vec3;
use boom.math.quat.Quat;
use boom.math.transform.Transform;
use boom.math.transform.transform_matrix;
use std.types.size.usize;
use std.types.string.str;

# the most joints a skeleton and its skinning palette carry
#
# also the size of the joint palette the skinning shader declares as a
# storage block; src/shaders/skinned_vert.mach hardcodes the resulting column
# count and the guard below keeps the two in sync.
pub val MAX_JOINTS: usize = 128;

$if (MAX_JOINTS != 128) {
    $error("skeleton: src/shaders/skinned_vert.mach declares a 512-column palette; keep it in sync with MAX_JOINTS");
}

# a skeleton's joints, their hierarchy, and their bind data
#
# joints are indexed 0..count, matching the order a skin lists them, which
# is also the order the JOINTS_0 vertex attribute references. parents and
# order describe the same tree two ways: parents for the child-to-root
# link, order for a parent-before-child evaluation sweep.
# ---
# count:        number of joints, at most MAX_JOINTS
# parents:      per-joint parent joint index, or -1 for a root joint
# order:        joint indices ordered so every parent precedes its children
# rest:         per-joint rest-pose local transform, the base a clip overrides
# inverse_bind: per-joint inverse bind matrix, mesh space into joint space
pub rec Skeleton {
    count:        usize;
    parents:      [128]i64;
    order:        [128]usize;
    rest:         [128]Transform;
    inverse_bind: [128]Mat4;
}

# a posed skeleton: the skinning matrix palette ready to upload
# ---
# count:    number of joints the skeleton actually has
# matrices: per-joint skinning matrix, joint j at index j; entries at or past
#           `count` are identity rather than undefined
pub rec Pose {
    count:    usize;
    matrices: [128]Mat4;
}

# compose model-space joint transforms into caller storage of at least sk.count matrices
pub fun skeleton_globals(sk: *Skeleton, locals: *Transform, out: *Mat4) {
    var i: usize = 0;
    for (i < sk.count) {
        val j: usize = sk.order[i];
        var local: Mat4 = transform_matrix(?locals[j]);
        val p: i64 = sk.parents[j];
        if (p < 0) {
            out[j] = local;
        }
        or {
            out[j] = mat4_mul(?out[p::usize], ?local);
        }
        i = i + 1;
    }
}

# compose per-joint local transforms into a skinning palette
#
# sweeps joints in the skeleton's evaluation order so each joint's parent
# is composed first, forming per-joint model-space matrices, then folds in
# each inverse bind matrix to map bind-pose mesh vertices into the joint's
# posed frame. the mesh node's own transform is deliberately ignored, per
# the glTF skinning rule. this assumes the skin's joints form a
# self-contained hierarchy, the common case for exported rigs; non-joint
# intermediate nodes and a non-identity armature transform are future work.
# ---
# sk:     the skeleton providing the hierarchy and inverse binds
# locals: per-joint local transform, index j for joint j
# out:    receives the computed skinning palette
pub fun skeleton_pose(sk: *Skeleton, locals: *Transform, out: *Pose) {
    var globals: [128]Mat4;
    skeleton_globals(sk, locals, ?globals[0]);
    var k: usize = 0;
    for (k < sk.count) {
        out.matrices[k] = mat4_mul(?globals[k], ?sk.inverse_bind[k]);
        k = k + 1;
    }

    # THE TAIL IS FILLED, NOT LEFT ALONE. A skinned draw uploads the whole
    # MAX_JOINTS-matrix palette, because that is what the shader's storage
    # block declares and the upload is one copy rather than a per-joint loop.
    # Leaving the joints past `count` at whatever was on the stack means a
    # vertex referencing an out-of-range joint reads a matrix of garbage
    # floats and is flung somewhere unbounded, which stretches the whole mesh
    # into a spike. Identity leaves such a vertex where it already is, which
    # is visible as a piece of the model not moving rather than as the model
    # being destroyed.
    for (k < MAX_JOINTS) {
        out.matrices[k] = mat4_identity();
        k = k + 1;
    }
    out.count = sk.count;
}

# pose a skeleton in its rest pose, the bind-pose palette
#
# the pose a model shows before any clip is sampled; also the value a
# skinning draw uploads when no animation is playing.
# ---
# sk:  the skeleton to pose
# out: receives the rest-pose skinning palette
pub fun skeleton_rest_pose(sk: *Skeleton, out: *Pose) {
    skeleton_pose(sk, ?sk.rest[0], out);
}

# a pointer to the palette's first matrix, for upload as a storage buffer
#
# All MAX_JOINTS matrices are contiguous and all are defined, so the upload is
# one copy of a fixed size rather than a per-joint loop bounded by `count`.
# ---
# pose: the pose to expose
# ret:  pointer to the first of MAX_JOINTS contiguous column-major matrices
pub fun pose_matrices(pose: *Pose) *Mat4 {
    ret ?pose.matrices[0];
}

# build a two-joint chain skeleton for tests: root then a child of it
fun fixture_chain(sk: *Skeleton) {
    sk.count = 2;
    sk.parents[0] = 0 - 1;
    sk.parents[1] = 0;
    sk.order[0] = 0;
    sk.order[1] = 1;
    var i: usize = 0;
    for (i < 2) {
        sk.rest[i].position = vec3(0.0, 0.0, 0.0);
        sk.rest[i].rotation = f32x4{0.0, 0.0, 0.0, 1.0};
        sk.rest[i].scale    = vec3(1.0, 1.0, 1.0);
        sk.inverse_bind[i]  = mat4_identity();
        i = i + 1;
    }
}

test "skeleton: composition propagates a parent transform to its child" {
    var sk: Skeleton;
    fixture_chain(?sk);

    var locals: [2]Transform;
    locals[0].position = vec3(2.0, 0.0, 0.0);
    locals[0].rotation = f32x4{0.0, 0.0, 0.0, 1.0};
    locals[0].scale    = vec3(1.0, 1.0, 1.0);
    locals[1].position = vec3(1.0, 0.0, 0.0);
    locals[1].rotation = f32x4{0.0, 0.0, 0.0, 1.0};
    locals[1].scale    = vec3(1.0, 1.0, 1.0);

    var pose: Pose;
    skeleton_pose(?sk, ?locals[0], ?pose);
    if (pose.count != 2) { ret 1; }
    if (pose.matrices[0].m[3][0] != 2.0) { ret 2; }
    if (pose.matrices[1].m[3][0] != 3.0) { ret 3; }
    ret 0;
}

test "skeleton: the palette tail is identity, not whatever was on the stack" {
    # A skinned draw uploads all MAX_JOINTS matrices, because that is the size
    # of the storage block the shader declares. A vertex referencing a joint
    # past `count` would otherwise be transformed by uninitialized floats and
    # flung somewhere unbounded, stretching the whole mesh into a spike.
    var sk: Skeleton;
    fixture_chain(?sk);

    var pose: Pose;
    # Dirty the tail first, so the fill is what is being observed rather than
    # a zeroed stack that happens to look right.
    var i: usize = 0;
    for (i < MAX_JOINTS) {
        pose.matrices[i] = mat4_translation(vec3(99.0, 99.0, 99.0));
        i = i + 1;
    }

    skeleton_rest_pose(?sk, ?pose);
    if (pose.count != 2) { ret 1; }

    val last: *Mat4 = ?pose.matrices[MAX_JOINTS - 1];
    if (last.m[0][0] != 1.0 || last.m[1][1] != 1.0 || last.m[2][2] != 1.0 || last.m[3][3] != 1.0) { ret 2; }
    if (last.m[3][0] != 0.0 || last.m[3][1] != 0.0 || last.m[3][2] != 0.0) { ret 3; }

    # The first joint past the real ones, which is the index an out-of-range
    # JOINTS_0 value most often lands on.
    val next: *Mat4 = ?pose.matrices[2];
    if (next.m[3][0] != 0.0 || next.m[3][3] != 1.0) { ret 4; }
    ret 0;
}

test "skeleton: the palette is exactly what the shader's storage block holds" {
    # boom.graphics.renderer uploads $size_of(Mat4) * MAX_JOINTS bytes in one
    # copy. A palette narrower than that reads past the Pose; wider, and the
    # last joints come from the next draw's palette.
    if ($size_of(Mat4) != 64)                 { ret 1; }
    if ($size_of(Mat4) * MAX_JOINTS != 8192)  { ret 2; }
    ret 0;
}

test "skeleton: the inverse bind matrix folds into the skinning matrix" {
    var sk: Skeleton;
    fixture_chain(?sk);
    sk.inverse_bind[1] = mat4_translation(vec3(0.0 - 3.0, 0.0, 0.0));

    var pose: Pose;
    skeleton_rest_pose(?sk, ?pose);
    # rest globals are identity, so joint 1's skinning matrix is its inverse bind
    if (pose.matrices[1].m[3][0] != 0.0 - 3.0) { ret 1; }
    ret 0;
}

test "skeleton: socket globals retain parent rotation and translation before inverse bind" {
    var sk: Skeleton;
    fixture_chain(?sk);
    sk.parents[0] = 1;
    sk.parents[1] = 0 - 1;
    sk.order[0] = 1;
    sk.order[1] = 0;
    sk.rest[1].position = vec3(2.0, 3.0, 0.0);
    sk.rest[1].rotation = f32x4{0.0, 0.0, 0.70710678, 0.70710678};
    sk.rest[0].position = vec3(1.0, 0.0, 0.0);
    sk.inverse_bind[0] = mat4_translation(vec3(0.0 - 1.0, 0.0, 0.0));
    var globals: [3]Mat4;
    globals[2] = mat4_translation(vec3(99.0, 0.0, 0.0));
    skeleton_globals(?sk, ?sk.rest[0], ?globals[0]);
    if (globals[0].m[3][0] < 1.999 || globals[0].m[3][0] > 2.001) { ret 1; }
    if (globals[0].m[3][1] < 3.999 || globals[0].m[3][1] > 4.001) { ret 2; }
    if (globals[0].m[0][1] < 0.999 || globals[0].m[1][0] > 0.0 - 0.999) { ret 3; }
    if (globals[2].m[3][0] != 99.0) { ret 4; }
    var pose: Pose;
    skeleton_pose(?sk, ?sk.rest[0], ?pose);
    if (pose.matrices[0].m[3][0] < 1.999 || pose.matrices[0].m[3][0] > 2.001) { ret 5; }
    if (pose.matrices[0].m[3][1] < 2.999 || pose.matrices[0].m[3][1] > 3.001) { ret 6; }
    if (pose.matrices[0].m[0][1] != globals[0].m[0][1]) { ret 7; }
    if (pose.count != 2 || pose.matrices[2].m[0][0] != 1.0) { ret 8; }
    ret 0;
}
