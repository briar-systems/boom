# The pipeline cache: one pipeline per program and vertex layout.
#
# A GL program did not care what the vertex buffer looked like; the vertex array
# object described the layout, and the same program drew a mesh with a tangent
# and one without. Vulkan bakes the vertex input layout into the pipeline, so a
# program and a layout together are what identifies a pipeline, and a mesh drawn
# through a pipeline built for a different layout reads its attributes from the
# wrong byte offsets.
#
# THAT LAYOUT IS NOT KNOWN UP FRONT. A .glb primitive carries whatever
# attributes it happens to have: POSITION always, and NORMAL, TEXCOORD_0,
# COLOR_0, TANGENT, JOINTS_0 and WEIGHTS_0 if the exporter wrote them. The
# extracted format is packed in that order, so two models can differ in stride
# and in every offset past the first attribute. Building the mesh pipeline once
# at renderer init against a fixed layout is therefore correct only for assets
# that happen to match it, and wrong without any diagnostic for the rest.
#
# So pipelines are built on demand and kept, keyed by the program, vertex
# format, render-pass compatibility, and depth convention. The cache is a
# linear scan because the count is small: a game has a handful of distinct
# layouts and target formats, not hundreds, and a scan over thirty-two entries
# costs less than hashing them.
#
# EVERY PIPELINE SHARES ONE DESCRIPTOR SET LAYOUT. See
# boom.graphics.pipeline.set_layout_full for why. It is what lets one descriptor
# pool and one set per draw serve every program.

use boom.graphics.depth.DepthConvention;
use boom.graphics.depth.depth_convention_same;
use boom.graphics.error.Capacity;
use boom.graphics.error.Error;
use boom.graphics.pass.PassCompatibility;
use boom.graphics.pass.pass_compatibility_eq;
use boom.graphics.pass.pass_compatibility_one;
use boom.graphics.pipeline.Pipeline;
use boom.graphics.pipeline.PipelineDesc;
use boom.graphics.pipeline.SetLayout;
use boom.graphics.pipeline.pipeline_desc_2d;
use boom.graphics.pipeline.pipeline_desc_3d;
use boom.graphics.pipeline.pipeline_dnit;
use boom.graphics.pipeline.pipeline_init_depth;
use boom.graphics.pipeline.set_layout_full;
use boom.graphics.spirv.LIT_FRAG_SPV;
use boom.graphics.spirv.MESH_VERT_SPV;
use boom.graphics.spirv.SKINNED_VERT_SPV;
use boom.graphics.spirv.UI_FRAG_SPV;
use boom.graphics.spirv.UI_VERT_SPV;
use boom.graphics.vertex.VertexFormat;
use boom.graphics.vertex.vertex_format_eq;
use boom.graphics.vertex.vertex_format_standard;
use boom.graphics.vertex.vertex_format_ui;
use boom.graphics.vk.Vk;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use vk;

# Which pair of shader modules a pipeline uses.
pub def Program: u8;

# mesh_vert plus lit_frag: unskinned lit geometry.
pub val PROGRAM_MESH: Program = 0;
# skinned_vert plus lit_frag: geometry placed by a joint palette.
pub val PROGRAM_SKINNED: Program = 1;
# Already-placed, per-vertex-coloured triangles: every 2D draw boom makes, which
# after batching is sprites, text and immediate-mode geometry alike. No model
# matrix and no tint, because one draw covers a whole run.
pub val PROGRAM_UI: Program = 2;

# The most distinct program-and-layout combinations one renderer keeps.
#
# A miss past this is reported rather than evicting: eviction would destroy a
# pipeline a recorded command buffer still references, and a game with more
# than sixteen distinct vertex layouts per depth convention has a content
# problem worth surfacing.
pub val MAX_PIPELINES: usize = 32;

# One cached pipeline and the key it was built for.
# ---
# program:       Which shader pair it uses.
# format:        The vertex layout it was built against.
# compatibility: The attachment signature it was built against.
# depth:         The depth comparison direction it was built with.
# pipeline:      The built pipeline.
# live:          Whether this entry holds a pipeline.
pub rec CacheEntry {
    program:       Program;
    format:        VertexFormat;
    compatibility: PassCompatibility;
    depth:         DepthConvention;
    pipeline:      Pipeline;
    live:          bool;
}

# The renderer's pipelines.
# ---
# entries: The cached pipelines, first `count` live.
# count:   How many entries are live.
# missed:  Lookups refused because the cache was full, since renderer init.
pub rec PipelineCache {
    entries: [32]CacheEntry;
    count:   usize;
    missed:  usize;
}

# Start an empty pipeline cache.
pub fun cache_init(c: *PipelineCache) {
    c.count  = 0;
    c.missed = 0;
    var i: usize = 0;
    for (i < MAX_PIPELINES) {
        c.entries[i].live = false;
        i                 = i + 1;
    }
}

# Find a live entry's index, if one matches.
#
# Separated from the lookup so the hit path is testable without a device.
pub fun cache_find(c: *PipelineCache, program: Program, compatibility: *PassCompatibility,
    f: *VertexFormat, depth: DepthConvention) opt[usize] {
    var i: usize = 0;
    for (i < c.count) {
        if (c.entries[i].live && c.entries[i].program == program
            && depth_convention_same(c.entries[i].depth, depth)
            && pass_compatibility_eq(?c.entries[i].compatibility, compatibility)) {
            if (vertex_format_eq(?c.entries[i].format, f)) { ret opt[usize].some{i}; }
        }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# The description and shader modules a program is built with.
#
# Kept beside the Program constants rather than at the call sites, so adding a
# program is one entry here and not a new branch in every caller.
fun program_desc(program: Program) PipelineDesc {
    # UI shares the 2D description: blended, unculled, no depth. A draw list is
    # emitted back to front and its triangles are wound however the emitter
    # happened to, so culling it would drop half of them.
    if (program == PROGRAM_UI) { ret pipeline_desc_2d(); }
    ret pipeline_desc_3d();
}

# Build and store the pipeline for a program and format.
fun cache_add(c: *PipelineCache, v: *Vk, pass: vk.RenderPass,
    compatibility: *PassCompatibility, program: Program,
    f: *VertexFormat, depth: DepthConvention) res[usize, Error] {
    if (c.count >= MAX_PIPELINES) {
        c.missed = c.missed + 1;
        ret res[usize, Error].err{Error.full{Capacity.pipelines{}}};
    }

    var vert: *u8   = ?MESH_VERT_SPV[0];
    var vlen: usize = $length_of(MESH_VERT_SPV);
    var frag: *u8   = ?LIT_FRAG_SPV[0];
    var flen: usize = $length_of(LIT_FRAG_SPV);

    if (program == PROGRAM_SKINNED) {
        vert = ?SKINNED_VERT_SPV[0];
        vlen = $length_of(SKINNED_VERT_SPV);
    }
    or (program == PROGRAM_UI) {
        vert = ?UI_VERT_SPV[0];
        vlen = $length_of(UI_VERT_SPV);
        frag = ?UI_FRAG_SPV[0];
        flen = $length_of(UI_FRAG_SPV);
    }

    val i:    usize        = c.count;
    var desc: PipelineDesc = program_desc(program);
    var lay:  SetLayout    = set_layout_full();
    val r:    err[Error]   = pipeline_init_depth(?c.entries[i].pipeline, v, pass,
        compatibility.color_count,
        f, ?desc, depth,
        vert, vlen, frag, flen, ?lay);
    if (sel r.err) { ret res[usize, Error].err{r.err}; }

    c.entries[i].program       = program;
    c.entries[i].format        = @f;
    c.entries[i].compatibility = @compatibility;
    c.entries[i].depth         = depth;
    c.entries[i].live          = true;
    c.count                    = c.count + 1;
    ret res[usize, Error].ok{i};
}

# The pipeline for a program and vertex layout, building it on first use.
#
# Refused when the cache is full or the pipeline could not be built, which the
# caller reports as a dropped draw. Returning a wrong pipeline instead would draw
# geometry from the wrong byte offsets, which looks like corrupt art rather than
# a missing one.
# ---
# c:       the cache
# v:       the device
# program: which shader pair the draw needs
# f:       the mesh's vertex layout
# ret:     the pipeline, or why it could not be built
pub fun cache_get(c: *PipelineCache, v: *Vk, pass: vk.RenderPass,
    compatibility: *PassCompatibility, program: Program,
    f: *VertexFormat, depth: DepthConvention) res[*Pipeline, Error] {
    val found: opt[usize] = cache_find(c, program, compatibility, f, depth);
    if (sel found.some) { ret res[*Pipeline, Error].ok{?c.entries[found.some].pipeline}; }

    val r: res[usize, Error] = cache_add(c, v, pass, compatibility,
        program, f, depth);
    if (sel r.err) { ret res[*Pipeline, Error].err{r.err}; }
    ret res[*Pipeline, Error].ok{?c.entries[r.ok].pipeline};
}

# Destroy every pipeline the cache holds.
pub fun cache_dnit(c: *PipelineCache, v: *Vk) {
    var i: usize = 0;
    for (i < c.count) {
        if (c.entries[i].live) {
            pipeline_dnit(?c.entries[i].pipeline, v);
            c.entries[i].live = false;
        }
        i = i + 1;
    }
    c.count = 0;
}

# --------------------------------------------------------------------- tests
#
# Building a pipeline needs a device, so these cover the key: a lookup that
# matches the wrong entry hands a draw a pipeline built for another layout,
# which reads every attribute past the first from the wrong offset.

test "cache: an empty cache finds nothing" {
    var c: PipelineCache;
    cache_init(?c);
    var f:             VertexFormat      = vertex_format_standard();
    var compatibility: PassCompatibility = pass_compatibility_one(1);
    val found:         opt[usize]        = cache_find(?c, PROGRAM_MESH, ?compatibility, ?f,
        DepthConvention.forward{});
    if (!sel found.none) { ret 1; }
    ret 0;
}

fun misses(found: opt[usize]) bool {
    ret sel found.none;
}

test "cache: an entry matches only its own program and format" {
    var c: PipelineCache;
    cache_init(?c);
    var compatibility: PassCompatibility = pass_compatibility_one(1);

    # Populated directly rather than through cache_add, which needs a device.
    c.entries[0].program       = PROGRAM_MESH;
    c.entries[0].format        = vertex_format_standard();
    c.entries[0].compatibility = compatibility;
    c.entries[0].depth         = DepthConvention.forward{};
    c.entries[0].live          = true;
    c.count                    = 1;

    var std_fmt: VertexFormat = vertex_format_standard();
    val hit:     opt[usize]   = cache_find(?c, PROGRAM_MESH, ?compatibility, ?std_fmt,
        DepthConvention.forward{});
    if (!sel hit.some) { ret 1; }
    if (hit.some != 0) { ret 6; }

    # Same layout, different program. Matching here would draw a skinned mesh
    # with the unskinned shader, which ignores the joints entirely.
    if (!misses(cache_find(?c, PROGRAM_SKINNED, ?compatibility, ?std_fmt,
        DepthConvention.forward{}))) { ret 2; }

    # Same program, different layout. Matching here is the bug this cache
    # exists to prevent.
    var ui_fmt: VertexFormat = vertex_format_ui();
    if (!misses(cache_find(?c, PROGRAM_MESH, ?compatibility, ?ui_fmt,
        DepthConvention.forward{}))) { ret 3; }

    # Same program and layout, different attachment format.
    var hdr: PassCompatibility = pass_compatibility_one(2);
    if (!misses(cache_find(?c, PROGRAM_MESH, ?hdr, ?std_fmt,
        DepthConvention.forward{}))) { ret 4; }
    if (!misses(cache_find(?c, PROGRAM_MESH, ?compatibility, ?std_fmt,
        DepthConvention.reversed{}))) { ret 5; }
    ret 0;
}

test "cache: a dead entry is not matched" {
    var c: PipelineCache;
    cache_init(?c);
    var compatibility: PassCompatibility = pass_compatibility_one(1);
    c.entries[0].program       = PROGRAM_MESH;
    c.entries[0].format        = vertex_format_standard();
    c.entries[0].compatibility = compatibility;
    c.entries[0].depth         = DepthConvention.forward{};
    c.entries[0].live          = false;
    c.count                    = 1;
    var f: VertexFormat = vertex_format_standard();
    if (!misses(cache_find(?c, PROGRAM_MESH, ?compatibility, ?f,
        DepthConvention.forward{}))) { ret 1; }
    ret 0;
}

test "cache: teardown clears the entries" {
    var c: PipelineCache;
    cache_init(?c);
    c.count = 0;
    var v: Vk;
    v.ready = false;
    cache_dnit(?c, ?v);
    if (c.count != 0) { ret 1; }
    ret 0;
}
