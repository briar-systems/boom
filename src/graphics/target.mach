# the RenderTarget handle: an offscreen target a pass renders into
#
# a RenderTarget owns a colour image, a depth image, a render pass, and a
# framebuffer, so a pass can render a scene to a texture instead of the
# window. the colour attachment is exposed as a Texture for a later pass to
# sample, which is how post-processing and render-to-texture effects are
# built. the backing Vulkan objects stay hidden.
#
# WHY A SEPARATE RENDER PASS. GL let a framebuffer be swapped mid-frame with
# a bind call. Vulkan bakes the attachment formats and the load and store
# operations into a render pass object, and a pipeline is created against
# one, so an offscreen target cannot share the swapchain's. that is why this
# module owns a render pass rather than borrowing the frame loop's, and why
# a pipeline drawing into a target must be built against target_pass.
#
# THE FINAL LAYOUT IS SHADER_READ_ONLY, NOT PRESENT_SRC. the whole point of
# an offscreen target is that something samples it afterwards. declaring the
# transition in the render pass rather than issuing a barrier after it means
# the driver performs it as part of ending the pass, and it cannot be
# forgotten at a call site.

use boom.graphics.device.Device;
use boom.graphics.error.Error;
use boom.graphics.error.ImageError;
use boom.graphics.error.Stage;
use boom.graphics.error.TargetError;
use boom.graphics.error.VkCall;
use boom.graphics.error.vk_failed;
use boom.graphics.image.DEPTH_FORMAT;
use boom.graphics.image.DepthAttachment;
use boom.graphics.image.Image;
use boom.graphics.image.ImageUsage;
use boom.graphics.image.depth_attachment_dnit;
use boom.graphics.image.depth_attachment_init;
use boom.graphics.image.image_dnit;
use boom.graphics.image.image_format_bytes;
use boom.graphics.image.image_init;
use boom.graphics.image.image_raw_bytes;
use boom.graphics.image.image_read;
use boom.graphics.image.image_transition;
use boom.graphics.pass.MAX_COLOR_ATTACHMENTS;
use boom.graphics.pass.PassCompatibility;
use boom.graphics.pass.PassOptions;
use boom.graphics.pass.pass_clearing;
use boom.graphics.pass.pass_clearing_mrt;
use boom.graphics.pass.pass_compatibility;
use boom.graphics.pass.pass_create;
use boom.graphics.pass.pass_loading_mrt;
use boom.graphics.texture.Texture;
use boom.graphics.vk.Vk;
use boom.graphics.vk.vk_wait_idle;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use vk;

# The storage format of one offscreen colour attachment.
#
# These names describe data rather than Vulkan. Surface preserves the historical
# behaviour and matches the window; the explicit formats let data buffers avoid
# an sRGB transfer and let light buffers retain values above one.
# ---
# surface:      the window's colour format, so a target and the window share pipelines
# rgba8_srgb:   eight-bit colour with an sRGB transfer
# rgba8_unorm:  eight-bit data read as stored
# rgba16_float: half-float channels that keep values above one
pub tag RenderFormat: u8 {
    surface;
    rgba8_srgb;
    rgba8_unorm;
    rgba16_float;
}

# One format per colour attachment in an offscreen target.
pub rec RenderTargetDesc {
    formats:     [4]RenderFormat;
    color_count: usize;
}

# A target description whose attachments all share one format.
pub fun render_target_desc(format: RenderFormat, count: usize) RenderTargetDesc {
    var d: RenderTargetDesc;
    d.color_count = count;
    if (d.color_count == 0)                    { d.color_count = 1; }
    if (d.color_count > MAX_COLOR_ATTACHMENTS) { d.color_count = MAX_COLOR_ATTACHMENTS; }
    var i: usize = 0;
    for (i < MAX_COLOR_ATTACHMENTS) {
        d.formats[i] = format;
        i            = i + 1;
    }
    ret d;
}

# A mixed-format target description.
pub fun render_target_desc_mrt(formats: *RenderFormat, count: usize) RenderTargetDesc {
    var d: RenderTargetDesc = render_target_desc(RenderFormat.surface{}, count);
    if (formats == nil) { ret d; }
    var i: usize = 0;
    for (i < d.color_count) {
        d.formats[i] = formats[i];
        i            = i + 1;
    }
    ret d;
}

# Bytes occupied by one texel of a public render format.
pub fun render_format_bytes(format: RenderFormat) usize {
    if (sel format.rgba16_float) { ret 8; }
    ret 4;
}

# Resolve a backend-neutral render format for this device.
fun render_vk_format(d: *Device, format: RenderFormat) i32 {
    if (sel format.rgba8_srgb)   { ret vk.FORMAT_R8G8B8A8_SRGB; }
    if (sel format.rgba8_unorm)  { ret vk.FORMAT_R8G8B8A8_UNORM; }
    if (sel format.rgba16_float) { ret vk.FORMAT_R16G16B16A16_SFLOAT; }
    ret d.vk.color_format;
}

# Whether optimal-tiling images of this format support every operation a target
# exposes: drawing, sampling, filtered sampling, upload and readback.
fun render_format_supported(d: *Device, format: i32) bool {
    var props: vk.FormatProperties;
    vk.vkGetPhysicalDeviceFormatProperties(d.vk.physical, format, ?props);
    val need: u32 = vk.FORMAT_FEATURE_COLOR_ATTACHMENT_BIT
        | vk.FORMAT_FEATURE_SAMPLED_IMAGE_BIT
        | vk.FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT
        | vk.FORMAT_FEATURE_TRANSFER_DST_BIT
        | vk.FORMAT_FEATURE_TRANSFER_SRC_BIT;
    ret (props.optimalTilingFeatures & need) == need;
}

# an opaque handle to an offscreen render target
# ---
# colors:        the colour attachments, each sampleable as a Texture
# formats:       the public storage format of each attachment
# color_count:   how many of colors this target writes
# compatibility: the attachment signature pipelines are cached against
# depth:         the depth attachment, shared with the frame loop's
# pass:          the render pass drawing into this target uses
# framebuffer:   the framebuffer binding the two attachments
# width:         target width in pixels
# height:        target height in pixels
# ready:         whether creation completed
pub rec RenderTarget {
    colors:        [4]Texture;
    formats:       [4]RenderFormat;
    color_count:   usize;
    compatibility: PassCompatibility;
    depth:         DepthAttachment;
    pass:          vk.RenderPass;
    pass_load:     vk.RenderPass;
    framebuffer:   vk.Framebuffer;
    width:         i32;
    height:        i32;
    ready:         bool;
}

# the render pass an offscreen target draws through
#
# Built from the same description as the window's, in boom.graphics.pass. That
# is not tidiness: a pipeline may only be used in a pass compatible with the one
# it was built against, boom builds one set of pipelines, and compatibility
# covers the subpass dependencies as well as the attachments. Two hand-written
# passes agreed on everything obvious and differed in dependency count, which
# made every draw into a target invalid.
# TWO PASSES, AND THE SECOND IS WHY ANYTHING CAN ACCUMULATE. A target owning
# only a clearing pass is wiped by every pass that touches it, which makes a
# layer that builds up over many frames, such as decals stamped one quad at a
# time, impossible to express: the only way to add a mark would be to redraw
# every previous mark.
#
# The two are render-pass compatible, so one set of pipelines works in both.
# Load and store operations and attachment layouts are exactly the members
# compatibility exempts, and they are the only members these two differ in.
fun make_pass(t: *RenderTarget, v: *Vk) err[Error] {
    # Ends ready to be sampled, which is what an offscreen target is for.
    # Declaring the transition in the pass rather than as a barrier after it
    # means the driver performs it as part of ending the pass, and it cannot be
    # forgotten at a call site.
    var fmts: [4]i32;
    var i:    usize = 0;
    for (i < t.color_count) {
        fmts[i] = t.colors[i].image.format;
        i       = i + 1;
    }
    val o: PassOptions = pass_clearing_mrt(?fmts[0], t.color_count,
        vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
    val cr: err[Error] = pass_create(v, ?o, ?t.pass);
    if (sel cr.err) { ret cr; }

    # Entered in SHADER_READ_ONLY_OPTIMAL, which is where this target's own
    # clearing pass leaves it, not COLOR_ATTACHMENT_OPTIMAL as the window's
    # resume pass uses. Naming the wrong layout preserves nothing.
    val l: PassOptions = pass_loading_mrt(?fmts[0], t.color_count,
        vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
        vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
    ret pass_create(v, ?l, ?t.pass_load);
}

# create an offscreen render target of the given size
#
# allocates a surface-format colour image exposed as a Texture, a depth image,
# a render pass ending with the colour attachment ready to sample, and a
# framebuffer binding the two. Use render_target_create for explicit formats.
# ---
# d:      the upload context
# width:  target width in pixels, positive
# height: target height in pixels, positive
# ret:    the render target, or a creation error
pub fun render_target(d: *Device, width: i32, height: i32) res[RenderTarget, Error] {
    val desc: RenderTargetDesc = render_target_desc(RenderFormat.surface{}, 1);
    ret render_target_create(d, width, height, ?desc);
}

# create an offscreen target with several colour attachments
#
# What a deferred pipeline needs: one geometry pass writing albedo, normal,
# material and emissive together, rather than four passes each resubmitting the
# same geometry. Every attachment shares the target's size and format and is
# cleared and transitioned with the rest, because they are written together.
#
# A fragment shader drawing into this must declare an output per attachment.
# One that writes fewer leaves the rest undefined, which is legal and is what
# the built-in programs do when they are drawn into a multi-attachment target.
# ---
# d:      the upload context
# width:  target width in pixels, positive
# height: target height in pixels, positive
# count:  colour attachments, 1 to MAX_COLOR_ATTACHMENTS
# ret:    the render target, or a creation error
pub fun render_target_mrt(d: *Device, width: i32, height: i32, count: usize) res[RenderTarget, Error] {
    val desc: RenderTargetDesc = render_target_desc(RenderFormat.surface{}, count);
    ret render_target_create(d, width, height, ?desc);
}

# Create an offscreen target from an explicit attachment description.
#
# Mixed formats are useful for deferred rendering: display colour can retain
# sRGB precision, normal and mask data can stay linear, and emissive output can
# be floating point, all in one geometry pass.
# ---
# d:      the upload context
# width:  target width in pixels, positive
# height: target height in pixels, positive
# desc:   attachment count and formats; nil means one surface-format attachment
# ret:    the render target, or a creation error
pub fun render_target_create(d: *Device, width: i32, height: i32,
    desc: *RenderTargetDesc) res[RenderTarget, Error] {
    var t: RenderTarget;
    t.ready       = false;
    t.width       = width;
    t.height      = height;
    t.color_count = 1;
    if (desc != nil)                           { t.color_count = desc.color_count; }
    if (t.color_count == 0)                    { t.color_count = 1; }
    if (t.color_count > MAX_COLOR_ATTACHMENTS) { t.color_count = MAX_COLOR_ATTACHMENTS; }

    if (!d.ready) {
        ret res[RenderTarget, Error].err{Error.uninitialized{Stage.upload{}}};
    }
    if (width <= 0 || height <= 0) {
        ret res[RenderTarget, Error].err{Error.target{TargetError.dimensions{}}};
    }

    var vk_formats: [4]i32;
    var ci:         usize = 0;
    for (ci < t.color_count) {
        var public_format: RenderFormat = RenderFormat.surface{};
        if (desc != nil) { public_format = desc.formats[ci]; }
        val format: i32 = render_vk_format(d, public_format);
        if (!render_format_supported(d, format)) {
            render_target_delete(d, ?t);
            ret res[RenderTarget, Error].err{Error.target{TargetError.format_unsupported{}}};
        }
        val cr: err[Error] = image_init(?t.colors[ci].image, d.vk, width::u32, height::u32,
            format, ImageUsage.target{});
        if (sel cr.err) {
            render_target_delete(d, ?t);
            ret res[RenderTarget, Error].err{cr.err};
        }
        t.formats[ci]       = public_format;
        vk_formats[ci]      = format;
        t.colors[ci].width  = width;
        t.colors[ci].height = height;
        ci                  = ci + 1;
    }
    t.compatibility = pass_compatibility(?vk_formats[0], t.color_count);

    # Put the colour image into a readable layout before anything draws into it.
    # A game is free to sample a target on the first frame, before its first
    # render pass has run; without this the image is in UNDEFINED while the
    # descriptor claims SHADER_READ_ONLY_OPTIMAL, which is a lie about the
    # layout rather than merely undefined contents. The render pass's own
    # initialLayout is UNDEFINED, so this costs nothing afterwards.
    var ti: usize = 0;
    for (ti < t.color_count) {
        val tir: err[Error] = image_transition(?t.colors[ti].image, d.vk, d.pool,
            vk.IMAGE_LAYOUT_UNDEFINED,
            vk.IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
        if (sel tir.err) {
            render_target_delete(d, ?t);
            ret res[RenderTarget, Error].err{tir.err};
        }
        ti = ti + 1;
    }

    val dr: err[Error] = depth_attachment_init(?t.depth, d.vk, width, height);
    if (sel dr.err) {
        render_target_delete(d, ?t);
        ret res[RenderTarget, Error].err{dr.err};
    }

    val pr: err[Error] = make_pass(?t, d.vk);
    if (sel pr.err) {
        render_target_delete(d, ?t);
        ret res[RenderTarget, Error].err{pr.err};
    }

    # DEPTH LAST, matching pass_create's attachment ordering. A framebuffer
    # whose views are in a different order than its render pass's attachments
    # binds the depth image as a colour target and renders nothing visible.
    var views: [5]vk.ImageView;
    var vi:    usize = 0;
    for (vi < t.color_count) {
        views[vi] = t.colors[vi].image.view;
        vi        = vi + 1;
    }
    views[t.color_count] = t.depth.view;

    var fci: vk.FramebufferCreateInfo;
    fci.sType           = vk.STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
    fci.pNext           = nil;
    fci.flags           = 0;
    fci.renderPass      = t.pass;
    fci.attachmentCount = (t.color_count + 1)::u32;
    fci.pAttachments    = ?views[0];
    fci.width           = width::u32;
    fci.height          = height::u32;
    fci.layers          = 1;
    val framed: i32 = vk.vkCreateFramebuffer(d.vk.device, ?fci, nil, ?t.framebuffer);
    if (framed != vk.SUCCESS) {
        t.framebuffer = nil;
        render_target_delete(d, ?t);
        ret res[RenderTarget, Error].err{vk_failed(VkCall.create_framebuffer{}, framed)};
    }

    t.ready = true;
    ret res[RenderTarget, Error].ok{t};
}

# the color attachment, sampleable as a Texture
# ---
# t:   the render target
# ret: pointer to the color texture, valid while the target lives
pub fun render_target_texture(t: *RenderTarget) *Texture {
    ret ?t.colors[0];
}

# one of several colour attachments, sampleable as a Texture
#
# An index past the target's count returns the first attachment rather than
# addressing whatever is next in memory, so a caller that miscounts samples the
# wrong picture instead of reading past the record.
# ---
# t:   the render target
# i:   the attachment index, below the target's count
# ret: pointer to that colour texture, valid while the target lives
pub fun render_target_texture_at(t: *RenderTarget, i: usize) *Texture {
    if (i >= t.color_count) { ret ?t.colors[0]; }
    ret ?t.colors[i];
}

# how many colour attachments this target writes
pub fun render_target_count(t: *RenderTarget) usize {
    ret t.color_count;
}

# The declared format of one colour attachment.
pub fun render_target_format_at(t: *RenderTarget, i: usize) RenderFormat {
    if (i >= t.color_count) { ret t.formats[0]; }
    ret t.formats[i];
}

# The byte size required for raw readback of one attachment, or none for an
# index past the count or a format without a raw layout.
pub fun render_target_raw_bytes_at(t: *RenderTarget, i: usize) opt[usize] {
    if (i >= t.color_count) { ret opt[usize].none{}; }
    ret image_raw_bytes(?t.colors[i].image);
}

# copy the target's rendered pixels back to host memory, as tightly packed RGBA8
#
# The bytes are in the first colour attachment's four-byte format. A surface
# target may be B8G8R8A8 or R8G8B8A8; render_target_bgra reports which. Wider
# formats are refused here and read with render_target_read_raw_at instead.
#
# A DEBUGGING AND TOOLING FACILITY, NOT A FRAME OPERATION. The read drains the
# device before it copies, so everything the GPU has been given retires first
# and the pipeline refills from empty afterwards. That stall is what buys a
# picture that is whole rather than one assembled while a pass was still writing
# it, and it is worth paying for a screenshot, a rendering test, or a probe a
# developer is watching. A shipping game does not read a target every frame.
#
# IT REPORTS THE LAST SUBMITTED FRAME. A pass records into the frame's command
# buffer and renderer_end_frame is what submits it, so a read taken between
# renderer_begin_frame and renderer_end_frame does not include what the open
# frame has drawn: it hands back the frame before it, complete. Draining cannot
# change that and neither can anything else here, since those commands are not
# on the queue yet. End the frame first when the current one's draws are the
# point.
# ---
# d:   the upload context the target was created against
# t:   the target to read
# out: destination for width * height * 4 bytes
# len: size of out in bytes
# ret: ok, or a readback error
pub fun render_target_read(d: *Device, t: *RenderTarget, out: *u8, len: usize) err[Error] {
    if (!t.ready) {
        ret err[Error].err{Error.image{ImageError.not_created{}}};
    }
    val texel: opt[usize] = image_format_bytes(t.colors[0].image.format);
    if (sel texel.none)  { ret err[Error].err{Error.target{TargetError.readback_format{}}}; }
    if (texel.some != 4) { ret err[Error].err{Error.target{TargetError.readback_format{}}}; }
    ret image_read(?t.colors[0].image, d.vk, d.pool, out, len);
}

# Copy one attachment back in its native packed format.
#
# RGBA8 attachments occupy four bytes per texel. RENDER_RGBA16_FLOAT occupies
# eight bytes per texel as four IEEE 754 half-floats. Query the required size
# with render_target_raw_bytes_at before allocating the destination.
#
# Carries the stall and the last-submitted-frame contract render_target_read
# describes, which govern every readback rather than that one entry point.
# ---
# d:   the upload context the target was created against
# t:   the target to read
# i:   the attachment index, below the target's count
# out: destination for render_target_raw_bytes_at bytes
# len: size of out in bytes
# ret: ok, or a readback error
pub fun render_target_read_raw_at(d: *Device, t: *RenderTarget, i: usize,
    out: *u8, len: usize) err[Error] {
    if (!t.ready) {
        ret err[Error].err{Error.image{ImageError.not_created{}}};
    }
    if (i >= t.color_count) {
        ret err[Error].err{Error.target{TargetError.attachment{i}}};
    }
    ret image_read(?t.colors[i].image, d.vk, d.pool, out, len);
}

# whether a target's pixels come back blue-green-red-alpha rather than RGBA
#
# The order follows the surface format, which is the surface's choice and not
# boom's. Exposed rather than assumed, because a caller that guesses gets a
# picture with red and blue swapped and no diagnostic.
pub fun render_target_bgra(t: *RenderTarget) bool {
    ret t.colors[0].image.format == vk.FORMAT_B8G8R8A8_SRGB
        || t.colors[0].image.format == vk.FORMAT_B8G8R8A8_UNORM;
}

# release the target's images, render pass, and framebuffer
#
# Call before renderer_dnit: the delete waits on the device, which is gone after.
# ---
# d: the upload context the target was created against
# t: target to delete; the handle must not be used afterward
pub fun render_target_delete(d: *Device, t: *RenderTarget) {
    val v: *Vk = d.vk;
    vk_wait_idle(v);
    if (t.framebuffer != nil) {
        vk.vkDestroyFramebuffer(v.device, t.framebuffer, nil);
        t.framebuffer = nil;
    }
    if (t.pass != nil) {
        vk.vkDestroyRenderPass(v.device, t.pass, nil);
        t.pass = nil;
    }
    if (t.pass_load != nil) {
        vk.vkDestroyRenderPass(v.device, t.pass_load, nil);
        t.pass_load = nil;
    }
    depth_attachment_dnit(?t.depth, v);
    var di: usize = 0;
    for (di < MAX_COLOR_ATTACHMENTS) {
        image_dnit(?t.colors[di].image, v);
        di = di + 1;
    }
    t.ready = false;
}

# --------------------------------------------------------------------- tests
#
# creation needs a device, so these cover the argument checks and the
# teardown ordering, which is where a mistake destroys an object that is
# still referenced by another. A readback's checks are ordering too: they
# run before the device is drained, so a read that cannot succeed does not
# stall the pipeline to say so.

fun bad_dimensions(r: res[RenderTarget, Error]) bool {
    ret sel r.err && (sel r.err.target && sel r.err.target.dimensions);
}

fun refused(r: err[Error]) bool {
    ret sel r.err;
}

test "target: non-positive dimensions are refused before allocating" {
    var d: Device;
    d.ready = true;
    if (!bad_dimensions(render_target(?d, 0, 16)))  { ret 1; }
    if (!bad_dimensions(render_target(?d, 16, 0)))  { ret 2; }
    if (!bad_dimensions(render_target(?d, -1, -1))) { ret 3; }
    ret 0;
}

test "target: creation against an uninitialized context is refused" {
    var d: Device;
    d.ready = false;
    val r: res[RenderTarget, Error] = render_target(?d, 16, 16);
    if (!sel r.err)               { ret 1; }
    if (!sel r.err.uninitialized) { ret 2; }
    ret 0;
}

test "target: descriptions preserve mixed attachment formats" {
    var formats: [4]RenderFormat;
    formats[0] = RenderFormat.rgba8_srgb{};
    formats[1] = RenderFormat.rgba8_unorm{};
    formats[2] = RenderFormat.rgba16_float{};
    val d: RenderTargetDesc = render_target_desc_mrt(?formats[0], 3);
    if (d.color_count != 3)                     { ret 1; }
    if (!sel d.formats[0].rgba8_srgb)           { ret 2; }
    if (!sel d.formats[1].rgba8_unorm)          { ret 3; }
    if (!sel d.formats[2].rgba16_float)         { ret 4; }
    if (render_format_bytes(d.formats[0]) != 4) { ret 5; }
    if (render_format_bytes(d.formats[2]) != 8) { ret 6; }
    ret 0;
}

test "target: teardown on a target that was never created is a no-op" {
    var t: RenderTarget;
    t.framebuffer = nil;
    t.pass        = nil;
    t.pass_load   = nil;
    t.depth.view  = nil;
    t.depth.image = nil;
    t.depth.mem   = nil;
    var zi: usize = 0;
    for (zi < MAX_COLOR_ATTACHMENTS) {
        t.colors[zi].image.view   = nil;
        t.colors[zi].image.handle = nil;
        t.colors[zi].image.memory = nil;
        zi                        = zi + 1;
    }
    t.ready = false;

    var v: Vk;
    v.ready = false;
    var d: Device;
    d.vk    = ?v;
    d.ready = true;
    render_target_delete(?d, ?t);
    if (t.ready) { ret 1; }
    ret 0;
}

test "target: the depth format is one every implementation must support" {
    # D32_SFLOAT is mandatory as a depth-stencil attachment, so it needs no
    # query. A format chosen without checking support is a startup failure on
    # hardware that is behaving correctly.
    if (DEPTH_FORMAT != vk.FORMAT_D32_SFLOAT) { ret 1; }
    ret 0;
}

test "target: a fresh multi-attachment target reports its count" {
    # render_target_count is what the renderer uses to size clear values and to
    # decide a pipeline's blend attachments, so a wrong count here is a
    # validation failure at the first draw rather than anything visible.
    var t: RenderTarget;
    t.color_count = 4;
    if (render_target_count(?t) != 4) { ret 1; }
    t.color_count = 1;
    if (render_target_count(?t) != 1) { ret 2; }
    ret 0;
}

test "target: an attachment index past the count returns the first" {
    # Reading past color_count would address whatever follows the array in the
    # record and hand back a Texture built from adjacent fields, which samples
    # as garbage rather than failing.
    var t: RenderTarget;
    t.color_count     = 2;
    t.colors[0].width = 11;
    t.colors[1].width = 22;
    t.colors[2].width = 33;

    if (render_target_texture_at(?t, 0).width != 11)  { ret 1; }
    if (render_target_texture_at(?t, 1).width != 22)  { ret 2; }
    if (render_target_texture_at(?t, 2).width != 11)  { ret 3; }
    if (render_target_texture_at(?t, 99).width != 11) { ret 4; }

    # And the single-attachment accessor is the first one.
    if (render_target_texture(?t) != render_target_texture_at(?t, 0)) { ret 5; }
    ret 0;
}

test "target: a read of a target that was never created is refused" {
    # Answered from the handle, before the drain and before a staging buffer
    # exists. The device here never came up, which is what proves the read got
    # nowhere near it.
    var v: Vk;
    v.ready = false;
    var d: Device;
    d.vk    = ?v;
    d.ready = true;

    var t: RenderTarget;
    t.ready       = false;
    t.color_count = 1;

    var out: [16]u8;
    if (!refused(render_target_read(?d, ?t, ?out[0], 16)))           { ret 1; }
    if (!refused(render_target_read_raw_at(?d, ?t, 0, ?out[0], 16))) { ret 2; }
    ret 0;
}

test "target: a raw read past the attachment count is refused" {
    # render_target_texture_at clamps a bad index because sampling the wrong
    # picture is recoverable. A read cannot clamp: the caller sized its
    # destination from render_target_raw_bytes_at for the attachment it named,
    # so quietly copying a different one either overflows that buffer or fills
    # it with the wrong image and reports success.
    var v: Vk;
    v.ready = false;
    var d: Device;
    d.vk    = ?v;
    d.ready = true;

    var t: RenderTarget;
    t.ready       = true;
    t.color_count = 1;

    var out: [16]u8;
    if (!refused(render_target_read_raw_at(?d, ?t, 1, ?out[0], 16)))  { ret 1; }
    if (!refused(render_target_read_raw_at(?d, ?t, 99, ?out[0], 16))) { ret 2; }
    ret 0;
}

test "target: the packed read refuses a format it cannot pack" {
    # RENDER_RGBA16_FLOAT is eight bytes a texel and render_target_read promises
    # four. The attachment is otherwise ready to be copied, so this check is the
    # only thing standing between the call and a copy that would deliver half a
    # picture and report success.
    var v: Vk;
    v.ready = false;
    var d: Device;
    d.vk    = ?v;
    d.ready = true;

    var t: RenderTarget;
    t.ready                  = true;
    t.color_count            = 1;
    t.formats[0]             = RenderFormat.rgba16_float{};
    t.colors[0].image.format = vk.FORMAT_R16G16B16A16_SFLOAT;
    t.colors[0].image.width  = 2;
    t.colors[0].image.height = 2;
    t.colors[0].image.ready  = true;

    var out: [32]u8;
    if (!refused(render_target_read(?d, ?t, ?out[0], 32))) { ret 1; }
    # And the size the raw form needs comes from the target rather than from a
    # caller assuming four bytes: 2 * 2 * 8.
    val raw: opt[usize] = render_target_raw_bytes_at(?t, 0);
    if (!sel raw.some)  { ret 2; }
    if (raw.some != 32) { ret 3; }
    ret 0;
}
