# Vulkan device bring-up: instance, surface, physical device, and queues.
#
# The first of the three shader-independent steps of the Vulkan migration. It
# stops short of the swapchain so that each piece lands verified rather than as
# one unrunnable block.
#
# The bootstrap entry point comes from GLFW's own declaration rather than a
# local ext fun. A consumer-declared #[library("glfw")] does not bind against
# the dependency's exported link entry (mach#2800), so the alternative would be
# restating a [link.glfw] in this manifest describing a library boom does not
# own. Routing through the binding avoids that and is correct regardless.
#
# GLFW owns the window and therefore the surface, so the required instance
# extensions come from it rather than a hardcoded list. Hardcoding
# VK_KHR_xcb_surface or VK_KHR_win32_surface would be wrong on the first
# platform that uses a different windowing system, including Wayland, which is
# already reachable through the same GLFW build.
#
# Queue families are selected by capability, not index. A graphics-capable
# family and a present-capable family are frequently the same one and are not
# required to be, so both are resolved independently and may coincide.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use vk;
use glfw.glfw;
use gc: glfw.c;
use boom.graphics.error.Error;
use boom.graphics.error.error;

# A queue family index, or NO_FAMILY when none was found.
pub val NO_FAMILY: u32 = 0xFFFFFFFF;

# Packed API versions, as (major << 22) | (minor << 12) | patch.
#
# Defined here because mach-vk generates declarations from the registry and the
# version macros are not declarations.
val API_VERSION_1_0: u32 = 0x00400000;
val API_VERSION_1_3: u32 = 0x00403000;

# The portability extensions, and the instance flag that opts into the first.
#
# Defined here because mach-vk emits a curated set of extension names rather
# than every one the registry lists, and neither of these is among them. Spelled
# as mach-vk spells KHR_SWAPCHAIN_EXTENSION_NAME: the registry's name without
# the VK_ prefix the generator drops.
val INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR: u32 = 0x00000001;
val KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME: *u8 = "VK_KHR_portability_enumeration";
val KHR_PORTABILITY_SUBSET_EXTENSION_NAME: *u8 = "VK_KHR_portability_subset";

# The version the instance requests.
#
# 1.3, NOT 1.0. Mach emits SPIR-V 1.6, and the SPIR-V version a driver will
# accept is fixed by the API version the instance declared: 1.0 permits only
# SPIR-V 1.0. Requesting 1.0 and handing over 1.6 is rejected by
# vkCreateShaderModule under validation and is undefined without it, which is
# why it went unnoticed — the drivers tested happened to accept the module and
# render correctly anyway.
#
# vkEnumerateInstanceVersion is itself a 1.1 entry point and is absent on a 1.0
# loader, so a nil there is the loader saying it is 1.0. In that case the
# request drops to 1.0 and instance creation proceeds; shader module creation is
# then the thing that fails, with a message naming the version, rather than the
# instance failing with one that does not.
# name one failed Vulkan call after the result it actually returned
#
# a bring-up failure that says only "failed" costs a report-and-reply round
# trip to learn whether the machine lacks a driver or the request was wrong.
# the common results are named; anything else keeps the bare call name.
# ---
# call: the Vulkan entry point that failed
# code: the VkResult it returned
# ret:  a static message naming both
fun result_name(call: str, code: i32) str {
    if (code == vk.ERROR_INCOMPATIBLE_DRIVER) {
        if (same(call, "vkCreateInstance")) {
            ret "vkCreateInstance: VK_ERROR_INCOMPATIBLE_DRIVER (no Vulkan-capable graphics driver on this machine)";
        }
        ret "vkCreateDevice: VK_ERROR_INCOMPATIBLE_DRIVER";
    }
    if (code == vk.ERROR_EXTENSION_NOT_PRESENT) {
        if (same(call, "vkCreateInstance")) {
            ret "vkCreateInstance: VK_ERROR_EXTENSION_NOT_PRESENT";
        }
        ret "vkCreateDevice: VK_ERROR_EXTENSION_NOT_PRESENT";
    }
    if (code == vk.ERROR_LAYER_NOT_PRESENT) {
        if (same(call, "vkCreateInstance")) {
            ret "vkCreateInstance: VK_ERROR_LAYER_NOT_PRESENT";
        }
        ret "vkCreateDevice: VK_ERROR_LAYER_NOT_PRESENT";
    }
    if (code == vk.ERROR_INITIALIZATION_FAILED) {
        if (same(call, "vkCreateInstance")) {
            ret "vkCreateInstance: VK_ERROR_INITIALIZATION_FAILED";
        }
        ret "vkCreateDevice: VK_ERROR_INITIALIZATION_FAILED";
    }
    if (code == vk.ERROR_OUT_OF_HOST_MEMORY
        || code == vk.ERROR_OUT_OF_DEVICE_MEMORY) {
        if (same(call, "vkCreateInstance")) {
            ret "vkCreateInstance: out of memory";
        }
        ret "vkCreateDevice: out of memory";
    }
    if (code == vk.ERROR_FEATURE_NOT_PRESENT) {
        ret "vkCreateDevice: VK_ERROR_FEATURE_NOT_PRESENT";
    }
    if (same(call, "vkCreateInstance")) {
        ret "vkCreateInstance failed with an unlisted VkResult";
    }
    ret "vkCreateDevice failed with an unlisted VkResult";
}

fun same(a: str, b: str) bool {
    var i: usize = 0;
    for (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret a[i] == b[i];
}

fun requested_api_version() u32 {
    if (vk.vkEnumerateInstanceVersion == nil) { ret API_VERSION_1_0; }
    var supported: u32 = 0;
    if (vk.vkEnumerateInstanceVersion(?supported) != vk.SUCCESS) { ret API_VERSION_1_0; }
    if (supported < API_VERSION_1_3) { ret supported; }
    ret API_VERSION_1_3;
}

# The device-level objects a renderer needs before it can build a swapchain.
# ---
# instance:       The Vulkan instance.
# surface:        The window surface. GLFW hands it back as a u64 because a
#                 non-dispatchable handle is 64-bit everywhere; mach-vk types it
#                 as ptr, so the conversion happens once, here.
# physical:       The selected physical device.
# device:         The logical device.
# graphics_queue: Queue for draw submission.
# present_queue:  Queue for presentation; may equal graphics_queue.
# graphics_family: Family index behind graphics_queue.
# present_family:  Family index behind present_queue.
# ready:          Whether bring-up completed.
pub rec Vk {
    instance:        vk.Instance;
    surface:         vk.SurfaceKHR;
    physical:        vk.PhysicalDevice;
    device:          vk.Device;
    graphics_queue:  vk.Queue;
    present_queue:   vk.Queue;
    graphics_family: u32;
    present_family:  u32;
    color_format:    i32;
    color_space:     i32;
    ready:           bool;
}

# Create the instance, surface, device, and queues for a window.
#
# The window must have been created with the client API hint set to none;
# a window carrying a GL context cannot back a Vulkan surface.
pub fun vk_init(v: *Vk, window: glfw.Window, app_name: str) Result[bool, Error] {
    v.ready           = false;
    v.graphics_family = NO_FAMILY;
    v.present_family  = NO_FAMILY;

    if (!glfw.vulkan_supported()) {
        ret err[bool, Error](error("no Vulkan loader or ICD available"));
    }

    if (vk.load_global(gc.glfwGetInstanceProcAddress:~vk.GetInstanceProcAddr) <= 0) {
        ret err[bool, Error](error("could not resolve global Vulkan commands"));
    }

    # The surface extensions GLFW requires for this platform. An instance
    # created without them cannot present.
    var ext_count: u32 = 0;
    val exts: **u8 = glfw.required_instance_extensions(?ext_count);
    if (exts == nil || ext_count == 0) {
        ret err[bool, Error](error("GLFW reported no required instance extensions"));
    }

    # GLFW's list plus whatever the platform adds, in a fixed array rather than
    # an allocated one. GLFW asks for two on every platform boom targets, the
    # generic surface and one platform surface, and boom adds at most one on
    # top, so fifteen is several times what any of them needs and the sixteenth
    # slot is held for that one.
    #
    # FIXED BECAUSE THE ALLOCATING VERSION FAILS QUIETLY. A growable list has an
    # allocation that can fail, and the only place to notice is the push, which
    # is one call deep in the thing that should have been a list of names. Miss
    # it and the instance is created with no extensions at all, which succeeds,
    # and the first call to fail is the surface: a report three steps downstream
    # of the cause and pointing at the wrong subsystem. A bound that can be
    # refused here says what actually went wrong.
    if (ext_count > 15) {
        ret err[bool, Error](error("GLFW requires more instance extensions than boom can enable"));
    }
    var enabled: [16]*u8;
    var enabled_count: u32 = 0;
    for (enabled_count < ext_count) {
        enabled[enabled_count] = exts[enabled_count];
        enabled_count = enabled_count + 1;
    }

    $if ($mach.build.os == $mach.os.darwin) {
        # VULKAN ON MACOS IS A TRANSLATION LAYER, NOT A DRIVER. Apple ships
        # Metal and no Vulkan implementation, so what runs there is MoltenVK: a
        # Vulkan front end that lowers to Metal underneath. Metal cannot express
        # all of Vulkan, so MoltenVK identifies itself as a portability
        # implementation rather than a complete one, and the loader keeps those
        # away from an application that has not said it can cope with one. It
        # does not hide them at enumeration, it refuses the instance, which is
        # why a macOS build without this fails at vkCreateInstance rather than
        # at device selection, with a message that names nothing to do with
        # portability.
        enabled[enabled_count] = KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME;
        enabled_count = enabled_count + 1;
    }

    var app: vk.ApplicationInfo;
    app.sType              = vk.STRUCTURE_TYPE_APPLICATION_INFO;
    app.pNext              = nil;
    app.pApplicationName   = app_name;
    app.applicationVersion = 0;
    app.pEngineName        = "boom";
    app.engineVersion      = 0;
    app.apiVersion         = requested_api_version();

    var ici: vk.InstanceCreateInfo;
    ici.sType                   = vk.STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
    ici.pNext                   = nil;
    ici.flags                   = 0;
    ici.pApplicationInfo        = ?app;
    ici.enabledLayerCount       = 0;
    ici.ppEnabledLayerNames     = nil;
    ici.enabledExtensionCount   = enabled_count;
    ici.ppEnabledExtensionNames = ?enabled[0];
    $if ($mach.build.os == $mach.os.darwin) {
        # THE FLAG AND THE EXTENSION ABOVE ARE ONE THING WRITTEN IN TWO PLACES.
        # The extension is what makes this bit legal to pass, since a flag
        # belonging to an extension the instance did not enable is invalid
        # usage, and the bit is what actually opts the enumeration in. The
        # extension alone changes nothing and the bit alone is rejected, so
        # neither is meaningful without the other and adding one without the
        # other is always a mistake.
        ici.flags = ici.flags | INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR;
    }

    val made: i32 = vk.vkCreateInstance(?ici, nil, ?v.instance);
    if (made != vk.SUCCESS) {
        ret err[bool, Error](error(result_name("vkCreateInstance", made)));
    }
    if (vk.load_instance(gc.glfwGetInstanceProcAddress:~vk.GetInstanceProcAddr, v.instance::ptr) <= 0) {
        ret err[bool, Error](error("could not resolve instance Vulkan commands"));
    }

    var raw_surface: u64 = 0;
    if (!glfw.create_window_surface(v.instance::ptr, window, ?raw_surface)) {
        ret err[bool, Error](error("could not create a window surface"));
    }
    v.surface = raw_surface::vk.SurfaceKHR;

    val pr: Result[bool, Error] = pick_physical(v);
    if (is_err[bool, Error](pr)) { ret pr; }

    val dr: Result[bool, Error] = create_device(v);
    if (is_err[bool, Error](dr)) { ret dr; }

    # THE COLOUR FORMAT IS THE SURFACE'S, AND IT IS PICKED ONCE, HERE. It is a
    # property of the surface, which this module owns, and three separate things
    # need to agree on it: the swapchain's images, any offscreen target that a
    # pipeline is shared with, and the renderer's report of whether the colour
    # pipeline closes. Two Vulkan render passes are compatible only when their
    # attachment formats match, so a target that picked its own format would be
    # incompatible with the window pass and every draw into it would be rejected.
    # Deriving it in one place makes that agreement structural rather than a
    # convention each caller has to remember.
    var fmt: vk.SurfaceFormatKHR;
    if (!pick_format(v, ?fmt)) {
        ret err[bool, Error](error("surface reported no formats"));
    }
    v.color_format = fmt.format;
    v.color_space  = fmt.colorSpace;

    v.ready = true;
    ret ok[bool, Error](true);
}

# Pick a surface format, preferring 8-bit sRGB.
#
# Falls back to the first format the surface reports rather than failing. Every
# surface offers at least one, and a renderer that insists on a preferred format
# cannot start on hardware that does not offer it.
fun pick_format(v: *Vk, out: *vk.SurfaceFormatKHR) bool {
    var count: u32 = 0;
    if (!enumerated(vk.vkGetPhysicalDeviceSurfaceFormatsKHR(v.physical, v.surface, ?count, nil))) {
        ret false;
    }
    if (count == 0) { ret false; }

    var formats: [32]vk.SurfaceFormatKHR;
    var cap: u32 = 32;
    if (count < cap) { cap = count; }
    if (!enumerated(vk.vkGetPhysicalDeviceSurfaceFormatsKHR(v.physical, v.surface, ?cap, ?formats[0]))) {
        ret false;
    }

    # AN sRGB SURFACE IS WHAT MAKES THE COLOUR PIPELINE CLOSE. Textures are
    # sampled through sRGB image formats, so the shader works in linear light;
    # an sRGB surface format is what encodes the result on write. Either variant
    # does that, and every desktop driver offers one, so both are preferred over
    # whatever happens to be first.
    var i: u32 = 0;
    for (i < cap) {
        if (formats[i].format == vk.FORMAT_B8G8R8A8_SRGB
            || formats[i].format == vk.FORMAT_R8G8B8A8_SRGB) {
            @out = formats[i];
            ret true;
        }
        i = i + 1;
    }

    # A surface offering no sRGB format at all. Taking the first one keeps the
    # renderer working; it does not encode, so colours come out darker than
    # authored. Reporting it is the caller's job, since there is nothing better
    # to do about it here.
    @out = formats[0];
    ret true;
}

# Whether a surface format encodes sRGB on write.
#
# Pure, and the thing worth asserting: the whole colour pipeline assumes the
# encode happens exactly once, at the surface.
pub fun format_is_srgb(format: i32) bool {
    ret format == vk.FORMAT_B8G8R8A8_SRGB || format == vk.FORMAT_R8G8B8A8_SRGB;
}

# Wait until the device has finished everything submitted to it.
#
# Destroying a Vulkan object that a submitted command buffer still references is
# undefined behaviour, and the frame loop runs up to MAX_FRAMES_IN_FLIGHT frames
# ahead, so a resource deleted "after the last draw" may still be in use. Every
# public delete waits first.
#
# A conservative stall, not the eventual design. The right answer for a resource
# freed mid-game is a deletion queue retired behind the frame fences, which frees
# without stalling. This is correct today and costs nothing where deletion
# happens: loading screens and shutdown.
pub fun vk_wait_idle(v: *Vk) {
    if (v == nil || !v.ready) { ret; }
    vk.vkDeviceWaitIdle(v.device);
}

# Choose a physical device that can both draw and present to the surface.
#
# The first device satisfying both is taken. Preferring a discrete GPU is a
# refinement, not a correctness matter, and is deliberately left out until
# there is a reason to rank devices.
fun pick_physical(v: *Vk) Result[bool, Error] {
    var count: u32 = 0;
    if (!enumerated(vk.vkEnumeratePhysicalDevices(v.instance, ?count, nil)) || count == 0) {
        ret err[bool, Error](error("no Vulkan physical devices"));
    }

    var devices: [16]vk.PhysicalDevice;
    var cap: u32 = 16;
    if (count < cap) { cap = count; }
    if (!enumerated(vk.vkEnumeratePhysicalDevices(v.instance, ?cap, ?devices[0]))) {
        ret err[bool, Error](error("could not enumerate physical devices"));
    }

    var i: u32 = 0;
    for (i < cap) {
        val d: vk.PhysicalDevice = devices[i];
        var g: u32 = NO_FAMILY;
        var p: u32 = NO_FAMILY;
        find_families(v, d, ?g, ?p);
        if (g != NO_FAMILY && p != NO_FAMILY) {
            v.physical        = d;
            v.graphics_family = g;
            v.present_family  = p;
            ret ok[bool, Error](true);
        }
        i = i + 1;
    }
    ret err[bool, Error](error("no device can both render and present to this surface"));
}

# Resolve a graphics-capable and a present-capable family on a device.
#
# They are resolved independently because they are not required to be the same
# family, even though on most hardware they are.
fun find_families(v: *Vk, d: vk.PhysicalDevice, out_g: *u32, out_p: *u32) {
    @out_g = NO_FAMILY;
    @out_p = NO_FAMILY;

    var count: u32 = 0;
    vk.vkGetPhysicalDeviceQueueFamilyProperties(d, ?count, nil);
    if (count == 0) { ret; }

    var props: [16]vk.QueueFamilyProperties;
    var cap: u32 = 16;
    if (count < cap) { cap = count; }
    vk.vkGetPhysicalDeviceQueueFamilyProperties(d, ?cap, ?props[0]);

    var i: u32 = 0;
    for (i < cap) {
        if (@out_g == NO_FAMILY && (props[i].queueFlags & vk.QUEUE_GRAPHICS_BIT) != 0) {
            @out_g = i;
        }
        if (@out_p == NO_FAMILY) {
            var supported: u32 = 0;
            if (vk.vkGetPhysicalDeviceSurfaceSupportKHR(d, i, v.surface, ?supported) == vk.SUCCESS) {
                if (supported != 0) { @out_p = i; }
            }
        }
        i = i + 1;
    }
}

# Create the logical device and fetch its queues.
fun create_device(v: *Vk) Result[bool, Error] {
    var prio: f32 = 1.0;

    var qci: [2]vk.DeviceQueueCreateInfo;
    qci[0].sType            = vk.STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
    qci[0].pNext            = nil;
    qci[0].flags            = 0;
    qci[0].queueFamilyIndex = v.graphics_family;
    qci[0].queueCount       = 1;
    qci[0].pQueuePriorities = ?prio;

    # One create-info per DISTINCT family. Passing the same family twice is
    # invalid usage, and the two frequently coincide.
    var qcount: u32 = 1;
    if (v.present_family != v.graphics_family) {
        qci[1].sType            = vk.STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
        qci[1].pNext            = nil;
        qci[1].flags            = 0;
        qci[1].queueFamilyIndex = v.present_family;
        qci[1].queueCount       = 1;
        qci[1].pQueuePriorities = ?prio;
        qcount = 2;
    }

    # The device extension list, fixed for the same reason the instance's is.
    # Every entry is decided here rather than reported by anything, so the bound
    # is not a guess: swapchain always, portability_subset on macOS, and eight
    # so that the next one to be needed is a line rather than a resize. What
    # does not go here is an extension boom could do without, for the reason the
    # features paragraph below gives about optional things.
    var enabled: [8]*u8;
    var enabled_count: u32 = 0;
    enabled[enabled_count] = vk.KHR_SWAPCHAIN_EXTENSION_NAME;
    enabled_count = enabled_count + 1;

    $if ($mach.build.os == $mach.os.darwin) {
        # PORTABILITY_SUBSET IS NOT OPTIONAL WHERE IT IS OFFERED. A device
        # advertising it is saying it does not implement all of Vulkan, and the
        # spec requires an application creating that device to enable it, since
        # it is the only way to ask which parts are missing. A device created
        # without it is invalid usage and vkCreateDevice may refuse outright.
        # MoltenVK advertises it on everything it exposes, so on macOS it is
        # never the optional case.
        #
        # GATING ON THE OS IS NOT THE PREDICATE THE SPEC NAMES, and that is a
        # known edge rather than an oversight. The rule is about what the device
        # advertises, not what the host runs, so a macOS box driving lavapipe or
        # SwiftShader is handed an extension its device never offered and gets a
        # bare "vkCreateDevice failed" with nothing to point at. boom does not
        # enumerate device extensions anywhere yet, and adding that machinery
        # for one call site would be the wrong order to build it in. When there
        # is a second caller this becomes a query against
        # vkEnumerateDeviceExtensionProperties and the $if goes away.
        enabled[enabled_count] = KHR_PORTABILITY_SUBSET_EXTENSION_NAME;
        enabled_count = enabled_count + 1;
    }

    # NO OPTIONAL FEATURES, AND THAT IS A CLAIM ABOUT THE SHADERS. A device is
    # created with every optional feature off, and using one that was not
    # enabled is invalid usage a driver may honour anyway, so a shader that
    # quietly needs one is a bug that only appears on someone else's machine.
    #
    # boom needed two for a while, both of them artefacts of how the skinned
    # stage was emitted rather than of anything it does: the palette index
    # arithmetic lowered to 64-bit locals and declared Int64 (mach#2878), and a
    # storage buffer that is only ever read was not decorated NonWritable, so a
    # driver had to assume the vertex stage might write it (mach#2879). Both are
    # fixed as of mach 4.18.0, and the emitted modules are what says so:
    # boom.graphics.spirv reads every module's capabilities and fails on
    # anything past Shader, which is what keeps this honest without a GPU.
    #
    # A feature that is genuinely needed goes here, requested by name and
    # checked for support first. Handing back the supported set is legal and
    # wrong: it hides what the engine depends on, so the first device missing
    # something fails far from the reason.

    var dci: vk.DeviceCreateInfo;
    dci.sType                   = vk.STRUCTURE_TYPE_DEVICE_CREATE_INFO;
    dci.pNext                   = nil;
    dci.flags                   = 0;
    dci.queueCreateInfoCount    = qcount;
    dci.pQueueCreateInfos       = ?qci[0];
    dci.enabledLayerCount       = 0;
    dci.ppEnabledLayerNames     = nil;
    dci.enabledExtensionCount   = enabled_count;
    dci.ppEnabledExtensionNames = ?enabled[0];
    dci.pEnabledFeatures        = nil;

    val built: i32 = vk.vkCreateDevice(v.physical, ?dci, nil, ?v.device);
    if (built != vk.SUCCESS) {
        ret err[bool, Error](error(result_name("vkCreateDevice", built)));
    }
    # THE DEVICE LOADER'S BOOTSTRAP COMES FROM THE INSTANCE, NOT FROM ITSELF.
    # mach-vk's `vkGetDeviceProcAddr` global is *set by* load_device, so passing
    # it in is passing nil and load_device calls it immediately: a jump to
    # address zero on the first device ever created. The bootstrap has to be
    # resolved the same way the instance loader's was, through the platform
    # loader against the instance.
    val raw_gdpa: ptr = gc.glfwGetInstanceProcAddress(v.instance::ptr, "vkGetDeviceProcAddr"::*u8);
    if (raw_gdpa == nil) {
        ret err[bool, Error](error("the loader does not provide vkGetDeviceProcAddr"));
    }
    if (vk.load_device(raw_gdpa:~vk.GetDeviceProcAddr, v.device::ptr) <= 0) {
        ret err[bool, Error](error("could not resolve device Vulkan commands"));
    }

    vk.vkGetDeviceQueue(v.device, v.graphics_family, 0, ?v.graphics_queue);
    vk.vkGetDeviceQueue(v.device, v.present_family, 0, ?v.present_queue);
    ret ok[bool, Error](true);
}

# Whether an enumeration call succeeded, counting a truncated result as success.
#
# VK_INCOMPLETE IS NOT A FAILURE. An enumeration given an array smaller than the
# full result fills what fits and returns VK_INCOMPLETE. boom's enumerations read
# into fixed arrays and only ever want a preferred entry out of them, so a
# truncated list is exactly as useful as a complete one.
#
# Treating it as an error is invisible on hardware whose lists are short and
# fatal on hardware whose lists are long: lavapipe reports 45 surface formats
# where a desktop GPU reports a handful, so the renderer failed to start there
# and nowhere else. That is the worst shape a bug can have.
pub fun enumerated(rc: i32) bool {
    ret rc == vk.SUCCESS || rc == vk.INCOMPLETE;
}

# Tear down in reverse order of creation.
#
# The surface outlives the device and must be destroyed with the instance still
# alive, which is why the order here is not simply the inverse of the record's
# field order.
pub fun vk_dnit(v: *Vk) {
    if (!v.ready) { ret; }
    vk.vkDestroyDevice(v.device, nil);
    vk.vkDestroySurfaceKHR(v.instance, v.surface, nil);
    vk.vkDestroyInstance(v.instance, nil);
    v.ready = false;
}

# --------------------------------------------------------------------- tests
#
# Bring-up needs a Vulkan loader, an ICD, and a window, so vk_init is not
# reachable here. These cover the pure decisions around it.

test "vk: a fresh handle is not ready and has no queue families" {
    var v: Vk;
    v.ready           = false;
    v.graphics_family = NO_FAMILY;
    v.present_family  = NO_FAMILY;
    if (v.ready)                        { ret 1; }
    if (v.graphics_family != NO_FAMILY) { ret 1; }
    # Teardown on a handle that never initialized must be a no-op rather than
    # destroying a device that was never created.
    vk_dnit(?v);
    ret 0;
}

test "vk: the packed API versions decode to the versions they name" {
    # Mach emits SPIR-V 1.6, which a driver only accepts when the instance
    # declared API 1.3 or later. A wrong constant here is accepted by instance
    # creation and rejected later by every vkCreateShaderModule.
    if (API_VERSION_1_3 != 0x00403000)              { ret 1; }
    if ((API_VERSION_1_3 >> 22) != 1)               { ret 2; }
    if (((API_VERSION_1_3 >> 12) & 0x3FF) != 3)     { ret 3; }
    if (API_VERSION_1_3 <= API_VERSION_1_0)         { ret 4; }
    ret 0;
}

test "vk: the packed API version is VK_API_VERSION_1_0" {
    # (1 << 22) | (0 << 12) | 0. A wrong value is accepted by the loader and
    # then silently caps or rejects features later.
    if (API_VERSION_1_0 != 0x00400000)      { ret 1; }
    if ((API_VERSION_1_0 >> 22) != 1)       { ret 1; }
    if (((API_VERSION_1_0 >> 12) & 0x3FF) != 0) { ret 1; }
    ret 0;
}
