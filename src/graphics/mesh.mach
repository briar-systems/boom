# the Mesh handle: GPU vertex and index buffers ready to draw
#
# a game supplies raw interleaved vertex bytes plus a VertexFormat, or a
# .glb file or bytes, and receives an opaque Mesh; the backing mach-vk
# buffers and the mach-gltf loader both stay hidden. a mesh is no longer
# tied to one vertex layout: mesh() binds whatever attributes its format
# declares, and mesh_load builds the format from whatever attributes the
# first primitive of the first mesh provides.
#
# mesh_load reads POSITION (required) and any of NORMAL, TEXCOORD_0,
# COLOR_0, and TANGENT that the primitive carries as float accessors, and
# requires an index buffer. a skinned primitive's JOINTS_0 (an integer
# uvec4, widened to u16) and WEIGHTS_0 (a float vec4) are read too, so
# skinned geometry uploads its joint indices and weights for the skinning
# shader; the animation runtime that drives them lives in
# boom.graphics.skeleton and boom.graphics.animation.

use vk;
use boom.graphics.vk.vk_wait_idle;
use boom.graphics.device.Device;
use boom.graphics.buffer.Buffer;
use boom.graphics.buffer.buffer_upload;
use boom.graphics.buffer.buffer_dnit;
use boom.graphics.error.Error;
use boom.graphics.error.error;
use boom.graphics.vertex.Semantic;
use boom.graphics.vertex.SEMANTIC_POSITION;
use boom.graphics.vertex.SEMANTIC_NORMAL;
use boom.graphics.vertex.SEMANTIC_TEXCOORD_0;
use boom.graphics.vertex.SEMANTIC_COLOR_0;
use boom.graphics.vertex.SEMANTIC_TANGENT;
use boom.graphics.vertex.SEMANTIC_JOINTS_0;
use boom.graphics.vertex.SEMANTIC_WEIGHTS_0;
use boom.graphics.vertex.Component;
use boom.graphics.vertex.COMP_F32;
use boom.graphics.vertex.COMP_U8;
use boom.graphics.vertex.COMP_U16;
use boom.graphics.vertex.COMP_U32;
use boom.graphics.vertex.COMP_I8;
use boom.graphics.vertex.COMP_I16;
use boom.graphics.vertex.VertexAttribute;
use boom.graphics.vertex.VertexFormat;
use boom.graphics.vertex.vertex_format;
use boom.graphics.vertex.vertex_format_add;
use boom.graphics.vertex.vertex_format_standard;
use boom.graphics.vertex.vertex_format_skinned;
use boom.graphics.vertex.attribute_bytes;
use gp: gltf.parse;
use ga: gltf.accessor;
use gd: gltf.doc;
use slice: std.collections.slice;
use fs:    std.filesystem;
use vec:     std.collections.vector;
use allo:  std.allocator;
use page:  std.allocator.page;
use arena: std.allocator.arena;
use std.types.option.Option;
use std.types.option.is_some;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;

# an opaque handle to a drawable mesh
# ---
# vertices:    the device-local vertex buffer, hidden from the game
# indices:     the device-local index buffer
# index_count: number of indices, the count drawn
# format:      the vertex layout the buffers were uploaded with
pub rec Mesh {
    vertices:    Buffer;
    indices:     Buffer;
    index_count: i32;
    format:      VertexFormat;
}

# CPU-side geometry extracted from a glTF primitive, owned by an allocator
# ---
# vertices:     raw interleaved vertex bytes, vertex_count * format.stride
# vertex_count: number of vertices
# format:       the layout describing the interleaved bytes
# indices:      u32 triangle indices
# index_count:  number of indices
pub rec MeshData {
    vertices:     *u8;
    vertex_count: i32;
    format:       VertexFormat;
    indices:      *u32;
    index_count:  i32;
}

# read a little-endian f32 from a byte buffer at off
fun read_f32_at(src: *u8, off: usize) f32 {
    var p: *f32 = (?src[off]):~*f32;
    ret @p;
}

# read a little-endian u16 from a byte buffer at off
fun read_u16_at(src: *u8, off: usize) u16 {
    var p: *u16 = (?src[off]):~*u16;
    ret @p;
}

# upload interleaved vertices and indices to the GPU
#
# copies vertex_count * format.stride bytes and the u32 triangle indices
# into device-local buffers through a staging copy, since geometry is
# written once at load and read every frame. the CPU data need not
# outlive the call.
#
# the format is stored rather than bound. GL described the layout on the
# buffer, through a vertex array object; Vulkan describes it on the
# pipeline. so a Mesh carries its format for a pipeline to be built
# against, and a mesh drawn through a pipeline built for a different
# format is the error boom.graphics.pipeline's vertex_attributes exists
# to make impossible to express by accident.
# ---
# d:            the upload context
# vertices:     raw interleaved vertex bytes
# vertex_count: number of vertices
# format:       the vertex layout
# indices:      triangle index list, three per triangle
# index_count:  number of indices
# ret:          the drawable Mesh handle, or an allocation/upload error
pub fun mesh(d: *Device, vertices: ptr, vertex_count: i32, format: *VertexFormat, indices: *u32, index_count: i32) Result[Mesh, Error] {
    if (!d.ready) {
        ret err[Mesh, Error](error("the upload context is not initialized"));
    }
    if (vertex_count <= 0 || index_count <= 0) {
        ret err[Mesh, Error](error("a mesh needs at least one vertex and one index"));
    }
    if (format.stride == 0) {
        ret err[Mesh, Error](error("the vertex format has a zero stride"));
    }

    var m: Mesh;
    m.format      = @format;
    m.index_count = index_count;

    val vsize: u64 = vertex_count::u64 * format.stride::u64;
    val isize: u64 = index_count::u64 * 4;

    val vr: Result[bool, Error] = buffer_upload(?m.vertices, d.vk, d.pool, vertices:~*u8, vsize,
                                                vk.BUFFER_USAGE_VERTEX_BUFFER_BIT);
    if (is_err[bool, Error](vr)) {
        ret err[Mesh, Error](unwrap_err[bool, Error](vr));
    }

    val ir: Result[bool, Error] = buffer_upload(?m.indices, d.vk, d.pool, indices:~*u8, isize,
                                                vk.BUFFER_USAGE_INDEX_BUFFER_BIT);
    if (is_err[bool, Error](ir)) {
        buffer_dnit(?m.vertices, d.vk);
        ret err[Mesh, Error](unwrap_err[bool, Error](ir));
    }
    ret ok[Mesh, Error](m);
}

# record an indexed triangle draw for a mesh
#
# binds the mesh's vertex and index buffers and issues the draw. the
# caller binds the pipeline and its descriptor sets first, because in
# Vulkan those are pipeline state rather than something a draw carries.
# ---
# m:   mesh to draw
# cmd: the command buffer being recorded
pub fun mesh_draw(m: *Mesh, cmd: vk.CommandBuffer) {
    var vb:     vk.Buffer = m.vertices.handle;
    var offset: u64 = 0;
    vk.vkCmdBindVertexBuffers(cmd, 0, 1, ?vb, ?offset);
    # 32-bit indices, matching what the loader produces. A mesh past 65535
    # vertices is ordinary, so narrowing to 16 would be a silent corruption
    # on exactly the models that matter.
    vk.vkCmdBindIndexBuffer(cmd, m.indices.handle, 0, vk.INDEX_TYPE_UINT32);
    vk.vkCmdDrawIndexed(cmd, m.index_count::u32, 1, 0, 0, 0);
}

# find the accessor index bound to a named attribute, or gd.NONE
# ---
# prim: primitive to search
# name: attribute semantic, e.g. "POSITION"
# ret:  the accessor index, or gd.NONE when the attribute is absent
fun find_attr(prim: *gd.Primitive, name: str) i64 {
    var i: usize = 0;
    for (i < prim.attributes.size) {
        val ar: Result[*gd.Attribute, str] = slice.get[gd.Attribute](prim.attributes, i);
        if (is_err[*gd.Attribute, str](ar)) { ret gd.NONE; }
        val a: *gd.Attribute = unwrap_ok[*gd.Attribute, str](ar);
        if (str_equals(a.name, name)) { ret a.accessor; }
        i = i + 1;
    }
    ret gd.NONE;
}

# read a FLOAT accessor into a freshly allocated packed f32 array
# ---
# d:     the document owning the accessor
# bin:   the binary buffer bytes
# blen:  length of bin in bytes
# ai:    accessor index
# a:     allocator for the output array
# out:   receives the packed f32 array (count*comps values)
# count: receives the element count
# comps: receives components per element
# ret:   true on success, or a plan/read/allocation error
#
# public within boom.graphics so boom.graphics.model can read animation
# and inverse-bind accessors through the same path; not part of the facade.
pub fun read_floats(d: *gd.Document, bin: *u8, blen: usize, ai: usize, a: *allo.Allocator, out: **f32, count: *usize, comps: *usize) Result[bool, Error] {
    val pr: Result[ga.Plan, str] = ga.plan(d, bin, blen, ai);
    if (is_err[ga.Plan, str](pr)) {
        ret err[bool, Error](error(unwrap_err[ga.Plan, str](pr)));
    }
    var p: ga.Plan = unwrap_ok[ga.Plan, str](pr);
    val total: usize = p.count * p.comps;

    val alr: Result[*f32, str] = allo.allocate[f32](a, total);
    if (is_err[*f32, str](alr)) {
        ret err[bool, Error](error(unwrap_err[*f32, str](alr)));
    }
    val buf: *f32 = unwrap_ok[*f32, str](alr);

    val rr: Result[usize, str] = ga.read_f32(?p, buf, total);
    if (is_err[usize, str](rr)) {
        ret err[bool, Error](error(unwrap_err[usize, str](rr)));
    }

    @out   = buf;
    @count = p.count;
    @comps = p.comps;
    ret ok[bool, Error](true);
}

# read an index accessor into a freshly allocated u32 array
#
# widens UNSIGNED_SHORT and UNSIGNED_BYTE indices to u32.
# ---
# d:     the document owning the accessor
# bin:   the binary buffer bytes
# blen:  length of bin in bytes
# ai:    accessor index
# a:     allocator for the output array
# out:   receives the u32 index array
# count: receives the index count
# ret:   true on success, or a plan/read/allocation error
fun read_indices(d: *gd.Document, bin: *u8, blen: usize, ai: usize, a: *allo.Allocator, out: **u32, count: *usize) Result[bool, Error] {
    val pr: Result[ga.Plan, str] = ga.plan(d, bin, blen, ai);
    if (is_err[ga.Plan, str](pr)) {
        ret err[bool, Error](error(unwrap_err[ga.Plan, str](pr)));
    }
    var p: ga.Plan = unwrap_ok[ga.Plan, str](pr);
    val n: usize = p.count;

    val alr: Result[*u32, str] = allo.allocate[u32](a, n);
    if (is_err[*u32, str](alr)) {
        ret err[bool, Error](error(unwrap_err[*u32, str](alr)));
    }
    val buf: *u32 = unwrap_ok[*u32, str](alr);

    if (p.component_type == gd.COMPONENT_UNSIGNED_INT) {
        val rr: Result[usize, str] = ga.read_u32(?p, buf, n);
        if (is_err[usize, str](rr)) { ret err[bool, Error](error(unwrap_err[usize, str](rr))); }
    }
    or (p.component_type == gd.COMPONENT_UNSIGNED_SHORT) {
        val t16r: Result[*u16, str] = allo.allocate[u16](a, n);
        if (is_err[*u16, str](t16r)) { ret err[bool, Error](error(unwrap_err[*u16, str](t16r))); }
        val t16: *u16 = unwrap_ok[*u16, str](t16r);
        val rr: Result[usize, str] = ga.read_u16(?p, t16, n);
        if (is_err[usize, str](rr)) { ret err[bool, Error](error(unwrap_err[usize, str](rr))); }
        var i: usize = 0;
        for (i < n) { buf[i] = t16[i]::u32; i = i + 1; }
    }
    or (p.component_type == gd.COMPONENT_UNSIGNED_BYTE) {
        val t8r: Result[*u8, str] = allo.allocate[u8](a, n);
        if (is_err[*u8, str](t8r)) { ret err[bool, Error](error(unwrap_err[*u8, str](t8r))); }
        val t8: *u8 = unwrap_ok[*u8, str](t8r);
        val rr: Result[usize, str] = ga.read_u8(?p, t8, n);
        if (is_err[usize, str](rr)) { ret err[bool, Error](error(unwrap_err[usize, str](rr))); }
        var i: usize = 0;
        for (i < n) { buf[i] = t8[i]::u32; i = i + 1; }
    }
    or {
        ret err[bool, Error](error("unsupported index component type"));
    }

    @out   = buf;
    @count = n;
    ret ok[bool, Error](true);
}

# read an optional float attribute into a source array
#
# an absent attribute is a no-op success leaving out at nil. a present one is
# read as f32 and its component count reported, so the caller can check it
# against what the canonical layout expects. a present attribute whose element
# count differs from POSITION is an error.
#
# the format is not touched here. the layout a mesh is uploaded with is boom's,
# not the asset's, so what an attribute is read into is decided by the canonical
# format in extract_loaded rather than by the order the asset happens to
# declare its attributes in.
# ---
# prim:   primitive to read from
# d:      the owning document
# bin:    the binary buffer bytes
# blen:   length of bin in bytes
# a:      allocator for the read array
# name:   the glTF attribute name, e.g. "NORMAL"
# vcount: the POSITION vertex count, the required element count
# out:    set to the read f32 array, or left nil when absent
# comps:  set to the component count when present
# ret:    true on success, or a read/mismatch error
fun read_attr(prim: *gd.Primitive, d: *gd.Document, bin: *u8, blen: usize, a: *allo.Allocator,
              name: str, vcount: usize, out: **u8, comps: *usize) Result[bool, Error] {
    @out   = nil;
    @comps = 0;
    val ai: i64 = find_attr(prim, name);
    if (ai == gd.NONE) {
        ret ok[bool, Error](true);
    }
    var dp:  *f32 = nil;
    var cnt: usize = 0;
    var cmp: usize = 0;
    val r: Result[bool, Error] = read_floats(d, bin, blen, ai::usize, a, ?dp, ?cnt, ?cmp);
    if (is_err[bool, Error](r)) { ret r; }
    if (cnt != vcount) {
        ret err[bool, Error](error("attribute element count does not match POSITION"));
    }
    @out   = dp:~*u8;
    @comps = cmp;
    ret ok[bool, Error](true);
}

# write the default value for a canonical attribute the asset did not carry
#
# A NORMAL of (0, 1, 0) rather than zero: a zero normal normalizes to NaN in
# the fragment stage, which most drivers resolve to a black surface and some to
# a discarded fragment, so an untextured model with no normals would come out
# black or invisible rather than flat-lit. A UV of (0, 0) samples the texture's
# first texel, which for the renderer's 1x1 white fallback is white.
#
# Joints and weights have no default: a mesh missing either is not skinned, so
# the skinned layout is never chosen for it and this is never reached for them.
# ---
# dst:      the interleaved vertex buffer
# off:      byte offset of this attribute in this vertex
# semantic: which attribute to default
fun default_attribute(dst: *u8, off: usize, semantic: Semantic) {
    if (semantic == SEMANTIC_NORMAL) {
        write_f32_at(dst, off,     0.0);
        write_f32_at(dst, off + 4, 1.0);
        write_f32_at(dst, off + 8, 0.0);
        ret;
    }
    if (semantic == SEMANTIC_TEXCOORD_0) {
        write_f32_at(dst, off,     0.0);
        write_f32_at(dst, off + 4, 0.0);
        ret;
    }
}

# write a little-endian f32 into a byte buffer at off
fun write_f32_at(dst: *u8, off: usize, v: f32) {
    var p: *f32 = (?dst[off]):~*f32;
    @p = v;
}

# copy n bytes from src at soff into dst at doff
fun copy_bytes(dst: *u8, doff: usize, src: *u8, soff: usize, n: usize) {
    var i: usize = 0;
    for (i < n) {
        dst[doff + i] = src[soff + i];
        i = i + 1;
    }
}

# read the skin's JOINTS_0 attribute as an integer uvec4
#
# an absent attribute is a no-op success leaving out at nil. joint indices
# arrive as UNSIGNED_BYTE or UNSIGNED_SHORT and are widened to u16, the integer
# component the canonical skinned format binds; the attribute must be a vec4
# whose element count matches POSITION.
# ---
# prim:   primitive to read from
# d:      the owning document
# bin:    the binary buffer bytes
# blen:   length of bin in bytes
# a:      allocator for the read array
# vcount: the POSITION vertex count, the required element count
# out:    set to the widened u16 array as bytes, or left nil when absent
# ret:    true on success, or a read/mismatch error
fun read_joints(prim: *gd.Primitive, d: *gd.Document, bin: *u8, blen: usize, a: *allo.Allocator,
                vcount: usize, out: **u8) Result[bool, Error] {
    @out = nil;
    val ai: i64 = find_attr(prim, "JOINTS_0");
    if (ai == gd.NONE) {
        ret ok[bool, Error](true);
    }

    val pr: Result[ga.Plan, str] = ga.plan(d, bin, blen, ai::usize);
    if (is_err[ga.Plan, str](pr)) {
        ret err[bool, Error](error(unwrap_err[ga.Plan, str](pr)));
    }
    var p: ga.Plan = unwrap_ok[ga.Plan, str](pr);
    if (p.comps != 4) {
        ret err[bool, Error](error("JOINTS_0 must be a vec4"));
    }
    if (p.count != vcount) {
        ret err[bool, Error](error("JOINTS_0 element count does not match POSITION"));
    }

    val total: usize = p.count * 4;
    val alr: Result[*u16, str] = allo.allocate[u16](a, total);
    if (is_err[*u16, str](alr)) {
        ret err[bool, Error](error(unwrap_err[*u16, str](alr)));
    }
    val buf: *u16 = unwrap_ok[*u16, str](alr);

    if (p.component_type == gd.COMPONENT_UNSIGNED_SHORT) {
        val rr: Result[usize, str] = ga.read_u16(?p, buf, total);
        if (is_err[usize, str](rr)) { ret err[bool, Error](error(unwrap_err[usize, str](rr))); }
    }
    or (p.component_type == gd.COMPONENT_UNSIGNED_BYTE) {
        val t8r: Result[*u8, str] = allo.allocate[u8](a, total);
        if (is_err[*u8, str](t8r)) { ret err[bool, Error](error(unwrap_err[*u8, str](t8r))); }
        val t8: *u8 = unwrap_ok[*u8, str](t8r);
        val rr: Result[usize, str] = ga.read_u8(?p, t8, total);
        if (is_err[usize, str](rr)) { ret err[bool, Error](error(unwrap_err[usize, str](rr))); }
        var i: usize = 0;
        for (i < total) { buf[i] = t8[i]::u16; i = i + 1; }
    }
    or {
        ret err[bool, Error](error("JOINTS_0 component type must be unsigned byte or short"));
    }

    @out = buf:~*u8;
    ret ok[bool, Error](true);
}

# extract the first primitive of the first mesh from a .glb into MeshData
#
# parses the container, then delegates to extract_loaded. all allocations
# come from a; a single arena the caller frees afterward reclaims them in
# one shot. no GL calls are made, so this is the testable core of the
# loader.
# ---
# data: the .glb bytes
# len:  length of data in bytes
# a:    allocator for the document and the output arrays
# out:  populated with the extracted geometry on success
# ret:  true on success, or a parse/extract error
fun extract_glb(data: *u8, len: usize, a: *allo.Allocator, out: *MeshData) Result[bool, Error] {
    val lr: Result[gp.Loaded, str] = gp.load_glb(data, len, a);
    if (is_err[gp.Loaded, str](lr)) {
        ret err[bool, Error](error(unwrap_err[gp.Loaded, str](lr)));
    }
    var loaded: gp.Loaded = unwrap_ok[gp.Loaded, str](lr);
    ret extract_loaded(?loaded, a, out);
}

# extract the first primitive of the first mesh from a parsed document
#
# reads POSITION (required) and any present NORMAL, TEXCOORD_0, COLOR_0,
# TANGENT, and WEIGHTS_0 float attributes plus a skinned primitive's
# integer JOINTS_0, building a VertexFormat that mirrors the primitive and
# interleaving the attributes into one packed buffer. boom.graphics.model
# shares one parse across the mesh, skeleton, and animations by calling
# this directly; it is public within boom.graphics but not part of the
# game-facing facade.
# ---
# loaded: a parsed glTF document with its binary buffer
# a:      allocator for the output arrays
# out:    populated with the extracted geometry on success
# ret:    true on success, or an extract error
pub fun extract_loaded(loaded: *gp.Loaded, a: *allo.Allocator, out: *MeshData) Result[bool, Error] {
    if (loaded.bin == nil) {
        ret err[bool, Error](error("glb has no binary buffer"));
    }

    val mr: Result[*gd.Mesh, str] = slice.get[gd.Mesh](loaded.document.meshes, 0);
    if (is_err[*gd.Mesh, str](mr)) {
        ret err[bool, Error](error("glb has no meshes"));
    }
    val mesh0: *gd.Mesh = unwrap_ok[*gd.Mesh, str](mr);

    val prr: Result[*gd.Primitive, str] = slice.get[gd.Primitive](mesh0.primitives, 0);
    if (is_err[*gd.Primitive, str](prr)) {
        ret err[bool, Error](error("glb mesh has no primitives"));
    }
    val prim: *gd.Primitive = unwrap_ok[*gd.Primitive, str](prr);

    val pos_ai: i64 = find_attr(prim, "POSITION");
    if (pos_ai == gd.NONE) {
        ret err[bool, Error](error("glb primitive has no POSITION attribute"));
    }
    if (prim.indices == gd.NONE) {
        ret err[bool, Error](error("glb primitive is non-indexed, which is not supported"));
    }

    var pos: *u8 = nil;    var pcomps: usize = 0;
    var nrm: *u8 = nil;    var ncomps: usize = 0;
    var uv:  *u8 = nil;    var ucomps: usize = 0;
    var wts: *u8 = nil;    var wcomps: usize = 0;
    var jts: *u8 = nil;

    var posf:   *f32  = nil;
    var vcount: usize = 0;
    val prf: Result[bool, Error] = read_floats(?loaded.document, loaded.bin, loaded.bin_len, pos_ai::usize, a, ?posf, ?vcount, ?pcomps);
    if (is_err[bool, Error](prf)) { ret prf; }
    if (pcomps != 3) {
        ret err[bool, Error](error("POSITION must be a vec3"));
    }
    pos = posf:~*u8;

    val nr: Result[bool, Error] = read_attr(prim, ?loaded.document, loaded.bin, loaded.bin_len, a, "NORMAL",     vcount, ?nrm, ?ncomps);
    if (is_err[bool, Error](nr)) { ret nr; }
    if (nrm != nil && ncomps != 3) {
        ret err[bool, Error](error("NORMAL must be a vec3"));
    }
    val tr: Result[bool, Error] = read_attr(prim, ?loaded.document, loaded.bin, loaded.bin_len, a, "TEXCOORD_0", vcount, ?uv, ?ucomps);
    if (is_err[bool, Error](tr)) { ret tr; }
    if (uv != nil && ucomps != 2) {
        ret err[bool, Error](error("TEXCOORD_0 must be a vec2"));
    }
    val wr: Result[bool, Error] = read_attr(prim, ?loaded.document, loaded.bin, loaded.bin_len, a, "WEIGHTS_0",  vcount, ?wts, ?wcomps);
    if (is_err[bool, Error](wr)) { ret wr; }
    if (wts != nil && wcomps != 4) {
        ret err[bool, Error](error("WEIGHTS_0 must be a vec4"));
    }
    val jr: Result[bool, Error] = read_joints(prim, ?loaded.document, loaded.bin, loaded.bin_len, a, vcount, ?jts);
    if (is_err[bool, Error](jr)) { ret jr; }

    # THE LAYOUT IS BOOM'S, NOT THE ASSET'S. A glTF primitive carries whatever
    # attributes its exporter wrote, so mirroring it would give every model a
    # different stride and a different offset for every attribute past the
    # first. The shaders declare fixed inputs, and a vertex input a shader
    # declares with no attribute behind it is invalid, so a mesh is conformed
    # to one of two canonical layouts here and missing attributes are filled
    # with defaults. That is also what keeps the pipeline cache to a handful of
    # entries instead of one per asset.
    #
    # Skinning needs both halves. A primitive with joints and no weights, or
    # the reverse, cannot be skinned by any pose, so it is treated as static
    # rather than skinned with whichever half is missing defaulted.
    val skinned: bool = jts != nil && wts != nil;
    var fmt: VertexFormat = vertex_format_standard();
    if (skinned) { fmt = vertex_format_skinned(); }

    val vbytes: usize = vcount * fmt.stride::usize;
    val vr: Result[*u8, str] = allo.allocate[u8](a, vbytes);
    if (is_err[*u8, str](vr)) {
        ret err[bool, Error](error(unwrap_err[*u8, str](vr)));
    }
    val dst: *u8 = unwrap_ok[*u8, str](vr);

    var idx:    *u32 = nil;
    var icount: usize = 0;
    val irf: Result[bool, Error] = read_indices(?loaded.document, loaded.bin, loaded.bin_len, prim.indices::usize, a, ?idx, ?icount);
    if (is_err[bool, Error](irf)) { ret irf; }

    var v: usize = 0;
    for (v < vcount) {
        var i: u32 = 0;
        for (i < fmt.count) {
            val at:     *VertexAttribute = ?fmt.attributes[i];
            val abytes: usize = attribute_bytes(at)::usize;
            val dbase:  usize = v * fmt.stride::usize + at.offset::usize;
            var src:    *u8 = nil;

            if (at.semantic == SEMANTIC_POSITION)   { src = pos; }
            or (at.semantic == SEMANTIC_NORMAL)     { src = nrm; }
            or (at.semantic == SEMANTIC_TEXCOORD_0) { src = uv;  }
            or (at.semantic == SEMANTIC_JOINTS_0)   { src = jts; }
            or (at.semantic == SEMANTIC_WEIGHTS_0)  { src = wts; }

            if (src != nil) {
                copy_bytes(dst, dbase, src, v * abytes, abytes);
            }
            or {
                default_attribute(dst, dbase, at.semantic);
            }
            i = i + 1;
        }
        v = v + 1;
    }

    out.vertices     = dst;
    out.vertex_count = vcount::i32;
    out.format       = fmt;
    out.indices      = idx;
    out.index_count  = icount::i32;
    ret ok[bool, Error](true);
}

# the highest joint index any vertex references, or -1 when unskinned
#
# A skinned draw uploads a fixed MAX_JOINTS-matrix palette and the vertex stage
# indexes it with whatever JOINTS_0 holds. An index past the skeleton's joint
# count reads outside the palette, which is undefined in Vulkan without
# robustBufferAccess and collapses the vertex to the origin with it: either way
# the model tears, and nothing at load or draw time says why.
#
# So the range is checked once, here, against CPU data, rather than clamped per
# vertex in the shader. The scan is O(vertices) at load and free at draw.
# ---
# md:  the extracted geometry
# ret: the largest joint index present, or -1 when the layout carries no joints
pub fun mesh_data_max_joint(md: *MeshData) i64 {
    var off:   usize = 0;
    var found: bool  = false;
    var i: u32 = 0;
    for (i < md.format.count) {
        if (md.format.attributes[i].semantic == SEMANTIC_JOINTS_0) {
            off   = md.format.attributes[i].offset::usize;
            found = true;
        }
        i = i + 1;
    }
    if (!found) { ret 0 - 1; }

    var best: i64 = 0 - 1;
    var v: usize = 0;
    val stride: usize = md.format.stride::usize;
    val count:  usize = md.vertex_count::usize;
    for (v < count) {
        var c: usize = 0;
        for (c < 4) {
            val j: i64 = read_u16_at(md.vertices, v * stride + off + c * 2)::i64;
            if (j > best) { best = j; }
            c = c + 1;
        }
        v = v + 1;
    }
    ret best;
}

# build a Mesh from .glb bytes already in memory
#
# extracts the first primitive and uploads it. the bytes are not retained.
# ---
# data: the .glb bytes
# len:  length of data in bytes
# ret:  the uploaded Mesh, or a parse/extract error
pub fun mesh_from_glb(d: *Device, data: *u8, len: usize) Result[Mesh, Error] {
    var pa: allo.Allocator;
    page.make(?pa);
    var ar: arena.Arena;
    val ie: Option[str] = arena.init(?ar, ?pa, 65536);
    if (is_some[str](ie)) {
        ret err[Mesh, Error](error("out of memory"));
    }
    var aa: allo.Allocator;
    arena.make(?aa, ?ar);

    var md: MeshData;
    val r: Result[bool, Error] = extract_glb(data, len, ?aa, ?md);
    if (is_err[bool, Error](r)) {
        arena.dnit(?ar);
        ret err[Mesh, Error](unwrap_err[bool, Error](r));
    }

    val mr: Result[Mesh, Error] = mesh(d, md.vertices::ptr, md.vertex_count, ?md.format,
                                       md.indices, md.index_count);
    arena.dnit(?ar);
    ret mr;
}

# load a .glb file and upload its first primitive as a Mesh
# ---
# path: filesystem path to a .glb file
# ret:  the uploaded Mesh, or a read/parse/extract error
pub fun mesh_load(d: *Device, path: str) Result[Mesh, Error] {
    var pa: allo.Allocator;
    page.make(?pa);

    val br: Result[vec.Vector[u8], str] = fs.read_bytes(?pa, path);
    if (is_err[vec.Vector[u8], str](br)) {
        ret err[Mesh, Error](error(unwrap_err[vec.Vector[u8], str](br)));
    }
    var buf: vec.Vector[u8] = unwrap_ok[vec.Vector[u8], str](br);

    val res: Result[Mesh, Error] = mesh_from_glb(d, buf.data, buf.len);
    vec.dnit[u8](?buf);
    ret res;
}

# release the GPU buffers backing a mesh
# ---
# d: the upload context the mesh was created against
# m: mesh to delete; the handle must not be used afterward
pub fun mesh_delete(d: *Device, m: *Mesh) {
    # A resource may still be referenced by a command buffer the GPU has not
    # finished. See vk_wait_idle.
    vk_wait_idle(d.vk);
    buffer_dnit(?m.vertices, d.vk);
    buffer_dnit(?m.indices, d.vk);
    m.index_count = 0;
}

# write a little-endian u32 into a byte buffer at off
fun put_u32(b: *u8, off: usize, v: u32) {
    b[off]     = (v & 0xFF)::u8;
    b[off + 1] = ((v >> 8) & 0xFF)::u8;
    b[off + 2] = ((v >> 16) & 0xFF)::u8;
    b[off + 3] = ((v >> 24) & 0xFF)::u8;
}

# write a little-endian u16 into a byte buffer at off
fun put_u16(b: *u8, off: usize, v: u16) {
    b[off]     = (v & 0xFF)::u8;
    b[off + 1] = ((v >> 8) & 0xFF)::u8;
}

# write an f32 (little-endian IEEE-754) into a byte buffer at off
fun put_f32(b: *u8, off: usize, f: f32) {
    put_u32(b, off, f:~u32);
}

# assemble a minimal indexed-triangle .glb into out, returning its length
fun fixture_triangle_glb(out: *u8) usize {
    val json: str = "{\"asset\":{\"version\":\"2.0\"},\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0},\"indices\":1,\"mode\":4}]}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":6}],\"buffers\":[{\"byteLength\":42}]}";
    val jlen: usize = str_len(json);

    var bin: [44]u8;
    put_f32(?bin[0], 0,  0.0);
    put_f32(?bin[0], 4,  0.0);
    put_f32(?bin[0], 8,  0.0);
    put_f32(?bin[0], 12, 1.0);
    put_f32(?bin[0], 16, 0.0);
    put_f32(?bin[0], 20, 0.0);
    put_f32(?bin[0], 24, 0.0);
    put_f32(?bin[0], 28, 1.0);
    put_f32(?bin[0], 32, 0.0);
    put_u16(?bin[0], 36, 0);
    put_u16(?bin[0], 38, 1);
    put_u16(?bin[0], 40, 2);
    bin[42] = 0;
    bin[43] = 0;
    val blen: usize = 42;

    val jpad:   usize = (4 - (jlen % 4)) % 4;
    val jchunk: usize = jlen + jpad;
    val bpad:   usize = (4 - (blen % 4)) % 4;
    val bchunk: usize = blen + bpad;
    val total:  usize = 12 + 8 + jchunk + 8 + bchunk;

    put_u32(out, 0, 0x46546C67);
    put_u32(out, 4, 2);
    put_u32(out, 8, total::u32);

    put_u32(out, 12, jchunk::u32);
    put_u32(out, 16, 0x4E4F534A);
    var i: usize = 0;
    for (i < jlen) { out[20 + i] = json[i]; i = i + 1; }
    var jp: usize = 0;
    for (jp < jpad) { out[20 + jlen + jp] = ' '; jp = jp + 1; }

    val boff: usize = 20 + jchunk;
    put_u32(out, boff, bchunk::u32);
    put_u32(out, boff + 4, 0x004E4942);
    i = 0;
    for (i < bchunk) { out[boff + 8 + i] = bin[i]; i = i + 1; }

    ret total;
}

test "mesh: a POSITION-only primitive is conformed to the standard layout" {
    # The asset carries one attribute; the shaders declare three. Mirroring the
    # asset would give the pipeline no attribute behind in_normal and in_uv,
    # which is invalid vertex input rather than a mesh that draws untextured.
    var glb: [512]u8;
    val n: usize = fixture_triangle_glb(?glb[0]);

    var pa: allo.Allocator;
    page.make(?pa);
    var ar: arena.Arena;
    arena.init(?ar, ?pa, 65536);
    var aa: allo.Allocator;
    arena.make(?aa, ?ar);

    var md: MeshData;
    val r: Result[bool, Error] = extract_glb(?glb[0], n, ?aa, ?md);
    if (is_err[bool, Error](r))   { arena.dnit(?ar); ret 1; }
    if (md.vertex_count != 3)     { arena.dnit(?ar); ret 2; }
    if (md.index_count != 3)      { arena.dnit(?ar); ret 3; }
    if (md.format.count != 3)     { arena.dnit(?ar); ret 4; }
    if (md.format.stride != 32)   { arena.dnit(?ar); ret 5; }

    # Positions land at the canonical stride, not packed at 12 bytes apart.
    if (read_f32_at(md.vertices, 32) != 1.0)      { arena.dnit(?ar); ret 6; }
    if (read_f32_at(md.vertices, 64 + 4) != 1.0)  { arena.dnit(?ar); ret 7; }

    # The default normal is +Y, not zero: a zero normal normalizes to NaN in
    # the fragment stage and the surface comes out black or discarded.
    if (read_f32_at(md.vertices, 12) != 0.0) { arena.dnit(?ar); ret 8; }
    if (read_f32_at(md.vertices, 16) != 1.0) { arena.dnit(?ar); ret 9; }
    if (read_f32_at(md.vertices, 20) != 0.0) { arena.dnit(?ar); ret 10; }
    if (read_f32_at(md.vertices, 24) != 0.0) { arena.dnit(?ar); ret 11; }
    if (read_f32_at(md.vertices, 28) != 0.0) { arena.dnit(?ar); ret 12; }

    if (md.indices[0] != 0 || md.indices[1] != 1 || md.indices[2] != 2) { arena.dnit(?ar); ret 13; }
    arena.dnit(?ar);
    ret 0;
}

# assemble a minimal skinned .glb: POSITION, JOINTS_0 (u16), WEIGHTS_0
fun fixture_skinned_glb(out: *u8) usize {
    val json: str = "{\"asset\":{\"version\":\"2.0\"},\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0,\"JOINTS_0\":1,\"WEIGHTS_0\":2},\"indices\":3,\"mode\":4}]}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5123,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":2,\"componentType\":5126,\"count\":3,\"type\":\"VEC4\"},{\"bufferView\":3,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":24},{\"buffer\":0,\"byteOffset\":60,\"byteLength\":48},{\"buffer\":0,\"byteOffset\":108,\"byteLength\":6}],\"buffers\":[{\"byteLength\":114}]}";
    val jlen: usize = str_len(json);

    var bin: [116]u8;
    # POSITION vec3, three vertices
    put_f32(?bin[0], 0,  0.0); put_f32(?bin[0], 4,  0.0); put_f32(?bin[0], 8,  0.0);
    put_f32(?bin[0], 12, 1.0); put_f32(?bin[0], 16, 0.0); put_f32(?bin[0], 20, 0.0);
    put_f32(?bin[0], 24, 0.0); put_f32(?bin[0], 28, 1.0); put_f32(?bin[0], 32, 0.0);
    # JOINTS_0 uvec4 u16, three vertices
    put_u16(?bin[0], 36, 0); put_u16(?bin[0], 38, 1); put_u16(?bin[0], 40, 2);  put_u16(?bin[0], 42, 3);
    put_u16(?bin[0], 44, 4); put_u16(?bin[0], 46, 5); put_u16(?bin[0], 48, 6);  put_u16(?bin[0], 50, 7);
    put_u16(?bin[0], 52, 8); put_u16(?bin[0], 54, 9); put_u16(?bin[0], 56, 10); put_u16(?bin[0], 58, 11);
    # WEIGHTS_0 vec4, three vertices
    put_f32(?bin[0], 60,  1.0);  put_f32(?bin[0], 64,  0.0);  put_f32(?bin[0], 68,  0.0);  put_f32(?bin[0], 72,  0.0);
    put_f32(?bin[0], 76,  0.5);  put_f32(?bin[0], 80,  0.5);  put_f32(?bin[0], 84,  0.0);  put_f32(?bin[0], 88,  0.0);
    put_f32(?bin[0], 92,  0.25); put_f32(?bin[0], 96,  0.25); put_f32(?bin[0], 100, 0.25); put_f32(?bin[0], 104, 0.25);
    # indices
    put_u16(?bin[0], 108, 0); put_u16(?bin[0], 110, 1); put_u16(?bin[0], 112, 2);
    bin[114] = 0;
    bin[115] = 0;
    val blen: usize = 114;

    val jpad:   usize = (4 - (jlen % 4)) % 4;
    val jchunk: usize = jlen + jpad;
    val bpad:   usize = (4 - (blen % 4)) % 4;
    val bchunk: usize = blen + bpad;
    val total:  usize = 12 + 8 + jchunk + 8 + bchunk;

    put_u32(out, 0, 0x46546C67);
    put_u32(out, 4, 2);
    put_u32(out, 8, total::u32);

    put_u32(out, 12, jchunk::u32);
    put_u32(out, 16, 0x4E4F534A);
    var i: usize = 0;
    for (i < jlen) { out[20 + i] = json[i]; i = i + 1; }
    var jp: usize = 0;
    for (jp < jpad) { out[20 + jlen + jp] = ' '; jp = jp + 1; }

    val boff: usize = 20 + jchunk;
    put_u32(out, boff, bchunk::u32);
    put_u32(out, boff + 4, 0x004E4942);
    i = 0;
    for (i < bchunk) { out[boff + 8 + i] = bin[i]; i = i + 1; }

    ret total;
}

test "mesh: the highest joint index is found across every vertex and lane" {
    # The fixture's joint indices run 0..11 across three vertices. Scanning only
    # the first vertex, or only the first lane, would report 3 or 8 and let a
    # model through whose later vertices index outside the palette.
    var glb: [1024]u8;
    val n: usize = fixture_skinned_glb(?glb[0]);

    var pa: allo.Allocator;
    page.make(?pa);
    var ar: arena.Arena;
    arena.init(?ar, ?pa, 65536);
    var aa: allo.Allocator;
    arena.make(?aa, ?ar);

    var md: MeshData;
    val r: Result[bool, Error] = extract_glb(?glb[0], n, ?aa, ?md);
    if (is_err[bool, Error](r)) { arena.dnit(?ar); ret 1; }
    if (mesh_data_max_joint(?md) != 11) { arena.dnit(?ar); ret 2; }
    arena.dnit(?ar);
    ret 0;
}

test "mesh: an unskinned layout reports no joints rather than zero" {
    # Zero is a valid joint index, so a mesh with no joints at all has to be
    # distinguishable from one that only ever references joint 0. Otherwise a
    # static mesh would be rejected against a skeleton with no joints.
    var glb: [512]u8;
    val n: usize = fixture_triangle_glb(?glb[0]);

    var pa: allo.Allocator;
    page.make(?pa);
    var ar: arena.Arena;
    arena.init(?ar, ?pa, 65536);
    var aa: allo.Allocator;
    arena.make(?aa, ?ar);

    var md: MeshData;
    val r: Result[bool, Error] = extract_glb(?glb[0], n, ?aa, ?md);
    if (is_err[bool, Error](r)) { arena.dnit(?ar); ret 1; }
    if (mesh_data_max_joint(?md) != 0 - 1) { arena.dnit(?ar); ret 2; }
    arena.dnit(?ar);
    ret 0;
}

test "mesh: a skinned primitive is conformed to the skinned layout" {
    var glb: [1024]u8;
    val n: usize = fixture_skinned_glb(?glb[0]);

    var pa: allo.Allocator;
    page.make(?pa);
    var ar: arena.Arena;
    arena.init(?ar, ?pa, 65536);
    var aa: allo.Allocator;
    arena.make(?aa, ?ar);

    var md: MeshData;
    val r: Result[bool, Error] = extract_glb(?glb[0], n, ?aa, ?md);
    if (is_err[bool, Error](r)) { arena.dnit(?ar); ret 1; }

    # POSITION, NORMAL, TEXCOORD_0, JOINTS_0, WEIGHTS_0: 12 + 12 + 8 + 8 + 16.
    # The asset carries no normal or UV, so the layout is still the canonical
    # one and those two are defaulted.
    if (md.format.count != 5)   { arena.dnit(?ar); ret 2; }
    if (md.format.stride != 56) { arena.dnit(?ar); ret 3; }

    val joints: *VertexAttribute = ?md.format.attributes[3];
    if (joints.semantic != SEMANTIC_JOINTS_0)              { arena.dnit(?ar); ret 4; }
    if (joints.location != 5 || joints.integer != 1)       { arena.dnit(?ar); ret 5; }
    if (joints.component != COMP_U16 || joints.count != 4) { arena.dnit(?ar); ret 6; }
    if (joints.offset != 32)                               { arena.dnit(?ar); ret 7; }

    val weights: *VertexAttribute = ?md.format.attributes[4];
    if (weights.semantic != SEMANTIC_WEIGHTS_0)        { arena.dnit(?ar); ret 8; }
    if (weights.location != 6 || weights.integer != 0) { arena.dnit(?ar); ret 9; }
    if (weights.offset != 40)                          { arena.dnit(?ar); ret 10; }

    # Vertex 1's first joint index and weight land at the interleaved offsets.
    if (read_u16_at(md.vertices, 56 + 32) != 4)     { arena.dnit(?ar); ret 11; }
    if (read_f32_at(md.vertices, 56 + 40) != 0.5)   { arena.dnit(?ar); ret 12; }
    # Vertex 2's third joint index.
    if (read_u16_at(md.vertices, 112 + 32 + 4) != 10) { arena.dnit(?ar); ret 13; }
    arena.dnit(?ar);
    ret 0;
}
