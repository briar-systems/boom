# the Mesh handle: GPU vertex and index buffers ready to draw
#
# a game supplies interleaved vertices, or a .glb file or bytes, and
# receives an opaque Mesh; the backing mach-gl buffers and the mach-gltf
# loader both stay hidden. mesh_load extracts the first primitive of the
# first mesh (POSITION, NORMAL, TEXCOORD_0, and the index buffer) from a
# glTF 2.0 binary container; missing NORMAL or TEXCOORD_0 default, and
# non-indexed or multi-primitive geometry is left for a later pass.
#
# the interleaved layout is fixed and matches the shader attribute
# convention: location 0 = position (vec3), 1 = normal (vec3),
# 2 = uv (vec2).

use gl.gl;
use boom.graphics.error.Error;
use boom.graphics.error.error;
use boom.graphics.math.vec.Vec2;
use boom.graphics.math.vec.Vec3;
use boom.graphics.math.vec.vec2;
use boom.graphics.math.vec.vec3;
use gp: gltf.parse;
use ga: gltf.accessor;
use gd: gltf.doc;
use slice: std.collections.slice;
use fs:    std.filesystem;
use allo:  std.allocator;
use page:  std.allocator.page;
use arena: std.allocator.arena;
use std.types.option.Option;
use std.types.option.is_some;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.view_eq_str;

# one interleaved vertex
# ---
# position: model-space position
# normal:   surface normal
# uv:       texture coordinate
pub rec Vertex {
    position: Vec3;
    normal:   Vec3;
    uv:       Vec2;
}

# an opaque handle to a drawable mesh
# ---
# vao:         the backing vertex-array object id, hidden from the game
# vbo:         the backing vertex buffer id
# ebo:         the backing index buffer id
# index_count: number of indices, the count drawn
pub rec Mesh {
    vao:         u32;
    vbo:         u32;
    ebo:         u32;
    index_count: i32;
}

# CPU-side geometry extracted from a glTF primitive, owned by an allocator
# ---
# vertices:     interleaved vertices
# vertex_count: number of vertices
# indices:      u32 triangle indices
# index_count:  number of indices
pub rec MeshData {
    vertices:     *Vertex;
    vertex_count: i32;
    indices:      *u32;
    index_count:  i32;
}

# reinterpret a byte offset as a buffer pointer for attribute setup
# ---
# n:   byte offset into the bound vertex buffer
# ret: the offset as a pointer, as glVertexAttribPointer expects
fun offset_ptr(n: usize) ptr {
    ret n:~ptr;
}

# upload vertices and indices to the GPU
#
# copies the interleaved vertex data and the u32 triangle indices into GL
# buffers and configures the standard attribute layout. the CPU data need
# not outlive the call.
# ---
# vertices:     interleaved vertex array
# vertex_count: number of vertices
# indices:      triangle index list, three per triangle
# index_count:  number of indices
# ret:          the drawable Mesh handle
pub fun mesh(vertices: *Vertex, vertex_count: i32, indices: *u32, index_count: i32) Mesh {
    val stride: i32 = $size_of(Vertex)::i32;
    val vsize:  i64 = vertex_count::i64 * $size_of(Vertex)::i64;
    val isize:  i64 = index_count::i64 * 4;

    var vao: u32 = 0;
    var vbo: u32 = 0;
    var ebo: u32 = 0;
    gl.gen_vertex_arrays(1, ?vao);
    gl.bind_vertex_array(vao);

    gl.gen_buffers(1, ?vbo);
    gl.bind_buffer(gl.ARRAY_BUFFER, vbo);
    gl.buffer_data(gl.ARRAY_BUFFER, vsize, vertices::ptr, gl.STATIC_DRAW);

    gl.gen_buffers(1, ?ebo);
    gl.bind_buffer(gl.ELEMENT_ARRAY_BUFFER, ebo);
    gl.buffer_data(gl.ELEMENT_ARRAY_BUFFER, isize, indices::ptr, gl.STATIC_DRAW);

    gl.enable_vertex_attrib_array(0);
    gl.vertex_attrib_pointer(0, 3, gl.FLOAT, false, stride, offset_ptr($offset_of(Vertex, position)));
    gl.enable_vertex_attrib_array(1);
    gl.vertex_attrib_pointer(1, 3, gl.FLOAT, false, stride, offset_ptr($offset_of(Vertex, normal)));
    gl.enable_vertex_attrib_array(2);
    gl.vertex_attrib_pointer(2, 2, gl.FLOAT, false, stride, offset_ptr($offset_of(Vertex, uv)));

    gl.bind_vertex_array(0);

    ret Mesh{vao: vao, vbo: vbo, ebo: ebo, index_count: index_count};
}

# find the accessor index bound to a named attribute, or gd.NONE
# ---
# prim: primitive to search
# name: attribute semantic, e.g. "POSITION"
# ret:  the accessor index, or gd.NONE when the attribute is absent
fun find_attr(prim: *gd.Primitive, name: str) i64 {
    var i: usize = 0;
    for (i < prim.attributes.size) {
        val ar: Result[*gd.Attribute, str] = slice.get[gd.Attribute](prim.attributes, i);
        if (is_err[*gd.Attribute, str](ar)) { ret gd.NONE; }
        val a: *gd.Attribute = unwrap_ok[*gd.Attribute, str](ar);
        if (view_eq_str(a.name, name)) { ret a.accessor; }
        i = i + 1;
    }
    ret gd.NONE;
}

# read a FLOAT accessor into a freshly allocated packed f32 array
# ---
# d:     the document owning the accessor
# bin:   the binary buffer bytes
# blen:  length of bin in bytes
# ai:    accessor index
# a:     allocator for the output array
# out:   receives the packed f32 array (count*comps values)
# count: receives the element count
# comps: receives components per element
# ret:   true on success, or a plan/read/allocation error
fun read_floats(d: *gd.Document, bin: *u8, blen: usize, ai: usize, a: *allo.Allocator, out: **f32, count: *usize, comps: *usize) Result[bool, Error] {
    val pr: Result[ga.Plan, str] = ga.plan(d, bin, blen, ai);
    if (is_err[ga.Plan, str](pr)) {
        ret err[bool, Error](error(unwrap_err[ga.Plan, str](pr)));
    }
    var p: ga.Plan = unwrap_ok[ga.Plan, str](pr);
    val total: usize = p.count * p.comps;

    val alr: Result[*f32, str] = allo.allocate[f32](a, total);
    if (is_err[*f32, str](alr)) {
        ret err[bool, Error](error(unwrap_err[*f32, str](alr)));
    }
    val buf: *f32 = unwrap_ok[*f32, str](alr);

    val rr: Result[usize, str] = ga.read_f32(?p, buf, total);
    if (is_err[usize, str](rr)) {
        ret err[bool, Error](error(unwrap_err[usize, str](rr)));
    }

    @out   = buf;
    @count = p.count;
    @comps = p.comps;
    ret ok[bool, Error](true);
}

# read an index accessor into a freshly allocated u32 array
#
# widens UNSIGNED_SHORT and UNSIGNED_BYTE indices to u32.
# ---
# d:     the document owning the accessor
# bin:   the binary buffer bytes
# blen:  length of bin in bytes
# ai:    accessor index
# a:     allocator for the output array
# out:   receives the u32 index array
# count: receives the index count
# ret:   true on success, or a plan/read/allocation error
fun read_indices(d: *gd.Document, bin: *u8, blen: usize, ai: usize, a: *allo.Allocator, out: **u32, count: *usize) Result[bool, Error] {
    val pr: Result[ga.Plan, str] = ga.plan(d, bin, blen, ai);
    if (is_err[ga.Plan, str](pr)) {
        ret err[bool, Error](error(unwrap_err[ga.Plan, str](pr)));
    }
    var p: ga.Plan = unwrap_ok[ga.Plan, str](pr);
    val n: usize = p.count;

    val alr: Result[*u32, str] = allo.allocate[u32](a, n);
    if (is_err[*u32, str](alr)) {
        ret err[bool, Error](error(unwrap_err[*u32, str](alr)));
    }
    val buf: *u32 = unwrap_ok[*u32, str](alr);

    if (p.component_type == gd.COMPONENT_UNSIGNED_INT) {
        val rr: Result[usize, str] = ga.read_u32(?p, buf, n);
        if (is_err[usize, str](rr)) { ret err[bool, Error](error(unwrap_err[usize, str](rr))); }
    }
    or (p.component_type == gd.COMPONENT_UNSIGNED_SHORT) {
        val t16r: Result[*u16, str] = allo.allocate[u16](a, n);
        if (is_err[*u16, str](t16r)) { ret err[bool, Error](error(unwrap_err[*u16, str](t16r))); }
        val t16: *u16 = unwrap_ok[*u16, str](t16r);
        val rr: Result[usize, str] = ga.read_u16(?p, t16, n);
        if (is_err[usize, str](rr)) { ret err[bool, Error](error(unwrap_err[usize, str](rr))); }
        var i: usize = 0;
        for (i < n) { buf[i] = t16[i]::u32; i = i + 1; }
    }
    or (p.component_type == gd.COMPONENT_UNSIGNED_BYTE) {
        val t8r: Result[*u8, str] = allo.allocate[u8](a, n);
        if (is_err[*u8, str](t8r)) { ret err[bool, Error](error(unwrap_err[*u8, str](t8r))); }
        val t8: *u8 = unwrap_ok[*u8, str](t8r);
        val rr: Result[usize, str] = ga.read_u8(?p, t8, n);
        if (is_err[usize, str](rr)) { ret err[bool, Error](error(unwrap_err[usize, str](rr))); }
        var i: usize = 0;
        for (i < n) { buf[i] = t8[i]::u32; i = i + 1; }
    }
    or {
        ret err[bool, Error](error("unsupported index component type"));
    }

    @out   = buf;
    @count = n;
    ret ok[bool, Error](true);
}

# extract the first primitive of the first mesh from a .glb into MeshData
#
# reads POSITION (required), NORMAL and TEXCOORD_0 (optional, defaulted),
# and the index buffer. all allocations come from a; a single arena that
# the caller frees afterward reclaims them in one shot. no GL calls are
# made, so this is the testable core of the loader.
# ---
# data: the .glb bytes
# len:  length of data in bytes
# a:    allocator for the document and the output arrays
# out:  populated with the extracted geometry on success
# ret:  true on success, or a parse/extract error
fun extract_glb(data: *u8, len: usize, a: *allo.Allocator, out: *MeshData) Result[bool, Error] {
    val lr: Result[gp.Loaded, str] = gp.load_glb(data, len, a);
    if (is_err[gp.Loaded, str](lr)) {
        ret err[bool, Error](error(unwrap_err[gp.Loaded, str](lr)));
    }
    var loaded: gp.Loaded = unwrap_ok[gp.Loaded, str](lr);
    if (loaded.bin == nil) {
        ret err[bool, Error](error("glb has no binary buffer"));
    }

    val mr: Result[*gd.Mesh, str] = slice.get[gd.Mesh](loaded.document.meshes, 0);
    if (is_err[*gd.Mesh, str](mr)) {
        ret err[bool, Error](error("glb has no meshes"));
    }
    val mesh0: *gd.Mesh = unwrap_ok[*gd.Mesh, str](mr);

    val prr: Result[*gd.Primitive, str] = slice.get[gd.Primitive](mesh0.primitives, 0);
    if (is_err[*gd.Primitive, str](prr)) {
        ret err[bool, Error](error("glb mesh has no primitives"));
    }
    val prim: *gd.Primitive = unwrap_ok[*gd.Primitive, str](prr);

    val pos_ai: i64 = find_attr(prim, "POSITION");
    if (pos_ai == gd.NONE) {
        ret err[bool, Error](error("glb primitive has no POSITION attribute"));
    }
    if (prim.indices == gd.NONE) {
        ret err[bool, Error](error("glb primitive is non-indexed, which is not supported"));
    }
    val nrm_ai: i64 = find_attr(prim, "NORMAL");
    val uv_ai:  i64 = find_attr(prim, "TEXCOORD_0");

    var pos: *f32 = nil;
    var pcount: usize = 0;
    var pcomps: usize = 0;
    val prf: Result[bool, Error] = read_floats(?loaded.document, loaded.bin, loaded.bin_len, pos_ai::usize, a, ?pos, ?pcount, ?pcomps);
    if (is_err[bool, Error](prf)) { ret prf; }

    var nrm: *f32 = nil;
    var ncount: usize = 0;
    var ncomps: usize = 0;
    var have_nrm: u8 = 0;
    if (nrm_ai != gd.NONE) {
        val nrf: Result[bool, Error] = read_floats(?loaded.document, loaded.bin, loaded.bin_len, nrm_ai::usize, a, ?nrm, ?ncount, ?ncomps);
        if (is_err[bool, Error](nrf)) { ret nrf; }
        have_nrm = 1;
    }

    var uv: *f32 = nil;
    var ucount: usize = 0;
    var ucomps: usize = 0;
    var have_uv: u8 = 0;
    if (uv_ai != gd.NONE) {
        val urf: Result[bool, Error] = read_floats(?loaded.document, loaded.bin, loaded.bin_len, uv_ai::usize, a, ?uv, ?ucount, ?ucomps);
        if (is_err[bool, Error](urf)) { ret urf; }
        have_uv = 1;
    }

    var idx: *u32 = nil;
    var icount: usize = 0;
    val irf: Result[bool, Error] = read_indices(?loaded.document, loaded.bin, loaded.bin_len, prim.indices::usize, a, ?idx, ?icount);
    if (is_err[bool, Error](irf)) { ret irf; }

    val vr: Result[*Vertex, str] = allo.allocate[Vertex](a, pcount);
    if (is_err[*Vertex, str](vr)) {
        ret err[bool, Error](error(unwrap_err[*Vertex, str](vr)));
    }
    val verts: *Vertex = unwrap_ok[*Vertex, str](vr);

    var v: usize = 0;
    for (v < pcount) {
        var vert: Vertex;
        vert.position = vec3(pos[v * 3], pos[v * 3 + 1], pos[v * 3 + 2]);
        if (have_nrm != 0 && v < ncount) {
            vert.normal = vec3(nrm[v * 3], nrm[v * 3 + 1], nrm[v * 3 + 2]);
        }
        or {
            vert.normal = vec3(0.0, 1.0, 0.0);
        }
        if (have_uv != 0 && v < ucount) {
            vert.uv = vec2(uv[v * 2], uv[v * 2 + 1]);
        }
        or {
            vert.uv = vec2(0.0, 0.0);
        }
        verts[v] = vert;
        v = v + 1;
    }

    out.vertices     = verts;
    out.vertex_count = pcount::i32;
    out.indices      = idx;
    out.index_count  = icount::i32;
    ret ok[bool, Error](true);
}

# build a Mesh from .glb bytes already in memory
#
# extracts the first primitive and uploads it. the bytes are not retained.
# ---
# data: the .glb bytes
# len:  length of data in bytes
# ret:  the uploaded Mesh, or a parse/extract error
pub fun mesh_from_glb(data: *u8, len: usize) Result[Mesh, Error] {
    var pa: allo.Allocator;
    page.make(?pa);
    var ar: arena.Arena;
    val ie: Option[str] = arena.init(?ar, ?pa, 65536);
    if (is_some[str](ie)) {
        ret err[Mesh, Error](error("out of memory"));
    }
    var aa: allo.Allocator;
    arena.make(?aa, ?ar);

    var md: MeshData;
    val r: Result[bool, Error] = extract_glb(data, len, ?aa, ?md);
    if (is_err[bool, Error](r)) {
        arena.dnit(?ar);
        ret err[Mesh, Error](unwrap_err[bool, Error](r));
    }

    val m: Mesh = mesh(md.vertices, md.vertex_count, md.indices, md.index_count);
    arena.dnit(?ar);
    ret ok[Mesh, Error](m);
}

# load a .glb file and upload its first primitive as a Mesh
# ---
# path: filesystem path to a .glb file
# ret:  the uploaded Mesh, or a read/parse/extract error
pub fun mesh_load(path: str) Result[Mesh, Error] {
    var pa: allo.Allocator;
    page.make(?pa);

    val br: Result[fs.Buffer, str] = fs.read_all_sized(?pa, path);
    if (is_err[fs.Buffer, str](br)) {
        ret err[Mesh, Error](error(unwrap_err[fs.Buffer, str](br)));
    }
    val buf: fs.Buffer = unwrap_ok[fs.Buffer, str](br);

    val res: Result[Mesh, Error] = mesh_from_glb(buf.data, buf.len);
    allo.deallocate[u8](?pa, buf.data, buf.len + 1);
    ret res;
}

# release the GPU buffers backing a mesh
# ---
# m: mesh to delete; the handle must not be used afterward
pub fun mesh_delete(m: *Mesh) {
    gl.delete_vertex_arrays(1, ?m.vao);
    gl.delete_buffers(1, ?m.vbo);
    gl.delete_buffers(1, ?m.ebo);
    m.vao = 0;
    m.vbo = 0;
    m.ebo = 0;
    m.index_count = 0;
}

test "mesh: interleaved layout matches the attribute convention" {
    if ($offset_of(Vertex, position) != 0) { ret 1; }
    if ($offset_of(Vertex, normal) != 12) { ret 2; }
    if ($offset_of(Vertex, uv) != 24) { ret 3; }
    if ($size_of(Vertex) != 32) { ret 4; }
    ret 0;
}

# write a little-endian u32 into a byte buffer at off
fun put_u32(b: *u8, off: usize, v: u32) {
    b[off]     = (v & 0xFF)::u8;
    b[off + 1] = ((v >> 8) & 0xFF)::u8;
    b[off + 2] = ((v >> 16) & 0xFF)::u8;
    b[off + 3] = ((v >> 24) & 0xFF)::u8;
}

# write a little-endian u16 into a byte buffer at off
fun put_u16(b: *u8, off: usize, v: u16) {
    b[off]     = (v & 0xFF)::u8;
    b[off + 1] = ((v >> 8) & 0xFF)::u8;
}

# write an f32 (little-endian IEEE-754) into a byte buffer at off
fun put_f32(b: *u8, off: usize, f: f32) {
    put_u32(b, off, f:~u32);
}

# assemble a minimal indexed-triangle .glb into out, returning its length
fun fixture_triangle_glb(out: *u8) usize {
    val json: str = "{\"asset\":{\"version\":\"2.0\"},\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0},\"indices\":1,\"mode\":4}]}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\"},{\"bufferView\":1,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":6}],\"buffers\":[{\"byteLength\":42}]}";
    val jlen: usize = str_len(json);

    var bin: [44]u8;
    put_f32(?bin[0], 0,  0.0);
    put_f32(?bin[0], 4,  0.0);
    put_f32(?bin[0], 8,  0.0);
    put_f32(?bin[0], 12, 1.0);
    put_f32(?bin[0], 16, 0.0);
    put_f32(?bin[0], 20, 0.0);
    put_f32(?bin[0], 24, 0.0);
    put_f32(?bin[0], 28, 1.0);
    put_f32(?bin[0], 32, 0.0);
    put_u16(?bin[0], 36, 0);
    put_u16(?bin[0], 38, 1);
    put_u16(?bin[0], 40, 2);
    bin[42] = 0;
    bin[43] = 0;
    val blen: usize = 42;

    val jpad:   usize = (4 - (jlen % 4)) % 4;
    val jchunk: usize = jlen + jpad;
    val bpad:   usize = (4 - (blen % 4)) % 4;
    val bchunk: usize = blen + bpad;
    val total:  usize = 12 + 8 + jchunk + 8 + bchunk;

    put_u32(out, 0, 0x46546C67);
    put_u32(out, 4, 2);
    put_u32(out, 8, total::u32);

    put_u32(out, 12, jchunk::u32);
    put_u32(out, 16, 0x4E4F534A);
    var i: usize = 0;
    for (i < jlen) { out[20 + i] = json[i]; i = i + 1; }
    var jp: usize = 0;
    for (jp < jpad) { out[20 + jlen + jp] = ' '; jp = jp + 1; }

    val boff: usize = 20 + jchunk;
    put_u32(out, boff, bchunk::u32);
    put_u32(out, boff + 4, 0x004E4942);
    i = 0;
    for (i < bchunk) { out[boff + 8 + i] = bin[i]; i = i + 1; }

    ret total;
}

test "mesh: extract reads glTF triangle geometry" {
    var glb: [512]u8;
    val n: usize = fixture_triangle_glb(?glb[0]);

    var pa: allo.Allocator;
    page.make(?pa);
    var ar: arena.Arena;
    arena.init(?ar, ?pa, 65536);
    var aa: allo.Allocator;
    arena.make(?aa, ?ar);

    var md: MeshData;
    val r: Result[bool, Error] = extract_glb(?glb[0], n, ?aa, ?md);
    if (is_err[bool, Error](r)) { arena.dnit(?ar); ret 1; }
    if (md.vertex_count != 3) { arena.dnit(?ar); ret 2; }
    if (md.index_count != 3) { arena.dnit(?ar); ret 3; }
    if (md.vertices[1].position.x != 1.0) { arena.dnit(?ar); ret 4; }
    if (md.vertices[2].position.y != 1.0) { arena.dnit(?ar); ret 5; }
    if (md.indices[0] != 0 || md.indices[1] != 1 || md.indices[2] != 2) { arena.dnit(?ar); ret 6; }
    arena.dnit(?ar);
    ret 0;
}
