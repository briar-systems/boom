# Device memory and buffers.
#
# Everything a Vulkan renderer draws from lives in a buffer backed by device
# memory, so this sits between the device and every later module: vertices,
# indices, uniforms, and the staging buffers that fill textures all come from
# here.
#
# MEMORY TYPES ARE NOT FIXED. Vulkan exposes a per-device table of memory types
# with property flags, and the index that satisfies a request varies by vendor
# and by driver version. A renderer that hardcodes an index works on the machine
# it was written on and fails elsewhere, so the type is always searched for by
# required flags against the mask the resource reports.
#
# TWO KINDS OF BUFFER. Host-visible memory can be mapped and written directly
# but is slower for the GPU to read; device-local memory is fast but not
# mappable. Data written once and read every frame goes device-local through a
# staging copy; data rewritten every frame stays host-visible, because a staging
# copy per frame costs more than the slower reads.

use boom.graphics.error.BufferError;
use boom.graphics.error.DeviceError;
use boom.graphics.error.Error;
use boom.graphics.error.Stage;
use boom.graphics.error.VkCall;
use boom.graphics.error.vk_failed;
use boom.graphics.vk.Vk;
use mem: std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use vk;

# A buffer and the memory backing it.
# ---
# handle: The buffer object.
# memory: Memory allocated for this buffer alone.
# size:   Requested size in bytes, not the possibly larger allocation.
# mapped: Host pointer while mapped, nil otherwise.
pub rec Buffer {
    handle: vk.Buffer;
    memory: vk.DeviceMemory;
    size:   u64;
    mapped: ptr;
}

# Find a memory type satisfying both the resource's mask and the wanted flags.
#
# `bits` comes from the resource's memory requirements and marks which type
# indices are legal for it. `want` is the set of properties the caller needs,
# and a type qualifies only when it carries all of them; carrying more is fine
# and is common.
#
# Split out from allocation because it is the one part of this module that can
# be tested without a device, and it is where a wrong answer produces memory
# the GPU cannot address.
pub fun pick_memory_type(props: *vk.PhysicalDeviceMemoryProperties, bits: u32, want: u32) opt[u32] {
    var i: u32 = 0;
    for (i < props.memoryTypeCount) {
        if ((bits & (1::u32 << i)) != 0) {
            if ((props.memoryTypes[i].propertyFlags & want) == want) { ret opt[u32].some{i}; }
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# Create a buffer and allocate memory for it.
#
# One allocation per buffer. Vulkan implementations bound the total number of
# allocations, so a shipping game eventually needs a suballocator, but that is a
# change behind this same interface rather than a different one.
pub fun buffer_init(b: *Buffer, v: *Vk, size: u64, usage: u32, want: u32) err[Error] {
    b.handle = nil;
    b.memory = nil;
    b.mapped = nil;
    b.size   = 0;

    if (!v.ready)  { ret err[Error].err{Error.uninitialized{Stage.device{}}}; }
    if (size == 0) { ret err[Error].err{Error.buffer{BufferError.empty{}}}; }

    var ci: vk.BufferCreateInfo;
    ci.sType                 = vk.STRUCTURE_TYPE_BUFFER_CREATE_INFO;
    ci.pNext                 = nil;
    ci.flags                 = 0;
    ci.size                  = size;
    ci.usage                 = usage;
    ci.sharingMode           = vk.SHARING_MODE_EXCLUSIVE;
    ci.queueFamilyIndexCount = 0;
    ci.pQueueFamilyIndices   = nil;

    val created: i32 = vk.vkCreateBuffer(v.device, ?ci, nil, ?b.handle);
    if (created != vk.SUCCESS) {
        b.handle = nil;
        ret err[Error].err{vk_failed(VkCall.create_buffer{}, created)};
    }

    var req: vk.MemoryRequirements;
    vk.vkGetBufferMemoryRequirements(v.device, b.handle, ?req);

    var props: vk.PhysicalDeviceMemoryProperties;
    vk.vkGetPhysicalDeviceMemoryProperties(v.physical, ?props);

    val index: opt[u32] = pick_memory_type(?props, req.memoryTypeBits, want);
    if (sel index.none) {
        buffer_dnit(b, v);
        ret err[Error].err{Error.device{DeviceError.no_memory_type{}}};
    }

    var ai: vk.MemoryAllocateInfo;
    ai.sType = vk.STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
    ai.pNext = nil;
    # The requirement's size, not the requested size. The driver may need more
    # for alignment, and binding an allocation smaller than it asked for is
    # invalid.
    ai.allocationSize  = req.size;
    ai.memoryTypeIndex = index.some;

    val allocated: i32 = vk.vkAllocateMemory(v.device, ?ai, nil, ?b.memory);
    if (allocated != vk.SUCCESS) {
        b.memory = nil;
        buffer_dnit(b, v);
        ret err[Error].err{vk_failed(VkCall.allocate_memory{}, allocated)};
    }
    val bound: i32 = vk.vkBindBufferMemory(v.device, b.handle, b.memory, 0);
    if (bound != vk.SUCCESS) {
        buffer_dnit(b, v);
        ret err[Error].err{vk_failed(VkCall.bind_buffer_memory{}, bound)};
    }

    b.size = size;
    ret err[Error].ok{};
}

# Map the buffer's memory and return the host pointer.
#
# Only valid on host-visible memory. Mapping is left to the caller rather than
# done at creation because a buffer that stays mapped for its whole life is the
# right choice for per-frame uniforms and the wrong one for a staging buffer
# that is filled once.
pub fun buffer_map(b: *Buffer, v: *Vk) res[ptr, Error] {
    if (b.mapped != nil) { ret res[ptr, Error].ok{b.mapped}; }
    val rc: i32 = vk.vkMapMemory(v.device, b.memory, 0, b.size, 0, ?b.mapped);
    if (rc != vk.SUCCESS) {
        b.mapped = nil;
        ret res[ptr, Error].err{vk_failed(VkCall.map_memory{}, rc)};
    }
    ret res[ptr, Error].ok{b.mapped};
}

# Unmap the buffer's memory.
pub fun buffer_unmap(b: *Buffer, v: *Vk) {
    if (b.mapped == nil) { ret; }
    vk.vkUnmapMemory(v.device, b.memory);
    b.mapped = nil;
}

# Copy bytes into a host-visible buffer.
#
# Refused when the source is larger than the buffer or the memory could not be
# mapped. Writing past the end would corrupt whatever the driver placed after it,
# so the length is checked rather than trusted.
pub fun buffer_write(b: *Buffer, v: *Vk, src: *u8, len: u64) err[Error] {
    if (len > b.size) { ret err[Error].err{Error.buffer{BufferError.overrun{len}}}; }
    val dst: res[ptr, Error] = buffer_map(b, v);
    if (sel dst.err) { ret err[Error].err{dst.err}; }
    mem.copy[u8](dst.ok:~*u8, src, len::usize);
    ret err[Error].ok{};
}

# Destroy the buffer and free its memory.
pub fun buffer_dnit(b: *Buffer, v: *Vk) {
    if (b.handle == nil) { ret; }
    buffer_unmap(b, v);
    vk.vkDestroyBuffer(v.device, b.handle, nil);
    if (b.memory != nil) { vk.vkFreeMemory(v.device, b.memory, nil); }
    b.handle = nil;
    b.memory = nil;
    b.size   = 0;
}

# Copy between buffers on the GPU, waiting for the copy to finish.
#
# Used to move staged data into device-local memory. A one-shot command buffer
# with a queue wait is the simplest correct form; batching these into the frame's
# command buffer is a throughput refinement that matters when uploads happen
# every frame, which is not the case for assets loaded once.
pub fun buffer_copy(v: *Vk, pool: vk.CommandPool, src: *Buffer, dst: *Buffer, size: u64) err[Error] {
    if (size > src.size || size > dst.size) {
        ret err[Error].err{Error.buffer{BufferError.overrun{size}}};
    }

    var cmd: vk.CommandBuffer;
    var ai:  vk.CommandBufferAllocateInfo;
    ai.sType              = vk.STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
    ai.pNext              = nil;
    ai.commandPool        = pool;
    ai.level              = vk.COMMAND_BUFFER_LEVEL_PRIMARY;
    ai.commandBufferCount = 1;
    val allocated: i32 = vk.vkAllocateCommandBuffers(v.device, ?ai, ?cmd);
    if (allocated != vk.SUCCESS) {
        ret err[Error].err{vk_failed(VkCall.allocate_command_buffers{}, allocated)};
    }

    var bi: vk.CommandBufferBeginInfo;
    bi.sType            = vk.STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
    bi.pNext            = nil;
    bi.flags            = vk.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
    bi.pInheritanceInfo = nil;
    val begun: i32 = vk.vkBeginCommandBuffer(cmd, ?bi);
    if (begun != vk.SUCCESS) {
        vk.vkFreeCommandBuffers(v.device, pool, 1, ?cmd);
        ret err[Error].err{vk_failed(VkCall.begin_command_buffer{}, begun)};
    }

    var region: vk.BufferCopy;
    region.srcOffset = 0;
    region.dstOffset = 0;
    region.size      = size;
    vk.vkCmdCopyBuffer(cmd, src.handle, dst.handle, 1, ?region);

    val ended: i32 = vk.vkEndCommandBuffer(cmd);
    if (ended != vk.SUCCESS) {
        vk.vkFreeCommandBuffers(v.device, pool, 1, ?cmd);
        ret err[Error].err{vk_failed(VkCall.end_command_buffer{}, ended)};
    }

    var si: vk.SubmitInfo;
    si.sType                = vk.STRUCTURE_TYPE_SUBMIT_INFO;
    si.pNext                = nil;
    si.waitSemaphoreCount   = 0;
    si.pWaitSemaphores      = nil;
    si.pWaitDstStageMask    = nil;
    si.commandBufferCount   = 1;
    si.pCommandBuffers      = ?cmd;
    si.signalSemaphoreCount = 0;
    si.pSignalSemaphores    = nil;

    val submitted: i32 = vk.vkQueueSubmit(v.graphics_queue, 1, ?si, nil);
    if (submitted != vk.SUCCESS) {
        vk.vkFreeCommandBuffers(v.device, pool, 1, ?cmd);
        ret err[Error].err{vk_failed(VkCall.queue_submit{}, submitted)};
    }
    # Freeing the command buffer while it is executing is invalid, so the wait
    # is not optional here even though it stalls the queue.
    vk.vkQueueWaitIdle(v.graphics_queue);
    vk.vkFreeCommandBuffers(v.device, pool, 1, ?cmd);

    ret err[Error].ok{};
}

# Create a device-local buffer and fill it through a staging copy.
#
# The usual path for geometry: written once at load, read every frame. The
# staging buffer exists only for the duration of the upload.
pub fun buffer_upload(b: *Buffer, v: *Vk, pool: vk.CommandPool, src: *u8, len: u64, usage: u32) err[Error] {
    var staging: Buffer;
    val sr:      err[Error] = buffer_init(?staging, v, len,
        vk.BUFFER_USAGE_TRANSFER_SRC_BIT,
        vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT);
    if (sel sr.err) { ret sr; }

    val wr: err[Error] = buffer_write(?staging, v, src, len);
    if (sel wr.err) {
        buffer_dnit(?staging, v);
        ret wr;
    }

    val dr: err[Error] = buffer_init(b, v, len,
        usage | vk.BUFFER_USAGE_TRANSFER_DST_BIT,
        vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
    if (sel dr.err) {
        buffer_dnit(?staging, v);
        ret dr;
    }

    val cr: err[Error] = buffer_copy(v, pool, ?staging, b, len);
    buffer_dnit(?staging, v);
    if (sel cr.err) {
        buffer_dnit(b, v);
        ret cr;
    }
    ret err[Error].ok{};
}

# --------------------------------------------------------------------- tests
#
# Allocation needs a device, so these cover the memory type search, which is
# pure and is the part that differs between machines.

test "buffer: the search skips types the resource cannot use" {
    var p: vk.PhysicalDeviceMemoryProperties;
    p.memoryTypeCount = 3;
    # Type 0 has the wanted flags but is not in the resource's mask.
    p.memoryTypes[0].propertyFlags = vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
    p.memoryTypes[1].propertyFlags = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT;
    p.memoryTypes[2].propertyFlags = vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT;

    val bits:   u32      = 0b110;
    val picked: opt[u32] = pick_memory_type(?p, bits, vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
    if (!sel picked.some) { ret 1; }
    if (picked.some != 2) { ret 2; }
    ret 0;
}

test "buffer: a type must carry every wanted flag, not merely one" {
    var p: vk.PhysicalDeviceMemoryProperties;
    p.memoryTypeCount              = 2;
    p.memoryTypes[0].propertyFlags = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT;
    p.memoryTypes[1].propertyFlags = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT;

    val want: u32 = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT;
    # Type 0 carries half the request. Accepting it produces memory that needs
    # explicit flushing, and every write silently fails to reach the GPU.
    val picked: opt[u32] = pick_memory_type(?p, 0b11, want);
    if (!sel picked.some) { ret 1; }
    if (picked.some != 1) { ret 2; }
    ret 0;
}

test "buffer: extra properties on a type do not disqualify it" {
    var p: vk.PhysicalDeviceMemoryProperties;
    p.memoryTypeCount              = 1;
    p.memoryTypes[0].propertyFlags = vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT | vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT;
    val picked: opt[u32] = pick_memory_type(?p, 0b1, vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
    if (!sel picked.some) { ret 1; }
    if (picked.some != 0) { ret 2; }
    ret 0;
}

test "buffer: an unsatisfiable request reports no type" {
    var p: vk.PhysicalDeviceMemoryProperties;
    p.memoryTypeCount              = 2;
    p.memoryTypes[0].propertyFlags = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT;
    p.memoryTypes[1].propertyFlags = vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT;
    # Returning 0 here would allocate host-visible memory for a device-local
    # request and the failure would surface as a performance mystery, not an
    # error.
    val picked: opt[u32] = pick_memory_type(?p, 0b11, vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
    if (!sel picked.none) { ret 1; }
    ret 0;
}

test "buffer: an empty mask matches nothing" {
    var p: vk.PhysicalDeviceMemoryProperties;
    p.memoryTypeCount = 4;
    var i: u32 = 0;
    for (i < 4) {
        p.memoryTypes[i].propertyFlags = 0xFFFFFFFF;
        i                              = i + 1;
    }
    val picked: opt[u32] = pick_memory_type(?p, 0, 0);
    if (!sel picked.none) { ret 1; }
    ret 0;
}

test "buffer: teardown on a buffer that was never created is a no-op" {
    var b: Buffer;
    b.handle = nil;
    var v: Vk;
    v.ready = false;
    buffer_dnit(?b, ?v);
    if (b.handle != nil) { ret 1; }
    ret 0;
}
