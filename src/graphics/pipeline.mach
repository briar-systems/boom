# Graphics pipelines: shader modules, layouts, and pipeline state.
#
# A Vulkan pipeline bakes the whole fixed-function state and both shader stages
# into one immutable object, so everything that GL set with individual calls is
# decided here at creation time. That is why this module takes a description
# rather than exposing setters.
#
# VERTEX INPUT COMES FROM THE FORMAT. boom.graphics.vertex already describes a
# mesh's attributes in a backend-neutral way, so the input state is derived from
# a VertexFormat rather than declared twice. A pipeline built for a format is
# only valid for meshes uploaded with that same format, and the conversion is
# the single place that correspondence is enforced.
#
# VIEWPORT AND SCISSOR ARE DYNAMIC. Baking them would mean rebuilding every
# pipeline on every window resize. Declaring them dynamic costs one command per
# frame and makes a resize touch only the swapchain.

use boom.graphics.depth.DepthConvention;
use boom.graphics.error.Error;
use boom.graphics.error.PipelineError;
use boom.graphics.error.ShaderError;
use boom.graphics.error.Stage;
use boom.graphics.error.VkCall;
use boom.graphics.error.vk_failed;
use boom.graphics.limits.DRAW_STORAGE_BUFFERS;
use boom.graphics.limits.Limits;
use boom.graphics.limits.MAX_STORAGE_BINDINGS;
use boom.graphics.pass.MAX_COLOR_ATTACHMENTS;
use boom.graphics.retire.Doomed;
use boom.graphics.retire.Release;
use boom.graphics.spirv.FRAGMENT_ENTRY;
use boom.graphics.spirv.VERTEX_ENTRY;
use boom.graphics.spirvread.spv_bindings_end;
use boom.graphics.storage.FRAME_STORAGE_BINDING;
use boom.graphics.vertex.COMP_F32;
use boom.graphics.vertex.COMP_I16;
use boom.graphics.vertex.COMP_I8;
use boom.graphics.vertex.COMP_U16;
use boom.graphics.vertex.COMP_U32;
use boom.graphics.vertex.COMP_U8;
use boom.graphics.vertex.Component;
use boom.graphics.vertex.VertexAttribute;
use boom.graphics.vertex.VertexFormat;
use boom.graphics.vk.Vk;
use boom.graphics.vk.vk_release;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use vk;

# A pipeline and the layouts it was built against.
# ---
# handle:     The pipeline object.
# layout:     Pipeline layout, owned here.
# set_layout: Descriptor set layout, owned here; nil when the pipeline binds
#             no descriptors.
# storage:    The STORAGE_SET layout, owned here; nil when the pipeline reads
#             no game storage buffers.
# ready:      Whether creation completed.
pub rec Pipeline {
    handle:     vk.Pipeline;
    layout:     vk.PipelineLayout;
    set_layout: vk.DescriptorSetLayout;
    storage:    vk.DescriptorSetLayout;
    ready:      bool;
}

# The descriptor set a game's own storage buffers arrive in.
#
# SET 1, IN EVERY STAGE THAT READS ONE. Set 0 is the draw's slot, whose layout
# is fixed and shared by every graphics pipeline (see set_layout_full), so a
# game's buffers cannot join it without every draw carrying them. A second set
# keeps them apart, and using the same number for a compute stage means one
# declaration, `#[storage(1, n)]`, reads the same buffer whether the stage is
# the dispatch that writes it or the draw that reads it.
pub val STORAGE_SET: u32 = 1;

# Create the STORAGE_SET layout: the device's max_dispatch_bindings storage
# buffers, at bindings 0 up to that.
#
# ONE LAYOUT FOR BOTH KINDS, SIZED FOR A DISPATCH. The first max_draw_bindings
# are visible to the vertex, fragment and compute stages, the rest to compute
# alone. Vulkan counts a binding against the per-stage limit only in the stages
# it names, so a draw's vertex and fragment stages see set 0's
# DRAW_STORAGE_BUFFERS and max_draw_bindings of these, a compute stage sees all
# of them and no set 0, and each stays within what the device reports. A driver
# may accept a layout past that here and reject it elsewhere.
#
# Every layout on one device is the same, so a set taken against one binds to
# any pipeline built against another, compute or graphics, and one pool serves
# both.
#
# Created per pipeline rather than shared, like the set 0 layout: Vulkan binds a
# set to any pipeline whose layout for that set is identically defined, so two
# identical layouts are interchangeable and neither has to outlive the other.
pub fun storage_set_layout(v: *Vk, out: *vk.DescriptorSetLayout) err[Error] {
    var bindings: [MAX_STORAGE_BINDINGS]vk.DescriptorSetLayoutBinding;
    val n:        usize = storage_set_bindings(?v.limits, ?bindings[0]);
    ret create_set_layout(v, ?bindings[0], n::u32, out);
}

# the STORAGE_SET layout's bindings for a device's limits, written to out, which
# holds MAX_STORAGE_BINDINGS; returns how many
pub fun storage_set_bindings(l: *Limits, out: *vk.DescriptorSetLayoutBinding) usize {
    val n: usize = l.max_dispatch_bindings;
    var i: usize = 0;
    for (i < n) {
        out[i].binding         = i::u32;
        out[i].descriptorType  = vk.DESCRIPTOR_TYPE_STORAGE_BUFFER;
        out[i].descriptorCount = 1;
        out[i].stageFlags      = vk.SHADER_STAGE_COMPUTE_BIT;
        if (i < l.max_draw_bindings) {
            out[i].stageFlags = vk.SHADER_STAGE_VERTEX_BIT | vk.SHADER_STAGE_FRAGMENT_BIT | vk.SHADER_STAGE_COMPUTE_BIT;
        }
        out[i].pImmutableSamplers = nil;
        i                         = i + 1;
    }
    ret n;
}

# Whether a stage's STORAGE_SET bindings fit what its kind may bind: a compute
# stage max_dispatch_bindings, a draw's stages max_draw_bindings.
#
# A module declaring a binding past that builds a pipeline against a layout that
# does not hold it for its stage, which Vulkan leaves undefined, so it is
# refused with the binding it declared rather than handed to the driver.
pub fun storage_bindings_fit(spv: *u8, len: usize, allowed: usize) err[Error] {
    val end: u32 = spv_bindings_end(spv, len, STORAGE_SET);
    if (end::usize > allowed) {
        ret err[Error].err{Error.shader{ShaderError.storage_binding{end - 1}}};
    }
    ret err[Error].ok{};
}

# Create a descriptor set layout from a list of bindings, which may be empty.
pub fun create_set_layout(v: *Vk, bindings: *vk.DescriptorSetLayoutBinding, n: u32,
    out: *vk.DescriptorSetLayout) err[Error] {
    var ci: vk.DescriptorSetLayoutCreateInfo;
    ci.sType        = vk.STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO;
    ci.pNext        = nil;
    ci.flags        = 0;
    ci.bindingCount = n;
    ci.pBindings    = bindings;
    val rc: i32 = vk.vkCreateDescriptorSetLayout(v.device, ?ci, nil, out);
    if (rc != vk.SUCCESS) {
        @out = nil;
        ret err[Error].err{vk_failed(VkCall.create_descriptor_set_layout{}, rc)};
    }
    ret err[Error].ok{};
}

# How a pipeline combines fragment output with an existing colour attachment.
# ---
# opaque:        replace the attachment with the fragment output
# source_alpha:  compose the fragment over the attachment using source alpha
# additive:      add fragment channels to the existing attachment channels
# premultiplied: compose a fragment whose colour is already multiplied by its
#                alpha over the attachment
pub tag BlendMode: u8 {
    opaque;
    source_alpha;
    additive;
    premultiplied;
}

# What a pipeline needs beyond its shaders and vertex format.
# ---
# blend:               How fragment output combines with the colour attachment.
# cull:                Back-face culling. Off for 2D, where quads may be wound either way.
# depth:               Depth test and write. Off for overlays drawn in submission order.
# depth_bias:          Whether rasterized depth is offset before depth testing and fragment shading.
# depth_bias_constant: Constant depth offset in implementation-dependent depth units.
# depth_bias_clamp:    Maximum absolute depth offset. Zero leaves the offset unclamped.
# depth_bias_slope:    Offset scaled by the primitive's maximum depth slope.
# topology:            Primitive topology, normally a triangle list.
pub rec PipelineDesc {
    blend:               BlendMode;
    cull:                bool;
    depth:               bool;
    depth_bias:          bool;
    depth_bias_constant: f32;
    depth_bias_clamp:    f32;
    depth_bias_slope:    f32;
    topology:            i32;
}

# The default description: opaque, culled, depth-tested triangles.
pub fun pipeline_desc_3d() PipelineDesc {
    var d: PipelineDesc;
    d.blend               = BlendMode.opaque{};
    d.cull                = true;
    d.depth               = true;
    d.depth_bias          = false;
    d.depth_bias_constant = 0.0;
    d.depth_bias_clamp    = 0.0;
    d.depth_bias_slope    = 0.0;
    d.topology            = vk.PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
    ret d;
}

# The 2D description: blended, unculled, no depth.
pub fun pipeline_desc_2d() PipelineDesc {
    var d: PipelineDesc;
    d.blend               = BlendMode.source_alpha{};
    d.cull                = false;
    d.depth               = false;
    d.depth_bias          = false;
    d.depth_bias_constant = 0.0;
    d.depth_bias_clamp    = 0.0;
    d.depth_bias_slope    = 0.0;
    d.topology            = vk.PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
    ret d;
}

fun rasterization_state(d: *PipelineDesc) vk.PipelineRasterizationStateCreateInfo {
    var rs: vk.PipelineRasterizationStateCreateInfo;
    rs.sType                   = vk.STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
    rs.pNext                   = nil;
    rs.flags                   = 0;
    rs.depthClampEnable        = vk.FALSE;
    rs.rasterizerDiscardEnable = vk.FALSE;
    rs.polygonMode             = vk.POLYGON_MODE_FILL;
    rs.cullMode                = 0;
    if (d.cull) { rs.cullMode = vk.CULL_MODE_BACK_BIT; }
    # COUNTER-CLOCKWISE, matching glTF's winding, and the Y flip does not change
    # that. It is tempting to reason that boom.math negates Y to reach Vulkan's
    # clip space, that a negation mirrors every triangle, and that CLOCKWISE
    # therefore follows. The middle step is where it goes wrong: Vulkan's
    # framebuffer already has Y increasing downward, so the negation converts a
    # Y-up view space into that convention rather than mirroring anything the
    # rasterizer sees. The winding on screen is what it was in model space.
    #
    # This was CLOCKWISE, and the argument above was written down next to it, and
    # it culled part of every closed mesh. Nothing reported that: a cube missing
    # some of its faces still draws, still presents, and still has the right
    # silhouette from the outside, because the faces behind the missing ones are
    # drawn instead. demo/vulkan reads the render back and compares the
    # covered pixel count against the area of the projected hull, which is the
    # check that caught it.
    rs.frontFace       = vk.FRONT_FACE_COUNTER_CLOCKWISE;
    rs.depthBiasEnable = vk.FALSE;
    if (d.depth_bias) { rs.depthBiasEnable = vk.TRUE; }
    rs.depthBiasConstantFactor = d.depth_bias_constant;
    rs.depthBiasClamp          = d.depth_bias_clamp;
    rs.depthBiasSlopeFactor    = d.depth_bias_slope;
    rs.lineWidth               = 1.0;
    ret rs;
}

# The Vulkan format for one vertex attribute.
#
# The three axes are the component type, the component count, and whether the
# attribute is normalized or read as a raw integer. A float attribute is always
# SFLOAT; an integer attribute is UINT or SINT; a normalized attribute is UNORM
# or SNORM, which is how a colour packed into four bytes reaches the shader as a
# vec4 in [0, 1].
#
# None rather than a guess, because a wrong format is accepted by pipeline
# creation and produces silently wrong values in the shader.
pub fun attribute_format(c: Component, count: u32, normalized: u8, integer: u8) opt[i32] {
    if (count < 1 || count > 4) { ret opt[i32].none{}; }

    if (c == COMP_F32) {
        ret by_count(count, vk.FORMAT_R32_SFLOAT, vk.FORMAT_R32G32_SFLOAT,
            vk.FORMAT_R32G32B32_SFLOAT, vk.FORMAT_R32G32B32A32_SFLOAT);
    }

    # A normalized 32-bit integer attribute has no Vulkan format, and glTF never
    # produces one. Rejecting is better than silently reading it as raw.
    if (c == COMP_U32) {
        if (normalized != 0) { ret opt[i32].none{}; }
        ret by_count(count, vk.FORMAT_R32_UINT, vk.FORMAT_R32G32_UINT,
            vk.FORMAT_R32G32B32_UINT, vk.FORMAT_R32G32B32A32_UINT);
    }

    if (c == COMP_U16) {
        if (normalized != 0) {
            ret by_count(count, vk.FORMAT_R16_UNORM, vk.FORMAT_R16G16_UNORM,
                vk.FORMAT_R16G16B16_UNORM, vk.FORMAT_R16G16B16A16_UNORM);
        }
        ret by_count(count, vk.FORMAT_R16_UINT, vk.FORMAT_R16G16_UINT,
            vk.FORMAT_R16G16B16_UINT, vk.FORMAT_R16G16B16A16_UINT);
    }

    if (c == COMP_U8) {
        if (normalized != 0) {
            ret by_count(count, vk.FORMAT_R8_UNORM, vk.FORMAT_R8G8_UNORM,
                vk.FORMAT_R8G8B8_UNORM, vk.FORMAT_R8G8B8A8_UNORM);
        }
        ret by_count(count, vk.FORMAT_R8_UINT, vk.FORMAT_R8G8_UINT,
            vk.FORMAT_R8G8B8_UINT, vk.FORMAT_R8G8B8A8_UINT);
    }

    if (c == COMP_I16) {
        if (normalized != 0) {
            ret by_count(count, vk.FORMAT_R16_SNORM, vk.FORMAT_R16G16_SNORM,
                vk.FORMAT_R16G16B16_SNORM, vk.FORMAT_R16G16B16A16_SNORM);
        }
        ret by_count(count, vk.FORMAT_R16_SINT, vk.FORMAT_R16G16_SINT,
            vk.FORMAT_R16G16B16_SINT, vk.FORMAT_R16G16B16A16_SINT);
    }

    if (c == COMP_I8) {
        if (normalized != 0) {
            ret by_count(count, vk.FORMAT_R8_SNORM, vk.FORMAT_R8G8_SNORM,
                vk.FORMAT_R8G8B8_SNORM, vk.FORMAT_R8G8B8A8_SNORM);
        }
        ret by_count(count, vk.FORMAT_R8_SINT, vk.FORMAT_R8G8_SINT,
            vk.FORMAT_R8G8B8_SINT, vk.FORMAT_R8G8B8A8_SINT);
    }

    ret opt[i32].none{};
}

# the format for a component count of one through four
fun by_count(count: u32, one: i32, two: i32, three: i32, four: i32) opt[i32] {
    if (count == 1) { ret opt[i32].some{one}; }
    if (count == 2) { ret opt[i32].some{two}; }
    if (count == 3) { ret opt[i32].some{three}; }
    ret opt[i32].some{four};
}

# Fill Vulkan attribute descriptions from a vertex format.
#
# The location, offset, and stride all come from the format, so the pipeline and
# the uploaded geometry cannot disagree. The number written, or none when the
# format does not fit `cap` or any attribute has no Vulkan format.
pub fun vertex_attributes(f: *VertexFormat, out: *vk.VertexInputAttributeDescription, cap: usize) opt[u32] {
    if (f.count::usize > cap) { ret opt[u32].none{}; }
    var i: u32 = 0;
    for (i < f.count) {
        val a:   *VertexAttribute = ?f.attributes[i];
        val fmt: opt[i32]         = attribute_format(a.component, a.count, a.normalized, a.integer);
        if (sel fmt.none) { ret opt[u32].none{}; }
        out[i].location = a.location;
        out[i].binding  = 0;
        out[i].format   = fmt.some;
        out[i].offset   = a.offset;
        i               = i + 1;
    }
    ret opt[u32].some{f.count};
}

# Wrap SPIR-V bytes in a shader module.
#
# The length must be a multiple of four: SPIR-V is a word stream, and a byte
# count that is not word-aligned means the file is truncated or is not SPIR-V.
pub fun shader_module(v: *Vk, spv: *u8, len: usize, out: *vk.ShaderModule) err[Error] {
    if (len == 0 || (len % 4) != 0) {
        ret err[Error].err{Error.shader{ShaderError.spirv_words{len}}};
    }
    var ci: vk.ShaderModuleCreateInfo;
    ci.sType    = vk.STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
    ci.pNext    = nil;
    ci.flags    = 0;
    ci.codeSize = len::u64;
    ci.pCode    = spv:~*u32;
    val rc: i32 = vk.vkCreateShaderModule(v.device, ?ci, nil, out);
    if (rc != vk.SUCCESS) {
        ret err[Error].err{vk_failed(VkCall.create_shader_module{}, rc)};
    }
    ret err[Error].ok{};
}

# What a shader binds, as a list of binding kinds.
#
# NOT A BOOLEAN. The first version of this took `sampled: bool` and emitted a
# uniform at binding 0 plus, optionally, a sampler at binding 1. That was shaped
# around the mesh pipeline, which is the easy case, and the lit pipeline breaks
# it: the vertex stage declares a uniform at binding 0 while the fragment stage
# declares the sampler at binding 1 and its tint uniform at binding 2. A boolean
# cannot describe that, and a layout missing binding 2 does not fail loudly; the
# shader reads a descriptor that was never written.
#
# So the layout is a list, and the index in it IS the binding number. Adding a
# shader that binds a fourth thing is one more entry rather than a new flag.
pub def Binding: u8;

# No binding at this index. Present so a gap is describable rather than
# implicitly shifting every later binding down by one.
pub val BINDING_NONE: Binding = 0;
# A uniform buffer.
pub val BINDING_UNIFORM: Binding = 1;
# A combined image sampler.
pub val BINDING_SAMPLER: Binding = 2;
# A storage buffer. Read-write and std430-laid-out, where a uniform block is
# read-only and std140-laid-out. The skinning palette is one: at 128 joints it
# is 8 KB, and an array of 16-byte columns needs std430's natural stride.
pub val BINDING_STORAGE: Binding = 3;

# The most bindings one descriptor set describes.
#
# The next power of two past what set_layout_full uses, so the binding after the
# frame storage is one more entry rather than a change to every array that
# mirrors this number. A set layout is described once per pipeline and a pool is
# sized per kind, so the unused entries cost nothing at draw time.
pub val MAX_BINDINGS: usize = 16;

# A descriptor set layout description.
# ---
# kinds: The kind at each binding number, BINDING_NONE where unused.
# count: One past the highest binding number used.
pub rec SetLayout {
    kinds: [16]Binding;
    count: u32;
}

# An empty layout.
pub fun set_layout() SetLayout {
    var l: SetLayout;
    var i: usize = 0;
    for (i < MAX_BINDINGS) {
        l.kinds[i] = BINDING_NONE;
        i          = i + 1;
    }
    l.count = 0;
    ret l;
}

# Declare a binding at a specific number.
#
# The number is explicit rather than the next free slot, because it has to match
# what the shader declares and a shader is free to leave a gap.
pub fun set_layout_at(l: *SetLayout, binding: u32, kind: Binding) bool {
    if (binding::usize >= MAX_BINDINGS) { ret false; }
    l.kinds[binding] = kind;
    if (binding + 1 > l.count) { l.count = binding + 1; }
    ret true;
}

# The layout mesh_vert and lit_frag declare: one uniform at binding 0.
pub fun set_layout_mesh() SetLayout {
    var l: SetLayout = set_layout();
    set_layout_at(?l, 0, BINDING_UNIFORM);
    ret l;
}

# The layout skinned_vert declares: the matrices at 0, the joint palette at 3.
pub fun set_layout_skinned() SetLayout {
    var l: SetLayout = set_layout();
    set_layout_at(?l, 0, BINDING_UNIFORM);
    set_layout_at(?l, 3, BINDING_STORAGE);
    # Binding 4 is the game's own uniform block, declared in every layout so a
    # game shader and a built-in one are interchangeable at the same pipeline
    # layout. A shader that does not declare it never reads it.
    set_layout_at(?l, 4, BINDING_UNIFORM);
    ret l;
}

# The union of every layout any of boom's shaders declares.
#
# WHY ONE LAYOUT FOR EVERY PIPELINE. A descriptor set is allocated against a
# layout, and Vulkan will only bind it to a pipeline whose layout is compatible,
# which means identical bindings. Giving each pipeline its own layout would mean
# a pool and a set ring per pipeline, and a draw could not switch programs
# without switching sets. Building every pipeline against the union means one
# pool, one ring, and one set per draw regardless of which program the draw uses.
#
# A binding a program does not declare is simply unused by it. The cost is that
# every set carries four descriptors rather than the one or two it needs, which
# is bookkeeping in the pool and nothing at draw time.
pub fun set_layout_full() SetLayout {
    var l: SetLayout = set_layout();
    set_layout_at(?l, 0, BINDING_UNIFORM);
    set_layout_at(?l, 1, BINDING_SAMPLER);
    set_layout_at(?l, 2, BINDING_UNIFORM);
    set_layout_at(?l, 3, BINDING_STORAGE);
    # Binding 4 is the game's own uniform block, declared in every layout so a
    # game shader and a built-in one are interchangeable at the same pipeline
    # layout. A shader that does not declare it never reads it.
    set_layout_at(?l, 4, BINDING_UNIFORM);
    # Bindings 5, 6 and 7 are a Material's second, third and fourth textures.
    #
    # A Material has always held MAX_TEXTURES of them and a draw has always bound
    # the first. A deferred pipeline needs an albedo, a normal, a material and an
    # emissive sheet reachable from one fragment stage, and a composite needs the
    # albedo, the light target and the emissive at once, so one sampler is not a
    # tight fit for that work, it is a wall.
    #
    # THE OLD LIMIT DID NOT ANNOUNCE ITSELF. A shader declaring a sampler at a
    # binding the layout called a uniform buffer built a pipeline the driver
    # returned success for, and read the uniform's bytes as an image. Only the
    # validation layers said anything.
    set_layout_at(?l, 5, BINDING_SAMPLER);
    set_layout_at(?l, 6, BINDING_SAMPLER);
    set_layout_at(?l, 7, BINDING_SAMPLER);
    # Binding 8 is the frame's storage buffer, declared in every layout for the
    # same reason binding 4 is: one buffer the whole frame shares, bound to
    # every set so a game shader that reads it and a built-in one that does not
    # are interchangeable at the same pipeline layout.
    set_layout_at(?l, FRAME_STORAGE_BINDING, BINDING_STORAGE);
    ret l;
}

# The binding number a material's texture index occupies.
#
# Index 0 stays at binding 1 because every shader boom already ships declares it
# there, and moving it would mean rewriting all of them to gain nothing.
pub fun sampler_binding(index: usize) u32 {
    if (index == 0) { ret 1; }
    ret (index + 4)::u32;
}

# How many bindings of a given kind a layout declares.
#
# The descriptor pool is sized per kind, not per set, so this is what a pool
# needs to know. A sprite set holds two uniforms, and a pool sized at one per
# set runs out at the first sprite material.
pub fun set_layout_count(l: *SetLayout, kind: Binding) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < l.count) {
        if (l.kinds[i] == kind) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# Create the Vulkan descriptor set layout for a description.
fun make_set_layout(v: *Vk, l: *SetLayout, out: *vk.DescriptorSetLayout) err[Error] {
    var bindings: [16]vk.DescriptorSetLayoutBinding;
    var n:        u32 = 0;
    var i:        u32 = 0;
    for (i < l.count) {
        if (l.kinds[i] != BINDING_NONE) {
            bindings[n].binding            = i;
            bindings[n].descriptorCount    = 1;
            bindings[n].pImmutableSamplers = nil;
            if (l.kinds[i] == BINDING_SAMPLER) {
                bindings[n].descriptorType = vk.DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
                bindings[n].stageFlags     = vk.SHADER_STAGE_FRAGMENT_BIT;
            }
            or (l.kinds[i] == BINDING_STORAGE) {
                bindings[n].descriptorType = vk.DESCRIPTOR_TYPE_STORAGE_BUFFER;
                bindings[n].stageFlags     = vk.SHADER_STAGE_VERTEX_BIT | vk.SHADER_STAGE_FRAGMENT_BIT;
            }
            or {
                bindings[n].descriptorType = vk.DESCRIPTOR_TYPE_UNIFORM_BUFFER;
                # Visible to both stages. A uniform declared in one stage and
                # named in the other is common, and restricting the stage mask
                # to where it happens to be read today makes adding that a
                # pipeline-creation failure later.
                bindings[n].stageFlags = vk.SHADER_STAGE_VERTEX_BIT | vk.SHADER_STAGE_FRAGMENT_BIT;
            }
            n = n + 1;
        }
        i = i + 1;
    }
    if (n == 0) { ret err[Error].err{Error.pipeline{PipelineError.no_bindings{}}}; }
    ret create_set_layout(v, ?bindings[0], n, out);
}

# Map a public blend mode to the fixed state baked into a Vulkan pipeline.
fun blend_attachment(mode: BlendMode) vk.PipelineColorBlendAttachmentState {
    var cb: vk.PipelineColorBlendAttachmentState;
    cb.colorWriteMask = vk.COLOR_COMPONENT_R_BIT | vk.COLOR_COMPONENT_G_BIT
        | vk.COLOR_COMPONENT_B_BIT | vk.COLOR_COMPONENT_A_BIT;
    cb.blendEnable         = vk.FALSE;
    cb.srcColorBlendFactor = vk.BLEND_FACTOR_ONE;
    cb.dstColorBlendFactor = vk.BLEND_FACTOR_ZERO;
    cb.colorBlendOp        = vk.BLEND_OP_ADD;
    cb.srcAlphaBlendFactor = vk.BLEND_FACTOR_ONE;
    cb.dstAlphaBlendFactor = vk.BLEND_FACTOR_ZERO;
    cb.alphaBlendOp        = vk.BLEND_OP_ADD;

    if (sel mode.source_alpha) {
        cb.blendEnable         = vk.TRUE;
        cb.srcColorBlendFactor = vk.BLEND_FACTOR_SRC_ALPHA;
        cb.dstColorBlendFactor = vk.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
        cb.dstAlphaBlendFactor = vk.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
    }
    or (sel mode.additive) {
        cb.blendEnable         = vk.TRUE;
        cb.dstColorBlendFactor = vk.BLEND_FACTOR_ONE;
        cb.dstAlphaBlendFactor = vk.BLEND_FACTOR_ONE;
    }
    or (sel mode.premultiplied) {
        cb.blendEnable         = vk.TRUE;
        cb.dstColorBlendFactor = vk.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
        cb.dstAlphaBlendFactor = vk.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
    }
    ret cb;
}

# Build a graphics pipeline from two SPIR-V modules and a vertex format.
# `targets` is the colour attachment count of the pass this is built against.
# The blend state must have one entry per attachment or the pipeline is invalid
# in that pass, and the count is not recoverable from a vk.RenderPass handle, so
# it travels alongside it.
pub fun pipeline_init(p: *Pipeline, v: *Vk, pass: vk.RenderPass, targets: usize,
    f: *VertexFormat, d: *PipelineDesc,
    vert: *u8, vlen: usize, frag: *u8, flen: usize,
    layout: *SetLayout) err[Error] {
    ret pipeline_init_depth(p, v, pass, targets, f, d, DepthConvention.forward{},
        vert, vlen, frag, flen, layout);
}

# build a pipeline for an explicit pass depth convention
pub fun pipeline_init_depth(p: *Pipeline, v: *Vk, pass: vk.RenderPass,
    targets: usize, f: *VertexFormat,
    d: *PipelineDesc, depth: DepthConvention,
    vert: *u8, vlen: usize, frag: *u8, flen: usize,
    layout: *SetLayout) err[Error] {
    ret pipeline_init_sets(p, v, pass, targets, f, d, depth, vert, vlen, frag, flen, layout, false);
}

# build a pipeline, with the STORAGE_SET in its layout when storage is set
#
# a game's Shader always takes it, so any of its stages may read a game's
# storage buffers. the built-in programs never read one and do not.
pub fun pipeline_init_sets(p: *Pipeline, v: *Vk, pass: vk.RenderPass,
    targets: usize, f: *VertexFormat,
    d: *PipelineDesc, depth: DepthConvention,
    vert: *u8, vlen: usize, frag: *u8, flen: usize,
    layout: *SetLayout, storage: bool) err[Error] {
    p.ready      = false;
    p.handle     = nil;
    p.layout     = nil;
    p.set_layout = nil;
    p.storage    = nil;

    if (!v.ready) { ret err[Error].err{Error.uninitialized{Stage.device{}}}; }

    if (storage) {
        val vf: err[Error] = storage_bindings_fit(vert, vlen, v.limits.max_draw_bindings);
        if (sel vf.err) { ret vf; }
        val ff: err[Error] = storage_bindings_fit(frag, flen, v.limits.max_draw_bindings);
        if (sel ff.err) { ret ff; }
    }

    var vmod: vk.ShaderModule;
    var fmod: vk.ShaderModule;
    val vr:   err[Error] = shader_module(v, vert, vlen, ?vmod);
    if (sel vr.err) { ret vr; }
    val fr: err[Error] = shader_module(v, frag, flen, ?fmod);
    if (sel fr.err) {
        vk.vkDestroyShaderModule(v.device, vmod, nil);
        ret fr;
    }

    val sr: err[Error] = make_set_layout(v, layout, ?p.set_layout);
    if (sel sr.err) {
        vk.vkDestroyShaderModule(v.device, vmod, nil);
        vk.vkDestroyShaderModule(v.device, fmod, nil);
        ret sr;
    }

    var set_layouts: [2]vk.DescriptorSetLayout;
    set_layouts[0] = p.set_layout;
    var set_count: u32 = 1;
    if (storage) {
        val str: err[Error] = storage_set_layout(v, ?p.storage);
        if (sel str.err) {
            pipeline_dnit(p, v);
            vk.vkDestroyShaderModule(v.device, vmod, nil);
            vk.vkDestroyShaderModule(v.device, fmod, nil);
            ret str;
        }
        set_layouts[STORAGE_SET] = p.storage;
        set_count                = STORAGE_SET + 1;
    }
    var lci: vk.PipelineLayoutCreateInfo;
    lci.sType                  = vk.STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
    lci.pNext                  = nil;
    lci.flags                  = 0;
    lci.setLayoutCount         = set_count;
    lci.pSetLayouts            = ?set_layouts[0];
    lci.pushConstantRangeCount = 0;
    lci.pPushConstantRanges    = nil;
    val laid: i32 = vk.vkCreatePipelineLayout(v.device, ?lci, nil, ?p.layout);
    if (laid != vk.SUCCESS) {
        p.layout = nil;
        pipeline_dnit(p, v);
        vk.vkDestroyShaderModule(v.device, vmod, nil);
        vk.vkDestroyShaderModule(v.device, fmod, nil);
        ret err[Error].err{vk_failed(VkCall.create_pipeline_layout{}, laid)};
    }

    var stages: [2]vk.PipelineShaderStageCreateInfo;
    stages[0].sType               = vk.STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
    stages[0].pNext               = nil;
    stages[0].flags               = 0;
    stages[0].stage               = vk.SHADER_STAGE_VERTEX_BIT::i32;
    stages[0].module              = vmod;
    stages[0].pName               = VERTEX_ENTRY::*u8;
    stages[0].pSpecializationInfo = nil;
    stages[1].sType               = vk.STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
    stages[1].pNext               = nil;
    stages[1].flags               = 0;
    stages[1].stage               = vk.SHADER_STAGE_FRAGMENT_BIT::i32;
    stages[1].module              = fmod;
    stages[1].pName               = FRAGMENT_ENTRY::*u8;
    stages[1].pSpecializationInfo = nil;

    var binding: vk.VertexInputBindingDescription;
    binding.binding   = 0;
    binding.stride    = f.stride;
    binding.inputRate = vk.VERTEX_INPUT_RATE_VERTEX;

    var attrs:     [8]vk.VertexInputAttributeDescription;
    val described: opt[u32] = vertex_attributes(f, ?attrs[0], 8);
    if (sel described.none) {
        pipeline_dnit(p, v);
        vk.vkDestroyShaderModule(v.device, vmod, nil);
        vk.vkDestroyShaderModule(v.device, fmod, nil);
        ret err[Error].err{Error.pipeline{PipelineError.vertex_attribute{}}};
    }
    val nattrs: u32 = described.some;

    var vi: vk.PipelineVertexInputStateCreateInfo;
    vi.sType = vk.STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
    vi.pNext = nil;
    vi.flags = 0;
    # a draw that pulls its geometry from storage buffers has no vertex input
    # at all, and a binding with no attributes behind it is not one
    vi.vertexBindingDescriptionCount = 1;
    if (nattrs == 0) { vi.vertexBindingDescriptionCount = 0; }
    vi.pVertexBindingDescriptions      = ?binding;
    vi.vertexAttributeDescriptionCount = nattrs;
    vi.pVertexAttributeDescriptions    = ?attrs[0];

    var ia: vk.PipelineInputAssemblyStateCreateInfo;
    ia.sType                  = vk.STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
    ia.pNext                  = nil;
    ia.flags                  = 0;
    ia.topology               = d.topology;
    ia.primitiveRestartEnable = vk.FALSE;

    # Counts, not contents: both are dynamic, so the pointers are unused.
    var vp: vk.PipelineViewportStateCreateInfo;
    vp.sType         = vk.STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
    vp.pNext         = nil;
    vp.flags         = 0;
    vp.viewportCount = 1;
    vp.pViewports    = nil;
    vp.scissorCount  = 1;
    vp.pScissors     = nil;

    var rs: vk.PipelineRasterizationStateCreateInfo = rasterization_state(d);
    var ms: vk.PipelineMultisampleStateCreateInfo;
    ms.sType                 = vk.STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
    ms.pNext                 = nil;
    ms.flags                 = 0;
    ms.rasterizationSamples  = vk.SAMPLE_COUNT_1_BIT::i32;
    ms.sampleShadingEnable   = vk.FALSE;
    ms.minSampleShading      = 1.0;
    ms.pSampleMask           = nil;
    ms.alphaToCoverageEnable = vk.FALSE;
    ms.alphaToOneEnable      = vk.FALSE;

    var ds: vk.PipelineDepthStencilStateCreateInfo;
    ds.sType            = vk.STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO;
    ds.pNext            = nil;
    ds.flags            = 0;
    ds.depthTestEnable  = vk.FALSE;
    ds.depthWriteEnable = vk.FALSE;
    if (d.depth) {
        ds.depthTestEnable  = vk.TRUE;
        ds.depthWriteEnable = vk.TRUE;
    }
    ds.depthCompareOp        = depth_compare_op(depth);
    ds.depthBoundsTestEnable = vk.FALSE;
    ds.stencilTestEnable     = vk.FALSE;
    ds.minDepthBounds        = 0.0;
    ds.maxDepthBounds        = 1.0;

    val cb: vk.PipelineColorBlendAttachmentState = blend_attachment(d.blend);

    # Every attachment gets the same blend state. A deferred pass writing albedo
    # beside a normal map wants no blending on any of them, and a game that
    # wants them to differ wants separate passes rather than a per-attachment
    # blend description this API does not carry.
    var n: usize = targets;
    if (n == 0)                    { n = 1; }
    if (n > MAX_COLOR_ATTACHMENTS) { n = MAX_COLOR_ATTACHMENTS; }
    var cbs: [4]vk.PipelineColorBlendAttachmentState;
    var bi:  usize = 0;
    for (bi < n) {
        cbs[bi] = cb;
        bi      = bi + 1;
    }

    var bs: vk.PipelineColorBlendStateCreateInfo;
    bs.sType             = vk.STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
    bs.pNext             = nil;
    bs.flags             = 0;
    bs.logicOpEnable     = vk.FALSE;
    bs.logicOp           = vk.LOGIC_OP_COPY;
    bs.attachmentCount   = n::u32;
    bs.pAttachments      = ?cbs[0];
    bs.blendConstants[0] = 0.0;
    bs.blendConstants[1] = 0.0;
    bs.blendConstants[2] = 0.0;
    bs.blendConstants[3] = 0.0;

    var dyn: [2]i32;
    dyn[0] = vk.DYNAMIC_STATE_VIEWPORT;
    dyn[1] = vk.DYNAMIC_STATE_SCISSOR;
    var dsi: vk.PipelineDynamicStateCreateInfo;
    dsi.sType             = vk.STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
    dsi.pNext             = nil;
    dsi.flags             = 0;
    dsi.dynamicStateCount = 2;
    dsi.pDynamicStates    = ?dyn[0];

    var gci: vk.GraphicsPipelineCreateInfo;
    gci.sType               = vk.STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
    gci.pNext               = nil;
    gci.flags               = 0;
    gci.stageCount          = 2;
    gci.pStages             = ?stages[0];
    gci.pVertexInputState   = ?vi;
    gci.pInputAssemblyState = ?ia;
    gci.pTessellationState  = nil;
    gci.pViewportState      = ?vp;
    gci.pRasterizationState = ?rs;
    gci.pMultisampleState   = ?ms;
    gci.pDepthStencilState  = ?ds;
    gci.pColorBlendState    = ?bs;
    gci.pDynamicState       = ?dsi;
    gci.layout              = p.layout;
    gci.renderPass          = pass;
    gci.subpass             = 0;
    gci.basePipelineHandle  = nil;
    gci.basePipelineIndex   = -1;

    val rc: i32 = vk.vkCreateGraphicsPipelines(v.device, nil, 1, ?gci, nil, ?p.handle);

    # The modules are consumed by creation and are not referenced afterwards, so
    # they are destroyed either way rather than kept alive with the pipeline.
    vk.vkDestroyShaderModule(v.device, vmod, nil);
    vk.vkDestroyShaderModule(v.device, fmod, nil);

    if (rc != vk.SUCCESS) {
        p.handle = nil;
        pipeline_dnit(p, v);
        ret err[Error].err{vk_failed(VkCall.create_graphics_pipelines{}, rc)};
    }

    p.ready = true;
    ret err[Error].ok{};
}

fun depth_compare_op(depth: DepthConvention) i32 {
    if (sel depth.reversed) { ret vk.COMPARE_OP_GREATER; }
    ret vk.COMPARE_OP_LESS;
}

# Bind the pipeline and set the viewport and scissor for the current extent.
#
# The viewport and scissor are dynamic, so a pipeline bound without them draws
# nothing. Setting them here keeps the two facts together.
pub fun pipeline_bind(p: *Pipeline, cmd: vk.CommandBuffer, width: u32, height: u32) {
    pipeline_bind_region(p, cmd, 0, 0, width, height);
}

pub fun pipeline_bind_region(p: *Pipeline, cmd: vk.CommandBuffer, x: i32, y: i32,
    width: u32, height: u32) {
    pipeline_bind_scissored(p, cmd, x, y, width, height, x, y, width, height);
}

# Bind the pipeline with a viewport and a separate, smaller scissor.
#
# The viewport is where the projection lands and the scissor what of it is
# written, so a clip inside a pass narrows the scissor and leaves the viewport,
# and with it every vertex's position, where it was.
pub fun pipeline_bind_scissored(p: *Pipeline, cmd: vk.CommandBuffer, x: i32, y: i32,
    width: u32, height: u32, sx: i32, sy: i32, swidth: u32, sheight: u32) {
    vk.vkCmdBindPipeline(cmd, vk.PIPELINE_BIND_POINT_GRAPHICS, p.handle);

    # A POSITIVE HEIGHT, NOT A FLIPPED VIEWPORT. There are two ways to reach
    # Vulkan's downward Y: negate it in the projection, or give the viewport a
    # negative height with y at the bottom. boom does the former (see
    # boom.math.mat). Doing both cancels out, and the result looks correct on
    # anything symmetrical about the horizontal midline, so it survives the
    # obvious check and shows up on the first asymmetric scene.
    var vpt: vk.Viewport;
    vpt.x      = x::f32;
    vpt.y      = y::f32;
    vpt.width  = width::f32;
    vpt.height = height::f32;
    # Matching the [0, 1] clip depth the projections produce. A [-1, 1] range
    # here would map the near half of every frustum outside the depth buffer.
    vpt.minDepth = 0.0;
    vpt.maxDepth = 1.0;
    vk.vkCmdSetViewport(cmd, 0, 1, ?vpt);

    var sc: vk.Rect2D;
    sc.offset.x      = sx;
    sc.offset.y      = sy;
    sc.extent.width  = swidth;
    sc.extent.height = sheight;
    vk.vkCmdSetScissor(cmd, 0, 1, ?sc);
}

# Destroy the pipeline and its layouts.
pub fun pipeline_dnit(p: *Pipeline, v: *Vk) {
    pipeline_release(p, v, Release.now{});
}

# Release the pipeline and its layouts, now or once its frames have finished.
pub fun pipeline_release(p: *Pipeline, v: *Vk, how: Release) {
    if (p.handle != nil) {
        vk_release(v, Doomed.pipeline{p.handle}, how);
        p.handle = nil;
    }
    if (p.layout != nil) {
        vk_release(v, Doomed.pipeline_layout{p.layout}, how);
        p.layout = nil;
    }
    if (p.set_layout != nil) {
        vk_release(v, Doomed.set_layout{p.set_layout}, how);
        p.set_layout = nil;
    }
    if (p.storage != nil) {
        vk_release(v, Doomed.set_layout{p.storage}, how);
        p.storage = nil;
    }
    p.ready = false;
}

# --------------------------------------------------------------------- tests
#
# Pipeline creation needs a device, so these cover the format mapping and the
# vertex input derivation, which are pure and are where a wrong answer reaches
# the shader as silently wrong values rather than as an error.

use boom.graphics.limits.limits_from;
use boom.graphics.vertex.SEMANTIC_COLOR_0;
use boom.graphics.vertex.SEMANTIC_POSITION;
use boom.graphics.vertex.SEMANTIC_TEXCOORD_0;
use boom.graphics.vertex.vertex_format;
use boom.graphics.vertex.vertex_format_add;
use boom.graphics.vertex.vertex_format_standard;

#[testing]
fun format_is(f: opt[i32], expected: i32) bool {
    ret sel f.some && f.some == expected;
}

#[testing]
fun attributes_are(n: opt[u32], expected: u32) bool {
    ret sel n.some && n.some == expected;
}

test attribute_format__maps_and_refuses {
    if (!format_is(attribute_format(COMP_F32, 1, 0, 0), vk.FORMAT_R32_SFLOAT))          { ret 1; }
    if (!format_is(attribute_format(COMP_F32, 2, 0, 0), vk.FORMAT_R32G32_SFLOAT))       { ret 2; }
    if (!format_is(attribute_format(COMP_F32, 3, 0, 0), vk.FORMAT_R32G32B32_SFLOAT))    { ret 3; }
    if (!format_is(attribute_format(COMP_F32, 4, 0, 0), vk.FORMAT_R32G32B32A32_SFLOAT)) { ret 4; }
    # normalized changes the format, or a byte colour arrives as 0..255 and clamps to white
    if (!format_is(attribute_format(COMP_U8, 4, 1, 0), vk.FORMAT_R8G8B8A8_UNORM)) { ret 5; }
    if (!format_is(attribute_format(COMP_U8, 4, 0, 0), vk.FORMAT_R8G8B8A8_UINT))  { ret 6; }
    if (!format_is(attribute_format(COMP_I8, 4, 1, 0), vk.FORMAT_R8G8B8A8_SNORM)) { ret 7; }
    if (!format_is(attribute_format(COMP_I8, 4, 0, 0), vk.FORMAT_R8G8B8A8_SINT))  { ret 8; }
    # joint indices reach the shader as integers, or every index is zero
    if (!format_is(attribute_format(COMP_U16, 4, 0, 1), vk.FORMAT_R16G16B16A16_UINT)) { ret 9; }

    val zero: opt[i32] = attribute_format(COMP_F32, 0, 0, 0);
    if (!sel zero.none) { ret 10; }
    val five: opt[i32] = attribute_format(COMP_F32, 5, 0, 0);
    if (!sel five.none) { ret 11; }
    # there is no normalized 32-bit integer vertex format
    val unorm32: opt[i32] = attribute_format(COMP_U32, 4, 1, 0);
    if (!sel unorm32.none) { ret 12; }
    ret 0;
}

test vertex_attributes__follow_format {
    var f:   VertexFormat = vertex_format_standard();
    var out: [8]vk.VertexInputAttributeDescription;
    if (!attributes_are(vertex_attributes(?f, ?out[0], 8), 3)) { ret 1; }

    # the format's offsets, or pipeline and geometry disagree on where each starts
    if (out[0].location != 0 || out[0].offset != 0)  { ret 2; }
    if (out[1].location != 1 || out[1].offset != 12) { ret 3; }
    if (out[2].location != 2 || out[2].offset != 24) { ret 4; }
    if (out[2].format != vk.FORMAT_R32G32_SFLOAT)    { ret 5; }
    if (out[0].binding != 0 || out[2].binding != 0)  { ret 6; }

    # the count comes from the attribute, not the semantic, or a vec2 position
    # reads a third float out of the next vertex
    var g: VertexFormat = vertex_format();
    vertex_format_add(?g, SEMANTIC_POSITION, 0, COMP_F32, 2, 0, 0);
    vertex_format_add(?g, SEMANTIC_TEXCOORD_0, 1, COMP_F32, 2, 0, 0);
    if (!attributes_are(vertex_attributes(?g, ?out[0], 8), 2)) { ret 7; }
    if (out[0].format != vk.FORMAT_R32G32_SFLOAT)              { ret 8; }
    if (out[1].location != 1 || out[1].offset != 8)            { ret 9; }
    ret 0;
}

test vertex_attributes__all_or_nothing {
    # a partial count would build a pipeline that silently drops the colour
    var f: VertexFormat = vertex_format();
    vertex_format_add(?f, SEMANTIC_POSITION, 0, COMP_F32, 3, 0, 0);
    vertex_format_add(?f, SEMANTIC_COLOR_0, 1, COMP_U32, 4, 1, 0);
    var out:       [8]vk.VertexInputAttributeDescription;
    val described: opt[u32] = vertex_attributes(?f, ?out[0], 8);
    if (!sel described.none) { ret 1; }

    var s:     VertexFormat = vertex_format_standard();
    val short: opt[u32]     = vertex_attributes(?s, ?out[0], 2);
    if (!sel short.none) { ret 2; }
    ret 0;
}

test blend_attachment__factors_per_mode {
    val opaque: vk.PipelineColorBlendAttachmentState = blend_attachment(BlendMode.opaque{});
    if (opaque.blendEnable != vk.FALSE
        || opaque.srcColorBlendFactor != vk.BLEND_FACTOR_ONE
        || opaque.dstColorBlendFactor != vk.BLEND_FACTOR_ZERO) { ret 1; }

    val alpha: vk.PipelineColorBlendAttachmentState = blend_attachment(BlendMode.source_alpha{});
    if (alpha.blendEnable != vk.TRUE
        || alpha.srcColorBlendFactor != vk.BLEND_FACTOR_SRC_ALPHA
        || alpha.dstColorBlendFactor != vk.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        || alpha.srcAlphaBlendFactor != vk.BLEND_FACTOR_ONE
        || alpha.dstAlphaBlendFactor != vk.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA) { ret 2; }

    val additive: vk.PipelineColorBlendAttachmentState = blend_attachment(BlendMode.additive{});
    if (additive.blendEnable != vk.TRUE
        || additive.srcColorBlendFactor != vk.BLEND_FACTOR_ONE
        || additive.dstColorBlendFactor != vk.BLEND_FACTOR_ONE
        || additive.colorBlendOp != vk.BLEND_OP_ADD
        || additive.srcAlphaBlendFactor != vk.BLEND_FACTOR_ONE
        || additive.dstAlphaBlendFactor != vk.BLEND_FACTOR_ONE
        || additive.alphaBlendOp != vk.BLEND_OP_ADD) { ret 3; }

    # a premultiplied colour already carries its alpha, so the source is taken whole
    val pre: vk.PipelineColorBlendAttachmentState = blend_attachment(BlendMode.premultiplied{});
    if (pre.blendEnable != vk.TRUE
        || pre.srcColorBlendFactor != vk.BLEND_FACTOR_ONE
        || pre.dstColorBlendFactor != vk.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
        || pre.srcAlphaBlendFactor != vk.BLEND_FACTOR_ONE
        || pre.dstAlphaBlendFactor != vk.BLEND_FACTOR_ONE_MINUS_SRC_ALPHA) { ret 4; }
    ret 0;
}

test set_layout_full__bindings_and_counts {
    # a layout stopping short has the shader read a descriptor never written
    var l: SetLayout = set_layout_full();
    if (l.count != 9)                                             { ret 1; }
    if (l.kinds[0] != BINDING_UNIFORM)                            { ret 2; }
    if (l.kinds[1] != BINDING_SAMPLER)                            { ret 3; }
    if (l.kinds[2] != BINDING_UNIFORM)                            { ret 4; }
    if (l.kinds[3] != BINDING_STORAGE)                            { ret 5; }
    if (l.kinds[4] != BINDING_UNIFORM)                            { ret 6; }
    if (l.kinds[5] != BINDING_SAMPLER)                            { ret 7; }
    if (l.kinds[6] != BINDING_SAMPLER)                            { ret 8; }
    if (l.kinds[7] != BINDING_SAMPLER)                            { ret 9; }
    if (l.kinds[FRAME_STORAGE_BINDING::usize] != BINDING_STORAGE) { ret 10; }
    # descriptor.mach sizes its pools from these counts
    if (set_layout_count(?l, BINDING_UNIFORM) != 3) { ret 11; }
    if (set_layout_count(?l, BINDING_SAMPLER) != 4) { ret 12; }
    if (set_layout_count(?l, BINDING_STORAGE) != 2) { ret 13; }
    # and limits.mach takes set 0's storage buffers off what STORAGE_SET may hold
    if (set_layout_count(?l, BINDING_STORAGE) != DRAW_STORAGE_BUFFERS) { ret 14; }
    ret 0;
}

test set_layout_at__keeps_gaps_and_refuses_past_table {
    # packing the list would silently move binding 3 to binding 1
    var l: SetLayout = set_layout();
    set_layout_at(?l, 0, BINDING_UNIFORM);
    set_layout_at(?l, 3, BINDING_SAMPLER);
    if (l.count != 4)                               { ret 1; }
    if (l.kinds[1] != BINDING_NONE)                 { ret 2; }
    if (l.kinds[2] != BINDING_NONE)                 { ret 3; }
    if (l.kinds[3] != BINDING_SAMPLER)              { ret 4; }
    if (set_layout_count(?l, BINDING_UNIFORM) != 1) { ret 5; }

    var e: SetLayout = set_layout();
    if (set_layout_at(?e, MAX_BINDINGS::u32, BINDING_UNIFORM)) { ret 6; }
    if (e.count != 0)                                          { ret 7; }
    ret 0;
}

test storage_set_bindings__each_stage_within_minimum {
    # at the specification's floor of four per stage, a compute stage sees all
    # four and a draw's vertex and fragment stages see two beside set 0's two
    var src: vk.PhysicalDeviceLimits;
    src.maxPerStageDescriptorStorageBuffers = 4;
    src.maxDescriptorSetStorageBuffers      = 24;
    var l:        Limits = limits_from(?src, 0);
    var bindings: [MAX_STORAGE_BINDINGS]vk.DescriptorSetLayoutBinding;
    val n:        usize  = storage_set_bindings(?l, ?bindings[0]);
    if (n != 4) { ret 1; }
    var vert: u32   = DRAW_STORAGE_BUFFERS;
    var frag: u32   = DRAW_STORAGE_BUFFERS;
    var comp: u32   = 0;
    var i:    usize = 0;
    for (i < n) {
        if (bindings[i].binding != i::u32)                                { ret 2; }
        if ((bindings[i].stageFlags & vk.SHADER_STAGE_VERTEX_BIT) != 0)   { vert = vert + 1; }
        if ((bindings[i].stageFlags & vk.SHADER_STAGE_FRAGMENT_BIT) != 0) { frag = frag + 1; }
        if ((bindings[i].stageFlags & vk.SHADER_STAGE_COMPUTE_BIT) != 0)  { comp = comp + 1; }
        i = i + 1;
    }
    if (vert != 4 || frag != 4 || comp != 4) { ret 3; }
    # the bindings a draw may name are the ones its stages see
    if ((bindings[1].stageFlags & vk.SHADER_STAGE_FRAGMENT_BIT) == 0) { ret 4; }
    if ((bindings[2].stageFlags & vk.SHADER_STAGE_VERTEX_BIT) != 0)   { ret 5; }
    ret 0;
}

test sampler_binding__lands_on_samplers {
    # Index 0 stays at binding 1 because every shader boom ships declares it
    # there. The rest follow the uniform and storage bindings rather than
    # displacing them.
    if (sampler_binding(0) != 1) { ret 1; }
    if (sampler_binding(1) != 5) { ret 2; }
    if (sampler_binding(2) != 6) { ret 3; }
    if (sampler_binding(3) != 7) { ret 4; }
    # And none of them lands on the frame storage, which is what a fifth texture
    # would do if it were added by extending this run rather than past it.
    var si: usize = 0;
    for (si < 4) {
        if (sampler_binding(si) == FRAME_STORAGE_BINDING) { ret 6; }
        si = si + 1;
    }

    # Every one of them is a sampler in the layout it indexes into, which is the
    # property that made the old second-sampler probe read a uniform buffer as
    # an image.
    var l: SetLayout = set_layout_full();
    var i: usize     = 0;
    for (i < 4) {
        if (l.kinds[sampler_binding(i)::usize] != BINDING_SAMPLER) { ret 5; }
        i = i + 1;
    }
    ret 0;
}
