# platform window, GL context, and input source
#
# wraps a GLFW window created with no client API and routes
# input into both an event queue and the polled input state. the window's
# GLFW user pointer holds the Sink, so the C callbacks can reach both. these
# paths drive real platform calls and cannot run headless. key translation and
# delivery are kept in a pure core below so their application-owned policy is
# still covered without opening a window.
#
# THE PLATFORM'S KEY CODES STOP HERE. map_key translates a GLFW code into a
# boom Key, and nothing above this file sees a GLFW integer. a game naming a
# key by its platform code would be importing the windowing library through
# the back door, which is what this engine otherwise avoids everywhere.

use boom.event.ButtonEvent;
use boom.event.ComposeEvent;
use boom.event.DropEvent;
use boom.event.Event;
use boom.event.EventQueue;
use boom.event.KeyAction;
use boom.event.KeyEvent;
use boom.event.MoveEvent;
use boom.event.PointerEvent;
use boom.event.QueueError;
use boom.event.ResizeEvent;
use boom.event.ScrollEvent;
use boom.event.TextEvent;
use boom.event.compose_new;
use boom.event.drop_new;
use boom.event.queue_clear;
use boom.event.queue_is_empty;
use boom.event.queue_new;
use boom.event.queue_pop;
use boom.event.queue_push;
use boom.event.queue_release;
use inp: boom.input;
use glfw;
use glfw.c.Vidmode;
use allo: std.allocator;
use std.allocator.page;
use std.print;
use std.process.env;
use text: std.text.string;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# how a window is presented
# ---
# windowed:   decorated, compositor-managed window
# borderless: undecorated window requesting coverage of one monitor
# fullscreen: monitor-attached fullscreen window; exact exclusivity is platform-defined
pub tag WindowMode: u8 {
    windowed;
    borderless;
    fullscreen;
}

# what a monitor-attached mode needed and did not get
# ---
# monitor:    no monitor was found for the window
# video_mode: the monitor reports no video mode
pub tag MonitorPart: u8 {
    monitor;
    video_mode;
}

# a borderless or fullscreen request the monitor could not satisfy
#
# The mode is carried so a caller can compare against the one it asked for
# with the type it already holds, and fall back on purpose rather than retry
# every failure as windowed. A windowed request never raises this.
# ---
# mode: the mode that was requested
# part: which requirement of that mode was unmet
pub rec ModeRefusal {
    mode: WindowMode;
    part: MonitorPart;
}

# the platform refused to create a window in a mode
# ---
# mode:  the mode the window was being created in
# cause: the platform's error
pub rec ModeCreate {
    mode:  WindowMode;
    cause: glfw.Error;
}

# why a window could not be opened or changed
# ---
# init:       the platform layer could not be initialized
# no_monitor: a borderless or fullscreen mode needed a monitor or video mode it did not get
# create:     the platform refused to create the window
# closed:     the window is not open
# in_use:     the window cannot close while this many renderers hold it
# alloc:      the sink registry could not grow to hold the window
pub tag WindowError: u8 {
    init:       glfw.Error;
    no_monitor: ModeRefusal;
    create:     ModeCreate;
    closed;
    in_use: usize;
    alloc:  allo.Error;
}

# a one-line description of a window failure, naming the mode where one was refused
# ---
# e:   the failure
# ret: static text naming the case
pub fun window_error_message(e: WindowError) str {
    if (sel e.init) { ret "could not initialize the platform window layer"; }
    if (sel e.no_monitor) {
        val r: ModeRefusal = e.no_monitor;
        if (sel r.part.monitor) {
            if (sel r.mode.fullscreen) { ret "fullscreen needs a monitor and none was found"; }
            ret "borderless needs a monitor and none was found";
        }
        if (sel r.mode.fullscreen) { ret "fullscreen needs a video mode and the monitor reports none"; }
        ret "borderless needs a video mode and the monitor reports none";
    }
    if (sel e.create) {
        val c: ModeCreate = e.create;
        if (sel c.mode.fullscreen) { ret "the platform refused to create a fullscreen window"; }
        if (sel c.mode.borderless) { ret "the platform refused to create a borderless window"; }
        ret "the platform refused to create a window";
    }
    if (sel e.closed) { ret "the window is not open"; }
    if (sel e.alloc)  { ret "the window's event sink could not be registered"; }
    ret "the window cannot close while a renderer holds it";
}

# the refusal for a mode that needed a monitor and a video mode
fun mode_refusal(mode: WindowMode, monitor: bool) WindowError {
    if (!monitor) { ret WindowError.no_monitor{ModeRefusal{mode: mode, part: MonitorPart.monitor{}}}; }
    ret WindowError.no_monitor{ModeRefusal{mode: mode, part: MonitorPart.video_mode{}}};
}

# windowed client bounds in screen coordinates
# ---
# x:      client origin on the virtual desktop
# y:      client origin on the virtual desktop
# width:  client size, independent of framebuffer scale
# height: client size, independent of framebuffer scale
pub rec WindowBounds {
    x:      i32;
    y:      i32;
    width:  i32;
    height: i32;
}

# a platform window
# ---
# handle:             the underlying GLFW window, none once closed or when never opened
# width:              current framebuffer width in pixels
# height:             current framebuffer height in pixels
# mode:               semantic presentation mode, including platform-specific borderless
# monitor:            output retained when the platform cannot report window placement
# windowed:           ordinary client bounds retained across fullscreen transitions
# windowed_maximized: whether ordinary mode restores through the compositor
# min_width:          client limit applied when restoring windowed mode
# min_height:         client limit applied when restoring windowed mode
# renderers:          how many renderers hold a surface on this window
# shape:              the pointer shape last set, CURSOR_ARROW at open
# shape_shown:        whether the platform shows shape rather than the arrow
# text_input:         whether the window was last put in a text input
#                     context, none while the platform default applies
pub rec Window {
    handle:             opt[glfw.Window];
    width:              i32;
    height:             i32;
    mode:               WindowMode;
    monitor:            opt[glfw.Monitor];
    windowed:           WindowBounds;
    windowed_maximized: bool;
    min_width:          i32;
    min_height:         i32;
    renderers:          usize;
    shape:              CursorShape;
    shape_shown:        bool;
    text_input:         opt[bool];
}

fun on_key(handle: ptr, key: i32, scancode: i32, action: i32, mods: i32) {
    val s: *Sink = sink_of(glfw.window_from_handle(handle));
    deliver_key(s, key, action, mods);
}

# Deliver one platform key transition without assigning policy to any key.
# Escape reaches the application through the same state and queue as every
# other key; only the application decides whether that means pause, back, or
# context_stop.
fun deliver_key(s: *Sink, key: i32, action: i32, mods: i32) {
    if (s == nil) { ret; }
    val k:   inp.Key        = map_key(key);
    val act: opt[KeyAction] = map_key_action(action);
    if (!sel act.some) { ret; }
    # GLFW REPEAT is neither a press nor a release: the key never came up, so
    # folding it in would fire a spurious edge every autorepeat interval while
    # a key is simply held. the queue still carries it for text-entry callers.
    if (!sel act.some.repeat) {
        inp.input_key_event(s.input, k, sel act.some.press);
    }
    offer(s.queue, Event.key{KeyEvent{key: k, action: act.some, mods: map_mods(mods)}});
}

fun on_char(handle: ptr, codepoint: u32) {
    deliver_text(sink_of(glfw.window_from_handle(handle)), codepoint);
}

# typed text is queue-only: polled Input has no state for it
fun deliver_text(s: *Sink, codepoint: u32) {
    if (s == nil) { ret; }
    offer(s.queue, Event.text{TextEvent{codepoint: codepoint}});
}

fun on_preedit(handle: ptr, count: i32, codepoints: *u32,
    blocks: i32, block_sizes: *i32, focused_block: i32, caret: i32) {
    deliver_compose(sink_of(glfw.window_from_handle(handle)), count, codepoints, caret);
}

# the composition is queue-only and copied before the callback returns. its
# attributed blocks are not carried: the caret is what a text field shows
fun deliver_compose(s: *Sink, count: i32, codepoints: *u32, caret: i32) {
    if (s == nil) { ret; }
    var n:  usize = 0;
    var at: usize = 0;
    if (count > 0) { n = count::usize; }
    if (caret > 0) { at = caret::usize; }
    val built: res[ComposeEvent, allo.Error] = compose_new(n, codepoints, at);
    if (sel built.err) { ret; }
    offer(s.queue, Event.compose{built.ok});
}

fun on_drop(handle: ptr, count: i32, paths: **u8) {
    deliver_drop(sink_of(glfw.window_from_handle(handle)), count, paths);
}

# dropped paths are queue-only and copied before the callback returns: the
# queue owns the copy until it is released
fun deliver_drop(s: *Sink, count: i32, paths: **u8) {
    if (s == nil || count <= 0 || paths == nil) { ret; }
    val built: res[DropEvent, allo.Error] = drop_new(count::usize, paths);
    if (sel built.err) { ret; }
    offer(s.queue, Event.drop{built.ok});
}

fun on_mouse_button(handle: ptr, button: i32, action: i32, mods: i32) {
    deliver_button(sink_of(glfw.window_from_handle(handle)), button, action, mods);
}

fun deliver_button(s: *Sink, button: i32, action: i32, mods: i32) {
    if (s == nil) { ret; }
    val b: opt[inp.Button] = map_button(button);
    # a button boom does not name has nothing to fold into and nothing a game can match
    if (!sel b.some) { ret; }
    val down: bool = action == glfw.PRESS;
    inp.input_button_event(s.input, b.some, down);
    offer(s.queue, Event.mouse_button{ButtonEvent{button: b.some, down: down, mods: map_mods(mods)}});
}

fun on_cursor_pos(handle: ptr, x: f64, y: f64) {
    val w:  glfw.Window = glfw.window_from_handle(handle);
    var ww: i32         = 0;
    var wh: i32         = 0;
    var fw: i32         = 0;
    var fh: i32         = 0;
    glfw.get_window_size(w, ?ww, ?wh);
    glfw.get_framebuffer_size(w, ?fw, ?fh);
    deliver_cursor(sink_of(w), x, y, ww, wh, fw, fh);
}

fun on_cursor_enter(handle: ptr, entered: i32) {
    deliver_pointer(sink_of(glfw.window_from_handle(handle)), entered != 0);
}

# the pointer entering or leaving, in order with the moves around it
fun deliver_pointer(s: *Sink, inside: bool) {
    if (s == nil) { ret; }
    inp.input_pointer_event(s.input, inside);
    offer(s.queue, Event.pointer{PointerEvent{inside: inside}});
}

fun on_scroll(handle: ptr, dx: f64, dy: f64) {
    val s: *Sink = sink_of(glfw.window_from_handle(handle));
    if (s == nil) { ret; }
    inp.input_scroll_event(s.input, dx, dy);
    offer(s.queue, Event.scroll{ScrollEvent{dx: dx, dy: dy}});
}

fun on_framebuffer_size(handle: ptr, width: i32, height: i32) {
    deliver_resize(sink_of(glfw.window_from_handle(handle)), width, height);
}

fun deliver_resize(s: *Sink, width: i32, height: i32) {
    if (s == nil) { ret; }
    offer(s.queue, Event.resize{ResizeEvent{width: width, height: height}});
}

# queue an event from a platform callback
#
# a callback has no caller to report to, so an event refused by a full queue is
# dropped. the polled Input state has already taken the transition.
fun offer(q: *EventQueue, e: Event) {
    val pushed: err[QueueError] = queue_push(q, e);
    if (sel pushed.err) { ret; }
}

# the sink installed on a window, or nil before one is set
fun sink_of(w: glfw.Window) *Sink {
    val p: ptr = glfw.get_window_user_pointer(w);
    if (p == nil) { ret nil; }
    ret p::*Sink;
}

fun cursor_scale(window: i32, framebuffer: i32) f64 {
    # A minimized window has no framebuffer coordinate space. Retaining the
    # platform coordinate avoids a divide by zero and the next valid refresh
    # replaces it before the application can draw into a framebuffer again.
    if (window <= 0 || framebuffer <= 0) { ret 1.0; }
    ret framebuffer::f64 / window::f64;
}

fun cursor_pixels(x: f64, y: f64,
    ww: i32, wh: i32, fw: i32, fh: i32,
    out_x: *f64, out_y: *f64) {
    @out_x = x * cursor_scale(ww, fw);
    @out_y = y * cursor_scale(wh, fh);
}

fun rebase_cursor(s: *Sink, x: f64, y: f64,
    ww: i32, wh: i32, fw: i32, fh: i32) {
    if (s == nil) { ret; }
    var px: f64 = 0.0;
    var py: f64 = 0.0;
    cursor_pixels(x, y, ww, wh, fw, fh, ?px, ?py);
    inp.input_mouse_rebase(s.input, px, py);
    s.cursor_x     = x;
    s.cursor_y     = y;
    s.cursor_known = true;
}

fun deliver_cursor(s: *Sink, x: f64, y: f64,
    ww: i32, wh: i32, fw: i32, fh: i32) {
    if (s == nil) { ret; }
    val sx: f64 = cursor_scale(ww, fw);
    val sy: f64 = cursor_scale(wh, fh);
    var px: f64 = x * sx;
    var py: f64 = y * sy;
    var dx: f64 = px;
    var dy: f64 = py;
    if (s.cursor_known) {
        dx = (x - s.cursor_x) * sx;
        dy = (y - s.cursor_y) * sy;
    }
    inp.input_mouse_event_with_delta(s.input, px, py, dx, dy);
    s.cursor_x     = x;
    s.cursor_y     = y;
    s.cursor_known = true;
    offer(s.queue, Event.mouse_move{MoveEvent{x: px, y: py}});
}

# translate a GLFW key code into a boom Key
#
# an unrecognized code becomes KEY_UNKNOWN, which every query reports false
# for, so an unmapped key is inert rather than aliasing onto a real one.
fun map_key(k: i32) inp.Key {
    if (k >= glfw.KEY_A && k <= glfw.KEY_Z)    { ret (inp.KEY_A + (k - glfw.KEY_A))::inp.Key; }
    if (k >= glfw.KEY_0 && k <= glfw.KEY_9)    { ret (inp.KEY_0 + (k - glfw.KEY_0))::inp.Key; }
    if (k >= glfw.KEY_F1 && k <= glfw.KEY_F12) { ret (inp.KEY_F1 + (k - glfw.KEY_F1))::inp.Key; }
    if (k == glfw.KEY_SPACE)                   { ret inp.KEY_SPACE; }
    if (k == glfw.KEY_ESCAPE)                  { ret inp.KEY_ESCAPE; }
    if (k == glfw.KEY_ENTER)                   { ret inp.KEY_ENTER; }
    if (k == glfw.KEY_TAB)                     { ret inp.KEY_TAB; }
    if (k == glfw.KEY_BACKSPACE)               { ret inp.KEY_BACKSPACE; }
    if (k == glfw.KEY_DELETE)                  { ret inp.KEY_DELETE; }
    if (k == glfw.KEY_LEFT)                    { ret inp.KEY_LEFT; }
    if (k == glfw.KEY_RIGHT)                   { ret inp.KEY_RIGHT; }
    if (k == glfw.KEY_UP)                      { ret inp.KEY_UP; }
    if (k == glfw.KEY_DOWN)                    { ret inp.KEY_DOWN; }
    if (k == glfw.KEY_LEFT_SHIFT)              { ret inp.KEY_LEFT_SHIFT; }
    if (k == glfw.KEY_LEFT_CONTROL)            { ret inp.KEY_LEFT_CTRL; }
    if (k == glfw.KEY_LEFT_ALT)                { ret inp.KEY_LEFT_ALT; }
    if (k == glfw.KEY_RIGHT_SHIFT)             { ret inp.KEY_RIGHT_SHIFT; }
    if (k == glfw.KEY_RIGHT_CONTROL)           { ret inp.KEY_RIGHT_CTRL; }
    if (k == glfw.KEY_RIGHT_ALT)               { ret inp.KEY_RIGHT_ALT; }
    if (k == glfw.KEY_LEFT_SUPER)              { ret inp.KEY_LEFT_SUPER; }
    if (k == glfw.KEY_RIGHT_SUPER)             { ret inp.KEY_RIGHT_SUPER; }
    if (k == glfw.KEY_HOME)                    { ret inp.KEY_HOME; }
    if (k == glfw.KEY_END)                     { ret inp.KEY_END; }
    if (k == glfw.KEY_PAGE_UP)                 { ret inp.KEY_PAGE_UP; }
    if (k == glfw.KEY_PAGE_DOWN)               { ret inp.KEY_PAGE_DOWN; }
    if (k == glfw.KEY_INSERT)                  { ret inp.KEY_INSERT; }
    ret inp.KEY_UNKNOWN;
}

# translate a GLFW key action, none for a code glfw does not define
fun map_key_action(action: i32) opt[KeyAction] {
    if (action == glfw.PRESS)   { ret opt[KeyAction].some{KeyAction.press{}}; }
    if (action == glfw.RELEASE) { ret opt[KeyAction].some{KeyAction.release{}}; }
    if (action == glfw.REPEAT)  { ret opt[KeyAction].some{KeyAction.repeat{}}; }
    ret opt[KeyAction].none{};
}

# translate a GLFW mouse button into a boom Button, none for a button boom does not name
fun map_button(b: i32) opt[inp.Button] {
    if (b == glfw.MOUSE_BUTTON_LEFT)   { ret opt[inp.Button].some{inp.BUTTON_LEFT}; }
    if (b == glfw.MOUSE_BUTTON_RIGHT)  { ret opt[inp.Button].some{inp.BUTTON_RIGHT}; }
    if (b == glfw.MOUSE_BUTTON_MIDDLE) { ret opt[inp.Button].some{inp.BUTTON_MIDDLE}; }
    if (b == glfw.MOUSE_BUTTON_4)      { ret opt[inp.Button].some{inp.BUTTON_X1}; }
    if (b == glfw.MOUSE_BUTTON_5)      { ret opt[inp.Button].some{inp.BUTTON_X2}; }
    ret opt[inp.Button].none{};
}

# translate GLFW modifier bits into boom's MOD_* bits, dropping the lock keys
fun map_mods(m: i32) i32 {
    var out: i32 = 0;
    if ((m & glfw.MOD_SHIFT) != 0)   { out = out | inp.MOD_SHIFT; }
    if ((m & glfw.MOD_CONTROL) != 0) { out = out | inp.MOD_CTRL; }
    if ((m & glfw.MOD_ALT) != 0)     { out = out | inp.MOD_ALT; }
    if ((m & glfw.MOD_SUPER) != 0)   { out = out | inp.MOD_SUPER; }
    ret out;
}

# open a window
#
# the client API hint is NO_API: GLFW would create an OpenGL context by
# default, and a window carrying one cannot back a Vulkan surface.
#
# there is no swap interval and no command-table load. presentation is
# the swapchain's present mode, and Vulkan commands are resolved through
# the loader in boom.graphics.vk rather than through the window, so there
# is no buffer swap here either: the renderer presents.
# ---
# THE RECORDED SIZE IS IN PIXELS, NOT SCREEN COORDINATES. GLFW takes the
# requested size in screen coordinates, which on a scaled display is not the
# framebuffer size: a 960x540 request becomes a 1920x1080 framebuffer at 2x.
# The swapchain, the viewport, and the 2D projection all work in pixels, so
# the actual framebuffer size is what is recorded, not the request.
# ---
# width:  desired client-area width in screen coordinates
# height: desired client-area height in screen coordinates
# title:  window title, UTF-8
# ret:    the opened Window sized in framebuffer pixels, or why it could not open
pub fun window_open(width: i32, height: i32, title: str) res[Window, WindowError] {
    ret window_open_mode(width, height, title, WindowMode.windowed{});
}

# open a window in one explicit presentation mode
# ---
# width:  ordinary windowed client width in screen coordinates
# height: ordinary windowed client height in screen coordinates
# title:  window title, UTF-8
# mode:   initial windowed, borderless, or fullscreen policy
# ret:    opened Window sized in framebuffer pixels, or why it could not open
pub fun window_open_mode(width: i32, height: i32, title: str,
    mode: WindowMode) res[Window, WindowError] {
    # x11 reports the IME's composition only on the spot. over the spot, the
    # input method draws it itself and no compose event ever arrives
    glfw.init_hint(glfw.X11_ONTHESPOT, glfw.TRUE);
    val started: err[glfw.Error] = glfw.init();
    if (sel started.err) {
        ret res[Window, WindowError].err{WindowError.init{started.err}};
    }

    val monitor:     opt[glfw.Monitor] = glfw.get_primary_monitor();
    var open_width:  i32               = width;
    var open_height: i32               = height;
    var attached:    opt[glfw.Monitor] = opt[glfw.Monitor].none{};
    var mx:          i32               = 0;
    var my:          i32               = 0;
    var video:       opt[*Vidmode]     = opt[*Vidmode].none{};
    if (sel monitor.some) { video = glfw.get_video_mode(monitor.some); }
    if (!sel mode.windowed) {
        if (!sel video.some) {
            glfw.terminate();
            ret res[Window, WindowError].err{mode_refusal(mode, sel monitor.some)};
        }
        open_width  = video.some.width;
        open_height = video.some.height;
        if (sel monitor.some) { glfw.get_monitor_pos(monitor.some, ?mx, ?my); }
    }
    if (sel mode.fullscreen || (sel mode.borderless && platform_wayland())) {
        attached = monitor;
    }

    var restore: WindowBounds = WindowBounds{x: 0, y: 0, width: width, height: height};
    if (sel monitor.some) {
        restore = centered_bounds(monitor.some, width, height);
    }
    val restore_maximized: bool = sel mode.windowed
        && windowed_should_maximize(restore, monitor);

    glfw.default_window_hints();
    glfw.window_hint(glfw.CLIENT_API, glfw.NO_API);
    if (sel mode.borderless) {
        glfw.window_hint(glfw.DECORATED, glfw.FALSE);
        glfw.window_hint(glfw.RESIZABLE, glfw.FALSE);
    }
    if (restore_maximized) {
        glfw.window_hint(glfw.MAXIMIZED, glfw.TRUE);
    }

    val created: res[glfw.Window, glfw.Error] = glfw.create_window(
        open_width, open_height, title, attached, opt[glfw.Window].none{});
    if (sel created.err) {
        glfw.terminate();
        ret res[Window, WindowError].err{WindowError.create{ModeCreate{mode: mode, cause: created.err}}};
    }
    val win: glfw.Window = created.ok;

    if (sel mode.borderless) {
        glfw.set_window_attrib(win, glfw.DECORATED, glfw.FALSE);
        glfw.set_window_attrib(win, glfw.RESIZABLE, glfw.FALSE);
        if (!platform_wayland()) { glfw.set_window_pos(win, mx, my); }
    }
    or (sel mode.windowed) {
        if (restore_maximized) { glfw.maximize_window(win); }
        or {
            glfw.set_window_pos(win, restore.x, restore.y);
            if (sel monitor.some) {
                restore = fit_windowed(win, restore, monitor.some, 1, 1);
            }
        }
    }

    glfw.set_key_callback(win, on_key);
    glfw.set_char_callback(win, on_char);
    glfw.set_drop_callback(win, on_drop);
    glfw.set_preedit_callback(win, on_preedit);
    glfw.set_mouse_button_callback(win, on_mouse_button);
    glfw.set_cursor_pos_callback(win, on_cursor_pos);
    glfw.set_cursor_enter_callback(win, on_cursor_enter);
    glfw.set_scroll_callback(win, on_scroll);
    glfw.set_framebuffer_size_callback(win, on_framebuffer_size);

    var fw: i32 = width;
    var fh: i32 = height;
    glfw.get_framebuffer_size(win, ?fw, ?fh);
    ret res[Window, WindowError].ok{Window{
        handle:     opt[glfw.Window].some{win}, width: fw, height: fh, mode: mode,
        monitor:    monitor, windowed: restore, windowed_maximized: restore_maximized,
        min_width:  1, min_height: 1, renderers: 0, shape: CURSOR_ARROW, shape_shown: true,
        text_input: opt[bool].none{}
    }};
}

# the current semantic window mode
# ---
# w:   window to query
# ret: retained mode
pub fun window_mode(w: *Window) WindowMode {
    ret w.mode;
}

# the platform handle of an open window
#
# what boom.graphics creates its Vulkan surface against.
# ---
# w:   window to query
# ret: the live GLFW window, or none once closed
pub fun window_handle(w: *Window) opt[glfw.Window] {
    ret w.handle;
}

# change the live window mode without recreating the Vulkan surface
# ---
# w:    live window to update outside an open render frame
# mode: requested presentation mode
# ret:  ok when the request was applied or already active, or why it was refused
pub fun window_set_mode(w: *Window, mode: WindowMode) err[WindowError] {
    if (!sel w.handle.some) { ret err[WindowError].err{WindowError.closed{}}; }
    val handle: glfw.Window = w.handle.some;
    if (same_mode(w.mode, mode)) { ret err[WindowError].ok{}; }

    if (sel w.mode.windowed) {
        w.windowed_maximized = glfw.get_window_attrib(
            handle, glfw.MAXIMIZED) == glfw.TRUE;
        if (!w.windowed_maximized) {
            if (!platform_wayland()) {
                glfw.get_window_pos(handle, ?w.windowed.x, ?w.windowed.y);
            }
            glfw.get_window_size(handle, ?w.windowed.width, ?w.windowed.height);
        }
    }

    val found: opt[glfw.Monitor] = monitor_for_window(w, handle);
    if (!sel found.some) { ret err[WindowError].err{mode_refusal(mode, false)}; }
    val monitor:    glfw.Monitor  = found.some;
    val mode_video: opt[*Vidmode] = glfw.get_video_mode(monitor);
    if (!sel mode_video.some) { ret err[WindowError].err{mode_refusal(mode, true)}; }
    val video: *Vidmode = mode_video.some;

    var mx: i32 = 0;
    var my: i32 = 0;
    glfw.get_monitor_pos(monitor, ?mx, ?my);
    glfw.restore_window(handle);

    if (sel mode.windowed) {
        glfw.set_window_monitor(handle, opt[glfw.Monitor].none{},
            w.windowed.x, w.windowed.y,
            w.windowed.width, w.windowed.height, glfw.DONT_CARE);
        glfw.set_window_attrib(handle, glfw.RESIZABLE, glfw.TRUE);
        glfw.set_window_attrib(handle, glfw.DECORATED, glfw.TRUE);
        if (w.windowed_maximized
            || windowed_should_maximize(w.windowed, opt[glfw.Monitor].some{monitor})) {
            w.windowed_maximized = true;
            glfw.maximize_window(handle);
        }
        or {
            w.windowed = fit_windowed(handle, w.windowed, monitor,
                w.min_width, w.min_height);
        }
    }
    or (sel mode.borderless) {
        glfw.set_window_attrib(handle, glfw.DECORATED, glfw.FALSE);
        if (platform_wayland()) {
            glfw.set_window_monitor(handle, opt[glfw.Monitor].some{monitor}, 0, 0,
                video.width, video.height, video.refreshRate);
        }
        or {
            glfw.set_window_monitor(handle, opt[glfw.Monitor].none{}, mx, my,
                video.width, video.height, glfw.DONT_CARE);
        }
        glfw.set_window_attrib(handle, glfw.RESIZABLE, glfw.FALSE);
        glfw.set_window_attrib(handle, glfw.DECORATED, glfw.FALSE);
    }
    or {
        glfw.set_window_monitor(handle, opt[glfw.Monitor].some{monitor}, 0, 0,
            video.width, video.height, video.refreshRate);
        glfw.set_window_attrib(handle, glfw.RESIZABLE, glfw.FALSE);
    }

    w.mode    = mode;
    w.monitor = opt[glfw.Monitor].some{monitor};
    window_refresh_size(w);
    ret err[WindowError].ok{};
}

# whether two modes name the same presentation
fun same_mode(a: WindowMode, b: WindowMode) bool {
    if (sel a.windowed)   { ret sel b.windowed; }
    if (sel a.borderless) { ret sel b.borderless; }
    ret sel b.fullscreen;
}

# refresh the recorded size from the platform
#
# A window is resizable, so its size is not a property of how it was opened. A
# game reading w.width after a resize would otherwise lay its interface out
# against dimensions the window has not had since startup.
#
# In pixels, for the same reason window_open records pixels. The cursor is
# rebased into that same space here as well. A minimized window reports zero in
# at least one dimension, which is a legal state and not a failure, so it is
# recorded as-is; callers that cannot divide by it check.
# ---
# w: window to update in place
pub fun window_refresh_size(w: *Window) {
    if (!sel w.handle.some) { ret; }
    val handle: glfw.Window = w.handle.some;
    var ww:     i32         = 0;
    var wh:     i32         = 0;
    var fw:     i32         = 0;
    var fh:     i32         = 0;
    glfw.get_window_size(handle, ?ww, ?wh);
    glfw.get_framebuffer_size(handle, ?fw, ?fh);
    w.width  = fw;
    w.height = fh;

    # Cursor callbacks carry screen coordinates. Re-read the current position
    # beside the new size so a stationary pointer follows a DPI or resize
    # change without inventing a movement event.
    var x: f64 = 0.0;
    var y: f64 = 0.0;
    glfw.get_cursor_pos(handle, ?x, ?y);
    rebase_cursor(sink_of(handle), x, y, ww, wh, fw, fh);
}

# whether the window is open
# ---
# w:   window to test
# ret: true while the window holds a live handle
pub fun window_is_valid(w: *Window) bool {
    ret sel w.handle.some;
}

# Set the smallest client area the platform may resize a window to.
# ---
# w:      open window to constrain
# width:  minimum client width in screen coordinates
# height: minimum client height in screen coordinates
pub fun window_set_min_size(w: *Window, width: i32, height: i32) {
    if (!sel w.handle.some)        { ret; }
    if (width <= 0 || height <= 0) { ret; }
    w.min_width  = width;
    w.min_height = height;
    glfw.set_window_size_limits(w.handle.some, width, height, glfw.DONT_CARE, glfw.DONT_CARE);
}

# capture or release the pointer for relative first-person look
#
# ret: true when the platform reports the requested cursor mode
pub fun window_set_cursor_captured(w: *Window, captured: bool) bool {
    if (!sel w.handle.some) { ret false; }
    val handle: glfw.Window = w.handle.some;
    var mode:   i32         = glfw.CURSOR_NORMAL;
    if (captured) { mode = glfw.CURSOR_DISABLED; }
    glfw.set_input_mode(handle, glfw.CURSOR, mode);
    if (glfw.raw_mouse_motion_supported()) {
        var raw: i32 = glfw.FALSE;
        if (captured) { raw = glfw.TRUE; }
        glfw.set_input_mode(handle, glfw.RAW_MOUSE_MOTION, raw);
    }
    window_refresh_size(w);
    ret glfw.get_input_mode(handle, glfw.CURSOR) == mode;
}

# whether the pointer is currently captured for relative motion
pub fun window_cursor_captured(w: *Window) bool {
    if (!sel w.handle.some) { ret false; }
    ret glfw.get_input_mode(w.handle.some, glfw.CURSOR) == glfw.CURSOR_DISABLED;
}

# a pointer shape shown over a window's client area
pub def CursorShape: u8;

pub val CURSOR_ARROW:       CursorShape = 0;
pub val CURSOR_TEXT:        CursorShape = 1;
pub val CURSOR_HAND:        CursorShape = 2;
pub val CURSOR_MOVE:        CursorShape = 3;
pub val CURSOR_RESIZE_EW:   CursorShape = 4;
pub val CURSOR_RESIZE_NS:   CursorShape = 5;
pub val CURSOR_RESIZE_NWSE: CursorShape = 6;
pub val CURSOR_RESIZE_NESW: CursorShape = 7;
pub val CURSOR_NOT_ALLOWED: CursorShape = 8;

# One past the highest shape
pub val CURSOR_SHAPE_COUNT: usize = 9;

# the platform's standard cursors, created on first use and tried once each.
# glfw owns them until terminate, which window_close calls, so closing forgets
# them
var cursors:      [9]ptr;
var cursor_made:  [9]bool;
var cursor_tried: [9]bool;

# the GLFW standard cursor a shape names
fun cursor_token(shape: CursorShape) i32 {
    if (shape == CURSOR_TEXT)        { ret glfw.IBEAM_CURSOR; }
    if (shape == CURSOR_HAND)        { ret glfw.POINTING_HAND_CURSOR; }
    if (shape == CURSOR_MOVE)        { ret glfw.RESIZE_ALL_CURSOR; }
    if (shape == CURSOR_RESIZE_EW)   { ret glfw.RESIZE_EW_CURSOR; }
    if (shape == CURSOR_RESIZE_NS)   { ret glfw.RESIZE_NS_CURSOR; }
    if (shape == CURSOR_RESIZE_NWSE) { ret glfw.RESIZE_NWSE_CURSOR; }
    if (shape == CURSOR_RESIZE_NESW) { ret glfw.RESIZE_NESW_CURSOR; }
    if (shape == CURSOR_NOT_ALLOWED) { ret glfw.NOT_ALLOWED_CURSOR; }
    ret glfw.ARROW_CURSOR;
}

# show a pointer shape over the window's client area
#
# a shape the platform's cursor theme lacks shows the default arrow, and the
# call reports it. setting the shape last set does nothing.
# ---
# w:     open window to change; a closed window is refused
# shape: a CURSOR_* shape
# ret:   true when the platform shows the shape
pub fun window_set_cursor_shape(w: *Window, shape: CursorShape) bool {
    if (!sel w.handle.some)                 { ret false; }
    if (shape::usize >= CURSOR_SHAPE_COUNT) { ret false; }
    if (w.shape == shape)                   { ret w.shape_shown; }
    val i: usize = shape::usize;
    if (!cursor_tried[i] && shape != CURSOR_ARROW) {
        cursor_tried[i] = true;
        val made: res[glfw.Cursor, glfw.Error] = glfw.create_standard_cursor(cursor_token(shape));
        if (sel made.ok) {
            cursors[i]     = made.ok.handle;
            cursor_made[i] = true;
        }
    }
    w.shape       = shape;
    w.shape_shown = shape == CURSOR_ARROW || cursor_made[i];
    if (w.shape_shown && shape != CURSOR_ARROW) {
        glfw.set_cursor(w.handle.some, opt[glfw.Cursor].some{glfw.Cursor{handle: cursors[i]}});
    }
    or {
        glfw.set_cursor(w.handle.some, opt[glfw.Cursor].none{});
    }
    ret w.shape_shown;
}

# the pointer shape last set on the window
# ---
# w:   window to query
# ret: a CURSOR_* shape, CURSOR_ARROW until one is set
pub fun window_cursor_shape(w: *Window) CursorShape {
    ret w.shape;
}

# the clipboard's text
#
# an empty or non-text clipboard, and a closed window, read as the empty
# string: nothing pasteable is a normal state, not a failure. the copy is the
# caller's, released with std.text.string.str_free against the same allocator.
# ---
# a:   allocator for the copy
# w:   window the platform clipboard is read through
# ret: an owned UTF-8 copy, or the allocator's refusal
pub fun window_clipboard_get(a: *allo.Allocator, w: *Window) res[str, allo.Error] {
    if (!sel w.handle.some) { ret text.str_dup(a, ""); }
    val got: opt[str] = glfw.get_clipboard_string();
    if (!sel got.some) { ret text.str_dup(a, ""); }
    ret text.str_dup(a, got.some);
}

# replace the clipboard's text
#
# the platform copies the text before this returns. a closed window leaves
# the clipboard untouched. wayland only honours a write while the window has
# input focus, so a write from an unfocused window may be dropped.
# ---
# w:        window the platform clipboard is written through
# contents: UTF-8 text to place on the clipboard
pub fun window_clipboard_set(w: *Window, contents: str) {
    if (!sel w.handle.some) { ret; }
    glfw.set_clipboard_string(contents);
}

# enter or leave a text input context, such as a focused text field
#
# the IME composes only inside one: leaving it ends any composition in
# progress. a window never told keeps the platform's default, and a call that
# repeats the current state does nothing.
# ---
# w:  window to change; a closed window is left alone
# on: true while a text field takes text, false once none does
pub fun window_set_text_input(w: *Window, on: bool) {
    if (!sel w.handle.some)                               { ret; }
    if (sel w.text_input.some && w.text_input.some == on) { ret; }
    glfw.set_text_input_focus(w.handle.some, on);
    w.text_input = opt[bool].some{on};
}

# place the IME's candidate window against a rect, normally the caret of the
# text field taking text
#
# x11 places it only while composing over the spot, which boom does not use,
# so there the input method places it on its own.
# ---
# w:      window to change; a closed window is left alone
# x:      left edge in framebuffer pixels
# y:      top edge in framebuffer pixels
# width:  width in framebuffer pixels
# height: height in framebuffer pixels
pub fun window_set_ime_rect(w: *Window, x: f64, y: f64, width: f64, height: f64) {
    if (!sel w.handle.some) { ret; }
    val handle: glfw.Window = w.handle.some;
    var ww:     i32         = 0;
    var wh:     i32         = 0;
    var fw:     i32         = 0;
    var fh:     i32         = 0;
    glfw.get_window_size(handle, ?ww, ?wh);
    glfw.get_framebuffer_size(handle, ?fw, ?fh);
    var x0: i32 = 0;
    var y0: i32 = 0;
    var x1: i32 = 0;
    var y1: i32 = 0;
    window_span(x, x + width, ww, fw, ?x0, ?x1);
    window_span(y, y + height, wh, fh, ?y0, ?y1);
    glfw.set_preedit_cursor_rectangle(handle, x0, y0, x1 - x0, y1 - y0);
}

# a span of framebuffer pixels in window coordinates, widened outward to whole
# coordinates
fun window_span(lo: f64, hi: f64, window: i32, framebuffer: i32, out_lo: *i32, out_hi: *i32) {
    val s: f64 = cursor_scale(window, framebuffer);
    @out_lo = floor_i32(lo / s);
    @out_hi = -floor_i32(-(hi / s));
}

fun floor_i32(v: f64) i32 {
    val t: i32 = v::i32;
    if (t::f64 > v) { ret t - 1; }
    ret t;
}

# route this window's input into a queue
#
# where the platform callbacks deliver input
#
# both destinations travel together because every callback feeds both: the
# queue preserves order for UI and discrete actions, the Input answers held
# state for movement. pass a Sink that outlives the window.
# ---
# queue:        receives ordered events
# input:        receives state transitions
# cursor_x:     last raw window-coordinate x used to form a movement delta
# cursor_y:     last raw window-coordinate y used to form a movement delta
# cursor_known: whether cursor_x/y have been initialized
pub rec Sink {
    queue:        *EventQueue;
    input:        *inp.Input;
    cursor_x:     f64;
    cursor_y:     f64;
    cursor_known: bool;
}

# route this window's input at the given sink
# ---
# w:   window to observe; a closed window routes nothing and is refused
# s:   sink to receive input; must outlive the window. Its cursor position is
#      initialized in framebuffer pixels without reporting synthetic motion,
#      and its pointer presence from whether the pointer is over the window
#      now, without queuing an enter: one that arrived before the sink did
#      was dropped.
# ret: ok, closed for a window that is not open, or alloc when the sink
#      registry could not grow
pub fun window_set_event_sink(w: *Window, s: *Sink) err[WindowError] {
    if (!sel w.handle.some) { ret err[WindowError].err{WindowError.closed{}}; }
    val handle: glfw.Window = w.handle.some;
    var ww:     i32         = 0;
    var wh:     i32         = 0;
    var fw:     i32         = 0;
    var fh:     i32         = 0;
    var x:      f64         = 0.0;
    var y:      f64         = 0.0;
    glfw.get_window_size(handle, ?ww, ?wh);
    glfw.get_framebuffer_size(handle, ?fw, ?fh);
    glfw.get_cursor_pos(handle, ?x, ?y);
    rebase_cursor(s, x, y, ww, wh, fw, fh);
    inp.input_pointer_event(s.input, glfw.get_window_attrib(handle, glfw.HOVERED) != 0);
    glfw.set_window_user_pointer(handle, s::ptr);
    val registered: err[allo.Error] = register_queue(handle.handle, s.queue);
    if (sel registered.err) { ret err[WindowError].err{WindowError.alloc{registered.err}}; }
    ret err[WindowError].ok{};
}

# whether the window has been asked to close
# ---
# w:   window to query
# ret: true once the platform's window-close flag is set, or once the window is closed
pub fun window_should_close(w: *Window) bool {
    if (!sel w.handle.some) { ret true; }
    ret glfw.window_should_close(w.handle.some);
}

# one window's event queue, as window_poll must release it
# ---
# handle: the window's platform handle
# queue:  the queue installed on that window
rec Registered {
    handle: ptr;
    queue:  *EventQueue;
}

# every window with a sink installed, packed in the first registry_len slots.
# glfwPollEvents services every window, so the poll releases every one of their
# queues, not one. it grows on demand from the page allocator
var registry:     *Registered = nil;
var registry_len: usize       = 0;
var registry_cap: usize       = 0;

# record the queue a window's sink feeds, replacing the window's earlier entry
# ---
# handle: the window's platform handle
# q:      the queue its sink feeds
# ret:    ok, or why the registry could not grow
fun register_queue(handle: ptr, q: *EventQueue) err[allo.Error] {
    var i: usize = 0;
    for (i < registry_len) {
        if (registry[i].handle == handle) {
            registry[i].queue = q;
            ret err[allo.Error].ok{};
        }
        i = i + 1;
    }
    if (registry_len == registry_cap) {
        var a: allo.Allocator;
        page.make(?a);
        var cap: usize = 4;
        if (registry_cap != 0) { cap = registry_cap * 2; }
        val grown: res[*Registered, allo.Error] = allo.reallocate[Registered](?a, registry, registry_cap, cap);
        if (sel grown.err) { ret err[allo.Error].err{grown.err}; }
        registry     = grown.ok;
        registry_cap = cap;
    }
    registry[registry_len] = Registered{handle: handle, queue: q};
    registry_len           = registry_len + 1;
    ret err[allo.Error].ok{};
}

fun unregister_queue(handle: ptr) {
    var i: usize = 0;
    for (i < registry_len) {
        if (registry[i].handle == handle) {
            registry_len = registry_len - 1;
            registry[i]  = registry[registry_len];
            ret;
        }
        i = i + 1;
    }
}

# process pending platform events, firing input callbacks
#
# first frees the dropped-file paths the consumers popped since the last poll,
# for every window's queue, so a drop event's paths are valid until the next
# call of this.
pub fun window_poll() {
    poll_release();
    glfw.poll_events();
}

# process platform events as window_poll does, sleeping until at least one
# arrives
#
# for an app with nothing to draw until input. gamepads deliver no events, so
# they do not wake it.
pub fun window_wait() {
    poll_release();
    glfw.wait_events();
}

# process platform events as window_poll does, sleeping until one arrives or
# the timeout passes
# ---
# seconds: longest time to sleep; zero or less polls without sleeping
pub fun window_wait_timeout(seconds: f64) {
    poll_release();
    if (seconds <= 0.0) {
        glfw.poll_events();
        ret;
    }
    glfw.wait_events_timeout(seconds);
}

fun poll_release() {
    var i: usize = 0;
    for (i < registry_len) {
        queue_release(registry[i].queue);
        i = i + 1;
    }
}

# destroy the window and shut down GLFW
#
# Refused while a renderer holds a surface on the window: that surface is
# destroyed by renderer_dnit, and destroying the window first pulls the
# platform layer out from under it. Tear down resources, then the renderer,
# then the window.
# ---
# w:   window to close; closing a closed window does nothing
# ret: ok, or in_use with how many renderers still hold the window
pub fun window_close(w: *Window) err[WindowError] {
    if (w.renderers != 0) { ret err[WindowError].err{WindowError.in_use{w.renderers}}; }
    if (sel w.handle.some) {
        glfw.set_window_user_pointer(w.handle.some, nil);
        unregister_queue(w.handle.some.handle);
        glfw.destroy_window(w.handle.some);
        glfw.terminate();
        forget_cursors();
    }
    w.handle = opt[glfw.Window].none{};
    w.width  = 0;
    w.height = 0;
    ret err[WindowError].ok{};
}

fun forget_cursors() {
    var i: usize = 0;
    for (i < CURSOR_SHAPE_COUNT) {
        cursor_made[i]  = false;
        cursor_tried[i] = false;
        i               = i + 1;
    }
}

fun centered_bounds(monitor: glfw.Monitor, width: i32, height: i32) WindowBounds {
    var x: i32 = 0;
    var y: i32 = 0;
    var w: i32 = width;
    var h: i32 = height;
    glfw.get_monitor_workarea(monitor, ?x, ?y, ?w, ?h);
    ret clamp_bounds(WindowBounds{
        x:      x + (w - width) / 2,
        y:      y + (h - height) / 2,
        width:  width,
        height: height,
    }, WindowBounds{x: x, y: y, width: w, height: h},
        WindowBounds{x: 0, y: 0, width: 0, height: 0}, 1, 1);
}

fun fit_windowed(handle: glfw.Window, bounds: WindowBounds,
    monitor: glfw.Monitor, min_width: i32,
    min_height: i32) WindowBounds {
    var area: WindowBounds;
    glfw.get_monitor_workarea(monitor, ?area.x, ?area.y, ?area.width, ?area.height);
    var frame: WindowBounds;
    # wayland deliberately withholds server-decoration extents and placement;
    # glfw reports zeroes there and the compositor remains authoritative. A
    # smaller restore remains its request rather than guessing at hidden chrome.
    glfw.get_window_frame_size(handle, ?frame.x, ?frame.y, ?frame.width, ?frame.height);
    val fitted: WindowBounds = clamp_bounds(bounds, area, frame, min_width, min_height);
    glfw.set_window_size(handle, fitted.width, fitted.height);
    glfw.set_window_pos(handle, fitted.x, fitted.y);
    ret fitted;
}

fun windowed_should_maximize(bounds: WindowBounds,
    monitor: opt[glfw.Monitor]) bool {
    if (!platform_wayland()) { ret false; }
    if (!sel monitor.some)   { ret false; }
    var area: WindowBounds;
    glfw.get_monitor_workarea(monitor.some, ?area.x, ?area.y, ?area.width, ?area.height);
    ret bounds_reach_area(bounds, area);
}

fun bounds_reach_area(bounds: WindowBounds, area: WindowBounds) bool {
    ret bounds.width >= area.width || bounds.height >= area.height;
}

fun platform_wayland() bool {
    ret glfw.get_platform() == glfw.PLATFORM_WAYLAND;
}

fun clamp_bounds(bounds: WindowBounds, area: WindowBounds, frame: WindowBounds,
    min_width: i32, min_height: i32) WindowBounds {
    var out:              WindowBounds = bounds;
    val available_width:  i32          = max_value(1, area.width - frame.x - frame.width);
    val available_height: i32          = max_value(1, area.height - frame.y - frame.height);
    out.width  = clamp_value(out.width, min_value(min_width, available_width), available_width);
    out.height = clamp_value(out.height, min_value(min_height, available_height), available_height);
    val left: i32 = area.x + frame.x;
    val top:  i32 = area.y + frame.y;
    out.x = clamp_value(out.x, left, area.x + area.width - frame.width - out.width);
    out.y = clamp_value(out.y, top, area.y + area.height - frame.height - out.height);
    ret out;
}

# the monitor a live window should change mode on, none when no monitor is connected
fun monitor_for_window(w: *Window, handle: glfw.Window) opt[glfw.Monitor] {
    if (sel w.monitor.some) {
        if (monitor_connected(w.monitor.some)
            && prefer_retained_monitor(platform_wayland(), w.mode)) {
            ret w.monitor;
        }
    }

    var wx: i32 = w.windowed.x;
    var wy: i32 = w.windowed.y;
    var ww: i32 = w.windowed.width;
    var wh: i32 = w.windowed.height;
    if (!sel w.mode.windowed) {
        glfw.get_window_pos(handle, ?wx, ?wy);
        glfw.get_window_size(handle, ?ww, ?wh);
    }

    var count:     i32               = 0;
    val handles:   *ptr              = glfw.get_monitors(?count);
    var best:      opt[glfw.Monitor] = glfw.get_primary_monitor();
    var best_area: i64               = 0;
    var i:         i32               = 0;
    for (handles != nil && i < count) {
        val current: glfw.Monitor = glfw.monitor_from_handle(handles[i]);
        var x:       i32          = 0;
        var y:       i32          = 0;
        var width:   i32          = 0;
        var height:  i32          = 0;
        glfw.get_monitor_workarea(current, ?x, ?y, ?width, ?height);
        val overlap: i64 = overlap_area(wx, wy, ww, wh, x, y, width, height);
        if (overlap > best_area) {
            best      = opt[glfw.Monitor].some{current};
            best_area = overlap;
        }
        i = i + 1;
    }
    ret best;
}

# the most monitors one window placement considers
val MAX_MONITORS: usize = 16;

# which of the work areas a rectangle shows the most of, the earliest on a tie,
# and -1 when it shows none of them
fun best_overlap(x: i32, y: i32, width: i32, height: i32,
    areas: *WindowBounds, count: usize) i32 {
    var best:      i32   = -1;
    var best_area: i64   = 0;
    var i:         usize = 0;
    for (i < count) {
        val a:       WindowBounds = areas[i];
        val overlap: i64          = overlap_area(x, y, width, height, a.x, a.y, a.width, a.height);
        if (overlap > best_area) {
            best      = i::i32;
            best_area = overlap;
        }
        i = i + 1;
    }
    ret best;
}

# the monitor a rectangle in screen coordinates shows the most of, none when
# it shows none of them or no monitor is connected
fun monitor_at(x: i32, y: i32, width: i32, height: i32) opt[glfw.Monitor] {
    var count:   i32   = 0;
    val handles: *ptr  = glfw.get_monitors(?count);
    var areas:   [MAX_MONITORS]WindowBounds;
    var n:       usize = 0;
    for (handles != nil && n::i32 < count && n < MAX_MONITORS) {
        val current: glfw.Monitor = glfw.monitor_from_handle(handles[n]);
        var ax:      i32          = 0;
        var ay:      i32          = 0;
        var aw:      i32          = 0;
        var ah:      i32          = 0;
        glfw.get_monitor_workarea(current, ?ax, ?ay, ?aw, ?ah);
        areas[n] = WindowBounds{x: ax, y: ay, width: aw, height: ah};
        n        = n + 1;
    }
    val at: i32 = best_overlap(x, y, width, height, ?areas[0], n);
    if (at < 0) { ret opt[glfw.Monitor].none{}; }
    ret opt[glfw.Monitor].some{glfw.monitor_from_handle(handles[at::usize])};
}

# the refresh rate of the monitor the window is on now
#
# A windowed window is placed by where it is on screen at the call, so dragging
# it to another display changes the answer. A borderless or fullscreen window
# is on the monitor it was set to, and on wayland, which does not report where
# a window is, a windowed one is on the last monitor boom recorded for it.
#
# Zero means the rate cannot be known, because the window is closed, no monitor
# is connected, or the platform reports none for the current mode. It is never
# a guess, so the caller picks its own fallback.
# ---
# w:   window to query
# ret: the current video mode's refresh rate in hertz, or zero
pub fun window_refresh_hz(w: *Window) f32 {
    if (!sel w.handle.some) { ret 0.0; }
    val handle:  glfw.Window       = w.handle.some;
    var monitor: opt[glfw.Monitor] = monitor_for_window(w, handle);
    if (sel w.mode.windowed && !platform_wayland()) {
        var wx: i32 = 0;
        var wy: i32 = 0;
        var ww: i32 = 0;
        var wh: i32 = 0;
        glfw.get_window_pos(handle, ?wx, ?wy);
        glfw.get_window_size(handle, ?ww, ?wh);
        val at: opt[glfw.Monitor] = monitor_at(wx, wy, ww, wh);
        if (sel at.some) { monitor = at; }
    }
    if (!sel monitor.some) { ret 0.0; }
    val mode: opt[*Vidmode] = glfw.get_video_mode(monitor.some);
    if (!sel mode.some)             { ret 0.0; }
    if (mode.some.refreshRate <= 0) { ret 0.0; }
    ret mode.some.refreshRate::f32;
}

fun prefer_retained_monitor(wayland: bool, mode: WindowMode) bool {
    ret wayland || !sel mode.windowed;
}

fun monitor_connected(monitor: glfw.Monitor) bool {
    var count:   i32  = 0;
    val handles: *ptr = glfw.get_monitors(?count);
    var i:       i32  = 0;
    for (handles != nil && i < count) {
        if (handles[i] == monitor.handle) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun overlap_area(ax: i32, ay: i32, aw: i32, ah: i32,
    bx: i32, by: i32, bw: i32, bh: i32) i64 {
    val left:   i32 = max_value(ax, bx);
    val top:    i32 = max_value(ay, by);
    val right:  i32 = min_value(ax + aw, bx + bw);
    val bottom: i32 = min_value(ay + ah, by + bh);
    if (right <= left || bottom <= top) { ret 0; }
    ret (right - left)::i64 * (bottom - top)::i64;
}

fun clamp_value(value: i32, minimum: i32, maximum: i32) i32 {
    if (value < minimum) { ret minimum; }
    if (value > maximum) { ret maximum; }
    ret value;
}

fun min_value(a: i32, b: i32) i32 {
    if (a < b) { ret a; }
    ret b;
}

fun max_value(a: i32, b: i32) i32 {
    if (a > b) { ret a; }
    ret b;
}

test deliver_key__press_edge_and_repeat_queued {
    var q:     EventQueue = queue_new();
    var input: inp.Input  = inp.input_new();
    var sink:  Sink       = Sink{queue: ?q, input: ?input, cursor_x: 0.0, cursor_y: 0.0, cursor_known: false};

    deliver_key(?sink, glfw.KEY_ESCAPE, glfw.PRESS, 0);
    inp.input_begin_tick(?input);
    if (!inp.key_pressed(?input, inp.KEY_ESCAPE)) { ret 1; }
    if (!inp.key_down(?input, inp.KEY_ESCAPE))    { ret 2; }

    val e: opt[Event] = queue_pop(?q);
    if (!sel e.some)                      { ret 3; }
    if (!sel e.some.key)                  { ret 4; }
    if (e.some.key.key != inp.KEY_ESCAPE) { ret 5; }
    if (!sel e.some.key.action.press)     { ret 6; }

    # autorepeat is queued but is no new input edge
    deliver_key(?sink, glfw.KEY_A, glfw.REPEAT, 0);
    inp.input_begin_tick(?input);
    if (inp.key_pressed(?input, inp.KEY_A)) { ret 7; }
    val r: opt[Event] = queue_pop(?q);
    if (!sel r.some)                   { ret 8; }
    if (!sel r.some.key)               { ret 9; }
    if (!sel r.some.key.action.repeat) { ret 10; }

    # the platform's modifier bits become boom's, the lock keys dropped
    deliver_key(?sink, glfw.KEY_HOME, glfw.PRESS, glfw.MOD_CONTROL | glfw.MOD_SUPER | glfw.MOD_NUM_LOCK);
    val h: opt[Event] = queue_pop(?q);
    if (!sel h.some)                                       { ret 11; }
    if (!sel h.some.key)                                   { ret 11; }
    if (h.some.key.key != inp.KEY_HOME)                    { ret 12; }
    if (h.some.key.mods != (inp.MOD_CTRL | inp.MOD_SUPER)) { ret 13; }
    ret 0;
}

# whether the next queued event is text carrying this codepoint
#[testing]
fun popped_text(q: *EventQueue, codepoint: u32) bool {
    val t: opt[Event] = queue_pop(q);
    if (!sel t.some)      { ret false; }
    if (!sel t.some.text) { ret false; }
    ret t.some.text.codepoint == codepoint;
}

test deliver_text__ordered_with_keys {
    var q:     EventQueue = queue_new();
    var input: inp.Input  = inp.input_new();
    var sink:  Sink       = Sink{queue: ?q, input: ?input, cursor_x: 0.0, cursor_y: 0.0, cursor_known: false};

    deliver_key(?sink, glfw.KEY_A, glfw.PRESS, 0);
    deliver_text(?sink, 0x61);
    deliver_text(?sink, 0xe9);
    deliver_text(?sink, 0x20ac);
    deliver_text(?sink, 0x1f600);
    deliver_key(?sink, glfw.KEY_A, glfw.RELEASE, 0);

    val k: opt[Event] = queue_pop(?q);
    if (!sel k.some)     { ret 1; }
    if (!sel k.some.key) { ret 1; }

    if (!popped_text(?q, 0x61))    { ret 2; }
    if (!popped_text(?q, 0xe9))    { ret 3; }
    if (!popped_text(?q, 0x20ac))  { ret 6; }
    if (!popped_text(?q, 0x1f600)) { ret 7; }
    val r: opt[Event] = queue_pop(?q);
    if (!sel r.some)                    { ret 4; }
    if (!sel r.some.key)                { ret 4; }
    if (!sel r.some.key.action.release) { ret 5; }
    deliver_text(nil, 0x61);
    ret 0;
}

test deliver_pointer__ordered_with_moves {
    var q:     EventQueue = queue_new();
    var input: inp.Input  = inp.input_new();
    var sink:  Sink       = Sink{queue: ?q, input: ?input, cursor_x: 0.0, cursor_y: 0.0, cursor_known: false};

    inp.input_begin_tick(?input);
    if (input.pointer_in) { ret 1; }

    deliver_pointer(?sink, true);
    deliver_cursor(?sink, 10.0, 20.0, 800, 600, 800, 600);
    inp.input_begin_tick(?input);
    if (!input.pointer_in) { ret 2; }

    deliver_pointer(?sink, false);
    inp.input_begin_tick(?input);
    # leaving keeps the last position inside
    if (input.pointer_in)                               { ret 3; }
    if (input.mouse_x != 10.0 || input.mouse_y != 20.0) { ret 4; }

    val a: opt[Event] = queue_pop(?q);
    if (!sel a.some)            { ret 5; }
    if (!sel a.some.pointer)    { ret 5; }
    if (!a.some.pointer.inside) { ret 6; }
    val m: opt[Event] = queue_pop(?q);
    if (!sel m.some)            { ret 7; }
    if (!sel m.some.mouse_move) { ret 7; }
    val b: opt[Event] = queue_pop(?q);
    if (!sel b.some)           { ret 8; }
    if (!sel b.some.pointer)   { ret 8; }
    if (b.some.pointer.inside) { ret 9; }
    val none: opt[Event] = queue_pop(?q);
    if (sel none.some) { ret 10; }
    deliver_pointer(nil, true);
    ret 0;
}

test deliver_drop__owned_until_release {
    var q:     EventQueue = queue_new();
    var input: inp.Input  = inp.input_new();
    var sink:  Sink       = Sink{queue: ?q, input: ?input, cursor_x: 0.0, cursor_y: 0.0, cursor_known: false};

    var one:  [1]*u8;
    var many: [3]*u8;
    one[0]  = "a.png"::*u8;
    many[0] = "b.txt"::*u8;
    many[1] = "dir/c d.obj"::*u8;
    many[2] = "e"::*u8;
    deliver_key(?sink, glfw.KEY_A, glfw.PRESS, 0);
    deliver_drop(?sink, 1, ?one[0]);
    deliver_drop(?sink, 3, ?many[0]);
    deliver_drop(?sink, 0, ?many[0]);
    deliver_drop(nil, 1, ?one[0]);

    val k: opt[Event] = queue_pop(?q);
    if (!sel k.some)     { ret 1; }
    if (!sel k.some.key) { ret 2; }

    # one event per drop, every path in order
    val d1: opt[Event] = queue_pop(?q);
    if (!sel d1.some)                                { ret 3; }
    if (!sel d1.some.drop)                           { ret 4; }
    if (d1.some.drop.count != 1)                     { ret 5; }
    if (!str_equals(d1.some.drop.paths[0], "a.png")) { ret 6; }

    val d2: opt[Event] = queue_pop(?q);
    if (!sel d2.some)                                      { ret 7; }
    if (!sel d2.some.drop)                                 { ret 8; }
    if (d2.some.drop.count != 3)                           { ret 9; }
    if (!str_equals(d2.some.drop.paths[0], "b.txt"))       { ret 10; }
    if (!str_equals(d2.some.drop.paths[1], "dir/c d.obj")) { ret 11; }
    if (!str_equals(d2.some.drop.paths[2], "e"))           { ret 12; }
    if (!queue_is_empty(?q))                               { ret 13; }

    # the source strings are gone after the callback: the copy is independent
    if (d1.some.drop.paths[0] == one[0]::str) { ret 14; }

    # popped paths stay valid until the next poll releases them
    if (!registered(1::ptr, ?q))                     { ret 22; }
    if (!str_equals(d1.some.drop.paths[0], "a.png")) { ret 15; }
    if (q.lent == nil)                               { ret 21; }
    poll_release();
    if (q.lent != nil) { ret 16; }

    # an unpopped drop survives a release and is freed by clear
    deliver_drop(?sink, 3, ?many[0]);
    poll_release();
    val d3: opt[Event] = queue_pop(?q);
    if (!sel d3.some)                            { ret 17; }
    if (!sel d3.some.drop)                       { ret 18; }
    if (!str_equals(d3.some.drop.paths[2], "e")) { ret 19; }
    deliver_drop(?sink, 1, ?one[0]);
    queue_clear(?q);
    if (q.lent != nil) { ret 20; }
    unregister_queue(1::ptr);
    ret 0;
}

test poll_release__every_window {
    var qa:    EventQueue = queue_new();
    var qb:    EventQueue = queue_new();
    var input: inp.Input  = inp.input_new();
    var sa:    Sink       = Sink{queue: ?qa, input: ?input, cursor_x: 0.0, cursor_y: 0.0, cursor_known: false};
    var sb:    Sink       = Sink{queue: ?qb, input: ?input, cursor_x: 0.0, cursor_y: 0.0, cursor_known: false};
    var one:   [1]*u8;
    one[0] = "a.png"::*u8;

    if (!registered(2::ptr, ?qa)) { ret 4; }
    if (!registered(3::ptr, ?qb)) { ret 5; }
    deliver_drop(?sa, 1, ?one[0]);
    deliver_drop(?sb, 1, ?one[0]);
    queue_pop(?qa);
    queue_pop(?qb);
    if (qa.lent == nil || qb.lent == nil) { ret 1; }

    poll_release();
    if (qa.lent != nil || qb.lent != nil) { ret 2; }

    # a closed window's queue is no longer released
    deliver_drop(?sa, 1, ?one[0]);
    queue_pop(?qa);
    unregister_queue(2::ptr);
    poll_release();
    if (qa.lent == nil) { ret 3; }
    unregister_queue(3::ptr);
    queue_clear(?qa);
    ret 0;
}

# whether a queue was registered for a handle
#[testing]
fun registered(handle: ptr, q: *EventQueue) bool {
    val r: err[allo.Error] = register_queue(handle, q);
    ret sel r.ok;
}

test register_queue__grows_past_sixteen {
    var qs: [40]EventQueue;
    var i:  usize = 0;
    for (i < 40) {
        qs[i] = queue_new();
        val added: err[allo.Error] = register_queue((i + 100)::ptr, ?qs[i]);
        if (!sel added.ok) { ret 1; }
        i = i + 1;
    }
    # re-registering a window replaces its entry rather than adding one
    val again: err[allo.Error] = register_queue(100::ptr, ?qs[0]);
    if (!sel again.ok)      { ret 2; }
    if (registry_len != 40) { ret 3; }

    var input: inp.Input = inp.input_new();
    var sink:  Sink      = Sink{queue: ?qs[39], input: ?input, cursor_x: 0.0, cursor_y: 0.0, cursor_known: false};
    var one:   [1]*u8;
    one[0] = "a.png"::*u8;
    deliver_drop(?sink, 1, ?one[0]);
    queue_pop(?qs[39]);
    if (qs[39].lent == nil) { ret 4; }
    poll_release();
    if (qs[39].lent != nil) { ret 5; }

    i = 0;
    for (i < 40) {
        unregister_queue((i + 100)::ptr);
        i = i + 1;
    }
    if (registry_len != 0) { ret 6; }
    ret 0;
}

test deliver_button__unnamed_button_dropped {
    var q:     EventQueue = queue_new();
    var input: inp.Input  = inp.input_new();
    var sink:  Sink       = Sink{queue: ?q, input: ?input, cursor_x: 0.0, cursor_y: 0.0, cursor_known: false};

    deliver_button(?sink, 7, glfw.PRESS, 0);
    val none: opt[Event] = queue_pop(?q);
    if (sel none.some) { ret 1; }

    deliver_button(?sink, glfw.MOUSE_BUTTON_RIGHT, glfw.PRESS, 0);
    val e: opt[Event] = queue_pop(?q);
    if (!sel e.some)                                    { ret 2; }
    if (!sel e.some.mouse_button)                       { ret 3; }
    if (e.some.mouse_button.button != inp.BUTTON_RIGHT) { ret 4; }
    if (!e.some.mouse_button.down)                      { ret 5; }

    deliver_button(?sink, glfw.MOUSE_BUTTON_5, glfw.PRESS, glfw.MOD_SHIFT);
    inp.input_begin_tick(?input);
    if (!inp.button_pressed(?input, inp.BUTTON_X2)) { ret 6; }
    val x: opt[Event] = queue_pop(?q);
    if (!sel x.some)                               { ret 7; }
    if (!sel x.some.mouse_button)                  { ret 7; }
    if (x.some.mouse_button.mods != inp.MOD_SHIFT) { ret 8; }
    ret 0;
}

test clamp_bounds__decoration_inside_work_area {
    val fitted: WindowBounds = clamp_bounds(
        WindowBounds{x: 0, y: 0, width: 1920, height: 1080},
        WindowBounds{x: 0, y: 0, width: 1920, height: 1080},
        WindowBounds{x: 0, y: 28, width: 0, height: 4},
        640, 360);
    if (fitted.x != 0 || fitted.y != 28)               { ret 1; }
    if (fitted.width != 1920 || fitted.height != 1048) { ret 2; }
    ret 0;
}

test overlap_area__visible_pixels {
    if (overlap_area(1800, 100, 400, 400, 0, 0, 1920, 1080) != 48000)     { ret 1; }
    if (overlap_area(1800, 100, 400, 400, 1920, 0, 1920, 1080) != 112000) { ret 2; }
    if (overlap_area(0, 0, 100, 100, 200, 200, 100, 100) != 0)            { ret 3; }
    ret 0;
}

test best_overlap__picks_the_monitor_showing_the_most {
    var areas: [2]WindowBounds;
    areas[0] = WindowBounds{x: 0, y: 0, width: 1920, height: 1080};
    areas[1] = WindowBounds{x: 1920, y: 0, width: 1920, height: 1080};
    if (best_overlap(100, 100, 400, 400, ?areas[0], 2) != 0)  { ret 1; }
    if (best_overlap(1800, 100, 400, 400, ?areas[0], 2) != 1) { ret 2; }
    if (best_overlap(2500, 100, 400, 400, ?areas[0], 2) != 1) { ret 3; }
    if (best_overlap(1820, 100, 200, 400, ?areas[0], 2) != 0) { ret 4; }
    if (best_overlap(0, 2000, 400, 400, ?areas[0], 2) != -1)  { ret 5; }
    if (best_overlap(100, 100, 400, 400, ?areas[0], 0) != -1) { ret 6; }
    ret 0;
}

test window_refresh_hz__closed_window_is_unknown {
    var w: Window;
    w.handle = opt[glfw.Window].none{};
    if (window_refresh_hz(?w) != 0.0) { ret 1; }
    ret 0;
}

test cursor_pixels__follows_framebuffer_scale {
    var x: f64 = 0.0;
    var y: f64 = 0.0;
    cursor_pixels(125.5, 44.25, 800, 600, 800, 600, ?x, ?y);
    if (x != 125.5 || y != 44.25) { ret 1; }

    cursor_pixels(125.5, 44.25, 800, 600, 1600, 1200, ?x, ?y);
    if (x != 251.0 || y != 88.5) { ret 2; }

    cursor_pixels(100.5, 50.0, 800, 600, 1200, 900, ?x, ?y);
    if (x != 150.75 || y != 75.0) { ret 3; }
    ret 0;
}

test window_span__framebuffer_pixels_to_window {
    var lo: i32 = 0;
    var hi: i32 = 0;
    window_span(10.0, 30.5, 800, 800, ?lo, ?hi);
    if (lo != 10 || hi != 31) { ret 1; }
    # at 2x a pixel rect halves, widened outward to whole coordinates
    window_span(101.0, 141.0, 800, 1600, ?lo, ?hi);
    if (lo != 50 || hi != 71) { ret 2; }
    window_span(-3.0, 3.0, 800, 1200, ?lo, ?hi);
    if (lo != -2 || hi != 2) { ret 3; }
    ret 0;
}

test deliver_compose__copied_into_the_queue {
    var q:     EventQueue = queue_new();
    var input: inp.Input  = inp.input_new();
    var sink:  Sink       = Sink{queue: ?q, input: ?input, cursor_x: 0.0, cursor_y: 0.0, cursor_known: false};
    var cps:   [2]u32     = [2]u32{0x304B, 0x3093};

    deliver_compose(?sink, 2, ?cps[0], 1);
    cps[0] = 0;
    deliver_compose(?sink, 0, nil, 0);
    deliver_compose(nil, 2, ?cps[0], 1);

    val c: opt[Event] = queue_pop(?q);
    if (!sel c.some)                                            { ret 1; }
    if (!sel c.some.compose)                                    { ret 1; }
    if (c.some.compose.count != 2 || c.some.compose.caret != 1) { ret 2; }
    if (c.some.compose.codepoints[0] != 0x304B)                 { ret 3; }
    val ended: opt[Event] = queue_pop(?q);
    if (!sel ended.some)               { ret 4; }
    if (!sel ended.some.compose)       { ret 4; }
    if (ended.some.compose.count != 0) { ret 5; }
    if (!queue_is_empty(?q))           { ret 6; }
    queue_clear(?q);
    ret 0;
}

test rebase_cursor__scale_change_is_not_motion {
    var q:     EventQueue = queue_new();
    var input: inp.Input  = inp.input_new();
    var sink:  Sink;
    sink.queue        = ?q;
    sink.input        = ?input;
    sink.cursor_known = false;

    rebase_cursor(?sink, 100.0, 50.0, 800, 600, 800, 600);
    rebase_cursor(?sink, 100.0, 50.0, 800, 600, 1600, 1200);
    inp.input_begin_tick(?input);
    if (input.mouse_x != 200.0 || input.mouse_y != 100.0) { ret 1; }
    if (input.mouse_dx != 0.0 || input.mouse_dy != 0.0)   { ret 2; }

    deliver_cursor(?sink, 101.0, 52.0, 800, 600, 1600, 1200);
    inp.input_begin_tick(?input);

    if (input.mouse_x != 202.0 || input.mouse_y != 104.0) { ret 3; }
    if (input.mouse_dx != 2.0 || input.mouse_dy != 4.0)   { ret 4; }
    val e: opt[Event] = queue_pop(?q);
    if (!sel e.some)                                                  { ret 5; }
    if (!sel e.some.mouse_move)                                       { ret 6; }
    if (e.some.mouse_move.x != 202.0 || e.some.mouse_move.y != 104.0) { ret 7; }
    ret 0;
}

test window__unopened_reads_closed {
    var w: Window;
    if (window_is_valid(?w))                  { ret 1; }
    if (window_set_cursor_captured(?w, true)) { ret 2; }
    if (window_cursor_captured(?w))           { ret 3; }
    if (!window_should_close(?w))             { ret 4; }
    val changed: err[WindowError] = window_set_mode(?w, WindowMode.fullscreen{});
    if (!sel changed.err)        { ret 5; }
    if (!sel changed.err.closed) { ret 6; }
    val h: opt[glfw.Window] = window_handle(?w);
    if (sel h.some) { ret 7; }
    window_close(?w);
    ret 0;
}

test mode_refusal__names_mode_and_missing_part {
    val no_mon: WindowError = mode_refusal(WindowMode.fullscreen{}, false);
    val no_vid: WindowError = mode_refusal(WindowMode.borderless{}, true);
    if (!sel no_mon.no_monitor) { ret 1; }
    if (!sel no_vid.no_monitor) { ret 2; }
    val a: ModeRefusal = no_mon.no_monitor;
    val b: ModeRefusal = no_vid.no_monitor;
    if (!sel a.mode.fullscreen || !sel a.part.monitor)    { ret 3; }
    if (!sel b.mode.borderless || !sel b.part.video_mode) { ret 4; }
    # the message says both, so a log line is enough to act on
    if (!str_equals(window_error_message(no_mon), "fullscreen needs a monitor and none was found"))              { ret 5; }
    if (!str_equals(window_error_message(no_vid), "borderless needs a video mode and the monitor reports none")) { ret 6; }
    ret 0;
}

test window_close__refused_while_renderer_holds {
    # a zeroed window has no handle, so closing it destroys nothing
    var w: Window;
    w.renderers = 2;
    val held: err[WindowError] = window_close(?w);
    if (!sel held.err)        { ret 1; }
    if (!sel held.err.in_use) { ret 2; }
    if (held.err.in_use != 2) { ret 3; }
    w.renderers = 0;
    val freed: err[WindowError] = window_close(?w);
    if (!sel freed.ok) { ret 4; }
    ret 0;
}

test window_clipboard__closed_window_reads_empty {
    var a: allo.Allocator;
    page.make(?a);
    var w: Window;
    window_clipboard_set(?w, "ignored");
    val got: res[str, allo.Error] = window_clipboard_get(?a, ?w);
    if (!sel got.ok)             { ret 1; }
    if (!str_equals(got.ok, "")) { ret 2; }
    val freed: err[allo.Error] = text.str_free(?a, got.ok);
    if (!sel freed.ok) { ret 3; }
    ret 0;
}

# set by a check that has a display, so a window that will not open fails there
# instead of skipping
fun window_required() bool {
    var buf: [8]u8;
    val got: res[opt[usize], env.EnvError] = env.get("BOOM_REQUIRE_WINDOW", ?buf[0], 8);
    ret sel got.ok && sel got.ok.some;
}

test window_clipboard__round_trips_utf8 {
    val opened: res[Window, WindowError] = window_open(64, 64, "boom clipboard test");
    if (sel opened.err) {
        if (window_required()) { ret 1; }
        print.eprintln("skipped: no window can be opened here");
        ret 0;
    }
    var w: Window = opened.ok;
    var a: allo.Allocator;
    page.make(?a);

    val sent: str = "héllo ✓ 日本";
    window_clipboard_set(?w, sent);
    val got: res[str, allo.Error] = window_clipboard_get(?a, ?w);
    if (!sel got.ok) { ret 2; }
    if (!str_equals(got.ok, sent)) {
        # wayland and some clipboard managers refuse a write from an unfocused window
        if (window_required()) { ret 3; }
        print.eprintln("skipped: the platform did not take the clipboard write");
        ret 0;
    }
    val freed: err[allo.Error] = text.str_free(?a, got.ok);
    if (!sel freed.ok) { ret 4; }
    window_close(?w);
    ret 0;
}
