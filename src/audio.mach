# sound playback: a mixer that owns the device and plays overlapping voices
#
# mach-audio supplies the pieces -- WAV decode, buffers, streams, a mixer, a
# device -- and its `play` binary shows one sound played end to end by mixing
# on the main thread into a finished buffer. a game needs something else: many
# sounds starting and stopping at arbitrary times, mixed live. that is this.
#
# THE REAL-TIME CONTRACT. the device's render callback runs on the audio
# thread, and mach-audio is explicit that it must not allocate and must not
# lock. so the scratch buffer is allocated once at init, the voice table is
# fixed, and the handoff between the game thread and the audio thread is done
# with atomics rather than a mutex.
#
# THE HANDOFF. each voice's `state` is the only field both threads touch, and
# it is what makes the rest safe to touch without a lock:
#
#   FREE     the game thread owns this voice and may write its stream
#   PLAYING  the audio thread owns it and pulls from its stream
#   STOPPING the game thread has asked for it back
#
# a voice is claimed with a compare-and-swap from FREE, so two game-thread
# callers cannot claim the same slot. its stream is written while still FREE
# -- invisible to the audio thread -- and only then stored as PLAYING, which
# publishes those writes. the audio thread never reads a voice that is not
# PLAYING, so it never sees a half-written stream. that ordering is the whole
# safety argument and is why the store must come last.
#
# WHAT THIS DELIBERATELY DOES NOT DO YET. no positional audio, no per-voice
# pitch, no streaming from disk: every clip is decoded fully into memory. those
# are additive and none of them change the shapes here.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use allo:   std.allocator;
use page:   std.allocator.page;
use fs:     std.filesystem;
use vector: std.collections.vector;
use atomic: std.sync.atomic;
use thread: std.sync.thread;
use audio;
use vfs: boom.vfs;

# how many sounds may play at once
#
# a fixed table because the render callback cannot allocate. overflow drops
# the newest request rather than stealing a playing voice: a dropped sound is
# a sound nobody hears, while a stolen one is an audible glitch in something
# already playing.
pub val MAX_VOICES: usize = 32;

# the game thread owns this slot and may write it
val FREE: i64 = 0;
# the audio thread owns this slot and is pulling from it
val PLAYING: i64 = 1;
# the game thread has asked for the slot back; the audio thread will free it
val STOPPING: i64 = 2;

# a decoded clip, ready to play any number of times
#
# owns its samples. several voices may stream the same Sound at once, since a
# Stream carries its own cursor and never mutates the buffer.
pub rec Sound {
    buffer: audio.Buffer;
    valid:  bool;
}

# one playback slot
# ---
# stream: cursor over a Sound's samples, written only while FREE
# state:  FREE / PLAYING / STOPPING, the atomic that orders everything else
# gain:   per-voice volume, written only while FREE
rec Voice {
    stream: audio.Stream;
    state:  i64;
    gain:   f32;
}

# a handle to a playing voice
#
# carries the generation the slot held when it started, so stopping a voice
# that already finished cannot silence whatever took its place. the same
# reasoning as the asset store's handles, and the same bug avoided.
pub rec VoiceId {
    slot: usize;
    gen:  i64;
}

# the mixer and its device
# ---
# a:       allocator owning the scratch buffer and decoded clips
# device:  the open output device, nil until audio_init succeeds
# voices:  the fixed voice table
# gens:    per-slot generation, bumped every time a voice is claimed
# scratch: per-voice pull target, allocated once so render never does
# master:  overall volume applied to every voice
# frames:  scratch capacity in frames
# chans:   device channel count
pub rec Audio {
    a:       *allo.Allocator;
    device:  audio.Device;
    voices:  [32]Voice;
    gens:    [32]i64;
    scratch: *f32;
    master:  f32;
    frames:  usize;
    chans:   usize;
    ready:   bool;
}

# the voice id that names nothing
pub fun voice_none() VoiceId {
    ret VoiceId{slot: 0, gen: 0};
}

# ------------------------------------------------------------ audio thread

# mix every playing voice into the device's output buffer
#
# real-time: no allocation, no locks, no syscalls. the only shared reads are
# the atomic states, and a voice is touched only while it reads PLAYING.
fun render(out: *f32, frames: u32, channels: u32, user: ptr) {
    val s: *Audio = user:~*Audio;

    # silence first: the device buffer is not guaranteed zeroed, and a voice
    # that ends mid-callback would otherwise leave stale samples audible
    var i: usize = 0;
    val total: usize = frames::usize * channels::usize;
    for (i < total) { out[i] = 0.0; i = i + 1; }

    var v: usize = 0;
    for (v < MAX_VOICES) {
        val st: i64 = atomic.load(?s.voices[v].state);

        if (st == STOPPING) {
            # the game thread asked for it back. release it here rather than
            # there, so the audio thread is the only writer of a PLAYING slot
            # and the game thread never races a pull in progress.
            atomic.store(?s.voices[v].state, FREE);
        }
        or (st == PLAYING) {
            var k: usize = 0;
            for (k < total) { s.scratch[k] = 0.0; k = k + 1; }
            audio.pull(?s.voices[v].stream, s.scratch, frames, channels);
            audio.mix_add(out, s.scratch, total, s.voices[v].gain * s.master);

            if (audio.done(s.voices[v].stream)) {
                atomic.store(?s.voices[v].state, FREE);
            }
        }
        v = v + 1;
    }

    # one clamp over the sum rather than per voice: clamping each source
    # would distort every voice individually instead of only the overflow
    audio.clamp_samples(out, total);
}

# ------------------------------------------------------------- game thread

# open the output device and start mixing
#
# ---
# a:        allocator for the scratch buffer and decoded clips
# rate:     requested sample rate
# channels: requested channel count
pub fun audio_init(s: *Audio, a: *allo.Allocator, rate: u32, channels: u16) Result[bool, str] {
    s.a      = a;
    s.master = 1.0;
    s.ready  = false;
    s.chans  = channels::usize;

    var v: usize = 0;
    for (v < MAX_VOICES) {
        s.voices[v].state = FREE;
        s.voices[v].gain  = 1.0;
        s.gens[v]         = 1;
        v = v + 1;
    }

    # a generous scratch: the device asks for a frame count per callback and
    # we must never allocate to serve a larger one
    s.frames = 4096;
    val sr: Result[*f32, str] = allo.allocate[f32](a, s.frames * s.chans);
    if (is_err[*f32, str](sr)) { ret err[bool, str](unwrap_err[*f32, str](sr)); }
    s.scratch = unwrap_ok[*f32, str](sr);

    var fmt: audio.Format;
    fmt.sample_rate = rate;
    fmt.channels    = channels;

    val dr: Result[audio.Device, str] = audio.open(fmt, render, s::ptr);
    if (is_err[audio.Device, str](dr)) {
        allo.deallocate[f32](a, s.scratch, s.frames * s.chans);
        ret err[bool, str](unwrap_err[audio.Device, str](dr));
    }
    s.device = unwrap_ok[audio.Device, str](dr);

    val st: Result[bool, str] = audio.start(?s.device);
    if (is_err[bool, str](st)) {
        audio.close(?s.device);
        allo.deallocate[f32](a, s.scratch, s.frames * s.chans);
        ret err[bool, str](unwrap_err[bool, str](st));
    }

    s.ready = true;
    ret ok[bool, str](true);
}

# stop the device and release the mixer's own memory
#
# decoded Sounds are not freed here: a game may hold them past the device, and
# sound_free is where that decision belongs.
pub fun audio_dnit(s: *Audio) {
    if (!s.ready) { ret; }
    audio.stop(?s.device);
    audio.close(?s.device);
    allo.deallocate[f32](s.a, s.scratch, s.frames * s.chans);
    s.ready = false;
}

# decode a clip from a virtual path
#
# the whole file is decoded into memory, so this is for sound effects and
# short music. `res://sfx/hit.wav` resolves through boom.vfs like every other
# asset path.
pub fun sound_load(s: *Audio, vpath: str) Result[Sound, str] {
    val pr: Result[str, str] = vfs.vfs_resolve(s.a, vpath);
    if (is_err[str, str](pr)) { ret err[Sound, str](unwrap_err[str, str](pr)); }
    val real: str = unwrap_ok[str, str](pr);

    val br: Result[vector.Vector[u8], str] = fs.read_bytes(s.a, real);
    if (is_err[vector.Vector[u8], str](br)) {
        ret err[Sound, str](unwrap_err[vector.Vector[u8], str](br));
    }
    var bytes: vector.Vector[u8] = unwrap_ok[vector.Vector[u8], str](br);

    val dr: Result[audio.Buffer, str] = audio.decode(s.a, bytes.data, bytes.len);
    vector.dnit[u8](?bytes);
    if (is_err[audio.Buffer, str](dr)) {
        ret err[Sound, str](unwrap_err[audio.Buffer, str](dr));
    }

    var snd: Sound;
    snd.buffer = unwrap_ok[audio.Buffer, str](dr);
    snd.valid  = true;
    ret ok[Sound, str](snd);
}

# release a decoded clip
#
# stop anything playing it first: a voice streaming a freed buffer reads
# released memory on the audio thread, which is the worst place to find out.
pub fun sound_free(snd: *Sound) {
    if (!snd.valid) { ret; }
    audio.dnit(?snd.buffer);
    snd.valid = false;
}

# claim a free voice, or MAX_VOICES when all are busy
#
# the compare-and-swap is what makes this safe against another game-thread
# caller claiming the same slot; the audio thread never sets a slot to
# anything but FREE, so it cannot interfere.
fun claim(s: *Audio) usize {
    var v: usize = 0;
    for (v < MAX_VOICES) {
        var expected: i64 = FREE;
        if (atomic.cas(?s.voices[v].state, ?expected, STOPPING)) { ret v; }
        v = v + 1;
    }
    ret MAX_VOICES;
}

# start a clip, returning the voice playing it
#
# `looping` restarts the clip at its end rather than freeing the voice, so a
# looping voice occupies its slot until stopped.
pub fun audio_play(s: *Audio, snd: *Sound, gain: f32, looping: bool) VoiceId {
    if (!s.ready || !snd.valid) { ret voice_none(); }

    val v: usize = claim(s);
    if (v == MAX_VOICES) { ret voice_none(); }

    # the slot is ours and invisible to the audio thread: it reads only
    # PLAYING, and this is STOPPING until the store below
    s.voices[v].stream = audio.stream_over(?snd.buffer, looping);
    s.voices[v].gain   = gain;
    s.gens[v]          = s.gens[v] + 1;
    val g: i64 = s.gens[v];

    # publishes every write above, and must therefore come last
    atomic.store(?s.voices[v].state, PLAYING);
    ret VoiceId{slot: v + 1, gen: g};
}

# stop a voice, if it is still the one that started
#
# a stale id -- one whose voice already finished and whose slot was reused --
# is ignored rather than silencing the new occupant.
pub fun audio_stop(s: *Audio, id: VoiceId) bool {
    if (id.slot == 0 || id.slot > MAX_VOICES) { ret false; }
    val v: usize = id.slot - 1;
    if (s.gens[v] != id.gen) { ret false; }

    var expected: i64 = PLAYING;
    ret atomic.cas(?s.voices[v].state, ?expected, STOPPING);
}

# whether a voice is still playing
pub fun audio_playing(s: *Audio, id: VoiceId) bool {
    if (id.slot == 0 || id.slot > MAX_VOICES) { ret false; }
    val v: usize = id.slot - 1;
    if (s.gens[v] != id.gen) { ret false; }
    ret atomic.load(?s.voices[v].state) == PLAYING;
}

# set the volume applied to every voice
pub fun audio_set_master(s: *Audio, gain: f32) {
    s.master = gain;
}

# how many voices are currently playing
pub fun audio_voice_count(s: *Audio) usize {
    var n: usize = 0;
    var v: usize = 0;
    for (v < MAX_VOICES) {
        if (atomic.load(?s.voices[v].state) == PLAYING) { n = n + 1; }
        v = v + 1;
    }
    ret n;
}

# --------------------------------------------------------------------- tests
#
# these drive the voice table and the render callback directly. opening a
# device needs hardware and is unreachable on a CI runner, so audio_init is
# not exercised here -- but the state machine it sets up is, which is where
# the concurrency bugs would be.

# a mixer with its table initialized but no device, for tests
fun test_audio(a: *allo.Allocator, chans: usize) Audio {
    var s: Audio;
    s.a      = a;
    s.master = 1.0;
    s.chans  = chans;
    s.frames = 64;
    s.ready  = true;
    var v: usize = 0;
    for (v < MAX_VOICES) {
        s.voices[v].state = FREE;
        s.voices[v].gain  = 1.0;
        s.gens[v]         = 1;
        v = v + 1;
    }
    s.scratch = unwrap_ok[*f32, str](allo.allocate[f32](a, s.frames * chans));
    ret s;
}

test "audio: a claimed voice is not handed out twice" {
    var a: allo.Allocator;
    page.make(?a);
    var s: Audio = test_audio(?a, 2);

    val v1: usize = claim(?s);
    val v2: usize = claim(?s);
    if (v1 == v2)          { ret 1; }
    if (v1 == MAX_VOICES)  { ret 1; }
    if (v2 == MAX_VOICES)  { ret 1; }
    ret 0;
}

test "audio: the table fills and then refuses rather than stealing" {
    var a: allo.Allocator;
    page.make(?a);
    var s: Audio = test_audio(?a, 2);

    var n: usize = 0;
    for (n < MAX_VOICES) {
        if (claim(?s) == MAX_VOICES) { ret 1; }
        n = n + 1;
    }
    # every slot taken: the next request is dropped, not granted by evicting
    # something already playing
    if (claim(?s) != MAX_VOICES) { ret 1; }
    ret 0;
}

test "audio: render releases a STOPPING voice and skips it" {
    var a: allo.Allocator;
    page.make(?a);
    var s: Audio = test_audio(?a, 2);

    val v: usize = claim(?s);
    # claim leaves the slot STOPPING: it is ours, not yet published
    if (atomic.load(?s.voices[v].state) != STOPPING) { ret 1; }

    var out: [128]f32;
    render(?out[0], 64, 2, (?s)::ptr);

    # the audio thread is the only writer of a PLAYING slot, so it is also
    # what returns a STOPPING one to FREE
    if (atomic.load(?s.voices[v].state) != FREE) { ret 1; }
    ret 0;
}

test "audio: render silences the output buffer before mixing" {
    var a: allo.Allocator;
    page.make(?a);
    var s: Audio = test_audio(?a, 2);

    var out: [128]f32;
    var i: usize = 0;
    # the device buffer is not guaranteed zeroed; leaving it would make a
    # frame with no voices play whatever was there last
    for (i < 128) { out[i] = 0.5; i = i + 1; }

    render(?out[0], 64, 2, (?s)::ptr);

    i = 0;
    for (i < 128) {
        if (out[i] != 0.0) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "audio: a stale voice id neither stops nor reports playing" {
    var a: allo.Allocator;
    page.make(?a);
    var s: Audio = test_audio(?a, 2);

    val v: usize = claim(?s);
    s.gens[v] = s.gens[v] + 1;
    val id: VoiceId = VoiceId{slot: v + 1, gen: s.gens[v]};
    atomic.store(?s.voices[v].state, PLAYING);

    if (!audio_playing(?s, id)) { ret 1; }

    # the voice ends and its slot is reused by something else
    atomic.store(?s.voices[v].state, FREE);
    s.gens[v] = s.gens[v] + 1;
    atomic.store(?s.voices[v].state, PLAYING);

    # the old id must not silence the new occupant
    if (audio_stop(?s, id))    { ret 1; }
    if (audio_playing(?s, id)) { ret 1; }
    ret 0;
}

test "audio: the null voice id is inert" {
    var a: allo.Allocator;
    page.make(?a);
    var s: Audio = test_audio(?a, 2);
    if (audio_playing(?s, voice_none())) { ret 1; }
    if (audio_stop(?s, voice_none()))    { ret 1; }
    ret 0;
}

test "audio: voice_count reflects only published voices" {
    var a: allo.Allocator;
    page.make(?a);
    var s: Audio = test_audio(?a, 2);

    val v: usize = claim(?s);
    # claimed but not yet published: the audio thread must not see it, so
    # neither should the count
    if (audio_voice_count(?s) != 0) { ret 1; }

    atomic.store(?s.voices[v].state, PLAYING);
    if (audio_voice_count(?s) != 1) { ret 1; }
    ret 0;
}

# shared state for the concurrent claim test
var race_audio: *Audio = nil;
var race_hits:  [32]i64;
var race_total: i64 = 0;
var race_overlap: i64 = 0;
val RACE_ROUNDS: usize = 20000;

# claim until the table is exhausted, tallying which slot each claim returned
fun race_claimer(arg: *u8) {
    # every slot but the last is pre-filled, so all threads contend for the
    # SAME slot. that is the narrowest window the claim has, and a wider scan
    # would let threads drift onto different slots and never race at all.
    var n: usize = 0;
    for (n < RACE_ROUNDS) {
        val v: usize = claim(race_audio);
        if (v != MAX_VOICES) {
            # count concurrent holders of this slot. exactly one may be
            # inside this region at a time; two means the claim was not atomic.
            if (atomic.fetch_add(?race_total, 1) != 0) {
                atomic.store(?race_overlap, 1);
            }
            atomic.fetch_sub(?race_total, 1);
            atomic.store(?race_audio.voices[v].state, FREE);
        }
        n = n + 1;
    }
}

test "audio: concurrent claims never hand the same voice to two callers" {
    var a: allo.Allocator;
    page.make(?a);
    var s: Audio = test_audio(?a, 2);

    var i: usize = 0;
    for (i < MAX_VOICES) { race_hits[i] = 0; i = i + 1; }
    # fill every slot but the last, so contention lands on one address
    i = 0;
    for (i < MAX_VOICES - 1) { s.voices[i].state = PLAYING; i = i + 1; }
    race_audio = ?s;
    atomic.store(?race_total, 0);

    # four threads contending for 32 slots. with a plain load-then-store two
    # threads can observe FREE on the same slot and both take it, which is
    # exactly what the compare-and-swap exists to prevent. a single-threaded
    # test cannot tell the two implementations apart, so this one races them.
    var t1: thread.Thread;
    var t2: thread.Thread;
    var t3: thread.Thread;
    var t4: thread.Thread;
    thread.spawn_with(race_claimer, nil, ?t1);
    thread.spawn_with(race_claimer, nil, ?t2);
    thread.spawn_with(race_claimer, nil, ?t3);
    thread.spawn_with(race_claimer, nil, ?t4);
    thread.join(?t1);
    thread.join(?t2);
    thread.join(?t3);
    thread.join(?t4);

    # every successful claim of the contended slot must have been exclusive.
    # claim sets STOPPING and the claimer resets to FREE, so a correct run
    # sees the slot handed out exactly as many times as it was returned. a
    # non-atomic claim lets two threads leave with the same slot, and the
    # tally of concurrent holders exceeds one.
    if (atomic.load(?race_overlap) != 0) { ret 1; }
    ret 0;
}
