# A ray: an origin and a direction, for asking what is where.
#
# WHY THIS IS A TYPE AND NOT A PAIR OF VECTORS. A ray is produced in one place
# and consumed in another: a camera turns a pointer position into one, and
# picking, aiming and line-of-sight consume it. Passing an origin and a
# direction as two arguments across that gap invites them to be swapped, which
# type-checks and produces a plausible wrong answer rather than an error.
#
# The direction is expected to be normalized. Nothing enforces it, because a
# ray built from a camera always is and re-normalizing on every use would cost
# a square root to defend against a caller error that a test would catch.
# Distances returned by intersection are therefore in world units.

use boom.math.vec.Vec3;
use boom.math.vec.vec3;
use boom.math.vec.vec3_add;
use boom.math.vec.vec3_scale;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

# An origin and a direction.
# ---
# origin:    where the ray starts
# direction: which way it points, expected to be unit length
pub rec Ray {
    origin:    Vec3;
    direction: Vec3;
}

# Build a ray.
pub fun ray(origin: Vec3, direction: Vec3) Ray {
    ret Ray{origin: origin, direction: direction};
}

# The point a given distance along the ray.
pub fun ray_at(r: *Ray, t: f32) Vec3 {
    ret vec3_add(r.origin, vec3_scale(r.direction, t));
}

# Where a ray crosses a horizontal plane, if it does.
#
# THE CASE ALMOST EVERY GAME NEEDS. Clicking on the ground, placing a building,
# aiming at a floor: all of them are a camera ray against a plane at a constant
# height. Returning whether it hit rather than a sentinel point means a click on
# the sky is distinguishable from a click at the origin, which a caller reading
# a zero vector cannot tell apart.
# ---
# r:     the ray
# y:     the plane's height
# out_p: set to the intersection when this returns true, untouched otherwise
# ret:   whether the ray crosses the plane ahead of its origin
pub fun ray_plane_y(r: *Ray, y: f32, out_p: *Vec3) bool {
    # Parallel to the plane, or close enough that the intersection would be
    # arbitrarily far away and dominated by rounding.
    var d: f32 = r.direction[1];
    if (d < 0.0)      { d = 0.0 - d; }
    if (d < 0.000001) { ret false; }

    val t: f32 = (y - r.origin[1]) / r.direction[1];
    # Behind the camera. A ray aimed at the sky still meets the ground plane, at
    # a negative distance, and reporting that as a hit puts the cursor's target
    # behind the player.
    if (t < 0.0) { ret false; }

    @out_p = ray_at(r, t);
    ret true;
}

test ray_plane_y__hits_ahead_and_at_origin {
    # from 10 up, aimed 45 degrees down, the ground is reached after 10 across
    val k: f32 = 0.70710677;
    var r: Ray = ray(vec3(0.0, 10.0, 0.0), vec3(k, 0.0 - k, 0.0));
    var p: Vec3;
    if (!ray_plane_y(?r, 0.0, ?p)) { ret 1; }
    if (!near(p[1], 0.0))          { ret 2; }
    if (!near(p[0], 10.0))         { ret 3; }
    # an origin on the plane hits at zero, so a level camera can still pick
    r = ray(vec3(3.0, 0.0, 4.0), vec3(0.0, 0.0 - 1.0, 0.0));
    if (!ray_plane_y(?r, 0.0, ?p))            { ret 4; }
    if (!near(p[0], 3.0) || !near(p[2], 4.0)) { ret 5; }
    ret 0;
}

test ray_plane_y__misses_behind_and_parallel {
    # a plane behind the origin solves at a negative distance, which is no hit
    var r: Ray = ray(vec3(0.0, 10.0, 0.0), vec3(0.0, 1.0, 0.0));
    var p: Vec3;
    p[0] = 42.0;
    if (ray_plane_y(?r, 0.0, ?p)) { ret 1; }
    # the out parameter is left alone on a miss
    if (p[0] != 42.0) { ret 2; }
    r = ray(vec3(0.0, 5.0, 0.0), vec3(1.0, 0.0, 0.0));
    if (ray_plane_y(?r, 0.0, ?p)) { ret 3; }
    ret 0;
}

#[testing]
fun near(a: f32, b: f32) bool {
    var d: f32 = a - b;
    if (d < 0.0) { d = 0.0 - d; }
    ret d < 0.001;
}
