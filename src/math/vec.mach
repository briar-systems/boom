# shared vector types and operations

use boom.math.scalar.sqrtf;

# a 2D vector
pub def Vec2: f32x2;

# a 3D vector with its unused fourth lane kept at zero
pub def Vec3: f32x4;

# a 4D vector
pub def Vec4: f32x4;

# build a Vec2
# ---
# x:   first component
# y:   second component
# ret: the vector (x, y)
pub fun vec2(x: f32, y: f32) Vec2 {
    ret f32x2{x, y};
}

# build a Vec3
# ---
# x:   first component
# y:   second component
# z:   third component
# ret: the vector (x, y, z)
pub fun vec3(x: f32, y: f32, z: f32) Vec3 {
    ret f32x4{x, y, z, 0.0};
}

# build a Vec4
# ---
# x:   first component
# y:   second component
# z:   third component
# w:   fourth component
# ret: the vector (x, y, z, w)
pub fun vec4(x: f32, y: f32, z: f32, w: f32) Vec4 {
    ret f32x4{x, y, z, w};
}

# add two vectors component-wise
# ---
# a:   left vector
# b:   right vector
# ret: a + b
pub fun vec3_add(a: Vec3, b: Vec3) Vec3 {
    ret a + b;
}

# subtract two vectors component-wise
# ---
# a:   left vector
# b:   right vector
# ret: a - b
pub fun vec3_sub(a: Vec3, b: Vec3) Vec3 {
    ret a - b;
}

# scale a vector by a scalar
# ---
# a:   vector
# s:   scalar
# ret: a * s
pub fun vec3_scale(a: Vec3, s: f32) Vec3 {
    ret a * f32x4{s, s, s, 0.0};
}

# dot product of two vectors
# ---
# a:   left vector
# b:   right vector
# ret: a . b
pub fun vec3_dot(a: Vec3, b: Vec3) f32 {
    val p: f32x4 = a * b;
    ret p[0] + p[1] + p[2];
}

# cross product of two vectors
# ---
# a:   left vector
# b:   right vector
# ret: a x b
pub fun vec3_cross(a: Vec3, b: Vec3) Vec3 {
    ret f32x4{
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0],
        0.0,
    };
}

# euclidean length of a vector
# ---
# a:   vector
# ret: sqrt(a . a)
pub fun vec3_length(a: Vec3) f32 {
    ret sqrtf(vec3_dot(a, a));
}

# unit vector in the direction of a
#
# returns the zero vector when a has zero length, a defined convention
# for the degenerate case rather than a trap.
# ---
# a:   vector
# ret: a scaled to unit length, or the zero vector
pub fun vec3_normalize(a: Vec3) Vec3 {
    val len: f32 = vec3_length(a);
    if (len == 0.0) {
        ret vec3(0.0, 0.0, 0.0);
    }
    ret vec3_scale(a, 1.0 / len);
}

test "vec: dot and cross of the basis vectors" {
    val x: Vec3 = vec3(1.0, 0.0, 0.0);
    val y: Vec3 = vec3(0.0, 1.0, 0.0);
    if (vec3_dot(x, y) != 0.0) { ret 1; }
    val z: Vec3 = vec3_cross(x, y);
    if (z[0] != 0.0 || z[1] != 0.0 || z[2] != 1.0 || z[3] != 0.0) { ret 2; }
    ret 0;
}

test "vec: length and normalize" {
    val v: Vec3 = vec3(3.0, 4.0, 0.0);
    if (vec3_length(v) != 5.0) { ret 1; }
    val n: Vec3 = vec3_normalize(v);
    val d: f32 = vec3_length(n) - 1.0;
    if (d > 0.0001 || d < 0.0 - 0.0001) { ret 2; }
    ret 0;
}

test "vec: normalize of the zero vector stays zero" {
    val n: Vec3 = vec3_normalize(vec3(0.0, 0.0, 0.0));
    if (n[0] != 0.0 || n[1] != 0.0 || n[2] != 0.0 || n[3] != 0.0) { ret 1; }
    ret 0;
}

test "vec: add scale and subtract" {
    val a: Vec3 = vec3(1.0, 2.0, 3.0);
    val b: Vec3 = vec3_scale(a, 2.0);
    val c: Vec3 = vec3_sub(b, a);
    if (c[0] != 1.0 || c[1] != 2.0 || c[2] != 3.0 || c[3] != 0.0) { ret 1; }
    ret 0;
}

test "vec: native layouts match their lane widths" {
    if ($size_of(Vec2) != 8 || $align_of(Vec2) != 4)   { ret 1; }
    if ($size_of(Vec3) != 16 || $align_of(Vec3) != 16) { ret 2; }
    if ($size_of(Vec4) != 16 || $align_of(Vec4) != 16) { ret 3; }
    ret 0;
}
