# shared floating-point helpers
#
# the shared mach-math is deferred until the compiler grows SIMD vector
# types, so boom.graphics carries its own small scalar math. these are
# plain f64 approximations (Newton's method for the root, range-reduced
# Taylor series for the trig functions) accurate to about 1e-5 over their
# reduced domains, which is ample for building view, projection, and
# model transforms. this module is engine-internal and will be replaced
# by mach-math; it is not a workaround, just the minimum arithmetic the
# renderer needs today.

use std.types.bool.bool;

# the ratio of a circle's circumference to its diameter
pub val PI: f64 = 3.14159265358979323846;

# half of PI
pub val HALF_PI: f64 = 1.57079632679489661923;

# twice PI, one full turn in radians
pub val TWO_PI: f64 = 6.28318530717958647692;

# convert degrees to radians
# ---
# deg: angle in degrees
# ret: the same angle in radians
pub fun radians(deg: f32) f32 {
    ret (deg::f64 * PI / 180.0)::f32;
}

# round to the nearest integral value, ties away from zero
# ---
# x:   value to round
# ret: nearest integral value as f64
fun round64(x: f64) f64 {
    if (x >= 0.0) {
        ret (x + 0.5)::i64::f64;
    }
    ret (x - 0.5)::i64::f64;
}

# square root by Newton's method
#
# returns 0 for non-positive input, which keeps vector length and
# normalization total for degenerate vectors rather than trapping.
# ---
# x:   radicand
# ret: the non-negative square root, or 0 if x <= 0
pub fun sqrt64(x: f64) f64 {
    if (x <= 0.0) {
        ret 0.0;
    }
    var guess: f64 = x;
    var i:     i64 = 0;
    for (i < 40) {
        guess = 0.5 * (guess + x / guess);
        i     = i + 1;
    }
    ret guess;
}

# sine, range-reduced Taylor series
# ---
# x:   angle in radians
# ret: sine of x
pub fun sin64(x: f64) f64 {
    var r: f64 = x - round64(x / TWO_PI) * TWO_PI;
    if (r > HALF_PI) {
        r = PI - r;
    }
    or (r < 0.0 - HALF_PI) {
        r = 0.0 - PI - r;
    }
    # Five terms rather than four. Reduction leaves r as large as pi/2, which is
    # where a truncated series is least accurate, and four terms were 3.5e-6 out
    # there. That is about thirty ulp in f32, so it was visible in the f32
    # wrappers everything else calls. The fifth term costs one multiply and
    # brings the worst case to 5.6e-8, below what f32 can represent.
    val x2: f64 = r * r;
    ret r * (1.0 - x2 / 6.0 * (1.0 - x2 / 20.0 * (1.0 - x2 / 42.0 * (1.0 - x2 / 72.0 * (1.0 - x2 / 110.0)))));
}

# cosine, range-reduced Taylor series
#
# ITS OWN SERIES, NOT A SHIFTED SINE. cos(x) = sin(x + pi/2) is exact in
# arithmetic and wrong in practice: shifting by pi/2 lands every small angle on
# the far end of sine's reduced range, which is precisely where the truncated
# series is least accurate. cos(0) came back as 1.0000035, greater than one,
# which is worse than imprecise. A rotation matrix built from it is not
# orthonormal, and feeding it to acos is outside the domain.
#
# Evaluating cosine's own series puts the common case, an angle near zero, at
# the point where the series is exact. cos(0) is now exactly 1.
# ---
# x:   angle in radians
# ret: cosine of x
pub fun cos64(x: f64) f64 {
    var r: f64 = x - round64(x / TWO_PI) * TWO_PI;
    # Cosine is even, so the sign of the reduced angle does not matter.
    if (r < 0.0) { r = 0.0 - r; }
    # Beyond a quarter turn, fold back and negate: cos(x) = -cos(pi - x).
    var sign: f64 = 1.0;
    if (r > HALF_PI) {
        r    = PI - r;
        sign = 0.0 - 1.0;
    }
    val x2: f64 = r * r;
    ret sign * (1.0 - x2 / 2.0 * (1.0 - x2 / 12.0 * (1.0 - x2 / 30.0 * (1.0 - x2 / 56.0 * (1.0 - x2 / 90.0)))));
}

# tangent, the ratio of sine to cosine
# ---
# x:   angle in radians
# ret: tangent of x
pub fun tan64(x: f64) f64 {
    ret sin64(x) / cos64(x);
}

# arccosine, a polynomial approximation over the clamped domain
#
# clamps the argument to [-1, 1] and evaluates the standard degree-3
# approximation on [0, 1], reflecting through pi for negative input.
# accurate to about 7e-5, ample for the slerp angle it serves. inputs
# outside [-1, 1] would otherwise arise only from rounding a dot product.
# ---
# x:   cosine value, clamped to [-1, 1]
# ret: the angle in radians, 0 to pi
pub fun acos64(x: f64) f64 {
    var c: f64 = x;
    if (c < 0.0 - 1.0) { c = 0.0 - 1.0; }
    if (c > 1.0)       { c = 1.0; }
    var a: f64 = c;
    if (a < 0.0) { a = 0.0 - a; }
    var p: f64 = 0.0 - 0.0187293;
    p = p * a + 0.0742610;
    p = p * a - 0.2121144;
    p = p * a + 1.5707288;
    val r: f64 = p * sqrt64(1.0 - a);
    if (c < 0.0) { ret PI - r; }
    ret r;
}

# f32 square root
# ---
# x:   radicand
# ret: the non-negative square root as f32
pub fun sqrtf(x: f32) f32 {
    ret sqrt64(x::f64)::f32;
}

# f32 sine
# ---
# x:   angle in radians
# ret: sine of x as f32
pub fun sinf(x: f32) f32 {
    ret sin64(x::f64)::f32;
}

# f32 cosine
# ---
# x:   angle in radians
# ret: cosine of x as f32
pub fun cosf(x: f32) f32 {
    ret cos64(x::f64)::f32;
}

# f32 tangent
# ---
# x:   angle in radians
# ret: tangent of x as f32
pub fun tanf(x: f32) f32 {
    ret tan64(x::f64)::f32;
}

# f32 arccosine
# ---
# x:   cosine value, clamped to [-1, 1]
# ret: the angle in radians as f32, 0 to pi
pub fun acosf(x: f32) f32 {
    ret acos64(x::f64)::f32;
}

# whether two f64 values differ by no more than eps
# ---
# a:   first value
# b:   second value
# eps: tolerance
# ret: true when |a - b| <= eps
#[testing]
fun close(a: f64, b: f64, eps: f64) bool {
    var d: f64 = a - b;
    if (d < 0.0) {
        d = 0.0 - d;
    }
    ret d <= eps;
}

test sqrt64__values_and_domain {
    if (!close(sqrt64(16.0), 4.0, 0.00001))       { ret 1; }
    if (!close(sqrt64(2.0), 1.41421356, 0.00001)) { ret 2; }
    if (sqrt64(0.0) != 0.0)                       { ret 3; }
    if (sqrt64(0.0 - 4.0) != 0.0)                 { ret 4; }
    ret 0;
}

test sin_cos__cardinal_angles {
    # cos(0) and sin(0) are exact: a cos(0) above one makes rotations
    # non-orthonormal and puts acos outside its domain
    if (cos64(0.0) != 1.0 || cosf(0.0) != 1.0) { ret 1; }
    if (sin64(0.0) != 0.0 || sinf(0.0) != 0.0) { ret 2; }
    if (!close(sin64(HALF_PI), 1.0, 0.00001))             { ret 3; }
    if (!close(sin64(PI), 0.0, 0.00001))                  { ret 4; }
    if (!close(sin64(0.0 - HALF_PI), 0.0 - 1.0, 0.00001)) { ret 5; }
    if (!close(cos64(HALF_PI), 0.0, 0.00001))             { ret 6; }
    if (!close(cos64(PI), 0.0 - 1.0, 0.00001))            { ret 7; }
    if (!close(sin64(TWO_PI + HALF_PI), 1.0, 0.00001))    { ret 8; }
    if (!close(sin64(0.0 - TWO_PI), 0.0, 0.00001))        { ret 9; }
    ret 0;
}

test sin_cos__bounded_and_consistent_across_range {
    # derived, not recorded: both stay in [-1, 1], sin^2 + cos^2 is one, and cos
    # leads sin by a quarter turn, which catches a drifting range reduction or a
    # series truncated too early
    var i: i32 = 0;
    for (i <= 400) {
        val x: f64 = (0.0 - 25.0) + i::f64 * 0.125;
        val s: f64 = sin64(x);
        val c: f64 = cos64(x);
        if (s > 1.0 || s < 0.0 - 1.0) { ret 1; }
        if (c > 1.0 || c < 0.0 - 1.0) { ret 2; }
        if (!close(s * s + c * c, 1.0, 0.000001)) { ret 3; }
        if (!close(c, sin64(x + HALF_PI), 0.00001)) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test acos64__cardinal_and_clamped {
    if (!close(acos64(1.0), 0.0, 0.0001))      { ret 1; }
    if (!close(acos64(0.0), HALF_PI, 0.0001))  { ret 2; }
    if (!close(acos64(0.0 - 1.0), PI, 0.0001)) { ret 3; }
    if (!close(acos64(0.5), PI / 3.0, 0.0005)) { ret 4; }
    if (!close(acos64(1.5), 0.0, 0.0001))      { ret 5; }
    if (!close(acos64(0.0 - 1.5), PI, 0.0001)) { ret 6; }
    ret 0;
}
