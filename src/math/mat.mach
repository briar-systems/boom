# scalar-interim 4x4 matrix type for the shared math layer
#
# Mat4 stores its 16 elements column-major, the layout OpenGL expects,
# so a Mat4 uploads to a uniform without transposing. element (row, col)
# lives at index col * 4 + row. engine-internal, to be replaced by
# mach-math; see boom.math.scalar.

use boom.math.scalar.tanf;
use boom.math.vec.Vec3;
use boom.math.vec.vec3_sub;
use boom.math.vec.vec3_dot;
use boom.math.vec.vec3_cross;
use boom.math.vec.vec3_normalize;
use boom.math.quat.Quat;

# a 4x4 matrix in column-major order
# ---
# m: the 16 elements, element (row, col) at index col * 4 + row
pub rec Mat4 {
    m: [16]f32;
}

# the identity matrix
# ---
# ret: a matrix with ones on the diagonal
pub fun mat4_identity() Mat4 {
    var r: Mat4;
    r.m[0]  = 1.0;
    r.m[5]  = 1.0;
    r.m[10] = 1.0;
    r.m[15] = 1.0;
    ret r;
}

# matrix product a * b
# ---
# a:   left matrix
# b:   right matrix
# ret: the product a * b
pub fun mat4_mul(a: *Mat4, b: *Mat4) Mat4 {
    var r: Mat4;
    var col: i64 = 0;
    for (col < 4) {
        var row: i64 = 0;
        for (row < 4) {
            var sum: f32 = 0.0;
            var k: i64 = 0;
            for (k < 4) {
                sum = sum + a.m[k * 4 + row] * b.m[col * 4 + k];
                k = k + 1;
            }
            r.m[col * 4 + row] = sum;
            row = row + 1;
        }
        col = col + 1;
    }
    ret r;
}

# a translation matrix
# ---
# v:   translation offset
# ret: a matrix translating by v
pub fun mat4_translation(v: Vec3) Mat4 {
    var r: Mat4 = mat4_identity();
    r.m[12] = v.x;
    r.m[13] = v.y;
    r.m[14] = v.z;
    ret r;
}

# a non-uniform scale matrix
# ---
# v:   per-axis scale factors
# ret: a matrix scaling by v
pub fun mat4_scale(v: Vec3) Mat4 {
    var r: Mat4;
    r.m[0]  = v.x;
    r.m[5]  = v.y;
    r.m[10] = v.z;
    r.m[15] = 1.0;
    ret r;
}

# the rotation matrix for a unit quaternion
# ---
# q:   unit quaternion
# ret: the equivalent rotation matrix
pub fun mat4_from_quat(q: Quat) Mat4 {
    val xx: f32 = q.x * q.x;
    val yy: f32 = q.y * q.y;
    val zz: f32 = q.z * q.z;
    val xy: f32 = q.x * q.y;
    val xz: f32 = q.x * q.z;
    val yz: f32 = q.y * q.z;
    val wx: f32 = q.w * q.x;
    val wy: f32 = q.w * q.y;
    val wz: f32 = q.w * q.z;

    var r: Mat4;
    r.m[0]  = 1.0 - 2.0 * (yy + zz);
    r.m[1]  = 2.0 * (xy + wz);
    r.m[2]  = 2.0 * (xz - wy);
    r.m[4]  = 2.0 * (xy - wz);
    r.m[5]  = 1.0 - 2.0 * (xx + zz);
    r.m[6]  = 2.0 * (yz + wx);
    r.m[8]  = 2.0 * (xz + wy);
    r.m[9]  = 2.0 * (yz - wx);
    r.m[10] = 1.0 - 2.0 * (xx + yy);
    r.m[15] = 1.0;
    ret r;
}

# a right-handed perspective projection
#
# maps a vertical field of view and aspect ratio to the OpenGL clip
# volume with depth in [-1, 1].
# ---
# fovy:   vertical field of view in radians
# aspect: viewport width divided by height
# near:   distance to the near clip plane, positive
# far:    distance to the far clip plane, positive and greater than near
# ret:    the projection matrix
pub fun mat4_perspective(fovy: f32, aspect: f32, near: f32, far: f32) Mat4 {
    val f: f32 = 1.0 / tanf(fovy * 0.5);
    var r: Mat4;
    r.m[0]  = f / aspect;
    r.m[5]  = f;
    r.m[10] = (far + near) / (near - far);
    r.m[11] = 0.0 - 1.0;
    r.m[14] = (2.0 * far * near) / (near - far);
    ret r;
}

# a right-handed orthographic projection
#
# maps an axis-aligned box to the OpenGL clip volume with depth in
# [-1, 1]. a 2D pass builds one over the framebuffer in pixel
# coordinates, e.g. left 0, right width, so screen positions map
# directly to pixels.
# ---
# left:   left clip plane
# right:  right clip plane
# bottom: bottom clip plane
# top:    top clip plane
# near:   near clip plane
# far:    far clip plane
# ret:    the projection matrix
pub fun mat4_orthographic(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32) Mat4 {
    var r: Mat4;
    r.m[0]  = 2.0 / (right - left);
    r.m[5]  = 2.0 / (top - bottom);
    r.m[10] = 0.0 - 2.0 / (far - near);
    r.m[12] = 0.0 - (right + left) / (right - left);
    r.m[13] = 0.0 - (top + bottom) / (top - bottom);
    r.m[14] = 0.0 - (far + near) / (far - near);
    r.m[15] = 1.0;
    ret r;
}

# a right-handed view matrix looking from eye toward center
# ---
# eye:    camera position
# center: point the camera looks at
# up:     approximate up direction, need not be orthogonal
# ret:    the view matrix
pub fun mat4_look_at(eye: Vec3, center: Vec3, up: Vec3) Mat4 {
    val f: Vec3 = vec3_normalize(vec3_sub(center, eye));
    val s: Vec3 = vec3_normalize(vec3_cross(f, up));
    val u: Vec3 = vec3_cross(s, f);

    var r: Mat4;
    r.m[0]  = s.x;
    r.m[1]  = u.x;
    r.m[2]  = 0.0 - f.x;
    r.m[4]  = s.y;
    r.m[5]  = u.y;
    r.m[6]  = 0.0 - f.y;
    r.m[8]  = s.z;
    r.m[9]  = u.z;
    r.m[10] = 0.0 - f.z;
    r.m[12] = 0.0 - vec3_dot(s, eye);
    r.m[13] = 0.0 - vec3_dot(u, eye);
    r.m[14] = vec3_dot(f, eye);
    r.m[15] = 1.0;
    ret r;
}

# a pointer to the matrix elements for upload to a uniform
# ---
# m:   matrix to expose
# ret: pointer to the first of the 16 column-major elements
pub fun mat4_ptr(m: *Mat4) *f32 {
    ret ?m.m[0];
}

# transform a point, applying the translation column
#
# the CPU twin of the mul_point written into each vertex stage. Mat4 is
# column-major, so the product is the columns scaled by the point's
# components and summed, and the shader computes it the same way over
# four f32x4 columns. keeping both here and tested is what pins the
# convention down: a transposed matrix produces a plausible-looking
# result that is wrong everywhere off the diagonal.
# ---
# m:   the matrix
# p:   the point
# ret: m * (p, 1)
pub fun mat4_transform_point(m: *Mat4, p: Vec3) Vec3 {
    var r: Vec3;
    r.x = m.m[0] * p.x + m.m[4] * p.y + m.m[8]  * p.z + m.m[12];
    r.y = m.m[1] * p.x + m.m[5] * p.y + m.m[9]  * p.z + m.m[13];
    r.z = m.m[2] * p.x + m.m[6] * p.y + m.m[10] * p.z + m.m[14];
    ret r;
}

# transform a direction, ignoring the translation column
#
# a direction has no position, so translating one is meaningless and
# breaks lighting on anything not at the origin. correct for a rotation
# and for a uniform scale up to renormalization; a non-uniform scale
# needs the inverse transpose supplied as its own matrix.
# ---
# m:   the matrix
# v:   the direction
# ret: the upper-left 3x3 of m applied to v
pub fun mat4_transform_dir(m: *Mat4, v: Vec3) Vec3 {
    var r: Vec3;
    r.x = m.m[0] * v.x + m.m[4] * v.y + m.m[8]  * v.z;
    r.y = m.m[1] * v.x + m.m[5] * v.y + m.m[9]  * v.z;
    r.z = m.m[2] * v.x + m.m[6] * v.y + m.m[10] * v.z;
    ret r;
}

test "mat: identity is the multiplicative unit" {
    var id: Mat4 = mat4_identity();
    var t: Mat4 = mat4_translation(Vec3{x: 1.0, y: 2.0, z: 3.0});
    var r: Mat4 = mat4_mul(?id, ?t);
    if (r.m[12] != 1.0 || r.m[13] != 2.0 || r.m[14] != 3.0) { ret 1; }
    ret 0;
}

test "mat: multiply composes translations" {
    var a: Mat4 = mat4_translation(Vec3{x: 1.0, y: 0.0, z: 0.0});
    var b: Mat4 = mat4_translation(Vec3{x: 0.0, y: 2.0, z: 0.0});
    var r: Mat4 = mat4_mul(?a, ?b);
    if (r.m[12] != 1.0 || r.m[13] != 2.0 || r.m[14] != 0.0) { ret 1; }
    ret 0;
}

test "mat: scale lands on the diagonal" {
    var s: Mat4 = mat4_scale(Vec3{x: 2.0, y: 3.0, z: 4.0});
    if (s.m[0] != 2.0 || s.m[5] != 3.0 || s.m[10] != 4.0 || s.m[15] != 1.0) { ret 1; }
    ret 0;
}

test "mat: perspective fills the expected entries" {
    var p: Mat4 = mat4_perspective(1.5707963, 1.0, 0.1, 100.0);
    if (p.m[11] != 0.0 - 1.0) { ret 1; }
    if (p.m[15] != 0.0) { ret 2; }
    if (p.m[5] <= 0.0) { ret 3; }
    ret 0;
}

test "mat: orthographic maps the box corners to the clip cube" {
    var p: Mat4 = mat4_orthographic(0.0, 800.0, 600.0, 0.0, 0.0 - 1.0, 1.0);
    val x: f32 = p.m[0] * 800.0 + p.m[12];
    val y: f32 = p.m[5] * 0.0 + p.m[13];
    if (x - 1.0 > 0.0001 || x - 1.0 < 0.0 - 0.0001) { ret 1; }
    if (y - 1.0 > 0.0001 || y - 1.0 < 0.0 - 0.0001) { ret 2; }
    if (p.m[15] != 1.0) { ret 3; }
    ret 0;
}

test "mat: look_at from the z axis faces the origin" {
    var v: Mat4 = mat4_look_at(Vec3{x: 0.0, y: 0.0, z: 5.0}, Vec3{x: 0.0, y: 0.0, z: 0.0}, Vec3{x: 0.0, y: 1.0, z: 0.0});
    if (v.m[15] != 1.0) { ret 1; }
    val d: f32 = v.m[14] - (0.0 - 5.0);
    if (d > 0.0001 || d < 0.0 - 0.0001) { ret 2; }
    ret 0;
}

test "mat: a point picks up the translation column" {
    var t: Mat4 = mat4_translation(Vec3{x: 1.0, y: 2.0, z: 3.0});
    val p: Vec3 = mat4_transform_point(?t, Vec3{x: 10.0, y: 20.0, z: 30.0});
    if (p.x != 11.0 || p.y != 22.0 || p.z != 33.0) { ret 1; }
    ret 0;
}

test "mat: a direction ignores the translation column" {
    var t: Mat4 = mat4_translation(Vec3{x: 1.0, y: 2.0, z: 3.0});
    val d: Vec3 = mat4_transform_dir(?t, Vec3{x: 10.0, y: 20.0, z: 30.0});
    # a normal that picks up a translation points somewhere else entirely
    # once the object moves, which is the bug this separation prevents.
    if (d.x != 10.0 || d.y != 20.0 || d.z != 30.0) { ret 1; }
    ret 0;
}

test "mat: transform agrees with composing the matrices" {
    # the check that catches a transposed convention. building T*S and
    # transforming once must equal scaling then translating, and it does
    # not if the elements are read row-major.
    var s: Mat4 = mat4_scale(Vec3{x: 2.0, y: 3.0, z: 4.0});
    var t: Mat4 = mat4_translation(Vec3{x: 5.0, y: 6.0, z: 7.0});
    var ts: Mat4 = mat4_mul(?t, ?s);

    val v: Vec3 = Vec3{x: 1.0, y: 1.0, z: 1.0};
    val once: Vec3 = mat4_transform_point(?ts, v);
    val twice: Vec3 = mat4_transform_point(?t, mat4_transform_point(?s, v));

    if (once.x != twice.x || once.y != twice.y || once.z != twice.z) { ret 1; }
    if (once.x != 7.0 || once.y != 9.0 || once.z != 11.0) { ret 2; }
    ret 0;
}

test "mat: a rotation moves a point off its axis" {
    # a transform that only ever reproduced its input would pass the
    # translation tests above by doing nothing, so this asserts an
    # actual rotation: 90 degrees about z sends +x to +y.
    val h: f32 = 0.70710678;
    var r: Mat4 = mat4_from_quat(Quat{x: 0.0, y: 0.0, z: h, w: h});
    val p: Vec3 = mat4_transform_point(?r, Vec3{x: 1.0, y: 0.0, z: 0.0});
    if (p.x > 0.001 || p.x < -0.001) { ret 1; }
    if (p.y < 0.999 || p.y > 1.001)  { ret 2; }
    ret 0;
}
