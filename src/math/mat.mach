# 4x4 matrix operations for the shared math layer

use boom.math.scalar.tanf;
use boom.math.vec.Vec3;
use boom.math.vec.vec3;
use boom.math.vec.vec3_sub;
use boom.math.vec.vec3_dot;
use boom.math.vec.vec3_cross;
use boom.math.vec.vec3_normalize;
use boom.math.quat.Quat;

# a 4x4 matrix stored as four SIMD columns in std140 order
# ---
# m: the columns, indexed as m[column][row]
pub rec Mat4 {
    m: [4]f32x4;
}

# the identity matrix
# ---
# ret: a matrix with ones on the diagonal
pub fun mat4_identity() Mat4 {
    var r: Mat4;
    r.m[0][0] = 1.0;
    r.m[1][1] = 1.0;
    r.m[2][2] = 1.0;
    r.m[3][3] = 1.0;
    ret r;
}

# matrix product a * b
# ---
# a:   left matrix
# b:   right matrix
# ret: the product a * b
pub fun mat4_mul(a: *Mat4, b: *Mat4) Mat4 {
    var r: Mat4;
    var col: i64 = 0;
    for (col < 4) {
        r.m[col] = a.m[0] * splat4(b.m[col][0])
                 + a.m[1] * splat4(b.m[col][1])
                 + a.m[2] * splat4(b.m[col][2])
                 + a.m[3] * splat4(b.m[col][3]);
        col = col + 1;
    }
    ret r;
}

# a translation matrix
# ---
# v:   translation offset
# ret: a matrix translating by v
pub fun mat4_translation(v: Vec3) Mat4 {
    var r: Mat4 = mat4_identity();
    r.m[3][0] = v[0];
    r.m[3][1] = v[1];
    r.m[3][2] = v[2];
    ret r;
}

# a non-uniform scale matrix
# ---
# v:   per-axis scale factors
# ret: a matrix scaling by v
pub fun mat4_scale(v: Vec3) Mat4 {
    var r: Mat4;
    r.m[0][0] = v[0];
    r.m[1][1] = v[1];
    r.m[2][2] = v[2];
    r.m[3][3] = 1.0;
    ret r;
}

# the rotation matrix for a unit quaternion
# ---
# q:   unit quaternion
# ret: the equivalent rotation matrix
pub fun mat4_from_quat(q: Quat) Mat4 {
    val xx: f32 = q[0] * q[0];
    val yy: f32 = q[1] * q[1];
    val zz: f32 = q[2] * q[2];
    val xy: f32 = q[0] * q[1];
    val xz: f32 = q[0] * q[2];
    val yz: f32 = q[1] * q[2];
    val wx: f32 = q[3] * q[0];
    val wy: f32 = q[3] * q[1];
    val wz: f32 = q[3] * q[2];

    var r: Mat4;
    r.m[0][0] = 1.0 - 2.0 * (yy + zz);
    r.m[0][1] = 2.0 * (xy + wz);
    r.m[0][2] = 2.0 * (xz - wy);
    r.m[1][0] = 2.0 * (xy - wz);
    r.m[1][1] = 1.0 - 2.0 * (xx + zz);
    r.m[1][2] = 2.0 * (yz + wx);
    r.m[2][0] = 2.0 * (xz + wy);
    r.m[2][1] = 2.0 * (yz - wx);
    r.m[2][2] = 1.0 - 2.0 * (xx + yy);
    r.m[3][3] = 1.0;
    ret r;
}

# a right-handed perspective projection onto the Vulkan clip volume
#
# maps a vertical field of view and aspect ratio to clip space with depth in
# [0, 1] and Y increasing downward, which is what Vulkan defines. This is not
# the OpenGL convention and the difference is not cosmetic: under GL's [-1, 1]
# depth the near half of the view volume maps to negative Z and is clipped
# away, and under GL's upward Y everything renders vertically mirrored.
#
# THE Y FLIP DOES NOT REVERSE WINDING, though it reads as though it should.
# Vulkan's framebuffer has Y increasing downward already, so negating Y here
# converts a Y-up view space into that convention rather than mirroring the
# triangle the rasterizer sees. boom.graphics.pipeline keeps counter-clockwise
# front faces, matching glTF. The opposite pairing was tried, on exactly the
# reasoning this paragraph replaces, and it culled part of every closed mesh.
# ---
# fovy:   vertical field of view in radians
# aspect: viewport width divided by height
# near:   distance to the near clip plane, positive
# far:    distance to the far clip plane, positive and greater than near
# ret:    the projection matrix
pub fun mat4_perspective(fovy: f32, aspect: f32, near: f32, far: f32) Mat4 {
    val f: f32 = 1.0 / tanf(fovy * 0.5);
    var r: Mat4;
    r.m[0][0] = f / aspect;
    r.m[1][1] = 0.0 - f;
    r.m[2][2] = far / (near - far);
    r.m[2][3] = 0.0 - 1.0;
    r.m[3][2] = (far * near) / (near - far);
    ret r;
}

# a right-handed infinite reversed-z perspective projection
pub fun mat4_perspective_reversed_infinite(fovy: f32, aspect: f32,
                                           near: f32) Mat4 {
    val f: f32 = 1.0 / tanf(fovy * 0.5);
    var r: Mat4;
    r.m[0][0] = f / aspect;
    r.m[1][1] = 0.0 - f;
    r.m[2][2] = 0.0;
    r.m[2][3] = 0.0 - 1.0;
    r.m[3][2] = near;
    ret r;
}

# a right-handed orthographic projection onto the Vulkan clip volume
#
# maps an axis-aligned box to clip space with depth in [0, 1] and Y increasing
# downward. a 2D pass builds one over the framebuffer in pixel coordinates as
# mat4_orthographic(0, width, height, 0, -1, 1), so a sprite at y = 0 is at the
# top of the window and screen positions map directly to pixels.
# ---
# left:   left clip plane
# right:  right clip plane
# bottom: bottom clip plane
# top:    top clip plane
# near:   near clip plane
# far:    far clip plane
# ret:    the projection matrix
pub fun mat4_orthographic(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32) Mat4 {
    var r: Mat4;
    r.m[0][0] = 2.0 / (right - left);
    # Negated against the OpenGL form, because Vulkan's Y increases downward.
    r.m[1][1] = 0.0 - 2.0 / (top - bottom);
    # Depth maps to [0, 1], not [-1, 1]. Under the OpenGL form everything from
    # the near plane to the midpoint lands at a negative Z and is clipped.
    r.m[2][2] = 0.0 - 1.0 / (far - near);
    r.m[3][0] = 0.0 - (right + left) / (right - left);
    r.m[3][1] = (top + bottom) / (top - bottom);
    r.m[3][2] = 0.0 - near / (far - near);
    r.m[3][3] = 1.0;
    ret r;
}

# a right-handed view matrix looking from eye toward center
# ---
# eye:    camera position
# center: point the camera looks at
# up:     approximate up direction, need not be orthogonal
# ret:    the view matrix
pub fun mat4_look_at(eye: Vec3, center: Vec3, up: Vec3) Mat4 {
    val f: Vec3 = vec3_normalize(vec3_sub(center, eye));
    val s: Vec3 = vec3_normalize(vec3_cross(f, up));
    val u: Vec3 = vec3_cross(s, f);

    var r: Mat4;
    r.m[0][0] = s[0];
    r.m[0][1] = u[0];
    r.m[0][2] = 0.0 - f[0];
    r.m[1][0] = s[1];
    r.m[1][1] = u[1];
    r.m[1][2] = 0.0 - f[1];
    r.m[2][0] = s[2];
    r.m[2][1] = u[2];
    r.m[2][2] = 0.0 - f[2];
    r.m[3][0] = 0.0 - vec3_dot(s, eye);
    r.m[3][1] = 0.0 - vec3_dot(u, eye);
    r.m[3][2] = vec3_dot(f, eye);
    r.m[3][3] = 1.0;
    ret r;
}

# a pointer to the matrix elements for upload to a uniform
# ---
# m:   matrix to expose
# ret: pointer to the first of the 16 column-major elements
pub fun mat4_ptr(m: *Mat4) *f32 {
    ret ?m.m[0][0];
}

# transform a point, applying the translation column
#
# the CPU twin of the mul_point written into each vertex stage. Mat4 is
# column-major, so the product is the columns scaled by the point's
# components and summed, and the shader computes it the same way over
# four f32x4 columns. keeping both here and tested is what pins the
# convention down: a transposed matrix produces a plausible-looking
# result that is wrong everywhere off the diagonal.
# ---
# AFFINE MATRICES ONLY. This returns m * (p, 1) without the perspective
# divide, which is correct for a model, view or normal matrix, whose fourth row
# leaves w at 1. Passing a projection, or a view-projection, silently returns
# unclipped coordinates that are wrong by a factor of w and look plausible near
# the view axis. Use mat4_project_point for those.
# ---
# m:   the matrix
# p:   the point
# ret: m * (p, 1)
pub fun mat4_transform_point(m: *Mat4, p: Vec3) Vec3 {
    val r: f32x4 = m.m[0] * splat4(p[0])
                   + m.m[1] * splat4(p[1])
                   + m.m[2] * splat4(p[2])
                   + m.m[3];
    ret vec3(r[0], r[1], r[2]);
}

# transform a point by a projection, dividing through by w
#
# WHY THIS IS SEPARATE FROM mat4_transform_point. A projection puts a value
# other than one in w, and the coordinates only mean anything after dividing by
# it. Doing that unconditionally in transform_point would cost a divide on every
# model-matrix transform to serve the rarer case, and skipping it on a
# projection gives an answer that is wrong by a factor that approaches one near
# the view axis, so it looks right exactly where it is checked first.
#
# A w of zero means the point is on the plane through the eye, where it has no
# projection at all. It is returned undivided rather than as an infinity, since
# an infinity propagates into whatever the caller computes next.
# ---
# m:   the matrix, typically a view-projection
# p:   the point
# ret: m * (p, 1), divided by w
pub fun mat4_project_point(m: *Mat4, p: Vec3) Vec3 {
    val r: f32x4 = m.m[0] * splat4(p[0])
                   + m.m[1] * splat4(p[1])
                   + m.m[2] * splat4(p[2])
                   + m.m[3];
    if (r[3] == 0.0) { ret vec3(r[0], r[1], r[2]); }
    ret vec3(r[0] / r[3], r[1] / r[3], r[2] / r[3]);
}

# transform a direction, ignoring the translation column
#
# a direction has no position, so translating one is meaningless and
# breaks lighting on anything not at the origin. correct for a rotation
# and for a uniform scale up to renormalization; a non-uniform scale
# needs the inverse transpose supplied as its own matrix.
# ---
# m:   the matrix
# v:   the direction
# ret: the upper-left 3x3 of m applied to v
pub fun mat4_transform_dir(m: *Mat4, v: Vec3) Vec3 {
    val r: f32x4 = m.m[0] * splat4(v[0])
                   + m.m[1] * splat4(v[1])
                   + m.m[2] * splat4(v[2]);
    ret vec3(r[0], r[1], r[2]);
}

fun splat4(v: f32) f32x4 {
    ret f32x4{v, v, v, v};
}

test "mat: columns preserve the std140 matrix layout" {
    if ($size_of(Mat4) != 64 || $align_of(Mat4) != 16) { ret 1; }
    var m: Mat4 = mat4_identity();
    val p: *f32 = mat4_ptr(?m);
    if (p[0] != 1.0 || p[5] != 1.0 || p[10] != 1.0 || p[15] != 1.0) { ret 2; }
    ret 0;
}

test "mat: identity is the multiplicative unit" {
    var id: Mat4 = mat4_identity();
    var t: Mat4 = mat4_translation(vec3(1.0, 2.0, 3.0));
    var r: Mat4 = mat4_mul(?id, ?t);
    if (r.m[3][0] != 1.0 || r.m[3][1] != 2.0 || r.m[3][2] != 3.0) { ret 1; }
    ret 0;
}

test "mat: multiply composes translations" {
    var a: Mat4 = mat4_translation(vec3(1.0, 0.0, 0.0));
    var b: Mat4 = mat4_translation(vec3(0.0, 2.0, 0.0));
    var r: Mat4 = mat4_mul(?a, ?b);
    if (r.m[3][0] != 1.0 || r.m[3][1] != 2.0 || r.m[3][2] != 0.0) { ret 1; }
    ret 0;
}

test "mat: scale lands on the diagonal" {
    var s: Mat4 = mat4_scale(vec3(2.0, 3.0, 4.0));
    if (s.m[0][0] != 2.0 || s.m[1][1] != 3.0 || s.m[2][2] != 4.0 || s.m[3][3] != 1.0) { ret 1; }
    ret 0;
}

test "mat: perspective maps the clip planes to the Vulkan depth range" {
    # Vulkan clip space is z in [0, 1], not OpenGL's [-1, 1]. Under the OpenGL
    # form everything from the near plane to the midpoint of the frustum lands
    # at a negative z and is clipped away, which looks like the near half of
    # every scene being invisible rather than like a wrong matrix.
    val near: f32 = 0.1;
    val far:  f32 = 100.0;
    var p: Mat4 = mat4_perspective(1.5707963, 1.0, near, far);
    if (p.m[2][3] != 0.0 - 1.0) { ret 1; }
    if (p.m[3][3] != 0.0)       { ret 2; }

    # A point on the near plane is at eye z = -near, and w is -z_eye.
    val zn: f32 = (p.m[2][2] * (0.0 - near) + p.m[3][2]) / near;
    if (zn > 0.0001 || zn < 0.0 - 0.0001) { ret 3; }

    # A point on the far plane maps to 1.
    val zf: f32 = (p.m[2][2] * (0.0 - far) + p.m[3][2]) / far;
    if (zf - 1.0 > 0.0001 || zf - 1.0 < 0.0 - 0.0001) { ret 4; }

    # Y is negated, because Vulkan's Y increases downward. Positive here would
    # render every scene vertically mirrored.
    if (p.m[1][1] >= 0.0) { ret 5; }
    ret 0;
}

test "mat: infinite reversed perspective maps near to one and distance to zero" {
    val near: f32 = 0.1;
    var p: Mat4 = mat4_perspective_reversed_infinite(1.5707963, 1.0, near);
    if (p.m[2][3] != 0.0 - 1.0) { ret 1; }
    if (p.m[3][3] != 0.0)       { ret 2; }

    val zn: f32 = (p.m[2][2] * (0.0 - near) + p.m[3][2]) / near;
    if (zn - 1.0 > 0.0001 || zn - 1.0 < 0.0 - 0.0001) { ret 3; }

    val distant: f32 = 1000000.0;
    val zd: f32 = (p.m[2][2] * (0.0 - distant) + p.m[3][2]) / distant;
    if (zd > 0.000001 || zd <= 0.0) { ret 4; }
    if (p.m[1][1] >= 0.0) { ret 5; }
    ret 0;
}

test "mat: orthographic maps a pixel box to the Vulkan clip cube" {
    # The projection a 2D pass builds: origin at the top left, y growing down
    # the window, depth in [-1, 1] eye space mapping to [0, 1] clip space.
    val w: f32 = 800.0;
    val h: f32 = 600.0;
    var p: Mat4 = mat4_orthographic(0.0, w, h, 0.0, 0.0 - 1.0, 1.0);
    if (p.m[3][3] != 1.0) { ret 1; }

    val x0: f32 = p.m[0][0] * 0.0 + p.m[3][0];
    val x1: f32 = p.m[0][0] * w   + p.m[3][0];
    if (x0 + 1.0 > 0.0001 || x0 + 1.0 < 0.0 - 0.0001) { ret 2; }
    if (x1 - 1.0 > 0.0001 || x1 - 1.0 < 0.0 - 0.0001) { ret 3; }

    # y = 0 is the TOP of the window, which is clip -1 in Vulkan. The OpenGL
    # form puts it at +1, so every sprite ends up mirrored about the midline
    # and a full-window blit still looks plausible.
    val y0: f32 = p.m[1][1] * 0.0 + p.m[3][1];
    val y1: f32 = p.m[1][1] * h   + p.m[3][1];
    if (y0 + 1.0 > 0.0001 || y0 + 1.0 < 0.0 - 0.0001) { ret 4; }
    if (y1 - 1.0 > 0.0001 || y1 - 1.0 < 0.0 - 0.0001) { ret 5; }

    # Depth: eye z = -near maps to 0 and eye z = -far maps to 1.
    val z0: f32 = p.m[2][2] * 1.0 + p.m[3][2];
    val z1: f32 = p.m[2][2] * (0.0 - 1.0) + p.m[3][2];
    if (z0 > 0.0001 || z0 < 0.0 - 0.0001)             { ret 6; }
    if (z1 - 1.0 > 0.0001 || z1 - 1.0 < 0.0 - 0.0001) { ret 7; }
    ret 0;
}

test "mat: look_at from the z axis faces the origin" {
    var v: Mat4 = mat4_look_at(vec3(0.0, 0.0, 5.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0));
    if (v.m[3][3] != 1.0) { ret 1; }
    val d: f32 = v.m[3][2] - (0.0 - 5.0);
    if (d > 0.0001 || d < 0.0 - 0.0001) { ret 2; }
    ret 0;
}

test "mat: a point picks up the translation column" {
    var t: Mat4 = mat4_translation(vec3(1.0, 2.0, 3.0));
    val p: Vec3 = mat4_transform_point(?t, vec3(10.0, 20.0, 30.0));
    if (p[0] != 11.0 || p[1] != 22.0 || p[2] != 33.0) { ret 1; }
    ret 0;
}

test "mat: a direction ignores the translation column" {
    var t: Mat4 = mat4_translation(vec3(1.0, 2.0, 3.0));
    val d: Vec3 = mat4_transform_dir(?t, vec3(10.0, 20.0, 30.0));
    # a normal that picks up a translation points somewhere else entirely
    # once the object moves, which is the bug this separation prevents.
    if (d[0] != 10.0 || d[1] != 20.0 || d[2] != 30.0) { ret 1; }
    ret 0;
}

test "mat: transform agrees with composing the matrices" {
    # the check that catches a transposed convention. building T*S and
    # transforming once must equal scaling then translating, and it does
    # not if the elements are read row-major.
    var s: Mat4 = mat4_scale(vec3(2.0, 3.0, 4.0));
    var t: Mat4 = mat4_translation(vec3(5.0, 6.0, 7.0));
    var ts: Mat4 = mat4_mul(?t, ?s);

    val v: Vec3 = vec3(1.0, 1.0, 1.0);
    val once: Vec3 = mat4_transform_point(?ts, v);
    val twice: Vec3 = mat4_transform_point(?t, mat4_transform_point(?s, v));

    if (once[0] != twice[0] || once[1] != twice[1] || once[2] != twice[2]) { ret 1; }
    if (once[0] != 7.0 || once[1] != 9.0 || once[2] != 11.0) { ret 2; }
    ret 0;
}

test "mat: a rotation moves a point off its axis" {
    # a transform that only ever reproduced its input would pass the
    # translation tests above by doing nothing, so this asserts an
    # actual rotation: 90 degrees about z sends +x to +y.
    val h: f32 = 0.70710678;
    var r: Mat4 = mat4_from_quat(f32x4{0.0, 0.0, h, h});
    val p: Vec3 = mat4_transform_point(?r, vec3(1.0, 0.0, 0.0));
    if (p[0] > 0.001 || p[0] < -0.001) { ret 1; }
    if (p[1] < 0.999 || p[1] > 1.001)  { ret 2; }
    ret 0;
}

test "mat: projecting a point divides through by w" {
    # A perspective matrix puts -z in w, so a point twice as far away lands at
    # half the offset. transform_point skips that divide and would report both
    # at the same place, which is the trap this function exists to remove.
    var p: Mat4 = mat4_perspective(1.0, 1.0, 0.1, 100.0);

    val near: Vec3 = mat4_project_point(?p, vec3(1.0, 0.0, 0.0 - 5.0));
    val far:  Vec3 = mat4_project_point(?p, vec3(1.0, 0.0, 0.0 - 10.0));

    # Twice the distance, half the screen offset.
    var d: f32 = near[0] - far[0] * 2.0;
    if (d < 0.0) { d = 0.0 - d; }
    if (d > 0.0001) { ret 1; }

    # And the undivided form does not foreshorten at all, which is what makes
    # the two genuinely different rather than a rename.
    val nu: Vec3 = mat4_transform_point(?p, vec3(1.0, 0.0, 0.0 - 5.0));
    val fu: Vec3 = mat4_transform_point(?p, vec3(1.0, 0.0, 0.0 - 10.0));
    if (nu[0] != fu[0]) { ret 2; }
    ret 0;
}
