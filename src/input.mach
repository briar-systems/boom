# Polled keyboard and mouse state, sampled at the fixed tick.
#
# The event queue answers "what happened, in what order", which is what UI and
# text entry need. This answers "is W held right now", which is what movement,
# aiming, and held fire need. Both are required and neither replaces the other,
# so this sits alongside boom.event rather than superseding it.
#
# Edges belong to a tick, not a frame. f_tick runs zero, one, or several times
# per frame depending on how much time the accumulator holds, while the
# platform delivers events once per frame. An edge query defined against the
# frame is therefore wrong in both directions. At a low frame rate a press that
# should be seen by one tick is seen by three. At a high frame rate a frame
# with no tick drops the press entirely. Events accumulate into a pending set
# as they arrive, and the engine folds that set into the live state exactly
# once per tick, immediately before f_tick.
#
# A press and release of the same key between two ticks, meaning a tap faster
# than the tick rate, reports both edges on the next tick with `down` ending
# false. Dropping either one silently eats fast input, which is the failure
# players notice and developers cannot reproduce.
#
# Key codes are boom's own. The platform's codes never reach a game, because
# the window layer maps them at the boundary in boom.window.map_key. A game
# that had to name a key by its GLFW integer would be importing the windowing
# library through the back door.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use boom.math.Vec2;
use boom.math.vec2;
use boom.math.sqrtf;

# ---------------------------------------------------------------- key codes

# A boom key identifier: a dense index, not a platform scancode
pub def Key: i32;

# Not a key this engine names. mapping an unrecognized platform code yields
# this, and every query on it is false, so an unmapped key is inert rather
# than aliasing onto a real one.
pub val KEY_UNKNOWN: Key = 0;

pub val KEY_A: Key = 1;   pub val KEY_B: Key = 2;   pub val KEY_C: Key = 3;
pub val KEY_D: Key = 4;   pub val KEY_E: Key = 5;   pub val KEY_F: Key = 6;
pub val KEY_G: Key = 7;   pub val KEY_H: Key = 8;   pub val KEY_I: Key = 9;
pub val KEY_J: Key = 10;  pub val KEY_K: Key = 11;  pub val KEY_L: Key = 12;
pub val KEY_M: Key = 13;  pub val KEY_N: Key = 14;  pub val KEY_O: Key = 15;
pub val KEY_P: Key = 16;  pub val KEY_Q: Key = 17;  pub val KEY_R: Key = 18;
pub val KEY_S: Key = 19;  pub val KEY_T: Key = 20;  pub val KEY_U: Key = 21;
pub val KEY_V: Key = 22;  pub val KEY_W: Key = 23;  pub val KEY_X: Key = 24;
pub val KEY_Y: Key = 25;  pub val KEY_Z: Key = 26;

pub val KEY_0: Key = 27;  pub val KEY_1: Key = 28;  pub val KEY_2: Key = 29;
pub val KEY_3: Key = 30;  pub val KEY_4: Key = 31;  pub val KEY_5: Key = 32;
pub val KEY_6: Key = 33;  pub val KEY_7: Key = 34;  pub val KEY_8: Key = 35;
pub val KEY_9: Key = 36;

pub val KEY_SPACE:     Key = 37;
pub val KEY_ESCAPE:    Key = 38;
pub val KEY_ENTER:     Key = 39;
pub val KEY_TAB:       Key = 40;
pub val KEY_BACKSPACE: Key = 41;
pub val KEY_DELETE:    Key = 42;

pub val KEY_LEFT:  Key = 43;
pub val KEY_RIGHT: Key = 44;
pub val KEY_UP:    Key = 45;
pub val KEY_DOWN:  Key = 46;

pub val KEY_LEFT_SHIFT:  Key = 47;
pub val KEY_LEFT_CTRL:   Key = 48;
pub val KEY_LEFT_ALT:    Key = 49;
pub val KEY_RIGHT_SHIFT: Key = 50;
pub val KEY_RIGHT_CTRL:  Key = 51;
pub val KEY_RIGHT_ALT:   Key = 52;

pub val KEY_F1:  Key = 53;  pub val KEY_F2:  Key = 54;  pub val KEY_F3:  Key = 55;
pub val KEY_F4:  Key = 56;  pub val KEY_F5:  Key = 57;  pub val KEY_F6:  Key = 58;
pub val KEY_F7:  Key = 59;  pub val KEY_F8:  Key = 60;  pub val KEY_F9:  Key = 61;
pub val KEY_F10: Key = 62;  pub val KEY_F11: Key = 63;  pub val KEY_F12: Key = 64;

# One past the highest key, sizing the state arrays
pub val KEY_COUNT: usize = 65;

# ------------------------------------------------------------ mouse buttons

# A boom mouse button identifier
pub def Button: i32;

pub val BUTTON_LEFT:   Button = 0;
pub val BUTTON_RIGHT:  Button = 1;
pub val BUTTON_MIDDLE: Button = 2;

# One past the highest button, sizing the state arrays
pub val BUTTON_COUNT: usize = 3;

# ------------------------------------------------------------------ gamepads
#
# GAMEPADS ARE POLLED, NOT DELIVERED. The platform reports a level once per
# frame rather than an edge when it happens, so the edges here are synthesized
# by diffing successive polls. That has one consequence worth stating plainly:
# a press and release inside a single frame is invisible, because the platform
# never saw two levels. The keyboard does not have this limit and this cannot
# be given it.
#
# Everything downstream of the poll keeps the keyboard's discipline. Edges
# accumulate into a pending set and are folded once per tick, so a frame that
# ticks three times reports a press to one tick, and a frame that ticks zero
# times does not lose it.
#
# TRIGGERS ARE BOTH. The platform reports them as axes, but a game binds fire
# to them and wants an edge. They are exposed as an axis and as a synthetic
# button, with hysteresis on the button so a trigger resting near the threshold
# does not chatter a semi-automatic weapon into a machine gun.

# A boom gamepad button identifier
pub def PadButton: i32;

pub val PAD_A:             PadButton = 0;
pub val PAD_B:             PadButton = 1;
pub val PAD_X:             PadButton = 2;
pub val PAD_Y:             PadButton = 3;
pub val PAD_LEFT_BUMPER:   PadButton = 4;
pub val PAD_RIGHT_BUMPER:  PadButton = 5;
pub val PAD_BACK:          PadButton = 6;
pub val PAD_START:         PadButton = 7;
pub val PAD_GUIDE:         PadButton = 8;
pub val PAD_LEFT_THUMB:    PadButton = 9;
pub val PAD_RIGHT_THUMB:   PadButton = 10;
pub val PAD_DPAD_UP:       PadButton = 11;
pub val PAD_DPAD_RIGHT:    PadButton = 12;
pub val PAD_DPAD_DOWN:     PadButton = 13;
pub val PAD_DPAD_LEFT:     PadButton = 14;

# Synthesized from the trigger axes rather than reported by the platform.
pub val PAD_LEFT_TRIGGER:  PadButton = 15;
pub val PAD_RIGHT_TRIGGER: PadButton = 16;

# How many buttons the platform itself reports. The two above are boom's.
pub val PAD_NATIVE_BUTTONS: usize = 15;

# One past the highest pad button, sizing the state arrays
pub val PAD_BUTTON_COUNT: usize = 17;

# A boom gamepad axis identifier
pub def PadAxis: i32;

pub val PAD_AXIS_LEFT_X:        PadAxis = 0;
pub val PAD_AXIS_LEFT_Y:        PadAxis = 1;
pub val PAD_AXIS_RIGHT_X:       PadAxis = 2;
pub val PAD_AXIS_RIGHT_Y:       PadAxis = 3;
pub val PAD_AXIS_LEFT_TRIGGER:  PadAxis = 4;
pub val PAD_AXIS_RIGHT_TRIGGER: PadAxis = 5;

pub val PAD_AXIS_COUNT: usize = 6;

# A stick, for the paired query that applies a deadzone correctly
pub def PadStick: i32;

pub val PAD_STICK_LEFT:  PadStick = 0;
pub val PAD_STICK_RIGHT: PadStick = 1;

# How many pads boom tracks, matching what the platform can report
pub val MAX_PADS: usize = 16;

# What pad_first_pressed returns when no pad pressed the button
pub val PAD_NONE: usize = 16;

# Below this stick magnitude the stick reads as centred.
#
# RADIAL, NOT PER AXIS. A per-axis deadzone squares off the stick: pushing
# diagonally passes both thresholds at a lower magnitude than pushing straight,
# so a rig walks faster on the diagonal and the dead region is a cross rather
# than a circle. The magnitude past the deadzone is rescaled to run 0 to 1, so
# there is no jump from centred to moving at the boundary.
pub val PAD_DEADZONE: f32 = 0.2;

# A trigger crosses to down here and back to up at PAD_TRIGGER_UP.
#
# The gap is the point. One threshold means a trigger resting on it emits an
# edge every poll, which fires a semi-automatic weapon continuously.
val PAD_TRIGGER_DOWN: f32 = 0.6;
val PAD_TRIGGER_UP:   f32 = 0.4;

# One gamepad's state for the current tick
#
# Mirrors the keyboard's shape: `down` is live, `pressed` and `released` belong
# to this tick, `pend_*` accumulates between ticks. `pend_down` doubles as the
# level from the previous poll, which is what the edges are diffed against.
pub rec Gamepad {
    connected: bool;
    down:      [17]bool;
    pressed:   [17]bool;
    released:  [17]bool;
    axes:      [6]f32;

    pend_connected: bool;
    pend_down:      [17]bool;
    pend_pressed:   [17]bool;
    pend_released:  [17]bool;
    pend_axes:      [6]f32;
}

# ------------------------------------------------------------------- state

# Polled input state for the current tick
#
# `down` is the live held state. `pressed` and `released` are the edges
# belonging to the current tick and are true for exactly one tick each.
# The `pend_*` fields accumulate between ticks and are folded in by
# input_begin_tick; a game never reads them.
# ---
# key_down:      held state per key
# key_pressed:   went down during this tick
# key_released:  came up during this tick
# btn_down:      held state per mouse button
# btn_pressed:   went down during this tick
# btn_released:  came up during this tick
# mouse_x:       cursor position in window coordinates
# mouse_y:       cursor position in window coordinates
# mouse_dx:      cursor movement accumulated over this tick
# mouse_dy:      cursor movement accumulated over this tick
# scroll_x:      horizontal scroll accumulated over this tick
# scroll_y:      vertical scroll accumulated over this tick
pub rec Input {
    key_down:     [65]bool;
    key_pressed:  [65]bool;
    key_released: [65]bool;
    btn_down:     [3]bool;
    btn_pressed:  [3]bool;
    btn_released: [3]bool;
    mouse_x:      f64;
    mouse_y:      f64;
    mouse_dx:     f64;
    mouse_dy:     f64;
    scroll_x:     f64;
    scroll_y:     f64;

    pend_key_down:     [65]bool;
    pend_key_pressed:  [65]bool;
    pend_key_released: [65]bool;
    pend_btn_down:     [3]bool;
    pend_btn_pressed:  [3]bool;
    pend_btn_released: [3]bool;
    pend_mouse_x:      f64;
    pend_mouse_y:      f64;
    pend_mouse_dx:     f64;
    pend_mouse_dy:     f64;
    pend_scroll_x:     f64;
    pend_scroll_y:     f64;

    pads: [16]Gamepad;
}

# A zeroed input state, nothing held and no edges
pub fun input_new() Input {
    var i: Input;
    var k: usize = 0;
    for (k < KEY_COUNT) {
        i.key_down[k] = false; i.key_pressed[k] = false; i.key_released[k] = false;
        i.pend_key_down[k] = false; i.pend_key_pressed[k] = false; i.pend_key_released[k] = false;
        k = k + 1;
    }
    var b: usize = 0;
    for (b < BUTTON_COUNT) {
        i.btn_down[b] = false; i.btn_pressed[b] = false; i.btn_released[b] = false;
        i.pend_btn_down[b] = false; i.pend_btn_pressed[b] = false; i.pend_btn_released[b] = false;
        b = b + 1;
    }
    i.mouse_x = 0.0; i.mouse_y = 0.0; i.mouse_dx = 0.0; i.mouse_dy = 0.0;
    i.scroll_x = 0.0; i.scroll_y = 0.0;
    i.pend_mouse_x = 0.0; i.pend_mouse_y = 0.0; i.pend_mouse_dx = 0.0; i.pend_mouse_dy = 0.0;
    i.pend_scroll_x = 0.0; i.pend_scroll_y = 0.0;

    var p: usize = 0;
    for (p < MAX_PADS) {
        i.pads[p].connected      = false;
        i.pads[p].pend_connected = false;
        var pb: usize = 0;
        for (pb < PAD_BUTTON_COUNT) {
            i.pads[p].down[pb]          = false;
            i.pads[p].pressed[pb]       = false;
            i.pads[p].released[pb]      = false;
            i.pads[p].pend_down[pb]     = false;
            i.pads[p].pend_pressed[pb]  = false;
            i.pads[p].pend_released[pb] = false;
            pb = pb + 1;
        }
        var pa: usize = 0;
        for (pa < PAD_AXIS_COUNT) {
            i.pads[p].axes[pa]      = 0.0;
            i.pads[p].pend_axes[pa] = 0.0;
            pa = pa + 1;
        }
        p = p + 1;
    }
    ret i;
}

# ------------------------------------------------- engine-side accumulation
#
# Called by the window layer as platform events arrive, and by the engine at
# each tick boundary. a game calls none of these.

# Record a key transition. `down` is the new state.
#
# Both edges are latched independently of the resulting state, so a press and
# release arriving between the same two ticks reports both rather than
# cancelling out.
pub fun input_key_event(i: *Input, k: Key, down: bool) {
    if (k <= KEY_UNKNOWN || k::usize >= KEY_COUNT) { ret; }
    if (down) { i.pend_key_pressed[k::usize] = true; }
    or        { i.pend_key_released[k::usize] = true; }
    i.pend_key_down[k::usize] = down;
}

# Record a mouse button transition. `down` is the new state.
pub fun input_button_event(i: *Input, b: Button, down: bool) {
    if (b < 0 || b::usize >= BUTTON_COUNT) { ret; }
    if (down) { i.pend_btn_pressed[b::usize] = true; }
    or        { i.pend_btn_released[b::usize] = true; }
    i.pend_btn_down[b::usize] = down;
}

# Record an absolute cursor position, accumulating the movement since the
# last tick rather than the last event, so a game reading delta sees the whole
# tick's motion regardless of how many move events composed it
pub fun input_mouse_event(i: *Input, x: f64, y: f64) {
    i.pend_mouse_dx = i.pend_mouse_dx + (x - i.pend_mouse_x);
    i.pend_mouse_dy = i.pend_mouse_dy + (y - i.pend_mouse_y);
    i.pend_mouse_x = x;
    i.pend_mouse_y = y;
}

# Record a scroll increment, accumulated over the tick
pub fun input_scroll_event(i: *Input, dx: f64, dy: f64) {
    i.pend_scroll_x = i.pend_scroll_x + dx;
    i.pend_scroll_y = i.pend_scroll_y + dy;
}

# Record one poll of one gamepad, synthesizing the edges since the last poll
#
# `buttons` is PAD_NATIVE_BUTTONS entries, non-zero for held. `axes` is
# PAD_AXIS_COUNT entries. The trigger buttons are derived here rather than by
# the platform layer, so every backend gets the same hysteresis.
# ---
# i:         the input state
# pad:       which pad, below MAX_PADS
# connected: whether the pad is present this poll
# buttons:   platform button levels, or nil when disconnected
# axes:      platform axis values, or nil when disconnected
pub fun input_pad_poll(i: *Input, pad: usize, connected: bool, buttons: *u8, axes: *f32) {
    if (pad >= MAX_PADS) { ret; }

    # A pad that vanished releases everything it held. Leaving the levels
    # latched means a rig walks into a wall forever when a cable is kicked out.
    if (!connected || buttons == nil || axes == nil) {
        if (i.pads[pad].pend_connected) {
            var rb: usize = 0;
            for (rb < PAD_BUTTON_COUNT) {
                if (i.pads[pad].pend_down[rb]) { i.pads[pad].pend_released[rb] = true; }
                i.pads[pad].pend_down[rb] = false;
                rb = rb + 1;
            }
            var ra: usize = 0;
            for (ra < PAD_AXIS_COUNT) {
                i.pads[pad].pend_axes[ra] = 0.0;
                ra = ra + 1;
            }
        }
        i.pads[pad].pend_connected = false;
        ret;
    }

    i.pads[pad].pend_connected = true;

    var a: usize = 0;
    for (a < PAD_AXIS_COUNT) {
        i.pads[pad].pend_axes[a] = axes[a];
        a = a + 1;
    }

    var b: usize = 0;
    for (b < PAD_NATIVE_BUTTONS) {
        pad_level(i, pad, b, buttons[b] != 0);
        b = b + 1;
    }

    pad_trigger_level(i, pad, PAD_LEFT_TRIGGER::usize,
                      trigger_unit(axes[PAD_AXIS_LEFT_TRIGGER::usize]));
    pad_trigger_level(i, pad, PAD_RIGHT_TRIGGER::usize,
                      trigger_unit(axes[PAD_AXIS_RIGHT_TRIGGER::usize]));
}

# The platform reports a trigger resting at -1 and fully pressed at 1.
fun trigger_unit(raw: f32) f32 {
    val v: f32 = (raw + 1.0) * 0.5;
    if (v < 0.0) { ret 0.0; }
    if (v > 1.0) { ret 1.0; }
    ret v;
}

# Fold one button's new level into the pending edges.
fun pad_level(i: *Input, pad: usize, b: usize, down: bool) {
    val was: bool = i.pads[pad].pend_down[b];
    if (down && !was)  { i.pads[pad].pend_pressed[b]  = true; }
    if (!down && was)  { i.pads[pad].pend_released[b] = true; }
    i.pads[pad].pend_down[b] = down;
}

# A trigger's digital level, with the down and up thresholds apart so a trigger
# held near the boundary does not emit an edge every poll.
fun pad_trigger_level(i: *Input, pad: usize, b: usize, unit: f32) {
    val was: bool = i.pads[pad].pend_down[b];
    var down: bool = was;
    if (unit >= PAD_TRIGGER_DOWN) { down = true; }
    or (unit <= PAD_TRIGGER_UP)   { down = false; }
    pad_level(i, pad, b, down);
}

# Fold everything accumulated since the last tick into the live state
#
# Called by the engine immediately before each f_tick. this is what makes an
# edge belong to exactly one tick: the pending edges become this tick's edges
# and are then cleared, so a second tick in the same frame sees held state and
# no edges, and a frame that ticks zero times leaves the pending set intact for
# whichever tick comes next.
pub fun input_begin_tick(i: *Input) {
    var k: usize = 0;
    for (k < KEY_COUNT) {
        i.key_down[k]     = i.pend_key_down[k];
        i.key_pressed[k]  = i.pend_key_pressed[k];
        i.key_released[k] = i.pend_key_released[k];
        i.pend_key_pressed[k]  = false;
        i.pend_key_released[k] = false;
        k = k + 1;
    }
    var b: usize = 0;
    for (b < BUTTON_COUNT) {
        i.btn_down[b]     = i.pend_btn_down[b];
        i.btn_pressed[b]  = i.pend_btn_pressed[b];
        i.btn_released[b] = i.pend_btn_released[b];
        i.pend_btn_pressed[b]  = false;
        i.pend_btn_released[b] = false;
        b = b + 1;
    }
    i.mouse_x  = i.pend_mouse_x;
    i.mouse_y  = i.pend_mouse_y;
    i.mouse_dx = i.pend_mouse_dx;
    i.mouse_dy = i.pend_mouse_dy;
    i.scroll_x = i.pend_scroll_x;
    i.scroll_y = i.pend_scroll_y;
    i.pend_mouse_dx  = 0.0;
    i.pend_mouse_dy  = 0.0;
    i.pend_scroll_x  = 0.0;
    i.pend_scroll_y  = 0.0;

    var p: usize = 0;
    for (p < MAX_PADS) {
        i.pads[p].connected = i.pads[p].pend_connected;
        var pb: usize = 0;
        for (pb < PAD_BUTTON_COUNT) {
            i.pads[p].down[pb]     = i.pads[p].pend_down[pb];
            i.pads[p].pressed[pb]  = i.pads[p].pend_pressed[pb];
            i.pads[p].released[pb] = i.pads[p].pend_released[pb];
            i.pads[p].pend_pressed[pb]  = false;
            i.pads[p].pend_released[pb] = false;
            pb = pb + 1;
        }
        var pa: usize = 0;
        for (pa < PAD_AXIS_COUNT) {
            i.pads[p].axes[pa] = i.pads[p].pend_axes[pa];
            pa = pa + 1;
        }
        p = p + 1;
    }
}

# ------------------------------------------------------------ game queries

# Whether a key is held as of this tick
pub fun key_down(i: *Input, k: Key) bool {
    if (k <= KEY_UNKNOWN || k::usize >= KEY_COUNT) { ret false; }
    ret i.key_down[k::usize];
}

# Whether a key went down during this tick, true for exactly one tick per press
pub fun key_pressed(i: *Input, k: Key) bool {
    if (k <= KEY_UNKNOWN || k::usize >= KEY_COUNT) { ret false; }
    ret i.key_pressed[k::usize];
}

# Whether a key came up during this tick, true for exactly one tick per release
pub fun key_released(i: *Input, k: Key) bool {
    if (k <= KEY_UNKNOWN || k::usize >= KEY_COUNT) { ret false; }
    ret i.key_released[k::usize];
}

# Whether a mouse button is held as of this tick
pub fun button_down(i: *Input, b: Button) bool {
    if (b < 0 || b::usize >= BUTTON_COUNT) { ret false; }
    ret i.btn_down[b::usize];
}

# Whether a mouse button went down during this tick
pub fun button_pressed(i: *Input, b: Button) bool {
    if (b < 0 || b::usize >= BUTTON_COUNT) { ret false; }
    ret i.btn_pressed[b::usize];
}

# Whether a mouse button came up during this tick
pub fun button_released(i: *Input, b: Button) bool {
    if (b < 0 || b::usize >= BUTTON_COUNT) { ret false; }
    ret i.btn_released[b::usize];
}

# An axis from two keys, -1.0, 0.0, or 1.0
#
# The shape movement code actually wants: `axis(inp, KEY_A, KEY_D)` rather than
# two queries and a subtraction at every call site. both held cancels to zero,
# which is what a player pressing left and right together expects.
pub fun axis(i: *Input, negative: Key, positive: Key) f32 {
    var v: f32 = 0.0;
    if (key_down(i, positive)) { v = v + 1.0; }
    if (key_down(i, negative)) { v = v - 1.0; }
    ret v;
}

# ------------------------------------------------------- gamepad queries

# Whether a pad was present at the last poll
pub fun pad_connected(i: *Input, pad: usize) bool {
    if (pad >= MAX_PADS) { ret false; }
    ret i.pads[pad].connected;
}

# How many pads are connected
pub fun pad_count(i: *Input) usize {
    var n: usize = 0;
    var p: usize = 0;
    for (p < MAX_PADS) {
        if (i.pads[p].connected) { n = n + 1; }
        p = p + 1;
    }
    ret n;
}

# Whether a pad button is held as of this tick
pub fun pad_down(i: *Input, pad: usize, b: PadButton) bool {
    if (pad >= MAX_PADS || b < 0 || b::usize >= PAD_BUTTON_COUNT) { ret false; }
    ret i.pads[pad].down[b::usize];
}

# Whether a pad button went down during this tick
pub fun pad_pressed(i: *Input, pad: usize, b: PadButton) bool {
    if (pad >= MAX_PADS || b < 0 || b::usize >= PAD_BUTTON_COUNT) { ret false; }
    ret i.pads[pad].pressed[b::usize];
}

# Whether a pad button came up during this tick
pub fun pad_released(i: *Input, pad: usize, b: PadButton) bool {
    if (pad >= MAX_PADS || b < 0 || b::usize >= PAD_BUTTON_COUNT) { ret false; }
    ret i.pads[pad].released[b::usize];
}

# The lowest-numbered pad that pressed a button this tick, or PAD_NONE
#
# What a join prompt needs: "press start to join" has to know which pad said it.
pub fun pad_first_pressed(i: *Input, b: PadButton) usize {
    var p: usize = 0;
    for (p < MAX_PADS) {
        if (pad_pressed(i, p, b)) { ret p; }
        p = p + 1;
    }
    ret PAD_NONE;
}

# A raw axis, with no deadzone applied
#
# Triggers read -1 at rest here because that is what the platform reports. Use
# pad_trigger for the 0 to 1 form, and pad_stick for a stick.
pub fun pad_axis(i: *Input, pad: usize, a: PadAxis) f32 {
    if (pad >= MAX_PADS || a < 0 || a::usize >= PAD_AXIS_COUNT) { ret 0.0; }
    ret i.pads[pad].axes[a::usize];
}

# A trigger as 0 at rest to 1 fully pressed
pub fun pad_trigger(i: *Input, pad: usize, a: PadAxis) f32 {
    if (a != PAD_AXIS_LEFT_TRIGGER && a != PAD_AXIS_RIGHT_TRIGGER) { ret 0.0; }
    if (!pad_connected(i, pad)) { ret 0.0; }
    ret trigger_unit(pad_axis(i, pad, a));
}

# A stick with a radial deadzone, as a direction and magnitude in one vector
#
# Magnitude is rescaled so it runs 0 to 1 from the deadzone edge outward, rather
# than jumping to the deadzone value the moment the stick leaves centre, and it
# is clamped to 1 because the hardware's corners read past it.
pub fun pad_stick(i: *Input, pad: usize, s: PadStick) Vec2 {
    var ax: PadAxis = PAD_AXIS_LEFT_X;
    var ay: PadAxis = PAD_AXIS_LEFT_Y;
    if (s == PAD_STICK_RIGHT) {
        ax = PAD_AXIS_RIGHT_X;
        ay = PAD_AXIS_RIGHT_Y;
    }
    or (s != PAD_STICK_LEFT) { ret vec2(0.0, 0.0); }

    val x: f32 = pad_axis(i, pad, ax);
    val y: f32 = pad_axis(i, pad, ay);
    val len: f32 = sqrtf(x * x + y * y);
    if (len <= PAD_DEADZONE) { ret vec2(0.0, 0.0); }

    var mag: f32 = (len - PAD_DEADZONE) / (1.0 - PAD_DEADZONE);
    if (mag > 1.0) { mag = 1.0; }
    val scale: f32 = mag / len;
    ret vec2(x * scale, y * scale);
}

# --------------------------------------------------------------------- tests

test "input: a press is observed by exactly one tick" {
    var i: Input = input_new();
    input_key_event(?i, KEY_W, true);

    input_begin_tick(?i);
    if (!key_pressed(?i, KEY_W)) { ret 1; }
    if (!key_down(?i, KEY_W))    { ret 1; }

    # The second tick of the same frame sees the key held, but the edge is
    # spent. a frame-scoped implementation fires it again here.
    input_begin_tick(?i);
    if (key_pressed(?i, KEY_W)) { ret 1; }
    if (!key_down(?i, KEY_W))   { ret 1; }
    ret 0;
}

test "input: a press during a frame that ticks zero times is not lost" {
    var i: Input = input_new();
    input_key_event(?i, KEY_SPACE, true);
    # No tick ran this frame: the accumulator held less than one step.
    # Nothing is folded, so nothing may be discarded either.
    input_begin_tick(?i);
    if (!key_pressed(?i, KEY_SPACE)) { ret 1; }
    ret 0;
}

test "input: a tap faster than the tick reports both edges" {
    var i: Input = input_new();
    input_key_event(?i, KEY_SPACE, true);
    input_key_event(?i, KEY_SPACE, false);

    input_begin_tick(?i);
    # Both edges, and the key ends up. collapsing this to the net state eats
    # the tap entirely, which is the bug a player feels and a developer cannot
    # reproduce.
    if (!key_pressed(?i, KEY_SPACE))  { ret 1; }
    if (!key_released(?i, KEY_SPACE)) { ret 1; }
    if (key_down(?i, KEY_SPACE))      { ret 1; }
    ret 0;
}

test "input: edges clear but held state persists across ticks" {
    var i: Input = input_new();
    input_key_event(?i, KEY_A, true);
    input_begin_tick(?i);
    input_begin_tick(?i);
    input_begin_tick(?i);
    if (key_pressed(?i, KEY_A)) { ret 1; }
    if (!key_down(?i, KEY_A))   { ret 1; }

    input_key_event(?i, KEY_A, false);
    input_begin_tick(?i);
    if (!key_released(?i, KEY_A)) { ret 1; }
    if (key_down(?i, KEY_A))      { ret 1; }
    ret 0;
}

test "input: mouse delta accumulates over the whole tick, not the last event" {
    var i: Input = input_new();
    input_mouse_event(?i, 10.0, 0.0);
    input_mouse_event(?i, 20.0, 0.0);
    input_mouse_event(?i, 25.0, 5.0);

    input_begin_tick(?i);
    if (i.mouse_x != 25.0 || i.mouse_y != 5.0) { ret 1; }
    # 25 total, not the 5 of the final event
    if (i.mouse_dx != 25.0 || i.mouse_dy != 5.0) { ret 1; }

    # Delta resets per tick; position does not
    input_begin_tick(?i);
    if (i.mouse_dx != 0.0)  { ret 1; }
    if (i.mouse_x != 25.0)  { ret 1; }
    ret 0;
}

test "input: scroll accumulates per tick and resets" {
    var i: Input = input_new();
    input_scroll_event(?i, 0.0, 1.0);
    input_scroll_event(?i, 0.0, 2.0);
    input_begin_tick(?i);
    if (i.scroll_y != 3.0) { ret 1; }
    input_begin_tick(?i);
    if (i.scroll_y != 0.0) { ret 1; }
    ret 0;
}

test "input: an unmapped key is inert rather than aliasing" {
    var i: Input = input_new();
    input_key_event(?i, KEY_UNKNOWN, true);
    input_begin_tick(?i);
    if (key_down(?i, KEY_UNKNOWN))    { ret 1; }
    if (key_pressed(?i, KEY_UNKNOWN)) { ret 1; }
    # And no real key was disturbed
    if (key_down(?i, KEY_A)) { ret 1; }
    ret 0;
}

test "input: axis is -1, 0, or 1 and opposites cancel" {
    var i: Input = input_new();
    if (axis(?i, KEY_A, KEY_D) != 0.0) { ret 1; }

    input_key_event(?i, KEY_D, true);
    input_begin_tick(?i);
    if (axis(?i, KEY_A, KEY_D) != 1.0) { ret 1; }

    input_key_event(?i, KEY_A, true);
    input_begin_tick(?i);
    if (axis(?i, KEY_A, KEY_D) != 0.0) { ret 1; }

    input_key_event(?i, KEY_D, false);
    input_begin_tick(?i);
    if (axis(?i, KEY_A, KEY_D) != -1.0) { ret 1; }
    ret 0;
}

    # ------------------------------------------------------ gamepad helpers

# Build a poll's worth of platform state: no buttons held, sticks centred,
# triggers at rest, which is -1 and not 0.
fun pad_rest(buttons: *u8, axes: *f32) {
    var b: usize = 0;
    for (b < PAD_NATIVE_BUTTONS) { buttons[b] = 0; b = b + 1; }
    axes[PAD_AXIS_LEFT_X::usize]        = 0.0;
    axes[PAD_AXIS_LEFT_Y::usize]        = 0.0;
    axes[PAD_AXIS_RIGHT_X::usize]       = 0.0;
    axes[PAD_AXIS_RIGHT_Y::usize]       = 0.0;
    axes[PAD_AXIS_LEFT_TRIGGER::usize]  = -1.0;
    axes[PAD_AXIS_RIGHT_TRIGGER::usize] = -1.0;
}

test "input: a pad press is observed by exactly one tick" {
    var i: Input = input_new();
    var buttons: [15]u8;
    var axes: [6]f32;
    pad_rest(?buttons[0], ?axes[0]);

    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (!pad_connected(?i, 0))          { ret 1; }
    if (pad_down(?i, 0, PAD_A))         { ret 2; }

    buttons[PAD_A::usize] = 1;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (!pad_pressed(?i, 0, PAD_A)) { ret 3; }
    if (!pad_down(?i, 0, PAD_A))    { ret 4; }

    # Second tick of the same frame: still held, edge spent.
    input_begin_tick(?i);
    if (pad_pressed(?i, 0, PAD_A)) { ret 5; }
    if (!pad_down(?i, 0, PAD_A))   { ret 6; }
    ret 0;
}

test "input: a disconnected pad releases what it was holding" {
    # A cable kicked out mid-run must not latch the stick and the trigger on.
    # Without this a rig walks into a wall firing until the process ends.
    var i: Input = input_new();
    var buttons: [15]u8;
    var axes: [6]f32;
    pad_rest(?buttons[0], ?axes[0]);
    buttons[PAD_A::usize] = 1;
    axes[PAD_AXIS_LEFT_X::usize] = 1.0;

    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (!pad_down(?i, 0, PAD_A)) { ret 1; }

    input_pad_poll(?i, 0, false, nil, nil);
    input_begin_tick(?i);
    if (pad_connected(?i, 0))         { ret 2; }
    if (pad_down(?i, 0, PAD_A))       { ret 3; }
    if (!pad_released(?i, 0, PAD_A))  { ret 4; }
    if (pad_axis(?i, 0, PAD_AXIS_LEFT_X) != 0.0) { ret 5; }
    ret 0;
}

test "input: a trigger has hysteresis and does not chatter" {
    # One threshold means a trigger resting on it emits a press every poll,
    # which turns a semi-automatic weapon into a continuous one.
    var i: Input = input_new();
    var buttons: [15]u8;
    var axes: [6]f32;
    pad_rest(?buttons[0], ?axes[0]);

    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (pad_down(?i, 0, PAD_RIGHT_TRIGGER)) { ret 1; }

    # 0.5 unit: past the up threshold, short of the down threshold. Nothing.
    axes[PAD_AXIS_RIGHT_TRIGGER::usize] = 0.0;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (pad_down(?i, 0, PAD_RIGHT_TRIGGER)) { ret 2; }

    # Fully pressed: down.
    axes[PAD_AXIS_RIGHT_TRIGGER::usize] = 1.0;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (!pad_pressed(?i, 0, PAD_RIGHT_TRIGGER)) { ret 3; }

    # Back to the middle: still down, because the up threshold is lower.
    axes[PAD_AXIS_RIGHT_TRIGGER::usize] = 0.0;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (!pad_down(?i, 0, PAD_RIGHT_TRIGGER))   { ret 4; }
    if (pad_released(?i, 0, PAD_RIGHT_TRIGGER)) { ret 5; }

    # Released properly.
    axes[PAD_AXIS_RIGHT_TRIGGER::usize] = -1.0;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (!pad_released(?i, 0, PAD_RIGHT_TRIGGER)) { ret 6; }
    if (pad_down(?i, 0, PAD_RIGHT_TRIGGER))      { ret 7; }
    ret 0;
}

test "input: a trigger reads 0 at rest, not -1" {
    var i: Input = input_new();
    var buttons: [15]u8;
    var axes: [6]f32;
    pad_rest(?buttons[0], ?axes[0]);
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (pad_trigger(?i, 0, PAD_AXIS_LEFT_TRIGGER) != 0.0) { ret 1; }

    axes[PAD_AXIS_LEFT_TRIGGER::usize] = 1.0;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (pad_trigger(?i, 0, PAD_AXIS_LEFT_TRIGGER) != 1.0) { ret 2; }

    # The raw axis still reports what the platform said.
    if (pad_axis(?i, 0, PAD_AXIS_LEFT_TRIGGER) != 1.0) { ret 3; }
    ret 0;
}

test "input: the stick deadzone is radial, not per axis" {
    # A per-axis deadzone squares off the stick: a diagonal push clears both
    # thresholds at a lower magnitude than a straight one, so a rig moves
    # faster on the diagonal and the dead region is a cross rather than a disc.
    var i: Input = input_new();
    var buttons: [15]u8;
    var axes: [6]f32;
    pad_rest(?buttons[0], ?axes[0]);

    # Each component is under the deadzone but the magnitude is over it, which
    # is exactly the case a per-axis implementation reports as centred.
    axes[PAD_AXIS_LEFT_X::usize] = 0.18;
    axes[PAD_AXIS_LEFT_Y::usize] = 0.18;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    val d: Vec2 = pad_stick(?i, 0, PAD_STICK_LEFT);
    if (d.x == 0.0 && d.y == 0.0) { ret 1; }

    # And the reverse: each component over the deadzone individually is fine.
    axes[PAD_AXIS_LEFT_X::usize] = 0.1;
    axes[PAD_AXIS_LEFT_Y::usize] = 0.1;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    val c: Vec2 = pad_stick(?i, 0, PAD_STICK_LEFT);
    if (c.x != 0.0 || c.y != 0.0) { ret 2; }
    ret 0;
}

test "input: a stick leaves the deadzone from zero and clamps at one" {
    # Rescaling matters: without it the magnitude jumps straight to the
    # deadzone value the moment the stick moves, so a rig cannot walk slowly.
    var i: Input = input_new();
    var buttons: [15]u8;
    var axes: [6]f32;
    pad_rest(?buttons[0], ?axes[0]);

    # Just past the deadzone: nearly zero, not nearly 0.2.
    axes[PAD_AXIS_LEFT_X::usize] = PAD_DEADZONE + 0.001;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    val slow: Vec2 = pad_stick(?i, 0, PAD_STICK_LEFT);
    if (slow.x <= 0.0)   { ret 1; }
    if (slow.x >= 0.01)  { ret 2; }

    # Full deflection is exactly 1, and a corner past it does not exceed 1.
    axes[PAD_AXIS_LEFT_X::usize] = 1.0;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    val full: Vec2 = pad_stick(?i, 0, PAD_STICK_LEFT);
    if (full.x != 1.0) { ret 3; }

    axes[PAD_AXIS_LEFT_X::usize] = 1.0;
    axes[PAD_AXIS_LEFT_Y::usize] = 1.0;
    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    val corner: Vec2 = pad_stick(?i, 0, PAD_STICK_LEFT);
    val mag: f32 = sqrtf(corner.x * corner.x + corner.y * corner.y);
    if (mag > 1.001) { ret 4; }
    ret 0;
}

test "input: pads are independent and join reports which one" {
    var i: Input = input_new();
    var buttons: [15]u8;
    var axes: [6]f32;
    pad_rest(?buttons[0], ?axes[0]);

    input_pad_poll(?i, 0, true, ?buttons[0], ?axes[0]);
    buttons[PAD_START::usize] = 1;
    input_pad_poll(?i, 2, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);

    if (pad_count(?i) != 2)            { ret 1; }
    if (pad_down(?i, 0, PAD_START))    { ret 2; }
    if (!pad_down(?i, 2, PAD_START))   { ret 3; }
    if (pad_first_pressed(?i, PAD_START) != 2) { ret 4; }
    if (pad_first_pressed(?i, PAD_A) != PAD_NONE) { ret 5; }
    ret 0;
}

test "input: an out-of-range pad is inert" {
    var i: Input = input_new();
    var buttons: [15]u8;
    var axes: [6]f32;
    pad_rest(?buttons[0], ?axes[0]);
    buttons[PAD_A::usize] = 1;

    input_pad_poll(?i, MAX_PADS, true, ?buttons[0], ?axes[0]);
    input_begin_tick(?i);
    if (pad_connected(?i, MAX_PADS))    { ret 1; }
    if (pad_down(?i, MAX_PADS, PAD_A))  { ret 2; }
    if (pad_count(?i) != 0)             { ret 3; }
    ret 0;
}

test "input: buttons carry the same edge semantics as keys" {
    var i: Input = input_new();
    input_button_event(?i, BUTTON_LEFT, true);
    input_begin_tick(?i);
    if (!button_pressed(?i, BUTTON_LEFT)) { ret 1; }
    if (!button_down(?i, BUTTON_LEFT))    { ret 1; }
    input_begin_tick(?i);
    if (button_pressed(?i, BUTTON_LEFT)) { ret 1; }
    if (!button_down(?i, BUTTON_LEFT))   { ret 1; }
    ret 0;
}
