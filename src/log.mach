# leveled, timestamped engine logging
#
# each line is rendered as "[<elapsed>] [<LEVEL>] <message>", where
# <elapsed> is the compact time since the logger started (e.g. "1.5s").
# the line rendering (format_line) is a pure function over an explicit
# timestamp so it is fully testable; the runtime entrypoints read the
# monotonic clock and write to stderr. levels below the configured
# minimum are dropped. the runtime level state is not synchronized, so
# configure it once before the loop and log from the main thread.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.chrono.time.Time;
use std.chrono.time.monotonic;
use std.chrono.time.time_sub;
use std.chrono.duration.Duration;
use std.chrono.duration.format_duration;
use os: std.system.os;

# log severity, ordered from most to least verbose
pub def Level: u8;

# fine-grained diagnostic detail
pub val DEBUG: Level = 0;
# normal operational messages
pub val INFO:  Level = 1;
# recoverable problems worth attention
pub val WARN:  Level = 2;
# failures that break expected behavior
pub val ERROR: Level = 3;
# sentinel above every level; set as the minimum to silence all output
pub val OFF:   Level = 4;

var min_level: i64 = 1;
var started:   i64 = 0;
var start:     Time;

# the fixed-width-ish text tag for a level
# ---
# level: level to name
# ret:   an uppercase ASCII tag, or "?" for an unknown level
pub fun level_tag(level: Level) str {
    if (level == DEBUG) { ret "DEBUG"; }
    if (level == INFO)  { ret "INFO"; }
    if (level == WARN)  { ret "WARN"; }
    if (level == ERROR) { ret "ERROR"; }
    ret "?";
}

fun put(buf: *u8, off: usize, cap: usize, b: u8) usize {
    if (off >= cap) { ret cap + 1; }
    buf[off] = b;
    ret off + 1;
}

fun put_str(buf: *u8, off: usize, cap: usize, s: str) usize {
    var o: usize = off;
    var i: usize = 0;
    for (s[i] != 0) {
        o = put(buf, o, cap, s[i]);
        i = i + 1;
    }
    ret o;
}

# render one log line into a caller buffer
#
# writes "[<elapsed>] [<LEVEL>] <message>\n", null-terminates it, and
# returns its length excluding the terminator. a nil message renders an
# empty body. returns 0 when the buffer is too small to hold the line
# and its terminator, leaving buf's contents unspecified.
# ---
# buf:     destination byte buffer
# cap:     capacity of buf in bytes
# elapsed: time since the logger started, rendered as the timestamp
# level:   severity tag to embed
# msg:     message body, or nil for none
# ret:     bytes written excluding the terminator, or 0 if it did not fit
pub fun format_line(buf: *u8, cap: usize, elapsed: Duration, level: Level, msg: str) usize {
    var tb: [24]u8;
    val ts: str = format_duration(elapsed, ?tb[0], 24);

    var off: usize = 0;
    off = put(buf, off, cap, '[');
    off = put_str(buf, off, cap, ts);
    off = put_str(buf, off, cap, "] [");
    off = put_str(buf, off, cap, level_tag(level));
    off = put_str(buf, off, cap, "] ");
    if (msg != nil) {
        off = put_str(buf, off, cap, msg);
    }
    off = put(buf, off, cap, '\n');

    if (off >= cap) { ret 0; }
    buf[off] = 0;
    ret off;
}

# set the minimum level that will be emitted
#
# messages below level are dropped. pass OFF to silence all output.
# ---
# level: lowest severity to emit
pub fun set_level(level: Level) {
    min_level = level::i64;
}

# whether a message at level would be emitted
#
# use to guard the construction of an expensive message.
# ---
# level: severity to test
# ret:   true if level is at or above the configured minimum
pub fun enabled(level: Level) bool {
    ret level::i64 >= min_level;
}

fun since_start() Duration {
    if (started == 0) {
        start = monotonic();
        started = 1;
    }
    ret time_sub(monotonic(), start);
}

fun emit(level: Level, msg: str) {
    if (level::i64 < min_level) { ret; }
    var buf: [512]u8;
    val n: usize = format_line(?buf[0], 512, since_start(), level, msg);
    if (n > 0) {
        os.write(os.STDERR_FD, ?buf[0], n);
    }
}

# log a message at DEBUG level
# ---
# msg: message to log
pub fun debug(msg: str) {
    emit(DEBUG, msg);
}

# log a message at INFO level
# ---
# msg: message to log
pub fun info(msg: str) {
    emit(INFO, msg);
}

# log a message at WARN level
# ---
# msg: message to log
pub fun warn(msg: str) {
    emit(WARN, msg);
}

# log a message at ERROR level
# ---
# msg: message to log
pub fun error(msg: str) {
    emit(ERROR, msg);
}

fun eq(buf: *u8, s: str) bool {
    var i: usize = 0;
    for (s[i] != 0) {
        if (buf[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret buf[i] == 0;
}

test "log: level_tag names each level" {
    if (!eq(level_tag(DEBUG), "DEBUG")) { ret 1; }
    if (!eq(level_tag(INFO), "INFO")) { ret 2; }
    if (!eq(level_tag(WARN), "WARN")) { ret 3; }
    if (!eq(level_tag(ERROR), "ERROR")) { ret 4; }
    ret 0;
}

test "log: format_line renders timestamp, tag, and message" {
    var b: [512]u8;
    val n: usize = format_line(?b[0], 512, 1500000000, INFO, "hello");
    if (n == 0) { ret 1; }
    if (!eq(?b[0], "[1.5s] [INFO] hello\n")) { ret 2; }
    ret 0;
}

test "log: format_line renders a nil message as empty body" {
    var b: [512]u8;
    val n: usize = format_line(?b[0], 512, 0, ERROR, nil);
    if (n == 0) { ret 1; }
    if (!eq(?b[0], "[0ms] [ERROR] \n")) { ret 2; }
    ret 0;
}

test "log: format_line reports overflow as zero" {
    var b: [8]u8;
    if (format_line(?b[0], 8, 1500000000, WARN, "too long for eight bytes") != 0) { ret 1; }
    ret 0;
}

test "log: enabled respects the configured minimum" {
    set_level(WARN);
    if (enabled(INFO)) { ret 1; }
    if (!enabled(WARN)) { ret 2; }
    if (!enabled(ERROR)) { ret 3; }
    set_level(OFF);
    if (enabled(ERROR)) { ret 4; }
    set_level(INFO);
    ret 0;
}

test "log: length excludes the terminator" {
    var b: [64]u8;
    val n: usize = format_line(?b[0], 64, 0, DEBUG, "x");
    # "[0ms] [DEBUG] x\n" is 16 bytes
    if (n != 16) { ret 1; }
    if (b[n] != 0) { ret 2; }
    ret 0;
}
