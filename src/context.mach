# the running engine state and its subsystem lifecycle
#
# the Context owns the window, the frame clock, the fixed-timestep
# accumulator, and the input queue, and exposes the per-frame values a
# game reads (alpha, running). context_init brings the subsystems up and
# context_shutdown tears them down; the frame loop that drives an App
# against this state lives in boom.engine.
#
# every App hook receives the running Context, so a game carries its own
# state through the opaque ctx.user pointer (set with context_set_user)
# rather than reaching for module globals.

use boom.window.Window;
use boom.window.window_open;
use boom.window.window_close;
use boom.window.window_is_valid;
use boom.window.window_set_event_sink;
use boom.clock.Clock;
use boom.clock.clock_new;
use boom.timestep.Timestep;
use boom.timestep.timestep_new;
use boom.event.EventQueue;
use boom.event.queue_new;
use window: boom.window;
use inp: boom.input;
use phy: boom.physics;
use boom.math.vec.vec3;
use std.chrono.duration.Duration;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.string.str;

# the parameters context_init brings the engine up with
# ---
# width:     window client-area width
# height:    window client-area height
# title:     window title, UTF-8
# fixed_dt:  duration of one fixed update step; must be positive
# max_frame: largest frame time folded into the accumulator at once
# frame_dt:  when non-zero, the delta every frame is told it took, instead of
#            the wall clock. See below.
#
# WHY A GAME WOULD PIN ITS FRAME DELTA. The loop feeds the wall-clock delta into
# the fixed-step accumulator, so the number of ticks a run executes depends on
# how busy the machine was. That is correct for a game. A measurement that
# draws a fixed number of frames still simulates a variable
# number of steps, so anything read back afterwards moves between two runs of
# the same binary.
#
# It is not a small effect. Onslaughter's probe reads back its scene target after
# a fixed frame count and its pixel coverage moved by around one percent across
# runs, a band wide enough to hide a real regression inside it.
#
# Setting frame_dt makes a run a function of its inputs alone. Leave it zero and
# the engine behaves exactly as before.
pub rec Config {
    width:     i32;
    height:    i32;
    title:     str;
    fixed_dt:  Duration;
    max_frame: Duration;
    frame_dt:  Duration;
}

# the live state of a running engine
# ---
# window:  platform window and GL context
# clock:   per-frame timing
# step:    fixed-timestep accumulator
# events:  input event queue, fed by the window
# input:   polled key and mouse state, sampled at each fixed tick
# physics: rigid body simulation, stepped once per fixed tick
# sink:    where the window delivers input; points into this Context
# alpha:   render interpolation factor in [0, 1), set each frame
# running: cleared to stop the loop
# user:    opaque game-state pointer, nil until set; hooks reach it
#          through the Context they receive
pub rec Context {
    window:  Window;
    clock:   Clock;
    step:    Timestep;
    events:  EventQueue;
    input:   inp.Input;
    physics: phy.Physics;
    sink:    window.Sink;
    alpha:   f64;
    running: bool;
    user:    ptr;
    # Zero means the clock is the wall clock. Non-zero pins every frame's delta
    # to this, which is what makes a run reproducible. See Config.frame_dt.
    frame_dt: Duration;
}

# bring the engine subsystems up
#
# opens the window, attaches the input queue as its event
# sink, starts the clock, and arms the fixed-timestep accumulator.
# returns false if the window could not be opened, in which case the
# subsystems are already torn down and context_shutdown must not be
# called.
# ---
# ctx: context to initialize
# cfg: window and timestep parameters
# ret: true on success, false if the window could not be opened
pub fun context_init(ctx: *Context, cfg: Config) bool {
    ctx.events = queue_new();
    ctx.input   = inp.input_new();
    ctx.physics = phy.physics_new(vec3(0.0, -9.81, 0.0));
    ctx.window = window_open(cfg.width, cfg.height, cfg.title);
    if (!window_is_valid(?ctx.window)) {
        ret false;
    }
    # the sink lives in the Context so it outlives the window, which the
    # platform callbacks require: they reach it through the GLFW user pointer
    # long after context_init has returned.
    ctx.sink.queue = ?ctx.events;
    ctx.sink.input = ?ctx.input;
    window_set_event_sink(?ctx.window, ?ctx.sink);
    ctx.clock   = clock_new();
    ctx.step    = timestep_new(cfg.fixed_dt, cfg.max_frame);
    ctx.alpha   = 0.0;
    ctx.running = true;
    ctx.user    = nil;
    ctx.frame_dt = cfg.frame_dt;
    ret true;
}

# request the run loop to exit after the current frame
# ---
# ctx: context to stop
pub fun context_stop(ctx: *Context) {
    ctx.running = false;
}

# attach an opaque game-state pointer to the context
#
# the pointer is passed through untouched and reachable from every hook
# as ctx.user (or via context_user), letting a game carry its own state
# without module globals. set it after context_init and before run so
# f_init sees it. the engine never dereferences it.
# ---
# ctx:  context to attach to
# user: opaque pointer to game state, or nil to clear
pub fun context_set_user(ctx: *Context, user: ptr) {
    ctx.user = user;
}

# read the opaque game-state pointer attached to the context
# ---
# ctx: context to query
# ret: the pointer set by context_set_user, or nil if none
pub fun context_user(ctx: *Context) ptr {
    ret ctx.user;
}

# tear the engine subsystems down
#
# closes the window and shuts down the platform layer. call once, after
# a successful context_init.
# ---
# ctx: context to shut down
pub fun context_shutdown(ctx: *Context) {
    window_close(?ctx.window);
    ctx.running = false;
}

test "context: user pointer round-trips" {
    var ctx: Context;
    var state: i64 = 42;
    if (context_user(?ctx) != nil) { ret 1; }
    context_set_user(?ctx, (?state)::ptr);
    if (context_user(?ctx) != (?state)::ptr) { ret 2; }
    if (ctx.user != (?state)::ptr) { ret 3; }
    ret 0;
}

test "context: user pointer clears to nil" {
    var ctx: Context;
    var state: i64 = 7;
    context_set_user(?ctx, (?state)::ptr);
    context_set_user(?ctx, nil);
    if (context_user(?ctx) != nil) { ret 1; }
    ret 0;
}
