# a spinning lit cube, the boom.graphics end-to-end example
#
# a standalone consumer of boom: it opens a window through the engine,
# compiles a GLSL shader, uploads an embedded cube mesh, and draws it with
# a transform and camera every frame, all through boom handles and without
# importing mach-gl, mach-glfw, or mach-image directly. this is the shape
# a real game takes. the interim math is imported on its own (as gm) so
# swapping it for mach-math later is a one-line change.

use std.runtime;
use std.print;
use boom.context.Config;
use boom.context.Context;
use boom.context.context_init;
use boom.context.context_set_user;
use boom.context.context_user;
use boom.context.context_shutdown;
use boom.engine.run;
use boom.app.App;
use gfx: boom.graphics;
use gm:  boom.graphics.math;
use std.chrono.duration.SECOND;
use std.chrono.duration.MILLISECOND;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.types.result.Result;
use std.types.string.str;

# the game's own state, carried through ctx.user
# ---
# shader:    the cube's compiled program
# mesh:      the cube geometry
# camera:    the viewpoint
# transform: the cube's placement, spun each tick
# ready:     whether init succeeded; draw is skipped if not
rec Game {
    shader:    gfx.Shader;
    mesh:      gfx.Mesh;
    camera:    gfx.Camera;
    transform: gfx.Transform;
    ready:     u8;
}

val VERTEX_SRC: str = "#version 330 core\nlayout(location = 0) in vec3 a_position;\nlayout(location = 1) in vec3 a_normal;\nlayout(location = 2) in vec2 a_uv;\nuniform mat4 u_model;\nuniform mat4 u_view;\nuniform mat4 u_projection;\nout vec3 v_normal;\nvoid main() {\n    v_normal = mat3(u_model) * a_normal;\n    gl_Position = u_projection * u_view * u_model * vec4(a_position, 1.0);\n}\n";

val FRAGMENT_SRC: str = "#version 330 core\nin vec3 v_normal;\nuniform vec4 u_base_color;\nout vec4 frag_color;\nvoid main() {\n    vec3 n = normalize(v_normal);\n    vec3 light = normalize(vec3(0.4, 1.0, 0.6));\n    float d = max(dot(n, light), 0.0);\n    frag_color = vec4(u_base_color.rgb * (0.25 + 0.75 * d), u_base_color.a);\n}\n";

# fill the 24 vertices and 36 indices of a unit cube centered at the origin
# ---
# verts:   destination for 24 vertices
# indices: destination for 36 indices
fun build_cube(verts: *gfx.Vertex, indices: *u32) {
    val h: f32 = 0.5;

    val faces: [6]gm.Vec3 = [6]gm.Vec3{
        gm.Vec3{x: 0.0, y: 0.0, z: 1.0},
        gm.Vec3{x: 0.0, y: 0.0, z: 0.0 - 1.0},
        gm.Vec3{x: 1.0, y: 0.0, z: 0.0},
        gm.Vec3{x: 0.0 - 1.0, y: 0.0, z: 0.0},
        gm.Vec3{x: 0.0, y: 1.0, z: 0.0},
        gm.Vec3{x: 0.0, y: 0.0 - 1.0, z: 0.0},
    };

    # four corner positions per face, CCW seen from outside
    val corners: [24]gm.Vec3 = [24]gm.Vec3{
        gm.Vec3{x: 0.0 - h, y: 0.0 - h, z: h}, gm.Vec3{x: h, y: 0.0 - h, z: h}, gm.Vec3{x: h, y: h, z: h}, gm.Vec3{x: 0.0 - h, y: h, z: h},
        gm.Vec3{x: h, y: 0.0 - h, z: 0.0 - h}, gm.Vec3{x: 0.0 - h, y: 0.0 - h, z: 0.0 - h}, gm.Vec3{x: 0.0 - h, y: h, z: 0.0 - h}, gm.Vec3{x: h, y: h, z: 0.0 - h},
        gm.Vec3{x: h, y: 0.0 - h, z: h}, gm.Vec3{x: h, y: 0.0 - h, z: 0.0 - h}, gm.Vec3{x: h, y: h, z: 0.0 - h}, gm.Vec3{x: h, y: h, z: h},
        gm.Vec3{x: 0.0 - h, y: 0.0 - h, z: 0.0 - h}, gm.Vec3{x: 0.0 - h, y: 0.0 - h, z: h}, gm.Vec3{x: 0.0 - h, y: h, z: h}, gm.Vec3{x: 0.0 - h, y: h, z: 0.0 - h},
        gm.Vec3{x: 0.0 - h, y: h, z: h}, gm.Vec3{x: h, y: h, z: h}, gm.Vec3{x: h, y: h, z: 0.0 - h}, gm.Vec3{x: 0.0 - h, y: h, z: 0.0 - h},
        gm.Vec3{x: 0.0 - h, y: 0.0 - h, z: 0.0 - h}, gm.Vec3{x: h, y: 0.0 - h, z: 0.0 - h}, gm.Vec3{x: h, y: 0.0 - h, z: h}, gm.Vec3{x: 0.0 - h, y: 0.0 - h, z: h},
    };

    val uvs: [4]gm.Vec2 = [4]gm.Vec2{
        gm.Vec2{x: 0.0, y: 0.0},
        gm.Vec2{x: 1.0, y: 0.0},
        gm.Vec2{x: 1.0, y: 1.0},
        gm.Vec2{x: 0.0, y: 1.0},
    };

    var face: i32 = 0;
    for (face < 6) {
        var c: i32 = 0;
        for (c < 4) {
            val vi: i32 = face * 4 + c;
            verts[vi] = gfx.Vertex{position: corners[vi], normal: faces[face], uv: uvs[c]};
            c = c + 1;
        }
        val base: i32 = face * 4;
        val ii: i32 = face * 6;
        indices[ii + 0] = (base + 0)::u32;
        indices[ii + 1] = (base + 1)::u32;
        indices[ii + 2] = (base + 2)::u32;
        indices[ii + 3] = (base + 0)::u32;
        indices[ii + 4] = (base + 2)::u32;
        indices[ii + 5] = (base + 3)::u32;
        face = face + 1;
    }
}

fun on_init(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    g.ready = 0;

    gfx.graphics_init();
    gfx.viewport(ctx.window.width, ctx.window.height);

    val compiled: Result[gfx.Shader, str] = gfx.shader(VERTEX_SRC, FRAGMENT_SRC);
    if (is_err[gfx.Shader, str](compiled)) {
        print.eprintlnf("shader error: {}", unwrap_err[gfx.Shader, str](compiled));
        ret;
    }
    g.shader = unwrap_ok[gfx.Shader, str](compiled);

    var verts:   [24]gfx.Vertex;
    var indices: [36]u32;
    build_cube(?verts[0], ?indices[0]);
    g.mesh = gfx.mesh(?verts[0], 24, ?indices[0], 36);

    val aspect: f32 = ctx.window.width::f32 / ctx.window.height::f32;
    g.camera = gfx.camera_perspective(
        gm.vec3(0.0, 1.5, 4.0),
        gm.vec3(0.0, 0.0, 0.0),
        gm.radians(60.0),
        aspect,
        0.1,
        100.0,
    );

    g.transform = gfx.transform_identity();
    g.ready = 1;
}

# accumulated spin angle in radians, advanced each fixed tick
var spin: f32 = 0.0;

fun on_tick(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (g.ready == 0) {
        ret;
    }
    spin = spin + 0.02;
    g.transform.rotation = gm.quat_from_axis_angle(gm.vec3(0.3, 1.0, 0.15), spin);
}

fun on_draw(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    gfx.clear(gm.vec4(0.08, 0.09, 0.12, 1.0));
    if (g.ready == 0) {
        ret;
    }
    gfx.shader_set_vec4(?g.shader, "u_base_color", gm.vec4(1.0, 0.55, 0.15, 1.0));
    gfx.draw(?g.mesh, ?g.shader, ?g.transform, ?g.camera);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var game: Game;

    var app: App;
    app.f_init = on_init;
    app.f_tick = on_tick;
    app.f_draw = on_draw;
    app.f_dnit = nil::fun(*Context);

    var ctx: Context;
    val cfg: Config = Config{
        width:     960,
        height:    540,
        title:     "boom.graphics: spinning cube",
        fixed_dt:  SECOND / 60,
        max_frame: 250 * MILLISECOND,
    };

    if (!context_init(?ctx, cfg)) {
        print.eprintln("failed to open window");
        ret 1;
    }
    context_set_user(?ctx, (?game)::ptr);
    run(?ctx, ?app);
    context_shutdown(?ctx);
    ret 0;
}
