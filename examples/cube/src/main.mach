# the boom.graphics v2 end-to-end example: 3D, offscreen, and 2D passes
#
# a standalone consumer of boom that proves the Renderer and Pass API
# drives 2D and 3D through the same machinery. each frame runs three
# passes:
#
#   1. a 3D scene pass renders a spinning, textured, lit cube (loaded from
#      a .glb, textured from a QOI image) into an offscreen render target.
#   2. a post-process pass blits that target to the window through a
#      custom shader (a vignette), showing custom shaders and sampling a
#      render target as a 2D sprite.
#   3. a 2D overlay pass draws a small HUD sprite with the default sprite
#      shader.
#
# everything goes through boom handles: the game never imports mach-gl,
# mach-glfw, mach-image, or mach-gltf. run it from this directory so the
# relative asset paths resolve. geometry math comes from boom.math (as
# gm), so swapping it for mach-math later is a localized change.

use std.runtime;
use std.print;
use boom.context.Config;
use boom.context.Context;
use boom.context.context_init;
use boom.context.context_set_user;
use boom.context.context_user;
use boom.context.context_shutdown;
use boom.engine.run;
use boom.app.App;
use gfx: boom.graphics;
use gm:  boom.math;
use std.chrono.duration.SECOND;
use std.chrono.duration.MILLISECOND;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.types.bool.bool;
use std.types.string.str;

# the game's own state, carried through ctx.user
# ---
# renderer:  the render device, created once
# shader:    the cube's 3D program
# mesh:      the cube geometry, loaded from cube.glb
# texture:   the surface texture, loaded from checker.qoi
# material:  the 3D shader plus the texture binding
# camera:    the 3D viewpoint
# transform: the cube's placement, spun each tick
# scene:     the offscreen target the 3D pass renders into
# post:      the post-process shader the blit pass drives
# ready:     whether init succeeded; draw is skipped if not
rec Game {
    renderer:  gfx.Renderer;
    shader:    gfx.Shader;
    mesh:      gfx.Mesh;
    texture:   gfx.Texture;
    material:  gfx.Material;
    camera:    gfx.Camera;
    transform: gm.Transform;
    scene:     gfx.RenderTarget;
    post:      gfx.Shader;
    ready:     u8;
}

val VERTEX_SRC: str = "#version 330 core\nlayout(location = 0) in vec3 a_position;\nlayout(location = 1) in vec3 a_normal;\nlayout(location = 2) in vec2 a_uv;\nuniform mat4 u_model;\nuniform mat4 u_view;\nuniform mat4 u_projection;\nout vec3 v_normal;\nout vec2 v_uv;\nvoid main() {\n    v_normal = mat3(u_model) * a_normal;\n    v_uv = a_uv;\n    gl_Position = u_projection * u_view * u_model * vec4(a_position, 1.0);\n}\n";

val FRAGMENT_SRC: str = "#version 330 core\nin vec3 v_normal;\nin vec2 v_uv;\nuniform vec4 u_base_color;\nuniform sampler2D u_texture0;\nout vec4 frag_color;\nvoid main() {\n    vec3 n = normalize(v_normal);\n    vec3 light = normalize(vec3(0.4, 1.0, 0.6));\n    float d = max(dot(n, light), 0.0);\n    vec4 tex = texture(u_texture0, v_uv);\n    frag_color = vec4(tex.rgb * u_base_color.rgb * (0.25 + 0.75 * d), tex.a * u_base_color.a);\n}\n";

# the post-process pass follows the sprite uniform convention: a full
# quad in pixel space, u_texture0 the scene target. it flips v on the y
# axis (a render target's texture origin is bottom-left) and darkens the
# edges into a vignette.
val POST_VERTEX_SRC: str = "#version 330 core\nlayout(location = 0) in vec2 a_position;\nlayout(location = 1) in vec2 a_uv;\nuniform mat4 u_projection;\nuniform mat4 u_model;\nuniform vec4 u_src;\nout vec2 v_uv;\nvoid main() {\n    v_uv = u_src.xy + a_uv * u_src.zw;\n    gl_Position = u_projection * u_model * vec4(a_position, 0.0, 1.0);\n}\n";

val POST_FRAGMENT_SRC: str = "#version 330 core\nin vec2 v_uv;\nuniform sampler2D u_texture0;\nuniform vec4 u_tint;\nout vec4 frag_color;\nvoid main() {\n    vec2 uv = vec2(v_uv.x, 1.0 - v_uv.y);\n    vec4 c = texture(u_texture0, uv);\n    vec2 d = uv - vec2(0.5, 0.5);\n    float vig = 1.0 - dot(d, d) * 1.1;\n    frag_color = vec4(c.rgb * vig, 1.0) * u_tint;\n}\n";

fun on_init(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    g.ready = 0;

    val w: i32 = ctx.window.width;
    val h: i32 = ctx.window.height;

    val ri: Result[bool, gfx.Error] = gfx.renderer_init(?g.renderer, ?ctx.window, w, h);
    if (is_err[bool, gfx.Error](ri)) {
        var e: gfx.Error = unwrap_err[bool, gfx.Error](ri);
        print.eprintlnf("renderer init error: {}", gfx.error_msg(?e));
        ret;
    }

    val compiled: Result[gfx.Shader, gfx.Error] = gfx.shader(VERTEX_SRC, FRAGMENT_SRC);
    if (is_err[gfx.Shader, gfx.Error](compiled)) {
        var e: gfx.Error = unwrap_err[gfx.Shader, gfx.Error](compiled);
        print.eprintlnf("shader error: {}", gfx.error_msg(?e));
        ret;
    }
    g.shader = unwrap_ok[gfx.Shader, gfx.Error](compiled);

    val post: Result[gfx.Shader, gfx.Error] = gfx.shader(POST_VERTEX_SRC, POST_FRAGMENT_SRC);
    if (is_err[gfx.Shader, gfx.Error](post)) {
        var e: gfx.Error = unwrap_err[gfx.Shader, gfx.Error](post);
        print.eprintlnf("post shader error: {}", gfx.error_msg(?e));
        ret;
    }
    g.post = unwrap_ok[gfx.Shader, gfx.Error](post);

    val loaded: Result[gfx.Mesh, gfx.Error] = gfx.mesh_load("assets/cube.glb");
    if (is_err[gfx.Mesh, gfx.Error](loaded)) {
        var e: gfx.Error = unwrap_err[gfx.Mesh, gfx.Error](loaded);
        print.eprintlnf("mesh load error: {}", gfx.error_msg(?e));
        ret;
    }
    g.mesh = unwrap_ok[gfx.Mesh, gfx.Error](loaded);

    val tex: Result[gfx.Texture, gfx.Error] = gfx.texture_load("assets/checker.qoi");
    if (is_err[gfx.Texture, gfx.Error](tex)) {
        var e: gfx.Error = unwrap_err[gfx.Texture, gfx.Error](tex);
        print.eprintlnf("texture load error: {}", gfx.error_msg(?e));
        ret;
    }
    g.texture = unwrap_ok[gfx.Texture, gfx.Error](tex);

    g.material = gfx.material(?g.shader);
    gfx.material_add_texture(?g.material, "u_texture0", ?g.texture);

    val st: Result[gfx.RenderTarget, gfx.Error] = gfx.render_target(w, h);
    if (is_err[gfx.RenderTarget, gfx.Error](st)) {
        var e: gfx.Error = unwrap_err[gfx.RenderTarget, gfx.Error](st);
        print.eprintlnf("render target error: {}", gfx.error_msg(?e));
        ret;
    }
    g.scene = unwrap_ok[gfx.RenderTarget, gfx.Error](st);

    val aspect: f32 = w::f32 / h::f32;
    g.camera = gfx.camera_perspective(
        gm.vec3(0.0, 1.5, 4.0),
        gm.vec3(0.0, 0.0, 0.0),
        gm.radians(60.0),
        aspect,
        0.1,
        100.0,
    );

    g.transform = gm.transform_identity();
    g.ready = 1;
}

# accumulated spin angle in radians, advanced each fixed tick
var spin: f32 = 0.0;

fun on_tick(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (g.ready == 0) {
        ret;
    }
    spin = spin + 0.02;
    g.transform.rotation = gm.quat_from_axis_angle(gm.vec3(0.3, 1.0, 0.15), spin);
}

fun on_draw(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (g.ready == 0) {
        ret;
    }

    val w: f32 = ctx.window.width::f32;
    val h: f32 = ctx.window.height::f32;

    gfx.renderer_begin_frame(?g.renderer);

    var scene_desc: gfx.PassDesc = gfx.pass_scene(?g.camera);
    scene_desc.target = ?g.scene;
    var scene_pass: gfx.Pass = gfx.pass_begin(?g.renderer, ?scene_desc);
    gfx.pass_draw_material(?scene_pass, ?g.mesh, ?g.material, ?g.transform);
    gfx.pass_end(?scene_pass);

    var post_desc: gfx.PassDesc = gfx.pass_overlay();
    post_desc.shader = ?g.post;
    var post_pass: gfx.Pass = gfx.pass_begin(?g.renderer, ?post_desc);
    gfx.pass_draw_sprite(?post_pass, gfx.render_target_texture(?g.scene), gfx.rect(0.0, 0.0, w, h), gm.vec4(1.0, 1.0, 1.0, 1.0));
    gfx.pass_end(?post_pass);

    var hud_desc: gfx.PassDesc = gfx.pass_overlay();
    var hud_pass: gfx.Pass = gfx.pass_begin(?g.renderer, ?hud_desc);
    gfx.pass_draw_sprite(?hud_pass, ?g.texture, gfx.rect(16.0, 16.0, 96.0, 96.0), gm.vec4(1.0, 1.0, 1.0, 1.0));
    gfx.pass_end(?hud_pass);

    gfx.renderer_end_frame(?g.renderer);
}

fun on_dnit(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (g.ready == 0) {
        ret;
    }
    gfx.render_target_delete(?g.scene);
    gfx.mesh_delete(?g.mesh);
    gfx.texture_delete(?g.texture);
    gfx.shader_delete(?g.shader);
    gfx.shader_delete(?g.post);
    gfx.renderer_dnit(?g.renderer);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var game: Game;

    var app: App;
    app.f_init = on_init;
    app.f_tick = on_tick;
    app.f_draw = on_draw;
    app.f_dnit = on_dnit;

    var ctx: Context;
    val cfg: Config = Config{
        width:     960,
        height:    540,
        title:     "boom.graphics v2: 3D, offscreen, and 2D passes",
        fixed_dt:  SECOND / 60,
        max_frame: 250 * MILLISECOND,
    };

    if (!context_init(?ctx, cfg)) {
        print.eprintln("failed to open window");
        ret 1;
    }
    context_set_user(?ctx, (?game)::ptr);
    run(?ctx, ?app);
    context_shutdown(?ctx);
    ret 0;
}
