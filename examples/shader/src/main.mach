# The escape hatch: a game drawing with its own shader.
#
# boom ships one lit program, and that is a default rather than a system. A game
# that wants its own lighting, its own fog, its own stylised anything supplies a
# pair of SPIR-V modules and draws with them. This is what that costs the game:
# a gfx.Shader, a gfx.pass_draw_shaded, and a block of its own parameters. No
# pipeline, no render pass, no descriptor set, no vk import.
#
# Two cubes are drawn side by side, spinning together. The left one goes through
# gfx.pass_draw_material and boom's built-in program: one hardcoded directional
# light. The right one goes through a gfx.Shader, and it is meant to look
# DIFFERENT -- a rim light in a colour the game chose. Identical cubes would
# mean the game's fragment stage was not the one that ran.
#
# THE SHADERS ARE THIS EXAMPLE'S OWN, in shaders/, compiled to SPIR-V by a build
# step and embedded below. boom does not compile them and does not know what is
# in them. That is the whole arrangement being demonstrated: a game carries a
# spirv project of its own, and the engine takes two byte buffers.
#
# The fragment stage shades entirely from what the game supplies, so the
# right-hand cube is evidence rather than decoration: if either descriptor were
# not reaching the shader it would be flat, black, or different every frame, not
# subtly off. It reads two things, and the difference between them is the point:
#
#   - binding 4, the block gfx.pass_set_user delivers, holds the pass's own
#     parameters. It is copied into each draw's uniform slot as the draw is
#     submitted, so two draws in one frame can be given different blocks. It is
#     gfx.USER_BYTES, which is 256 bytes: sixteen vec4s.
#
#   - binding 8, the buffer gfx.renderer_storage_write fills, holds the light
#     list. It is ONE buffer the whole frame shares, filled once as the frame
#     opens, and it is what a payload larger than a slot goes in. This example
#     draws thirty-two lights at two vec4 each, which is sixty-four vec4s: four
#     times what the block could carry, and the reason the buffer exists.
#
# The probe below checks the second of those by reading an entry back rather
# than by looking at it. See PROBE MODE in shaders/src/game_frag.mach.
#
# The assets are the cube example's, referenced rather than copied: two binary
# files duplicated in a repository is two files to keep in step. Run it from this
# directory so the relative paths resolve.

use std.runtime;
use std.print;
use boom.context.Config;
use boom.context.Context;
use boom.context.context_init;
use boom.context.context_set_user;
use boom.context.context_user;
use boom.context.context_shutdown;
use boom.engine.run;
use boom.app.App;
use input: boom.input;
use gfx: boom.graphics;
use gm:  boom.math;
use std.chrono.duration.SECOND;
use std.chrono.duration.MILLISECOND;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

# The game's compiled stages. Produced by the build-shaders step in mach.toml,
# which is why the artifact declares `need` on it: an embed is not an edge in
# the build graph, so nothing would otherwise have been asked to produce these.
#[embed("../res/spv/game_vert.spv")]
val GAME_VERT_SPV: [_]u8;
#[embed("../res/spv/game_frag.spv")]
val GAME_FRAG_SPV: [_]u8;

# What a game's shader reads at binding 4.
#
# Its layout is the game's business: boom copies the bytes and never looks at
# them. The only rule is that it fits in gfx.USER_BYTES and matches what the
# shader declares, and the usual std140 rules apply, which is why the direction
# is a vec4 rather than a vec3. The matching declaration is `rec Params` in
# shaders/src/game_frag.mach, and nothing checks that the two agree: a mismatch
# reads the colour out of the direction's padding and still draws.
rec Params {
    direction: gm.Vec4;
    colour:    gm.Vec4;
    # x: how many lights the storage buffer holds. y: an entry to read straight
    # out of that buffer instead of shading, or a negative number to shade.
    control:   gm.Vec4;
}

# One light in the list the storage buffer carries.
#
# Two vec4: a position with its radius in w, then a colour. std430 rather than
# std140, because this is a storage buffer, which is what makes an array of
# these a straight copy with a natural 16-byte stride rather than a repack.
rec Light {
    place: gm.Vec4;
    tint:  gm.Vec4;
}

# How many lights this example draws.
#
# Thirty-two, at two vec4 each, is sixty-four vec4s. gfx.USER_BYTES is sixteen,
# so six lights fit in the block once the header is in and this needs five times
# that. It is not a large scene; it is the size at which the block runs out.
val LIGHT_COUNT: usize = 32;

# The entry the probe reads back out of the storage buffer.
#
# Odd, so it is a colour rather than a position, and past the sixteenth, which
# is the whole point: an entry a uniform block could not have carried. 41 is
# light 20's colour.
val PROBE_ENTRY: usize = 41;

# ---
# renderer:  the window's renderer, which owns the device
# mesh:      the cube geometry
# texture:   the surface texture
# material:  the texture binding and base colour both cubes draw with
# shader:    the game's own program, used for the right-hand cube
# camera:    the 3D viewpoint
# left:      the built-in cube's placement
# right:     the shaded cube's placement
# params:    the block the game shader reads at binding 4
# lights:    the light list the game shader reads at binding 8, LIGHT_COUNT of
#            them; the array size is a literal because a record field's is, so
#            the two have to be moved together
# ready:     whether init succeeded
# paused:    whether the spin is advancing
rec Game {
    renderer: gfx.Renderer;
    mesh:     gfx.Mesh;
    texture:  gfx.Texture;
    material: gfx.Material;
    shader:   gfx.Shader;
    camera:   gfx.Camera;
    left:     gm.Transform;
    right:    gm.Transform;
    params:   Params;
    lights:   [32]Light;
    ready:    u8;
    paused:   bool;

    # --frames N draws N frames and quits, so the example can be checked without
    # someone watching it: the exit code says whether it managed to, and a run
    # under the validation layers says whether it did so legally.
    budget:   usize;
    gbuf:     gfx.RenderTarget;
    gbuf_ok:  bool;

    # A 64x64 target used to prove a loading pass preserves what is already
    # drawn. Nothing about this is visible on screen; it exists because the
    # failure it checks for is invisible to any test without a GPU.
    probe:    gfx.RenderTarget;
    probe_ok: bool;
    probe_lit: usize;
    # A tiny float target cleared above one and read back after the run.
    hdr_probe: gfx.RenderTarget;
    hdr_ok:    bool;
    hdr_kept:  bool;

    # THE STORAGE-BUFFER PROBE. A 2x2 float target the game shader writes one
    # entry of the light list into, in probe mode, on the first frame. Reading
    # it back and comparing against the bytes the host wrote is what turns "the
    # buffer reached the shader" from something to look at into something to
    # check, and a float target is what carries the value back unrounded.
    lit_probe: gfx.RenderTarget;
    lit_ok:    bool;
    lit_kept:  bool;
    drawn:    usize;
}

fun on_init(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    g.ready  = 0;
    g.paused = false;

    val w: i32 = ctx.window.width;
    val h: i32 = ctx.window.height;

    val ri: Result[bool, gfx.Error] = gfx.renderer_init(?g.renderer, ctx.window.handle, w, h);
    if (is_err[bool, gfx.Error](ri)) {
        var e: gfx.Error = unwrap_err[bool, gfx.Error](ri);
        print.eprintlnf("renderer init error: {}", gfx.error_msg(?e));
        ret;
    }

    val d: *gfx.Device = gfx.renderer_device(?g.renderer);

    # A four-attachment target, which is the shape a deferred pipeline wants:
    # albedo, normal, material and emissive written by one geometry pass. This
    # example does not shade from it. It exists so the render pass, the
    # framebuffer and the per-attachment clear values are exercised against a
    # real driver, because those are the parts that fail at object creation
    # rather than anywhere a test without a GPU can see.
    g.gbuf_ok = false;
    var formats: [4]gfx.RenderFormat;
    formats[0] = gfx.RENDER_RGBA8_SRGB;
    formats[1] = gfx.RENDER_RGBA8_UNORM;
    formats[2] = gfx.RENDER_RGBA8_UNORM;
    formats[3] = gfx.RENDER_RGBA16_FLOAT;
    val gdesc: gfx.RenderTargetDesc = gfx.render_target_desc_mrt(?formats[0], 4);
    val gb: Result[gfx.RenderTarget, gfx.Error] = gfx.render_target_create(d, 320, 180, ?gdesc);
    if (is_err[gfx.RenderTarget, gfx.Error](gb)) {
        var ge: gfx.Error = unwrap_err[gfx.RenderTarget, gfx.Error](gb);
        print.eprintlnf("mrt target error: {}", gfx.error_msg(?ge));
        ret;
    }
    g.gbuf = unwrap_ok[gfx.RenderTarget, gfx.Error](gb);
    g.gbuf_ok = true;
    print.printlnf("mixed mrt target: {} attachments at 320x180; hdr readback is {} bytes",
                   gfx.render_target_count(?g.gbuf),
                   gfx.render_target_raw_bytes_at(?g.gbuf, 3));

    g.probe_ok  = false;
    g.probe_lit = 0;
    val pb: Result[gfx.RenderTarget, gfx.Error] = gfx.render_target(d, 64, 64);
    if (is_err[gfx.RenderTarget, gfx.Error](pb)) {
        var pe: gfx.Error = unwrap_err[gfx.RenderTarget, gfx.Error](pb);
        print.eprintlnf("probe target error: {}", gfx.error_msg(?pe));
        ret;
    }
    g.probe = unwrap_ok[gfx.RenderTarget, gfx.Error](pb);
    g.probe_ok = true;

    g.hdr_ok = false;
    g.hdr_kept = false;
    val hdesc: gfx.RenderTargetDesc = gfx.render_target_desc(gfx.RENDER_RGBA16_FLOAT, 1);
    val hp: Result[gfx.RenderTarget, gfx.Error] = gfx.render_target_create(d, 2, 2, ?hdesc);
    if (is_err[gfx.RenderTarget, gfx.Error](hp)) {
        var he: gfx.Error = unwrap_err[gfx.RenderTarget, gfx.Error](hp);
        print.eprintlnf("hdr probe target error: {}", gfx.error_msg(?he));
        ret;
    }
    g.hdr_probe = unwrap_ok[gfx.RenderTarget, gfx.Error](hp);
    g.hdr_ok = true;

    g.lit_ok   = false;
    g.lit_kept = false;
    val ldesc: gfx.RenderTargetDesc = gfx.render_target_desc(gfx.RENDER_RGBA16_FLOAT, 1);
    val lp: Result[gfx.RenderTarget, gfx.Error] = gfx.render_target_create(d, 2, 2, ?ldesc);
    if (is_err[gfx.RenderTarget, gfx.Error](lp)) {
        var le: gfx.Error = unwrap_err[gfx.RenderTarget, gfx.Error](lp);
        print.eprintlnf("light probe target error: {}", gfx.error_msg(?le));
        ret;
    }
    g.lit_probe = unwrap_ok[gfx.RenderTarget, gfx.Error](lp);
    g.lit_ok = true;

    val loaded: Result[gfx.Mesh, gfx.Error] = gfx.mesh_load(d, "../cube/assets/cube.glb");
    if (is_err[gfx.Mesh, gfx.Error](loaded)) {
        var e: gfx.Error = unwrap_err[gfx.Mesh, gfx.Error](loaded);
        print.eprintlnf("mesh load error: {}", gfx.error_msg(?e));
        ret;
    }
    g.mesh = unwrap_ok[gfx.Mesh, gfx.Error](loaded);

    # This example knows the checker is display colour and names that explicitly.
    # A normal or material map uses the same loader with COLOR_LINEAR; examples
    # such as cube retain the shorter, source-compatible sRGB form.
    val tex: Result[gfx.Texture, gfx.Error] = gfx.texture_load_as(
        d, "../cube/assets/checker.qoi", gfx.COLOR_SRGB);
    if (is_err[gfx.Texture, gfx.Error](tex)) {
        var e: gfx.Error = unwrap_err[gfx.Texture, gfx.Error](tex);
        print.eprintlnf("texture load error: {}", gfx.error_msg(?e));
        ret;
    }
    g.texture = unwrap_ok[gfx.Texture, gfx.Error](tex);

    g.material = gfx.material();
    gfx.material_add_texture(?g.material, "u_texture0", ?g.texture);

    # THE WHOLE OF THE HATCH. Two SPIR-V modules in, a Shader out. Nothing is
    # built yet: the pipelines a shader needs depend on the render pass and the
    # vertex layout it is drawn with, and neither is known until a draw.
    val sr: Result[bool, gfx.Error] = gfx.shader(?g.shader,
                                                 ?GAME_VERT_SPV[0], $length_of(GAME_VERT_SPV),
                                                 ?GAME_FRAG_SPV[0], $length_of(GAME_FRAG_SPV));
    if (is_err[bool, gfx.Error](sr)) {
        var e: gfx.Error = unwrap_err[bool, gfx.Error](sr);
        print.eprintlnf("shader error: {}", gfx.error_msg(?e));
        ret;
    }

    g.params.direction = gm.vec4(0.4, 0.8, 0.45, 0.0);
    g.params.colour    = gm.vec4(1.0, 0.96, 0.88, 1.0);
    g.params.control   = gm.vec4(LIGHT_COUNT::f32, 0.0 - 1.0, 0.0, 0.0);

    # RESERVE WHAT THE SHADER DECLARES, ONCE. The descriptor's range is the
    # buffer's whole capacity, so it is also the largest storage block a shader
    # may legally declare: `rec Lights` in shaders/src/game_frag.mach is 128
    # f32x4, and a range shorter than that is invalid usage the layers report
    # and a driver may honour anyway. The starting capacity is already larger,
    # so this changes nothing today and keeps being true if either number moves.
    if (!gfx.renderer_storage_reserve(?g.renderer, 128 * $size_of(gm.Vec4))) {
        print.eprintln("could not reserve the storage buffer");
        ret;
    }

    # The list itself. Colours are fixed and positions are animated, so the
    # entry the probe reads back is stable across the run: a probe comparing
    # against a value that moves proves only that something arrived.
    var li: usize = 0;
    for (li < LIGHT_COUNT) {
        val t: f32 = li::f32 / LIGHT_COUNT::f32;
        g.lights[li].place = gm.vec4(0.0, 0.0, 0.0, 2.2);
        g.lights[li].tint  = gm.vec4(0.35 + 0.65 * t, 0.55 * (1.0 - t), 0.9 - 0.4 * t, 1.0);
        li = li + 1;
    }

    # One beacon with an exactly representable colour, so the probe compares
    # halves against halves rather than against something the conversion moved.
    # 0.5, 0.25 and 1.0 are 0x3800, 0x3400 and 0x3C00.
    g.lights[PROBE_ENTRY / 2].tint = gm.vec4(0.5, 0.25, 1.0, 1.0);

    val aspect: f32 = w::f32 / h::f32;
    g.camera = gfx.camera_perspective(
        gm.vec3(0.0, 1.5, 5.5),
        gm.vec3(0.0, 0.0, 0.0),
        gm.radians(60.0),
        aspect,
        0.1,
        100.0,
    );

    g.left  = gm.transform_identity();
    g.right = gm.transform_identity();
    g.left.position  = gm.vec3(0.0 - 1.4, 0.0, 0.0);
    g.right.position = gm.vec3(1.4, 0.0, 0.0);
    g.ready = 1;
}

var spin: f32 = 0.0;

fun on_tick(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (g.ready == 0) { ret; }

    if (input.key_pressed(?ctx.input, input.KEY_SPACE)) { g.paused = !g.paused; }
    if (!g.paused) {
        val steer: f32 = input.axis(?ctx.input, input.KEY_A, input.KEY_D);
        spin = spin + 0.02 + steer * 0.04;
        val q: gm.Quat = gm.quat_from_axis_angle(gm.vec3(0.3, 1.0, 0.15), spin);
        g.left.rotation  = q;
        g.right.rotation = q;
    }
}

fun on_draw(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (g.ready == 0) { ret; }

    val w: f32 = ctx.window.width::f32;
    val h: f32 = ctx.window.height::f32;
    if (w <= 0.0 || h <= 0.0) { ret; }
    g.camera.aspect = w / h;

    var opened: bool = false;
    val br: Result[bool, gfx.Error] = gfx.renderer_begin_frame(?g.renderer, ?opened);
    if (is_err[bool, gfx.Error](br)) {
        var e: gfx.Error = unwrap_err[bool, gfx.Error](br);
        print.eprintlnf("begin frame error: {}", gfx.error_msg(?e));
        ret;
    }
    if (!opened) { ret; }

    # FILL THE BUFFER ONCE, HERE. Every draw in the frame reads the same bytes,
    # so this is not per draw and must not be: a payload larger than a uniform
    # slot copied per draw is the cost this binding exists to remove. It also
    # has to be after renderer_begin_frame, which is where the fence proving the
    # GPU has finished with this frame's buffer is waited on.
    #
    # The lights orbit, so the positions differ every frame and the buffer is
    # genuinely rewritten rather than filled once at start-up and forgotten.
    var li: usize = 0;
    for (li < LIGHT_COUNT) {
        val a: f32 = spin + li::f32 * 0.196;
        val r: f32 = 1.9 + 0.35 * gm.sinf(a * 3.0);
        g.lights[li].place = gm.vec4(1.4 + r * gm.cosf(a),
                                     r * gm.sinf(a),
                                     0.9 * gm.cosf(a * 2.0),
                                     2.2);
        li = li + 1;
    }
    if (!gfx.renderer_storage_write(?g.renderer, (?g.lights[0]):~*u8,
                                    LIGHT_COUNT * $size_of(Light))) {
        print.eprintln("the light list could not be written");
    }

    # THE STORAGE-BUFFER PROBE, on the first frame only.
    #
    # The shader is asked for one entry of the buffer instead of a shaded pixel,
    # and on_dnit compares the pixel against the bytes written above. The entry
    # is past the sixteenth, so a uniform block could not have carried it, which
    # is what makes this a check of the storage buffer rather than of anything
    # that happened to be bound.
    #
    # The block at binding 4 is what carries the request, and it is a different
    # value here than in the scene pass below even though both draws are in the
    # same frame. That is the difference between the two: the block is copied
    # per draw, and the buffer is the frame's.
    if (g.lit_ok && g.drawn == 0) {
        var ld: gfx.PassDesc = gfx.pass_overlay();
        ld.target      = ?g.lit_probe;
        ld.clear       = 1;
        ld.clear_color = gm.vec4(0.0, 0.0, 0.0, 1.0);
        var lpass: gfx.Pass = gfx.pass_begin(?g.renderer, ?ld);

        g.params.control = gm.vec4(LIGHT_COUNT::f32, PROBE_ENTRY::f32, 0.0, 0.0);
        if (!gfx.pass_set_user(?lpass, (?g.params):~*u8, $size_of(Params))) {
            print.eprintln("the params block does not fit in a uniform slot");
        }

        # A pixel-space pass, so the cube is placed in pixels and scaled well
        # past the 2x2 target: every pixel is covered, which is what makes the
        # readback a comparison rather than a coin toss.
        var cover: gm.Transform = gm.transform_identity();
        cover.position = gm.vec3(1.0, 1.0, 0.0);
        cover.scale    = gm.vec3(64.0, 64.0, 1.0);
        gfx.pass_draw_shaded(?lpass, ?g.mesh, ?g.material, ?cover, ?g.shader);
        gfx.pass_end(?lpass);

        g.params.control = gm.vec4(LIGHT_COUNT::f32, 0.0 - 1.0, 0.0, 0.0);
    }

    # Open and close a pass into the four-attachment target every frame. This
    # is what puts the multi-attachment render pass, its framebuffer and its
    # five clear values in front of the driver. The sprite draw is expected to
    # be refused and counted, because the built-in programs declare one colour
    # output and are not valid here.
    # THE LOADING-PASS CHECK, over the first two frames.
    #
    # Frame 0 clears the probe to black and draws a white square into it.
    # Frame 1 opens a pass with clear = 0 and draws nothing. If a loading pass
    # preserves the attachment, the square is still there at the end; if the
    # target is wiped by every pass that touches it, it is gone. on_dnit reads
    # the pixels back and says which happened.
    if (g.probe_ok && g.drawn < 2) {
        var pd: gfx.PassDesc = gfx.pass_overlay();
        pd.target      = ?g.probe;
        pd.clear_color = gm.vec4(0.0, 0.0, 0.0, 1.0);
        pd.clear       = 0;
        if (g.drawn == 0) { pd.clear = 1; }
        var pp: gfx.Pass = gfx.pass_begin(?g.renderer, ?pd);
        if (g.drawn == 0) {
            gfx.pass_draw_sprite(?pp, nil, gfx.rect(0.0, 0.0, 32.0, 32.0),
                                 gm.vec4(1.0, 1.0, 1.0, 1.0));
        }
        gfx.pass_end(?pp);
    }


    if (g.hdr_ok && g.drawn == 0) {
        var hd: gfx.PassDesc = gfx.pass_overlay();
        hd.target = ?g.hdr_probe;
        hd.clear = 1;
        hd.clear_color = gm.vec4(2.0, 0.5, 0.25, 1.0);
        var hp: gfx.Pass = gfx.pass_begin(?g.renderer, ?hd);
        gfx.pass_end(?hp);
    }

    if (g.gbuf_ok) {
        var gd: gfx.PassDesc = gfx.pass_overlay();
        gd.target      = ?g.gbuf;
        gd.clear       = 1;
        gd.clear_color = gm.vec4(0.0, 0.0, 0.0, 1.0);
        var gp: gfx.Pass = gfx.pass_begin(?g.renderer, ?gd);
        # Once, not every frame: one refusal is the evidence, 120 of them is
        # noise that buries the rest of the output.
        if (g.drawn == 0) {
            gfx.pass_draw_sprite(?gp, nil, gfx.rect(0.0, 0.0, 32.0, 32.0),
                                 gm.vec4(1.0, 1.0, 1.0, 1.0));
        }
        gfx.pass_end(?gp);
    }

    g.drawn = g.drawn + 1;
    if (g.budget != 0 && g.drawn >= g.budget) { ctx.running = false; }

    var desc: gfx.PassDesc = gfx.pass_scene(?g.camera);
    var p: gfx.Pass = gfx.pass_begin(?g.renderer, ?desc);

    # The engine's program.
    gfx.pass_draw_material(?p, ?g.mesh, ?g.material, ?g.left);

    # The game's. The block is set once and read by every draw that follows, so
    # a game with one light sets it here and a game with per-object parameters
    # sets it again before each draw. The light list it names is already in the
    # frame's storage buffer, written once at the top of this function.
    if (!gfx.pass_set_user(?p, (?g.params):~*u8, $size_of(Params))) {
        print.eprintln("the params block does not fit in a uniform slot");
    }
    gfx.pass_draw_shaded(?p, ?g.mesh, ?g.material, ?g.right, ?g.shader);

    gfx.pass_end(?p);

    val er: Result[bool, gfx.Error] = gfx.renderer_end_frame(?g.renderer);
    if (is_err[bool, gfx.Error](er)) {
        var e: gfx.Error = unwrap_err[bool, gfx.Error](er);
        print.eprintlnf("end frame error: {}", gfx.error_msg(?e));
    }

    # A shaded draw that could not build its pipeline is dropped and counted, so
    # the failure is a number rather than a cube that is quietly missing. So is
    # a draw whose uniforms could not be uploaded, which used to return in
    # silence and is the reason a stage that did not run was indistinguishable
    # from one that ran wrongly.
    if (gfx.renderer_dropped(?g.renderer) != 0) {
        print.eprintln("warning: draws were dropped");
    }
    # A block that did not fit is a different fault: the draws still happened,
    # reading whatever their slot's user region last held.
    if (gfx.renderer_refused(?g.renderer) != 0) {
        print.eprintln("warning: a uniform block was refused for not fitting");
    }
    if (gfx.renderer_storage_refused(?g.renderer) != 0) {
        print.eprintln("warning: a storage write was refused");
    }
}

fun on_dnit(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (g.ready == 0) { ret; }

    # One per render pass and vertex layout the shader was drawn with, so two
    # here: the window's pass and the float probe's. A number that climbs with
    # the frame count would mean the cache is not being hit and every frame is
    # building a pipeline.
    print.printlnf("drew {} frames; the shader built {} pipeline(s)",
                   g.drawn, gfx.shader_pipelines(?g.shader));

    # What the storage buffer cost. The capacity is what it grew to and keeps,
    # the used count is what this frame actually wrote, and a buffer count above
    # one means the payload outgrew the reservation while the game ran.
    print.printlnf("storage: {} of {} bytes used, {} buffer(s), {} refused",
                   gfx.renderer_storage_used(?g.renderer),
                   gfx.renderer_storage_capacity(?g.renderer),
                   gfx.renderer_storage_buffers(?g.renderer),
                   gfx.renderer_storage_refused(?g.renderer));

    val d: *gfx.Device = gfx.renderer_device(?g.renderer);

    if (g.probe_ok) {
        var px: [16384]u8;
        val rr: Result[bool, gfx.Error] = gfx.render_target_read(d, ?g.probe, ?px[0], 16384);
        if (is_err[bool, gfx.Error](rr)) {
            var re: gfx.Error = unwrap_err[bool, gfx.Error](rr);
            print.eprintlnf("probe read error: {}", gfx.error_msg(?re));
        }
        or {
            var lit: usize = 0;
            var i: usize = 0;
            for (i < 4096) {
                if (px[i * 4] > 128) { lit = lit + 1; }
                i = i + 1;
            }
            g.probe_lit = lit;
            # 32x32 of a 64x64 target is a quarter of 4096.
            if (lit >= 1000 && lit <= 1100) {
                print.printlnf("PROBE OK: a loading pass preserved {} pixels", lit);
            }
            or {
                print.printlnf("PROBE FAIL: expected about 1024 pixels, found {}", lit);
            }
        }
        gfx.render_target_delete(d, ?g.probe);
    }


    if (g.hdr_ok) {
        var raw: [32]u8;
        val hr: Result[bool, gfx.Error] = gfx.render_target_read_raw_at(
            d, ?g.hdr_probe, 0, ?raw[0], 32);
        if (is_err[bool, gfx.Error](hr)) {
            var hre: gfx.Error = unwrap_err[bool, gfx.Error](hr);
            print.eprintlnf("hdr probe read error: {}", gfx.error_msg(?hre));
        }
        or {
            # Half-float 2.0 is 0x4000. Seeing it proves the float attachment
            # retained radiance that an RGBA8 target would clamp to 1.0.
            g.hdr_kept = raw[0] == 0x00 && raw[1] == 0x40;
            if (g.hdr_kept) { print.println("HDR PROBE OK: float target retained 2.0"); }
            or              { print.println("HDR PROBE FAIL: float target clipped or changed 2.0"); }
        }
        gfx.render_target_delete(d, ?g.hdr_probe);
    }

    # THE STORAGE-BUFFER PROBE, read back and compared.
    #
    # The shader wrote entry PROBE_ENTRY of the light list out as a colour, and
    # the host wrote (0.5, 0.25, 1.0, 1.0) there, whose halves are 0x3800,
    # 0x3400, 0x3C00 and 0x3C00. Exact values, so this is a comparison rather
    # than a tolerance: anything else means the buffer did not arrive, arrived
    # at the wrong offset, or arrived with the wrong stride.
    if (g.lit_ok) {
        var lraw: [32]u8;
        val lr: Result[bool, gfx.Error] = gfx.render_target_read_raw_at(
            d, ?g.lit_probe, 0, ?lraw[0], 32);
        if (is_err[bool, gfx.Error](lr)) {
            var lre: gfx.Error = unwrap_err[bool, gfx.Error](lr);
            print.eprintlnf("light probe read error: {}", gfx.error_msg(?lre));
        }
        or {
            g.lit_kept = lraw[0] == 0x00 && lraw[1] == 0x38
                      && lraw[2] == 0x00 && lraw[3] == 0x34
                      && lraw[4] == 0x00 && lraw[5] == 0x3C
                      && lraw[6] == 0x00 && lraw[7] == 0x3C;
            if (g.lit_kept) {
                print.printlnf("STORAGE PROBE OK: entry {} of the light list read back exactly",
                               PROBE_ENTRY);
            }
            or {
                print.printlnf("STORAGE PROBE FAIL: entry {} read back as {} {} {} {} {} {} {} {}",
                               PROBE_ENTRY,
                               lraw[0], lraw[1], lraw[2], lraw[3],
                               lraw[4], lraw[5], lraw[6], lraw[7]);
            }
        }
        gfx.render_target_delete(d, ?g.lit_probe);
    }

    if (g.gbuf_ok) { gfx.render_target_delete(d, ?g.gbuf); }
    gfx.shader_delete(?g.shader, d);
    gfx.mesh_delete(d, ?g.mesh);
    gfx.texture_delete(d, ?g.texture);
    gfx.renderer_dnit(?g.renderer);
}

# Decimal digits to a count, stopping at the first character that is not one.
fun parse_usize(s: str) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (s[i] != 0) {
        val c: u8 = s[i];
        if (c < 48 || c > 57) { ret n; }
        n = n * 10 + (c - 48)::usize;
        i = i + 1;
    }
    ret n;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var game: Game;
    game.budget = 0;
    game.drawn  = 0;
    var argi: i64 = 1;
    for (argi < argc) {
        if (str_equals(argv[argi]:~str, "--frames") && argi + 1 < argc) {
            game.budget = parse_usize(argv[argi + 1]:~str);
            argi = argi + 1;
        }
        argi = argi + 1;
    }

    var app: App;
    app.f_init = on_init;
    app.f_tick = on_tick;
    app.f_draw = on_draw;
    app.f_dnit = on_dnit;

    var ctx: Context;
    val cfg: Config = Config{
        width:     960,
        height:    540,
        title:     "boom.graphics: a game's own shader",
        fixed_dt:  SECOND / 60,
        max_frame: 250 * MILLISECOND,
    };

    if (!context_init(?ctx, cfg)) {
        print.eprintln("failed to open window");
        ret 1;
    }
    context_set_user(?ctx, (?game)::ptr);
    run(?ctx, ?app);
    context_shutdown(?ctx);

    # A failed startup step leaves ready at 0, and a run that was asked for a
    # fixed number of frames and drew fewer did not do what it was asked. Both
    # have to reach the exit code, or a check that runs this cannot fail.
    if (game.ready == 0) { ret 1; }
    if (game.budget != 0 && game.drawn < game.budget) {
        print.printlnf("FAIL frames: drew {} of {}", game.drawn, game.budget);
        ret 1;
    }
    # The probe reports through the exit code as well as the output. A check
    # that prints FAIL and exits 0 is a check nothing can act on.
    if (game.probe_ok && (game.probe_lit < 1000 || game.probe_lit > 1100)) { ret 1; }
    if (game.hdr_ok && !game.hdr_kept) { ret 1; }
    # The storage buffer is the thing this example exists to demonstrate, so a
    # run in which it did not arrive must fail rather than print and exit 0.
    if (game.lit_ok && !game.lit_kept) { ret 1; }
    ret 0;
}
