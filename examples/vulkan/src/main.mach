# Vulkan bring-up smoke test.
#
# Everything in boom's Vulkan path is unit-tested only where it is pure: extent
# clamping, memory-type search, format mapping, barrier masks, frame rotation.
# The parts that talk to a driver, which is most of the code, have no coverage at
# all in CI because CI has no GPU.
#
# This runs them. It opens a window with no client API, brings up an instance,
# surface, device and queues, builds a swapchain and a frame loop, then acquires,
# clears and presents real frames, rebuilding on resize. It reports what it found
# and exits non-zero on any failure, so it is a check and not a demo.
#
# It is not part of CI. Run it on a machine with a working GPU:
#
#   mach dep pull && mach build . && ./out/*/debug/bin/vulkan
#
# A machine whose driver cannot initialize reports that and exits non-zero,
# which is the correct outcome and not a pass. Confirm with an independent
# probe before blaming this: an ICD present in /usr/share/vulkan/icd.d and
# device nodes in /dev do not mean vkEnumeratePhysicalDevices will succeed.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_err;
use std.runtime;
use p: std.print;
use vk;
use boom.window.Window;
use boom.window.window_open_vulkan;
use boom.window.window_is_valid;
use boom.window.window_should_close;
use boom.window.window_poll;
use boom.window.window_close;
use boom.graphics.error.Error;
use boom.graphics.error.error_msg;
use boom.graphics.vk.Vk;
use boom.graphics.vk.vk_init;
use boom.graphics.vk.vk_dnit;
use boom.graphics.swapchain.Swapchain;
use boom.graphics.swapchain.swapchain_init;
use boom.graphics.swapchain.swapchain_rebuild;
use boom.graphics.swapchain.swapchain_dnit;
use boom.graphics.frame.FrameLoop;
use boom.graphics.frame.frame_init;
use boom.graphics.frame.frame_begin;
use boom.graphics.frame.frame_end;
use boom.graphics.frame.frame_rebuild_targets;
use boom.graphics.frame.frame_dnit;
use boom.graphics.buffer.Buffer;
use boom.graphics.buffer.buffer_init;
use boom.graphics.buffer.buffer_write;
use boom.graphics.buffer.buffer_dnit;
use boom.graphics.descriptor.Descriptors;
use boom.graphics.descriptor.descriptors_init;
use boom.graphics.descriptor.descriptors_dnit;
use boom.graphics.image.Image;
use boom.graphics.image.image_upload;
use boom.graphics.image.image_dnit;
use boom.graphics.image.sampler_init;
use boom.graphics.image.sampler_dnit;

# How many frames to present before exiting.
#
# Enough to cycle the in-flight frames many times, so a frame that reused a
# semaphore or a fence still owned by the GPU has many chances to be caught by
# the validation layers or to deadlock, rather than passing on the first frame.
val FRAMES: usize = 240;

val WIDTH:  i32 = 960;
val HEIGHT: i32 = 540;

fun fail(step: str, r: Result[bool, Error]) bool {
    if (!is_err[bool, Error](r)) { ret false; }
    var e: Error = unwrap_err[bool, Error](r);
    p.eprintlnf("FAIL {}: {}", step, error_msg(?e));
    ret true;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var w: Window = window_open_vulkan(WIDTH, HEIGHT, "boom vulkan smoke");
    if (!window_is_valid(?w)) {
        p.println("FAIL window: could not open a window with no client API");
        ret 1;
    }

    var v: Vk;
    if (fail("vk_init", vk_init(?v, w.handle, "boom vulkan smoke"))) { ret 1; }
    p.printlnf("ok   device and queues: graphics family {}, present family {}",
               v.graphics_family, v.present_family);

    var s: Swapchain;
    if (fail("swapchain_init", swapchain_init(?s, ?v, WIDTH::u32, HEIGHT::u32))) { ret 1; }
    p.printlnf("ok   swapchain: {} images at {}x{}", s.count, s.width, s.height);

    var f: FrameLoop;
    if (fail("frame_init", frame_init(?f, ?v, ?s))) { ret 1; }
    p.println("ok   render pass, framebuffers, and per-frame synchronization");

    # A host-visible buffer written from the CPU, which is the per-frame uniform
    # path, and a device-local image filled through a staging copy, which is the
    # texture path. Both exercise the memory-type search against a real driver's
    # memory table rather than the synthetic one in the unit tests.
    var ubo: Buffer;
    if (fail("buffer_init", buffer_init(?ubo, ?v, 256,
        vk.BUFFER_USAGE_UNIFORM_BUFFER_BIT,
        vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT))) { ret 1; }
    var bytes: [256]u8;
    var i: usize = 0;
    for (i < 256) { bytes[i] = i::u8; i = i + 1; }
    if (!buffer_write(?ubo, ?v, ?bytes[0], 256)) {
        p.println("FAIL buffer_write: could not map and fill a host-visible buffer");
        ret 1;
    }
    p.println("ok   host-visible buffer mapped and written");

    var pixels: [64]u8;
    i = 0;
    for (i < 64) { pixels[i] = 255; i = i + 1; }
    var tex: Image;
    if (fail("image_upload", image_upload(?tex, ?v, f.pool, ?pixels[0], 4, 4))) { ret 1; }
    p.println("ok   image created, staged, and transitioned for sampling");

    var sampler: vk.Sampler;
    if (fail("sampler_init", sampler_init(?sampler, ?v, true))) { ret 1; }
    p.println("ok   sampler");

    var desc: Descriptors;
    if (fail("descriptors_init", descriptors_init(?desc, ?v))) { ret 1; }
    p.println("ok   descriptor pool");

    var presented: usize = 0;
    var rebuilds:  usize = 0;
    var n: usize = 0;
    for (n < FRAMES) {
        window_poll();
        if (window_should_close(?w)) { n = FRAMES; }
        or {
            var began: bool = false;
            if (fail("frame_begin", frame_begin(?f, ?v, ?s, ?began))) { ret 1; }

            if (!began) {
                # Out of date, which a resize causes and which is not an error.
                # Rebuilding here is the path a real resize takes, so exercising
                # it is the point rather than an inconvenience.
                if (fail("swapchain_rebuild", swapchain_rebuild(?s, ?v, s.width, s.height))) { ret 1; }
                if (fail("frame_rebuild_targets", frame_rebuild_targets(?f, ?v, ?s))) { ret 1; }
                rebuilds = rebuilds + 1;
            }
            or {
                var ended: bool = false;
                if (fail("frame_end", frame_end(?f, ?v, ?s, ?ended))) { ret 1; }
                if (ended) { presented = presented + 1; }
                or {
                    if (fail("swapchain_rebuild", swapchain_rebuild(?s, ?v, s.width, s.height))) { ret 1; }
                    if (fail("frame_rebuild_targets", frame_rebuild_targets(?f, ?v, ?s))) { ret 1; }
                    rebuilds = rebuilds + 1;
                }
            }
            n = n + 1;
        }
    }

    p.printlnf("ok   presented {} frames, {} swapchain rebuilds", presented, rebuilds);

    # Teardown order is part of what is being checked: the surface outlives the
    # device, the pool outlives the frames, and destroying anything the GPU is
    # still reading is what the validation layers exist to catch.
    descriptors_dnit(?desc, ?v);
    sampler_dnit(sampler, ?v);
    image_dnit(?tex, ?v);
    buffer_dnit(?ubo, ?v);
    frame_dnit(?f, ?v);
    swapchain_dnit(?s, ?v);
    vk_dnit(?v);
    window_close(?w);
    p.println("ok   teardown");

    if (presented == 0) {
        p.println("FAIL: no frame was presented");
        ret 1;
    }
    p.println("PASS");
    ret 0;
}
