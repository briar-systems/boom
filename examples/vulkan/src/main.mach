# Renderer smoke test.
#
# Everything in boom's Vulkan path is unit-tested only where it is pure: extent
# clamping, memory-type search, format mapping, barrier masks, frame rotation,
# slot arithmetic, pipeline cache keys. The parts that talk to a driver, which is
# most of the code, have no coverage at all in CI because CI has no GPU.
#
# This runs them, through the same surface a game uses. It opens a window,
# creates a Renderer, builds geometry and a texture in memory, then draws real
# frames: a 3D mesh into an offscreen target, that target composited back to the
# window, and a sprite on top. Every path a game touches is exercised, including
# the three pipelines and the offscreen suspend and resume. It reports what it
# found and exits non-zero on any failure, so it is a check and not a demo.
#
# IT READS THE PIXELS BACK. Presenting a frame proves every call succeeded; it
# proves nothing about what was drawn. A pipeline with its winding backwards
# culls every face and a projection built for the wrong clip volume puts every
# vertex outside it, and both present frames that look correct from the API's
# side. So the last frame renders into a small offscreen target which is copied
# back to host memory and checked: that the cube covers the middle and not the
# corners, that its silhouette lands where projecting its eight corners through
# the same camera says it should, and that the checkerboard is actually sampled.
#
# The silhouette bounds are COMPUTED FROM THE CAMERA, not written down. A
# hardcoded pixel rectangle would be a record of one render rather than a check
# on the next, since whoever wrote it would have read it off the same output.
#
# What that does and does not prove is worth being exact about. Projecting the
# corners here uses the same matrices the draw used, so a projection that is
# wrong in the same way in both places still agrees: dropping the aspect ratio
# from mat4_perspective moves the silhouette and moves the prediction with it,
# and this reports a pass. The matrices themselves are what the unit tests in
# boom.math cover. What this adds is that the rasterizer, the vertex stage, the
# viewport, and the uniform upload all agree with those matrices, which no unit
# test can reach, plus the covered area, which does not depend on the projection
# at all and is what catches a face that was culled.
#
# WHAT IS STILL NOT CHECKED. Depth testing: the cube is convex and back faces are
# culled, so no fragment is ever hidden by another and an inverted depth test
# draws the same picture. Lighting, beyond that the surface is not black. And the
# window itself, since only the offscreen target is read back. Look at the window
# for those.
#
# WHY IT DRIVES THE RENDERER AND NOT THE MODULES BELOW IT. An earlier version
# built the instance, swapchain and frame loop by hand. That tested a path no
# game takes and drifted from the real one every time the renderer changed. What
# is worth knowing is whether the thing a game calls works.
#
# NO FILES ARE READ. Geometry, the texture, and the shaders all come from memory
# or from the embedded SPIR-V, so the test can run from any directory and a
# failure is never a missing asset.
#
# It is not part of CI. Run it on a machine with a working GPU:
#
#   mach dep pull && mach build . && ./out/*/debug/bin/vulkan
#
# A machine whose driver cannot initialize reports that and exits non-zero,
# which is the correct outcome and not a pass. Confirm with an independent probe
# before blaming this: an ICD present in /usr/share/vulkan/icd.d and device nodes
# in /dev do not mean vkEnumeratePhysicalDevices will succeed.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.runtime;
use p: std.print;
use boom.window.Window;
use boom.window.window_open;
use boom.window.window_is_valid;
use boom.window.window_should_close;
use boom.window.window_poll;
use boom.window.window_close;
use boom.window.window_refresh_size;
use gfx: boom.graphics;
use gm:  boom.math;

val WIDTH:  i32 = 640;
val HEIGHT: i32 = 360;

# The offscreen target the verification frame renders into.
#
# Small, because it is copied to host memory and the buffer is a local. The same
# aspect ratio as the window, so one camera serves both and the projection under
# test is the one the window frames used.
val CHECK_W: i32 = 160;
val CHECK_H: i32 = 90;
# CHECK_W * CHECK_H * 4. Written out because an array length must be a literal;
# check_bytes asserts the three agree.
val CHECK_BYTES: usize = 57600;

# A pixel of the verification clear colour, so a covered pixel is distinguishable
# from an uncovered one by hue rather than by brightness. The cube is grey under
# a white light at every texel, and the clear is pure blue, so red above a floor
# means a fragment landed there whatever the lighting did. A dark clear colour
# and a dark texel are not separable that way, and the dark half of a
# checkerboard is exactly what would then read as background.
val CLEAR_R: f32 = 0.0;
val CLEAR_G: f32 = 0.0;
val CLEAR_B: f32 = 0.5;
# Red above this means a fragment was rasterized here. The clear contributes
# exactly zero red, so any floor above sampling noise works; this one is far
# above the darkest texel's contribution and far below the lightest.
val COVERED_R: u8 = 16;

# How many frames to present before declaring success.
#
# More than MAX_FRAMES_IN_FLIGHT, so the frame fences are actually waited on and
# a slot reused, which is where a synchronization mistake shows. A count in the
# hundreds also gives a resize somewhere to land.
val FRAMES: usize = 240;

# Report a failed step and say which one.
fun fail(step: str, r: Result[bool, gfx.Error]) bool {
    if (!is_err[bool, gfx.Error](r)) { ret false; }
    var e: gfx.Error = unwrap_err[bool, gfx.Error](r);
    p.printlnf("FAIL {}: {}", step, gfx.error_msg(?e));
    ret true;
}

# A unit cube's 24 vertices in the canonical standard layout.
#
# Built in code rather than loaded, so the test exercises the upload path with
# geometry whose every value is known here. Six faces of four vertices, each face
# with its own normal so the lighting is flat rather than smoothed.
#
# THE IN-PLANE AXES ARE TABULATED, NOT DERIVED. Each face needs u and v with
# u cross v equal to its normal; that is what makes the corner order
# (-1,-1) (1,-1) (1,1) (-1,1) wind counter-clockwise as seen from outside, which
# after boom's Y flip reaches the rasterizer as the clockwise front face
# boom.graphics.pipeline expects. Picking u and v by which component of the
# normal is non-zero gets three of the six faces backwards, and those three are
# then culled: the cube still draws, still presents, and is simply hollow from
# half its angles. Nothing here would report that, which is exactly why the
# axes are written out where they can be checked by reading.
fun build_cube(verts: *f32, indices: *u32) {
    # Per face: normal, then u, then v, with u cross v equal to the normal.
    var axes: [54]f32;
    #            nx        ny        nz        ux        uy        uz        vx        vy        vz
    # +Z: X cross Y = Z
    axes[0]  = 0.0;  axes[1]  = 0.0;  axes[2]  = 1.0;
    axes[3]  = 1.0;  axes[4]  = 0.0;  axes[5]  = 0.0;
    axes[6]  = 0.0;  axes[7]  = 1.0;  axes[8]  = 0.0;
    # -Z: (-X) cross Y = -Z
    axes[9]  = 0.0;  axes[10] = 0.0;  axes[11] = 0.0 - 1.0;
    axes[12] = 0.0 - 1.0; axes[13] = 0.0; axes[14] = 0.0;
    axes[15] = 0.0;  axes[16] = 1.0;  axes[17] = 0.0;
    # +X: Y cross Z = X
    axes[18] = 1.0;  axes[19] = 0.0;  axes[20] = 0.0;
    axes[21] = 0.0;  axes[22] = 1.0;  axes[23] = 0.0;
    axes[24] = 0.0;  axes[25] = 0.0;  axes[26] = 1.0;
    # -X: Z cross Y = -X
    axes[27] = 0.0 - 1.0; axes[28] = 0.0; axes[29] = 0.0;
    axes[30] = 0.0;  axes[31] = 0.0;  axes[32] = 1.0;
    axes[33] = 0.0;  axes[34] = 1.0;  axes[35] = 0.0;
    # +Y: Z cross X = Y
    axes[36] = 0.0;  axes[37] = 1.0;  axes[38] = 0.0;
    axes[39] = 0.0;  axes[40] = 0.0;  axes[41] = 1.0;
    axes[42] = 1.0;  axes[43] = 0.0;  axes[44] = 0.0;
    # -Y: X cross Z = -Y
    axes[45] = 0.0;  axes[46] = 0.0 - 1.0; axes[47] = 0.0;
    axes[48] = 1.0;  axes[49] = 0.0;  axes[50] = 0.0;
    axes[51] = 0.0;  axes[52] = 0.0;  axes[53] = 1.0;

    var f: usize = 0;
    for (f < 6) {
        val b: usize = f * 9;
        val nx: f32 = axes[b];     val ny: f32 = axes[b + 1]; val nz: f32 = axes[b + 2];
        val ux: f32 = axes[b + 3]; val uy: f32 = axes[b + 4]; val uz: f32 = axes[b + 5];
        val vx: f32 = axes[b + 6]; val vy: f32 = axes[b + 7]; val vz: f32 = axes[b + 8];

        var c: usize = 0;
        for (c < 4) {
            # Corner signs: (-1,-1), (1,-1), (1,1), (-1,1).
            var su: f32 = 0.0 - 1.0;
            var sv: f32 = 0.0 - 1.0;
            if (c == 1) { su = 1.0;       sv = 0.0 - 1.0; }
            if (c == 2) { su = 1.0;       sv = 1.0; }
            if (c == 3) { su = 0.0 - 1.0; sv = 1.0; }

            val base: usize = (f * 4 + c) * 8;
            verts[base]     = (nx + su * ux + sv * vx) * 0.5;
            verts[base + 1] = (ny + su * uy + sv * vy) * 0.5;
            verts[base + 2] = (nz + su * uz + sv * vz) * 0.5;
            verts[base + 3] = nx;
            verts[base + 4] = ny;
            verts[base + 5] = nz;
            verts[base + 6] = (su + 1.0) * 0.5;
            verts[base + 7] = (sv + 1.0) * 0.5;
            c = c + 1;
        }

        val vi: u32 = (f * 4)::u32;
        val ii: usize = f * 6;
        indices[ii]     = vi;
        indices[ii + 1] = vi + 1;
        indices[ii + 2] = vi + 2;
        indices[ii + 3] = vi;
        indices[ii + 4] = vi + 2;
        indices[ii + 5] = vi + 3;
        f = f + 1;
    }
}

# An 8x8 checkerboard in RGBA, so a texturing mistake is visible rather than
# plausible: a solid colour would look correct with the UVs wrong.
fun build_checker(px: *u8) {
    var y: usize = 0;
    for (y < 8) {
        var x: usize = 0;
        for (x < 8) {
            var v: u8 = 40;
            if (((x + y) % 2) == 0) { v = 220; }
            val i: usize = (y * 8 + x) * 4;
            px[i]     = v;
            px[i + 1] = v;
            px[i + 2] = v;
            px[i + 3] = 255;
            x = x + 1;
        }
        y = y + 1;
    }
}

# The pixel a cube corner projects to, through the camera under test.
#
# The full 4x4 transform including the perspective divide.
# boom.math.mat4_transform_point drops w, which is fine for a model or a view
# matrix and wrong for a projection, so the divide is done here.
#
# The NDC-to-pixel mapping has no Y flip in it. boom's projection already puts Y
# increasing downward, matching Vulkan's framebuffer, so flipping again here
# would make this predict a mirrored silhouette and agree with a renderer that
# had the same mistake twice.
fun project(vp: *gm.Mat4, x: f32, y: f32, z: f32, out_x: *f32, out_y: *f32) {
    val cx: f32 = vp.m[0] * x + vp.m[4] * y + vp.m[8]  * z + vp.m[12];
    val cy: f32 = vp.m[1] * x + vp.m[5] * y + vp.m[9]  * z + vp.m[13];
    val cw: f32 = vp.m[3] * x + vp.m[7] * y + vp.m[11] * z + vp.m[15];
    @out_x = ((cx / cw) * 0.5 + 0.5) * CHECK_W::f32;
    @out_y = ((cy / cw) * 0.5 + 0.5) * CHECK_H::f32;
}

# The area of the convex hull of n points, in square pixels.
#
# WHY AN AREA AND NOT A PIXEL COUNT WRITTEN DOWN. The silhouette of a closed
# convex mesh is filled exactly once by its front faces, so the covered pixel
# count has a value derivable from the geometry, and a count that falls short
# means some front face was culled. A constant here would have been read off a
# render and would agree with a culled render as readily as a correct one. This
# is the check that found frontFace set to clockwise, where the cube kept its
# outline and lost faces inside it.
#
# Gift wrapping, because eight points do not justify anything cleverer. Start at
# the leftmost point and repeatedly take the point that leaves every other on one
# side, then close with the shoelace formula.
fun hull_area(xs: *f32, ys: *f32, n: usize) f32 {
    if (n < 3) { ret 0.0; }

    var start: usize = 0;
    var i: usize = 1;
    for (i < n) {
        if (xs[i] < xs[start]) { start = i; }
        i = i + 1;
    }

    var hx: [8]f32;
    var hy: [8]f32;
    var count: usize = 0;
    var cur: usize = start;
    var guard: usize = 0;
    for (guard < n) {
        hx[count] = xs[cur];
        hy[count] = ys[cur];
        count = count + 1;

        var next: usize = 0;
        if (cur == 0) { next = 1; }
        var k: usize = 0;
        for (k < n) {
            # The cross product of (next - cur) and (k - cur). Positive means k
            # is to the left, so k becomes the better candidate.
            val cross: f32 = (xs[next] - xs[cur]) * (ys[k] - ys[cur])
                           - (ys[next] - ys[cur]) * (xs[k] - xs[cur]);
            if (cross > 0.0) { next = k; }
            k = k + 1;
        }
        cur = next;
        if (cur == start) { guard = n; }
        or { guard = guard + 1; }
    }

    var twice: f32 = 0.0;
    var j: usize = 0;
    for (j < count) {
        var nx: usize = j + 1;
        if (nx == count) { nx = 0; }
        twice = twice + (hx[j] * hy[nx] - hx[nx] * hy[j]);
        j = j + 1;
    }
    if (twice < 0.0) { twice = 0.0 - twice; }
    ret twice * 0.5;
}

# The absolute difference of two f32.
fun fabs(x: f32) f32 {
    if (x < 0.0) { ret 0.0 - x; }
    ret x;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var w: Window = window_open(WIDTH, HEIGHT, "boom renderer smoke");
    if (!window_is_valid(?w)) {
        p.println("FAIL window_open: could not open a window");
        ret 1;
    }
    p.println("ok   window");

    var r: gfx.Renderer;
    if (fail("renderer_init", gfx.renderer_init(?r, w.handle, WIDTH, HEIGHT))) { ret 1; }
    p.println("ok   renderer: instance, surface, device, swapchain, frame loop, descriptors");

    # Not a failure: a surface offering no sRGB format still renders, just
    # darker than authored. Saying so keeps it from being diagnosed as a
    # shader or a texture problem.
    if (gfx.renderer_is_srgb(?r)) {
        p.println("ok   surface encodes sRGB, so the colour pipeline is complete");
    }
    or {
        p.println("NOTE surface offers no sRGB format; output will be darker than authored");
    }

    val d: *gfx.Device = gfx.renderer_device(?r);

    var verts:   [192]f32;
    var indices: [36]u32;
    build_cube(?verts[0], ?indices[0]);
    var fmt: gfx.VertexFormat = gfx.vertex_format_standard();
    val mr: Result[gfx.Mesh, gfx.Error] = gfx.mesh(d, (?verts[0])::ptr, 24, ?fmt, ?indices[0], 36);
    if (is_err[gfx.Mesh, gfx.Error](mr)) {
        var e: gfx.Error = unwrap_err[gfx.Mesh, gfx.Error](mr);
        p.printlnf("FAIL mesh: {}", gfx.error_msg(?e));
        ret 1;
    }
    var mesh: gfx.Mesh = unwrap_ok[gfx.Mesh, gfx.Error](mr);
    p.println("ok   mesh uploaded through a staging copy");

    var px: [256]u8;
    build_checker(?px[0]);
    val tr: Result[gfx.Texture, gfx.Error] = gfx.texture(d, ?px[0], 8, 8, gfx.COLOR_SRGB);
    if (is_err[gfx.Texture, gfx.Error](tr)) {
        var e: gfx.Error = unwrap_err[gfx.Texture, gfx.Error](tr);
        p.printlnf("FAIL texture: {}", gfx.error_msg(?e));
        ret 1;
    }
    var tex: gfx.Texture = unwrap_ok[gfx.Texture, gfx.Error](tr);
    p.println("ok   texture staged and transitioned for sampling");

    var mat: gfx.Material = gfx.material();
    gfx.material_add_texture(?mat, "u_texture0", ?tex);

    val gr: Result[gfx.RenderTarget, gfx.Error] = gfx.render_target(d, WIDTH, HEIGHT);
    if (is_err[gfx.RenderTarget, gfx.Error](gr)) {
        var e: gfx.Error = unwrap_err[gfx.RenderTarget, gfx.Error](gr);
        p.printlnf("FAIL render_target: {}", gfx.error_msg(?e));
        ret 1;
    }
    var target: gfx.RenderTarget = unwrap_ok[gfx.RenderTarget, gfx.Error](gr);
    p.println("ok   offscreen target: colour, depth, pass, framebuffer");

    var cam: gfx.Camera = gfx.camera_perspective(
        gm.vec3(0.0, 1.2, 3.0), gm.vec3(0.0, 0.0, 0.0),
        gm.radians(60.0), WIDTH::f32 / HEIGHT::f32, 0.1, 100.0);
    var xf: gm.Transform = gm.transform_identity();

    var spin:      f32 = 0.0;
    var presented: usize = 0;
    var skipped:   usize = 0;
    var dropped:   usize = 0;
    var n: usize = 0;
    for (n < FRAMES) {
        window_poll();
        window_refresh_size(?w);
        if (window_should_close(?w)) { n = FRAMES; }
        or {
            spin = spin + 0.02;
            xf.rotation = gm.quat_from_axis_angle(gm.vec3(0.3, 1.0, 0.15), spin);

            var opened: bool = false;
            if (fail("renderer_begin_frame", gfx.renderer_begin_frame(?r, ?opened))) { ret 1; }

            if (!opened) {
                # Out of date, which a resize causes and which is not an error.
                # The renderer has already rebuilt; this frame is simply skipped.
                skipped = skipped + 1;
            }
            or {
                var scene: gfx.PassDesc = gfx.pass_scene(?cam);
                scene.target      = ?target;
                scene.clear       = 1;
                scene.clear_color = gm.vec4(0.05, 0.06, 0.09, 1.0);
                var sp: gfx.Pass = gfx.pass_begin(?r, ?scene);
                gfx.pass_draw_material(?sp, ?mesh, ?mat, ?xf);
                gfx.pass_end(?sp);

                var over: gfx.PassDesc = gfx.pass_overlay();
                var op: gfx.Pass = gfx.pass_begin(?r, ?over);
                gfx.pass_draw_sprite(?op, gfx.render_target_texture(?target),
                                     gfx.rect(0.0, 0.0, WIDTH::f32, HEIGHT::f32),
                                     gm.vec4(1.0, 1.0, 1.0, 1.0));
                gfx.pass_draw_sprite(?op, ?tex, gfx.rect(8.0, 8.0, 64.0, 64.0),
                                     gm.vec4(1.0, 1.0, 1.0, 1.0));
                gfx.pass_end(?op);

                dropped = dropped + gfx.renderer_dropped(?r);
                if (fail("renderer_end_frame", gfx.renderer_end_frame(?r))) { ret 1; }
                presented = presented + 1;
            }
            n = n + 1;
        }
    }

    p.printlnf("ok   ran {} frames, {} skipped for a swapchain rebuild", presented, skipped);

    # ------------------------------------------------------- what was drawn
    #
    # Everything above proves the calls succeeded. This is the part that proves
    # a picture came out of them.
    if (CHECK_W::usize * CHECK_H::usize * 4 != CHECK_BYTES) {
        p.println("FAIL check: CHECK_BYTES does not match the check target's size");
        ret 1;
    }

    val kr: Result[gfx.RenderTarget, gfx.Error] = gfx.render_target(d, CHECK_W, CHECK_H);
    if (is_err[gfx.RenderTarget, gfx.Error](kr)) {
        var e: gfx.Error = unwrap_err[gfx.RenderTarget, gfx.Error](kr);
        p.printlnf("FAIL check target: {}", gfx.error_msg(?e));
        ret 1;
    }
    var check: gfx.RenderTarget = unwrap_ok[gfx.RenderTarget, gfx.Error](kr);

    # A known orientation, so the silhouette is predictable. The frames above
    # spun the cube precisely so that a mistake visible from only some angles
    # would show; this one is deliberately still.
    xf.rotation = gm.quat_identity();

    # Retry, because a frame is skipped when the swapchain is out of date and a
    # skipped frame renders nothing to read back.
    var drew: bool = false;
    var tries: usize = 0;
    for (tries < 8 && !drew) {
        window_poll();
        window_refresh_size(?w);
        var opened: bool = false;
        if (fail("renderer_begin_frame", gfx.renderer_begin_frame(?r, ?opened))) { ret 1; }
        if (opened) {
            var scene: gfx.PassDesc = gfx.pass_scene(?cam);
            scene.target      = ?check;
            scene.clear       = 1;
            scene.clear_color = gm.vec4(CLEAR_R, CLEAR_G, CLEAR_B, 1.0);
            var sp: gfx.Pass = gfx.pass_begin(?r, ?scene);
            gfx.pass_draw_material(?sp, ?mesh, ?mat, ?xf);
            gfx.pass_end(?sp);
            if (fail("renderer_end_frame", gfx.renderer_end_frame(?r))) { ret 1; }
            drew = true;
        }
        tries = tries + 1;
    }
    if (!drew) {
        p.println("FAIL check: the swapchain never came back to draw the check frame");
        ret 1;
    }

    var shot: [57600]u8;
    if (fail("render_target_read", gfx.render_target_read(d, ?check, ?shot[0], CHECK_BYTES))) {
        ret 1;
    }

    # The red channel's byte offset. The colour attachment is in the surface's
    # format, so on most drivers it comes back blue first. Guessing gets a
    # picture with red and blue swapped and every check below reading the wrong
    # channel.
    var red: usize = 0;
    if (gfx.render_target_bgra(?check)) { red = 2; }

    var covered:  usize = 0;
    var min_x: i32 = CHECK_W;
    var max_x: i32 = 0 - 1;
    var min_y: i32 = CHECK_H;
    var max_y: i32 = 0 - 1;
    var lo: u8 = 255;
    var hi: u8 = 0;
    var py: i32 = 0;
    for (py < CHECK_H) {
        var px_i: i32 = 0;
        for (px_i < CHECK_W) {
            val o: usize = (py::usize * CHECK_W::usize + px_i::usize) * 4;
            val rv: u8 = shot[o + red];
            if (rv > COVERED_R) {
                covered = covered + 1;
                if (px_i < min_x) { min_x = px_i; }
                if (px_i > max_x) { max_x = px_i; }
                if (py < min_y)   { min_y = py; }
                if (py > max_y)   { max_y = py; }
                if (rv < lo) { lo = rv; }
                if (rv > hi) { hi = rv; }
            }
            px_i = px_i + 1;
        }
        py = py + 1;
    }

    if (covered == 0) {
        p.println("FAIL check: nothing was rasterized; every fragment was culled or clipped");
        gfx.render_target_delete(d, ?check);
        ret 1;
    }

    # Where the eight corners of the cube land, through the same camera the draw
    # used. The model transform is the identity, so the corners are the cube's
    # own, at plus and minus a half unit.
    var view: gm.Mat4 = gfx.camera_view(?cam);
    var proj: gm.Mat4 = gfx.camera_projection(?cam);
    var vp:   gm.Mat4 = gm.mat4_mul(?proj, ?view);
    var want_min_x: f32 = CHECK_W::f32;
    var want_max_x: f32 = 0.0;
    var want_min_y: f32 = CHECK_H::f32;
    var want_max_y: f32 = 0.0;
    var corner_x: [8]f32;
    var corner_y: [8]f32;
    var corner: usize = 0;
    for (corner < 8) {
        var cxv: f32 = 0.0 - 0.5;
        var cyv: f32 = 0.0 - 0.5;
        var czv: f32 = 0.0 - 0.5;
        if ((corner & 1) != 0) { cxv = 0.5; }
        if ((corner & 2) != 0) { cyv = 0.5; }
        if ((corner & 4) != 0) { czv = 0.5; }
        var sx: f32 = 0.0;
        var sy: f32 = 0.0;
        project(?vp, cxv, cyv, czv, ?sx, ?sy);
        corner_x[corner] = sx;
        corner_y[corner] = sy;
        if (sx < want_min_x) { want_min_x = sx; }
        if (sx > want_max_x) { want_max_x = sx; }
        if (sy < want_min_y) { want_min_y = sy; }
        if (sy > want_max_y) { want_max_y = sy; }
        corner = corner + 1;
    }

    # A cube is convex, so the bounding box of its silhouette is the bounding box
    # of its projected corners. Two pixels of slack covers the difference between
    # a corner's exact position and the last pixel centre the rasterizer covers.
    val SLACK: f32 = 2.0;
    var off: bool = false;
    if (fabs(min_x::f32 - want_min_x) > SLACK) { off = true; }
    if (fabs(max_x::f32 - want_max_x) > SLACK) { off = true; }
    if (fabs(min_y::f32 - want_min_y) > SLACK) { off = true; }
    if (fabs(max_y::f32 - want_max_y) > SLACK) { off = true; }
    if (off) {
        p.printlnf("FAIL check: the cube covers x {}..{} y {}..{} in pixels",
                   min_x, max_x, min_y, max_y);
        p.printlnf("      projecting its corners through the same camera says x {}..{} y {}..{}",
                   want_min_x::i32, want_max_x::i32, want_min_y::i32, want_max_y::i32);
        p.println("      A silhouette in the wrong place is the projection, the Y flip,");
        p.println("      or the viewport; one mirrored in Y is the flip alone.");
        gfx.render_target_delete(d, ?check);
        ret 1;
    }
    p.printlnf("ok   {} pixels covered, silhouette within {} px of the projected corners",
               covered, SLACK::i32);

    # The silhouette of a closed convex mesh is filled exactly once by its front
    # faces, so the covered count is the hull's area. Short of it means faces are
    # missing from inside an outline that still looks right, which is what a
    # reversed front-face winding does and what the bounds above cannot see: the
    # faces behind the culled ones are drawn instead and reach the same extremes.
    val area: f32 = hull_area(?corner_x[0], ?corner_y[0], 8);
    val ratio: f32 = covered::f32 / area;
    if (ratio < 0.9 || ratio > 1.1) {
        p.printlnf("FAIL check: {} pixels covered against a projected hull of {}",
                   covered, area::i32);
        p.println("      Short of the hull means front faces were culled: the front-face");
        p.println("      winding, or a mesh whose faces are not consistently wound.");
        p.println("      Over it means something drew outside the silhouette.");
        gfx.render_target_delete(d, ?check);
        ret 1;
    }
    p.printlnf("ok   the covered area matches the projected hull's {} px", area::i32);

    # The corners of the image must be background. A silhouette that filled the
    # whole target would satisfy the bounds above only by accident, and this is
    # the cheap direct statement that it did not.
    var edge: usize = 0;
    for (edge < 4) {
        var ex: usize = 0;
        var ey: usize = 0;
        if ((edge & 1) != 0) { ex = (CHECK_W - 1)::usize; }
        if ((edge & 2) != 0) { ey = (CHECK_H - 1)::usize; }
        val o: usize = (ey * CHECK_W::usize + ex) * 4;
        if (shot[o + red] > COVERED_R) {
            p.println("FAIL check: a corner of the image is covered; the clear did not happen");
            gfx.render_target_delete(d, ?check);
            ret 1;
        }
        edge = edge + 1;
    }
    p.println("ok   the clear colour survives where no geometry covers it");

    # The checkerboard has a light half and a dark half, so a covered area of one
    # brightness means the texture was not sampled: a missing descriptor, a
    # constant UV, or a white fallback all look like a correctly lit solid.
    if (hi - lo < 40) {
        p.printlnf("FAIL check: covered pixels run {} to {}; the checkerboard was not sampled", lo, hi);
        gfx.render_target_delete(d, ?check);
        ret 1;
    }
    p.printlnf("ok   the checkerboard is sampled: covered pixels run {} to {}", lo, hi);

    gfx.render_target_delete(d, ?check);

    # Teardown order is part of what is being checked: everything created against
    # the device goes before the renderer that owns it, and destroying anything
    # the GPU is still reading is what the validation layers exist to catch.
    gfx.render_target_delete(d, ?target);
    gfx.texture_delete(d, ?tex);
    gfx.mesh_delete(d, ?mesh);
    gfx.renderer_dnit(?r);
    window_close(?w);
    p.println("ok   teardown");

    if (presented == 0) {
        p.println("FAIL: no frame was presented");
        ret 1;
    }
    # A dropped draw is otherwise invisible: the thing simply does not appear, so
    # a frame that drew nothing would still count as presented.
    if (dropped != 0) {
        p.printlnf("FAIL: {} draws were dropped for want of a uniform slot", dropped);
        ret 1;
    }
    p.println("PASS: frames were presented and the rendered pixels were checked");
    p.println("     Depth testing and lighting are still not covered: the cube is");
    p.println("     convex with back faces culled, so nothing is ever occluded.");
    p.println("     The window itself is not read back either. Look at it: a lit");
    p.println("     checkered cube filling most of it, with a small checker square");
    p.println("     at the top left.");
    ret 0;
}
