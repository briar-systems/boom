# Finite ownership check for font_from_bytes.
#
# The encoded file is released before the first draw. A pass therefore proves
# the returned Font owns both its glyph metrics and uploaded atlas rather than
# retaining a pointer into the caller's byte buffer.

use boom.app.App;
use boom.context.Config;
use boom.context.Context;
use boom.context.ContextError;
use boom.context.context_error_message;
use boom.context.context_fail;
use boom.context.context_init;
use boom.context.context_set_user;
use boom.context.context_shutdown;
use boom.context.context_user;
use boom.engine.EngineError;
use boom.engine.engine_error_message;
use boom.engine.run;
use gfx: boom.graphics;
use gm:  boom.math;
use boom.window.WindowMode;
use allo: std.allocator;
use std.allocator.page;
use std.chrono.duration.MILLISECOND;
use std.chrono.duration.SECOND;
use std.collections.vector;
use fs: std.filesystem;
use std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

rec Check {
    a:           allo.Allocator;
    renderer:    gfx.Renderer;
    font:        gfx.Font;
    renderer_ok: bool;
    font_ok:     bool;
    drawn:       usize;
}

var FONT_PATH: str = "";

fun on_init(ctx: *Context) {
    val c: *Check = context_user(ctx)::*Check;
    c.renderer_ok = false;
    c.font_ok     = false;
    c.drawn       = 0;
    val made: err[allo.Error] = page.make(?c.a);
    if (sel made.err) {
        print.eprintln("could not make the page allocator");
        context_fail(ctx, 1);
        ret;
    }

    val rr: err[gfx.Error] = gfx.renderer_init(?c.renderer, ?ctx.window);
    if (sel rr.err) {
        print.eprintlnf("renderer init error: {}", gfx.error_message(rr.err));
        context_fail(ctx, 1);
        ret;
    }
    c.renderer_ok = true;

    val br: res[vector.Vector[u8], fs.FsError] = fs.read_bytes(?c.a, FONT_PATH);
    if (sel br.err) {
        print.eprintlnf("font fixture read error: {}", FONT_PATH);
        context_fail(ctx, 1);
        ret;
    }
    var bytes: vector.Vector[u8]        = br.ok;
    val fr:    res[gfx.Font, gfx.Error] = gfx.font_from_bytes(
        ?c.a, gfx.renderer_device(?c.renderer), bytes.data, bytes.len, 18.0);

    # The source lifetime ends here, before metrics are inspected or the atlas
    # is sampled by a draw.
    val released: err[allo.Error] = vector.dnit[u8](?bytes);
    if (sel fr.err) {
        print.eprintlnf("font bytes error: {}", gfx.error_message(fr.err));
        context_fail(ctx, 1);
        ret;
    }
    c.font    = fr.ok;
    c.font_ok = true;
    if (sel released.err) {
        print.eprintln("the encoded font bytes could not be released");
        context_fail(ctx, 1);
        ret;
    }
    if (gfx.text_measure(?c.font, "borrowed bytes") <= 0.0) {
        print.eprintln("font metrics did not survive their encoded source");
        context_fail(ctx, 1);
    }
}

fun on_tick(ctx: *Context) {}

fun on_draw(ctx: *Context) {
    val c: *Check = context_user(ctx)::*Check;
    if (!c.font_ok) {
        context_fail(ctx, 1);
        ret;
    }

    val br: res[bool, gfx.Error] = gfx.renderer_begin_frame(?c.renderer);
    if (sel br.err) {
        print.eprintlnf("begin frame error: {}", gfx.error_message(br.err));
        context_fail(ctx, 1);
        ret;
    }
    if (!br.ok) { ret; }

    var desc: gfx.PassDesc = gfx.pass_overlay();
    desc.clear = opt[gm.Vec4].some{gm.vec4(0.02, 0.02, 0.03, 1.0)};
    var pass: gfx.Pass = gfx.pass_begin(?c.renderer, ?desc);
    gfx.text_draw(?pass, ?c.font, "borrowed bytes", 16.0, 16.0,
        gm.vec4(1.0, 1.0, 1.0, 1.0));
    gfx.pass_end(?pass);

    val er: err[gfx.Error] = gfx.renderer_end_frame(?c.renderer);
    if (sel er.err) {
        print.eprintlnf("end frame error: {}", gfx.error_message(er.err));
        context_fail(ctx, 1);
        ret;
    }
    c.drawn = c.drawn + 1;
    if (c.drawn == 2) { ctx.running = false; }
}

fun on_dnit(ctx: *Context) {
    val c: *Check = context_user(ctx)::*Check;
    if (c.font_ok) {
        gfx.font_delete(gfx.renderer_device(?c.renderer), ?c.font);
        c.font_ok = false;
    }
    if (c.renderer_ok) {
        gfx.renderer_dnit(?c.renderer);
        c.renderer_ok = false;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var argi: i64 = 1;
    for (argi < argc) {
        if (str_equals(argv[argi]:~str, "--font") && argi + 1 < argc) {
            FONT_PATH = argv[argi + 1]:~str;
            argi      = argi + 1;
        }
        argi = argi + 1;
    }
    if (FONT_PATH == nil || str_equals(FONT_PATH, "")) {
        print.eprintln("usage: text --font PATH.ttf");
        ret 1;
    }

    var check: Check;
    var app:   App;
    app.f_init = on_init;
    app.f_tick = on_tick;
    app.f_draw = on_draw;
    app.f_dnit = on_dnit;

    var ctx: Context;
    val cfg: Config = Config{
        width:     320,
        height:    120,
        title:     "boom.graphics: borrowed font bytes",
        fixed_dt:  SECOND / 60,
        max_frame: 250 * MILLISECOND,
        frame_dt:  SECOND / 60,
        mode:      WindowMode.windowed{},
    };
    val started: err[ContextError] = context_init(?ctx, cfg);
    if (sel started.err) {
        print.eprintlnf("could not start: {}", context_error_message(started.err));
        ret 1;
    }
    context_set_user(?ctx, (?check)::ptr);
    val ran: res[i64, EngineError] = run(?ctx, ?app);
    context_shutdown(?ctx);
    if (sel ran.err) {
        print.eprintlnf("the frame loop stopped: {}", engine_error_message(ran.err));
        ret 1;
    }
    if (ran.ok != 0) { ret ran.ok; }

    if (check.drawn != 2) {
        print.eprintlnf("font check drew {} of 2 frames", check.drawn);
        ret 1;
    }
    print.println("PASS: borrowed font bytes were released before atlas use");
    ret 0;
}
