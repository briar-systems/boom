# Directional-light fragment shader.
#
# Ported from the GLSL string in examples/animation. It carries no texture
# because SPIR-V has no sampler binding yet (mach#2794), so this is the shader
# that proves the pipeline rather than the one that draws a sprite.

use sh: shader.math;

#[input(0)]  var in_normal: f32x4;
#[output(0)] var out_colour: f32x4;

#[stage("fragment")]
fun frag_main() {
    val n: f32x4 = sh.normalize(in_normal);
    val l: f32x4 = sh.normalize(f32x4{0.4, 1.0, 0.6, 0.0});
    var d: f32   = sh.dot(n, l);
    if (d < 0.0) { d = 0.0; }
    val k: f32   = 0.25 + 0.75 * d;
    out_colour = f32x4{0.70 * k, 0.75 * k, 0.92 * k, 1.0};
}
