# Sprite fragment stage.
#
# Samples the atlas and multiplies by a tint. Text uses the same shader: the
# glyph atlas stores coverage in alpha with RGB left white, so tinting a glyph
# and tinting a sprite are the same operation.

use sh: shader.math;

#[spirv_op("core", "OpImageSampleImplicitLod")]
fun sample(s: sampler2d, uv: f32x2) f32x4;

#[sampler(0, 1)] var atlas: sampler2d;

rec Tint {
    colour: f32x4;
}
#[uniform(0, 2)] var tint: Tint;

#[input(0)]  var in_uv:      f32x2;
#[output(0)] var out_colour: f32x4;

#[stage("fragment")]
fun frag_main() {
    out_colour = sample(atlas, in_uv) * tint.colour;
}
