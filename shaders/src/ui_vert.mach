# Immediate-mode vertex stage: a stream of already-placed, coloured triangles.
#
# WHY THIS IS NOT THE SPRITE STAGE. A sprite is a unit quad placed by a model
# matrix, so its geometry lives in a uniform and one vertex buffer serves every
# draw. That works because a sprite is a rectangle and there is one per draw.
#
# An immediate-mode UI, a particle system, or a debug overlay produces the
# opposite shape: thousands of triangles that are already in the right place,
# each with its own colour, all of which must reach the GPU in one draw. There is
# no per-draw model matrix to put them in and no fixed geometry to reuse. So the
# positions arrive in the vertex buffer, in pixels, and the only uniform is the
# projection that maps pixels to clip space.
#
# The colour is per vertex rather than a tint uniform for the same reason: one
# draw covers a whole draw list, and a panel's background, its border and its
# text are different colours inside it.

# The projection, as its four columns. See shaders/src/mesh_vert.mach for why a
# matrix arrives as columns and why the product is a combination of them.
rec Screen {
    projection_0: f32x4;
    projection_1: f32x4;
    projection_2: f32x4;
    projection_3: f32x4;
}

#[uniform(0, 0)] var screen: Screen;

#[input(0)] var in_position: f32x2;
#[input(1)] var in_uv:       f32x2;
#[input(3)] var in_colour:   f32x4;

#[output(0)] var out_uv:     f32x2;
#[output(1)] var out_colour: f32x4;

#[builtin("position")] var position: f32x4;

# Transform a point by a 4x4 matrix given as its four columns.
#
# Duplicated in each vertex stage rather than shared, because a SPIR-V shader
# cannot call a function defined in another module (mach#2823).
fun mul_point(c0: f32x4, c1: f32x4, c2: f32x4, c3: f32x4, p: f32x4) f32x4 {
    ret c0 * f32x4{p[0], p[0], p[0], p[0]}
      + c1 * f32x4{p[1], p[1], p[1], p[1]}
      + c2 * f32x4{p[2], p[2], p[2], p[2]}
      + c3 * f32x4{p[3], p[3], p[3], p[3]};
}

#[stage("vertex")]
fun vert_main() {
    out_uv     = in_uv;
    out_colour = in_colour;
    position   = mul_point(screen.projection_0, screen.projection_1,
                           screen.projection_2, screen.projection_3,
                           f32x4{in_position[0], in_position[1], 0.0, 1.0});
}
