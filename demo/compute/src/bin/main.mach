# A simulation stepped on the GPU and drawn straight from its buffers.
#
# The shape of a GPU cellular automaton, at the smallest size that checks
# itself: a pool of cells in two StorageBuffers, stepped by a Compute stage
# each generation with the source and destination swapped, a per-workgroup
# activity flag the CPU reads back without a stall, and the cells drawn by a
# vertex stage that reads the buffer the step wrote. Nothing but the seed and
# the step's parameters crosses from the CPU, and nothing but the flags
# crosses back.
#
# Two generations run. The first is a direct dispatch that also writes the
# arguments the second dispatch and the draw read indirectly; the second is
# dispatched from them. Each step binds five buffers, one past the four Vulkan
# guarantees, the fifth a rule holding the scale. Each cell is the rule's scale,
# two, times its source plus the generation, so
# after both a cell seeded with i holds 4i + 4, and the host reads the pool back
# and says so. The draw goes into an offscreen target read back afterwards: a
# cell holding 2k + 1 covers a quarter of grid square k, so the red pixel count
# is right only if every value reached the vertex stage. GPU timers bracket the
# first dispatch and the draw, and their durations are taken once the frame has
# finished.
#
# A third frame writes a world of 1150 one-KiB chunks in two batches, the
# second in reverse order and large enough to grow the staging memory under the
# first, and reads the world back: every chunk must hold its own bytes, behind
# one barrier pair per batch.
#
# A fourth frame makes two pools mid-frame, with no wait, as a game growing its
# pool does: it writes one word of the first, steps the first into the second,
# and reads both back. The first must be zero but that word, and the second the
# step of it, so both fills landed before the write and the dispatch.
#
# CI runs it under lavapipe:
#
#   mach build . && xvfb-run -a ./out/linux-x86_64/debug/bin/compute

use gfx: boom.graphics;
use gm:  boom.math;
use boom.window.Window;
use boom.window.WindowError;
use boom.window.window_close;
use boom.window.window_error_message;
use boom.window.window_open;
use boom.window.window_poll;
use allo: std.allocator;
use std.allocator.page;
use std.chrono.duration.Duration;
use p: std.print;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

#[embed("{artifact.stage-step_comp.out}")]
val STEP_SPV:       [_]u8;
#[embed("{artifact.stage-cells_vert.out}")]
val CELLS_VERT_SPV: [_]u8;
#[embed("{artifact.stage-cells_frag.out}")]
val CELLS_FRAG_SPV: [_]u8;

# cells in the pool, and the workgroups of 64 that step it
val CELLS:  usize = 256;
val GROUPS: u32   = 4;

# Control: the draw arguments, the next dispatch's, then one flag per group
val DRAW_AT:  usize = 0;
val NEXT_AT:  usize = 16;
val FLAGS_AT: usize = 32;

# the offscreen target the cells are drawn into, 4 pixels to a grid square
val SIDE:  i32   = 64;
val BYTES: usize = 16384;

# the world the batches write: chunks of CHUNK_WORDS u32
val CHUNKS:      usize = 1150;
val CHUNK_WORDS: usize = 256;

# the one cell of a pool made mid-frame that the frame writes before stepping it
val SEEDED: usize = 5;

fun fail(step: str, r: err[gfx.Error]) bool {
    if (sel r.ok) { ret false; }
    p.printlnf("FAIL {}: {}", step, gfx.error_message(r.err));
    ret true;
}

# Begin a frame, retrying while the swapchain settles.
fun open_frame(r: *gfx.Renderer) bool {
    var tries: usize = 0;
    for (tries < 8) {
        window_poll();
        val br: res[bool, gfx.Error] = gfx.renderer_begin_frame(r);
        if (sel br.err) {
            p.printlnf("FAIL renderer_begin_frame: {}", gfx.error_message(br.err));
            ret false;
        }
        if (br.ok) { ret true; }
        tries = tries + 1;
    }
    p.println("FAIL renderer_begin_frame: the swapchain never settled");
    ret false;
}

fun make(d: *gfx.Device, size: usize, out: *gfx.StorageBuffer) bool {
    val made: res[gfx.StorageBuffer, gfx.Error] = gfx.storage_buffer(d, size);
    if (sel made.err) {
        p.printlnf("FAIL storage_buffer: {}", gfx.error_message(made.err));
        ret false;
    }
    @out = made.ok;
    ret true;
}

# a timer's duration, or -1 when none was handed back
fun took(o: opt[Duration]) Duration {
    if (sel o.some) { ret o.some; }
    ret -1;
}

fun params_for(generation: u32) [4]u32 {
    var q: [4]u32;
    q[0] = generation;
    q[1] = 0;
    q[2] = 0;
    q[3] = 0;
    ret q;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val opened: res[Window, WindowError] = window_open(SIDE, SIDE, "boom compute");
    if (sel opened.err) {
        p.printlnf("FAIL window_open: {}", window_error_message(opened.err));
        ret 1;
    }
    var w: Window = opened.ok;
    var r: gfx.Renderer;
    if (fail("renderer_init", gfx.renderer_init(?r, ?w))) { ret 1; }
    val d: *gfx.Device = gfx.renderer_device(?r);

    # the device's limits are at least what the specification guarantees, and
    # it lets a step and a draw bind the five buffers these do, a dispatch never
    # fewer than a draw
    val lim: gfx.Limits = gfx.renderer_limits(?r);
    if (lim.max_storage_buffer_range < 134217728 || lim.max_compute_work_group_count[0] < 65535
        || lim.max_compute_work_group_invocations < 128
        || lim.max_per_stage_descriptor_storage_buffers < 4
        || lim.max_draw_bindings < 5 || lim.max_dispatch_bindings < lim.max_draw_bindings
        || lim.max_dispatch_bindings > gfx.MAX_STORAGE_BINDINGS) {
        p.printlnf("FAIL renderer_limits: range {} groups {} invocations {} bindings {} dispatch {} draw of {}",
            lim.max_storage_buffer_range, lim.max_compute_work_group_count[0],
            lim.max_compute_work_group_invocations, lim.max_dispatch_bindings, lim.max_draw_bindings,
            lim.max_per_stage_descriptor_storage_buffers);
        ret 1;
    }

    # the pool, seeded with each cell's index
    var a:       gfx.StorageBuffer;
    var b:       gfx.StorageBuffer;
    var control: gfx.StorageBuffer;
    var params:  gfx.StorageBuffer;
    var rule:    gfx.StorageBuffer;
    if (!make(d, CELLS * 4, ?a) || !make(d, CELLS * 4, ?b)
        || !make(d, 48, ?control) || !make(d, 16, ?params) || !make(d, 16, ?rule)) { ret 1; }
    var seed: [256]u32;
    var i:    usize = 0;
    for (i < CELLS) {
        seed[i] = i::u32;
        i       = i + 1;
    }
    if (fail("storage_buffer_upload", gfx.storage_buffer_upload(d, ?a, 0, (?seed[0]):~*u8, CELLS * 4))) { ret 1; }
    var scale: [4]u32 = params_for(2);
    if (fail("storage_buffer_upload", gfx.storage_buffer_upload(d, ?rule, 0, (?scale[0]):~*u8, 16))) { ret 1; }

    var step: gfx.Compute;
    if (fail("compute", gfx.compute(?step, d, ?STEP_SPV[0], $length_of(STEP_SPV)))) { ret 1; }
    var cells: gfx.Shader;
    if (fail("shader", gfx.shader(?cells, ?CELLS_VERT_SPV[0], $length_of(CELLS_VERT_SPV),
        ?CELLS_FRAG_SPV[0], $length_of(CELLS_FRAG_SPV)))) { ret 1; }
    gfx.shader_set_state(?cells, gfx.pipeline_desc_2d());
    var flags: gfx.Readback;
    if (fail("readback", gfx.readback(?flags, d, 16))) { ret 1; }
    val tr: res[gfx.RenderTarget, gfx.Error] = gfx.render_target(d, SIDE, SIDE);
    if (sel tr.err) {
        p.printlnf("FAIL render_target: {}", gfx.error_message(tr.err));
        ret 1;
    }
    var target: gfx.RenderTarget = tr.ok;

    # a device whose queue writes no timestamps says so, and refuses a timer
    var timed:     bool = lim.timestamp_valid_bits != 0;
    var step_time: gfx.GpuTimer;
    var draw_time: gfx.GpuTimer;
    if (timed) {
        if (fail("renderer_timer", gfx.renderer_timer(?r, ?step_time))) { ret 1; }
        if (fail("renderer_timer", gfx.renderer_timer(?r, ?draw_time))) { ret 1; }
    }
    or {
        val none: err[gfx.Error] = gfx.renderer_timer(?r, ?step_time);
        if (!(sel none.err && (sel none.err.renderer && sel none.err.renderer.no_timestamps))) {
            p.println("FAIL renderer_timer: a device without timestamps did not refuse");
            ret 1;
        }
    }
    var mat: gfx.Material = gfx.material();
    var xf:  gm.Transform = gm.transform_identity();

    # generation 1: a direct dispatch from a to b, its flags read back, and the
    # cells drawn from b by the arguments it wrote
    if (!open_frame(?r)) { ret 1; }
    var q: [4]u32 = params_for(1);
    if (fail("renderer_buffer_update", gfx.renderer_buffer_update(?r, ?params, 0, (?q[0]):~*u8, 16))) { ret 1; }
    var first: [5]*gfx.StorageBuffer;
    first[0] = ?a;
    first[1] = ?b;
    first[2] = ?control;
    first[3] = ?params;
    first[4] = ?rule;

    # one more buffer than the device allows is refused before anything records
    var over: [gfx.MAX_STORAGE_BINDINGS + 1]*gfx.StorageBuffer;
    i = 0;
    for (i < gfx.MAX_STORAGE_BINDINGS + 1) {
        over[i] = ?rule;
        i       = i + 1;
    }
    val refused: err[gfx.Error] = gfx.renderer_dispatch(?r, ?step, ?over[0],
        lim.max_dispatch_bindings + 1, GROUPS, 1, 1);
    if (!(sel refused.err && (sel refused.err.buffer && (sel refused.err.buffer.too_many
        && refused.err.buffer.too_many == lim.max_dispatch_bindings + 1)))) {
        p.println("FAIL renderer_dispatch: a list past max_dispatch_bindings was not refused");
        ret 1;
    }

    if (timed) {
        # an end with no begin in the frame is refused
        val early: err[gfx.Error] = gfx.renderer_timer_end(?r, ?step_time);
        if (!(sel early.err && (sel early.err.renderer && sel early.err.renderer.timer_range))) {
            p.println("FAIL renderer_timer_end: an end without a begin was not refused");
            ret 1;
        }
        if (fail("renderer_timer_begin", gfx.renderer_timer_begin(?r, ?step_time))) { ret 1; }
    }
    if (fail("renderer_dispatch", gfx.renderer_dispatch(?r, ?step, ?first[0], 5, GROUPS, 1, 1))) { ret 1; }
    if (timed && fail("renderer_timer_end", gfx.renderer_timer_end(?r, ?step_time)))             { ret 1; }
    if (fail("renderer_readback", gfx.renderer_readback(?r, ?flags, ?control, FLAGS_AT)))        { ret 1; }

    var desc: gfx.PassDesc = gfx.pass_overlay();
    desc.target = opt[*gfx.RenderTarget].some{?target};
    desc.clear  = opt[gm.Vec4].some{gm.vec4(0.0, 0.0, 0.0, 1.0)};
    var pass: gfx.Pass = gfx.pass_begin(?r, ?desc);
    # the draw binds five as well, though its stages read only the first
    var drawn: [5]*gfx.StorageBuffer;
    drawn[0] = ?b;
    drawn[1] = ?a;
    drawn[2] = ?control;
    drawn[3] = ?params;
    drawn[4] = ?rule;
    if (timed && fail("pass_timer_begin", gfx.pass_timer_begin(?pass, ?draw_time))) { ret 1; }
    gfx.pass_draw_storage_indirect(?pass, ?drawn[0], 5, ?control, DRAW_AT, ?mat, ?xf, ?cells);
    if (timed && fail("pass_timer_end", gfx.pass_timer_end(?pass, ?draw_time))) { ret 1; }
    gfx.pass_end(?pass);
    val dropped: usize = gfx.renderer_dropped(?r);
    if (fail("renderer_end_frame", gfx.renderer_end_frame(?r))) { ret 1; }
    if (dropped != 0) {
        p.printlnf("FAIL pass_draw_storage_indirect: {} draws dropped", dropped);
        ret 1;
    }

    # generation 2: dispatched from the counts generation 1 wrote, b back to a.
    # Its parameters arrive as a batch of one-word writes, last word first, which
    # the dispatch after it must see.
    if (!open_frame(?r)) { ret 1; }
    q = params_for(2);
    var words: [4]gfx.BufferWrite;
    i = 0;
    for (i < 4) {
        words[i] = gfx.BufferWrite{offset: (3 - i) * 4, src: (?q[3 - i]):~*u8, len: 4};
        i        = i + 1;
    }
    if (fail("renderer_buffer_update_batch", gfx.renderer_buffer_update_batch(?r, ?params, ?words[0], 4))) {
        ret 1;
    }
    var second: [5]*gfx.StorageBuffer;
    second[0] = ?b;
    second[1] = ?a;
    second[2] = ?control;
    second[3] = ?params;
    second[4] = ?rule;
    if (fail("renderer_dispatch_indirect", gfx.renderer_dispatch_indirect(?r, ?step, ?second[0], 5,
        ?control, NEXT_AT))) { ret 1; }
    if (fail("renderer_end_frame", gfx.renderer_end_frame(?r))) { ret 1; }

    # the world: chunk c word j holds c * 1000 + j
    var heap:      allo.Allocator;
    val heap_made: err[allo.Error] = page.make(?heap);
    if (sel heap_made.err) {
        p.println("FAIL page allocator");
        ret 1;
    }
    val world_words: usize                 = CHUNKS * CHUNK_WORDS;
    val chunk_bytes: usize                 = CHUNK_WORDS * 4;
    val src_made:    res[*u32, allo.Error] = allo.allocate[u32](?heap, world_words);
    if (sel src_made.err) {
        p.println("FAIL allocate the world");
        ret 1;
    }
    val back_made: res[*u32, allo.Error] = allo.allocate[u32](?heap, world_words);
    if (sel back_made.err) {
        p.println("FAIL allocate the world");
        ret 1;
    }
    val list_made: res[*gfx.BufferWrite, allo.Error] = allo.allocate[gfx.BufferWrite](?heap, CHUNKS);
    if (sel list_made.err) {
        p.println("FAIL allocate the world");
        ret 1;
    }
    var src:   *u32             = src_made.ok;
    var back:  *u32             = back_made.ok;
    var list:  *gfx.BufferWrite = list_made.ok;
    var world: gfx.StorageBuffer;
    if (!make(d, world_words * 4, ?world)) { ret 1; }
    i = 0;
    for (i < world_words) {
        src[i] = ((i / CHUNK_WORDS) * 1000 + i % CHUNK_WORDS)::u32;
        i      = i + 1;
    }
    # the first half in order, the second last chunk first
    val half: usize = CHUNKS / 2;
    i = 0;
    for (i < CHUNKS) {
        var c: usize = i;
        if (i >= half) { c = CHUNKS - 1 - (i - half); }
        list[i] = gfx.BufferWrite{offset: c * chunk_bytes, src: (?src[c * CHUNK_WORDS]):~*u8, len: chunk_bytes};
        i       = i + 1;
    }

    if (!open_frame(?r)) { ret 1; }
    if (fail("renderer_buffer_update_batch", gfx.renderer_buffer_update_batch(?r, ?world, ?list[0], half))) {
        ret 1;
    }
    if (fail("renderer_buffer_update_batch", gfx.renderer_buffer_update_batch(?r, ?world, ?list[half],
        CHUNKS - half))) { ret 1; }
    # two writes over the same bytes are refused, and record nothing
    var crossed: [2]gfx.BufferWrite;
    crossed[0]        = list[0];
    crossed[1]        = list[0];
    crossed[1].offset = crossed[1].offset + 4;
    val overlap: err[gfx.Error] = gfx.renderer_buffer_update_batch(?r, ?world, ?crossed[0], 2);
    val batched: usize          = gfx.renderer_barriers(?r);
    if (fail("renderer_end_frame", gfx.renderer_end_frame(?r))) { ret 1; }

    # the grown pools: made, seeded and stepped within one frame
    if (!open_frame(?r)) { ret 1; }
    val fresh_made: res[gfx.StorageBuffer, gfx.Error] = gfx.renderer_storage_buffer(?r, CELLS * 4);
    if (sel fresh_made.err) {
        p.printlnf("FAIL renderer_storage_buffer: {}", gfx.error_message(fresh_made.err));
        ret 1;
    }
    var fresh:      gfx.StorageBuffer                 = fresh_made.ok;
    val grown_made: res[gfx.StorageBuffer, gfx.Error] = gfx.renderer_storage_buffer(?r, CELLS * 4);
    if (sel grown_made.err) {
        p.printlnf("FAIL renderer_storage_buffer: {}", gfx.error_message(grown_made.err));
        ret 1;
    }
    var grown: gfx.StorageBuffer = grown_made.ok;
    var seven: u32               = 7;
    if (fail("renderer_buffer_update", gfx.renderer_buffer_update(?r, ?fresh, SEEDED * 4, (?seven):~*u8, 4))) {
        ret 1;
    }
    var grew: [5]*gfx.StorageBuffer;
    grew[0] = ?fresh;
    grew[1] = ?grown;
    grew[2] = ?control;
    grew[3] = ?params;
    grew[4] = ?rule;
    if (fail("renderer_dispatch", gfx.renderer_dispatch(?r, ?step, ?grew[0], 5, GROUPS, 1, 1))) { ret 1; }
    if (fail("renderer_end_frame", gfx.renderer_end_frame(?r)))                                 { ret 1; }

    gfx.renderer_wait_idle(?r);
    var ok: bool = true;

    var zeroes:       [256]u32;
    var stepped_pool: [256]u32;
    if (fail("storage_buffer_read", gfx.storage_buffer_read(d, ?fresh, 0, (?zeroes[0]):~*u8, CELLS * 4))) { ret 1; }
    if (fail("storage_buffer_read", gfx.storage_buffer_read(d, ?grown, 0, (?stepped_pool[0]):~*u8, CELLS * 4))) {
        ret 1;
    }
    var unfilled: usize = 0;
    i = 0;
    for (i < CELLS) {
        # the step is 2 * src + 2 under the second generation's parameters
        var want: u32 = 0;
        if (i == SEEDED)                                          { want = 7; }
        if (zeroes[i] != want || stepped_pool[i] != want * 2 + 2) { unfilled = unfilled + 1; }
        i = i + 1;
    }
    if (unfilled != 0) {
        p.printlnf("FAIL renderer_storage_buffer: {} of 256 cells were not zero when the frame used them", unfilled);
        ok = false;
    }
    or { p.println("ok   two pools made mid-frame were zero for the write and the step after them"); }
    gfx.storage_buffer_delete(d, ?grown);
    gfx.storage_buffer_delete(d, ?fresh);

    if (!(sel overlap.err && (sel overlap.err.buffer && sel overlap.err.buffer.overlap))) {
        p.println("FAIL renderer_buffer_update_batch: overlapping writes were not refused");
        ok = false;
    }
    if (batched != 4) {
        p.printlnf("FAIL renderer_buffer_update_batch: {} barriers for two batches, not 4", batched);
        ok = false;
    }
    if (fail("storage_buffer_read", gfx.storage_buffer_read(d, ?world, 0, back:~*u8, world_words * 4))) { ret 1; }
    var off: usize = 0;
    i = 0;
    for (i < world_words) {
        if (back[i] != src[i]) { off = off + 1; }
        i = i + 1;
    }
    if (off != 0) {
        p.printlnf("FAIL renderer_buffer_update_batch: {} of {} world words differ", off, world_words);
        ok = false;
    }
    or { p.println("ok   1150 chunks written in two batches behind four barriers"); }
    gfx.storage_buffer_delete(d, ?world);
    allo.deallocate[gfx.BufferWrite](?heap, list, CHUNKS);
    allo.deallocate[u32](?heap, back, world_words);
    allo.deallocate[u32](?heap, src, world_words);

    var pool: [256]u32;
    if (fail("storage_buffer_read", gfx.storage_buffer_read(d, ?a, 0, (?pool[0]):~*u8, CELLS * 4))) { ret 1; }
    i = 0;
    var wrong: usize = 0;
    for (i < CELLS) {
        if (pool[i] != (i::u32) * 4 + 4) { wrong = wrong + 1; }
        i = i + 1;
    }
    if (wrong != 0) {
        p.printlnf("FAIL dispatch: {} of 256 cells differ from 4i + 4 (cell 1 holds {})", wrong, pool[1]);
        ok = false;
    }
    or { p.println("ok   two generations of five bindings, one indirect, left every cell at 4i + 4"); }

    var seen: [4]u32;
    if (!gfx.renderer_readback_take(?r, ?flags, (?seen[0]):~*u8, 16)) {
        p.println("FAIL readback: no copy landed");
        ok = false;
    }
    or (seen[0] != 1 || seen[1] != 1 || seen[2] != 1 || seen[3] != 1) {
        p.printlnf("FAIL readback: flags {} {} {} {}", seen[0], seen[1], seen[2], seen[3]);
        ok = false;
    }
    or { p.println("ok   every workgroup's flag came back without a stall"); }

    if (timed) {
        val stepped: Duration      = took(gfx.renderer_timer_take(?r, ?step_time));
        val drew:    Duration      = took(gfx.renderer_timer_take(?r, ?draw_time));
        val again:   opt[Duration] = gfx.renderer_timer_take(?r, ?step_time);
        if (stepped < 0 || drew < 0) {
            p.println("FAIL renderer_timer_take: a finished frame's range was not handed back");
            ok = false;
        }
        or (stepped == 0) {
            p.println("FAIL renderer_timer_take: the dispatch took no time");
            ok = false;
        }
        or (sel again.some) {
            p.println("FAIL renderer_timer_take: one range was handed back twice");
            ok = false;
        }
        or { p.printlnf("ok   the dispatch took {} ns and the draw {} ns on the GPU", stepped, drew); }
        gfx.renderer_timer_delete(?r, ?draw_time);
        gfx.renderer_timer_delete(?r, ?step_time);
    }
    or { p.println("ok   the device writes no timestamps, and a timer was refused"); }

    var px: [16384]u8;
    if (fail("render_target_read", gfx.render_target_read(d, ?target, ?px[0], BYTES))) { ret 1; }
    var red:   usize = 0;
    var red_i: usize = 0;
    if (gfx.render_target_bgra(?target)) { red_i = 2; }
    i = 0;
    for (i < BYTES / 4) {
        if (px[i * 4 + red_i] > 128 && px[i * 4 + 1] < 64) { red = red + 1; }
        i = i + 1;
    }
    # 256 cells, each a 2 by 2 pixel quarter of its own grid square
    if (red != 1024) {
        p.printlnf("FAIL draw: {} red pixels where the cells cover 1024", red);
        ok = false;
    }
    or { p.println("ok   the cells were drawn from the buffer the step wrote"); }

    gfx.render_target_delete(d, ?target);
    gfx.readback_delete(?flags, d);
    gfx.shader_delete(?cells, d);
    gfx.compute_delete(?step, d);
    gfx.storage_buffer_delete(d, ?rule);
    gfx.storage_buffer_delete(d, ?params);
    gfx.storage_buffer_delete(d, ?control);
    gfx.storage_buffer_delete(d, ?b);
    gfx.storage_buffer_delete(d, ?a);
    if (fail("renderer_dnit", gfx.renderer_dnit(?r))) { ret 1; }
    val closed: err[WindowError] = window_close(?w);
    if (sel closed.err) {
        p.printlnf("FAIL window_close: {}", window_error_message(closed.err));
        ret 1;
    }
    if (!ok) { ret 1; }
    p.println("PASS");
    ret 0;
}
