# One generation of the example's simulation.
#
# Every cell becomes its rule's scale times what it was plus the generation,
# read from the source and written to the destination, so the host can say exactly what the
# buffer must hold after any number of steps. Each workgroup raises its flag,
# the per-chunk activity a game reads back, and the first generation also
# writes the arguments the next dispatch and the draw read indirectly.
#
# The buffers are at set 1, the set boom binds a game's storage buffers in, in
# the order the host lists them. The rule is the fifth, past the four Vulkan
# guarantees every device, so a step that reads it is one boom sized its layout
# for from the device's own limits.

rec Cells {
    v: [256]u32;
}

# draw:  vertex count, instance count, first vertex, first instance
# next:  the workgroup counts the next step is dispatched with, and a pad
# flags: one per workgroup
rec Control {
    draw:  [4]u32;
    next:  [4]u32;
    flags: [4]u32;
}

rec Params {
    generation: u32;
    pad0:       u32;
    pad1:       u32;
    pad2:       u32;
}

rec Rule {
    scale: u32;
    pad0:  u32;
    pad1:  u32;
    pad2:  u32;
}

#[storage(1, 0, "readonly")]
var src:     Cells;
#[storage(1, 1)]
var dst:     Cells;
#[storage(1, 2)]
var control: Control;
#[storage(1, 3, "readonly")]
var params:  Params;
#[storage(1, 4, "readonly")]
var rule:    Rule;

#[builtin("global_invocation")]
var gid:   u32x3;
#[builtin("workgroup_id")]
var group: u32x3;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_main() {
    val i: u32 = gid[0];
    dst.v[i]                = src.v[i] * rule.scale + params.generation;
    control.flags[group[0]] = 1;
    # only the first generation writes the arguments, since a later one is
    # dispatched from them and may not write what its own dispatch reads
    if (i == 0 && params.generation == 1) {
        control.draw[0] = 6;
        control.draw[1] = 256;
        control.draw[2] = 0;
        control.draw[3] = 0;
        control.next[0] = 4;
        control.next[1] = 1;
        control.next[2] = 1;
        control.next[3] = 0;
    }
}
