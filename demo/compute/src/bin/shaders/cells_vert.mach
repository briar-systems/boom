# Cells drawn straight from the storage buffer a dispatch wrote.
#
# No vertex input. Instance n is cell n and its six vertices are a quad, placed
# in a 16 by 16 grid by the value the buffer holds for it: a cell holding 2k + 1
# lands in grid square k and covers its lower-left quarter. The host checks the
# coverage that gives, which is only right if every value arrived.

rec Cells {
    v: [256]u32;
}

#[storage(1, 0, "readonly")]
var cells: Cells;

#[builtin("vertex_index")]
var vertex:   u32;
#[builtin("instance_index")]
var instance: u32;
#[builtin("position")]
var position: f32x4;

#[stage("vertex")]
fun vert_main() {
    val k:   u32 = cells.v[instance] / 2;
    val col: u32 = k % 16;
    val row: u32 = (k / 16) % 16;
    var cx:  f32 = 0.0;
    var cy:  f32 = 0.0;
    if (vertex == 1 || vertex == 2 || vertex == 4) { cx = 0.5; }
    if (vertex == 2 || vertex == 4 || vertex == 5) { cy = 0.5; }
    val x: f32 = (col::f32 + cx) * 0.125 - 1.0;
    val y: f32 = (row::f32 + cy) * 0.125 - 1.0;
    position = f32x4{x, y, 0.5, 1.0};
}
