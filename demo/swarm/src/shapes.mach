# The bodies' shapes, from four triangles to twelve hundred and eighty.
#
# Each is a convex solid of unit radius, flat shaded so its facets catch the
# lights, and laid out as plain triangles, three vertices each and no index.
# A vertex is a standard boom mesh vertex, position, normal and uv in eight
# floats, which the instanced stage reads as two f32x4, so one array is both
# the shape buffer the instanced draw pulls from and the vertices the draw call
# path's meshes are made of.
#
# The detail is the vertex load: the same swarm in the finest shape is three
# hundred and twenty times the triangles of the coarsest.

use gm:   boom.math;
use allo: std.allocator;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# floats per vertex, a standard boom mesh vertex
pub val FLOATS: usize = 8;

# f32x4 the shape buffer holds, which pulled_vert's Shapes is sized to: room
# for 6144 vertices, of which every shape together uses 5148
pub val SHAPE_VECS: usize = 12288;

# how many shapes there are
pub val SHAPES: usize = 6;

# the solids the shapes are cut from
val TETRA: u8 = 0;
val CUBE:  u8 = 1;
val ICOSA: u8 = 2;

# one shape's recipe: its name on the panel, the solid, and how many times its
# faces are split in four and pushed out onto the sphere
rec Kind {
    name:  str;
    solid: u8;
    depth: u32;
}

val KINDS: [6]Kind = [6]Kind{
    Kind{name: "4", solid: TETRA, depth: 0},
    Kind{name: "12", solid: CUBE, depth: 0},
    Kind{name: "20", solid: ICOSA, depth: 0},
    Kind{name: "80", solid: ICOSA, depth: 1},
    Kind{name: "320", solid: ICOSA, depth: 2},
    Kind{name: "1280", solid: ICOSA, depth: 3}
};

# a built shape
# ---
# name:  its triangle count, as the panel shows it
# first: its first vertex in the array
# count: its vertices
pub rec Shape {
    name:  str;
    first: usize;
    count: usize;
}

# every shape, in one array
# ---
# data:   the vertices, FLOATS each, SHAPE_VECS * 4 floats in all
# shapes: where each shape sits in it
# used:   vertices written
pub rec Shapes {
    data:   *f32;
    shapes: [6]Shape;
    used:   usize;
}

fun put(s: *Shapes, p: gm.Vec3, n: gm.Vec3, u: f32, v: f32) {
    val k: usize = s.used * FLOATS;
    s.data[k]     = p[0];
    s.data[k + 1] = p[1];
    s.data[k + 2] = p[2];
    s.data[k + 3] = n[0];
    s.data[k + 4] = n[1];
    s.data[k + 5] = n[2];
    s.data[k + 6] = u;
    s.data[k + 7] = v;
    s.used        = s.used + 1;
}

# one flat triangle, wound counter-clockwise seen from outside whichever way
# round its corners came
fun triangle(s: *Shapes, a: gm.Vec3, b: gm.Vec3, c: gm.Vec3) {
    var n: gm.Vec3 = gm.vec3_normalize(gm.vec3_cross(gm.vec3_sub(b, a), gm.vec3_sub(c, a)));
    if (gm.vec3_dot(n, gm.vec3_add(a, gm.vec3_add(b, c))) < 0.0) {
        n = gm.vec3_scale(n, -1.0);
        put(s, a, n, 0.0, 0.0);
        put(s, c, n, 0.0, 1.0);
        put(s, b, n, 1.0, 0.0);
        ret;
    }
    put(s, a, n, 0.0, 0.0);
    put(s, b, n, 1.0, 0.0);
    put(s, c, n, 0.0, 1.0);
}

fun on_sphere(a: gm.Vec3, b: gm.Vec3) gm.Vec3 {
    ret gm.vec3_normalize(gm.vec3_add(a, b));
}

fun split(s: *Shapes, a: gm.Vec3, b: gm.Vec3, c: gm.Vec3, depth: u32) {
    if (depth == 0) {
        triangle(s, a, b, c);
        ret;
    }
    val ab: gm.Vec3 = on_sphere(a, b);
    val bc: gm.Vec3 = on_sphere(b, c);
    val ca: gm.Vec3 = on_sphere(c, a);
    split(s, a, ab, ca, depth - 1);
    split(s, b, bc, ab, depth - 1);
    split(s, c, ca, bc, depth - 1);
    split(s, ab, bc, ca, depth - 1);
}

fun tetra(s: *Shapes) {
    val k: f32        = 0.57735026;
    val v: [4]gm.Vec3 = [4]gm.Vec3{gm.vec3(k, k, k), gm.vec3(k, -k, -k), gm.vec3(-k, k, -k), gm.vec3(-k, -k, k)};
    triangle(s, v[0], v[1], v[2]);
    triangle(s, v[0], v[1], v[3]);
    triangle(s, v[0], v[2], v[3]);
    triangle(s, v[1], v[2], v[3]);
}

# the cube's faces, as its corners in order round each, a corner's bits
# choosing its x, y and z
val QUADS: [24]usize = [24]usize{0, 2, 6, 4, 1, 3, 7, 5, 0, 1, 5, 4, 2, 3, 7, 6, 0, 1, 3, 2, 4, 5, 7, 6};

fun cube(s: *Shapes) {
    val k: f32   = 0.57735026;
    var v: [8]gm.Vec3;
    var i: usize = 0;
    for (i < 8) {
        var x: f32 = -k;
        var y: f32 = -k;
        var z: f32 = -k;
        if ((i & 1) != 0) { x = k; }
        if ((i & 2) != 0) { y = k; }
        if ((i & 4) != 0) { z = k; }
        v[i] = gm.vec3(x, y, z);
        i    = i + 1;
    }
    var f: usize = 0;
    for (f < 6) {
        val q: usize = f * 4;
        triangle(s, v[QUADS[q]], v[QUADS[q + 1]], v[QUADS[q + 2]]);
        triangle(s, v[QUADS[q]], v[QUADS[q + 2]], v[QUADS[q + 3]]);
        f = f + 1;
    }
}

val FACES: [60]usize = [60]usize{
    0, 11, 5, 0, 5, 1, 0, 1, 7, 0, 7, 10, 0, 10, 11,
    1, 5, 9, 5, 11, 4, 11, 10, 2, 10, 7, 6, 7, 1, 8,
    3, 9, 4, 3, 4, 2, 3, 2, 6, 3, 6, 8, 3, 8, 9,
    4, 9, 5, 2, 4, 11, 6, 2, 10, 8, 6, 7, 9, 8, 1
};

fun icosa(s: *Shapes, depth: u32) {
    val t: f32 = 1.618034;
    var v: [12]gm.Vec3;
    v[0]  = gm.vec3(-1.0, t, 0.0);
    v[1]  = gm.vec3(1.0, t, 0.0);
    v[2]  = gm.vec3(-1.0, -t, 0.0);
    v[3]  = gm.vec3(1.0, -t, 0.0);
    v[4]  = gm.vec3(0.0, -1.0, t);
    v[5]  = gm.vec3(0.0, 1.0, t);
    v[6]  = gm.vec3(0.0, -1.0, -t);
    v[7]  = gm.vec3(0.0, 1.0, -t);
    v[8]  = gm.vec3(t, 0.0, -1.0);
    v[9]  = gm.vec3(t, 0.0, 1.0);
    v[10] = gm.vec3(-t, 0.0, -1.0);
    v[11] = gm.vec3(-t, 0.0, 1.0);
    var i: usize = 0;
    for (i < 12) {
        v[i] = gm.vec3_normalize(v[i]);
        i    = i + 1;
    }
    var f: usize = 0;
    for (f < 20) {
        split(s, v[FACES[f * 3]], v[FACES[f * 3 + 1]], v[FACES[f * 3 + 2]], depth);
        f = f + 1;
    }
}

# build every shape into one allocation
pub fun shapes_make(s: *Shapes, a: *allo.Allocator) err[allo.Error] {
    val got: res[*f32, allo.Error] = allo.allocate[f32](a, SHAPE_VECS * 4);
    if (sel got.err) { ret err[allo.Error].err{got.err}; }
    s.data = got.ok;
    s.used = 0;
    var i: usize = 0;
    for (i < SHAPE_VECS * 4) {
        s.data[i] = 0.0;
        i         = i + 1;
    }
    var k: usize = 0;
    for (k < SHAPES) {
        val first: usize = s.used;
        val kind:  *Kind = ?KINDS[k];
        if (kind.solid == TETRA) { tetra(s); }
        or (kind.solid == CUBE)  { cube(s); }
        or                       { icosa(s, kind.depth); }
        s.shapes[k] = Shape{name: kind.name, first: first, count: s.used - first};
        k           = k + 1;
    }
    ret err[allo.Error].ok{};
}

pub fun shapes_free(s: *Shapes, a: *allo.Allocator) err[allo.Error] {
    val done: err[allo.Error] = allo.deallocate[f32](a, s.data, SHAPE_VECS * 4);
    s.data = nil;
    ret done;
}

# a shape's first vertex as a pointer into the array
pub fun shape_vertices(s: *Shapes, k: usize) *f32 {
    ret ?s.data[s.shapes[k].first * FLOATS];
}
